{
  "name": "galbox-fata-morgana-experiment",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.28.5",
  "scripts": {
    "extract": "python3 tooling/extract.py",
    "inspect": "tsx tooling/inspect.ts",
    "convert": "tsx tooling/convert.ts",
    "check": "tsc --noEmit && tsc -p tests/door2-app/tsconfig.json --noEmit && tsc -p tests/door3-app/tsconfig.json --noEmit && tsx tooling/check-locales.ts && tsx tooling/check-chapters.ts && node tooling/check-boundaries.mjs",
    "test": "pnpm test:extractor && tsx --test tests/*.test.ts",
    "dev": "FATA_MODULES=1 vite --host 127.0.0.1",
    "build": "pnpm build:integrated",
    "test:browser": "pnpm test:integrated",
    "test:extractor": "python3 -m unittest discover -s tests -p '*_test.py'",
    "analyze:kag": "tsx tooling/analyze-kag.ts",
    "cloudflare:prepare": "pnpm build && tsx tooling/prepare-edge.ts preview",
    "cloudflare:types": "wrangler types",
    "cloudflare:check": "pnpm cloudflare:types && tsc -p tsconfig.worker.json",
    "cloudflare:deploy": "pnpm cloudflare:prepare && wrangler deploy",
    "r2:upload": "FATA_PUBLICATION_ROOT=generated/integrated python3 tooling/upload-r2.py --bulk",
    "r2:probe": "FATA_PUBLICATION_ROOT=generated/integrated python3 tooling/probe-r2.py",
    "test:remote": "playwright test --config playwright.integrated.remote.config.ts",
    "cloudflare:prepare:regression": "pnpm build && tsx tooling/prepare-edge.ts regression",
    "cloudflare:deploy:regression": "pnpm cloudflare:prepare:regression && wrangler deploy --env regression",
    "preview:check": "python3 tooling/check-preview.py",
    "locales:check": "tsx tooling/check-locales.ts",
    "locales:seed": "tsx tooling/seed-locales.ts",
    "sdk:build": "node tooling/build-sdk.mjs",
    "sdk:update": "node tooling/build-sdk.mjs --update",
    "chapters:convert": "tsx tooling/convert-chapters.ts",
    "chapters:check": "tsx tooling/check-chapters.ts",
    "chapters:assets": "tsx tooling/plan-chapter-assets.ts",
    "menus:refresh": "tsx tooling/refresh-menus.ts",
    "chapters:portraits": "tsx tooling/compile-chapter-portraits.ts",
    "test:edge": "python3 tooling/test-worker-cache.py",
    "test:reading": "pnpm build:door1 && playwright test tests/browser/reading-network.spec.ts && node tooling/compare-reading.mjs artifacts/browser/results.json",
    "compat:fetch": "tsx tooling/publish-legacy.ts --fetch",
    "door2:build": "tsx tooling/compile-full-door.ts",
    "door2:verify": "tsx tooling/drive-full-door.ts",
    "dev:door2:full": "FATA_FULL_DOOR=1 vite --config tests/door2-app/vite.config.ts",
    "test:door2:full": "playwright test --config playwright.full-door.config.ts",
    "chapters:build": "tsx tooling/compile-next-door.ts",
    "chapters:verify": "tsx tooling/drive-next-door.ts",
    "dev:door2": "vite --config tests/door2-app/vite.config.ts",
    "test:door2": "playwright test --config playwright.door2.config.ts",
    "integration:build": "tsx tooling/compile-integrated.ts",
    "integration:verify": "tsx tooling/drive-integrated.ts",
    "dev:integrated": "FATA_MODULES=1 vite",
    "build:integrated": "pnpm check && FATA_MODULES=1 vite build && tsx tooling/compress-static.ts dist",
    "test:integrated": "playwright test --config playwright.integrated.config.ts",
    "build:door1": "pnpm check && tsx tooling/publish.ts && FATA_MODULES=0 vite build && tsx tooling/compress-static.ts dist",
    "dev:door1": "vite --host 127.0.0.1",
    "test:browser:door1": "pnpm build:door1 && playwright test",
    "test:remote:door1": "playwright test --config playwright.remote.config.ts",
    "r2:upload:door1": "python3 tooling/upload-r2.py",
    "r2:probe:door1": "python3 tooling/probe-r2.py",
    "r2:verify": "python3 tooling/verify-integrated-assets.py",
    "door3:build": "tsx tooling/compile-third-door.ts",
    "door3:verify": "tsx tooling/drive-third-door.ts",
    "dev:door3": "vite --config tests/door3-app/vite.config.ts",
    "test:door3": "playwright test --config playwright.third-door.config.ts",
    "connection:build": "tsx tooling/compile-connected.ts",
    "dev:connected": "FATA_MODULES=1 FATA_PUBLICATION_ROOT=generated/connected vite --host 127.0.0.1 --port 4186",
    "connection:verify": "tsx tooling/drive-connected.ts",
    "connection:old-cuts": "tsx tooling/verify-module-cuts.ts",
    "test:connection": "playwright test --config playwright.connection.config.ts",
    "connection:freeze": "tsx tooling/freeze-module-sources.ts",
    "connection:promote": "tsx tooling/promote-connected.ts",
    "test:connection:fit": "FATA_FIT_ROOT=generated/connected playwright test --config playwright.connected-fit.config.ts"
  },
  "dependencies": {
    "galbox-sdk": "file:vendor/galbox-sdk-7ae4655617e1.tgz",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/gettext-parser": "9.0.0",
    "@types/node": "24.10.1",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "gettext-parser": "10.0.0",
    "smol-toml": "1.9.1",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "wrangler": "4.153.0",
    "yaml": "2.8.3"
  }
}
