#: page:first_540C42D1_CF8B_4050_832A_CFD8B94A0EAE
#. Edit msgstr; keep msgctxt and msgid unchanged.
msgctxt "page:first_540C42D1_CF8B_4050_832A_CFD8B94A0EAE"
msgid "I was looking down upon a corpse."
msgstr "Eu estava olhando para um corpo."

#: page:first_37585A74_A7E2_48F0_989E_25B6DC38DBCB
#. Edit msgstr; keep msgctxt and msgid unchanged.
msgctxt "page:first_37585A74_A7E2_48F0_989E_25B6DC38DBCB"
msgid "My own corpse."
msgstr "Meu próprio corpo."

#: page:first_79213175_FEDD_40B3_A0AA_B0EB913874D0
#. Edit msgstr; keep msgctxt and msgid unchanged.
msgctxt "page:first_79213175_FEDD_40B3_A0AA_B0EB913874D0"
msgid "I was afflicted with great despair"
msgstr "Fui tomado por profundo desespero"

#: page:first_A7FCDB93_195C_497F_85E5_EA06E877E9AA
#. Edit msgstr; keep msgctxt and msgid unchanged.
msgctxt "page:first_A7FCDB93_195C_497F_85E5_EA06E877E9AA"
msgid "at the sight of it being dragged to the place of my crucifixion."
msgstr "pela visão dele sendo carregado ao lugar da minha crucificação."

#: page:first_E85CC0FE_0471_4EF1_BBA0_51400C5AC44D
#. Edit msgstr; keep msgctxt and msgid unchanged.
msgctxt "page:first_E85CC0FE_0471_4EF1_BBA0_51400C5AC44D"
msgid "My soul crumbled,"
msgstr "Minha alma desmoronou,"

#: page:first_3F2933EA_3E00_4D37_BB6D_28E31C48A036
#. Edit msgstr; keep msgctxt and msgid unchanged.
msgctxt "page:first_3F2933EA_3E00_4D37_BB6D_28E31C48A036"
msgid "and I was wholly extinguished."
msgstr "e eu fui completamente extinto."

#: page:first_59EC77B3_02F7_42BF_9344_D15CBCF0D413
#. Edit msgstr; keep msgctxt and msgid unchanged.
msgctxt "page:first_59EC77B3_02F7_42BF_9344_D15CBCF0D413"
msgid "Indeed, I did once lose everything."
msgstr "Eu, uma vez, eu realmente perdi tudo."

#: page:first_347457C5_05AD_400F_B6D5_C78A5C32ECAE
#. Edit msgstr; keep msgctxt and msgid unchanged.
msgctxt "page:first_347457C5_05AD_400F_B6D5_C78A5C32ECAE"
msgid "However..."
msgstr "No entanto..."

#: page:first_947457C5_05AD_400F_B6D5_C78A5C32ECAE
#. Edit msgstr; keep msgctxt and msgid unchanged.
msgctxt "page:first_947457C5_05AD_400F_B6D5_C78A5C32ECAE"
msgid "as I faded into darkness everlasting,"
msgstr "enquanto eu desaparecia na escuridão eterna,"

#: page:first_347457C5_05AD_400F_B6D5_C98A5C32ECAE
#. Edit msgstr; keep msgctxt and msgid unchanged.
msgctxt "page:first_347457C5_05AD_400F_B6D5_C98A5C32ECAE"
msgid "I heard a voice calling out to me."
msgstr "Eu ouvi uma voz me chamando."

#: page:first_347457C5_05AD_400F_B6D5_C78A5C34ECAE
#. Edit msgstr; keep msgctxt and msgid unchanged.
msgctxt "page:first_347457C5_05AD_400F_B6D5_C78A5C34ECAE"
msgid "And so,"
msgstr "Então,"

#: page:first_347457C5_05AD_400F_B6D9_C78A5C32ECAE
#. Edit msgstr; keep msgctxt and msgid unchanged.
msgctxt "page:first_347457C5_05AD_400F_B6D9_C78A5C32ECAE"
msgid "I vowed once more"
msgstr "uma vez mais eu jurei"

#: page:first_347457C5_05AD_401F_B6D5_C78A5C32ECAE
#. Edit msgstr; keep msgctxt and msgid unchanged.
msgctxt "page:first_347457C5_05AD_401F_B6D5_C78A5C32ECAE"
msgid "that no matter how long it may take,"
msgstr "que não importa o quanto demorar,"

#: page:first_347457C5_05AD_410F_B6D5_C78A5C32ECAE
#. Edit msgstr; keep msgctxt and msgid unchanged.
msgctxt "page:first_347457C5_05AD_410F_B6D5_C78A5C32ECAE"
msgid "how great the obstacles that stand in my way,"
msgstr "o quão grandes forem os obstáculos no meu caminho,"

#: page:first_347457C5_05AD_910F_B6D5_C78A5C32ECAE
#. Edit msgstr; keep msgctxt and msgid unchanged.
msgctxt "page:first_347457C5_05AD_910F_B6D5_C78A5C32ECAE"
msgid "or what form you may assume,"
msgstr "ou qual forma você assumir,"

#: page:first_347457C5_06AD_400F_B6D5_C78A5C32ECAE
#. Edit msgstr; keep msgctxt and msgid unchanged.
msgctxt "page:first_347457C5_06AD_400F_B6D5_C78A5C32ECAE"
msgid "I shall come back for you."
msgstr "eu voltarei para você."

#: page:first_347457C9_06AD_400F_B6D5_C78A5C32ECAE
#. Edit msgstr; keep msgctxt and msgid unchanged.
msgctxt "page:first_347457C9_06AD_400F_B6D5_C78A5C32ECAE"
msgid "That I must return"
msgstr "Que eu preciso retornar"

#: page:first_399457C5_06AD_400F_B6D5_C78A5C32ECAE
#. Edit msgstr; keep msgctxt and msgid unchanged.
msgctxt "page:first_399457C5_06AD_400F_B6D5_C78A5C32ECAE"
msgid "to that house."
msgstr "para aquela casa."

#: page:first_399457C5_06AD_400F_B6D5_C78A5C72ECAE
#. Edit msgstr; keep msgctxt and msgid unchanged.
msgctxt "page:first_399457C5_06AD_400F_B6D5_C78A5C72ECAE"
msgid "So I ask of you,"
msgstr "Portanto, eu peço a você"

#: page:first_319457C7_06AD_400F_B6D5_C78A5C72ECAE
#. Edit msgstr; keep msgctxt and msgid unchanged.
msgctxt "page:first_319457C7_06AD_400F_B6D5_C78A5C72ECAE"
msgid "please wait"
msgstr "por favor, espere"

#: page:first_419457C7_06AD_400F_B6D5_C78A5C72ECAE
#. Edit msgstr; keep msgctxt and msgid unchanged.
msgctxt "page:first_419457C7_06AD_400F_B6D5_C78A5C72ECAE"
msgid "until this mutilated body"
msgstr "até que este corpo mutilado"

#: page:first_419407C7_06AD_400F_B6D5_C78A5C72ECAE
#. Edit msgstr; keep msgctxt and msgid unchanged.
msgctxt "page:first_419407C7_06AD_400F_B6D5_C78A5C72ECAE"
msgid "arrives there once more."
msgstr "chegue aí novamente."
