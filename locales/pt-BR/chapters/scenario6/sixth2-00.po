msgstr "⟪k:0⟫⟪k:1⟫............"

#: scenario6:scenario6_9A86FC9B_89CD_40AF_AC2D_F93A8A50470C
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 01889b4fe9fed7f6a6b913d14429597a49976b19a9ccf5bca299619c84e1afe3
#. default-sha256: dc3263517dd70ba524b9c5701f3b5f68fbb0347065d6983a65e1d80b789dc72c
msgctxt "scenario6:scenario6_9A86FC9B_89CD_40AF_AC2D_F93A8A50470C"
msgid ""
"⟪k:0⟫But it didn’t matter if it was all an illusion; ⟪k:1⟫the gentle breeze blowing in through "
"the window felt wonderful."
msgstr ""
"⟪k:0⟫Mas não importava se era tudo uma ilusão; ⟪k:1⟫a brisa suave que entrava pela janela era "
"maravilhosa."

#: scenario6:scenario6_2BB1070F_5121_4B4C_87C2_E5392817163A
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: ff0e294851d4a41a327ace6bad8dc89a12d509c647658e32a416a8295dc48f9d
#. default-sha256: 4dba2477bc25404b339ea5d764e88c08bed332b378205f7851d16dc17fa6341e
msgctxt "scenario6:scenario6_2BB1070F_5121_4B4C_87C2_E5392817163A"
msgid ""
"⟪k:0⟫The smell of grass, the chirping of birds, the glistening blue sky...⟪k:1⟫⟪k:2⟫it was like a "
"thousand memories rushing back all at once,⟪k:3⟫and it brought tears to my eyes."
msgstr ""
"⟪k:0⟫O cheiro da grama, o chilrear dos pássaros, o céu azul brilhante...⟪k:1⟫⟪k:2⟫era como se mil "
"memórias voltassem de uma só vez,⟪k:3⟫e trouxe lágrimas aos meus olhos."

#: scenario6:scenario6_FEAE7690_F01A_4749_B284_1BBFF2039512
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: e194b8c9f429a0bb628d966d0650c05103c9f40a368b9d909991c052c6447c93
#. default-sha256: 59a28996e3e7444a4e13af13dcbe83b582ab02d6be4adb290ff455221d725dbd
msgctxt "scenario6:scenario6_FEAE7690_F01A_4749_B284_1BBFF2039512"
msgid ""
"⟪k:0⟫And as she always did, the witch’s voice crushed my elation,⟪k:1⟫dragging me back to reality."
msgstr ""
"⟪k:0⟫E como ela sempre fazia, a voz da bruxa esmagou minha euforia,⟪k:1⟫me arrastando de volta à "
"realidade."

#: scenario6:scenario6_F4C5E076_10F9_423D_AE33_EDC7C998E390
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: a7e14a6832cce9431c803038d2c3743bd7239c38d41ba4cc552dcb1ba07e69b8
#. default-sha256: a0adad635fcc9e1fa8402c882260b817442b03de279480f3c1ca2f2760610e3d
msgctxt "scenario6:scenario6_F4C5E076_10F9_423D_AE33_EDC7C998E390"
msgid "⟪k:0⟫for it was that moment that began my true decline."
msgstr "⟪k:0⟫pois foi esse momento que começou meu verdadeiro declínio."

#: scenario6:scenario6_24048DAB_589E_445E_9473_514B697F5F20
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 7da4eb12ee72efe1b5263e45a2311472592032b3028879c6f69b22e84aec51a2
#. default-sha256: 8a23d4afe01c0fccc331e0209b0df87466a8d6fae83272e9d0de993abc0d89ea
msgctxt "scenario6:scenario6_24048DAB_589E_445E_9473_514B697F5F20"
msgid ""
"⟪k:0⟫Have you already forgotten?⟪k:1⟫Oh, good heavens... ⟪k:2⟫Do you have your head on straight, "
"my dear?"
msgstr "⟪k:0⟫Você já esqueceu?⟪k:1⟫Oh, céus... ⟪k:2⟫Você está com a cabeça no lugar, minha querida?"

#: scenario6:scenario6_9D80C2BC_6E8A_4074_B8A5_966D67262FB5
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 20eaba0624274c81cdf6844fde2fabe6a49dc3aa606980283466737dc9678c8a
#. default-sha256: 5c8f5d534cfc42cc5f64ce778ed9c4f631bdbb534d59ba61a3af24327f3495e5
msgctxt "scenario6:scenario6_9D80C2BC_6E8A_4074_B8A5_966D67262FB5"
msgid "⟪k:0⟫...It looks like someone’s here."
msgstr "⟪k:0⟫...Parece que alguém está aqui."

#: scenario6:scenario6_5ECC5EC6_1C2A_4C00_8926_9D15828AFB8B
