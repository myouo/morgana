msgstr "⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫⟪k:4⟫⟪k:5⟫Não importa o que aconteça..."

#: scenario6:scenario6_4DF94911_E146_44DB_9E37_A31671194188
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 56e09a4e66e727e2d76590ec887bcb8ec507de13970846de012066194592dc3a
#. default-sha256: 3511298344a1f0887588278603e1833694c723bcbb12dfeaf9f06bae6ec9bf87
msgctxt "scenario6:scenario6_4DF94911_E146_44DB_9E37_A31671194188"
msgid "⟪k:0⟫⟪k:1⟫no matter what you see..."
msgstr "⟪k:0⟫⟪k:1⟫não importa o que você veja..."

#: scenario6:scenario6_BF129CA0_712B_4687_BB76_D5CAAE6E3137
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: db5d5dbc6ca20e9bf92e16ac1fc29d58093ebbd65eda7feeb39465f5775ce2d3
