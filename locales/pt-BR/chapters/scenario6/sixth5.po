msgctxt "scenario6:scenario6_42F292D3_4735_4C81_944B_E79D476A783A"
msgid ""
"⟪k:0⟫When her fingers brush against my skin, they feel as frigid as death itself—⟪k:1⟫far colder "
"than anything I have felt from her thus far."
msgstr ""
"⟪k:0⟫Quando seus dedos roçam minha pele, eles parecem tão gelados quanto a própria morte—⟪k:1⟫"
"muito mais frio do que qualquer coisa que eu senti dela até agora."

#: scenario6:scenario6_3770BA1C_DAE0_4A0B_96A2_5FE9454BD0BE
