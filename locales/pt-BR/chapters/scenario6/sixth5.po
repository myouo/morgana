msgid ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫⟪k:4⟫⟪k:5⟫⟪k:6⟫⟪k:7⟫⟪k:8⟫⟪k:9⟫⟪k:10⟫⟪k:11⟫⟪k:12⟫⟪k:13⟫⟪k:14⟫Time pressed "
"onward,"
msgstr ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫⟪k:4⟫⟪k:5⟫⟪k:6⟫⟪k:7⟫⟪k:8⟫⟪k:9⟫⟪k:10⟫⟪k:11⟫⟪k:12⟫⟪k:13⟫⟪k:14⟫O tempo passou,"

#: scenario6:scenario6_E00C943F_4D75_42F5_B79C_13668E56E37E
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 51e7e26ff382e3aa5b831c82a4919b307024e744c6bda115bfb1236c574d602a
