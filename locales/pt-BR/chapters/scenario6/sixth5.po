msgid "⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫............"
msgstr "⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫............"

#: scenario6:scenario6_1266F294_ED32_406E_94D6_8CCA1AF6B90C
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 2febfcefbb3aa898ec094e27d8ba2145f382d9a4c44c0e85e481f54e39c2df00
#. default-sha256: 8f1206dc5981138d6fcfa68cab3cc59b4472ef73b6d7b37f0f01fd251a3ca8d4
msgctxt "scenario6:scenario6_1266F294_ED32_406E_94D6_8CCA1AF6B90C"
msgid "⟪k:0⟫I prepared a number of things to say when she was finished with her tale,"
msgstr "⟪k:0⟫Preparei uma série de coisas para dizer quando ela terminasse seu conto,"

#: scenario6:scenario6_0CF713FA_806D_4B6A_BAA0_BF374F4C56E0
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: f6ca00f04b22eef59ec6f1e8bcca512b6124040518270c0323cba1ea90cd6d91
#. default-sha256: 282e7936942ad97e11ecec3c5072408b019480170f6f911636d216495661c2a0
msgctxt "scenario6:scenario6_0CF713FA_806D_4B6A_BAA0_BF374F4C56E0"
msgid "⟪k:0⟫but I can’t manage to put any of them into words."
msgstr "⟪k:0⟫mas não consigo colocar nenhuma delas em palavras."

#: scenario6:scenario6_1F1C88CC_6A6E_4ECC_868A_58408AC2ABA6
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 516e31bbf52f3fb16decbc6b5b91b9c164a81b30f0cc569e30953f617a07512c
#. default-sha256: 1ed5849454c30fda15eb9a064eb0eaf70e4526dafb24b7bbd47bbe40ceb1cda7
msgctxt "scenario6:scenario6_1F1C88CC_6A6E_4ECC_868A_58408AC2ABA6"
msgid "⟪k:0⟫I almost hate myself for thinking it would be so easy."
msgstr "⟪k:0⟫Quase me odeio por pensar que seria tão fácil."

#: scenario6:scenario6_E53F052F_E604_466B_A462_5229FDF0E856
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 2cd73b1e06ce05378c7e6c41599d02da712157892f8c27ded14d1b770a957f0f
#. default-sha256: dc732fff81741bda5e9f1b1124ece3647a9dbcb2a2af2aa17ac4361be3004aec
msgctxt "scenario6:scenario6_E53F052F_E604_466B_A462_5229FDF0E856"
msgid ""
"⟪k:0⟫For letting myself hope I could simply pull her back to her old self,⟪k:1⟫accept whatever "
"had happened to her,"
msgstr ""
"⟪k:0⟫Por me deixar acreditar que eu pudesse simplesmente arrastá-la de volta para o seu antigo eu,"
"⟪k:1⟫aceitar o que quer que tenha acontecido com ela,"

#: scenario6:scenario6_F3D5627E_7C28_445A_9C3F_932FF496F53E
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: fc5023cf5b0e133762d31bfecf067a57c9f15a60ce5a3ab4b4bedcd0c0320d90
#. default-sha256: 508398f8a5a307ad321be7cda166653a20a96b10884121e7f0b5d952191e9eaa
msgctxt "scenario6:scenario6_F3D5627E_7C28_445A_9C3F_932FF496F53E"
msgid "⟪k:0⟫take her hand in mine, and that would solve everything."
msgstr "⟪k:0⟫pegar a mão dela na minha, e isso resolveria tudo."

#: scenario6:scenario6_218D7FBB_C459_4977_BB6A_96B43570A67F
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 29d123aba0a6ed594a1e11f29e43cb34d4039ded3386feb2a83773ecf88b9a51
#. default-sha256: 336079b6033c7b2413f9b5dd180bf708ff15bef031c86b2abd6eff05f2e51193
msgctxt "scenario6:scenario6_218D7FBB_C459_4977_BB6A_96B43570A67F"
msgid "⟪k:0⟫The truth is so much worse than I imagined—⟪k:1⟫⟪k:2⟫so much more harrowing."
msgstr "⟪k:0⟫A verdade é muito pior do que eu imaginava—⟪k:1⟫⟪k:2⟫muito mais angustiante."

#: scenario6:scenario6_16D0120E_43DD_41D0_A19C_830C0C139E1D
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 77ac8f405e372bcd8b446dac9ebbefc91fa2deaf515c3df2fc2d4d76c603411e
#. default-sha256: 3160f810ecdfc5441ec92ee7f5490fb64a08c076f179d1ec0f2f57dc8628f70b
msgctxt "scenario6:scenario6_16D0120E_43DD_41D0_A19C_830C0C139E1D"
msgid "⟪k:0⟫She was subjected not only to her own terrible fate,"
msgstr "⟪k:0⟫Ela foi submetida não apenas ao seu próprio destino terrível,"

#: scenario6:scenario6_581895C7_70CD_4803_BFC6_FB50FAB30442
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 6d7b18255bb318a8039a0bda0cf3f9ae6a6ddc01f29a5d62076a39f34e1f34e0
#. default-sha256: 8d26397e75e37d7af98105170df2e9358671f105453d9e12ef141041363ff0f2
msgctxt "scenario6:scenario6_581895C7_70CD_4803_BFC6_FB50FAB30442"
msgid "⟪k:0⟫but every single one of this house’s tragedies."
msgstr "⟪k:0⟫mas a cada uma das tragédias desta casa."

#: scenario6:scenario6_D523CCEA_32F8_4BE3_ADED_A419394BED4D
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 0f1cacd57bb50c9583a9b3ebc5edb64d6df46c71b33eb6969ea28c44c069a8c3
#. default-sha256: 522e2bfdc092f5f2c1b8dd4fa4557cadd8fe6d9e932d8061ed24c3ffdbfa21ad
msgctxt "scenario6:scenario6_D523CCEA_32F8_4BE3_ADED_A419394BED4D"
