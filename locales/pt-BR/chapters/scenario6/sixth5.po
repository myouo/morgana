msgctxt "scenario6:scenario6_BF129CA0_712B_4687_BB76_D5CAAE6E3137"
msgid "⟪k:0⟫⟪k:1⟫never again..."
msgstr "⟪k:0⟫⟪k:1⟫nunca mais..."

#: scenario6:scenario6_9CB7481D_46BE_4B1A_ACA9_2845B727CBC5
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 2522655e1a2c2fc11ab5d15049aa85256bfefa80271cfe85dcc454ed0a1169f3
#. default-sha256: 14340a19fa970f1eb0fce737b8821a093f78c2095175339cfa28fc745df02c72
msgctxt "scenario6:scenario6_9CB7481D_46BE_4B1A_ACA9_2845B727CBC5"
msgid "⟪k:0⟫⟪k:1⟫let go of this hand..."
msgstr "⟪k:0⟫⟪k:1⟫solte esta mão..."

#: scenario6:scenario6_18E2B9AF_AE3C_41CE_A368_93578918249C
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 16a5c6f105ae19815d0e67116041ec43c4c8f28b5a6a508ef3bc2ffcaf8a4a98
