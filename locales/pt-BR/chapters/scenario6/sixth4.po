msgid "⟪k:0⟫⟪k:1⟫⟪k:2⟫It’s a pleasure to meet you."
msgstr "⟪k:0⟫⟪k:1⟫⟪k:2⟫É um prazer conhecer você."

#: scenario6:scenario6_083071E8_9111_45AE_8A4B_D0C4122FF24C
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 5edd7c056c206952e9488e240778dbaa8e061b312406ce423b7e20e52198f70f
#. default-sha256: 6828156bb97cf21d042e917aef1122de64b50ab947054b2bfe976107caeaafbd
