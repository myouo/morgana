msgid "⟪k:0⟫⟪k:1⟫⟪k:2⟫Hey! Hey, head maid!⟪k:3⟫⟪k:4⟫Get out here!"
msgstr "⟪k:0⟫⟪k:1⟫⟪k:2⟫Ei! Ei, criada chefe!⟪k:3⟫⟪k:4⟫Venha aqui!"

#: scenario6:scenario6_B9FFC48D_8468_4417_89FD_3726CB41A310
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 32f9af0697d0afa77e0659c71ddb26281174644784dea6e7233cb23af1a6b436
