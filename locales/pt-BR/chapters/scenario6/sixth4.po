msgstr "⟪k:0⟫⟪k:1⟫⟪k:2⟫“É um prazer conhecer você.”"

#: scenario6:scenario6_666D9EDB_836D_4578_AA5F_8AD6C8F27534
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 7eaccac7917f579aa58d94406175e2bd40516ace5db6ddf19dfd0c41f9e2490d
#. default-sha256: f79358aef698baea4b2ac58a25ebb7e55a88cec4c4f538dcbc842365c564f8b3
msgctxt "scenario6:scenario6_666D9EDB_836D_4578_AA5F_8AD6C8F27534"
msgid "⟪k:0⟫What had I spent all that time waiting for?"
msgstr "⟪k:0⟫Pelo que eu passei todo esse tempo esperando?"

#: scenario6:scenario6_88DA40EB_7F6A_4485_BBEE_ACE5B0922BA6
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 41c47ac5ede1d92cfa92718be1daaef938ca8e3860af432bf2b81d201fc19dc8
#. default-sha256: 36920508d843c52d4eb74c027fe647113e1dc69c464583d9c6fecd80d519120a
msgctxt "scenario6:scenario6_88DA40EB_7F6A_4485_BBEE_ACE5B0922BA6"
msgid "⟪k:0⟫It was all for naught. It was all meaningless."
msgstr "⟪k:0⟫Foi tudo em vão. Foi tudo sem sentido."

#: scenario6:scenario6_6F18845D_E537_4999_BC44_68C8B705221C
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 8107e90368d71384b0163d5fd934942231369dd1b4695ba61c6e3ec495bde970
#. default-sha256: 6f7b39b316476978272c7bc1a96b5a1323b1f4f524841923cc348c064425a574
