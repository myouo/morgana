msgid "⟪k:0⟫⟪k:1⟫⟪k:2⟫I am right here, sir.⟪k:3⟫⟪k:4⟫Is something the matter?"
msgstr "⟪k:0⟫⟪k:1⟫⟪k:2⟫Estou bem aqui, senhor.⟪k:3⟫⟪k:4⟫Há algo de errado?"

#: scenario6:scenario6_03232306_DBE0_4747_B3FA_10B5730DBEB3
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 688959f360f00581a15350825da0f1bb642c64003d15c4af4cf6dd60a1443aee
