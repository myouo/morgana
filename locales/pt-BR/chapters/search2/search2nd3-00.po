msgid ""
"⟪k:0⟫⟪k:1⟫Those merry...⟪k:2⟫⟪k:3⟫peaceful...⟪k:4⟫⟪k:5⟫⟪k:6⟫⟪k:7⟫⟪k:8⟫cheerful...⟪k:9⟫⟪k:10⟫⟪k:11⟫"
"⟪k:12⟫⟪k:13⟫⟪k:14⟫spirited sinners’ voices...⟪k:15⟫⟪k:16⟫⟪k:17⟫resounded in my tower."
msgstr ""
"⟪k:0⟫⟪k:1⟫Aquelas alegres...⟪k:2⟫⟪k:3⟫pacificas...⟪k:4⟫⟪k:5⟫⟪k:6⟫⟪k:7⟫⟪k:8⟫animadas...⟪k:9⟫⟪k:10⟫"
"⟪k:11⟫⟪k:12⟫⟪k:13⟫⟪k:14⟫espirituosas vozes de pecadores...⟪k:15⟫⟪k:16⟫⟪k:17⟫ressoavam na minha "
"torre."

