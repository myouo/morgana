msgid "⟪k:0⟫⟪k:1⟫⟪k:2⟫“Nothing personal. I just need your blood.”"
msgstr "⟪k:0⟫⟪k:1⟫⟪k:2⟫“Nada pessoal. Eu só preciso do seu sangue.”"

#: search2:search2_11369757_332F_4130_A71A_287590EB6D56
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 367c23be48406e5e5dedc85477d3cbcb6017455d18f4f6d19292347862eebd34
