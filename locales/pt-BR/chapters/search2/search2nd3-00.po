msgctxt "search2:search2_3C835617_FE2B_4BB6_A129_DC7164284E49"
msgid "⟪k:0⟫⟪k:1⟫“I needed some way of getting enough money⟪k:2⟫⟪k:3⟫to keep her church running.”"
msgstr ""
"⟪k:0⟫⟪k:1⟫“Eu precisava de alguma maneira de conseguir dinheiro suficiente⟪k:2⟫⟪k:3⟫para manter "
"sua igreja funcionando.”"

#: search2:search2_B0F6C89D_1614_4BF4_AA66_6BC1CB5A0166
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: dbfe248045f5b2294e8d20f133d1727ab134b00dd931aeb52d94875d03da9460
#. default-sha256: 1bc8786993296b0358f69279496ebbb7bb9a4a453391318d23f4b171f5dec060
msgctxt "search2:search2_B0F6C89D_1614_4BF4_AA66_6BC1CB5A0166"
msgid ""
"⟪k:0⟫⟪k:1⟫“If I brought him the witch with the miracle blood,⟪k:2⟫⟪k:3⟫he would finance a whole "
"new church for her.”"
msgstr ""
"⟪k:0⟫⟪k:1⟫“Se eu trouxesse para a bruxa com o sangue milagroso,⟪k:2⟫⟪k:3⟫ele financiaria toda uma "
"igreja completamente nova para ela.”"

#: search2:search2_1B01C5B2_4399_4C85_B551_DD668454F45F
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 54cf1dfa0d389940a21d66ea1a15e1ea309099a3cb0e034a82fb177563508cd1
