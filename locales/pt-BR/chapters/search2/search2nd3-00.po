msgctxt "search2:search2_84C0E871_4E4E_4065_9055_55456FCCFBC0"
msgid ""
"⟪k:0⟫⟪k:1⟫How could I ⟪k:2⟫not⟪k:3⟫ hold a grudge?⟪k:4⟫⟪k:5⟫⟪k:6⟫How could I ⟪k:7⟫not⟪k:8⟫ "
"despise them?⟪k:9⟫⟪k:10⟫⟪k:11⟫How could I possibly forgive them?⟪k:12⟫⟪k:13⟫⟪k:14⟫Tell me, please."
"⟪k:15⟫⟪k:16⟫⟪k:17⟫Tell me, how could I?!"
msgstr ""
"⟪k:0⟫⟪k:1⟫Como eu poderia ⟪k:2⟫não⟪k:3⟫ guardar rancor?⟪k:4⟫⟪k:5⟫⟪k:6⟫Como eu poderia ⟪k:7⟫"
"não⟪k:8⟫ desprezá-los?⟪k:9⟫⟪k:10⟫⟪k:11⟫Como eu, possivelmente, poderia perdoá-los?⟪k:12⟫⟪k:13⟫"
"⟪k:14⟫Diga-me, por favor.⟪k:15⟫⟪k:16⟫⟪k:17⟫Diga-me, como eu poderia?!"

#: search2:search2_508A1570_9B15_44CC_B46B_3B12B131CBDC
