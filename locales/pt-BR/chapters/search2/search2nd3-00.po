msgctxt "search2:search2_11369757_332F_4130_A71A_287590EB6D56"
msgid "⟪k:0⟫⟪k:1⟫“Without it, she’ll lose her church.”"
msgstr "⟪k:0⟫⟪k:1⟫“Sem isso, ela perderá sua igreja.”"

#: search2:search2_84C0E871_4E4E_4065_9055_55456FCCFBC0
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 141f7cc00cee367f9c56768cf712388bc19bbfa2412b4287238d151659d437c2
