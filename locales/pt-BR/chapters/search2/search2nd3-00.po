msgid "⟪k:0⟫⟪k:1⟫⟪k:2⟫“She needs the money.”"
msgstr "⟪k:0⟫⟪k:1⟫⟪k:2⟫“Ela precisa do dinheiro.”"

#: search2:search2_3C835617_FE2B_4BB6_A129_DC7164284E49
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 6f992aecdff6c3c610fe758115c969b8ea1232cc07aa177151ef00326c63ab7d
