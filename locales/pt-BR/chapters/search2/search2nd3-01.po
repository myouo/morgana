msgctxt "search2:search2_D1457BE5_C85C_468F_8ACF_0338463EBFED"
msgid "⟪k:0⟫Rgh... ⟪k:1⟫ngh... ⟪k:2⟫gggh!"
msgstr "⟪k:0⟫Rgh... ⟪k:1⟫ngh... ⟪k:2⟫gggh!"

#: search2:search2_02897E03_ADEA_4850_B4E8_EF06E8054C40
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: aa1acb69b9f06b7282ca40c59b8a50009472dde5007898fdb7f0290111a6f030
#. default-sha256: f56299002c747a7c47469cd48fd45bd5d9f3d18960fcfd488cf22daf5659ae7d
msgctxt "search2:search2_02897E03_ADEA_4850_B4E8_EF06E8054C40"
msgid "⟪k:0⟫But when my mouth opens to vomit, blood pours into it."
msgstr "⟪k:0⟫Mas quando minha boca se abre para vomitar, o sangue jorra nela."

#: search2:search2_6A45F86A_347A_4152_8DFF_AE847CA7BED5
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: adcad10c06ba76ae790a4de89f7797e4393a1d6f678e7151d42bbf3a98596a76
#. default-sha256: e0bdf2bca24d90d25f0812ba0edbccdc00a7fa40f7068588de78ae2741c086db
msgctxt "search2:search2_6A45F86A_347A_4152_8DFF_AE847CA7BED5"
msgid ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫⟪k:4⟫⟪k:5⟫⟪k:6⟫⟪k:7⟫⟪k:8⟫⟪k:9⟫⟪k:10⟫⟪k:11⟫⟪k:12⟫⟪k:13⟫Ah, ⟪k:14⟫aah, ⟪k:15⟫"
"aaaaagh...!⟪k:16⟫⟪k:17⟫Ngh... ⟪k:18⟫Let go of me!"
msgstr ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫⟪k:4⟫⟪k:5⟫⟪k:6⟫⟪k:7⟫⟪k:8⟫⟪k:9⟫⟪k:10⟫⟪k:11⟫⟪k:12⟫⟪k:13⟫Ah, ⟪k:14⟫aah, ⟪k:15⟫"
"aaaaagh...!⟪k:16⟫⟪k:17⟫Ngh... ⟪k:18⟫Me solte!"

