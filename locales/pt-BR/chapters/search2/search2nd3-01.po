msgctxt "search2:search2_3DEB4A48_EF59_4C2B_8BFC_3302FFFE69E9"
msgid ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫⟪k:4⟫⟪k:5⟫⟪k:6⟫⟪k:7⟫⟪k:8⟫⟪k:9⟫⟪k:10⟫⟪k:11⟫⟪k:12⟫⟪k:13⟫⟪k:14⟫⟪k:15⟫⟪k:16⟫⟪k:17⟫"
"⟪k:18⟫⟪k:19⟫Wrapped in absolute darkness,"
msgstr ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫⟪k:4⟫⟪k:5⟫⟪k:6⟫⟪k:7⟫⟪k:8⟫⟪k:9⟫⟪k:10⟫⟪k:11⟫⟪k:12⟫⟪k:13⟫⟪k:14⟫⟪k:15⟫⟪k:16⟫⟪k:17⟫"
"⟪k:18⟫⟪k:19⟫Envolto em absoluta escuridão,"

#: search2:search2_4326134B_FF7B_4A4B_8BD2_38D5522A15CA
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: cbe1210265d0374b3f18f56d1846dce679bd594e3eee65ad1ef4cc1df854c165
#. default-sha256: 0315cb418179510d72e864116715d42fd2a1d7cc416726c59ce22571a5ca8091
msgctxt "search2:search2_4326134B_FF7B_4A4B_8BD2_38D5522A15CA"
msgid "⟪k:0⟫⟪k:1⟫⟪k:2⟫warm blood spills onto my cheeks, my hair, my skin."
msgstr "⟪k:0⟫⟪k:1⟫⟪k:2⟫sangue quente derrama em minhas bochechas, meu cabelo, minha pele."

#: search2:search2_1412DDF5_ADB3_4A79_9474_163C095A2FAA
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 56b96dd7eaf81f540edefde461c66830d6a80afe67ab821a7b1f5b2ef3de7003
#. default-sha256: 075556d1de655ea6429133d17dfc23dc04b1f083b5ff4284f2d4d6b56adea530
msgctxt "search2:search2_1412DDF5_ADB3_4A79_9474_163C095A2FAA"
msgid "⟪k:0⟫⟪k:1⟫⟪k:2⟫Chunks of human flesh rain down on me."
msgstr "⟪k:0⟫⟪k:1⟫⟪k:2⟫Pedaços de carne humana chovem sobre mim."

#: search2:search2_D1457BE5_C85C_468F_8ACF_0338463EBFED
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 1437be19b47935434a3f8c2d69ba27d198c455911be3aafee4eb17095d442bd1
