msgctxt "search2:search2_C3C31414_3C27_45F6_A85E_DC497DD51F33"
msgid "⟪k:0⟫⟪k:1⟫⟪k:2⟫“Why... I never wanted her to die...⟪k:3⟫⟪k:4⟫⟪k:5⟫Was she not eating?!”"
msgstr ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫“Por que... eu nunca quis que ela morresse...⟪k:3⟫⟪k:4⟫⟪k:5⟫Ela não estava "
"comendo?!”"

#: search2:search2_5EF2B737_0293_40B2_83B5_54BF14C686A0
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 769ee1103eb49ef8930f9de47cd9fac609d62d3c52fa541622d9f9a368b04d21
