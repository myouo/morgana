#: badend5:badend5_121A7CDC_3548_4519_9C0D_1EACDCD8F100
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 216a6654997415e350c9eeef66759cab89a40164650a1113cec84f2be2ec5c28
#. default-sha256: 9bf5bf4df4afa24df795338b56c920a03f195426cac13d9829192073a9f539a2
msgctxt "badend5:badend5_121A7CDC_3548_4519_9C0D_1EACDCD8F100"
msgid "⟪k:0⟫Oh, ⟪k:1⟫um, ⟪k:2⟫sorry. I’m fine."
msgstr "⟪k:0⟫Ah, ⟪k:1⟫hum, ⟪k:2⟫desculpe. Estou bem."

#: badend5:badend5_14843988_FD1C_4853_853A_52A5802A150B
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 52cea5a71d764bac66031f7bc7dd539b9c64bd362dadfebabe8d59480fccdc01
#. default-sha256: f05b39d426d62958c5ae38a11508e58793bc0decb6f9c26194276506b54f69ec
msgctxt "badend5:badend5_14843988_FD1C_4853_853A_52A5802A150B"
msgid "⟪k:0⟫What were... ⟪k:1⟫you saying, again?"
msgstr "⟪k:0⟫O que você estava... ⟪k:1⟫dizendo mesmo?"

#: badend5:badend5_22A3A367_B50D_46BE_8D2A_00044CB8B667
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 8c8b8784a94aeb66aae63fb1be4bed8dd44bca79d34d2e1f1747220f43689f81
#. default-sha256: acc44a4a1d47a462c8c48bfa8c42ffafbaef20b32b6a61e7c9220411f709cfc7
msgctxt "badend5:badend5_22A3A367_B50D_46BE_8D2A_00044CB8B667"
msgid ""
"⟪k:0⟫Are you sure you’re okay?⟪k:1⟫⟪k:2⟫I was saying we need to settle on a destination for our "
"trip next month."
msgstr ""
"⟪k:0⟫Você tem certeza de que está bem?⟪k:1⟫⟪k:2⟫Eu estava dizendo que precisamos decidir um "
"destino para nossa viagem no mês que vem."

#: badend5:badend5_86396821_A704_466D_BDC8_B9DA192F8AC1
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 464faa778c83a3975f1f9995f7fb53fa73adcdcb06951ec26acaf7d9427785bc
#. default-sha256: 1af08167d4e741f7d0b18188b62f0d94e135229eca2f581474995edac0f47d06
msgctxt "badend5:badend5_86396821_A704_466D_BDC8_B9DA192F8AC1"
msgid "⟪k:0⟫Ahh... ⟪k:1⟫Anywhere you’d like is fine with me."
msgstr "⟪k:0⟫Ahh... ⟪k:1⟫Qualquer lugar que você quiser está bom para mim."

#: badend5:badend5_7B84C3A8_4D0F_4F9F_BAC2_E5C67DB83917
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 88dda609037318c2774065e1210b4c8ff5d473560ddec0b03ec2972c534cd43f
#. default-sha256: e3e4a8f7ce2cbb033476f819b8526d320a6c6ac15e5b713441967474df43b6bc
msgctxt "badend5:badend5_7B84C3A8_4D0F_4F9F_BAC2_E5C67DB83917"
msgid ""
"⟪k:0⟫Hehe... ⟪k:1⟫that’s always how it goes with you, isn’t it?⟪k:2⟫⟪k:3⟫You are allowed to have "
"an opinion of your own, you know."
msgstr ""
"⟪k:0⟫Hehe... ⟪k:1⟫é sempre assim que é com você, não é?⟪k:2⟫⟪k:3⟫Você tem o direito de ter sua "
"própria opinião, sabia."

#: badend5:badend5_8FAE56BF_1795_4ACC_B488_406EB3C79BEC
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 2231f21b6d4bf8f0d8f1d18b870a996104e61c1bcc00065eb8533c1bac5a40bd
#. default-sha256: d98fd00608d77112e24bd4a4ee57fff532820cccacfb1ab32e0de4fef405d146
msgctxt "badend5:badend5_8FAE56BF_1795_4ACC_B488_406EB3C79BEC"
msgid "⟪k:0⟫We’ll end up going to Prague again if you let me pick."
msgstr "⟪k:0⟫Acabaremos indo para Praga novamente se você me deixar escolher."

#: badend5:badend5_4F9A34C5_FB50_441D_A1C9_B99B9E40C585
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 0575411460752965a7ed2300a247c984aa6be1be1ca5f2539667e76969190678
#. default-sha256: 7506997ee4bfc407dfd4015fb5e4cc74c0a9b55b3db2456e93ed38ec40a2cb7e
msgctxt "badend5:badend5_4F9A34C5_FB50_441D_A1C9_B99B9E40C585"
msgid ""
"⟪k:0⟫There’s nothing wrong with Prague.⟪k:1⟫⟪k:2⟫We can go see Mucha’s stained-glass window at "
"the St. Vitus Cathedral and visit the Petřín Gardens again."
msgstr ""
"⟪k:0⟫Não há nada de errado com Praga.⟪k:1⟫⟪k:2⟫Podemos ir ver o vitral de Mucha na Catedral de "
"São Vito e visitar novamente os Jardins de Petřín."

#: badend5:badend5_DDC5A25E_7AAF_4FF8_957F_F3CCFF4C6A23
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: f4f89a43856617fd6380ef2b5100b149f06624e8b18bfdcb58746b256cd559b7
#. default-sha256: 3f7401ea92331f7a516100a0f95aaa034495d1c354294bb001df066a87a05b0f
msgctxt "badend5:badend5_DDC5A25E_7AAF_4FF8_957F_F3CCFF4C6A23"
msgid "⟪k:0⟫And maybe this time, we won’t be late for the Walk of the Apostles at the clock tower."
msgstr ""
"⟪k:0⟫E talvez desta vez não nos atrasemos para a Procissão dos Apóstolos na torre do relógio."

#: badend5:badend5_235E0583_6691_45E7_BA54_F8BFDE73790C
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: ed638e9c1682cd7b62449ceb59330bd80a7df8e599bbb1d99e08239c41b19ff1
#. default-sha256: fd4e8fb6912c659071f16da4b218f0e5653abcd28794b07f871151fade50d072
msgctxt "badend5:badend5_235E0583_6691_45E7_BA54_F8BFDE73790C"
msgid "⟪k:0⟫All right, then we should start looking at hotels."
msgstr "⟪k:0⟫Tudo bem, então devemos começar a procurar hotéis."

#: badend5:badend5_BE7D8084_75C7_447A_AA86_79065F6C5CC7
