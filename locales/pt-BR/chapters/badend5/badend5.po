#: badend5:badend5_BBEF13A2_BB0F_4A79_B501_E9A68ED3ECA9
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 7dca6246de1a8c188b3c17a97c4e4fc5d03e12f1e068d9ac9094b2f6a77ceb9d
#. default-sha256: 2ec0487593c3437e53dda8b4544743a656e064774ab38a1ca3f70baab9d58583
msgctxt "badend5:badend5_BBEF13A2_BB0F_4A79_B501_E9A68ED3ECA9"
msgid ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫⟪k:4⟫⟪k:5⟫⟪k:6⟫⟪k:7⟫⟪k:8⟫⟪k:9⟫⟪k:10⟫⟪k:11⟫⟪k:12⟫⟪k:13⟫⟪k:14⟫⟪k:15⟫⟪k:16⟫"
"You’ve made the right decision, Michel."
msgstr ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫⟪k:4⟫⟪k:5⟫⟪k:6⟫⟪k:7⟫⟪k:8⟫⟪k:9⟫⟪k:10⟫⟪k:11⟫⟪k:12⟫⟪k:13⟫⟪k:14⟫⟪k:15⟫⟪k:16⟫Você "
"tomou a decisão certa, Michel."

#: badend5:badend5_83564003_4394_490F_B68B_0F69DF183169
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: f97e3dbdefa74455d45849340d12da87b9183c9f8055d3803fb892d5c7905c78
#. default-sha256: ff271d1aeae71a352ec93d51ee03dcdb4bd3da81fa52934a7f8b142c58dd5131
msgctxt "badend5:badend5_83564003_4394_490F_B68B_0F69DF183169"
msgid "⟪k:0⟫Your tragic tale has finally come to an end."
msgstr "⟪k:0⟫Sua história trágica finalmente chegou ao fim."

#: badend5:badend5_B76F5D6E_10F3_4739_9D24_003030A012AB
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 90b51fe0d0f50c3a6753eb5529024d455da1223d3de7b24fc045ec768749c2ac
#. default-sha256: d4120e969ceed9cadc455a37909b4002116f50aba980b186e56bd9f99a5504d3
msgctxt "badend5:badend5_B76F5D6E_10F3_4739_9D24_003030A012AB"
msgid ""
"⟪k:0⟫You’re free from the grip of this cursed mansion—⟪k:1⟫⟪k:2⟫free to begin your life anew."
msgstr ""
"⟪k:0⟫Você está livre das garras desta mansão amaldiçoada—⟪k:1⟫⟪k:2⟫livre para recomeçar sua vida."

#: badend5:badend5_B5231881_9804_4A29_9A8D_C27497A519D2
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: e71d7c98a15f30596f53391266daeff083a09db8145a8b0b064a7474ae0a5daf
#. default-sha256: edcb3c30ff68f0edbf8a46e01a99e0d7bcfcb945fe94eecbe4fdaeb0db8f130a
msgctxt "badend5:badend5_B5231881_9804_4A29_9A8D_C27497A519D2"
msgid "⟪k:0⟫I wish you a wonderful life,"
msgstr "⟪k:0⟫Eu te desejo uma vida maravilhosa,"

#: badend5:badend5_D76E6452_7102_4582_A162_5866DDAB8A55
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: e2df7560e728b0f4b75090328ac46b9e5d3ff9778a35f0c0deb05eb1c517d5af
#. default-sha256: 5744a20209b4fa52b8ec12b5b3d01067c873bb24ed4b86903a3adfe79876c1e1
msgctxt "badend5:badend5_D76E6452_7102_4582_A162_5866DDAB8A55"
msgid "⟪k:0⟫richly fulfilling and abounding in light."
msgstr "⟪k:0⟫ricamente gratificante e abundante em luz."

#: badend5:badend5_60370D30_8D56_42CF_B457_4881616FC1D7
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: a8a90f36538801347597c4fb875597b226f17355b8b13664235c549221d7308d
#. default-sha256: b12431a596163ac88da0a25ef08e1af24921910f3e26c0272c65b0419a51409b
msgctxt "badend5:badend5_60370D30_8D56_42CF_B457_4881616FC1D7"
msgid ""
"⟪k:0⟫For you, my dear friend, I will not cast a curse,⟪k:1⟫⟪k:2⟫but give you my utmost blessing."
msgstr ""
"⟪k:0⟫Para você, meu caro amigo, não lançarei maldição,⟪k:1⟫⟪k:2⟫mas te darei minha maior bênção."

