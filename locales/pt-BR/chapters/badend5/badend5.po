msgstr "⟪k:0⟫............"

#: badend5:badend5_97113EAB_1C5C_404C_959A_3651C60A21A5
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 9f4dd5ec2fcd07f5d37a69704335c617b2bedab13bb3616204f70887671eea88
#. default-sha256: 734ec578578745284c0c5053026d966c513223005997e2928783354293df6c6a
msgctxt "badend5:badend5_97113EAB_1C5C_404C_959A_3651C60A21A5"
msgid "⟪k:0⟫It was a day just like any other."
msgstr "⟪k:0⟫Era um dia como qualquer outro."

#: badend5:badend5_16E70DB7_800A_4AB5_8915_E9E4B83CA6A1
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 34803443924d34cbc7516ae9fbb579ac3ad0f1c9dddfd431bc77eb22eb6ec577
#. default-sha256: 2b9920067a22d203b7a3b0205aa39186932e9ca17993e37b78eb2f60fb121e19
msgctxt "badend5:badend5_16E70DB7_800A_4AB5_8915_E9E4B83CA6A1"
msgid ""
"⟪k:0⟫A layer of clouds drifted slowly across the sky.⟪k:1⟫⟪k:2⟫We sat across from one another at "
"a café’s outdoor table."
msgstr ""
"⟪k:0⟫Uma camada de nuvens flutuava lentamente pelo céu.⟪k:1⟫⟪k:2⟫Nós nos sentamos um de frente "
"para o outro na mesa ao ar livre de um café."

#: badend5:badend5_08D685DB_E611_4FA5_A9DF_2AF90B2BA5B8
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
