msgid "⟪k:0⟫⟪k:1⟫Since you’re here, though, how would you like to take a little tour of the house?"
msgstr "⟪k:0⟫⟪k:1⟫Já que está aqui, que tal fazer um pequeno tour pela casa?"

#: omake:omake_2574838F_36C7_4107_9AF5_2F7E11A0C43F
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 3e8722ca546fe4beff5bae9ced4d98dab8f831e5ee655654a39913e92d2bc627
#. default-sha256: 5dfdc7621e9fe4ff503dc299da378cea149c474b6ceee97f1d835b6406f713ae
msgctxt "omake:omake_2574838F_36C7_4107_9AF5_2F7E11A0C43F"
msgid ""
"⟪k:0⟫I don’t know why you’re so excited about split ends...⟪k:1⟫⟪k:2⟫If my hair’s such a mess, "
"maybe I should just cut it all off."
msgstr ""
"⟪k:0⟫Não sei por que você fica tão empolgada com pontas duplas...⟪k:1⟫⟪k:2⟫Se meu cabelo está "
"essa bagunça toda, talvez eu devesse simplesmente cortar tudo."

#: omake:omake_0C0EE1DB_3843_4E39_AA33_F255BD48212B
