#: omake:omake_FA818BD6_BB3B_4F25_9C0C_5DBC194FFB00
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 2acb33dcca46cc035c1567dd41ec78520b11b98de357c7f9aa510aa64c6351b0
#. default-sha256: 21964827f3ad8a99fb6741d95e848cb6bf6f95acc2c762cd3f0f532fbadba47a
msgctxt "omake:omake_FA818BD6_BB3B_4F25_9C0C_5DBC194FFB00"
msgid "⟪k:0⟫Nor do I really think of myself that way.⟪k:1⟫⟪k:2⟫I’m hardly a paragon of virtue..."
msgstr ""
"⟪k:0⟫Nem realmente penso em mim desse jeito.⟪k:1⟫⟪k:2⟫Estou longe de ser um exemplo de virtude..."

#: omake:omake_144794EF_6F90_4486_983B_6646972FE572
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 955dd37fe74ddb0d2c91ddf67d27faae472e04b145a17a42496aa77d00c8aed6
#. default-sha256: bd2ca35dbc0ec5fc08961c37eb1081b69e37dc5070617c4104b6c83009d937ab
msgctxt "omake:omake_144794EF_6F90_4486_983B_6646972FE572"
msgid ""
"⟪k:0⟫Your circumstances in life forced you to repress yourself, and once you were free from those "
"restrictions in the final chapter, you were able to act as the man you truly are. Or something to "
"that effect."
msgstr ""
"⟪k:0⟫Suas circunstâncias de vida o forçaram a reprimir quem você era, e só quando se libertou "
"dessas amarras no capítulo final pôde agir como o homem que realmente é. Ou algo nesse sentido."

