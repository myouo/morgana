#: omake:omake_FC88912E_2931_41A4_92DD_9E4111F94673
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: a18bb7f2a80bfcf42c4c04dc5707ce95acf0200aeac18ea6679049330c56169d
#. default-sha256: 34a71bdeacb0df3f76344fce3423d13cd921986a36ddad6910b17cce1f283a44
msgctxt "omake:omake_FC88912E_2931_41A4_92DD_9E4111F94673"
msgid "⟪k:0⟫⟪k:1⟫⟪k:2⟫Well, never mind that for now."
msgstr "⟪k:0⟫⟪k:1⟫⟪k:2⟫Bem, deixa isso pra lá por enquanto."

#: omake:omake_842EAA67_89AC_4204_B51D_994B16A9A5B6
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: b30d22ed92c4b108127a2726e73f7d89191773bcfc08b4632493c11e8573662a
#. default-sha256: 06a6d259aa0c8f3843f48a57b2454ec84962bbcc4a0bed8dda4d1c78fe37501a
msgctxt "omake:omake_842EAA67_89AC_4204_B51D_994B16A9A5B6"
msgid ""
"⟪k:0⟫I would ask you what you thought of it,⟪k:1⟫but unfortunately, that is beyond even my powers."
msgstr ""
"⟪k:0⟫Eu até perguntaria o que você achou,⟪k:1⟫mas infelizmente isso está além até dos meus "
"poderes."

#: omake:omake_F9A09CB9_71D9_41BD_8D28_DFAE4B4D5048
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 1f2819b9259ffdf3419bab456ab1f59c8e29b05990d06330a1afe962d7c8172c
#. default-sha256: 845dc2326b1e3e305597372e3b2e7dc6a61122be5cb97b77fd443063e77489cb
msgctxt "omake:omake_F9A09CB9_71D9_41BD_8D28_DFAE4B4D5048"
msgid "⟪k:0⟫⟪k:1⟫⟪k:2⟫...You’ve got a strong stomach, at least."
msgstr "⟪k:0⟫⟪k:1⟫⟪k:2⟫...Pelo menos, você tem estômago forte."

#: omake:omake_3D14B59C_669A_473A_81E7_82B165B4E507
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: f302a6710a1ccdc9fb651a5aaed3e294346d60f082c3274d595f1b9bca4140dc
#. default-sha256: 636d35ed5e55f158d4f10ea88a12d0b7b2d63077daf9cc427192edd3e838519d
msgctxt "omake:omake_3D14B59C_669A_473A_81E7_82B165B4E507"
msgid ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫Before we begin our little trek, I would like to emphasize that this is,⟪k:3⟫as "
"the title implies, a look behind the curtains of ⟪k:4⟫The House in Fata Morgana⟪k:5⟫."
msgstr ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫Antes de começarmos nossa pequena caminhada, gostaria de enfatizar que isto é,⟪k:3⟫"
"como o título sugere, um olhar pelos bastidores de ⟪k:4⟫The House in Fata Morgana⟪k:5⟫."

#: omake:omake_8C0E56DE_602A_2D29_9429_071DD0D4C50A
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 38207cc622089167a3c52aedb27ab6f83a5a41e569d601a983b6295d5ee0a8ff
#. default-sha256: f6bb17f9231730f398894e9e3d98b1c9a780b7d52ab34cabe0440c246d866840
msgctxt "omake:omake_8C0E56DE_602A_2D29_9429_071DD0D4C50A"
msgid ""
"⟪k:0⟫⟪k:1⟫But should you choose to continue, I encourage you to do so knowing that what you’re "
"about to read does not in any way respect the tone of the game proper."
msgstr ""
"⟪k:0⟫⟪k:1⟫Mas, se decidir continuar, aviso que o que está prestes a ler não respeita de forma "
"alguma a atmosfera do jogo em si."

#: omake:omake_5973E007_064C_48B3_A4D6_641D2CD416FC
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: a96525d62b390cc9771e8339daa5172f878abbb8fcb3aae7394adde09cd16120
#. default-sha256: a5cfb00bde23add87841c47fc81d8375620d7f2bd4672ee5e838ed084390b06e
msgctxt "omake:omake_5973E007_064C_48B3_A4D6_641D2CD416FC"
msgid ""
"⟪k:0⟫You’ll be making your way into the heads of the staff themselves,⟪k:1⟫and I promise you—⟪k:2⟫"
"⟪k:3⟫it’s not a pretty sight."
msgstr ""
"⟪k:0⟫Você vai entrar na cabeça da própria equipe,⟪k:1⟫e eu lhe garanto—⟪k:2⟫⟪k:3⟫não é uma visão "
"bonita."

#: omake:omake_8A3E8667_5714_4479_945B_89A82141E83A
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: c61916055c41fbcb669939dd3082e80bdf565b7399b0edfff5f15b2e848869bc
#. default-sha256: 58c6bb78b46a17233162e9705688db3dbf43873ca3531588b876696c34ffc79d
msgctxt "omake:omake_8A3E8667_5714_4479_945B_89A82141E83A"
msgid "⟪k:0⟫Let us be off, then."
msgstr "⟪k:0⟫Então vamos."

#: omake:omake_0D388061_5E2E_478A_ACF1_CABD30013371
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: d19242f188eeb737bc18f7201d731dd78d450e80eb73d745d8c2ae14e9813cfd
#. default-sha256: de333da3a8648786fd90b69280e7403401a94334291160b8ccd4628205c928da
msgctxt "omake:omake_0D388061_5E2E_478A_ACF1_CABD30013371"
msgid ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫⟪k:4⟫⟪k:5⟫⟪k:6⟫Ah! I found another split end!⟪k:7⟫⟪k:8⟫Look, this one’s split "
"into three!"
msgstr ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫⟪k:4⟫⟪k:5⟫⟪k:6⟫Ah! Achei mais uma ponta dupla!⟪k:7⟫⟪k:8⟫Olha, esta se dividiu "
"em três!"

#: omake:omake_C02C6675_80EB_49E5_9A4B_007813BB63CA
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 517f88b988ba04a730fcc37a34df065b42c0581a6a8e88a005d4c8a03d559a6b
#. default-sha256: 9f9d04d70b2431b1bdd2d31c1b34947ba9fea065a905b62cdf04f9a7d97d256d
msgctxt "omake:omake_C02C6675_80EB_49E5_9A4B_007813BB63CA"
msgid ""
"⟪k:0⟫I-⟪k:1⟫I— ⟪k:2⟫⟪k:3⟫I didn’t actually mean that!⟪k:4⟫⟪k:5⟫I was just, ⟪k:6⟫you know, ⟪k:7⟫a "
"little overwhelmed at the time!⟪k:8⟫About how unexpectedly handsome you were!⟪k:9⟫But I couldn’t "
"bring myself to say it!"
msgstr ""
"⟪k:0⟫E-⟪k:1⟫eu— ⟪k:2⟫⟪k:3⟫eu não quis dizer aquilo de verdade!⟪k:4⟫⟪k:5⟫Eu só estava, ⟪k:6⟫sabe, "
"⟪k:7⟫um pouco atordoada na hora!⟪k:8⟫Com o quão inesperadamente bonito você era!⟪k:9⟫Mas não "
"consegui dizer!"

#: omake:omake_DE51EA4A_A870_40CF_91A4_9D835B779A79
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 01f2d2b41cb2a628f249b595cdae1f293c1493f6f2b250093fd7ee1f38b95570
#. default-sha256: d47b5fede435d5b5018a1a6bcfef7481b4934ff7d3179f9979e270e4cdf97635
msgctxt "omake:omake_DE51EA4A_A870_40CF_91A4_9D835B779A79"
msgid "⟪k:0⟫I hope you two sickening lovebirds spontaneously combust..."
msgstr "⟪k:0⟫Espero que vocês dois, pombinhos enjoativos, entrem em combustão espontânea..."

#: omake:omake_7F2F89CD_77AE_4D18_96BE_501ABA446818
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: b0f35f56bc2a8622e01999165ad5aa6a9efe268b43501ab467d4b0bc78451f8b
#. default-sha256: 39ead4a9bda27af2b4b283b2f46e7184f4432d8e233b5e47e4a2746c53e5e201
msgctxt "omake:omake_7F2F89CD_77AE_4D18_96BE_501ABA446818"
msgid ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫As the true master of this house, I am everywhere at all times.⟪k:3⟫⟪k:4⟫Even in "
"the bathrooms."
msgstr ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫Como a verdadeira senhora desta casa, eu estou em toda parte o tempo todo.⟪k:3⟫"
"⟪k:4⟫Até nos banheiros."

#: omake:omake_05A8DDD2_7450_494D_9A7A_1B323EC72C6E
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: df0a260f1d2cb331af3fa716ae7cd459dda40ee2f342e70ce40282029cc71cbf
#. default-sha256: 31989c1a6a9b7b735551bcd18605032acf0d7e33c9edc7b90794d09f32c27d64
msgctxt "omake:omake_05A8DDD2_7450_494D_9A7A_1B323EC72C6E"
msgid ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫I think that’s enough toilet humor for the time being.⟪k:3⟫⟪k:4⟫Especially in "
"front of our guest."
msgstr ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫Acho que já chega de humor de banheiro por enquanto.⟪k:3⟫⟪k:4⟫Especialmente na "
"frente do nosso convidado."

#: omake:omake_FD6983FC_6500_4BC7_BE9D_0AC6E8F24B4A
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: f39453016e47b007d5d93559aedcf6e8bbaf63eb0ac195a5302aff107c3dd36b
#. default-sha256: 4f9c542a639e3026d216f5c675d9d33c86140fc659f24f443daca4d62e2f5eac
msgctxt "omake:omake_FD6983FC_6500_4BC7_BE9D_0AC6E8F24B4A"
msgid "⟪k:0⟫⟪k:1⟫It just... ⟪k:2⟫never really seemed that way to me..."
msgstr "⟪k:0⟫⟪k:1⟫É que... ⟪k:2⟫nunca me pareceu bem assim..."

#: omake:omake_8BA87D65_BDE0_4565_B0AE_E16CA2BF4C6D
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 7d24a29754bc8e775bacd75286941ddc2ad5c1a0a56bb5921ec73734395c8cf9
#. default-sha256: e803ae5a07e12dbc71f026f7ea6929d5ed1eebe33ca22d9ebea1d40b04e3a035
msgctxt "omake:omake_8BA87D65_BDE0_4565_B0AE_E16CA2BF4C6D"
msgid ""
"⟪k:0⟫⟪k:1⟫But once you reclaimed yourself, you were most definitely playing the protagonist. ⟪k:2⟫"
"Especially the final chapter! You had me swooning by the end!"
msgstr ""
"⟪k:0⟫⟪k:1⟫Mas quando você se recuperou, aí sim estava claramente como protagonista. ⟪k:2⟫"
"Especialmente no capítulo final! No fim eu já estava desmaiando de amores!"

#: omake:omake_48AEFCD0_9BAB_438B_A1E5_5BD013A1151B
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 5d25b2e2fdb006b96c023a345d376e4432d19aa725fe69e5c7492fc37a4aadcf
#. default-sha256: 60d456d73e5587908e65e4236ca901a2c14f6c6e36a4eb1887c510530f83444e
msgctxt "omake:omake_48AEFCD0_9BAB_438B_A1E5_5BD013A1151B"
msgid ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫What do you think, my dear? ⟪k:3⟫What any respectable behind-the-scenes extra "
"would do, of course—"
msgstr ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫O que você acha, meu caro? ⟪k:3⟫O que qualquer figurante de bastidores respeitável "
"faria, claro—"

#: omake:omake_2A7F3CA3_1134_4621_BF76_8BE0B1176ACB
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 1ffde57c6facfbb8447ac9f127fbc085a6ba16d7acf7183085021c66ecd2d4b8
#. default-sha256: 656fc165ba8efc734012d57efabeb7d331ec705a1843b9e4087c46b3b5513db8
msgctxt "omake:omake_2A7F3CA3_1134_4621_BF76_8BE0B1176ACB"
msgid "⟪k:0⟫we’re going visit each room in the mansion and faff about like a bunch of fools."
msgstr "⟪k:0⟫vamos visitar cada cômodo da mansão e ficar enrolando como um bando de bobos."

#: omake:omake_060CE94C_E0AE_47B9_9D2B_6BC0BB35989D
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 2810cd08f8e5de7944d8a72d3ba52810e6f37e0f01cdd310e33cdb3fb539e06a
#. default-sha256: b10d82a68a4d62c3150b0936b91ec0a6453ec8e4e51fd231ecb20cc3c4dfeb9e
msgctxt "omake:omake_060CE94C_E0AE_47B9_9D2B_6BC0BB35989D"
msgid "⟪k:0⟫⟪k:1⟫............"
msgstr "⟪k:0⟫⟪k:1⟫............"

#: omake:omake_DD46117D_9ECB_4B85_BC2C_B5C1D59040E9
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 34beb79eb2fd4f128103f49ab88c44352358f8288276cb48f77767733297c52a
#. default-sha256: adb247c79abedda5892dfa11ff14a8d32344188f4a40e55e259a12cd3c28fa5a
msgctxt "omake:omake_DD46117D_9ECB_4B85_BC2C_B5C1D59040E9"
msgid ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫You can’t deny a lot of readers probably didn’t expect the creepy white-haired "
"recluse to turn out to be the main character."
msgstr ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫Você não pode negar que muitos leitores provavelmente não esperavam que o recluso "
"de cabelos brancos e aparência estranha acabasse sendo o protagonista."

#: omake:omake_AB7DE4F2_5BDB_46C5_B426_851B3684F16C
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 08c42a9b659cd7873a5654013abe84b0a3d526159682da0581c5b6390ac3e539
#. default-sha256: f75639c93e0e7df168a7cd6c2a0cf86a6cb0fe2cb6834d6059b733199fe03fd0
msgctxt "omake:omake_AB7DE4F2_5BDB_46C5_B426_851B3684F16C"
msgid ""
"⟪k:0⟫Though perhaps there are some people whose interpretations did not change throughout the "
"course of the tales."
msgstr ""
"⟪k:0⟫Embora talvez existam pessoas cuja interpretação não tenha mudado ao longo das histórias."

#: omake:omake_409E38F1_AD87_424A_9225_01F6D09C8F9D
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: db71378c02b2bc6adc47f97ca125ea67354cd168e95af73ec62d1886191d719a
#. default-sha256: 070f251530cfd1378ea735b4894a955db878dff38f190e246ce82bb976502518
msgctxt "omake:omake_409E38F1_AD87_424A_9225_01F6D09C8F9D"
msgid "⟪k:0⟫⟪k:1⟫No, that’s not how you pronounce his name.⟪k:2⟫⟪k:3⟫As I recall, it’s Eucalyptus—"
msgstr ""
"⟪k:0⟫⟪k:1⟫Não, não é assim que se pronuncia o nome dele.⟪k:2⟫⟪k:3⟫Se bem me lembro, é Eucalyptus—"

#: omake:omake_0563CC2F_1F91_4F15_AA9C_CA7CEC8E9CA9
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: f495e2b3294e03ad7b3711a62ccd00d91c0961e04385c586286dc397f5961814
#. default-sha256: 21efd349a049aac7076cba412d196b7063534caaa479444e8c5167e829021469
msgctxt "omake:omake_0563CC2F_1F91_4F15_AA9C_CA7CEC8E9CA9"
msgid ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫You already made that joke. Let it go, please.⟪k:3⟫⟪k:4⟫That creature doesn’t need "
"a name. Just call him “the beast.”"
msgstr ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫Você já fez essa piada. Deixe pra lá, por favor.⟪k:3⟫⟪k:4⟫Aquela criatura não "
"precisa de nome. Apenas chame de “a besta”."

#: omake:omake_E6ED0CF4_EA96_43F7_8609_288EDFB5E6DA
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 3447046c531df4a0b3b0d6fee739d91834cfaffcc041ca9b2affca0f65dbaed8
#. default-sha256: 517bd64718f2ef49aa3a99fd6c4b5d8bcc227079a7c988c1de3de85e7fe16ac2
msgctxt "omake:omake_E6ED0CF4_EA96_43F7_8609_288EDFB5E6DA"
msgid ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫At the end of that chapter, you learn what kind of man he really was, which then "
"ties into the revelations in the final chapter."
msgstr ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫No final daquele capítulo, você descobre que tipo de homem ele realmente era, o "
"que então se conecta às revelações do capítulo final."

#: omake:omake_C5A798EB_B811_4ED8_AFAC_A061A9511D1D
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: c74eec995e795ecc94e0c754a16c21d094c15d962b5e5505047668d20ea50db2
#. default-sha256: 801635a9c4b0c19349b03dced24cd5e56d12b606c0f3b9af33c5d46e0bc6fe1a
msgctxt "omake:omake_C5A798EB_B811_4ED8_AFAC_A061A9511D1D"
msgid "⟪k:0⟫⟪k:1⟫.................."
msgstr "⟪k:0⟫⟪k:1⟫.................."

#: omake:omake_50B816BD_A179_493D_9A53_C8C56CE248FA
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: ea002bb0577e67db5ab171bcb5a25de0fbe86f451c3670bb4cb4f3cb1fdf7839
#. default-sha256: 895a3ba2b6d017f49b9d9091ee2f72d3fc34652cf43119939361a1328499367c
msgctxt "omake:omake_50B816BD_A179_493D_9A53_C8C56CE248FA"
msgid "⟪k:0⟫I don’t hold it against you, though."
msgstr "⟪k:0⟫Não guardo rancor de você, porém."

#: omake:omake_6F5B9841_CFC1_491F_A9B2_FBB2DF203B6D
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: ba449d91ae6bf686705116dbf98862ff47fdcf933043902885edf45e9775a7aa
#. default-sha256: b10d82a68a4d62c3150b0936b91ec0a6453ec8e4e51fd231ecb20cc3c4dfeb9e
msgctxt "omake:omake_6F5B9841_CFC1_491F_A9B2_FBB2DF203B6D"
msgid "⟪k:0⟫⟪k:1⟫............"
msgstr "⟪k:0⟫⟪k:1⟫............"

#: omake:omake_0A72F11A_330D_41F5_9178_3472164D57AD
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: aa8b61c9cdfbe23a02db24ed6adf3f75c4c331e580b8820b8a9ece81a5a3431e
#. default-sha256: d020fd712d7d75c7f16c040cc6b3f5c3d861063663b6f61f2aac1df5688eba54
msgctxt "omake:omake_0A72F11A_330D_41F5_9178_3472164D57AD"
msgid ""
"⟪k:0⟫(I really need to peel these two apart. ⟪k:1⟫We’ll never finish if they keep making goo-goo "
"eyes at each other every ten seconds...)"
