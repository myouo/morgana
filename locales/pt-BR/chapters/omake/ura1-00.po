#: omake:omake_8F3B5A95_060E_4BAC_972A_F08911B67416
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 7edebb09b01708c1268f054e22888b87aa090b3f68d5f32b4676e2749ad07ac5
#. default-sha256: ca0f421e7308707ca205e615a66bdc637fa88e12de4907422cf8c2c1f512d92b
msgctxt "omake:omake_8F3B5A95_060E_4BAC_972A_F08911B67416"
msgid "⟪k:0⟫⟪k:1⟫The fact that you’re here means you’ve uncovered all the mansion’s mysteries, yes?"
msgstr ""
"⟪k:0⟫⟪k:1⟫O fato de você estar aqui significa que desvendou todos os mistérios da mansão, não é?"

#: omake:omake_33DB8421_3078_4DDB_BCC8_CC85C82A31C9
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 8b0f7ed5d885f73b6fcb342b30d91ea4151df492857b0110189865bf2950bdb1
#. default-sha256: 3a72f19cd3be3300aa1bed8a01938bb294b2e3023bc8c24671b5902c7b6810f6
msgctxt "omake:omake_33DB8421_3078_4DDB_BCC8_CC85C82A31C9"
msgid ""
"⟪k:0⟫⟪k:1⟫Hehe... ⟪k:2⟫My congratulations for having the fortitude to endure such a... ⟪k:3⟫grim "
"tale."
msgstr ""
"⟪k:0⟫⟪k:1⟫Hehe... ⟪k:2⟫Meus parabéns por ter a fibra de suportar uma... ⟪k:3⟫história tão sombria."

#: omake:omake_D63F2895_E50C_46E2_9865_90EE7DAEF191
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: ef68a002d8f5eec5eee52692bf3541d2e8e878e757294f65a2dff89bb773a206
#. default-sha256: 80ea3e33387dbc1ba356e879c3b7af34d69e3ec46706dfa6f55fd8ec3c48a4e9
msgctxt "omake:omake_D63F2895_E50C_46E2_9865_90EE7DAEF191"
msgid "⟪k:0⟫⟪k:1⟫⟪k:2⟫That is, if you’re willing to take this hand."
msgstr "⟪k:0⟫⟪k:1⟫⟪k:2⟫Isto é, se estiver disposto(a) a pegar esta mão."

#: omake:omake_A617AD89_AEC1_4805_99EF_AA6B38AE5A1E
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 0825a92823d72f30a9d2285e8809650350ba2583512763df4ea23eec01640b9f
#. default-sha256: a6ae5c9d424b69b0c2f4ba7d65090ae9cfd598a7b1cefb15f79c65082f67f723
msgctxt "omake:omake_A617AD89_AEC1_4805_99EF_AA6B38AE5A1E"
msgid ""
"⟪k:0⟫⟪k:1⟫That said, I would prefer not to have to guide you around the house all by myself. ⟪k:2⟫"
"Not because I have anything in particular against you, of course."
msgstr ""
"⟪k:0⟫⟪k:1⟫Dito isso, eu preferiria não ter que guiá-lo(a) pela casa sozinha. ⟪k:2⟫Não porque eu "
"tenha algo contra você, claro."

#: omake:omake_DA265B35_DB52_473A_9DE9_B33FBA039094
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 0e72b91e9d558ad969351839957404acfb6f6a5ef73c65005c1c6053732491d7
#. default-sha256: 27a71d6606dfef2195bd683b325bc62029c3d52c90d6a97b1392452a03e41f77
msgctxt "omake:omake_DA265B35_DB52_473A_9DE9_B33FBA039094"
msgid ""
"⟪k:0⟫⟪k:1⟫I simply think it would be inappropriate for him not to accompany us—⟪k:2⟫yes, him. "
"This story’s protagonist."
msgstr ""
"⟪k:0⟫⟪k:1⟫Só acho que seria inadequado ele não nos acompanhar—⟪k:2⟫sim, ele. O protagonista desta "
"história."

#: omake:omake_0794DE9D_FE35_4A86_8F75_5AD32CE22656
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: f14e54cc1824d7634a7a21f6bb6300f3a338ef28293bdb60c4891ab03e36238a
#. default-sha256: af55cd751d28ccd1b108cdb4c1fc4f4a27838d83d62a3b61496a58a21f65557e
msgctxt "omake:omake_0794DE9D_FE35_4A86_8F75_5AD32CE22656"
msgid ""
"⟪k:0⟫⟪k:1⟫D-⟪k:2⟫Don’t worry! When I was in her position, I closed my eyes and plugged my ears "
"when you were doing your business!"
msgstr ""
"⟪k:0⟫⟪k:1⟫N-⟪k:2⟫não se preocupe! Quando eu estava na posição dela, eu fechava os olhos e tampava "
"os ouvidos quando você estava fazendo... suas necessidades!"

#: omake:omake_C86A283F_EF5F_4910_9E27_FEEE835E9822
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 9b2df334e0e4cd0e784e3f0ae645ecd9afe176e2795617645086fe3a086d284d
#. default-sha256: b408288c1eb4d8798d78f29c40c92c3b8df8f472f3d21589e110618e09b58792
msgctxt "omake:omake_C86A283F_EF5F_4910_9E27_FEEE835E9822"
msgid "⟪k:0⟫⟪k:1⟫⟪k:2⟫In some ways, you could call the first four chapters an extended prologue."
msgstr ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫De certo modo, dá até pra chamar os quatro primeiros capítulos de um prólogo "
"estendido."

#: omake:omake_04EFEC16_E072_4AAB_8F7F_27F92146FDB2
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 86dbf66e28c8dd2bb2a379e1537cc8926ba6755b0090bb3306165b607ce9daa9
#. default-sha256: dc952a4ee65a87ba7135f9ab7e1623ebf0b0564146df86da224239912d37e30e
msgctxt "omake:omake_04EFEC16_E072_4AAB_8F7F_27F92146FDB2"
msgid "⟪k:0⟫⟪k:1⟫Aww! What about me?!"
msgstr "⟪k:0⟫⟪k:1⟫Ahh! E eu?!"

#: omake:omake_FAE92C38_A7AE_47BC_988B_8D0A204B48A5
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 1969c4221596ddafba7a06573362aed1d8eb20a85ae16fc234ccf9cd897e8abc
#. default-sha256: 483fafedb061bed3a45e1c2595f2a0494d22dddd83734224d36d21dcb38b164f
msgctxt "omake:omake_FAE92C38_A7AE_47BC_988B_8D0A204B48A5"
msgid ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫Because with you around, he turns into a lovesick, airheaded dope. ⟪k:3⟫He’s about "
"as useful to me as a wet paper sack full of potatoes."
msgstr ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫Porque com você por perto ele vira um bobão apaixonado e avoado. ⟪k:3⟫Pra mim, ele "
"fica tão útil quanto um saco de papel molhado cheio de batatas."

#: omake:omake_01DFD587_996F_4535_AD66_8069416148E1
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 862000f83e7b7e32c9b32aebd2f9218b9c29ed861c02863de685593b86ef09f7
#. default-sha256: 7c4f23778a23dc8aeb9261a44a5a6c85b36e70d4571b187d20125cbdf3c5af9b
msgctxt "omake:omake_01DFD587_996F_4535_AD66_8069416148E1"
msgid "⟪k:0⟫⟪k:1⟫⟪k:2⟫Absolutely not.⟪k:3⟫⟪k:4⟫You spoil him—⟪k:5⟫⟪k:6⟫in more ways than one."
msgstr "⟪k:0⟫⟪k:1⟫⟪k:2⟫De jeito nenhum.⟪k:3⟫⟪k:4⟫Você mima ele—⟪k:5⟫⟪k:6⟫e não é só de um jeito."

#: omake:omake_00458DC6_24DD_49A1_9A44_7913F792FA41
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 2488c3f14dfbfdba75ee2b9ed055624d3ff197cc355b4ae28b4230fc18ff7306
#. default-sha256: ccb708afa88c1cef22887c5b36e3677660ccbc6667064b1f8f7e08ac35b905ca
msgctxt "omake:omake_00458DC6_24DD_49A1_9A44_7913F792FA41"
msgid "⟪k:0⟫⟪k:1⟫What are we going to do, though?"
msgstr "⟪k:0⟫⟪k:1⟫Mas o que é que a gente vai fazer?"

#: omake:omake_0A87396A_6CA3_4EBB_A1DC_2E718908DE9B
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: da10b5fa22fd6d619c2b9f91cd73ff48c8bf15465a0166ac363695db6528dc69
#. default-sha256: 4f28639ab600cb53f8addf74d362736bc65836f090ed2815eba9f0e7039dde52
msgctxt "omake:omake_0A87396A_6CA3_4EBB_A1DC_2E718908DE9B"
msgid ""
"⟪k:0⟫⟪k:1⟫I seem to recall plenty of faffing about in the main game anyway;⟪k:2⟫⟪k:3⟫⟪k:4⟫why "
"don’t we do something we ⟪k:5⟫couldn’t⟪k:6⟫ do there?"
msgstr ""
"⟪k:0⟫⟪k:1⟫Tenho a impressão de que já houve bastante enrolação no jogo principal;⟪k:2⟫⟪k:3⟫⟪k:4⟫"
"por que não fazemos algo que ⟪k:5⟫não podíamos⟪k:6⟫ fazer lá?"

#: omake:omake_3270FD07_2CA5_4EB1_A3EC_A58FAF8F9135
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 0a53b7f53317e2c82798794dace1b09fb49b6d40b25d37601738332e7bf526e8
#. default-sha256: 0194d7f5c617b0365dd8aa665fec67b44dde76b703d36f75a20c681d612b9e1a
msgctxt "omake:omake_3270FD07_2CA5_4EB1_A3EC_A58FAF8F9135"
msgid ""
"⟪k:0⟫⟪k:1⟫They’ve got profiles and other miscellaneous notes from the creators about each of the "
"characters. ⟪k:2⟫I thought they might come in handy."
msgstr ""
"⟪k:0⟫⟪k:1⟫Eles têm perfis e outras notas variadas dos criadores sobre cada um dos personagens. "
"⟪k:2⟫Achei que poderiam ser úteis."

#: omake:omake_D9720B49_BE4B_4233_AD85_F5EE3AB8852A
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 7d4fb063706d74b4b418fa2feebdb5b68dbee384bcdc1fec3e6b401edf999cdd
#. default-sha256: 105e40822882e4d9e2771991ef42ac5c85c1f1190222ed68b4308f019b580596
msgctxt "omake:omake_D9720B49_BE4B_4233_AD85_F5EE3AB8852A"
msgid ""
"⟪k:0⟫⟪k:1⟫I can see them being useful, yes...⟪k:2⟫⟪k:3⟫but why exactly do you ⟪k:4⟫have⟪k:5⟫ "
"those?"
msgstr ""
"⟪k:0⟫⟪k:1⟫Consigo ver como podem ser úteis, sim...⟪k:2⟫⟪k:3⟫mas por que exatamente você ⟪k:4⟫"
"tem⟪k:5⟫ esses cartões?"

#: omake:omake_B908C0B0_A59E_4A40_A466_5B4855F5E803
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: da3863fd95e9ac02318c53a98c4e64424427117cfacae65816e884ee4849a0c7
#. default-sha256: e01f4e812391707750885cd820f9af779185f3c6a3c59ee2e45c3328b5795764
msgctxt "omake:omake_B908C0B0_A59E_4A40_A466_5B4855F5E803"
msgid "⟪k:0⟫⟪k:1⟫(I’d rather pretend those miniaturized ⟪k:2⟫things⟪k:3⟫ were not actually us...)"
msgstr ""
"⟪k:0⟫⟪k:1⟫(Eu preferiria fingir que aquelas versões miniaturizadas ⟪k:2⟫não⟪k:3⟫ éramos nós de "
"verdade...)"

#: omake:omake_0410FEE1_869D_46D3_9374_1966D808C9F3
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: df90237a53ebbdef28744053a225ee614bf8027e990777f315278a8ee1103d05
#. default-sha256: b071ea05ae5bd29fbd1de03ce404f95706e2a501354e9400046f0c0717149113
msgctxt "omake:omake_0410FEE1_869D_46D3_9374_1966D808C9F3"
msgid "⟪k:0⟫⟪k:1⟫⟪k:2⟫Hand over the cue cards."
msgstr "⟪k:0⟫⟪k:1⟫⟪k:2⟫Passe os cartões de referência."

#: omake:omake_523CA8EE_C152_D46E_6915_5E57E7AB78F5
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 1c3a1fb4f8987b26f4c654f0877a3a0dcab7ac682adbed25fdb291c8922b2bf8
#. default-sha256: 0728a70d14fa3f465101e9e1da649a062f1cf460cf81ebe758ff1a87d1470ba9
msgctxt "omake:omake_523CA8EE_C152_D46E_6915_5E57E7AB78F5"
msgid ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫According to this, two of the creators’ goals for this game were to subvert "
"readers’ expectations and cast new light on old information the farther you progressed through "
"the story."
msgstr ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫De acordo com isto, dois dos objetivos dos criadores para este jogo eram subverter "
"as expectativas dos leitores e lançar nova luz sobre informações antigas à medida que se avançava "
"pela história."

#: omake:omake_7B6F174A_D4E5_B493_7D56_89C3D06E0122
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: e0fb77e1ecb322ec98c49998943b6225fb74f1dad12d5008220718298d816a48
#. default-sha256: 7c3cdadb215fdb0f3131c68ef09bb477f5199fbc24f59e350e8f61af0b579649
msgctxt "omake:omake_7B6F174A_D4E5_B493_7D56_89C3D06E0122"
msgid ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫Even before the focal point of the game—⟪k:3⟫⟪k:4⟫my story—⟪k:5⟫⟪k:6⟫was revealed, "
"there were examples of lines or events taking on new meaning as each of the first three chapters "
"developed."
msgstr ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫Mesmo antes do ponto central do jogo — ⟪k:3⟫⟪k:4⟫a minha história — ⟪k:5⟫⟪k:6⟫ser "
"revelado, já havia exemplos de falas ou eventos ganhando novos significados à medida que cada um "
"dos três primeiros capítulos se desenvolvia."

#: omake:omake_4043095C_4868_46C9_9D44_88A2E7235295
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: a9f918b61af48eb43a6ae422cae15e7d9f553b075a0a859f61d78167e8febf36
#. default-sha256: 84574cf7e89b4c509a6a9ec3d7febdb906e5bc93d7a82ebcb1af9f6072b83a8f
msgctxt "omake:omake_4043095C_4868_46C9_9D44_88A2E7235295"
msgid ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫The second chapter was pretty crazy too!⟪k:3⟫⟪k:4⟫When we found out about, ⟪k:5⟫"
"uh, ⟪k:6⟫Ukulele, that was it!"
msgstr ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫O segundo capítulo foi bem louco também!⟪k:3⟫⟪k:4⟫Quando descobrimos sobre, ⟪k:5⟫"
"ah, ⟪k:6⟫Ukulele, aí foi demais!"

#: omake:omake_FB1C8C58_BDE7_4C25_A96D_8C079BBFE140
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 9b5a59f9b7bceff0aebc6df060030788c370006bae064738e2453f9bf2f0e562
#. default-sha256: bb773e48a7560c9dd42f8d759a8aa4599a7cb068451643566bf17702360a2c61
msgctxt "omake:omake_FB1C8C58_BDE7_4C25_A96D_8C079BBFE140"
msgid ""
"⟪k:0⟫A-⟪k:1⟫Ahaha.⟪k:2⟫⟪k:3⟫Chapter three was something else too.⟪k:4⟫⟪k:5⟫My impression of "
"Jacopo and Maria had completely turned around by the end."
msgstr ""
"⟪k:0⟫A-⟪k:1⟫Ahaha.⟪k:2⟫⟪k:3⟫O terceiro capítulo também foi algo e tanto.⟪k:4⟫⟪k:5⟫Minha impressão "
"de Jacopo e Maria mudou completamente até o fim."

#: omake:omake_54FAF5B0_AB1F_4D4B_8DD6_4EB27BAB9EC3
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 024a3a3fa6d3213817d336a6f9d8ee178ed4e700b181e8bebfe796dfdb63d5d1
#. default-sha256: ffc33c02299dc86e34f92ba0631877f37ac126be7f9d0952d1def368c2f193e3
msgctxt "omake:omake_54FAF5B0_AB1F_4D4B_8DD6_4EB27BAB9EC3"
msgid "⟪k:0⟫Piles of human garbage, the three of them."
msgstr "⟪k:0⟫Montes de lixo humano, os três."

#: omake:omake_4A3B06DA_3318_4B85_897A_EFAC99CB3699
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 05adf891a3f4adc0b877a1749f35237fd533798cd1da1117098ae5fdd2953526
#. default-sha256: a139a85517c2c022ef973a3087c53262b58bde785794d3a3e2acbb7a72456957
msgctxt "omake:omake_4A3B06DA_3318_4B85_897A_EFAC99CB3699"
msgid "⟪k:0⟫⟪k:1⟫..................⟪k:2⟫⟪k:3⟫Wha?"
msgstr "⟪k:0⟫⟪k:1⟫..................⟪k:2⟫⟪k:3⟫Quê?"

#: omake:omake_AF459C50_7428_4E06_B52B_E61DDFA1FC42
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 69987e3a3e8ccb8c40bc9fba4f71621786933a36c37d3b486d3cb58e0d0d8cdc
#. default-sha256: 5a09bf875dbd66abf4a38e2576b9663dcaf07c8bed201a55eca3fd06810501b5
msgctxt "omake:omake_AF459C50_7428_4E06_B52B_E61DDFA1FC42"
msgid ""
"⟪k:0⟫⟪k:1⟫I, ⟪k:2⟫um... ⟪k:3⟫wasn’t expecting something so...⟪k:4⟫⟪k:5⟫flattering to come out of "
"your mouth..."
msgstr ""
"⟪k:0⟫⟪k:1⟫Eu, ⟪k:2⟫ah... ⟪k:3⟫não esperava algo tão...⟪k:4⟫⟪k:5⟫lisonjeiro saindo da sua boca..."

#: omake:omake_015D16D7_B9C9_4D89_A4A6_0559A858ADB1
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 8ccb322db436c1fcdebdb4229a1bbd399bd1d6f16f2b68f892b497e230711391
#. default-sha256: ffd4a26c1f9b537910f76db63ed337ff111d5af0ba747bf9f878626c95ba530c
msgctxt "omake:omake_015D16D7_B9C9_4D89_A4A6_0559A858ADB1"
msgid "⟪k:0⟫⟪k:1⟫⟪k:2⟫That’s true.⟪k:3⟫⟪k:4⟫Putting a knife to a woman’s neck isn’t very righteous."
msgstr ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫Isso é verdade.⟪k:3⟫⟪k:4⟫Apontar uma faca para o pescoço de uma mulher não é nada "
"justo."

#: omake:omake_C5E64966_43BC_4099_8D0D_6DA0BD579942
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 7c6177037f0fa2b744951a0bf3dc5619b3d8571c5e37533bb96eb8c24d373a7f
#. default-sha256: 152a523d8ab969786e433b1926663e9d19e1ac73c3384c60cd34223da808d634
