msgid "⟪k:0⟫It was only a few, short seconds,"
msgstr "⟪k:0⟫Foram apenas alguns poucos segundos,"

#: badend4:badend4_455C04DF_3FC9_44B9_A371_3FCBD45D2299
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 69fab1b84ae43b49c1a625e3f50522baa2cca4e64e2c22b4fe6dec02b3039df5
#. default-sha256: 1a61572ccdd42a5347e3d96ef3eb94f0729dd4ec4ebafe8ab5962eca4caa434e
msgctxt "badend4:badend4_455C04DF_3FC9_44B9_A371_3FCBD45D2299"
msgid "⟪k:0⟫but those seconds decided it all."
msgstr "⟪k:0⟫mas aqueles segundos decidiram tudo."

