#: badend4:badend4_9E3B30D7_BD5E_48D5_89AA_0E599A990788
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 76340944885af6cad529233d98d00337c9bc7029381f325fd530bffb3cb6802c
#. default-sha256: 378ce0147226e793f67bb82351906fb1adb1a47813549af93f66e98b91e5b2ce
msgctxt "badend4:badend4_9E3B30D7_BD5E_48D5_89AA_0E599A990788"
msgid ""
"⟪k:0⟫I reach my hand out, but I cannot grasp anything.⟪k:1⟫⟪k:2⟫Her hand—⟪k:3⟫⟪k:4⟫the hand I "
"held for all this time—⟪k:5⟫⟪k:6⟫is so far away."
msgstr ""
"⟪k:0⟫Estendo a mão, mas não consigo agarrar nada.⟪k:1⟫⟪k:2⟫A mão dela—⟪k:3⟫⟪k:4⟫a mão que segurei "
"por todo esse tempo—⟪k:5⟫⟪k:6⟫está tão longe."

#: badend4:badend4_ED24E8C2_97DA_4BC6_A2E8_6FD2942EF79E
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: b6016a905daa5a8307d1b77b2d5f893b133de54c30c0a7cc9532d5c89c7401c6
#. default-sha256: 74195a2fb0d948bde1e465397316e3d85d26bec054900120246f8b6fce9331e2
msgctxt "badend4:badend4_ED24E8C2_97DA_4BC6_A2E8_6FD2942EF79E"
msgid ""
"⟪k:0⟫I try to shout, but nothing comes out.⟪k:1⟫⟪k:2⟫I can neither answer her original question..."
msgstr ""
"⟪k:0⟫Tento gritar, mas não sai nada.⟪k:1⟫⟪k:2⟫Eu não consigo nem responder à pergunta original "
"dela..."

#: badend4:badend4_E4AC1FC8_4D3A_4AC0_A5B4_BCB978B1B26F
