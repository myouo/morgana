msgctxt "scenario:scenario_2E56EF2D_57B0_499F_B806_64AAED789BC8"
msgid "⟪k:0⟫Okay..."
msgstr "⟪k:0⟫Tá..."

#: scenario:scenario_5DD066D5_F911_4923_8D23_5AFFFF403A43
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: e9e4a26f3cf1697fd58ae45cb56d1d6ffafa173a739d8669d11e2a95235e67ae
#. default-sha256: 3f813133b5661ded7ce3ea21dde09e39761dd3a1ad67fb965b30b2a7eedda82f
msgctxt "scenario:scenario_5DD066D5_F911_4923_8D23_5AFFFF403A43"
msgid "⟪k:0⟫And then, the girl grew up."
msgstr "⟪k:0⟫E então, a menina cresceu."

#: scenario:scenario_3ABF5463_D001_4F4A_A6C9_1C2026CFA592
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 99f5d6389fe85e50709f9f174a5da337bd9d97380f612121cb05d46a42ca41e5
#. default-sha256: 91afd7dd22b6e66007ee0c3e8381ffa102a2283247cb35293033511b3508f830
msgctxt "scenario:scenario_3ABF5463_D001_4F4A_A6C9_1C2026CFA592"
msgid ""
"⟪k:0⟫By then, she had already forgotten why she was locked up.⟪k:1⟫But she was content with the "
"darkness."
msgstr ""
"⟪k:0⟫Nessa altura, ela já havia esquecido por que estava trancada.⟪k:1⟫Mas ela estava contente "
"com a escuridão."

#: scenario:scenario_75F3E623_5F82_40D5_9D38_FBAA6F03E566
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 3e8a87da9ccc19af99aadc62c95159066598e543af3e77b8517259eb19c6b8af
#. default-sha256: a79d3d731828ba16fb0bd19d0e6f8b7df46f337b7ab29655915f322e812dbcb6
msgctxt "scenario:scenario_75F3E623_5F82_40D5_9D38_FBAA6F03E566"
msgid ""
"⟪k:0⟫However, her eyes couldn’t help but be drawn to the little bit of light that spilled through "
"the one window."
msgstr ""
"⟪k:0⟫No entanto, seus olhos não podiam deixar de ser atraídos para o pouco de luz que se "
"derramava pela única janela."

#: scenario:scenario_A1CE68A2_61F6_4F65_ABFC_0CB2CA4A3E84
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 34cb4dac9ed19ea00110fa5c26020f666f7cf93db326abac1701bb95561839f0
#. default-sha256: 892c0b80d04117ddac804dc5884252fbf40629ee12927ecd429768f8ddbd66d5
msgctxt "scenario:scenario_A1CE68A2_61F6_4F65_ABFC_0CB2CA4A3E84"
msgid "⟪k:0⟫Though she was comfortable in the darkness, the sight of the light made her heart race."
msgstr "⟪k:0⟫Embora estivesse confortável na escuridão, a visão da luz fazia seu coração disparar."

#: scenario:scenario_C81E3409_A993_4D5C_9C3D_6A9C97AD8171
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 1bd73ca529ce391464314d27df351b0c0c7da0e32138f60ae9443a48cbcd55fe
#. default-sha256: bf773a153a0dbd0acd7876866daf1579ecbd37e043cfc87b3c3d635489a6a04f
msgctxt "scenario:scenario_C81E3409_A993_4D5C_9C3D_6A9C97AD8171"
msgid ""
"⟪k:0⟫At first, the girl thought it was because she found it unpleasant.⟪k:1⟫Because she disliked "
"the light, and the outside.⟪k:2⟫⟪k:3⟫But slowly she came to realize..."
msgstr ""
"⟪k:0⟫A princípio, a garota pensou que era porque considerava desagradável.⟪k:1⟫Porque ela não "
"gostava da luz e do lado de fora.⟪k:2⟫⟪k:3⟫Mas aos poucos ela foi percebendo..."

#: scenario:scenario_7C3F21D2_96F0_4230_AECB_D134EDD86581
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 7ef8e8835408b4ad778e75c8b19619ed163ce07f5506739b3a4d9b818cab5b0a
#. default-sha256: 9918e8362625c2fbb8f11556c9057f932a3a476089558b28d2774cf3d62d2895
msgctxt "scenario:scenario_7C3F21D2_96F0_4230_AECB_D134EDD86581"
msgid "⟪k:0⟫that she was curious about the outside world."
msgstr "⟪k:0⟫que ela estava curiosa sobre o mundo exterior."

#: scenario:scenario_0BDEAF15_C627_4CAD_B87A_AAEA6E7F867C
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 02d49465ec6838da5047d4cc7a33243fe81328486d866b2d50507156888f2bfc
#. default-sha256: bc7e628a4c1894e2ac977ef448ebfb574cae2ed28c0681609c95eb00a0f85b73
msgctxt "scenario:scenario_0BDEAF15_C627_4CAD_B87A_AAEA6E7F867C"
msgid "⟪k:0⟫What could be happening out there?"
msgstr "⟪k:0⟫O que pode estar acontecendo lá fora?"

#: scenario:scenario_9A21B5F7_B0D2_4077_979B_BAA779AA217A
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 15625d187c515f11a37836fc2769973a38c1cdfbfcf1d7f4be5d685bfc0e008c
#. default-sha256: 57a019571f9d0870d8059f85b2131a2f9e423ea7c0c2a7452eced31ee73ac72a
msgctxt "scenario:scenario_9A21B5F7_B0D2_4077_979B_BAA779AA217A"
msgid ""
"⟪k:0⟫For all she knew, the town, the forest, the people, all of it could have changed while she "
"was imprisoned in the mansion."
msgstr ""
"⟪k:0⟫Até onde ela sabia, a cidade, a floresta, as pessoas, tudo isso poderia ter mudado enquanto "
"ela estava aprisionada na mansão."

#: scenario:scenario_56598AB9_8974_4EB1_91E2_584F878B7EFC
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: abe3de716d107d233c0dc38041c15e91ee50e2d9a00c3a3f4e9cee0ecccf2f4f
#. default-sha256: eb0066908ccbeb4bfd4c4a1ac15d670795722d5b8fb8c7ba9deb77f2d33aa710
msgctxt "scenario:scenario_56598AB9_8974_4EB1_91E2_584F878B7EFC"
msgid "⟪k:0⟫But she had no way of finding out."
msgstr "⟪k:0⟫Mas ela não tinha como saber."

#: scenario:scenario_F19D5998_9D81_4477_B7BC_5C48035A7549
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 5f88777ecd6bc5bf100a047ed27f87a273f79dc14ce79989fc4e06987a47270a
