#: scenario:scenario_22DA36E8_B82A_485F_B079_E626A6377134
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 31e70229fb12ff9e6c5d94f8a418dd3a2f44d0b8954f797e48dedbf915458c7f
#. default-sha256: cf0ce430006f6dcba2a63b2ae40d5a881b69b2b1d1921401b15ba28d07360cb1
msgctxt "scenario:scenario_22DA36E8_B82A_485F_B079_E626A6377134"
msgid ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫⟪k:4⟫⟪k:5⟫⟪k:6⟫⟪k:7⟫⟪k:8⟫Ahaha!⟪k:9⟫Sorry, sorry.⟪k:10⟫I didn’t mean to scare "
"you."
msgstr ""
