msgid "⟪k:0⟫⟪k:1⟫(Though... ⟪k:2⟫why is she disappointed with me?)"
msgstr "⟪k:0⟫⟪k:1⟫(No entanto... ⟪k:2⟫por que ela está desapontada comigo?)"

#: scenario:scenario_4E973416_1EE7_46FA_86CD_CB839058D2EE
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 7fd71b7463fdcc51d93b3efca38794346de624627190e41835b2c1055317f139
#. default-sha256: 13b0bb13805f7e5de4086c0efa239ca954348575a65498bcb91cb1ee88693344
msgctxt "scenario:scenario_4E973416_1EE7_46FA_86CD_CB839058D2EE"
msgid "⟪k:0⟫⟪k:1⟫Uggggh, I think I’m done with birthday parties after this year."
msgstr "⟪k:0⟫⟪k:1⟫Aaaaah, eu acho que já deu de festas de aniversário depois deste ano."

#: scenario:scenario_F4C7CEBA_FFC0_4989_80F1_0B18359A4581
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: efb6e60e269dac14f33001afb1a830e3b240e5903207223a56c0a0ed7f1c8179
