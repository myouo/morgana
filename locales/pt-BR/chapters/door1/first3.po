msgctxt "scenario:scenario_C20CD433_B0CD_417B_B181_C24666F35234"
msgid "⟪k:0⟫⟪k:1⟫(But I think that ⟪k:2⟫is⟪k:3⟫ true for you, Nellie.)"
msgstr "⟪k:0⟫⟪k:1⟫(Mas eu acho que isso ⟪k:2⟫é⟪k:3⟫ verdade para você, Nellie.)"

#: scenario:scenario_BA226F13_9347_408F_AC5B_C26B4A5BDFB0
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: a054e98c08d6b94a3a45305fe173779a900538aadb6bc83191975fb8d5c0d0bc
