msgid "⟪k:0⟫⟪k:1⟫What’s the matter, Nellie?⟪k:2⟫⟪k:3⟫You look exhausted."
msgstr "⟪k:0⟫⟪k:1⟫O que houve, Nellie?⟪k:2⟫⟪k:3⟫Você parece exausta."

#: scenario:scenario_25B59912_86D9_4430_A5F0_DB07F0529EDC
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 94a04fa46c95f0201df29d6df1683eeb9c488bdd52b6f6d9ff02c28790aab7be
