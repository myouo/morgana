msgctxt "scenario:scenario_287512F0_CF6F_4350_BE3A_A53B0D268FEB"
msgid ""
"⟪k:0⟫He ordered the servants to investigate, had the music restarted, gave a short apology for "
"the interruption, and set the party back on course."
msgstr ""
"⟪k:0⟫Ele ordenou que serviçais investigassem, recomeçou a música, desculpou-se brevemente pela "
"interrupção e colocou a festa nos trilhos novamente."

#: scenario:scenario_E9C09BAB_174B_4898_8822_042911CEB06C
