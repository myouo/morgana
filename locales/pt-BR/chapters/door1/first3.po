msgctxt "scenario:scenario_DA8B5329_49DB_4C6C_923F_FEDFDFE8DDA8"
msgid "⟪k:0⟫⟪k:1⟫You disappoint me, dearest Mell."
msgstr "⟪k:0⟫⟪k:1⟫Você me desaponta, querido Mell."

#: scenario:scenario_149349B0_AE96_4EFA_889E_E106147B1CB6
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 8530659c807c8fdeefad1fd409a3f25f90a235fe5b29128d6c1e1f77c4134d3e
