msgctxt "scenario:scenario_DCB893DC_6670_47A0_BD44_6606BE247DA5"
msgid "⟪k:0⟫⟪k:1⟫Well, you know.⟪k:2⟫⟪k:3⟫You’re... ⟪k:4⟫about that age, Nellie."
msgstr "⟪k:0⟫⟪k:1⟫Bem, você sabe.⟪k:2⟫⟪k:3⟫Você está... ⟪k:4⟫naquela idade, Nellie."

#: scenario:scenario_58E28F15_FFFB_40BB_8FD0_F0A7225EED44
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: a708265afafb62a307d9dd942f3e25bdcb8544f60b0f90f5017c769d6bb4145c
