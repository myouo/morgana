msgid "⟪k:0⟫⟪k:1⟫Huh? ⟪k:2⟫Why?!"
msgstr "⟪k:0⟫⟪k:1⟫Huh? ⟪k:2⟫Por quê?!"

#: scenario:scenario_DCB893DC_6670_47A0_BD44_6606BE247DA5
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: d50ce65280bccf0db6b7ff2283d1df30aa252909e52c7907d2a0d96b3222cd2b
