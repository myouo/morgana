#: scenario:scenario_4C79A825_BC8B_4501_A0B5_2BA0E88A8755
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: afef251a56bae74b042a614f35b32e0437ef828fe925eba99852c79d31f76547
#. default-sha256: ae1811aaff965537b0562a8c1ae13363342e46e9382597fcae964657996c8505
msgctxt "scenario:scenario_4C79A825_BC8B_4501_A0B5_2BA0E88A8755"
msgid ""
"⟪k:0⟫The rose you tried to give me is an example of that.⟪k:1⟫⟪k:2⟫It was certainly crafted with "
"skill, but the jeweler is only known because some aristocrat spoke highly of him."
msgstr ""
"⟪k:0⟫A rosa que você tentou me dar é um exemplo disso.⟪k:1⟫⟪k:2⟫Certamente foi feito com "
"habilidade, mas o joalheiro só é conhecido porque algum aristocrata falou muito bem dele."

#: scenario:scenario_6962A1BA_5A83_4624_A0CC_8C6E364D191B
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: a35e25ad59efc8d7ab5e1b0d8d58949f8b9e1772747de74592bcb09064893475
#. default-sha256: c37eafa062e9b40d3ea6e8ce984f4116a79d80159322bb86e99a624b55a0c2a9
msgctxt "scenario:scenario_6962A1BA_5A83_4624_A0CC_8C6E364D191B"
msgid ""
"⟪k:0⟫My father’s paintings were no less skillful!⟪k:1⟫⟪k:2⟫His was a talent that could not be "
"easily imitated!"
msgstr ""
"⟪k:0⟫As pinturas do meu pai não eram menos habilidosas!⟪k:1⟫⟪k:2⟫O talento dele não podia ser "
"facilmente imitado!"

#: scenario:scenario_915E5451_8083_472C_8693_C47ACEFE7ED5
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 4254c8e380264db0ad5d0d1e0ccd2d65b475ce955794d5d98a60f0a808bf7c9e
#. default-sha256: 04bc5454e5a5baf13ec9fc751275b75fca689484a7d6e2c7e82ecb4709928059
msgctxt "scenario:scenario_915E5451_8083_472C_8693_C47ACEFE7ED5"
msgid "⟪k:0⟫But no one was willing to separate the art from the artist."
msgstr "⟪k:0⟫Mas ninguém estava disposto a separar a arte do artista."

#: scenario:scenario_21810620_3685_4F78_9BCA_832550E29B62
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: e3fe06d660216c7e941e933a919e312d8932e3b24f4531f28d2ec69fbe19fdaa
#. default-sha256: 99f3ee25b47fae53bab702313b9a18f498fd8c069ff315243e4ab1f4c41327b2
msgctxt "scenario:scenario_21810620_3685_4F78_9BCA_832550E29B62"
msgid ""
"⟪k:0⟫The Rhodes family stole everything from my father.⟪k:1⟫⟪k:2⟫But even thrown out onto the "
"streets, his only skill was painting."
msgstr ""
"⟪k:0⟫A família Rhodes roubou tudo do meu pai.⟪k:1⟫⟪k:2⟫Mas, mesmo tendo sido jogado na rua, sua "
"única habilidade era pintar."

#: scenario:scenario_571CF3A2_CEFA_4E6C_B91D_1E24807F6603
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 3b3a16fc86fbba0174ae218303708a05f68b8955151de22b34d38e126d6c851c
#. default-sha256: 7bfd5852bf529abadb140c72d93f940b3e8f6622ec2f17aceabe8ac4c0b43152
msgctxt "scenario:scenario_571CF3A2_CEFA_4E6C_B91D_1E24807F6603"
msgid "⟪k:0⟫That was all he could do to earn a living."
msgstr "⟪k:0⟫Isso era tudo o que ele podia fazer para ganhar a vida."

#: scenario:scenario_31E38DAE_533E_41D5_88DF_D96EA452F213
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 2348073bc4e0c162aad33618bad4a50e1c251ddfcbc9b4b07123d33bd4841da5
#. default-sha256: d8bf2e6f4ddae2b72218dc203b190f9840ca3922cc223c2e1cc521ff2a65672e
msgctxt "scenario:scenario_31E38DAE_533E_41D5_88DF_D96EA452F213"
msgid ""
"⟪k:0⟫What little money we had for food, he gave to me.⟪k:1⟫⟪k:2⟫He did anything he could to "
"ensure my survival,⟪k:3⟫even at the expense of his own well-being."
msgstr ""
"⟪k:0⟫O pouco dinheiro que tínhamos para comida, ele me dava.⟪k:1⟫⟪k:2⟫Ele fez tudo o que podia "
"para garantir a minha sobrevivência,⟪k:3⟫mesmo à custa de seu próprio bem-estar."

#: scenario:scenario_E3A8A197_803D_4EBC_8E0F_BD2FC6D493AC
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: a4eb4f66565ef82ff390845d02bf065d79d3c7f4941caf2cba474de19f75aa36
#. default-sha256: 5d7ce0083ad836174584f71a9c8c14dbe54abeadf30481cf45425d78f15e01fd
msgctxt "scenario:scenario_E3A8A197_803D_4EBC_8E0F_BD2FC6D493AC"
msgid "⟪k:0⟫...My father passed away in this town."
msgstr "⟪k:0⟫...Meu pai faleceu nesta cidade."

#: scenario:scenario_A06ABDFD_7866_46D3_9E53_D3FFA5ABA2EC
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 591e0e97971698ffdec38228dea1a64dfb2a4be6913d739806c4527f702c4326
#. default-sha256: d21a3ec9bba2621edf8b07cfba2c9d7666cbcbf6ca5547f60a63c38bdb4f75bb
msgctxt "scenario:scenario_A06ABDFD_7866_46D3_9E53_D3FFA5ABA2EC"
msgid "⟪k:0⟫Up until his last breath, he was only ever concerned about me..."
msgstr "⟪k:0⟫Até seu último suspiro, ele só estava preocupado comigo..."

#: scenario:scenario_CD6E291F_755C_4BE7_B15C_D83003B2EADE
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 9bba022497d6fb94c9c96ce7e34bc15bf8046289cbd592885dc8cc9fc9a5fee1
