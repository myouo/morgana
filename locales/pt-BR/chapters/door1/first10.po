msgctxt "scenario:scenario_96ADFF43_9B89_4340_804B_D4BE556E5EBB"
msgid ""
"⟪k:0⟫But on the night of the storm,⟪k:1⟫the mistress was the first one to extend her hand to me."
msgstr "⟪k:0⟫Mas na noite da tempestade,⟪k:1⟫a patroa foi a primeira a estender a mão para mim."

#: scenario:scenario_7B76CFE3_409A_4B9A_814F_084FD1A08324
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 9c1554b12df68fd1ba706dbf09bb1ae21a9987191cc1900552b7ea6cdc7f78f2
