msgctxt "scenario:scenario_069495CE_C027_4774_A7EF_20A347FC2145"
msgid "⟪k:0⟫And so, I sought to bring misfortune upon you."
msgstr "⟪k:0⟫E assim, eu procurei trazer infortúnio sobre vocês."

#: scenario:scenario_480EC6D3_51C4_47F4_8798_38493C5712CC
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: e47e8855de47b482c3fe7a8cd06228e2d18b0a3814fe33bf9d1127b22e08917d
