msgctxt "scenario:scenario_65863436_D2F5_43EB_8207_B6C7C3C0924A"
msgid ""
"⟪k:0⟫The mistress did not send me away when she saw me.⟪k:1⟫⟪k:2⟫Quite the opposite—⟪k:3⟫⟪k:4⟫she "
"took me in as a servant."
msgstr ""
"⟪k:0⟫A patroa não me mandou embora quando me viu.⟪k:1⟫⟪k:2⟫Muito pelo contrário—⟪k:3⟫⟪k:4⟫ela me "
"acolheu como serva."

#: scenario:scenario_8B3C936B_1D1B_4E2F_AD9A_79A6C8A2D79E
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 873d69b6e12093ec314f2a38e8accf62bac15eeb0bae9f6aabf018c05115eea2
