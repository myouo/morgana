msgid ""
"⟪k:0⟫and the family who dwelled within it.⟪k:1⟫⟪k:2⟫Rhodes is a name my father could never forget."
msgstr ""
"⟪k:0⟫e a família que nela residia.⟪k:1⟫⟪k:2⟫Rhodes é um nome que meu pai nunca poderia esquecer."

#: scenario:scenario_2801E4E0_E4EC_488C_B0DF_A8D80C68CB0D
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 76c2821e8af9451afa8fdbe2449ec8101b8e1d0cabb2c71d1665e5780aa392ec
