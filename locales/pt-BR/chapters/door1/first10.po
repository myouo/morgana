msgctxt "scenario:scenario_472740DE_ED88_4671_9470_93460F18559C"
msgid ""
"⟪k:0⟫I imagined you were still living in decadence,⟪k:1⟫acting as though nothing had ever "
"happened."
msgstr ""
"⟪k:0⟫Imaginei que vocês ainda estivessem vivendo em decadência,⟪k:1⟫agindo como se nada tivesse "
"acontecido."

#: scenario:scenario_2E8B6A2C_E63A_40F1_AC64_11E4AF5DCA1C
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: dbfce38d59457f968d72a7b3e0567083620a55c5019a24602f1e07a2cc842baf
