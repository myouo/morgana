msgctxt "scenario:scenario_7057D7E3_AA09_4B19_96B6_1163119CB401"
msgid "⟪k:0⟫On the night of the storm, I paid a visit to Rose Manor—⟪k:1⟫⟪k:2⟫⟪k:3⟫this mansion."
msgstr "⟪k:0⟫Na noite da tempestade, fiz uma visita à Mansão das Rosas—⟪k:1⟫⟪k:2⟫⟪k:3⟫esta mansão."

#: scenario:scenario_3A9BA9CB_5CD3_4594_BF21_EF595EEBD26B
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: e03775d5d53cff16b1de356bc69665f58f3c5f1e66ede915df584ac1c07408fc
