msgid "⟪k:0⟫I... ⟪k:1⟫am not fit for your affection."
msgstr "⟪k:0⟫Eu...⟪k:1⟫não sou digna do seu afeto."

#: scenario:scenario_04CC19FC_1A0E_44AF_A957_81057F23BFFE
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 069ee7d7883d93e3f5b210d5e45446f042c074d69a6ce90c9ca2437bb1d6116b
