msgctxt "scenario:scenario_575B60BC_BB37_4475_8BA8_6814A80488A9"
msgid "⟪k:0⟫We were birds that migrated without a flock."
msgstr "⟪k:0⟫Éramos pássaros que migravam sem bando."

#: scenario:scenario_4A09487B_5B8F_4949_B006_58FCF7D98D50
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 7f467158fc008cc4e122bc60a558b791443333023cf6a8a03e9eba782de42f67
