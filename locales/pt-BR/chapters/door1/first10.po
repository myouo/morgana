msgctxt "scenario:scenario_28853A73_29D4_4A43_BF93_9BA4F07EF93B"
msgid ""
"⟪k:0⟫I disdained the Rhodes family for putting us...⟪k:1⟫⟪k:2⟫no, for putting my father through "
"such hardship."
msgstr ""
"⟪k:0⟫Desprezei a família Rhodes por nos fazer...⟪k:1⟫⟪k:2⟫não, por fazer meu pai passar por "
"tantas dificuldades."

#: scenario:scenario_472740DE_ED88_4671_9470_93460F18559C
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 77b3ba9eb53b0d72f7958bca1919e60f03c8ad1b72a6211234a3630c699b9573
