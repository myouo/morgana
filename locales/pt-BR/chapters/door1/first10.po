msgctxt "scenario:scenario_4A09487B_5B8F_4949_B006_58FCF7D98D50"
msgid ""
"⟪k:0⟫When we arrived at this town, my father was exhausted and weak.⟪k:1⟫⟪k:2⟫That is when we "
"learned of Rose Manor..."
msgstr ""
"⟪k:0⟫Quando chegamos a esta cidade, meu pai estava exausto e fraco.⟪k:1⟫⟪k:2⟫Foi quando soubemos "
"da Mansão das Rosas..."

#: scenario:scenario_3019C590_EF86_450D_A610_9FC45A26E841
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 97b7e9582a4d64974f24466a3ad7886ed7c1ff9f2280409c8aaf7b12b667affa
