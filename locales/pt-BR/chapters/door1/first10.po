#: scenario:scenario_4658E743_4327_4AE0_A0D6_F4ED2C05ED7A
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 96276be6aaeb912ddb4de3a6b66bc505d10ea882fed445f81253355c901a87a9
#. default-sha256: 55c904650d41f776d7fedda4f96958f43f7492edaf8046c432d78af0b5e352c7
msgctxt "scenario:scenario_4658E743_4327_4AE0_A0D6_F4ED2C05ED7A"
msgid ""
"⟪k:0⟫My transgression is that I was unable to completely predict where this path we were "
"traveling led."
msgstr ""
"⟪k:0⟫Minha transgressão é que não consegui prever completamente para onde levava esse caminho que "
"estávamos percorrendo."

#: scenario:scenario_F421FEF6_8212_4F76_902F_126E652CBBA2
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 6a7d76145c6d151098c347b7c1125b5319744cafd2a48715cfb823f702b3a1c0
#. default-sha256: b574c915c0d4670db553cc08ba0afef3ea320c944f27cf2726e660b2f9a292ff
msgctxt "scenario:scenario_F421FEF6_8212_4F76_902F_126E652CBBA2"
msgid ""
"⟪k:0⟫My hands were full dealing with my immediate day-to-day tasks, ⟪k:1⟫so I could do naught but "
"pray there was happiness waiting in the future."
msgstr ""
"⟪k:0⟫Minhas mãos estavam ocupadas lidando com minhas tarefas do dia a dia, então eu não podia "
"fazer nada além de rezar para que houvesse felicidade esperando no futuro."

#: scenario:scenario_04CA1AB7_ED67_44C2_99D6_240B21119DA2
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: d73600a947a38236f5036b9a7b665ef494998d3319ceb4b303b8ac6a07a3a55f
