#: scenario:scenario_3889ECE8_14D0_4B02_A043_8975F3066FAB
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: a601abd589743f627cefa2fc87c98bf5c372e92f734062a043a311fea2fc7727
#. default-sha256: 996495ae9ce92ef718795b91ca5b2eaf10f2fa7586663cc4a73e0a075761642a
msgctxt "scenario:scenario_3889ECE8_14D0_4B02_A043_8975F3066FAB"
msgid ""
"⟪k:0⟫However, not everyone living in the same land was equally blessed.⟪k:1⟫⟪k:2⟫In fact, the "
"blessed were far outnumbered by the forsaken."
msgstr ""
"⟪k:0⟫No entanto, nem todos que viviam na mesma terra eram igualmente abençoados.⟪k:1⟫⟪k:2⟫De "
"fato, os bem-aventurados eram muito menos numerosos que os abandonados."

#: scenario:scenario_23A7B9C7_8346_49FC_924B_A63FB403D755
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 6d1a83c403952974888ddcf44ef22d4b325971cba4ad349fe7bdc01eaabee2f8
