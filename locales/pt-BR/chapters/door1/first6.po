msgctxt "scenario:scenario_7BF2CCDF_724E_4FC0_A216_50B4B754228A"
msgid ""
"⟪k:0⟫And she had not summoned only her personal servants, but others as well—⟪k:1⟫⟪k:2⟫including "
"the White-Haired Girl."
msgstr ""
"⟪k:0⟫E ela não convocou apenas seus servos pessoais, mas também outros...⟪k:1⟫⟪k:2⟫incluindo a "
"Garota de Cabelos Brancos."

#: scenario:scenario_2649E325_FADA_41C0_BA9D_34CD2CFE9BD7
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: db75c814afc1d3eaaa306713adf3278077ccf7d5baa24832cc5a1d638e9ddda9
