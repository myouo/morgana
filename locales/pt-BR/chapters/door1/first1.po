msgctxt "scenario:scenario_5FA5021E_D160_466F_8EB1_C05FDA1A31C3"
msgid ""
"⟪k:0⟫What he was reading had been copied by a scribe.⟪k:1⟫⟪k:2⟫I presume he had borrowed it from "
"the church."
msgstr ""
"⟪k:0⟫O que ele estava lendo havia sido copiado por um escriba.⟪k:1⟫⟪k:2⟫Presumo que ele pegara "
"emprestado da igreja."

#: scenario:scenario_2D9E3BC0_0854_4F34_ABE7_A93B23D50558
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: c9f9b6af1f16f109e397d7b61841319bdf5c86c0d3470fca6b0762560616f91d
