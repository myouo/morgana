msgid "⟪k:0⟫Why..."
msgstr "⟪k:0⟫Por que..."

#: scenario:scenario_6ED4B62B_E12E_4D5B_8D73_7EE2BC667616
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 3704d503805151dd50a22d9deda5b02b6569dca985daaa59a183cf66339143a9
#. default-sha256: 06650495982cd2643691828c397e912001aae013956bbca2055fa37a6373a515
msgctxt "scenario:scenario_6ED4B62B_E12E_4D5B_8D73_7EE2BC667616"
msgid ""
"⟪k:0⟫Why won’t anyone tell me the truth?⟪k:1⟫⟪k:2⟫All I want... ⟪k:3⟫All I want is for someone to "
"tell me it’s not true!"
msgstr ""
"⟪k:0⟫Por que ninguém me diz a verdade?⟪k:1⟫⟪k:2⟫Tudo o que eu quero...⟪k:3⟫Tudo que eu quero é "
"que alguém me diga que não é verdade!"

#: scenario:scenario_C00DCF2D_6774_43CE_9214_83D0559ACD6E
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: f65616e40ca43c281c3761dbfc8e4e7d2cdd9c98de9071120e4c509f088b81f7
#. default-sha256: b193307af8d91bd2fdc0d772c6ff572fefcc0cfd0c667a5e2a5782f95ac82f2e
msgctxt "scenario:scenario_C00DCF2D_6774_43CE_9214_83D0559ACD6E"
msgid "⟪k:0⟫Have I sinned?!⟪k:1⟫⟪k:2⟫No, I didn’t know anything!⟪k:3⟫⟪k:4⟫I didn’t know—"
msgstr "⟪k:0⟫Eu pequei?!⟪k:1⟫⟪k:2⟫Não, eu não sabia de nada!⟪k:3⟫⟪k:4⟫Eu não sabia—"

#: scenario:scenario_7676B9E7_B6A6_4D27_9D66_080D85ADA4E2
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 4736e0de416be530dff27d5c0c31340969de45d649cc6a1baec0b32f7a661da9
#. default-sha256: 0a91d8c14f156cfd304086d1e0cea6716bee66d4da40bff9a3061fb333e39b92
msgctxt "scenario:scenario_7676B9E7_B6A6_4D27_9D66_080D85ADA4E2"
msgid ""
"⟪k:0⟫No... ⟪k:1⟫No... ⟪k:2⟫None of it’s true...⟪k:3⟫⟪k:4⟫So I... ⟪k:5⟫I haven’t done anything "
"wrong..."
msgstr ""
"⟪k:0⟫Não... ⟪k:1⟫Não... ⟪k:2⟫Nada disso é verdade...⟪k:3⟫⟪k:4⟫Então eu...⟪k:5⟫Eu não fiz nada de "
"errado..."

#: scenario:scenario_7679B9E7_B6A6_4D27_9D66_080D85ADA4E2
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 0e42f16e09bd31e3efcfd83184db46738a795332689ff948f45a5d0264801c8f
#. default-sha256: 3cee751f386d16eabda0945298a48ffe65946393ea2740c7cbbfda54d1157919
msgctxt "scenario:scenario_7679B9E7_B6A6_4D27_9D66_080D85ADA4E2"
msgid "⟪k:0⟫I am not at fault! ⟪k:1⟫Am I?!"
msgstr "⟪k:0⟫Eu não tenho culpa! ⟪k:1⟫Tenho?!"

#: scenario:scenario_88552BA7_3E5E_486A_A919_653A6E6E2460
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: d2282d58794a482e7062f0536233e37c563fda8097d945e6d2e6431aa5ac10b8
#. default-sha256: 10b39c524b94862b6dc2baab24285d2fb6a20336a13004b6fbcee75786750e99
msgctxt "scenario:scenario_88552BA7_3E5E_486A_A919_653A6E6E2460"
msgid "⟪k:0⟫Nevertheless, his sister’s claims, and her laughs, continued to echo within his head."
msgstr ""
"⟪k:0⟫No entanto, as afirmações de sua irmã e suas risadas continuaram a ecoar em sua cabeça."

