#: scenario:scenario_76414AD9_CBC2_4E2D_9A48_5BD226AF7166
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 301a9ec3b75bc6e09b417376bfffd01d00257ababbc3adec548c3435a5a3a5e2
#. default-sha256: c601c96ffd284a7c2039df19bfc386d6a9146220faeff9186da243af6960b1da
msgctxt "scenario:scenario_76414AD9_CBC2_4E2D_9A48_5BD226AF7166"
msgid ""
"⟪k:0⟫In a fevered frenzy, Mell fled from the mansion. ⟪k:1⟫Even in early summer, the night was "
"cold."
msgstr ""
"⟪k:0⟫Em um frenesi febril, Mell fugiu da mansão. ⟪k:1⟫Mesmo no início do verão, a noite estava "
"fria."

#: scenario:scenario_6801AEDC_0747_46BB_8CFE_962228550A8F
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: c5049a71e548bff5e78dd4ce0166337071fc45189fa16844a42d995973e1f0a1
#. default-sha256: c6dfc60c95b09e2b582cd3488c15b5742912809bfd63b970156d2720ff4b6abe
msgctxt "scenario:scenario_6801AEDC_0747_46BB_8CFE_962228550A8F"
msgid "⟪k:0⟫And to make matters worse, raindrops pelted him from head to toe."
msgstr "⟪k:0⟫E para piorar as coisas, gotas de chuva o atingiram da cabeça aos pés."

#: scenario:scenario_CCA9673A_482B_43E1_A63C_1E2C96681A1F
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 6f93042fec4b67b67193a57638512abd9f9065acf7fa6e0b0e97129c4af2d424
#. default-sha256: e20a72288fa61edcf8edbb29441699b91fde50767cd7cd9487d4f2279294c2ec
msgctxt "scenario:scenario_CCA9673A_482B_43E1_A63C_1E2C96681A1F"
msgid ""
"⟪k:0⟫But that caused him little discomfort, for a far greater maelstrom of pain rampaged within "
"his breast."
msgstr ""
"⟪k:0⟫Mas isso causou-lhe pouco desconforto, pois um redemoinho de dor muito mais intenso se "
"espalhava dentro de seu peito."

#: scenario:scenario_140790A3_031E_46EE_A5A9_C09D5D593EE8
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 9d9ab4ac19c54896946de8ddbe5e44d5d90803123c5bbe13b7a402e7bebeec24
#. default-sha256: f203136fe8cb4dbf5f19175ee85c1c7631dff1a15ba6626762f69794164e4187
msgctxt "scenario:scenario_140790A3_031E_46EE_A5A9_C09D5D593EE8"
msgid ""
"⟪k:0⟫At night, the town took on a different appearance. ⟪k:1⟫Not simply for lack of illumination, "
"but the people active within it as well."
msgstr ""
"⟪k:0⟫À noite, a cidade assumiu uma aparência diferente. ⟪k:1⟫Não apenas por falta de iluminação, "
"mas também pelas pessoas que nela circulavam."

#: scenario:scenario_5678B376_21F6_4AA4_B7F2_5DAE02514F57
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 2332c2a56d8a2594f5e1a442b032e367a50bc7f667d4565e6a4aa0368b8b703b
#. default-sha256: 101b82a78bec43a3686d0c503f74378f38ebacedd90a50e897cc84c4349e357e
msgctxt "scenario:scenario_5678B376_21F6_4AA4_B7F2_5DAE02514F57"
msgid "⟪k:0⟫It was not a suitable place for a young aristocratic man to go wandering unattended."
msgstr "⟪k:0⟫Não era um lugar adequado para um jovem aristocrata vagar desacompanhado."

#: scenario:scenario_320635AE_966E_4446_B2EE_B0BF550649BD
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 7d4f0a7aafc136626e1cc526f3ccbc807c97e42a6988355aff3c0ca4695409c9
#. default-sha256: de969e919586e5e0214838337b0f34a2805597da391860186a38653b431fecf0
msgctxt "scenario:scenario_320635AE_966E_4446_B2EE_B0BF550649BD"
msgid ""
"⟪k:0⟫The darkness is not only the abode of devils, but of beggars, thieves, criminals, and all "
"manner of things undesirable."
msgstr ""
"⟪k:0⟫A escuridão não é apenas morada de demônios, mas de mendigos, ladrões, criminosos e todo "
"tipo de coisas indesejáveis."

