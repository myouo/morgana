#: scenario:scenario_7C893E1F_346E_4C9F_B42E_D76879C2965A
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 3fc9a1cb46b75425c57bf0dd33ecc3f26573d290a0624bca7b933a5b576e25df
#. default-sha256: 8f751d6bd73c9a7764eb060a4fec502305bf137d7edd2b119fad3f33f182fd30
msgctxt "scenario:scenario_7C893E1F_346E_4C9F_B42E_D76879C2965A"
msgid "⟪k:0⟫But despite that, he continued to run, knowing not where he was to head."
msgstr "⟪k:0⟫Mas, apesar disso, ele continuou a correr, sem saber para onde iria."

#: scenario:scenario_7007E2B4_607A_4FF5_8C31_8FF521D1D873
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
