#: scenario:scenario_A9C0F767_79A2_4DB6_92EC_132010EF2A30
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: cebf0431b9f63bec541b71944b2975fe33e47f7e966bb138ba8cad6fda7532e9
#. default-sha256: 30199977dbd22e5a39d97ad264f3561b9402bf6e286ffcc120f66f7fbc0e37cc
msgctxt "scenario:scenario_A9C0F767_79A2_4DB6_92EC_132010EF2A30"
msgid ""
"⟪k:0⟫His head drooped feebly. ⟪k:1⟫He looked like a helpless little calf who had wandered, alone, "
"onto a dark, precarious mountain path with no end in sight."
msgstr ""
"⟪k:0⟫Sua cabeça tombou, exausta. ⟪k:1⟫Ele parecia um bezerro indefeso que vagava sozinho por um "
"caminho de montanha escuro e perigoso, sem fim à vista."

#: scenario:scenario_8EAD7373_0AA2_4954_ACE6_8051992CE92A
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 454c4292751425e41dad916270814b1f78b544dff96fea2bf0cbc6482eb9de05
