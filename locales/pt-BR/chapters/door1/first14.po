msgid "⟪k:0⟫He simply went where his feet took him. ⟪k:1⟫And where he arrived was the church."
msgstr "⟪k:0⟫Ele simplesmente seguiu para onde os pés o levaram. ⟪k:1⟫E eles levaram à igreja."

