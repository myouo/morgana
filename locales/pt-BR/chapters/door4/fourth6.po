#: scenario4:scenario4_7E77A93C_97B6_46DB_90A6_D4C6E3A505A6
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: c2343c6661363dbed62ae25fdba38c835b06be019e855006bfdfff9c0280edec
#. default-sha256: 04f7cb869c09b2a3f06d49781f4a3357e805bad6a30b9d56a96a2f109d194a23
msgctxt "scenario4:scenario4_7E77A93C_97B6_46DB_90A6_D4C6E3A505A6"
msgid "⟪k:0⟫⟪k:1⟫⟪k:2⟫Hmm?⟪k:3⟫⟪k:4⟫Is someone at the door?"
msgstr "⟪k:0⟫⟪k:1⟫⟪k:2⟫Hmm?⟪k:3⟫⟪k:4⟫Tem alguém na porta?"

#: scenario4:scenario4_C11C86C8_E501_4EDE_B209_83D989A12E52
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 930d8d3b071d12b001fcb26a5b8e09d77a074fce48e429b975365776e2925081
#. default-sha256: 740ce9c0672d535922ab520ee0d939765fe462af13402833301128071f0dcb3e
msgctxt "scenario4:scenario4_C11C86C8_E501_4EDE_B209_83D989A12E52"
msgid ""
"⟪k:0⟫The flow of time was hazy within the mansion’s walls. ⟪k:1⟫They had little way of telling "
"whether it was night or day, preventing them from knowing exactly how much time had passed."
msgstr ""
"⟪k:0⟫O fluxo do tempo era nebuloso dentro das paredes da mansão. ⟪k:1⟫⟪k:2⟫Eles tinham poucos "
"meios de dizer se era noite ou dia, impedindo-os de saber exatamente quanto tempo havia se "
"passado."

#: scenario4:scenario4_39EB3EAB_7C0F_4D68_B10C_55ED104EAC75
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: feb26d8f5951a003545d58c9374a4a24670b0127c43b89906827705e8e44c9b3
#. default-sha256: e72f715dae720e8b1d71b8a1a35a82b8a39240b9bd049167bfd72163c1886a28
msgctxt "scenario4:scenario4_39EB3EAB_7C0F_4D68_B10C_55ED104EAC75"
msgid ""
"⟪k:0⟫The White-Haired Girl had made a habit of climbing the observation tower every so often to "
"see whether the sun was up, which allowed her to approximate the time of day."
msgstr ""
"⟪k:0⟫A Garota de Cabelos Brancos tinha o hábito de subir na torre de observação de vez em quando "
"para ver se o sol estava alto, o que lhe permitia aproximar a hora do dia."

#: scenario4:scenario4_F87761B9_B58B_4448_8629_4751E9B8488E
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 8baf212df5260184d29f1dd496ec1cb626216af3397c2d8b3964a41787954fb8
#. default-sha256: b71d791cacc73c5e826adf93371b1390439f42943de2f789cf5154503af92bce
msgctxt "scenario4:scenario4_F87761B9_B58B_4448_8629_4751E9B8488E"
msgid ""
"⟪k:0⟫Consequently, when she heard the knock on the door, she was not aware just how deep the "
"night was outside—⟪k:1⟫⟪k:2⟫that forest and beast alike lay quietly at rest."
msgstr ""
"⟪k:0⟫Consequentemente, quando ela ouviu a batida na porta, não percebeu o quão profundo na noite "
"era lá fora—⟪k:1⟫⟪k:2⟫que a floresta e as feras repousavam silenciosamente."

#: scenario4:scenario4_6C9B35A5_F117_40B3_A387_462780EB00E3
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 8f81abff6f08737a3b2cd5572466c5b468dcc5b8f9fecaf126809e7ed32840c7
#. default-sha256: e79e55562b779883bc44b8036d5c2e72810cc155f08e5fa16689977a84251908
msgctxt "scenario4:scenario4_6C9B35A5_F117_40B3_A387_462780EB00E3"
msgid "⟪k:0⟫(Oh, right, the stores in the cellar ⟪k:1⟫are⟪k:2⟫ almost exhausted...)"
msgstr "⟪k:0⟫(Ah, certo, as provisões no porão ⟪k:1⟫estão⟪k:2⟫ quase esgotadas...)"

#: scenario4:scenario4_F662AC6A_109C_4237_B301_A595D078DCE2
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 2da7912e2b75e74002cbcd3d9041bbb26a53882963b31dd2f16d50d949f03831
#. default-sha256: 798b1d4e2936ac6d1163d8ab78df49ff6014ac170a729f5faa43f5458e58134a
msgctxt "scenario4:scenario4_F662AC6A_109C_4237_B301_A595D078DCE2"
msgid "⟪k:0⟫(It must be this month’s delivery.)"
msgstr "⟪k:0⟫(Deve ser a entrega deste mês.)"

#: scenario4:scenario4_2FDFD391_D01D_430A_8FB5_8AD19682A08A
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: d3daa3810b47cf2f3c516770c822f877ecff7a82f6dcbc187623e22bddc06b6e
#. default-sha256: 8bbb958dea0c3252bb60bae90a9775cec69751e80a2f975a6a1f7f6a59a73e07
msgctxt "scenario4:scenario4_2FDFD391_D01D_430A_8FB5_8AD19682A08A"
msgid ""
"⟪k:0⟫Not thinking it was worth bothering Michel over, she made her way out of her chambers and "
"headed for the entrance."
msgstr ""
"⟪k:0⟫Não achando que valeria a pena incomodar Michel, ela saiu de seus aposentos e se dirigiu "
"para a entrada."

#: scenario4:scenario4_A66F8C4E_786F_457E_8E11_6433A05D1710
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 98f1e1f1be50320bdc3f5776ea64aed0e0f59ebe37f044342b69d4ee64ffe3c5
#. default-sha256: cfa290af3d41f2c4b55b625ca992612af663ec6b25241ec1799beb08091736b6
msgctxt "scenario4:scenario4_A66F8C4E_786F_457E_8E11_6433A05D1710"
msgid "⟪k:0⟫There had only been a single knock,"
msgstr "⟪k:0⟫Houve apenas uma única batida,"

#: scenario4:scenario4_BBB7D78A_4C7B_4265_83A7_52CF48469070
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 42913f628fba57a05189747af3f7fa658520ec7915f4082e2964d5efa80dc802
#. default-sha256: 8fcea35f3af01776a4c4086f8f517ba1aef20e17fb34f4371635e4827812a55f
msgctxt "scenario4:scenario4_BBB7D78A_4C7B_4265_83A7_52CF48469070"
msgid ""
"⟪k:0⟫leading her to conclude that, as before, the servant had simply left the box outside the "
"door."
msgstr ""
"⟪k:0⟫levando-a a concluir que, como antes, o criado simplesmente deixou a caixa do lado de fora."

#: scenario4:scenario4_B01D0B15_E1EE_49B9_BD57_10B0CA1C1B60
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 253ff1086969b4c5b9c2ef07130a5b41a640c2c1baba23277888ba6a813486bc
#. default-sha256: 0117d5299d48a132302256135df50098f5ce901b3634f8e0e0118d23f723da3c
msgctxt "scenario4:scenario4_B01D0B15_E1EE_49B9_BD57_10B0CA1C1B60"
msgid "⟪k:0⟫⟪k:1⟫So without a second thought, she opened the door—"
msgstr "⟪k:0⟫⟪k:1⟫Então, sem pensar duas vezes, ela abriu a porta—"

#: scenario4:scenario4_FC468F18_DCC6_46B6_AD08_05BC3BCEDF6C
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: f306267fee460640b3340d3ba40f3d89c540220fd7a2f04673e87ae09ce12434
#. default-sha256: 229e48bdf3f1b174399153a2e5b775d708b7de15af71806791603fda8bf4fc3e
msgctxt "scenario4:scenario4_FC468F18_DCC6_46B6_AD08_05BC3BCEDF6C"
msgid ""
"⟪k:0⟫and there she saw a strange, vagrant man standing in the moonlight. ⟪k:1⟫His clothes were "
"tattered, his bearded face bony and emaciated."
msgstr ""
"⟪k:0⟫e lá ela viu um homem vadio e estranho parado ao luar. ⟪k:1⟫Suas roupas estavam "
"esfarrapadas, seu rosto barbudo ossudo e emagrecido."

#: scenario4:scenario4_8A71D3D9_E307_411B_ABF6_BB00BFBB53DD
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: fcf4381b14bf43fcadf7f2554144f661ea4283b12537cae7f36986d916302db2
#. default-sha256: f0f04c711f011a8a9874adb15a2c6bd6b568ea1a0eb6f41a83310b961977028e
msgctxt "scenario4:scenario4_8A71D3D9_E307_411B_ABF6_BB00BFBB53DD"
msgid "⟪k:0⟫—!"
msgstr "⟪k:0⟫—!"

#: scenario4:scenario4_3595D187_60FD_4829_86D6_7B456706EDD3
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 6c32c54b7a8e5c5ed6256c7395b5d094c69279164c4053f608642fb35a80e67a
#. default-sha256: 2fed5013859e00f3fb8f44a3039aee0985d443dbe1cc85f21de19279a7c292c4
msgctxt "scenario4:scenario4_3595D187_60FD_4829_86D6_7B456706EDD3"
msgid ""
"⟪k:0⟫She gasped, shrinking back several paces. ⟪k:1⟫The heavy door began to swing shut, but the "
"man forced it open,"
msgstr ""
"⟪k:0⟫Ela engasgou, encolhendo-se vários passos. ⟪k:1⟫A pesada porta começou a se fechar, mas o "
"homem a forçou a abrir,"

#: scenario4:scenario4_DCDC200C_5930_4228_A84C_5A1555F94B21
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: e88fa13ec1d4a61cbc693ee7ce4e1697b6f6c59d5c1809c84286f4fc4f17ce86
#. default-sha256: 55efc8541c0eddfa71d5275b5d817eab69782a525e4d7aa547fcdb566838957f
msgctxt "scenario4:scenario4_DCDC200C_5930_4228_A84C_5A1555F94B21"
msgid "⟪k:0⟫glaring down at her with unfocused eyes and mumbling,"
msgstr "⟪k:0⟫olhando para ela com olhos desfocados e resmungando,"

#: scenario4:scenario4_0E7B69CA_31B2_4FCD_9779_175E3F94FB67
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: b75899341a3d7456bb7df227713dbfdc24b6d8c2712543b57306c18e7d698a83
#. default-sha256: 1e3a73284c1b57701415f51a5e6821e4f96572febf8fe2d3a4340e32b27404b5
msgctxt "scenario4:scenario4_0E7B69CA_31B2_4FCD_9779_175E3F94FB67"
msgid "⟪k:0⟫Are ye the witch that’ll grant people’s wishes?"
msgstr "⟪k:0⟫Cê é a bruxa que concede os desejo das pessoa?"

#: scenario4:scenario4_A34CF1FA_E92C_44D3_B497_C6503B98EBB9
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 098b8f46311c4107af3eb76831781d23f167e6e798daaf044696c9fa8272a5ab
#. default-sha256: 937efa65bbcdb109981612a72ae0e43df51bd0c5da1cf8c60ac568570a16ec64
msgctxt "scenario4:scenario4_A34CF1FA_E92C_44D3_B497_C6503B98EBB9"
msgid ""
"⟪k:0⟫It was in that moment that the White-Haired Girl realized she had been careless. ⟪k:1⟫The "
"man had sought out the mansion because he believed the legend of the witch."
msgstr ""
"⟪k:0⟫Foi nesse momento que a Garota de Cabelos Brancos percebeu que havia sido descuidada. ⟪k:1⟫O "
"homem procurou a mansão porque acreditava na lenda da bruxa."

#: scenario4:scenario4_3EA1F26B_E711_4316_A68E_172EC1760EB6
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: bb459addb05ddd5279f83157d26e097cc19a62b192b143cdf72fbe5691190a41
#. default-sha256: 3d27a77228c0bbe3297fecfa4ee113f11b525c015a80c0a34dac34c6fb9ae9ac
msgctxt "scenario4:scenario4_3EA1F26B_E711_4316_A68E_172EC1760EB6"
msgid ""
"⟪k:0⟫And he did not seem particularly right of mind, either—⟪k:1⟫⟪k:2⟫perhaps a result of "
"wandering through the forest for several days. Or perhaps it was ⟪k:3⟫because⟪k:4⟫ he was so "
"beaten down that he thought to ask for a witch’s help."
msgstr ""
"⟪k:0⟫E ele não parecia particularmente bem da cabeça, também...⟪k:1⟫⟪k:2⟫talvez o resultado de "
"vagar pela floresta por vários dias. Ou talvez fosse ⟪k:3⟫porque⟪k:4⟫ ele estava tão quebrado que "
"pensou em pedir a ajuda de uma bruxa."

#: scenario4:scenario4_C7257A84_1D3E_4823_A936_F17F36BE0932
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: eedf250569c5d7e0b9c5d08c9027af6c6835623315cc2e7c883e223f2a89847e
#. default-sha256: 20c404fdc21d876f43bb6f0fa27c5c6d0831c36c68a4006148a14eb44d189fb5
msgctxt "scenario4:scenario4_C7257A84_1D3E_4823_A936_F17F36BE0932"
msgid "⟪k:0⟫In a word, he seemed mad."
msgstr "⟪k:0⟫Em uma palavra, ele parecia louco."

#: scenario4:scenario4_88F28DEE_9E99_46D5_872F_3095AA05A27B
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 67adfe55531064e8bfa8a36696bf8adb2fbcafd5a06fe9f05210a257bcdf98cf
#. default-sha256: 42102f805412d4e566d902e47f45ef14a6a08d30e94f3aed538862fff4808a4e
msgctxt "scenario4:scenario4_88F28DEE_9E99_46D5_872F_3095AA05A27B"
msgid "⟪k:0⟫N-⟪k:1⟫No...⟪k:2⟫⟪k:3⟫There is no witch here..."
msgstr "⟪k:0⟫N-⟪k:1⟫Não...⟪k:2⟫⟪k:3⟫Não há nenhuma bruxa aqui..."

#: scenario4:scenario4_1BE00853_0238_48B0_BA1C_28E0370C7C4D
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 98f77e921324b4a777709d0847e84ffdcf855ffd3342f318cb1bca9297669e39
#. default-sha256: f4964d419a82a4d935c8717881f3791a4ed5d2514960bac9bfad31413b9d359d
msgctxt "scenario4:scenario4_1BE00853_0238_48B0_BA1C_28E0370C7C4D"
msgid "⟪k:0⟫Sure there is. Don’t ye lie to me...⟪k:1⟫⟪k:2⟫I can ’ear the witch’s voice..."
msgstr "⟪k:0⟫Claro que tem. Não mente pra mim...⟪k:1⟫⟪k:2⟫Eu consigo ouvi a voz da bruxa..."

#: scenario4:scenario4_880EC7AC_1F2B_4DD7_B643_47239262DAF2
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 2a123f6db2b31ef5f9a4934a548999bc09a213f62730cf8ea529a196250176ac
#. default-sha256: 998a0850ce43faf4a3dd3d30815d5446c03240337d2d9e3817b742626985226b
msgctxt "scenario4:scenario4_880EC7AC_1F2B_4DD7_B643_47239262DAF2"
msgid "⟪k:0⟫She led me to this ’ouse!"
msgstr "⟪k:0⟫Ela me guio pra essa casa!"

#: scenario4:scenario4_75400493_59A8_4243_BB66_2EE779585351
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: dfb8db234bfe5ac18dd11136d5302b94f69e5f22a8f54c036d9ae1c9887bd558
#. default-sha256: fbb7d2c2e6f307d9d16ce329a509bc5872afd25cae06e3a1ab877bd0f3ed11cc
msgctxt "scenario4:scenario4_75400493_59A8_4243_BB66_2EE779585351"
msgid "⟪k:0⟫Ngh... ⟪k:1⟫I-⟪k:2⟫I promise you, there isn’t!⟪k:3⟫⟪k:4⟫Now please, be on your way!"
msgstr ""
"⟪k:0⟫Ngh...⟪k:1⟫E-⟪k:2⟫Eu prometo a você, não há!⟪k:3⟫⟪k:4⟫Agora, por favor, siga seu caminho!"

#: scenario4:scenario4_0237B531_A3CD_4C65_886E_E37919AB5260
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: f6e3a788d4fe5787df0dba5d3d61ed6ef75cc6ee43abf8c6ebe75637fbaee0bd
#. default-sha256: 29f1bb3dd554e2e43982c3683af54075b7b471083d493fadb7afb8a664da6604
msgctxt "scenario4:scenario4_0237B531_A3CD_4C65_886E_E37919AB5260"
msgid ""
"⟪k:0⟫’Ave ye any idea ’ow long it took to find this place?!⟪k:1⟫⟪k:2⟫’Ow many days I’ve gone "
"without food or water?!⟪k:3⟫⟪k:4⟫And ye’re tellin’ me to get lost?!"
msgstr ""
"⟪k:0⟫Cê tem alguma ideia de quanto tempo levo pra encontra esse luga?! ⟪k:1⟫⟪k:2⟫Quantos dia eu "
"fiquei sem comida o água?!⟪k:3⟫⟪k:4⟫E cê tá me dizendo pra sumi?!"

#: scenario4:scenario4_099B4492_1369_4746_AD8C_8DC846C0252B
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 06f24c6bb53a6729150980154f2efeea2be429fe630166b1b09929360b1fab64
#. default-sha256: c5df064a5e1a4882e5e5b48a17810aa75b898dc2f60b3fd7b1746d071c10b79e
msgctxt "scenario4:scenario4_099B4492_1369_4746_AD8C_8DC846C0252B"
msgid ""
"⟪k:0⟫I-⟪k:1⟫I don’t know what you want from me...⟪k:2⟫⟪k:3⟫I’m happy to give you a little food, "
"so please!"
msgstr ""
"⟪k:0⟫N-⟪k:1⟫Não sei o que você quer de mim...⟪k:2⟫⟪k:3⟫Fico feliz em lhe dar um pouco de comida, "
"então, por favor!"

#: scenario4:scenario4_1A36B37C_383A_4DC1_8071_2124A926CB5C
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: e5c548c7e518a75ad06baa947a3cf54f15a2037494914428f0a094922c4efd99
#. default-sha256: 48f41697b22461c825c2f67ac00db3078091b23a05c42741f58ec0ffc02c435d
msgctxt "scenario4:scenario4_1A36B37C_383A_4DC1_8071_2124A926CB5C"
msgid "⟪k:0⟫............"
msgstr "⟪k:0⟫............"

#: scenario4:scenario4_243F0BF8_9390_4410_8605_330C9EF078E7
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: ce8f2d6aad544f8b9ebfafd4c54dd23905cd2af1b1cefeaa422b506421657845
#. default-sha256: ae1311eecb83786c7bbb6325cd7cdd05cfe903ec3f7e468d7e9347d2592c2b3b
msgctxt "scenario4:scenario4_243F0BF8_9390_4410_8605_330C9EF078E7"
msgid "⟪k:0⟫Is there really no witch?"
msgstr "⟪k:0⟫Realmente não tem nenhuma bruxa?"

#: scenario4:scenario4_1C6FABC2_2B88_4E56_9069_06BE40D16A79
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 66c29ee3476cb0cf39d71f129e0dffa2c60b3a3be767353e097d9b5fc1d5e55c
#. default-sha256: c2761960bc850fea3b66c72a6b87509016a002286ab9f1129e93ff9fff27eee8
msgctxt "scenario4:scenario4_1C6FABC2_2B88_4E56_9069_06BE40D16A79"
msgid ""
"⟪k:0⟫There’s no witch here!⟪k:1⟫⟪k:2⟫It’s nothing but a legend.⟪k:3⟫⟪k:4⟫If she does exist, she "
"doesn’t live here."
msgstr ""
"⟪k:0⟫Não há bruxa aqui!⟪k:1⟫⟪k:2⟫Não passa de uma lenda.⟪k:3⟫⟪k:4⟫Se ela existe, ela não mora "
"aqui."

