#: scenario4:scenario4_3A3AB18D_914F_4D7D_A8F8_47F3C26A1973
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: f94548a3ac4910b087a7783c1899fe1d5d2e1c0fbaf2746081facd8fbdc7784c
#. default-sha256: 72ae53ee63c1c31879725a053a278448f5dd5d06a4b7090748b196815baf71b7
msgctxt "scenario4:scenario4_3A3AB18D_914F_4D7D_A8F8_47F3C26A1973"
msgid ""
"⟪k:0⟫It had been about a week since the White-Haired Girl had taken up residence in the mansion."
msgstr ""
"⟪k:0⟫Fazia cerca de uma semana desde que a Garota de Cabelos Brancos se estabelecera na mansão."

#: scenario4:scenario4_CA14D481_F927_4BC4_9958_89127B00B8B1
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 6169d5d175147ea93c861215b928713b1fdd568e3cfafe49b6178e45e717b3bf
#. default-sha256: 744c9aa4457bd424cec0364596bbe3ee0f1f90b9895c0c6e689a02e1228a52bd
msgctxt "scenario4:scenario4_CA14D481_F927_4BC4_9958_89127B00B8B1"
msgid ""
"⟪k:0⟫Staying in that house deprived of light was, I imagine, a very claustrophobic experience."
msgstr ""
"⟪k:0⟫Ficar naquela casa privada de luz era, eu imagino, uma experiência muito claustrofóbica."

#: scenario4:scenario4_A191B3E2_744B_40E6_BC31_09F8B9BC8D69
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 8d6a2ffdf49e29a47f95822ec1c09f7e59edca8a8d64bfd84c6fbeb1e7b2a6f8
#. default-sha256: 677d4c7e87fa5ba9a5593024f012bb8880ad4bff028ab6ee9a69d0110062a4d1
msgctxt "scenario4:scenario4_A191B3E2_744B_40E6_BC31_09F8B9BC8D69"
msgid ""
"⟪k:0⟫To anyone blessed enough to have sunlight as a part of their everyday lives, it would have "
"been unbearable."
msgstr ""
"⟪k:0⟫Para qualquer um abençoado o suficiente para ter a luz do sol como parte de sua vida "
"cotidiana, teria sido insuportável."

#: scenario4:scenario4_FAFA92C5_1D4E_459F_9D64_B65AFCC317F0
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: aad0947a9f8a86af63e429f720ac6c04e6adf1b0c2ba8387340a3e0fd65c264d
#. default-sha256: 7d2612884ab82290525ec33503807c076f0e682df46107b6ffd2f0ba2f446cb7
msgctxt "scenario4:scenario4_FAFA92C5_1D4E_459F_9D64_B65AFCC317F0"
msgid ""
"⟪k:0⟫But for her, the mansion—⟪k:1⟫⟪k:2⟫with its prison walls and lack of either illumination or "
"recreation—"
msgstr ""
"⟪k:0⟫Mas para ela, a mansão—⟪k:1⟫⟪k:2⟫com suas paredes de prisão e falta de iluminação ou "
"recreação—"

#: scenario4:scenario4_9D4BEBF1_80AA_4E52_98BB_1FEF04B35971
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 91e116063eddf8d6916d26748490d21628eeb03fd08b91da281f3a2ed6f996c5
#. default-sha256: 897b94c5e4ad5e2966b210d283ee585a2c076b16ee47aa37be74e00af6d688b3
msgctxt "scenario4:scenario4_9D4BEBF1_80AA_4E52_98BB_1FEF04B35971"
msgid "⟪k:0⟫was the one place she could find respite."
msgstr "⟪k:0⟫era o único lugar que ela poderia encontrar descanso."

#: scenario4:scenario4_2C19D17D_1B86_464E_BD1A_5D58985CF708
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: c61d43549dd99ce4a51d00fe2ee2288372ce9c6c934d01050f514119d01ed76d
#. default-sha256: f8ec074f9ee7f3fafe7a672a6362e7c9365dac949bee0dbe537b4df577b6b88c
msgctxt "scenario4:scenario4_2C19D17D_1B86_464E_BD1A_5D58985CF708"
msgid "⟪k:0⟫She and Michel continued to be distant, however."
msgstr "⟪k:0⟫No entanto, ela e Michel continuaram distantes."

#: scenario4:scenario4_41A0DF7B_FEF0_4138_9D23_61C4F5FABF7B
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: f247c73d346dae38f3a4c94e9229c23dddaab1cf4c22eae4cb6a001e636c6da5
#. default-sha256: 384280ed782c6a4735ddb299269a48f4316533810d4f5e694b8566aab10d1e91
msgctxt "scenario4:scenario4_41A0DF7B_FEF0_4138_9D23_61C4F5FABF7B"
msgid ""
"⟪k:0⟫He spent most of his time in his chambers, which he had explicitly told the White-Haired "
"Girl to stay out of, leaving her unable to close that gap."
msgstr ""
"⟪k:0⟫Ele passava a maior parte do tempo em seus aposentos, dos quais havia explicitamente dito à "
"Garota de Cabelos Brancos para ficar fora, deixando-a incapaz de fechar essa lacuna."

#: scenario4:scenario4_419AA7BE_CF8A_47D9_B354_FE57A702C379
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: a2ac776c8583d4b9ef34c620bd3bf47c9a50b951d4996a168ad369ddb295ac90
#. default-sha256: 9b41c9569743b416b5fb838b304665d54c665efaa1d7b00478fe69e9dbcd2eef
msgctxt "scenario4:scenario4_419AA7BE_CF8A_47D9_B354_FE57A702C379"
msgid ""
"⟪k:0⟫Nonetheless, on the occasions they did cross paths in the hallway,⟪k:1⟫their eyes would meet—"
"⟪k:2⟫⟪k:3⟫if but briefly."
msgstr ""
"⟪k:0⟫No entanto, nas ocasiões em que se cruzaram no corredor,⟪k:1⟫seus olhos se encontravam—⟪k:2⟫"
"⟪k:3⟫mesmo que brevemente."

#: scenario4:scenario4_BA131BFB_3883_4E0E_AA4B_FCA79D169316
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: eb68dab316448e7c95590d6be7789338a896b8e1f73914e8f0d63d0f3a683c9a
#. default-sha256: 5f6d25e17f047c8b467cf8d8cd3b6bab4d375f3c1b51a3b3a8a211606fcfe598
msgctxt "scenario4:scenario4_BA131BFB_3883_4E0E_AA4B_FCA79D169316"
msgid ""
"⟪k:0⟫It was never for more than a few seconds.⟪k:1⟫⟪k:2⟫Whenever she saw him, she made a point of "
"giving him a little smile."
msgstr ""
"⟪k:0⟫Nunca era por mais do que alguns segundos.⟪k:1⟫⟪k:2⟫Sempre que ela o via, fazia questão de "
"lhe dar um pequeno sorriso."

#: scenario4:scenario4_E589D0D3_9447_4659_B771_8331DEB129FD
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 1d21174d170cadb9096a38496ae5e7eb7e46369a262d7ba69ce28e3e5f88676d
#. default-sha256: 537dc74cb58b47a61572e18ec9603b12b3722ec431e8b1d96d828f7e3a126903
msgctxt "scenario4:scenario4_E589D0D3_9447_4659_B771_8331DEB129FD"
msgid ""
"⟪k:0⟫He never said anything, but still, when she had first arrived, he would not have even met "
"her gaze."
msgstr ""
"⟪k:0⟫Ele nunca dizia nada, mas ainda assim, quando ela recém tinha chegado, ele não teria sequer "
"olhado nos seus olhos."

#: scenario4:scenario4_47AC4865_F13E_483C_B557_9E8D0D9C0774
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 32a15a563604394e6516d52c5def8d305a36c5333f9d5cd2d6df4d59e446f33c
#. default-sha256: 19f72b8188672ab61152ccdbb8e41dc5fceee78173a00934ff81cdffd66775aa
msgctxt "scenario4:scenario4_47AC4865_F13E_483C_B557_9E8D0D9C0774"
msgid "⟪k:0⟫He seemed to be taking more and more notice of her."
msgstr "⟪k:0⟫Ele parecia estar prestando mais e mais atenção nela."

#: scenario4:scenario4_9050C588_7A68_4FEA_8488_372AA36F7653
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 9ce437ffd9cbee45e363762799a811dfcf746d88c725a6d6e798e0775dc04c79
#. default-sha256: b45a5f75d40540c52b654bd3b35bba194a995b3e815b5c0bcb8250b3710f68db
msgctxt "scenario4:scenario4_9050C588_7A68_4FEA_8488_372AA36F7653"
msgid "⟪k:0⟫⟪k:1⟫One day, the White-Haired Girl stood in the cellar, a frown on her face."
msgstr "⟪k:0⟫⟪k:1⟫Um dia, a Garota de Cabelos Brancos estava no porão, uma carranca no rosto."

#: scenario4:scenario4_1FAD219B_A05E_47E3_9C94_1A264074123E
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 4f870f68eb1f3f26573c1c5fab86ca3e2cee0dac88c368bc979bac596599cbc8
#. default-sha256: b28cd4d959d51a17f20267d97787ab9a1f3d0c24369b8960cd1307b8df72405f
msgctxt "scenario4:scenario4_1FAD219B_A05E_47E3_9C94_1A264074123E"
msgid ""
"⟪k:0⟫(Well, this is troubling...⟪k:1⟫⟪k:2⟫I can’t go down to the village...⟪k:3⟫⟪k:4⟫but if we "
"don’t do something soon...)"
msgstr ""
"⟪k:0⟫(Bem, isso é preocupante...⟪k:1⟫⟪k:2⟫Eu não posso descer para a aldeia...⟪k:3⟫⟪k:4⟫mas se "
"não fizermos algo logo...)"

#: scenario4:scenario4_C7C31BBE_4520_4B03_895C_9A9E2E31B043
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: a276dd232ac2a42f577922d5aec3fdb827b2884698374b8553ad6b59044cca3d
#. default-sha256: 48f41697b22461c825c2f67ac00db3078091b23a05c42741f58ec0ffc02c435d
msgctxt "scenario4:scenario4_C7C31BBE_4520_4B03_895C_9A9E2E31B043"
msgid "⟪k:0⟫............"
msgstr "⟪k:0⟫............"

#: scenario4:scenario4_6772CFC4_884E_4AA8_BC06_143BC8034363
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: f857d5c0b5bc33446690e868464b7b44c61b7c8c849bca9dbb7b57ae7d471d07
#. default-sha256: b23b6dbf1e924cdc36ad9ea095ae807dc0bc9a93b5ee8d67776daee67c49072e
msgctxt "scenario4:scenario4_6772CFC4_884E_4AA8_BC06_143BC8034363"
msgid ""
"⟪k:0⟫The cellar was where their food was stored—⟪k:1⟫⟪k:2⟫an assortment of nonperishables and "
"dried foods, smoked meats and cheeses."
msgstr ""
"⟪k:0⟫O porão era onde a comida deles era armazenada—⟪k:1⟫⟪k:2⟫uma variedade de alimentos não "
"perecíveis e secos, carnes defumadas e queijos."

#: scenario4:scenario4_7DF38F10_3DF3_45C1_9032_8EFC0EB9C983
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 70aef95f509ce2995d45d86a3f96c006867ffd1c23943efdd4f7be591fe4bdf4
#. default-sha256: ed8b03d002b683ce96c51d0d0b63bd15fcb1aa5bd1fba0277ca3928f84d53b69
msgctxt "scenario4:scenario4_7DF38F10_3DF3_45C1_9032_8EFC0EB9C983"
msgid ""
"⟪k:0⟫Her daily meals were taken from the supplies there. ⟪k:1⟫However, the stockpile was "
"beginning to grow quite small."
msgstr ""
"⟪k:0⟫Suas refeições diárias eram retiradas dos suprimentos de lá. ⟪k:1⟫⟪k:2⟫No entanto, o estoque "
"estava começando a ficar bem pequeno."

#: scenario4:scenario4_9D1FF1CA_1B11_4CEC_884A_BED48D6AC2ED
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 0a203d3a6f034ef016a50baa5cf2aa8ed2f8dac86b4635df0bbbcbee6a345bbd
#. default-sha256: bc800220263bcda279f729222623df8a541c9eb9d831795eabfbc75c4273d68a
msgctxt "scenario4:scenario4_9D1FF1CA_1B11_4CEC_884A_BED48D6AC2ED"
msgid "⟪k:0⟫Were she not on the run, she could have gone to the village to procure more."
msgstr "⟪k:0⟫Se não estivesse fugindo, ela poderia ter ido à aldeia para obter mais."

#: scenario4:scenario4_2E697E6F_E846_4699_A77B_01ABD9A7FE97
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 408a0e91b3854d2f89b17c46e9c878b1c1fcdb51c99c3ab24cb1dac14fb59a66
#. default-sha256: 02d2161d3f2588498c5e7c96f2b11bb503eb6ffc71baf090503626bb5757b63e
msgctxt "scenario4:scenario4_2E697E6F_E846_4699_A77B_01ABD9A7FE97"
msgid ""
"⟪k:0⟫Or perhaps, were she a little tougher, she could have captured a wild animal for its meat."
msgstr ""
"⟪k:0⟫Ou talvez, se ela fosse um pouco mais forte, poderia ter capturado um animal selvagem para "
"ter carne."

#: scenario4:scenario4_AD7A4BAA_BA3E_43B8_9766_C2C60BF2E6DB
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 767125c1d394f0400f6321a373059c41dcbe3214ba07ed8ecc13078fd7c2023c
#. default-sha256: 833db65c156c830ed6623cc8c07e4b46fe96eac345b5a25ed9570a16bdf6d55f
msgctxt "scenario4:scenario4_AD7A4BAA_BA3E_43B8_9766_C2C60BF2E6DB"
msgid ""
"⟪k:0⟫Hehe... ⟪k:1⟫But Master, you know a young, delicate thing like her was hardly up to the task "
"of hunting for food."
msgstr ""
"⟪k:0⟫Hehe... ⟪k:1⟫ Mas Mestre, você sabe que uma coisinha jovem e delicada como ela dificilmente "
"estava à altura da tarefa de caçar comida."

#: scenario4:scenario4_058A15FB_40C9_4C42_B7C6_7467071F65FD
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: fd37318e9b399fa60b6602cd661edc5440f52b515ae4f0de927ad541a3335881
#. default-sha256: 60b27722605698b3dc11faae83b8969610ce095ec9e2014725e3f242a31b0404
msgctxt "scenario4:scenario4_058A15FB_40C9_4C42_B7C6_7467071F65FD"
msgid "⟪k:0⟫How does he normally get his supplies, I wonder?"
msgstr "⟪k:0⟫Como ele normalmente consegue seus suprimentos, eu me pergunto?"

#: scenario4:scenario4_0F8AAD60_039D_4743_90BB_E791E77745CE
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 637a5f32ac9ba8e3ca5b4cb44f220fa0b601689e8d9ca79d072738b43d581afe
#. default-sha256: f46c3c960d886ae1ab28878168d2090b655f8c75564199b688dca9637f56ec98
msgctxt "scenario4:scenario4_0F8AAD60_039D_4743_90BB_E791E77745CE"
msgid ""
"⟪k:0⟫From there, other questions about Michel started rising in her mind. ⟪k:1⟫No matter how "
"lifeless he seemed..."
msgstr ""
"⟪k:0⟫A partir daí, outras perguntas sobre Michel começaram a surgir em sua mente. ⟪k:1⟫ Não "
"importa o quão sem vida ele parecia..."

#: scenario4:scenario4_87865C14_5F55_44EC_942E_30D9AA895D4C
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 89a8a01f11d32435ac2a302410f029907ea53e8c07b3cbba1f1a613553639b6a
#. default-sha256: bf1445ddc0e02ee35a38327041ced91543c56dbfb541dd209998d46faa4fab44
msgctxt "scenario4:scenario4_87865C14_5F55_44EC_942E_30D9AA895D4C"
msgid "⟪k:0⟫⟪k:1⟫surely⟪k:2⟫ he still had to eat, right?"
msgstr "⟪k:0⟫⟪k:1⟫certamente⟪k:2⟫ ele ainda tinha que comer, não é?"

#: scenario4:scenario4_C7D68F39_01B3_452B_97D1_6070B28AC292
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 3c9b4a50fad44386440b1205354724fc4d9bfdc37070864f5aa127f91e6b42c4
#. default-sha256: 0bc5246c2cb66e912bd663b6afe1990bf8c3f4be4039dab06ca95131614e0e8f
msgctxt "scenario4:scenario4_C7D68F39_01B3_452B_97D1_6070B28AC292"
msgid ""
"⟪k:0⟫The White-Haired Girl nodded, then made her way out of the cellar, intending to head for his "
"bedchamber."
msgstr ""
"⟪k:0⟫A Garota de Cabelos Brancos assentiu, então saiu do porão, pretendendo ir até o quarto dele."

#: scenario4:scenario4_4D147211_E99D_42C2_B81C_D7CE886146E1
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 135c5bfebe0e866827c6878b1966163ab2f427a39095a4a6156b97f568674cf2
#. default-sha256: 288ec68d25382eb9433193b808702d17a96fb8a94b27f7c2ed05e9d8f26f4930
msgctxt "scenario4:scenario4_4D147211_E99D_42C2_B81C_D7CE886146E1"
msgid "⟪k:0⟫⟪k:1⟫⟪k:2⟫Ah..."
msgstr "⟪k:0⟫⟪k:1⟫⟪k:2⟫Ah..."

#: scenario4:scenario4_3B0F559A_0143_4023_936D_B8594593E90A
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 8463aebd1448a19543c52ff16dfc9ecca45b602fe89e19d45a3209ff49d02e86
#. default-sha256: b44183b2e8be5b0107766cd373f22394fef9116c4d2452d93fef3d387d05b5fe
msgctxt "scenario4:scenario4_3B0F559A_0143_4023_936D_B8594593E90A"
msgid "⟪k:0⟫But on her way there, she spotted him standing by the entrance,"
msgstr "⟪k:0⟫Mas no caminho para lá, ela o viu parado na entrada,"

#: scenario4:scenario4_E0603546_E5DC_49EA_85A5_308CDFAB747B
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 7a1f92e4c2d34da6ea0a8f1abfadde97f2d0e3b8d6ea796da39c14bb5e45f063
#. default-sha256: 4c3dcd06589a2d0bd46b17f8cf52095fe462c6794d71b5c8257799bc9fee757f
msgctxt "scenario4:scenario4_E0603546_E5DC_49EA_85A5_308CDFAB747B"
msgid ""
"⟪k:0⟫staring motionless at the door, lit by a single candle. ⟪k:1⟫He appeared to be waiting for "
"something."
msgstr ""
"⟪k:0⟫olhando imóvel para a porta, iluminado por uma única vela. ⟪k:1⟫⟪k:2⟫Ele parecia estar "
"esperando por algo."

#: scenario4:scenario4_F165E07F_0730_4DD0_BBF8_22866D9D8BAE
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 6a5934a727ff3876845f03de77f96c0b225ca46e52c125f0947725c38d63d30a
#. default-sha256: 0f395baed9f1d6676c3a44831133ca1c7199a437f0b5db533f5fb426f7d5cbea
msgctxt "scenario4:scenario4_F165E07F_0730_4DD0_BBF8_22866D9D8BAE"
msgid "⟪k:0⟫Um..."
msgstr "⟪k:0⟫Hum..."

#: scenario4:scenario4_561B3E19_6D73_4271_B805_36A8F0766D4A
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 33cfe2ab2802f9c576c06961c86ff2364362be144e518ae8b8a709920d69f962
#. default-sha256: 1c812955ab9bac78e3a90e06d812791e1961c834f796f1436b7f9a497f0f3238
msgctxt "scenario4:scenario4_561B3E19_6D73_4271_B805_36A8F0766D4A"
msgid "⟪k:0⟫⟪k:1⟫⟪k:2⟫............"
msgstr "⟪k:0⟫⟪k:1⟫⟪k:2⟫............"

