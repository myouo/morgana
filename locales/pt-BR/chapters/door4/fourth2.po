#. native-sha256: 11e6e31a73b97b0c6776e74f50cdad08dad728b7d7f0135927f7ab61c7c869b6
#. default-sha256: 2d4f549766cc6c758d36c699a351529d3a427a811c1af08586aee53bf886c927
msgctxt "scenario4:scenario4_54050BD7_BD20_4F3F_89D2_ACF387428879"
msgid ""
"⟪k:0⟫Not only was the mansion a prison for his body, his body was also a prison ensnaring his "
"heart."
msgstr ""
"⟪k:0⟫Não apenas a mansão era uma prisão para seu corpo, seu corpo também era uma prisão enredando "
"seu coração."

#: scenario4:scenario4_7D6004BB_B5C1_46B7_A5CE_1F03430A4971
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 87ceb19316115a59ce4147c0335bd9e0fa951e62168c82900d758bbe5c4d2345
#. default-sha256: 545aee35e1a66b7cf4dc9142e07ae80fb290a137402401adeb1a64b00c397995
msgctxt "scenario4:scenario4_7D6004BB_B5C1_46B7_A5CE_1F03430A4971"
msgid "⟪k:0⟫(I should still do whatever I can.)"
msgstr "⟪k:0⟫(Eu ainda devo fazer o que puder.)"

#: scenario4:scenario4_C646BDA3_4462_4C88_B7FF_B8279C83B0D4
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: e57221825fe36b8036609dcc2b4c8fa70693b66f9c2bb854f744d80921185240
#. default-sha256: c022f7c25b15d1b74a19e8725abe5abf88c67d36302bbbde383dbb750d613f22
msgctxt "scenario4:scenario4_C646BDA3_4462_4C88_B7FF_B8279C83B0D4"
msgid ""
"⟪k:0⟫But she did not let that get her down. ⟪k:1⟫In fact, she might have even interpreted his "
"disinterest as kindness."
msgstr ""
"⟪k:0⟫Mas ela não deixou que isso a derrubasse. ⟪k:1⟫Na verdade, ela pode até ter interpretado o "
"desinteresse dele como gentileza."

#: scenario4:scenario4_13131F31_9A42_41A0_9E64_6EA53DC69456
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 1c29924c565ed434cac029267749dfc9efdb56842bde92d408cfb8c8dc2c28b5
#. default-sha256: 8c951e27daad8a866c9aca63293f8d64c56883fe3b9c6f00cf03b39e0b351612
msgctxt "scenario4:scenario4_13131F31_9A42_41A0_9E64_6EA53DC69456"
msgid ""
"⟪k:0⟫Though he was a bit standoffish, he did not attempt to cause her harm. ⟪k:1⟫He was nothing "
"like the people who had accused her of being a witch and forced her to flee for her life."
msgstr ""
"⟪k:0⟫Embora fosse um pouco distante, ele não tentou machucá-la. ⟪k:1⟫Não era nada parecido com as "
"pessoas que a acusaram de ser uma bruxa e a forçaram a fugir para salvar sua vida."

#: scenario4:scenario4_40245605_7D13_496B_AAB5_8DF61CBD11F2
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 00b6790c88489929c7d671cd7487d16939a9b63b92fa87f68e8afeda36771d0a
#. default-sha256: 7a441e95591ddc7b33e17e66be0a0ee11c747b3d5264ebacaf8ae66e7ffc40ef
msgctxt "scenario4:scenario4_40245605_7D13_496B_AAB5_8DF61CBD11F2"
msgid "⟪k:0⟫And she was deeply grateful for that."
msgstr "⟪k:0⟫E ela estava profundamente grata por isso."

#: scenario4:scenario4_3C7A6950_6D50_412E_B0FA_7756486CE3C5
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 2a1b0a494b59626efbf2d3a2f28bf43dc3489b2db1190d6c00c70426d12d11db
#. default-sha256: f8228e916054e3d2ce38c9827e4dc8341385a5a038ba43a331697432f7380f69
msgctxt "scenario4:scenario4_3C7A6950_6D50_412E_B0FA_7756486CE3C5"
msgid ""
"⟪k:0⟫⟪k:1⟫Thus began their quiet life together—⟪k:2⟫⟪k:3⟫Michel, who avoided contact with others, "
"and the White-Haired Girl, who had taken a great deal of abuse from others."
msgstr ""
"⟪k:0⟫⟪k:1⟫Assim começou sua vida tranquila juntos—⟪k:2⟫⟪k:3⟫Michel, que evitava o contato com "
"outros, e a Garota de Cabelos Brancos, que sofreu muitos abusos de outros."

#: scenario4:scenario4_6D41E979_C176_416B_9A55_48944A13EFCE
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 91446dcde9da9a5469bc74b135a9dabc7379af5359693692ae4ddc8d4d8c907a
#. default-sha256: 35dcd0a5053852f3831cf4e0b4c34ec19ee407a9c90a7e850c588a7b49e5e724
msgctxt "scenario4:scenario4_6D41E979_C176_416B_9A55_48944A13EFCE"
msgid ""
"⟪k:0⟫Two people who knew hardly anything about one another—⟪k:1⟫⟪k:2⟫who were too distant to "
"really be said to be living “together.”"
msgstr ""
"⟪k:0⟫Duas pessoas que não sabiam quase nada uma da outra—⟪k:1⟫⟪k:2⟫que estavam muito distantes "
"para realmente se dizer que viviam “juntos”."

#: scenario4:scenario4_AB6ABACB_5661_491D_B2AC_B361299E2335
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 3d3df3db54785b82a345630134442d1c319fff85cf3a069d18a6808a0a1230be
#. default-sha256: 6f8dce71f07fe6ee9e8714f0ae2fb8fb075781ff3adc15e4c995b6f6e3766c0e
msgctxt "scenario4:scenario4_AB6ABACB_5661_491D_B2AC_B361299E2335"
msgid ""
"⟪k:0⟫Michel spent most of his day in his chambers, so they only ever saw each other occasionally, "
"and they hardly ever spoke."
msgstr ""
"⟪k:0⟫Michel passava a maior parte do dia em seus aposentos, então eles só se viam ocasionalmente "
"e quase nunca se falavam."

#: scenario4:scenario4_57099ACB_C553_4EC9_955F_FAA781ED6BC2
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: bb77e71a2abd2eaef136dcd321c358bae0178784abc1060cc9100df734e9af9e
#. default-sha256: d2eefb2e58d080a23ef732bdbafe2395874976160e9143c0cd9b84b1325ffa67
msgctxt "scenario4:scenario4_57099ACB_C553_4EC9_955F_FAA781ED6BC2"
msgid "⟪k:0⟫Though they stayed in the same house,⟪k:1⟫they both still lived solitary lives."
msgstr "⟪k:0⟫Apesar de estarem na mesma casa,⟪k:1⟫ambos ainda viviam vidas solitárias."

#: scenario4:scenario4_2279AA0A_4CF2_4489_AA22_A8D2847C68CD
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 5b0c281e21d805493083ce96fb2548e91aa7bc78ea8000cbf578db785190d2e6
#. default-sha256: 5f8d414809d6c76276a3d3351cab8ec7fe37791ac096d9c8580884f1a851e810
msgctxt "scenario4:scenario4_2279AA0A_4CF2_4489_AA22_A8D2847C68CD"
msgid "⟪k:0⟫Nonetheless, the White-Haired Girl wanted to get to know Michel better."
msgstr "⟪k:0⟫Não obstante, a Garota de Cabelos Brancos queria conhecer melhor Michel."

#: scenario4:scenario4_6F15CC23_D3F5_4FEC_993D_333844D58D28
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: d84634a374f9b9a33c1b301e72f4277390bc8dbb2c79580c0a6db2b28da84482
#. default-sha256: 306522f1a08e673923c7be99e2673fda2b31137c708c005bc20ce59982190eaf
msgctxt "scenario4:scenario4_6F15CC23_D3F5_4FEC_993D_333844D58D28"
msgid "⟪k:0⟫She wanted to know why he called himself cursed,"
msgstr "⟪k:0⟫Ela queria saber por que ele se chamou de amaldiçoado,"

#: scenario4:scenario4_BE41FC56_496B_4165_A681_048D619EEEF0
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 48cf388fd27d819b6babaed0353357c8f26a40e4b9885442894f6ab09baedfaf
#. default-sha256: 01b597c77d1623afd6c232cb3087b1c9c5c6fc85c2c5999ca06767da95b19669
msgctxt "scenario4:scenario4_BE41FC56_496B_4165_A681_048D619EEEF0"
msgid "⟪k:0⟫why... ⟪k:1⟫he lived alone in this dark mansion,"
msgstr "⟪k:0⟫por que...⟪k:1⟫ele morava sozinho nesta mansão escura,"

#: scenario4:scenario4_56924B05_D029_4EF7_86C2_FBCF3E8ECDB0
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 274582a1aa8f047ebe4ff90533b65fb1f9e70b6c5695aec27a04fd3b4710e2d7
#. default-sha256: 66bc3caabc5cc3ccc01fa30ea7c54188a3f22b5a3aaa54ebc7108a7b381672e2
msgctxt "scenario4:scenario4_56924B05_D029_4EF7_86C2_FBCF3E8ECDB0"
msgid "⟪k:0⟫how many days, how many years he had spent here in solitude."
msgstr "⟪k:0⟫quantos dias, quantos anos ele passou aqui na solidão."

#: scenario4:scenario4_02943C5C_88AC_4B7C_9445_C1E7DDA92F8E
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: f58ef1628dce0e30d855de5aba16bcdb50fbbfa937ec7726718a7f459d5ac325
#. default-sha256: eec20192b415bd2862b98c11b389f67ed55f2919854da7fd60958975ee962a6e
msgctxt "scenario4:scenario4_02943C5C_88AC_4B7C_9445_C1E7DDA92F8E"
msgid ""
"⟪k:0⟫And while she waited for the opportunity, she also started doing things around the house."
msgstr "⟪k:0⟫E enquanto esperava a oportunidade, ela também começou a fazer coisas pela casa."

#: scenario4:scenario4_FEAE5476_5E22_4BE2_B5CE_EBB1071EF666
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: fa8653c1268cd8362524e9b47a401f6b3ddc0ba2925134572c25b9bc882077e9
#. default-sha256: 78de81d6a62fe9bc71114d3aef5986408391eccb3e26ce8daaca5bcb72ca0544
msgctxt "scenario4:scenario4_FEAE5476_5E22_4BE2_B5CE_EBB1071EF666"
msgid ""
"⟪k:0⟫⟪k:1⟫The first project she set out to take care of was cleaning. ⟪k:2⟫As the windows were "
"all firmly shut, her only source of light was candles."
msgstr ""
"⟪k:0⟫⟪k:1⟫O primeiro projeto que ela se propôs a cuidar foi a limpeza. ⟪k:2⟫Como as janelas "
"estavam todas firmemente fechadas, sua única fonte de luz eram as velas."

#: scenario4:scenario4_E96CF4DB_B15B_4BF1_ADC2_C15D8B247304
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: cad388cd057147548072cc1f96b6ce97f4e7afd1f34acaf7e297b1cca2c2461f
#. default-sha256: 08a299b9fcc55df59ffc1c66d9cf90a066cc050ab6e967ea22a14ef45d5357eb
msgctxt "scenario4:scenario4_E96CF4DB_B15B_4BF1_ADC2_C15D8B247304"
msgid "⟪k:0⟫For whatever reason, there was a great deal of candles stored in the cellar."
msgstr "⟪k:0⟫Por alguma razão, havia muitas velas guardadas no porão."

#: scenario4:scenario4_B3569F31_3996_4693_8CB4_72193079A5B7
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: bb76d26f9f8f586f22b7a00ce83472a5959fcb2b4cfcefca5a3418188dff88c2
#. default-sha256: d6837a4d0e9a0a638850bfe4b3e86626ce484473f86993f72b1ed36ace0caccd
msgctxt "scenario4:scenario4_B3569F31_3996_4693_8CB4_72193079A5B7"
msgid ""
"⟪k:0⟫She wondered where on earth he had acquired so many, but she never found the opportunity to "
"ask him."
msgstr ""
"⟪k:0⟫Ela se perguntou onde diabos ele havia adquirido tantas, mas ela nunca encontrou a "
"oportunidade de perguntar a ele."

#: scenario4:scenario4_790671EB_16E3_4500_8067_C875CA673253
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 34db41b14f89757885eb8b6493283ef4a2eb97acce9b864c50343c4f2dfc7ea9
#. default-sha256: 36d0adb71c2958b19166bde76302bb659b7b24894ca0bc81467e2a24f7ed0e0e
msgctxt "scenario4:scenario4_790671EB_16E3_4500_8067_C875CA673253"
msgid ""
"⟪k:0⟫It was difficult to even see all the dust and cobwebs with only candlelight, and considering "
"the poor airflow through the house, she was afraid her efforts were going to be in vain."
msgstr ""
"⟪k:0⟫Era difícil até mesmo de ver toda a poeira e teias de aranha apenas com a luz de velas, e "
"considerando o fluxo ruim de ar pela casa, ela temia que seus esforços fossem em vão."

#: scenario4:scenario4_73075EBA_6725_4B69_BE7A_FC90071FF6BE
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 7ba7894b3f122bdfd011b3d0f360e406cc8cc881ada6a57535c9472f0acbd0d9
#. default-sha256: 05e6dc196a0f25cdf876c95476e2fc658cefedcaa534612452da4d2a82accd1f
msgctxt "scenario4:scenario4_73075EBA_6725_4B69_BE7A_FC90071FF6BE"
msgid "⟪k:0⟫Still she persisted, sweeping and wiping things down, one room at a time."
msgstr "⟪k:0⟫Ainda assim ela persistiu, varrendo e limpando as coisas, um quarto de cada vez."

#: scenario4:scenario4_A9B09618_AA36_4C3F_8C7A_ECABE6D861FF
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: e81f99cab436e8874eff44f4364ea75a3b15e7b1a2c50ad17a65c014734b0206
#. default-sha256: 064b07f4acc69c727167a032141cc8417604ac774b2dc95962bc39ed560699bb
msgctxt "scenario4:scenario4_A9B09618_AA36_4C3F_8C7A_ECABE6D861FF"
msgid ""
"⟪k:0⟫Eventually, she made her way to the library.⟪k:1⟫⟪k:2⟫The dust that had settled there was "
"much heavier than in any other room; ⟪k:3⟫with each breath, she had to fight back coughs."
msgstr ""
"⟪k:0⟫Eventualmente, ela foi até a biblioteca.⟪k:1⟫⟪k:2⟫A poeira que havia assentado ali era muito "
"mais pesada do que em qualquer outro cômodo; ⟪k:3⟫a cada respiração, ela tinha que lutar contra a "
"tosse."

#: scenario4:scenario4_1ED3589A_04FC_4AA7_9181_C7023BD6EA65
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 650276a6f39a1d6aa5d9d82853fc209e7a927ab68b57b4a98130cd3313407702
#. default-sha256: 6d5568c4625187d6e510f73b637b81871f6d46f37eeb4291201d23d6c3669310
msgctxt "scenario4:scenario4_1ED3589A_04FC_4AA7_9181_C7023BD6EA65"
msgid ""
"⟪k:0⟫It was not a room one would normally be comfortable spending much time in, but the sight of "
"so many bulky volumes lining the shelves sent her heart aflutter with delight."
msgstr ""
"⟪k:0⟫Não era um aposento em que normalmente alguém se sentiria confortável em passar muito tempo, "
"mas a visão de tantos grossos volumes alinhados nas prateleiras fez seu coração palpitar de "
"deleite."

#: scenario4:scenario4_AD3E8AC4_00BA_4D0A_A64F_22B99EEF6A3D
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 9125c9726dca9a6563643365ca2e3e6d0bf76eeacd504f0e54596a94b7ff7176
#. default-sha256: e86b1b279d04fb09b8e4183048eba6ad72f423ad50406d72971287d635ac3d6f
msgctxt "scenario4:scenario4_AD3E8AC4_00BA_4D0A_A64F_22B99EEF6A3D"
msgid "⟪k:0⟫They’re... ⟪k:1⟫books.⟪k:2⟫⟪k:3⟫Incredible... ⟪k:4⟫Real books."
msgstr "⟪k:0⟫Eles são...⟪k:1⟫livros.⟪k:2⟫⟪k:3⟫Incrível...⟪k:4⟫Livros de verdade."

#: scenario4:scenario4_38886115_8108_4B46_86B1_0AA90E57CCA8
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: f32d30e370becf26718849e24723ae7fcb821ba9157cb1e6e57179ca572b1598
#. default-sha256: ad6ef02ab51f856ddf115ccce96682935ae543105d00e2eb5b5c5c84f8dcb721
msgctxt "scenario4:scenario4_38886115_8108_4B46_86B1_0AA90E57CCA8"
msgid ""
"⟪k:0⟫The White-Haired Girl had never seen a book before. ⟪k:1⟫She had heard people describe them, "
"but that was the first time she had ever seen one for herself."
msgstr ""
"⟪k:0⟫A Garota de Cabelos Brancos nunca tinha visto um livro antes. ⟪k:1⟫⟪k:2⟫Ela tinha ouvido as "
"pessoas descrevê-los, mas essa foi a primeira vez que ela viu um por si mesma."

#: scenario4:scenario4_5A11CAAD_2C90_4244_B40B_7A4D8700C78D
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: ae2c65f7ef6e029d0bbdb28b728c9313aa4325f82a1c69162802a4a81084d01d
#. default-sha256: fd8ba075017d71a681b02ee2dae0dd1aa814f62d4bebac00f7c66994d013414f
msgctxt "scenario4:scenario4_5A11CAAD_2C90_4244_B40B_7A4D8700C78D"
msgid "⟪k:0⟫Parchment was a very valuable commodity in that era."
msgstr "⟪k:0⟫O pergaminho era uma mercadoria muito valiosa naquela época."

#: scenario4:scenario4_747EC42F_41F5_48AA_8961_BE4879CF3798
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 10b961599948f27dcd3c1dc57707bc49bfe208dfe8d733271d0ea9a7c4ec1667
#. default-sha256: 907c895d1ee374bbed2efa2a405d3d5cabbe9cc3b0b378df2b67e4320f255c8b
msgctxt "scenario4:scenario4_747EC42F_41F5_48AA_8961_BE4879CF3798"
msgid ""
"⟪k:0⟫It was something monks or scholarly priests made use of, and not a material one could easily "
"acquire without some degree of social rank."
msgstr ""
"⟪k:0⟫Era algo de que monges ou sacerdotes eruditos faziam uso, e não era um material que se "
"pudesse adquirir facilmente sem ter uma boa posição social."

#: scenario4:scenario4_459918B0_5D9B_44F0_BDDC_30A3C489745D
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 287d61ba7072c3b4b3c0815fa217bb4b8773e33878a23b4e0e7541700917e99d
#. default-sha256: 02d1cf54922e3ced4648d260855a9bace8cc2da841edd69332be26e05e738748
msgctxt "scenario4:scenario4_459918B0_5D9B_44F0_BDDC_30A3C489745D"
msgid "⟪k:0⟫Books were not printed with machines, but copied by hand."
msgstr "⟪k:0⟫Livros não eram impressos com máquinas, mas copiados à mão."

#: scenario4:scenario4_75D69473_E7A3_4283_822D_A10B509FD98E
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 2bd0a025706d5e577cc69deaa029c780a47ba79040d4dd7b1b3a61700116b027
