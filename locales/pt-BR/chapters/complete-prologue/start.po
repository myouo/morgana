#: prologue:prologue_9C5985A3_A450_4279_89AD_E4C9055CB369
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 700777b3af64e283aba379c5d3c3e18df079d8baec67a9d923a39950f5413dac
#. default-sha256: ed2cdbe9f4635f40ca13240a4ba21bde7fb2145a909f7a2d9887b1495fe46ac2
msgctxt "prologue:prologue_9C5985A3_A450_4279_89AD_E4C9055CB369"
msgid "⟪k:0⟫What’s the occasion? You never come to wake me up."
msgstr "⟪k:0⟫Qual é a ocasião? Você nunca vem me acordar."

#: prologue:prologue_68962FD1_5789_4814_BF46_B3586D07440A
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: f4668065a0af893210c90e5e4ccf9b66e3892c8607b81a9bef96639c019adff8
#. default-sha256: 737b9d9b66735edd7116a6e3217de3c5c5a3e1887a641885bc92e8f5c5274023
msgctxt "prologue:prologue_68962FD1_5789_4814_BF46_B3586D07440A"
msgid ""
"⟪k:0⟫⟪k:1⟫I was merely concerned for your health.⟪k:2⟫⟪k:3⟫You really should be sleeping in a "
"proper bed."
msgstr ""
"⟪k:0⟫⟪k:1⟫Eu só estava preocupada com a sua saúde.⟪k:2⟫⟪k:3⟫Você realmente deveria dormir em uma "
"cama de verdade."

#: prologue:prologue_CF9E89B3_32AE_40C3_9AFC_47CEAC6DA8C3
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 3d244bb2b9b85c41d65afc617171b8a305d89c30f7d8c9acac613730e21c2164
#. default-sha256: cafe938bad19ddfd9f9b6e64c637eb199868e08776eab6e1454d12d085db630f
msgctxt "prologue:prologue_CF9E89B3_32AE_40C3_9AFC_47CEAC6DA8C3"
msgid ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫You were ⟪k:3⟫concerned⟪k:4⟫? About ⟪k:5⟫me⟪k:6⟫?⟪k:7⟫⟪k:8⟫You do realize the "
"concept of “health” bears little meaning for either of us, don’t you?"
msgstr ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫Você estava ⟪k:3⟫preocupada⟪k:4⟫? ⟪k:5⟫Comigo⟪k:6⟫?⟪k:7⟫⟪k:8⟫Você sabe que o "
"conceito de “saúde” tem pouco significado para qualquer uma de nós, não é?"

#: prologue:prologue_42F500E6_AADF_4523_B5D0_46846E73867B
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 8c5904d00811597a817ee3c79d4ed0ea14e667af37843c931df0bf3e7c9251e0
#. default-sha256: 482b8af5b961e5e94c5b3b039f8bf7af792b3bce8b73e2b908bc94e414d00fb3
msgctxt "prologue:prologue_42F500E6_AADF_4523_B5D0_46846E73867B"
msgid ""
"⟪k:0⟫⟪k:1⟫Why would I not be concerned? ⟪k:2⟫You ⟪k:3⟫are⟪k:4⟫ me.⟪k:5⟫⟪k:6⟫If something were to "
"cause you to depart this world,⟪k:7⟫the same would happen to me."
msgstr ""
"⟪k:0⟫⟪k:1⟫Por que eu não me preocuparia? ⟪k:2⟫Você ⟪k:3⟫é⟪k:4⟫ eu.⟪k:5⟫⟪k:6⟫Se algo a fizesse "
"partir deste mundo,⟪k:7⟫o mesmo aconteceria comigo."

#: prologue:prologue_B351EC4B_885F_482C_B4CB_BCEFFF7E34F7
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: cdcccb49d3addc1caade54120850c3e5ea6a4afdd048c47c9e0823028219bbc7
#. default-sha256: 892b74c72f71435fab8e0577a0ab67211f8f98cb8933927f4d2ad06fdfdf3e52
msgctxt "prologue:prologue_B351EC4B_885F_482C_B4CB_BCEFFF7E34F7"
msgid "⟪k:0⟫⟪k:1⟫⟪k:2⟫Ahh... ⟪k:3⟫right.⟪k:4⟫⟪k:5⟫That’s true."
msgstr "⟪k:0⟫⟪k:1⟫⟪k:2⟫Ahh... ⟪k:3⟫certo.⟪k:4⟫⟪k:5⟫É verdade."

#: prologue:prologue_219F44A4_AECD_4C4F_AFBA_6559324490AB
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 97cb76a03f3a5f5f6a99293f9593594fafccd324cdb7762c1116f60f06243287
#. default-sha256: a3bacfcf04f3317fa9eade4d7e605469874ed449d1ba3295258fd126fc075b40
msgctxt "prologue:prologue_219F44A4_AECD_4C4F_AFBA_6559324490AB"
msgid ""
"⟪k:0⟫(It was so long ago, I almost forgot I told her she was me.⟪k:1⟫⟪k:2⟫And it would seem she "
"still believes that to be the case.)"
msgstr ""
"⟪k:0⟫(Faz tanto tempo que quase esqueci que disse a ela que ela era eu.⟪k:1⟫⟪k:2⟫E parece que ela "
"ainda acredita nisso.)"

#: prologue:prologue_3BF7FF21_91E5_45AA_8A70_93A97AE211F1
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 386b6804ae6878779d85bbd05c0876f7f7bbf2b0a2835086ba3729f8344a867c
#. default-sha256: 677edd44aecd0c1a0730f1b5d3bccfc7fa63a367931b9266a430b5033539910e
msgctxt "prologue:prologue_3BF7FF21_91E5_45AA_8A70_93A97AE211F1"
msgid "⟪k:0⟫(Foolish woman.)"
msgstr "⟪k:0⟫(Mulher tola.)"

#: prologue:prologue_2494829B_6EF8_4259_8A89_724BF8C2E9BE
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: b16f5b32aac5b63be6e8ff9ab50bcd77d8b9d86ec41662aac2cd632a00973762
#. default-sha256: a175fb1972906cbffeda9e0f1150f1744f4c10cf6a8363f571e00bfa2000fb39
msgctxt "prologue:prologue_2494829B_6EF8_4259_8A89_724BF8C2E9BE"
msgid ""
"⟪k:0⟫⟪k:1⟫Hehe... ⟪k:2⟫What kind of herbal tea would you like to start your day with?⟪k:3⟫⟪k:4⟫I "
"have some lovely mint leaves, if you would like.⟪k:5⟫⟪k:6⟫They are wonderful for improving one’s "
"mood."
msgstr ""
"⟪k:0⟫⟪k:1⟫Hehe... ⟪k:2⟫Com que tipo de chá de ervas você gostaria de começar o dia?⟪k:3⟫⟪k:4⟫"
"Tenho umas maravilhosas folhas de hortelã, se quiser.⟪k:5⟫⟪k:6⟫São ótimas para melhorar o humor."

#: prologue:prologue_A3379ACC_2922_40DF_B93A_42D0249E6756
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 4cbf87232e50c21849c05254b21c6aa8ecab1e64121977185e38e1bfdfaeaca7
#. default-sha256: 70b4e57e5517f83b03e93122b659cdb30e35c596b1392c4a762a7981f041eb18
msgctxt "prologue:prologue_A3379ACC_2922_40DF_B93A_42D0249E6756"
msgid "⟪k:0⟫⟪k:1⟫⟪k:2⟫I have no interest in—⟪k:3⟫⟪k:4⟫or need for—⟪k:5⟫⟪k:6⟫tea."
msgstr "⟪k:0⟫⟪k:1⟫⟪k:2⟫Não tenho interesse—⟪k:3⟫⟪k:4⟫nem necessidade—⟪k:5⟫⟪k:6⟫de chá."

#: prologue:prologue_2A7416EA_6EC3_4EC3_B482_0837EB84EE2E
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: bbed3ce66ce67fdfd0b37043918f29b430bab8311fa3014f814d895a1de60e91
#. default-sha256: d54d28b06f441113cd62906ccbf025619ca1996d18d4729e53b7b9f34efca742
msgctxt "prologue:prologue_2A7416EA_6EC3_4EC3_B482_0837EB84EE2E"
msgid "⟪k:0⟫⟪k:1⟫That is most unfortunate."
msgstr "⟪k:0⟫⟪k:1⟫Que pena."

#: prologue:prologue_8FC837AF_E40A_4C1D_94F4_77A8DB4EDBD0
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 56f7fd1fb29c0166ad3f66e7fdf945baef8c40ba72f220885e76d2fa0c5f68f6
#. default-sha256: 72ad66c494546780bb5014fb0442e56240586ad7c6d246f4797d71fcb7230572
msgctxt "prologue:prologue_8FC837AF_E40A_4C1D_94F4_77A8DB4EDBD0"
msgid "⟪k:0⟫⟪k:1⟫In that case, perhaps you could tell me a story?"
msgstr "⟪k:0⟫⟪k:1⟫Nesse caso, talvez possa me contar uma história?"

#: prologue:prologue_403866E0_6E4F_493B_A27C_2C7EAFE6329E
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: d848fb22ae0e1d2a710e92c8ce4c32ff7f4fae5a3211c3ac4b2eaec83107723d
#. default-sha256: a3c9bf39f610f18c9bc6d5d500f3ea8505aed47c4790e52486a4a64fac9bab74
msgctxt "prologue:prologue_403866E0_6E4F_493B_A27C_2C7EAFE6329E"
msgid "⟪k:0⟫⟪k:1⟫⟪k:2⟫A story?⟪k:3⟫⟪k:4⟫You mean the one about Michel and Giselle again?"
msgstr "⟪k:0⟫⟪k:1⟫⟪k:2⟫Uma história?⟪k:3⟫⟪k:4⟫Quer dizer aquela sobre Michel e Giselle de novo?"

#: prologue:prologue_0B05D229_DD6F_426C_BBE6_F3909259CA5D
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 26c97323f5a6fd5085498f68bb3f7bd57108814798a26fdb6d53eb08a89d778f
#. default-sha256: 085b92ab9210b4625821cc1279190395e8e239c178a3746a92e9a5dbc451c60d
msgctxt "prologue:prologue_0B05D229_DD6F_426C_BBE6_F3909259CA5D"
msgid "⟪k:0⟫⟪k:1⟫Yes, that one.⟪k:2⟫⟪k:3⟫I do love that story oh so very much."
msgstr "⟪k:0⟫⟪k:1⟫Sim, essa.⟪k:2⟫⟪k:3⟫Eu amo tanto essa história."

#: prologue:prologue_4604B25A_659B_44D1_9FFC_0469BC280F95
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 1dfa6df395554879fb846a461e4c51b07e34dfe4fa7a57d491b033ccf0b5739b
#. default-sha256: 12baf10d70b4d182c0a376f4fe95ddde94cde0a6ded88946e43b6bc64aec1472
msgctxt "prologue:prologue_4604B25A_659B_44D1_9FFC_0469BC280F95"
msgid ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫I, for one, am growing rather tired of it.⟪k:3⟫⟪k:4⟫I’ve told it to you dozens of "
"times now."
msgstr ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫Eu, pelo menos, já estou ficando cansada.⟪k:3⟫⟪k:4⟫Já contei para você dezenas de "
"vezes."

#: prologue:prologue_DB2E9551_BD10_4F5E_B19B_02E32600B333
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: c3f8f73e799eec37cb5678709746bf06712e4b4ebb5c6f4979ea931fa7303437
#. default-sha256: 71bb3207cee6cae732654a88026fb0230dd8caaccc718a0e6c5ef968ad1bbb57
msgctxt "prologue:prologue_DB2E9551_BD10_4F5E_B19B_02E32600B333"
msgid ""
"⟪k:0⟫⟪k:1⟫Now, don’t be like that.⟪k:2⟫⟪k:3⟫The best stories never stop being moving,⟪k:4⟫no "
"matter how many times you hear them."
msgstr ""
"⟪k:0⟫⟪k:1⟫Ora, não seja assim.⟪k:2⟫⟪k:3⟫As melhores histórias nunca deixam de emocionar,⟪k:4⟫por "
"mais vezes que você as ouça."

#: prologue:prologue_FE9551A9_E7B3_4525_AC83_90F29E5824B3
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 2267537a83e19f45cd4a91a8080f82395fafbeaeeb576bf2d28cfb1ec03870df
#. default-sha256: 322d5bf000c3cfff0fa3b6b8ccb669b1625ad73a68ce41703a55837e499bacdc
msgctxt "prologue:prologue_FE9551A9_E7B3_4525_AC83_90F29E5824B3"
msgid "⟪k:0⟫⟪k:1⟫⟪k:2⟫(It’s like I’m talking to a child...)"
msgstr "⟪k:0⟫⟪k:1⟫⟪k:2⟫(É como se eu estivesse falando com uma criança...)"

#: prologue:prologue_9A642A70_8B15_47C9_BD7B_BEB6E479AED8
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 90ac422694bef6d7b7a4fcbd1984f17d4978ff171a57f7e649e2cf0cac60e869
#. default-sha256: b27cf53355d4091a0a72ea3570f3e59a6cfe46db99f4902ff6a56d6a96cff92b
msgctxt "prologue:prologue_9A642A70_8B15_47C9_BD7B_BEB6E479AED8"
msgid ""
"⟪k:0⟫All right, then, how about this? ⟪k:1⟫I’m going to ask you a question,⟪k:2⟫and if you give "
"me an answer I like, I’ll tell you the story again."
msgstr ""
"⟪k:0⟫Muito bem, que tal assim? ⟪k:1⟫Vou fazer uma pergunta,⟪k:2⟫e se me der uma resposta que eu "
"goste, conto a história de novo."

#: prologue:prologue_37041A75_7016_4F96_B9C5_AD3F59AEC5F5
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 9043f25a2b6488d9acc7e9193243ed2b71be47e7eb4c260a69d68c4e5135f08b
#. default-sha256: ce5b6a160a265f56029a0f79f41d25921536b0c8affd310b05b2cb9aac0bd5d7
msgctxt "prologue:prologue_37041A75_7016_4F96_B9C5_AD3F59AEC5F5"
msgid "⟪k:0⟫⟪k:1⟫Oh? What kind of question?"
msgstr "⟪k:0⟫⟪k:1⟫Oh? Que tipo de pergunta?"

#: prologue:prologue_DDEDFAD1_E397_4B12_B05A_473A3CDE182C
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: a33537fe5684725044f638ef15b8f41d98d8359d79778766d8f0445d470e25d2
#. default-sha256: db0d15d3317b9baf846a5ce15c7fa3c695d3b5bddddf02296289c09b7f4821f1
msgctxt "prologue:prologue_DDEDFAD1_E397_4B12_B05A_473A3CDE182C"
msgid ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫Hehe... ⟪k:3⟫Nothing difficult, I promise.⟪k:4⟫⟪k:5⟫I want to hear your opinion on "
"something."
msgstr ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫Hehe... ⟪k:3⟫Nada difícil, prometo.⟪k:4⟫⟪k:5⟫Quero ouvir sua opinião sobre algo."

#: prologue:prologue_30C3C1BA_1D3D_4D6D_A3C5_556EB160ED24
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 21abf378b4cb4c0b807a9abe76b256ca717c1ade0a95abe3335d530d4570c2e6
#. default-sha256: 7ab931f905796c628c2b24658b97a60d69a38b5561453fab05a050cae036d6a1
