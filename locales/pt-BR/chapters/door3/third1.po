msgid ""
"⟪k:0⟫The other men in the room chuckled uncomfortably at Jacopo’s distasteful choice of words."
msgstr ""
"⟪k:0⟫Os outros homens na sala riram desconfortáveis ​​com a escolha desagradável de palavras de "
"Jacopo."

#: scenario3:scenario3_5C9354BC_4C69_44D9_9188_13AD9CA3D36B
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: bc699d5467496de390111f96523c3dbd3ac0e488ac8467e345f1b47f22f29cd4
