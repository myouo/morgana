msgctxt "scenario3:scenario3_9A10FC2F_5A65_43FC_B4D6_EA158DC04EBF"
msgid "⟪k:0⟫I felt like I had gotten closer to you."
msgstr "⟪k:0⟫Senti como se tivesse me aproximado de você."

#: scenario3:scenario3_7C6151C5_059E_43DA_96D1_C74626D77CBB
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: dfa81bfd7ed18a86241e62ca6d5e573b802338c01ee4b969dcbe8d868ccbb772
