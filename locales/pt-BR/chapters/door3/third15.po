msgctxt "scenario3:scenario3_86406C83_4B36_4C3F_8CC6_F48CAD8E8C13"
msgid ""
"⟪k:0⟫he would have almost certainly been able to realize the letters were directed at him, "
"despite the altered recipient name."
msgstr ""
"⟪k:0⟫quase certamente teria percebido que as cartas eram dirigidas a ele, apesar do nome do "
"destinatário alterado."

#: scenario3:scenario3_43B42520_6217_4709_AF6F_354D10551C5A
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 4ad1ff02f30333a0643a17e8289b971c6db51154cf7b3bd3bd2505aad1f7bff0
