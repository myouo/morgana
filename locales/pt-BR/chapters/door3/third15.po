msgctxt "scenario3:scenario3_43B42520_6217_4709_AF6F_354D10551C5A"
msgid "⟪k:0⟫Everything she wrote about concerned him, after all."
msgstr "⟪k:0⟫Afinal, tudo o que ela escrevia era sobre ele."

#: scenario3:scenario3_8F118727_77C2_4DE7_80CE_8D1A5127EBD4
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: cc9715505e4237ff91250e2ca1c146a9e8b5448c4430e3fbdc6452060c33edcd
