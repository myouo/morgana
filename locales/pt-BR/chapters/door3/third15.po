msgctxt "scenario3:scenario3_8F118727_77C2_4DE7_80CE_8D1A5127EBD4"
msgid ""
"⟪k:0⟫How could someone who had lived as isolated a life as her have so many identical experiences "
"with two distinct men?"
msgstr ""
"⟪k:0⟫Como alguém que viveu uma vida tão isolada quanto ela poderia ter tantas experiências "
"idênticas com dois homens distintos?"

#: scenario3:scenario3_110FC6C1_9CAB_4787_A205_619E20331F8D
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: f4c603594177e0d30987205b091e27f717be7a11c601c1b68da7f4c12ae568ed
#. default-sha256: 75737df027e77e8d89cdb83bf2c3a5d561bfdb3c76003db5907d394e53d5ea47
msgctxt "scenario3:scenario3_110FC6C1_9CAB_4787_A205_619E20331F8D"
msgid ""
"⟪k:0⟫Why could he not find it in himself to trust her?⟪k:1⟫⟪k:2⟫Perhaps doubting her was simply "
"easier."
msgstr ""
"⟪k:0⟫Por que ele não conseguia confiar nela? ⟪k:1⟫Talvez duvidar dela fosse simplesmente mais "
"fácil."

#: scenario3:scenario3_02F83CA3_4101_40CE_890F_DDC2792CE5D2
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 562c696619737d319ba043e80399750aa5415e56bf887ea4fc3b4a20f7fbfe42
#. default-sha256: 49343e5f332d3d1780a28909a430f15f6cd9d0acce9e0cae972f6f97842ecc00
msgctxt "scenario3:scenario3_02F83CA3_4101_40CE_890F_DDC2792CE5D2"
msgid "⟪k:0⟫If you were in his position... ⟪k:1⟫would you trust her?"
msgstr "⟪k:0⟫Se você estivesse no lugar dele... ⟪k:1⟫confiaria nela?"

#: scenario3:scenario3_35F58E7B_DAE2_401E_B9CA_4E67094F114F
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 2d0e2cb71c069dbc2adb0c2ee66c4c993014b046fbf0f77318156dae7c078d4d
