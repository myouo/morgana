#: scenario3:scenario3_B22C54AE_13D7_4EF6_98DD_84AB3228666B
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 76ec5211d9072418c2f84a4147ecc5f41faf2088bd2469a4a28e021e1d1be4d4
#. default-sha256: 648f0e61fd27f43cf0cd54108ba88d3caebdb0905af7764321985d42280132ae
msgctxt "scenario3:scenario3_B22C54AE_13D7_4EF6_98DD_84AB3228666B"
msgid "⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫Master. ⟪k:4⟫Master."
msgstr "⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫Mestre. ⟪k:4⟫Mestre."

#: scenario3:scenario3_2FCCFDD8_433A_4294_9CB6_5C7C35CDD92C
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 8b78d887dda2382eccf794de6e6cd762918b8f85d0f8b167b65c6f37ca0e7f46
#. default-sha256: 1cfebd55bbf3b6d5400cbb4f0e0cd1b16cc9e18988966dee0faedc0782bb489d
msgctxt "scenario3:scenario3_2FCCFDD8_433A_4294_9CB6_5C7C35CDD92C"
msgid "⟪k:0⟫Are you shocked?⟪k:1⟫⟪k:2⟫Or do you instead lament this development?"
msgstr "⟪k:0⟫Você está chocado?⟪k:1⟫ Ou, em vez disso, você lamenta essa revelação?"

#: scenario3:scenario3_1EFB07A8_8D5D_4CCA_9EFD_23CE0ACEAA07
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 47ccd7f34d39a5e07f723b29d6c8ee2cc39d276d1518fa65169e9768a4444bfa
#. default-sha256: 14f0e3cc839713e16a2128001c690bf748b2109f84b7f94776bfdf0510883d32
msgctxt "scenario3:scenario3_1EFB07A8_8D5D_4CCA_9EFD_23CE0ACEAA07"
msgid ""
"⟪k:0⟫I was... ⟪k:1⟫I was deeply sorrowful.⟪k:2⟫⟪k:3⟫Though to a lesser degree about Maria’s true "
"intentions and more my shameful inability to recognize her machinations."
msgstr ""
"⟪k:0⟫Eu estava...⟪k:1⟫Eu estava profundamente triste.⟪k:2⟫ Embora em menor grau pelas verdadeiras "
"intenções de Maria e mais pela minha vergonhosa incapacidade de reconhecer suas maquinações."

#: scenario3:scenario3_69DB4C0C_31D8_4AFE_B6DE_D91912124EB6
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: c3a76e1cde16eb1a4ea27c18eb27f719502e6c40ea8b1e6e681921640a12c196
#. default-sha256: 4b36ad724cf28668cb049479685c597551627471e19b94ce27d97d970e04fd83
msgctxt "scenario3:scenario3_69DB4C0C_31D8_4AFE_B6DE_D91912124EB6"
msgid "⟪k:0⟫At the time, I too believed that Maria was the White-Haired Girl’s one and only ally."
msgstr ""
"⟪k:0⟫Na época, eu também acreditava que Maria era a única aliada da Garota de Cabelos Brancos."

#: scenario3:scenario3_A420E2B1_D973_4284_8769_540A95782AF0
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 09b0507ae6e1806801e6f0922bee27b364820d0e250e6287c22549ee071614b8
#. default-sha256: 91eabe8a2a3084c3bd76c1c5cfb8383e037038733663665f8a0de64c17380b5b
msgctxt "scenario3:scenario3_A420E2B1_D973_4284_8769_540A95782AF0"
msgid "⟪k:0⟫It was not until everything had drawn to a close that I discovered the truth."
msgstr "⟪k:0⟫Foi só quando tudo chegou ao fim que descobri a verdade."

#: scenario3:scenario3_0FBCF4C5_58AC_40A3_9903_30F2EEDD78E1
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: e85b8e2fa0bdeb6b95b3b8d6510f8070caad34b867eebcb41d4abc0b9f89f363
#. default-sha256: 7957fbb1207a8c028857e8b36d0f0ed76f22f89a061b8209bb39e1a9ef1331c8
msgctxt "scenario3:scenario3_0FBCF4C5_58AC_40A3_9903_30F2EEDD78E1"
msgid "⟪k:0⟫...Then I now know how the tale ends, you say? ⟪k:1⟫Yes, that is correct."
msgstr "⟪k:0⟫...Então agora eu sei como a história termina, você diz? ⟪k:1⟫Sim, está correto."

#: scenario3:scenario3_BEED55E5_FC2D_4478_B59E_1B24A3621BE8
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: d8bf0d6e6f7a674264eb3c36e08323cfb2c77b58d9ff2374d7d6d5709b463db6
#. default-sha256: 5b433b50159f613ca8d55dbbcc66e3a632359e3d93eb45b78b76f1f191ac7486
msgctxt "scenario3:scenario3_BEED55E5_FC2D_4478_B59E_1B24A3621BE8"
msgid ""
"⟪k:0⟫Well aware that it was not the case, I told you the story in a way that suggested she ⟪k:1⟫"
"was⟪k:2⟫ on the White-Haired Girl’s side."
msgstr ""
"⟪k:0⟫Bem ciente de que não era o caso, eu contei a história de uma forma que sugeria que ela ⟪k:1⟫"
"estava⟪k:2⟫ do lado da Garota de Cabelos Brancos."

#: scenario3:scenario3_037D8825_28AD_45EC_B463_30A9229BB447
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 7f532996ad166169d1502f044f313a0c5cdbb11634cbfa880eb65fdfee96a4f6
#. default-sha256: bc9e7ad23e2ef8197a8be0fa3dc860bee760615cbea5df8a644de4ce1b49423f
msgctxt "scenario3:scenario3_037D8825_28AD_45EC_B463_30A9229BB447"
msgid "⟪k:0⟫Oh my... ⟪k:1⟫I wonder if that constitutes lying to you, Master."
msgstr "⟪k:0⟫Ah nossa... ⟪k:1⟫Eu me pergunto se isso significa mentir para você, Mestre."

#: scenario3:scenario3_536BA22B_D9AB_4269_98F1_CF7925EE61BA
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: b16e798a4e7342af7a6a71cfda663ee89aff74c50836c10ef4ddef40943162da
#. default-sha256: ce0804c9e15b604bbe035df64f0fcd95dd2f1ea9546fd6fc3c8d90f9a606b9b4
msgctxt "scenario3:scenario3_536BA22B_D9AB_4269_98F1_CF7925EE61BA"
msgid ""
"⟪k:0⟫I merely wanted to present the events to you in order, starting from the beginning, when "
"Maria’s ill intentions were still veiled in shadow."
msgstr ""
"⟪k:0⟫Queria apenas apresentar-lhe os acontecimentos em ordem, começando desde o início, quando as "
"más intenções de Maria ainda estavam veladas nas sombras."

#: scenario3:scenario3_B07B1C5C_AD18_48B5_9A1C_9188D3B65528
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 10bd5a7f3cdfdc8c38446546bb0025b0592697b5e51ee00aba954a7798acc93d
#. default-sha256: 949c170bb58c4bc1d71ee7555a5b803d08d95560e05997674927848ed39d2ca9
msgctxt "scenario3:scenario3_B07B1C5C_AD18_48B5_9A1C_9188D3B65528"
msgid "⟪k:0⟫I wanted you to know the same feeling of consternation I had experienced."
msgstr "⟪k:0⟫Eu queria que você conhecesse o mesmo sentimento de mágoa que eu experimentei."

#: scenario3:scenario3_E9E59592_BFFD_4854_A962_ECEE24240B56
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: e2e91348bc535029e9fd9b8e54b3f40068a457c90602d7c26be6a76fe1fb005c
#. default-sha256: 55511b7c3e32c155eba72b197fe3666babe078b7efc2670e417f6a25d35d52fc
msgctxt "scenario3:scenario3_E9E59592_BFFD_4854_A962_ECEE24240B56"
msgid ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫⟪k:4⟫⟪k:5⟫⟪k:6⟫⟪k:7⟫⟪k:8⟫⟪k:9⟫The White-Haired Girl continued to write letter "
"after letter."
msgstr ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫⟪k:4⟫⟪k:5⟫⟪k:6⟫⟪k:7⟫⟪k:8⟫⟪k:9⟫A Garota de Cabelos Brancos continuou a "
"escrever carta após carta."

#: scenario3:scenario3_F1FC3C19_29B2_4F4C_836F_C0D34DD55451
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: c6f9f39eb225e4b2bb40edd2a5cfe2a2fd68e6420ec4157dce42be1b020d468b
#. default-sha256: 717d3f66feac0b608c61e736582fa86fb56d60a36c85f9ef6fd37c3335b377aa
msgctxt "scenario3:scenario3_F1FC3C19_29B2_4F4C_836F_C0D34DD55451"
msgid ""
"⟪k:0⟫They were all addressed to her dear husband, detailing her ever-persistent love for him..."
msgstr ""
"⟪k:0⟫Todas eram endereçadas ao seu querido marido, detalhando seu sempre persistente amor por "
"ele..."

#: scenario3:scenario3_8FD88E68_AF08_459F_BEA4_43220459FE5D
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 2b125691526a4f97f7aeff89eb104c2dde19c28b5f595bf2b9d52c86365c8047
#. default-sha256: f39dda1e79ad42f55ff27a0eb6ca6a6d685f436af0ab49719d4fbcc98590dfda
msgctxt "scenario3:scenario3_8FD88E68_AF08_459F_BEA4_43220459FE5D"
msgid "⟪k:0⟫and her desire for their relationship to return to what it had once been."
msgstr "⟪k:0⟫e seu desejo de que o relacionamento deles voltasse ao que era antes."

#: scenario3:scenario3_7332670A_DF5B_43B9_8DC2_C59C37EC2896
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: bcf4004f594f8c063437ad139602fa91a5b494c0b36a3a67797240ea55f50cb1
#. default-sha256: e61639f99414b1cc46f22c016c156f42493e99d4bf3c6f8d399955d2d43e5606
msgctxt "scenario3:scenario3_7332670A_DF5B_43B9_8DC2_C59C37EC2896"
msgid "⟪k:0⟫⟪k:1⟫My beloved,⟪k:2⟫⟪k:3⟫I am sure your hands are quite full right now.⟪k:4⟫"
msgstr "⟪k:0⟫⟪k:1⟫Meu amado,⟪k:2⟫ tenho certeza de que está bastante ocupado agora.⟪k:3⟫"

#: scenario3:scenario3_7377A6CF_B0F7_4CE8_9A1E_B62F992FB17E
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 069ec4ed46f5a08f9fb457b281e11eda77bd0d93d6d0db7f0aaa306f5d0a2c4f
#. default-sha256: fed456da0e1136d7386ec5697400dc80627f288d26f2e564de1d20a9cdf6c35d
msgctxt "scenario3:scenario3_7377A6CF_B0F7_4CE8_9A1E_B62F992FB17E"
msgid "⟪k:0⟫⟪k:1⟫But that is fine; it does not change my love for you.⟪k:2⟫"
msgstr "⟪k:0⟫⟪k:1⟫Mas tudo bem; isso não muda meu amor por você.⟪k:2⟫"

#: scenario3:scenario3_D6C01F95_238D_42FB_8CEB_21E1ACDEB556
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 1dd4ce43e33fb9305640db036932550177f486744a13ac23c3bc35f92c2e3bf3
#. default-sha256: 3c4ff632903960d22e3fe5740e51475f2ff7596cd1ebad4d9f6051b6ac93c602
msgctxt "scenario3:scenario3_D6C01F95_238D_42FB_8CEB_21E1ACDEB556"
msgid ""
"⟪k:0⟫⟪k:1⟫Do you remember the day we went out together?⟪k:2⟫⟪k:3⟫That was, perhaps, the most "
"wonderful day of my life.⟪k:4⟫⟪k:5⟫I had a truly incredible time.⟪k:6⟫"
msgstr ""
"⟪k:0⟫⟪k:1⟫Você se lembra do dia em que saímos juntos? ⟪k:2⟫Esse foi, talvez, o dia mais "
"maravilhoso da minha vida. ⟪k:3⟫Eu me diverti muito.⟪k:4⟫"

#: scenario3:scenario3_F3789E13_79DE_4518_A353_0ECBAA53CEF0
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 202f1b1b8e4e1482e579396295d43ce94b2d74215d444b477ae4160343de8a3a
#. default-sha256: 4e3f03747cd3a32ee5441a38e68e85d38245b90cdcfc59b5f95b3fa5510627da
msgctxt "scenario3:scenario3_F3789E13_79DE_4518_A353_0ECBAA53CEF0"
msgid ""
"⟪k:0⟫⟪k:1⟫I still treasure the gift you gave to me,⟪k:2⟫⟪k:3⟫for it is the one and only present I "
"have received from you...⟪k:4⟫"
msgstr ""
"⟪k:0⟫⟪k:1⟫Ainda valorizo ​​o presente que você me deu, ⟪k:2⟫pois é o único presente que recebi de "
"você...⟪k:3⟫"

#: scenario3:scenario3_078A285C_DB66_4D08_A856_7F85CABAF5BF
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 8f2660333cbaf709b8db4539331a6208718a7a2a9bc7eb47c4939fea9ade4fe6
#. default-sha256: 947e06780035267f9d4344a61ca9baab9963295a85bb4c0f83104d0454628936
msgctxt "scenario3:scenario3_078A285C_DB66_4D08_A856_7F85CABAF5BF"
msgid ""
"⟪k:0⟫⟪k:1⟫That reminds me, Maria tried to teach me how to dance.⟪k:2⟫⟪k:3⟫I doubt I will ever "
"progress beyond being laughably bad, though...⟪k:4⟫"
msgstr ""
"⟪k:0⟫⟪k:1⟫Isso me lembra, Maria tentou me ensinar a dançar. ⟪k:2⟫Embora, duvido que eu vá "
"progredir além de ser risivelmente ruim...⟪k:3⟫"

#: scenario3:scenario3_E062BEDC_9AE6_477E_9EAB_2F776BA9919A
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: c3215fab3f5934b38425164ba85b54019bb4c310eba611534ad59e943ec51b57
#. default-sha256: eac0a7ecf3ce267e4cb2e1f1e10d87f7f59fe273a18c131fe6b9981431604b31
msgctxt "scenario3:scenario3_E062BEDC_9AE6_477E_9EAB_2F776BA9919A"
msgid "⟪k:0⟫⟪k:1⟫It would be nice if, someday, you and I could dance together.⟪k:2⟫"
msgstr "⟪k:0⟫⟪k:1⟫Seria bom se, um dia, você e eu pudéssemos dançar juntos.⟪k:2⟫"

#: scenario3:scenario3_26F96882_6E8B_4C97_88BF_D48D97982A92
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 654a02e0b901461bc0be583f73a2a22f8caa9d537e5b8e593dcf69e58aa40109
#. default-sha256: e77713213c59471d0b73a866179a6da49c0306269e2e23c99f1629b35f6c0c91
msgctxt "scenario3:scenario3_26F96882_6E8B_4C97_88BF_D48D97982A92"
msgid ""
"⟪k:0⟫⟪k:1⟫Perhaps, when you have a little respite from work, we could go out again, maybe take a "
"carriage somewhere a little farther away.⟪k:2⟫"
msgstr ""
"⟪k:0⟫⟪k:1⟫Quem sabe, quando tiver um pouco de folga do trabalho, possamos sair de novo, talvez "
"pegar uma carruagem para algum lugar um pouco mais distante.⟪k:2⟫"

#: scenario3:scenario3_F7D5F193_D18B_482C_9412_88BCDF5A0C93
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 7210bfb256b43bf0f385ec608be2282582843ce2534256860ed21ef4b6c387af
#. default-sha256: 00c29b385eddb8c5f78d6cf133830ebf24db356b4d3a5672a55f1e6c56ac612e
msgctxt "scenario3:scenario3_F7D5F193_D18B_482C_9412_88BCDF5A0C93"
msgid "⟪k:0⟫⟪k:1⟫And we could dine at a restaurant more to your liking.⟪k:2⟫"
msgstr "⟪k:0⟫⟪k:1⟫E poderíamos jantar em um restaurante mais ao seu gosto.⟪k:2⟫"

#: scenario3:scenario3_470CC718_B9D6_41CC_B704_B9206DFD8ED6
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: e14cc9b22eaac61ce1d748cc7d86f5adb78339db5c640539c2a960de4ee768de
#. default-sha256: 4a9456e2cf2fc40b4a52fea14992f324cd35288242c9a80522ff87bd5cda226a
msgctxt "scenario3:scenario3_470CC718_B9D6_41CC_B704_B9206DFD8ED6"
msgid ""
"⟪k:0⟫⟪k:1⟫Although, I think the cuisine at the other restaurant was exquisite, personally.⟪k:2⟫"
msgstr "⟪k:0⟫⟪k:1⟫Embora, pessoalmente ache que a cozinha no outro restaurante era requintada.⟪k:2⟫"

#: scenario3:scenario3_C35D0B18_64E9_408C_8AD3_1673B334D207
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 5e1dac489fa9e3739569d4c0addc3581b11ed89c33f0c4c5039d058b5d7bee1c
#. default-sha256: ba84d84dab62ab34c8c66a44e31aa0c8163be6e234e264155975a27a53afd156
msgctxt "scenario3:scenario3_C35D0B18_64E9_408C_8AD3_1673B334D207"
msgid "⟪k:0⟫⟪k:1⟫Do I, perhaps, have an unrefined palate?⟪k:2⟫"
msgstr "⟪k:0⟫⟪k:1⟫Eu, talvez, não tenho um paladar refinado?⟪k:2⟫"

#: scenario3:scenario3_F55CE928_ED20_4637_8482_B36D44AB0A51
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 069b0b576eecd386ad7dc9c44919f302bee668d5b7e48bff9d4c5634ac3c40c6
#. default-sha256: da19af9b96bb581a66cb802aa1400905548914b515a48200ddbd1121525d9962
msgctxt "scenario3:scenario3_F55CE928_ED20_4637_8482_B36D44AB0A51"
msgid ""
"⟪k:0⟫Maria altered the letters before delivering them, however.⟪k:1⟫⟪k:2⟫She changed the "
"addressee from Jacopo to another man."
msgstr ""
"⟪k:0⟫No entanto, Maria alterou as cartas antes de entregá-las.⟪k:1⟫⟪k:2⟫Ela mudou o destinatário "
"de Jacopo para outro homem."

#: scenario3:scenario3_6A9592E1_29C1_4FB4_885C_5B810929B83F
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 605841cd7379c98e297dbc52b0a011017f2d7b44406ec50c9949cacba94c809f
#. default-sha256: f6a945cee6f1da8894e2b96f67cc6d115ce29bdb95c106c19bc38fc541bffbd6
msgctxt "scenario3:scenario3_6A9592E1_29C1_4FB4_885C_5B810929B83F"
msgid ""
"⟪k:0⟫She would cut away the top of the page with Jacopo’s name on it, and in the space below "
"write a different name."
msgstr ""
"⟪k:0⟫Ela cortava o topo da página com o nome de Jacopo e no espaço abaixo escrevia um nome "
"diferente."

#: scenario3:scenario3_AFBC8CD9_BD05_4D83_868A_BE1F230C0838
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: bcc54215feccc75330013e306ad7963f9dd519338334927e9db347051e475eea
#. default-sha256: 1ced13aae9302da3b59f08a074949168df5e026e469219aadf26deb291931719
msgctxt "scenario3:scenario3_AFBC8CD9_BD05_4D83_868A_BE1F230C0838"
msgid ""
"⟪k:0⟫She could not have mimicked the White-Haired Girl’s handwriting for the full length of a "
"letter, but Maria could make a single name look adequately similar."
msgstr ""
"⟪k:0⟫Ela não conseguiria ter imitado a caligrafia da Garota de Cabelos Brancos por toda a "
"extensão de uma carta, mas Maria conseguia fazer um único nome parecer adequadamente semelhante."

#: scenario3:scenario3_101EB0A4_AF89_43CD_B7F7_037D32EFC20E
