msgid "⟪k:0⟫Jacopo accepted every letter Maria delivered, without fail."
msgstr "⟪k:0⟫Jacopo aceitava todas as cartas que Maria entregava, sem falta."

#: scenario3:scenario3_7828B9FF_F8E6_4F8F_A06F_0E3CB4F58FF5
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: d580f8ac30baf74121fefc5f24bd9a4618a75f9f8fc20bf7668c29c4b5391493
