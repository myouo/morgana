msgid "⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫⟪k:4⟫⟪k:5⟫⟪k:6⟫⟪k:7⟫............"
msgstr "⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫⟪k:4⟫⟪k:5⟫⟪k:6⟫⟪k:7⟫..........."

#: scenario3:scenario3_A4D825DA_EBE9_49C2_91AB_B085D9CB8EA5
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 131f4fe0321be4e2834d97d48dff5da714b2340bbb8592c61acd858a612cc32d
#. default-sha256: db229a00630253c33356299b1c56a5fa9217ac7f182804716f1fa78173b7772b
msgctxt "scenario3:scenario3_A4D825DA_EBE9_49C2_91AB_B085D9CB8EA5"
msgid ""
"⟪k:0⟫Looking down dejectedly at the undrunken tea, the White-Haired Girl walked alone down the "
"corridor."
msgstr ""
"⟪k:0⟫Olhando desanimada para o chá não bebido, a Garota de Cabelos Brancos caminhou sozinha pelo "
"corredor."

#: scenario3:scenario3_F7BCD182_8814_4357_9D96_A99E95E4FC85
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 28d46bbecc31539cf09854217b479e837ba989ba2c3ca5fd9267f8d784442d9d
#. default-sha256: ba94a49a45b8414d35d451dccc0d34cdeadd1c2d07ad4d023f255bfa8d737f3a
msgctxt "scenario3:scenario3_F7BCD182_8814_4357_9D96_A99E95E4FC85"
msgid ""
"⟪k:0⟫Though its calming scent filled the air, there was nobody around to have their heart warmed "
"by it."
msgstr ""
"⟪k:0⟫Embora seu aroma calmante enchesse o ar, não havia ninguém por perto para ter seu coração "
"aquecido por ele."

#: scenario3:scenario3_8B9C3D09_7F27_4EB1_A73D_A37B088B6E26
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 366738bef5143958588b56ce0786a45f15c3053c167054377eb012c7975a81e6
#. default-sha256: 32930f293d60ebe46ac3f0a099f8cfa2ba992225d3ded9d0722f08b55b13cd58
msgctxt "scenario3:scenario3_8B9C3D09_7F27_4EB1_A73D_A37B088B6E26"
msgid "⟪k:0⟫Nor was there anyone to alleviate her loneliness."
msgstr "⟪k:0⟫Nem havia alguém para aliviar sua solidão."

#: scenario3:scenario3_773BF3F5_3E27_413D_B02F_76AAC10204C2
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 88fb6255d013ac0ddabd81033c08df2389a8703e16ec71f4ae005d815413382b
#. default-sha256: 56f36292c7592c31448ec5abb6420f297082f53fd23f951c5d0a597c9700bab0
msgctxt "scenario3:scenario3_773BF3F5_3E27_413D_B02F_76AAC10204C2"
msgid ""
"⟪k:0⟫Despite being the master’s wife, the maids who crossed her path in the halls said nary a "
"word to her."
msgstr ""
"⟪k:0⟫Apesar de ser a esposa do mestre, as criadas que cruzaram seu caminho nos corredores não lhe "
"disseram uma palavra."

#: scenario3:scenario3_B9F11270_C774_4CE1_82C9_98BFE4C943F9
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 72d815cc0f26e2cb1c1fae08662cd72a3c361c572c2daa8090ef169733072d36
#. default-sha256: 2464f7cbeab8a398b3f4ceb830d6503bc8081ae8bdd392e871e057b4ec22f04e
msgctxt "scenario3:scenario3_B9F11270_C774_4CE1_82C9_98BFE4C943F9"
msgid "⟪k:0⟫............"
msgstr "⟪k:0⟫..........."

#: scenario3:scenario3_D1CC945B_1426_486D_A007_7D0E685D60C7
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 70de19e7bf5727f301ab1800e64db8fc6929ae730a3f69a0d1d3aae7990032e3
#. default-sha256: e605772831b9864fea3ca8369a38f2007665e65d229d487aea6557fd68527c6d
msgctxt "scenario3:scenario3_D1CC945B_1426_486D_A007_7D0E685D60C7"
msgid "⟪k:0⟫As a matter of fact—"
msgstr "⟪k:0⟫Na verdade—"

#: scenario3:scenario3_2648BE34_8454_4A6E_A4B9_1544D81DC629
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 8141c365a355afb4b2e67272cd231057f9d1bafda459049d7624cdf1f302ac0a
#. default-sha256: f4136ab13cde43942f4e3b4e470503895bb585d99b0f46a0e4897941e4a12f88
msgctxt "scenario3:scenario3_2648BE34_8454_4A6E_A4B9_1544D81DC629"
msgid "⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫...!"
msgstr "⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫...!"

#: scenario3:scenario3_3FDDECF2_46DB_4622_9B83_A8AD0DCF0D84
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: fafbd57f60034fadc237e4f62918116a44a03d6818b229594d20cb018e29db5c
#. default-sha256: e50984ce9221672e6bb1bfeee823ea2d65c1f9a12f626e2002581d4a0c46ba72
msgctxt "scenario3:scenario3_3FDDECF2_46DB_4622_9B83_A8AD0DCF0D84"
msgid "⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫⟪k:4⟫⟪k:5⟫⟪k:6⟫⟪k:7⟫Oh dear.⟪k:8⟫I beg your pardon, Madam."
msgstr "⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫⟪k:4⟫⟪k:5⟫⟪k:6⟫⟪k:7⟫Oh céus.⟪k:8⟫Peço desculpas, Madame."

#: scenario3:scenario3_B4165425_8A41_45A9_87B1_4540C8B167C8
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: d8c577f83e9168a9978e6300ec8ace48df2951c53b7abc357665a34e39c146bc
#. default-sha256: 555fac86e2284b009f784db63774947cf2f8b6815fb771c0ca98f667208e6f00
msgctxt "scenario3:scenario3_B4165425_8A41_45A9_87B1_4540C8B167C8"
msgid "⟪k:0⟫Ah... ⟪k:1⟫it’s fine..."
msgstr "⟪k:0⟫Ah...⟪k:1⟫tudo bem...⟪k:2⟫"

#: scenario3:scenario3_9747367B_ECC6_47EA_B0E3_2CB573183AC4
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 7fd5fcfee7ec326b86bd7a18c6dea974dfbede55b24c70025a62566d6267585a
#. default-sha256: 0695c82df8d817e43d53656b45c007f44b1a5a7943537ba575d4b2902dfb5aa0
msgctxt "scenario3:scenario3_9747367B_ECC6_47EA_B0E3_2CB573183AC4"
msgid "⟪k:0⟫—one even bumped into her, stifling a laugh as she trotted off."
msgstr "⟪k:0⟫—uma até esbarrou nela, abafando uma risada enquanto seguia seu trote.⟪k:1⟫"

#: scenario3:scenario3_CD736832_7BEC_4174_A5C4_33B2132F2C71
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 04c64d877d4d866fd5134a0c700710ffb4103db816639e8a9a19d83f6cb79ec9
#. default-sha256: f39d0849199375974832e7bfb0011c0680c85c9f8c6ff0eedd0c04d6ab9d7b82
msgctxt "scenario3:scenario3_CD736832_7BEC_4174_A5C4_33B2132F2C71"
msgid ""
"⟪k:0⟫In all likelihood, she had done it intentionally. ⟪k:1⟫The poor White-Haired Girl, who had "
"fallen to the floor, stared helplessly at the broken cups."
msgstr ""
"⟪k:0⟫Muito provavelmente, ela tinha feito isso intencionalmente. ⟪k:1⟫ A pobre Garota de Cabelos "
"Brancos, que havia caído no chão, olhou impotente para as xícaras quebradas."

#: scenario3:scenario3_755AD335_1E15_49D6_A108_2117706A1AC7
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 9d51eb0419f76c13c98c908e0aee4b421ee8381ac0a509ba9db643c6676e716a
#. default-sha256: fb83349ca07f7bc00d56e52767bf60d961cbe1d81e0e919a06caa27b851b6523
msgctxt "scenario3:scenario3_755AD335_1E15_49D6_A108_2117706A1AC7"
msgid "⟪k:0⟫The tea she had made for her husband was forming a stain in the carpet."
msgstr "⟪k:0⟫O chá que ela havia feito para o marido estava formando uma mancha no tapete."

#: scenario3:scenario3_D9217328_537E_44AE_A7D1_F2142D1419F2
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: cf3f55c5fc810f87d5e852d9cde854fc6659b90d710b277371c8d83ae73dcec4
#. default-sha256: 27c383f38040bb44731f377c235cdaebab46236ef9cccc440f6c036db47ccc26
msgctxt "scenario3:scenario3_D9217328_537E_44AE_A7D1_F2142D1419F2"
msgid "⟪k:0⟫The maids’ behavior toward the mistress of the house was absolutely unacceptable."
msgstr "⟪k:0⟫O comportamento das criadas em relação à dona da casa era absolutamente inaceitável."

#: scenario3:scenario3_FCE0642B_DBE2_4935_A25D_FAE1492D1023
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: bda9a87a7b19ae854b1af279443105e4580177d05836486ba5c5fdde785c37bf
#. default-sha256: f72ee41d113171c9b75f158cb5aba0aa5c9d8d5d132119281901ed49730e8a9e
msgctxt "scenario3:scenario3_FCE0642B_DBE2_4935_A25D_FAE1492D1023"
msgid ""
"⟪k:0⟫Nonetheless, it was commonplace—⟪k:1⟫⟪k:2⟫⟪k:3⟫all because of the way Jacopo treated her."
msgstr ""
"⟪k:0⟫No entanto, já era algo comum—⟪k:1⟫⟪k:2⟫⟪k:3⟫tudo por causa da forma como Jacopo a tratava."

#: scenario3:scenario3_D68D42FA_CF32_457E_9CB5_30FBC93EEFC8
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: ec4bf9846050fcb20fc6214b1fb72a47a36298e24fa55b1903ab12577e9a1c45
#. default-sha256: 6870d1d44ee512d4e86f0e471cbb604fe5ec77b021b9883eaaab006d5bc1c40b
msgctxt "scenario3:scenario3_D68D42FA_CF32_457E_9CB5_30FBC93EEFC8"
msgid ""
"⟪k:0⟫The more the man of the house acted cruel to her,⟪k:1⟫the less weight her position as his "
"wife held to the servants."
msgstr ""
"⟪k:0⟫Quanto mais o homem da casa agia cruelmente com ela,⟪k:1⟫menos peso sua posição como esposa "
"tinha para os servos."

#: scenario3:scenario3_1855FFDE_01E4_46FF_B383_E9128B81C961
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 7c86dcd97dce28b2e1c9fa5d1c21e9ece965143fe6165ae6d96de435e2740a1f
#. default-sha256: c439afcdcbc58e9b16014fd6208c08a6691446503ec8d0be3cbe228d69a5de65
msgctxt "scenario3:scenario3_1855FFDE_01E4_46FF_B383_E9128B81C961"
msgid ""
"⟪k:0⟫Day in and day out, the maids worked busily—⟪k:1⟫⟪k:2⟫offered little opportunity for leisure—"
"⟪k:3⟫⟪k:4⟫so they would naturally have accumulated quite a bit of stress."
msgstr ""
"⟪k:0⟫Dia após dia, as criadas trabalhavam, atarefadas—⟪k:1⟫⟪k:2⟫o que oferecia poucas "
"oportunidades de lazer—⟪k:3⟫⟪k:4⟫então elas naturalmente acumulavam um bocado de estresse."

#: scenario3:scenario3_93CD596B_710F_4B6D_A9BE_C45CAFB41920
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: dffa5e163990a66ee7efb05e3c9eec4f948ac3ecdda4d7ecb79350600aec3d69
#. default-sha256: 7ea889d25dfcb598a25ffe6f2dd1b8b8b5548d1578491fd6b07045064fa5253e
msgctxt "scenario3:scenario3_93CD596B_710F_4B6D_A9BE_C45CAFB41920"
msgid "⟪k:0⟫And she became the target for them to let off this steam."
msgstr "⟪k:0⟫E ela se tornou o alvo para elas desopilarem."

#: scenario3:scenario3_A6A74DB4_B6EB_4691_8E51_D0B71446E496
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: b09d55482ef883b3bf1a9cb275b7486b675bd62bfd1ebdb0879b119d07e92cff
#. default-sha256: 6a49e20c12a997665261b290353162ebe09655c7c7d0bfc5d811f63d1a00519f
msgctxt "scenario3:scenario3_A6A74DB4_B6EB_4691_8E51_D0B71446E496"
msgid "⟪k:0⟫Not directly, but through a more subdued kind of harassment from the shadows."
msgstr "⟪k:0⟫Não diretamente, mas através de um tipo mais prudente de assédio, das sombras."

#: scenario3:scenario3_C90492EF_7D04_424F_9879_017BF694F1CA
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 5c723839f921c990e37362007719a6bdd54a5a02ae948908b7832a25944e2624
#. default-sha256: a6caa24d7af4488a2ca26ffee014beadf95a0489fda1e443c84712bb40f2c698
msgctxt "scenario3:scenario3_C90492EF_7D04_424F_9879_017BF694F1CA"
msgid ""
"⟪k:0⟫She must have felt quite miserable. ⟪k:1⟫I imagine she would have been better off as one of "
"the maids."
msgstr ""
"⟪k:0⟫Ela deve ter se sentido muito infeliz. ⟪k:1⟫Imagino que estaria melhor como uma das criadas."

#: scenario3:scenario3_FB205E25_E6F8_4865_B3E7_3319368D8FCC
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: cc2e4a7231bdc549bcd5738510a5ee203068cd5e46c6397f88eb319032222c70
#. default-sha256: 7d8d99d4b88bef5fda2efcd6fb8d5bcb8777a1aa50e20510616c0096372f77f4
msgctxt "scenario3:scenario3_FB205E25_E6F8_4865_B3E7_3319368D8FCC"
msgid ""
"⟪k:0⟫On the surface, and in front of others, they showed respect for her as Jacopo’s bride. But "
"behind closed doors, they acted very much the opposite."
msgstr ""
"⟪k:0⟫Superficialmente, e na frente dos outros, elas mostravam respeito por ela como noiva de "
"Jacopo. Mas atrás de portas fechadas, elas agiam exatamente ao contrário."

#: scenario3:scenario3_E95184CC_AC3F_4BCB_A653_912ADADA02DF
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: f3860f1a24bb6bbaaf43b00d044f3d3c2817a5f217d45a62cfe8f593025872f1
#. default-sha256: b3861a50dd83f5e37086a76d1a790e47f4c282374da49888e61c34a3118c4432
msgctxt "scenario3:scenario3_E95184CC_AC3F_4BCB_A653_912ADADA02DF"
msgid ""
"⟪k:0⟫The disparity between the treatment she received around others—⟪k:1⟫⟪k:2⟫the treatment she "
"was ⟪k:3⟫supposed⟪k:4⟫ to receive at all times—⟪k:5⟫⟪k:6⟫and the way she was actually treated "
"made the abuse that much worse."
msgstr ""
"⟪k:0⟫A disparidade entre o tratamento que ela recebia em torno dos outros—⟪k:1⟫⟪k:2⟫o tratamento "
"que ela ⟪k:3⟫deveria⟪k:4⟫ receber em todos os momentos—⟪k:5⟫⟪k:6⟫e a maneira como ela realmente "
"era tratada fazia com que o abuso fosse muito pior."

#: scenario3:scenario3_267EE02A_941F_4448_8B47_CA74E017EE6D
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 430bf8eeda4c4c60897afa997135176ba79e9fe67c16ffc77042e676ed8d33aa
#. default-sha256: d222c095f26ac28e4c58463ee5a968ad9b79e42b72401c26e620983f55f7e63a
msgctxt "scenario3:scenario3_267EE02A_941F_4448_8B47_CA74E017EE6D"
msgid ""
"⟪k:0⟫And furthermore, as you have seen through the other doors, Master, she was a very reserved "
"young woman."
msgstr ""
"⟪k:0⟫E além disso, como você viu pelas outras portas, Mestre, ela era uma jovem muito reservada."

#: scenario3:scenario3_9BDAD077_9CE6_4C39_8E22_6ABFFEE3ECF1
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 88bc97b2ec7fa56cf2bd21db3a99571e4efc62bff94cfc6022ffeaab4319923a
#. default-sha256: 88ea393f7ee75c50359ee2fb688e87b4045a5f2b395b6606bad7b724245692a1
msgctxt "scenario3:scenario3_9BDAD077_9CE6_4C39_8E22_6ABFFEE3ECF1"
msgid "⟪k:0⟫She could neither raise her voice in reprimand nor raise her hand in retaliation."
msgstr ""
"⟪k:0⟫Ela tanto não conseguia levantar a voz em repreensão como levantar a mão em retaliação."

#: scenario3:scenario3_2D2FF13F_3EAF_4424_8601_4E4DA6F69371
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 80fd20494435da7914139998a61cd3ce51bd8d7e6518ae7a71116555c0b18634
#. default-sha256: cccecc0c3214a753ca05cd727691ce902ff9fe668b48ec52c504d77311b19650
msgctxt "scenario3:scenario3_2D2FF13F_3EAF_4424_8601_4E4DA6F69371"
msgid "⟪k:0⟫I have to get this cleaned up..."
msgstr "⟪k:0⟫Tenho que limpar isto..."

#: scenario3:scenario3_01A7312C_4E02_430F_B6A7_45F2AA7F94C5
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 2ec483281c7cb29979c56f5348dd7a56e79d45ba2fbe28dd0b9a262a167335fc
#. default-sha256: ae63d91f8a5f39fef8b473f6a3bd80c2fd5ee14cbff90a70b51020fd313642f7
msgctxt "scenario3:scenario3_01A7312C_4E02_430F_B6A7_45F2AA7F94C5"
msgid "⟪k:0⟫She extended her spindly fingers toward the shards of shattered porcelain."
msgstr "⟪k:0⟫Ela estendeu seus dedos finos em direção aos cacos de porcelana quebrada."

#: scenario3:scenario3_6C35B0D2_1AEF_4680_A1A4_3B4661C2E547
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: a268e6038c42c56ef54929c49ec5796cd0df369e70f379e80ceb8da825dc3f05
#. default-sha256: d98b5abbbb0b7d2affda7e8c07b85d3833f3a891790f0897e837ba4c87740319
msgctxt "scenario3:scenario3_6C35B0D2_1AEF_4680_A1A4_3B4661C2E547"
msgid "⟪k:0⟫Ah..."
msgstr "⟪k:0⟫Ah..."

#: scenario3:scenario3_A2E96FCC_0E75_4993_989B_921AAAECD7EF
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 1ac470d30bd3f8ba3d1ed18bb3a1d5dd437b25907c28ff979f2dd4bdff4fd139
#. default-sha256: f683138bfbda5e2cf09cb6ce91caca45722ebae3a5a40a3745e71051a74a9a8e
msgctxt "scenario3:scenario3_A2E96FCC_0E75_4993_989B_921AAAECD7EF"
msgid ""
"⟪k:0⟫But even the broken cup seemed to have no concern to spare for her. Its shattered edge cut "
"her fingertip when she made to pick it up."
msgstr ""
"⟪k:0⟫Mas mesmo a xícara parecia não ter nenhuma consideração por ela. A borda quebrada cortou a "
"ponta de seu dedo quando ela tentou pegá-la."

