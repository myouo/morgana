msgctxt "scenario3:scenario3_B32415B3_4781_4156_8438_980EBF5EEB06"
msgid ""
"⟪k:0⟫Nonsense!⟪k:1⟫⟪k:2⟫She was ⟪k:3⟫waiting⟪k:4⟫ for me!⟪k:5⟫Until the day of the joining "
"ceremony!"
msgstr ""
"⟪k:0⟫Bobagem!⟪k:1⟫⟪k:2⟫Ela estava ⟪k:3⟫esperando⟪k:4⟫ por mim!⟪k:5⟫Até o dia da cerimônia de "
"adesão!"

#: scenario3:scenario3_74FEB0BA_DF3D_4B4B_9CF3_6D6C99B316E0
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 6c1836aa8e9d10470e7ad8abb4f74d0212dc5d7f920ba60845a4e5638dda9d38
