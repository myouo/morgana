msgid ""
"⟪k:0⟫⟪k:1⟫N-⟪k:2⟫No. I have had a portrait painted, though...⟪k:3⟫⟪k:4⟫Are these machines for "
"taking photographs?"
msgstr ""
"⟪k:0⟫⟪k:1⟫N-⟪k:2⟫Não. Eu já mandei pintar um retrato, no entanto...⟪k:3⟫⟪k:4⟫Essas máquinas são "
"para tirar fotos?"

#: scenario3:scenario3_44144CC4_05DC_4B1B_8225_6C5DEFDC4A79
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 008e32e6b1317e13458cb23043140af22a9d3846489dfeb14fc37d6e5b8e83df
#. default-sha256: df8fb7b1aea5ea5987075922f35a8d6850b190e001b71469355119b23455fec8
msgctxt "scenario3:scenario3_44144CC4_05DC_4B1B_8225_6C5DEFDC4A79"
msgid "⟪k:0⟫⟪k:1⟫A portrait, eh?⟪k:2⟫⟪k:3⟫Why am I not surprised?"
msgstr "⟪k:0⟫⟪k:1⟫Um retrato, hein?⟪k:2⟫⟪k:3⟫Por que não estou surpreso?"

#: scenario3:scenario3_455B22F7_27BC_4453_872D_2409482E44F4
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: a2abd2a587c54cafbb854e1f4e00cdf481e01fa285aed7033f3bf73fb5929ec3
#. default-sha256: 5a10b7ad2a29e1af828e2db2840efd602680368e573ca03323488719bda3b199
msgctxt "scenario3:scenario3_455B22F7_27BC_4453_872D_2409482E44F4"
msgid "⟪k:0⟫⟪k:1⟫I did not mean to boast..."
msgstr "⟪k:0⟫⟪k:1⟫Eu não quis me gabar..."

#: scenario3:scenario3_9718090B_69CA_43F3_BFF4_871834DC3D48
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 89c97d2d99ff12f851ca40f67361d9fae3b2b7f8d66856c5d7f82edec5d8e5e3
