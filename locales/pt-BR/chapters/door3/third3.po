msgstr "⟪k:0⟫Ele reclamou de cada coisinha.⟪k:1⟫Foi um desastre completo."

#: scenario3:scenario3_A254ECAD_7658_450A_92BC_2199D6436909
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: a63f0270d93c7566f39192240c10132e24af5669bef7d9fb8cdfcfc767e848e3
#. default-sha256: 6776d2ce56360504098b75a6ca7ce994d9bcf8728f119f458934207b2c543ac6
msgctxt "scenario3:scenario3_A254ECAD_7658_450A_92BC_2199D6436909"
msgid "⟪k:0⟫But curiously enough, I was not at all put off by his behavior."
msgstr "⟪k:0⟫Mas, curiosamente, não fiquei nada desanimada com seu comportamento."

#: scenario3:scenario3_37341C46_68D0_414F_BD92_A328C2B42AEB
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: b13ed3fab6d6cdee20dc5bbd24128dbd66563c2318248d6387df3630255fbe30
