msgid "⟪k:0⟫We had only just married days earlier..."
msgstr "⟪k:0⟫Tínhamos acabado de nos casar dias antes..."

#: scenario3:scenario3_AC30B3DE_B94F_4D8D_8073_E6BBF6BCDEC7
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 8c84d32b08766fa31788d1e525b49cab8f72044cdc0758b784bfedc38fb681e5
