msgctxt "scenario3:scenario3_0B1A017E_BF75_47D5_9F39_564F09E39F3A"
msgid ""
"⟪k:0⟫“How can you wave my country’s flag and not serve spaghetti?!⟪k:1⟫Do you have any shame at "
"all?!”"
msgstr ""
"⟪k:0⟫“Como você pode agitar a bandeira do meu país e não servir espaguete?!⟪k:1⟫Você não tem "
"vergonha?!”"

#: scenario3:scenario3_8F1C7A66_6E7B_4A53_A69B_27AE66AFAE91
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: d5d8b8ea08031ddf202c819777c8079f7c47a8e671ab77aab24830d9a002f6ed
