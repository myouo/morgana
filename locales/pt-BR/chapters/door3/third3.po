msgctxt "scenario3:scenario3_9718090B_69CA_43F3_BFF4_871834DC3D48"
msgid "⟪k:0⟫⟪k:1⟫Go on. Get in."
msgstr "⟪k:0⟫⟪k:1⟫Vamos. Entre."

