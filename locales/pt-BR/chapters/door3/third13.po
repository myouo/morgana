msgid "⟪k:0⟫Ah..."
msgstr "⟪k:0⟫Ah..."

#: scenario3:scenario3_CDA793AA_8C43_4FEC_9F5D_017005C93182
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 678854c39f35d86592ab12f3bbbb6bfe1290c843b7e83fd653791f2701cd7948
#. default-sha256: 7f1a87b73033282528187da683be59d8f837e3b44a16cc250537745edff24590
msgctxt "scenario3:scenario3_CDA793AA_8C43_4FEC_9F5D_017005C93182"
msgid ""
"⟪k:0⟫There’s... ⟪k:1⟫no reason you have to leave town.⟪k:2⟫⟪k:3⟫My old man says the Campanellas "
"have more power."
msgstr ""
"⟪k:0⟫Não tem...⟪k:1⟫por que você deixar a cidade.⟪k:2⟫⟪k:3⟫Meu velho disse que os Campanellas têm "
"mais poder."

#: scenario3:scenario3_16A96EA9_EC19_443A_9899_DD960278A6BB
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 75dde4d909b9dd6e97b1ac4f4e51a0cf11628f755f074e209af071ca72bf0b95
#. default-sha256: 3712d76b3138b37a530e40eb2618672a212c00e2cd8762816ef9416e3e292976
msgctxt "scenario3:scenario3_16A96EA9_EC19_443A_9899_DD960278A6BB"
msgid "⟪k:0⟫I should be the one leaving."
msgstr "⟪k:0⟫Deveria ser eu indo embora."

#: scenario3:scenario3_4A434A8E_FC21_45BB_B783_9126F1B071DF
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 6058a7251b8fec3649305d34c1f3bb2e7d0acbd50f584523285a07e371911af1
#. default-sha256: 27c0bad88423470dae40db62c3b0a0e57206350f932f7bac8a6913ed2cbf9953
msgctxt "scenario3:scenario3_4A434A8E_FC21_45BB_B783_9126F1B071DF"
msgid ""
"⟪k:0⟫It’s not that simple.⟪k:1⟫Grownups have a lot to consider.⟪k:2⟫⟪k:3⟫So don’t give me that "
"look, Jacopo."
msgstr ""
"⟪k:0⟫Não é tão simples assim. Os adultos têm muito a considerar.⟪k:1⟫ Então não me dê esse olhar, "
"Jacopo."

#: scenario3:scenario3_ED963991_E6FC_4B9D_8FD8_2632C7573FA6
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: eb6ca7e97341bb7f2c4bf95fedd23c58618283e3198e3c3e2a1479234ab666a9
