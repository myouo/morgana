msgid ""
"⟪k:0⟫⟪k:1⟫Sh-⟪k:2⟫Shut your mouth!⟪k:3⟫How do you know about that?!⟪k:4⟫Were you eavesdropping?!"
msgstr ""
"⟪k:0⟫⟪k:1⟫Ca-⟪k:2⟫Cala a sua boca!⟪k:3⟫Como você sabe disso?!⟪k:4⟫Você estava bisbilhotando?!"

#: scenario3:scenario3_9B5C8132_C8C1_409C_B893_DB04146A9987
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 90945b100540c3d235a8c9ecfb4a573ee5df5fa6d2d17274f6d35005dcdd0aea
#. default-sha256: fb30a6248337281e4bd69864b1c79f05169cb312a919cce4299b38eaeb9fd0b4
msgctxt "scenario3:scenario3_9B5C8132_C8C1_409C_B893_DB04146A9987"
msgid ""
"⟪k:0⟫And another thing, I do ⟪k:1⟫not⟪k:2⟫ care for the sort of stupid, fantastical tales you "
"women so love to pass around!"
msgstr ""
"⟪k:0⟫E outra coisa, eu ⟪k:1⟫não⟪k:2⟫ me importo com o tipo de contos estúpidos e fantásticos que "
"vocês mulheres adoram contar!"

#: scenario3:scenario3_70EA927F_8F4B_4247_AE42_F36AB2F4B422
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: d726f3f7fe0c7d290ff153792797e735cce16e55c7bc4a18f455a1e6d5db7dd7
