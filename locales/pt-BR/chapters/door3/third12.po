#: scenario3:scenario3_69824517_24CF_4B8E_B072_5694C0E5E948
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 1a1a4359f7e9a32d968f62c7932d06fa2a1793290acf0ea61e9b889b2aecb6c4
#. default-sha256: ebef68699d8765a0e8fe7de2a927ed7d06a1d57450de9cac12270966cdf4c33c
msgctxt "scenario3:scenario3_69824517_24CF_4B8E_B072_5694C0E5E948"
msgid ""
"⟪k:0⟫⟪k:1⟫So a couple days back, I didn’t get enough sleep the previous night, right? ⟪k:2⟫I’m "
"helping out in the kitchen, half-awake, plating up some food,"
msgstr ""
"⟪k:0⟫⟪k:1⟫Então, alguns dias atrás, eu não dormi o suficiente na noite anterior, certo? ⟪k:2⟫ "
"Estou ajudando na cozinha, meio acordada, botando comida em um prato, "

#: scenario3:scenario3_9E019DB4_7BCC_4D2A_862D_33920693D3EF
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: d2aee0e17eb908190666b3213e7b41ac69f70ac0c7c30ee75e18c3b151214015
#. default-sha256: 1c918a34b36fe324a1644cef3b0263c6ead888dcab496685ab970d38ddbc8faf
msgctxt "scenario3:scenario3_9E019DB4_7BCC_4D2A_862D_33920693D3EF"
msgid ""
"⟪k:0⟫and when I go to bring it out to the guest, my heart about leaps out of my mouth. Guess why."
msgstr ""
"⟪k:0⟫e quando vou trazê-la para o convidado, meu coração salta da minha boca. Adivinha por quê."

#: scenario3:scenario3_46EBE330_AB6F_4F2A_9199_BB4397AA1818
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 44123a105b37b3daec188e346cce98f3abea08f2f3805e963050e8ee8ffde944
