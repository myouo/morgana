msgctxt "scenario3:scenario3_5430C9E4_D756_4A69_A643_FE060E198187"
msgid "⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫⟪k:4⟫⟪k:5⟫⟪k:6⟫You look down on me!⟪k:7⟫You’re nobility!"
msgstr "⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫⟪k:4⟫⟪k:5⟫⟪k:6⟫Você me despreza!⟪k:7⟫Você é nobreza!"

#: scenario3:scenario3_87A868E5_3CC3_4115_AE67_41BE3A053F59
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 9ce3b464bb442e33e7b538e037886f19992d1da90b21e95c64f20e5b963abdd3
#. default-sha256: 96e4ddbd6e06f8981384c839012df0e06fff7a56f0999a661fd49e6199aa73a3
