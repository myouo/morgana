msgid "⟪k:0⟫S-⟪k:1⟫Stop— ⟪k:2⟫⟪k:3⟫Jacopo!"
msgstr "⟪k:0⟫P-⟪k:1⟫Pare— ⟪k:2⟫⟪k:3⟫Jacopo!"

#: scenario3:scenario3_5430C9E4_D756_4A69_A643_FE060E198187
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: aa48ca29a048b1c2573724f9426df1cc361dcc4bc0a416535db4e741e0669180
