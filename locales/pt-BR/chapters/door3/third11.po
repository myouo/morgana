msgid "⟪k:0⟫However, no one said a word to him."
msgstr "⟪k:0⟫No entanto, ninguém lhe disse uma palavra."

#: scenario3:scenario3_621886FE_B154_42C2_95E1_319ABE98F6A9
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 53e536ba9b12d0456ee6a5c895fcf4631e2fed227edd71ca316f7ab45a5f3bc3
