msgctxt "scenario3:scenario3_621886FE_B154_42C2_95E1_319ABE98F6A9"
msgid "⟪k:0⟫Had I not been preoccupied attending to his countryman..."
msgstr "⟪k:0⟫Se eu não estivesse preocupada em atender seu conterrâneo..."

#: scenario3:scenario3_7E2E929C_3397_45DA_9D13_F550D9D64B36
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 86c87645adc42dd2145a8e93d1fb9db5d73fe488dcd34a78c329ee28c9e262e1
