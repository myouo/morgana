msgid "⟪k:0⟫⟪k:1⟫............"
msgstr "⟪k:0⟫⟪k:1⟫............"

#: scenario3:scenario3_1546908A_4815_49FB_8144_C6A5F7BDE298
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 1a86f59deed04cd91fd3707bf4195dddf9cef1e28bbc1762fb5a7a538a01cf85
#. default-sha256: 5ef4d05dd58e62bd3deef047bef9ca8b816fe6c5f7113d2c9ae7e4b4041d9fe0
msgctxt "scenario3:scenario3_1546908A_4815_49FB_8144_C6A5F7BDE298"
msgid ""
"⟪k:0⟫⟪k:1⟫Jacopo doesn’t trust you in the ⟪k:2⟫slightest⟪k:3⟫.⟪k:4⟫⟪k:5⟫He goes around calling "
"you a witch.⟪k:6⟫⟪k:7⟫A man-eating devil-woman."
msgstr ""
"⟪k:0⟫⟪k:1⟫Jacopo não confia em você ⟪k:2⟫nem um pouco⟪k:3⟫. ⟪k:4⟫⟪k:5⟫Ele anda por aí chamando "
"você de bruxa.⟪k:6⟫⟪k:7⟫Uma demônio devoradora de homens."

#: scenario3:scenario3_3B0F9553_40AB_4C08_9C9A_29FEF480ED2C
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 1efdd8e13d496ec50547b06f4280d82aab3468fe3b68f1b3fb069d47c2712fdf
#. default-sha256: 391b0bfd15d215d413166c1e1edc2f2ef9ada88a3fb5d41f356340320919f5fe
msgctxt "scenario3:scenario3_3B0F9553_40AB_4C08_9C9A_29FEF480ED2C"
msgid "⟪k:0⟫⟪k:1⟫It’s awful.⟪k:2⟫⟪k:3⟫There’s no one as pure and as beautiful as you."
msgstr "⟪k:0⟫⟪k:1⟫É horrível.⟪k:2⟫⟪k:3⟫Não há ninguém tão pura e tão bonita quanto você."

#: scenario3:scenario3_31FA80D5_12A8_4254_B2D4_55D8CD3D7FC9
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: be69b4ce8900cf4abcd162c6160225a851c6009b054b33d2452cd6de89d88ddc
#. default-sha256: dd00224011522af2f8e0b7466df86a5ab25b2c1705c3438883659643b1847e30
msgctxt "scenario3:scenario3_31FA80D5_12A8_4254_B2D4_55D8CD3D7FC9"
msgid "⟪k:0⟫⟪k:1⟫He says... ⟪k:2⟫I am a witch?"
msgstr "⟪k:0⟫⟪k:1⟫Ele fala... ⟪k:2⟫que sou uma bruxa?"

#: scenario3:scenario3_2938A9B9_A728_4CA9_8E74_A87E86F07571
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 3279dad1f9432b4bd2dd1a8d89f79cfa712777b11ddd9c7344ea49d0fb55c990
#. default-sha256: 760e7e0f5d0511438c0a990dba9c5556b1ee44febc6360ced9e715a23202bf4e
msgctxt "scenario3:scenario3_2938A9B9_A728_4CA9_8E74_A87E86F07571"
msgid "⟪k:0⟫⟪k:1⟫Listen to me, Madam.⟪k:2⟫⟪k:3⟫He never for a second ⟪k:4⟫actually⟪k:5⟫ loved you."
msgstr "⟪k:0⟫⟪k:1⟫Ouça-me, Madame. ⟪k:2⟫Ele nunca, ⟪k:3⟫nem⟪k:4⟫ por um segundo, te amou."

#: scenario3:scenario3_7E310359_F5BE_44B4_AE3C_7F377E807B21
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 1ebd99538e5e444c14cbc6af38d86d1e3c489d910983c5f0783f69a288aaf44d
#. default-sha256: 69eb7254318e2a423ddf395b7aeb3b35d837afb751162561b9b2ff235bf306cf
msgctxt "scenario3:scenario3_7E310359_F5BE_44B4_AE3C_7F377E807B21"
msgid ""
"⟪k:0⟫He just wanted the influence attached to your name.⟪k:1⟫⟪k:2⟫Wanted to mingle with the upper "
"class."
msgstr ""
"⟪k:0⟫Ele só queria a influência ligada ao seu nome. ⟪k:1⟫Queria se misturar com a classe alta."

#: scenario3:scenario3_5997B74F_8DC7_4A29_B3D7_CE1F29A03E03
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 0a4542f8bcfd1e097ee7daadb0d08dfd37a4d416519e761c7169be37f2463644
#. default-sha256: cb07075a725bfdf2d71af8b82aad3a211d13468463eeee0bdad8157fefb1ffd1
msgctxt "scenario3:scenario3_5997B74F_8DC7_4A29_B3D7_CE1F29A03E03"
msgid "⟪k:0⟫He ⟪k:1⟫used⟪k:2⟫ you."
msgstr "⟪k:0⟫Ele ⟪k:1⟫usou⟪k:2⟫ você."

#: scenario3:scenario3_4FE46BE7_958C_4C8C_B141_10A50D9C9847
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 14a460fbf24e8dd5c9dc7ebb255e75560f92718f0d22522f6cf4ef0601381b23
#. default-sha256: 172dacb5cb3a0957b796fc60bdd69e87b851a727fc4574dcf0cfb90f9ad4c0ca
msgctxt "scenario3:scenario3_4FE46BE7_958C_4C8C_B141_10A50D9C9847"
msgid "⟪k:0⟫⟪k:1⟫But last year... ⟪k:2⟫when we went out together..."
msgstr "⟪k:0⟫⟪k:1⟫Mas ano passado... ⟪k:2⟫quando saímos juntos..."

#: scenario3:scenario3_3AFE7A7E_D651_4FF5_B9AC_78B8BC3B1DFC
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 69e8194a70dd1e993e870ec5b1bb952bcd9e5d06572f3c8d4a7897c6c451c4ef
#. default-sha256: de2234cc7bcdf61fc24338f6096126008c183a4675eb2271e62c624d79de1145
msgctxt "scenario3:scenario3_3AFE7A7E_D651_4FF5_B9AC_78B8BC3B1DFC"
msgid ""
"⟪k:0⟫he gave me the phenakis wheel at the photography shop...⟪k:1⟫⟪k:2⟫He had the owner make it "
"especially for me..."
msgstr ""
"⟪k:0⟫ele me deu a roda fenaquis na loja de fotografia... ⟪k:1⟫Ele pediu para o dono fazer isso "
"especialmente para mim..."

#: scenario3:scenario3_38DAE9F6_272E_43C2_84E4_E9191BEE9111
