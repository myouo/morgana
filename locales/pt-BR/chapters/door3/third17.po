msgstr "⟪k:0⟫⟪k:1⟫................................."

#: scenario3:scenario3_C7CD7239_02F4_40D9_9FA5_DCA92B72EDF5
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 21bf1212a03ae9c6eed3be5c8dce4a7d40304d21ba8464cbb5b078b0c9dbb73a
#. default-sha256: 0bb5bd9a41b21751690c2eb8fee22e78a341ba957a4d0906f71a37cdfe97ef45
msgctxt "scenario3:scenario3_C7CD7239_02F4_40D9_9FA5_DCA92B72EDF5"
msgid "⟪k:0⟫⟪k:1⟫No... ⟪k:2⟫No..."
msgstr "⟪k:0⟫⟪k:1⟫Não... ⟪k:2⟫Não..."

#: scenario3:scenario3_A174DBE2_8F2C_464A_9A01_1E9AEBCE5D74
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 3a4627a83f63cd47821fa1c3ec1ad2c27ac8fb1de0b6ae60d716d678aef1f227
#. default-sha256: 97251bbbb1fbf983e5bb585686576d7d9352e38ed0d8433e3d87033d07c02b2c
msgctxt "scenario3:scenario3_A174DBE2_8F2C_464A_9A01_1E9AEBCE5D74"
msgid ""
"⟪k:0⟫I will get through to him...⟪k:1⟫⟪k:2⟫Everything will go back to normal...⟪k:3⟫⟪k:4⟫I have "
"faith."
msgstr "⟪k:0⟫Eu vou chegar até ele...⟪k:1⟫ Tudo vai voltar ao normal...⟪k:2⟫ Eu tenho fé."

#: scenario3:scenario3_434D9104_934D_4D9E_876C_33E647912E0F
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 1861776db1ac79a15f98c41ccf1e93b98975d6c1c35e98752509c95d653807ea
#. default-sha256: 742991f36203b272620d1522d7645aa9342bf319937ddeaec2a1f49f526c23a0
msgctxt "scenario3:scenario3_434D9104_934D_4D9E_876C_33E647912E0F"
msgid "⟪k:0⟫All my letters may go up in flames...⟪k:1⟫⟪k:2⟫but my faith will not be lost with them."
msgstr ""
"⟪k:0⟫Todas as minhas cartas podem pegar fogo...⟪k:1⟫⟪k:2⟫mas minha fé não se perderá com elas."

#: scenario3:scenario3_B91FF130_107B_4C5D_91A5_56B2E0FC1501
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: d5f5272577f3bd495159d30b1e8426854a824721d712f0097094f8db9856e06a
#. default-sha256: cf8102240652f396a6bda56557ca04a1eec67b484c0b201f11212e059db3b1a0
msgctxt "scenario3:scenario3_B91FF130_107B_4C5D_91A5_56B2E0FC1501"
msgid "⟪k:0⟫As long as I keep writing..."
msgstr "⟪k:0⟫Contanto que eu continue escrevendo..."

#: scenario3:scenario3_FF9E4CFF_D915_4518_9A03_681D65EB23E6
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 0e94644476526d0b8881ba7ea28265b64349b45c3555d278758755190d3c0dfa
#. default-sha256: fe2c3ac6721ea637c9678d79d78585cd334c01995c73cb47a721126e7b7bc4e2
msgctxt "scenario3:scenario3_FF9E4CFF_D915_4518_9A03_681D65EB23E6"
msgid ""
"⟪k:0⟫eventually... ⟪k:1⟫I will get through to him.⟪k:2⟫⟪k:3⟫So I cannot stop... ⟪k:4⟫I cannot."
msgstr ""
"⟪k:0⟫eventualmente...⟪k:1⟫Eu vou chegar até ele. ⟪k:2⟫Então eu não posso parar... ⟪k:3⟫Eu não "
"posso."

#: scenario3:scenario3_FC66C310_D0EC_4D7A_B6E2_D7C0006192FD
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 973783e86c014f054172c8b63c90b0ed6d399c18bd37727fd6cf914046078649
#. default-sha256: ab3f52447fa5c65e79969cfaf70913bf6d111bcf3002d27392f0309f923e7087
msgctxt "scenario3:scenario3_FC66C310_D0EC_4D7A_B6E2_D7C0006192FD"
msgid "⟪k:0⟫⟪k:1⟫Do you have any idea what he says about you, Madam?"
msgstr "⟪k:0⟫⟪k:1⟫Você tem alguma ideia do que ele diz sobre você, Madame?"

#: scenario3:scenario3_F01194CA_4BA1_4927_8D9B_8AFBA294025E
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 0f9cc6cb8da0b3eff754ff312b9bca7d703d9de3e8508aa3b902c96c75123088
