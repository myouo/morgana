msgctxt "search:search_3A7FA097_8099_4B4C_90DB_0DE1D276157B"
msgid "⟪k:0⟫⟪k:1⟫I can hear you..."
msgstr "⟪k:0⟫⟪k:1⟫Eu posso te ouvir..."

#: search:search_53E12C05_26DB_47D1_9EB4_35E31462CE24
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 0cc313629bd243514b5d2d293203aecf28cae366ea232160b33a56853ec1bebb
#. default-sha256: 0b9c63a927a49694384e436f73247870421e09366c0c83fc9c587142b231ee4e
msgctxt "search:search_53E12C05_26DB_47D1_9EB4_35E31462CE24"
msgid "⟪k:0⟫⟪k:1⟫Splendid."
msgstr "⟪k:0⟫⟪k:1⟫Esplêndido."

#: search:search_AA1E2BF7_D662_4D19_BFD8_D0B8B08D191A
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: c092002ed4fdf7d38b10bdf999244e1743bdcc7e56c7b1adb21b8c55dbe42a55
#. default-sha256: 9553d9e31e5d4084354315bd2270e774dc22f51933dae90701d3cd9d65b6e9ce
msgctxt "search:search_AA1E2BF7_D662_4D19_BFD8_D0B8B08D191A"
msgid ""
"⟪k:0⟫Been so long since I’ve had a conversation,⟪k:1⟫I was afraid I might’ve forgotten how to "
"talk.⟪k:2⟫⟪k:3⟫So tell me, who might you be?"
msgstr ""
"⟪k:0⟫Faz tanto tempo desde que eu tive uma conversa,⟪k:1⟫Eu estava com medo de ter esquecido como "
"falar.⟪k:2⟫⟪k:3⟫Então me diga, quem seria você?"

#: search:search_E1EF2AD4_F041_48C4_AB86_840D600A6EB6
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 7e56476212e89b751b81542f6face8f3ea25211d03e9b68ca7b12db0449a8b53
#. default-sha256: c6bc30069993d823ebe3a5b21e50f4f33cbaa40a0ef1fcaf76c05bf10e5937fb
msgctxt "search:search_E1EF2AD4_F041_48C4_AB86_840D600A6EB6"
msgid "⟪k:0⟫⟪k:1⟫I don’t know...⟪k:2⟫⟪k:3⟫I don’t know anything..."
msgstr "⟪k:0⟫⟪k:1⟫Eu não sei...⟪k:2⟫⟪k:3⟫Eu não sei de nada..."

#: search:search_4D53616D_8E16_476F_8EAA_1318DB2A3890
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 076610afdec40bd83836ef45649c32f212843a564955d6370024c17a0c61cdb1
#. default-sha256: 8eb4f7d4d0312b22d006563e0c9c4ab03df66bb38dceda0f58a1cf9024266436
msgctxt "search:search_4D53616D_8E16_476F_8EAA_1318DB2A3890"
msgid "⟪k:0⟫⟪k:1⟫You don’t know?⟪k:2⟫⟪k:3⟫Well, isn’t that quite the pickle."
msgstr "⟪k:0⟫⟪k:1⟫Você não sabe?⟪k:2⟫⟪k:3⟫Bem, que situação chata."

#: search:search_8833BD8D_AEEA_4661_B533_6DE38CFDC60E
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 5e7d19d09ee874ce28210d2d7817726ab8bac81e3c81e2fd0a709acca71aaa80
#. default-sha256: 13ecc40a881233233da29f5bd192936cdde23a689390b21a3e8c8e3cbd0b6c30
msgctxt "search:search_8833BD8D_AEEA_4661_B533_6DE38CFDC60E"
msgid ""
"⟪k:0⟫Then how ’bout we have a little chat, eh?⟪k:1⟫⟪k:2⟫You got yourself turned around and aren’t "
"sure where to go, yeah?"
msgstr ""
"⟪k:0⟫Então que tal batermos um papo, hein?⟪k:1⟫⟪k:2⟫Você se perdeu e não tem certeza para onde "
"ir, certo?"

#: search:search_55D06A8D_6D62_4964_B686_5578F59611EC
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: a3b6942bcb6d42fe5937a709b94e55501c0483a3df58fee8b7a1030bd932dc98
