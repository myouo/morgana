msgctxt "scenario5:scenario5_E22FD1CE_DC1F_4F16_898F_96EFD80B6207"
msgid "⟪k:0⟫I shall bring calamity upon you, as the witch of legend!"
msgstr "⟪k:0⟫Trarei calamidade sobre vocês, como a bruxa da lenda!"

#: scenario5:scenario5_B5DDA295_5464_46AA_A330_C83F64301F84
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 4bfa7cd5f68d9700606edb0519038733fab0d8aa25919dad4f4f0eb0b7ec2242
#. default-sha256: 23618511ce6a40edd1350ed0623e2d37968fc4444194c085f1aeef4ffac253e7
msgctxt "scenario5:scenario5_B5DDA295_5464_46AA_A330_C83F64301F84"
msgid "⟪k:0⟫Neverending famine! Plague! Catastrophe! Suffering for generations!"
msgstr "⟪k:0⟫Fome sem fim! Praga! Catástrofe! Sofrimento por gerações!"

#: scenario5:scenario5_96E5ACB7_9EED_4B68_A0C2_A45F993F1E2D
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: fc54f9a79a7953e5a7ff2617e52a3cccf25642e4ad173b8ceb16fc79fe04830c
#. default-sha256: 3ae27cb8c23e4954087ce7b53a69a101e8f45a9d6b9963bae71c134f9e6ddd44
msgctxt "scenario5:scenario5_96E5ACB7_9EED_4B68_A0C2_A45F993F1E2D"
