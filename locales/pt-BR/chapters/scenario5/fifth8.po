msgid "⟪k:0⟫Ah... ⟪k:1⟫aaah..."
msgstr "⟪k:0⟫Ah... ⟪k:1⟫aaah..."

#: scenario5:scenario5_E22FD1CE_DC1F_4F16_898F_96EFD80B6207
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 81a659283c589b789789283612a158ffd370e5f3cb759936b2c455ed88bf6656
