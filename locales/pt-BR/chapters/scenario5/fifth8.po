msgctxt "scenario5:scenario5_231177F8_A960_411F_BAD4_D4A6BF6A7379"
msgid "⟪k:0⟫he had bone-chillingly alabaster skin and long, nearly translucently pale hair."
msgstr ""
"⟪k:0⟫ele tinha uma pele de alabastro de arrepiar os ossos e pálidos cabelos longos, quase "
"translúcidos."

#: scenario5:scenario5_2D3C3470_7C9F_4431_B67D_D05BDB14A582
