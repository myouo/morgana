#: scenario5:scenario5_0CB33A79_4C6F_4949_B116_CA3F9D4681BF
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 3b509b0841db5f30141cd0f6252ef47e120a44ef1d079c072e722eec511ddfb0
#. default-sha256: 12d902df67b949930f0840074a184c03f931dd278468fe06b22b57d7b6f8cfe3
msgctxt "scenario5:scenario5_0CB33A79_4C6F_4949_B116_CA3F9D4681BF"
msgid "⟪k:0⟫A witch, a demon, a spirit impure!⟪k:1⟫⟪k:2⟫Call me whatever you wish!"
msgstr "⟪k:0⟫Uma bruxa, um demônio, um espírito impuro!⟪k:1⟫⟪k:2⟫Me chamem do que quiser!"

#: scenario5:scenario5_711B9A6F_4494_4E8B_ACFC_EC7EEB85D949
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 583c48da5e2fd9ce30be8c897f27e1ab437f57fc331fd08c215da1ba6b806858
#. default-sha256: 541ef6ee4dfd3c4f16acf9ebb71dff69722abc2a4368910c22a154ff9591b423
msgctxt "scenario5:scenario5_711B9A6F_4494_4E8B_ACFC_EC7EEB85D949"
msgid "⟪k:0⟫For the truth shall not change!⟪k:1⟫⟪k:2⟫I carry within me an eternal curse!"
msgstr "⟪k:0⟫Pois a verdade não mudará!⟪k:1⟫⟪k:2⟫Trago dentro de mim uma maldição eterna!"

#: scenario5:scenario5_711B9A6F_4494_4E8B_ACFC_EC7EEB95D949
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 996c0a15b62018ff4e98da565de39103b2f2ebee592d21958eabc04a404e79be
#. default-sha256: d3f279690a2149e6432edf41f82de88403c898aa3dcda3d24a0ef0a12914fce4
msgctxt "scenario5:scenario5_711B9A6F_4494_4E8B_ACFC_EC7EEB95D949"
msgid ""
"⟪k:0⟫Behold my flesh, pale as the moon!⟪k:1⟫⟪k:2⟫No red blood flows beneath this skin, as it does "
"yours!"
msgstr ""
"⟪k:0⟫Vejam minha carne, pálida como a lua!⟪k:1⟫⟪k:2⟫Nenhum sangue vermelho flui sob esta pele, "
"como flui nas suas!"

#: scenario5:scenario5_711B9A6F_4494_4E8B_ACFC_EC7EEB85D959
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: f05fe7c5de741d413c44a3418ede2d780ada8d0121651d401838d7fb99ea18d4
#. default-sha256: 32988812151e9c5181a2b1fbd468126dae6f3d25a39fb8fd992c7d5170393af3
msgctxt "scenario5:scenario5_711B9A6F_4494_4E8B_ACFC_EC7EEB85D959"
msgid ""
"⟪k:0⟫Behold my hair, utterly devoid of color,⟪k:1⟫⟪k:2⟫offered up to the Devil as part of our "
"pact!"
msgstr ""
"⟪k:0⟫Vejam meu cabelo, totalmente desprovido de cor,⟪k:1⟫⟪k:2⟫oferecido ao diabo como parte do "
"nosso pacto!"

#: scenario5:scenario5_711B9A6F_4494_4E8B_ACFC_EC7EEB85D999
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: b01790d914e835ebb2511224a56242e600de7ce88a7b23534636c78a033f3e6d
#. default-sha256: 22a7011c4c1e315c57bd59c5539028ff4b30241c466a9689091de53b358074c0
msgctxt "scenario5:scenario5_711B9A6F_4494_4E8B_ACFC_EC7EEB85D999"
msgid "⟪k:0⟫Behold these crimson eyes!⟪k:1⟫⟪k:2⟫A symbol of the lifeblood spilt at my hands!"
msgstr ""
"⟪k:0⟫Vejam esses olhos carmesins!⟪k:1⟫⟪k:2⟫Um símbolo do sangue vital derramado em minhas mãos!"

#: scenario5:scenario5_711B9A6F_4494_4E8B_ACFC_EC7EEB85D849
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: cdcf0ec5360f45714a988c9d14a52565a0fb67b7afb0f26cf26db3e0d4e992ad
