#: scenario5:scenario5_A1A925CB_1079_4097_9984_F74FFA5128D7
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 019d7905c918a59ae629deb855c24408ef9ec354af266363adb1239b2f667c05
#. default-sha256: 8505b35928a3e9f2010aafeaf760481587e387d214316e8d11c681c1fd93f670
msgctxt "scenario5:scenario5_A1A925CB_1079_4097_9984_F74FFA5128D7"
msgid ""
"⟪k:0⟫For far longer than was comfortable, the only sound we heard was the gentle crackling of the "
"fire."
msgstr ""
"⟪k:0⟫Por muito mais tempo do que era confortável, o único som que ouvimos foi o crepitar suave do "
"fogo."

#: scenario5:scenario5_2FC207D4_5BB8_4F13_8ED3_B5CC837D3D60
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: df407fd382f5b3cc79ea096e8946f3241d0a8d57eea0e98c04dd71d0b96117d0
#. default-sha256: acb3ba91d1882113ca2990981cef06a5767e73ece0f9875f8948c36dddd5a42b
msgctxt "scenario5:scenario5_2FC207D4_5BB8_4F13_8ED3_B5CC837D3D60"
msgid "⟪k:0⟫I had to say something.⟪k:1⟫⟪k:2⟫I knew that, but what I didn’t know was how to begin."
msgstr ""
"⟪k:0⟫Eu tinha que dizer algo.⟪k:1⟫⟪k:2⟫Sabia disso, mas o que eu não sabia era como começar."

#: scenario5:scenario5_7636C76B_F264_44A8_B5FB_DAF40CA9AC9B
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 8d3b190c4a7f6c9d40b05aab62654470a726252e2be820f28ffcf7a8e2d2f60a
#. default-sha256: e8764aee2bdd57883c8413d14fdbd0d6a1ce03e3bdc2538e71765ae836db7a13
msgctxt "scenario5:scenario5_7636C76B_F264_44A8_B5FB_DAF40CA9AC9B"
msgid ""
"⟪k:0⟫I knew nothing about having an honest, face-to-face discussion with someone about the things "
"we were thinking and feeling."
msgstr ""
"⟪k:0⟫Eu não sabia nada sobre como ter uma discussão cara a cara e honesta com alguém sobre as "
"coisas que estávamos pensando e sentindo."

#: scenario5:scenario5_4CA04C0A_498A_4B14_8295_73157439C193
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 916400ec3ff58505f2c5499f92385dd4c31e292e607009630bc1f5bb1faa171c
