msgid "⟪k:0⟫⟪k:1⟫Will you still believe me, even then?"
msgstr "⟪k:0⟫⟪k:1⟫Você vai acreditar em mim ainda, mesmo assim?"

#: scenario5:scenario5_AA91C65B_A98A_4CE6_834C_9A601C41430B
