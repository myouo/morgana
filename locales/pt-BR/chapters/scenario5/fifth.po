msgid "⟪k:0⟫⟪k:1⟫I wonder... ⟪k:2⟫if the windows open."
msgstr "⟪k:0⟫⟪k:1⟫Eu me pergunto... ⟪k:2⟫se as janelas abrem."

#: scenario5:scenario5_AA15CF14_500D_4B38_AF57_947AC84E078C
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: b2d91720ded2e45fdddaf483e500484f73c70150e51af7532fa2b706e5ec57c2
