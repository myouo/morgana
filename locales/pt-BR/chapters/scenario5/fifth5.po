#. native-sha256: 2580bdec0552dce0234962207953f32d1bcd31eca1afc0bb50d07998dc59de64
#. default-sha256: a3b8382595ca1be1b90f432fe0a0d03363ebab2338d577351cde33ef0e10a1c4
msgctxt "scenario5:scenario5_0645E338_30D8_4F9C_B63C_904B2053A2DE"
msgid "⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫⟪k:4⟫⟪k:5⟫⟪k:6⟫⟪k:7⟫⟪k:8⟫⟪k:9⟫⟪k:10⟫⟪k:11⟫⟪k:12⟫............"
msgstr "⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫⟪k:4⟫⟪k:5⟫⟪k:6⟫⟪k:7⟫⟪k:8⟫⟪k:9⟫⟪k:10⟫⟪k:11⟫⟪k:12⟫............"

#: scenario5:scenario5_8CE805DC_7849_4D48_9836_CA4AD21D857E
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: a04fedd8d135ac4c428777e691723d72c371867c3618b772b05c23f1325cacd2
#. default-sha256: eeea1029ccf7fe3b91d0d5d479a609360563a61f8404be53b78896ae8d7b90fb
msgctxt "scenario5:scenario5_8CE805DC_7849_4D48_9836_CA4AD21D857E"
msgid "⟪k:0⟫How did we get to this point?"
msgstr "⟪k:0⟫Como chegamos a este ponto?"

#: scenario5:scenario5_1A87FAFA_5514_404A_B48E_D4BE7EF7560E
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: e8bc5cef82859ca32a1682c410aac48d1403a5a1644058607575e900f1e01933
#. default-sha256: 3f0494785578895ec09de3b79fb46062e71b5746f94c8699ac4162449dd7ea71
msgctxt "scenario5:scenario5_1A87FAFA_5514_404A_B48E_D4BE7EF7560E"
msgid "⟪k:0⟫Ugh... ⟪k:1⟫I hate everything."
msgstr "⟪k:0⟫Ugh... ⟪k:1⟫Eu odeio tudo."

#: scenario5:scenario5_95EC823A_55AB_4389_BA08_FBADAA9590FC
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 9c9ac48670454febf746528677471d521edd1071a302b4801aa5947bf8e7da8e
#. default-sha256: d4020acf4985ae81f3d8282b2500b9367e5e807c4d7db463f88ec8e976db8171
msgctxt "scenario5:scenario5_95EC823A_55AB_4389_BA08_FBADAA9590FC"
msgid ""
"⟪k:0⟫My spirits were getting darker and darker, like they were slowly sinking into a deep morass."
msgstr ""
"⟪k:0⟫Meu ânimo estava ficando cada vez mais sombrio, como se estivesse afundando lentamente em um "
"pântano profundo."

#: scenario5:scenario5_22EA8AC8_5551_48D4_A5DD_E8DB040D0DFF
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 62dd9c3a97d0d4b65e54ff7dfbeb1bdf42212fd7dcde9e0c40a093662fa4ccd6
#. default-sha256: ab8e54d799daa22531f9bcb74f6ff99b5ac61b1da7cab71b435452f0f7d3450b
msgctxt "scenario5:scenario5_22EA8AC8_5551_48D4_A5DD_E8DB040D0DFF"
msgid ""
"⟪k:0⟫I had been at the mansion for a month, ⟪k:1⟫and every day since felt twice as long as it "
"should have."
msgstr ""
"⟪k:0⟫Eu estava na mansão há um mês, ⟪k:1⟫e todos os dias desde então pareciam duas vezes mais "
"longos do que deveriam."

#: scenario5:scenario5_FC326764_576F_4F38_86F5_E5E79EFD1249
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: ecc9a278c0c8c2c157ff986003c822c510336a4cf14776cfc16504f7bbd28dd8
#. default-sha256: 8b6b1f2f8a54fe2711fb701d7c3053bb57eb1519a9d7e94261a212b7ca2c49da
msgctxt "scenario5:scenario5_FC326764_576F_4F38_86F5_E5E79EFD1249"
msgid ""
"⟪k:0⟫I had been optimistic, at first. ⟪k:1⟫I’d even had a little hope that me and Michel could "
"get along together."
msgstr ""
"⟪k:0⟫Eu tinha sido otimista, no início. ⟪k:1⟫Eu até tive um pouco de esperança de que eu e Michel "
"pudéssemos nos dar bem juntos."

#: scenario5:scenario5_BA4AB3D0_212C_41CB_B5F1_EA9EF2F48D8B
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 3663a3710102596088844f98e35c7172d27ac2e802ffd53edd4c68a75008e3ad
#. default-sha256: 4b2ee29c0795d97d8ef30ce087549d22ef086f23fcfa475ceb858975e489dfb8
msgctxt "scenario5:scenario5_BA4AB3D0_212C_41CB_B5F1_EA9EF2F48D8B"
msgid "⟪k:0⟫But it hadn’t taken long for that hope to be shattered,"
msgstr "⟪k:0⟫Mas não demorou muito para que essa esperança fosse destruída,"

#: scenario5:scenario5_827444A5_465E_4627_8BFD_97B4B87F05B7
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: b681de3a0f777055873c4a96ac12d6ddfd440106e6ef8c6c816f404db3384d32
#. default-sha256: 6eb44b569231b861eb134d17cc04c5a9191a458ea70b57ae1990fa17f798d07e
msgctxt "scenario5:scenario5_827444A5_465E_4627_8BFD_97B4B87F05B7"
msgid "⟪k:0⟫and the cheer locked away inside me."
msgstr "⟪k:0⟫e a alegria trancada dentro de mim."

#: scenario5:scenario5_28C38AE5_B643_4CA7_A431_756C7211C6EC
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 8c30a355fdf5a7e935bb7abfea046a19a3e2915c8b7f16bf6d019a3db7a4a1b2
#. default-sha256: 2a53ab648d9a30f0c54f4135642d1ba1e0bdfbd15a9652b241a28ca5b44338d9
msgctxt "scenario5:scenario5_28C38AE5_B643_4CA7_A431_756C7211C6EC"
msgid ""
"⟪k:0⟫We lived in the same house, but we never spoke anymore. ⟪k:1⟫On the few occasions we ⟪k:2⟫"
"did⟪k:3⟫ cross paths, he just gave me a cold glare and nothing more,"
msgstr ""
"⟪k:0⟫Morávamos na mesma casa, mas nunca mais nos falamos. ⟪k:1⟫Nas poucas ocasiões em que ⟪k:2⟫"
"acontecia⟪k:3⟫ de cruzarmos caminho, ele apenas me dava um olhar frio e nada mais,"

#: scenario5:scenario5_07D67BD5_A2F4_4BEF_BBD9_8012DD0C3767
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 8b522d55cf37d3696e5186b37c0dfa54a0762b4e2757c51963dc30bc5d435dde
#. default-sha256: b7e2b2d947534c6eefcd288713b414c2c0dbf905e2b2b007c0ca6f7fc0965025
msgctxt "scenario5:scenario5_07D67BD5_A2F4_4BEF_BBD9_8012DD0C3767"
msgid "⟪k:0⟫scorn and suspicion in his eyes."
msgstr "⟪k:0⟫desprezo e suspeita em seus olhos."

#: scenario5:scenario5_1559DCC3_8872_4427_8892_A34A50D8C50B
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 54a61bd0782f69bdaf73d07ca3efbc38577b2ade9e40954de3096b2568cb75ef
#. default-sha256: e755fac469609c56e95b072f5399d397837e05939add2d64c179c14291b0571d
msgctxt "scenario5:scenario5_1559DCC3_8872_4427_8892_A34A50D8C50B"
msgid ""
"⟪k:0⟫Whenever he looked at me like that, it felt as though my throat was being constricted—⟪k:1⟫"
"⟪k:2⟫like I was deep underwater and running out of air."
msgstr ""
"⟪k:0⟫Sempre que ele me olhava assim, parecia como se minha garganta estivesse sendo comprimida—"
"⟪k:1⟫⟪k:2⟫como se eu estivesse debaixo d'água e ficando sem ar."

#: scenario5:scenario5_E6007ABB_91CF_4C96_87B0_412762DF4126
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 98cb47a456f9e81540ca0ea6f7ed3b9660ec436387cb3d62a6c2c57a39c626a4
#. default-sha256: ad85abe93fe68da92002aaa1130e49810636d4fcdb1d231e9cc4fc91c01c2e28
msgctxt "scenario5:scenario5_E6007ABB_91CF_4C96_87B0_412762DF4126"
msgid "⟪k:0⟫Like my very presence in the world was a crime."
msgstr "⟪k:0⟫Como se minha mera presença no mundo fosse um crime."

#: scenario5:scenario5_2A0AFE93_234A_47B1_9DBC_48F9557EB2C2
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 60b81a4c8348261c3e1dccecc1b6c046619e5c9697b2578cda6c56d2f39d1bab
#. default-sha256: d38e3c6fe85f908c77c05b2a03c80d5913c4d5daad40f0a44e30733f23caafd1
msgctxt "scenario5:scenario5_2A0AFE93_234A_47B1_9DBC_48F9557EB2C2"
msgid "⟪k:0⟫I never could have imagined just how agonizing constant rejection was."
msgstr "⟪k:0⟫Eu nunca poderia ter imaginado o quão agonizante era ser rejeitada constantemente."

#: scenario5:scenario5_D1864E8B_89E6_4958_A090_C0464B88FE85
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 6cb7864a70ff1e10a87768845c3f91de534a6a018720ab71157c428475af797e
#. default-sha256: 01f13aac30e23883491dafafde1c00689e18753ebb2e3200bae8ee321c82cbfb
msgctxt "scenario5:scenario5_D1864E8B_89E6_4958_A090_C0464B88FE85"
msgid ""
"⟪k:0⟫I started despising others. ⟪k:1⟫Despising myself. ⟪k:2⟫Despising the world. ⟪k:3⟫Convinced "
"there was no one who could set me free."
msgstr ""
"⟪k:0⟫Comecei a desprezar os outros. ⟪k:1⟫Desprezar a mim mesma. ⟪k:2⟫Desprezar o mundo. ⟪k:3⟫"
"Convencida de que não havia ninguém que pudesse me libertar."

#: scenario5:scenario5_3FC4E713_D47A_4E6F_B4EE_CA683F2C019D
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 6ece3882f7d6a90e041839bc85e8784944b09aff2586e7b4e6ec08a3188afc9e
#. default-sha256: fa2fab8853185240f27828e4d82d164c98b18a5447e79d5218518abe0078699a
msgctxt "scenario5:scenario5_3FC4E713_D47A_4E6F_B4EE_CA683F2C019D"
msgid ""
"⟪k:0⟫I considered running away from everything,⟪k:1⟫rather than live like this another day,⟪k:2⟫"
"⟪k:3⟫but I would have done so long ago⟪k:4⟫if that were actually an option."
msgstr ""
"⟪k:0⟫Pensei em fugir de tudo,⟪k:1⟫ao invés de viver assim outro dia,⟪k:2⟫⟪k:3⟫mas eu teria feito "
"a muito tempo atrás⟪k:4⟫se isso fosse realmente uma opção."

#: scenario5:scenario5_757A2A5F_174D_4D90_9C29_5CE2ECED7F98
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 927df13c11c62c391281138fa6af52b48b6ad438619a0bf909e1906a550e9c7d
#. default-sha256: 21c2fc43fbf4d6bf66e0bc4f27e83ae96bcaa8c5722ee4b6f6550b2cf93d78e7
msgctxt "scenario5:scenario5_757A2A5F_174D_4D90_9C29_5CE2ECED7F98"
msgid ""
"⟪k:0⟫If they found out I had fled—⟪k:1⟫⟪k:2⟫⟪k:3⟫that I had acted outside their wishes—⟪k:4⟫⟪k:5⟫"
"⟪k:6⟫my mom and sister would pay."
msgstr ""
"⟪k:0⟫Se eles descobrissem que eu tinha fugido—⟪k:1⟫⟪k:2⟫⟪k:3⟫que eu agi fora de sua vontade—⟪k:4⟫"
"⟪k:5⟫⟪k:6⟫minha mãe e irmã pagariam."

#: scenario5:scenario5_F68CEDDD_2CAB_499C_9ACA_72AD323B655D
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 2cc51460a4de3d6059d99423dd50bc45017faf8961cf29734e0ee8a9144ee7c1
#. default-sha256: b3b40e3d241d45865cda5ecc99b7c20d990fc5adcadd93fcae0f252516ee42f0
msgctxt "scenario5:scenario5_F68CEDDD_2CAB_499C_9ACA_72AD323B655D"
msgid "⟪k:0⟫I had succeeded in allowing my sister to get married and my mom to live comfortably."
msgstr ""
"⟪k:0⟫Eu tinha conseguido possibilitar que minha irmã se casasse e minha mãe vivesse "
"confortavelmente."

#: scenario5:scenario5_E25A3CED_7774_415D_AEA6_094D84FB6A19
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 150f40e1a1f7170792fcfc3367d61764a3dbfe22dc8966a0dafb0af767522ba9
#. default-sha256: 97197b7483e4888aa0323a26079af0cf28872b2265f476a2b60565f344c7b570
msgctxt "scenario5:scenario5_E25A3CED_7774_415D_AEA6_094D84FB6A19"
msgid "⟪k:0⟫I had given them happiness. ⟪k:1⟫I couldn’t take that away from them again."
msgstr "⟪k:0⟫Eu lhes dei felicidade. ⟪k:1⟫Não podia tirar isso delas novamente."

#: scenario5:scenario5_1F90D50D_BAFD_4302_908B_EAF92C1E9A62
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 80b8ef581ab30a5863cd5eac1ff2e7e8a8f14a02ad17d2969fafd4ef7345228f
#. default-sha256: 9af6c9d01f4e9e8f3def67e043210c860d96d2ffffdfe6b5acc01d6a6ad767c8
msgctxt "scenario5:scenario5_1F90D50D_BAFD_4302_908B_EAF92C1E9A62"
msgid "⟪k:0⟫Not after what I had to go through to do it..."
msgstr "⟪k:0⟫Não depois do que eu tive que passar para conseguir..."

#: scenario5:scenario5_4B56EE6C_CABE_431B_B956_5F22B7F6E3BB
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 6efc705f3128cd902180e6e085e74e4b8cdc9ca807d80eac65ce49750964cc72
#. default-sha256: 48f41697b22461c825c2f67ac00db3078091b23a05c42741f58ec0ffc02c435d
msgctxt "scenario5:scenario5_4B56EE6C_CABE_431B_B956_5F22B7F6E3BB"
msgid "⟪k:0⟫............"
msgstr "⟪k:0⟫............"

#: scenario5:scenario5_24AEBBE7_47E0_44B0_87BA_A66DB1135D9C
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 532ee2c0e8ac6da4d1b101d326acc89b5246d4719ec3b784345cd5bd012f85ef
#. default-sha256: d7641a93da29947244fe434fd772621ba91ff20f5f499b39caadeb5601ed3a5e
msgctxt "scenario5:scenario5_24AEBBE7_47E0_44B0_87BA_A66DB1135D9C"
msgid "⟪k:0⟫(Ahh, no, cut that out. ⟪k:1⟫Getting way too depressing, Giselle.)"
msgstr "⟪k:0⟫(Ahh, não, pare com isso. ⟪k:1⟫Está ficando muito deprimente, Giselle.)"

#: scenario5:scenario5_34E62882_D5D5_4A9B_BF33_6F512D474499
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 508deda8b9f32ea58509fa217ccf4a6a4554e51422e80e284557dbfa18f17e53
#. default-sha256: d7ab933c89e3bc791b570be2292c90a18d68783bd607cf5f68a55f4c12720ee7
msgctxt "scenario5:scenario5_34E62882_D5D5_4A9B_BF33_6F512D474499"
msgid "⟪k:0⟫(Pull yourself together! That’s not who you are!)"
msgstr "⟪k:0⟫(Recomponha-se! Essa não é quem você é!)"

#: scenario5:scenario5_52516148_D540_4B8B_9ED3_E4A440C7D635
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 2650828c65e7dc1ae4ec60e0aea24d1d2daae427d39f7f42bf7e92618feb0f54
#. default-sha256: 7cd8860736cb667c51fc4b17fdca97f93d8944fe4c72ea0d865ef24e87512ec0
msgctxt "scenario5:scenario5_52516148_D540_4B8B_9ED3_E4A440C7D635"
msgid "⟪k:0⟫(Be positive...)"
msgstr "⟪k:0⟫(Seja positiva...)"

#: scenario5:scenario5_3B825B3F_B73A_424F_899B_CBEC47FC64B2
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: e8416efc3dc8fd48e6948a52f571560a4d6fff7821508decb9a3fc5689a06be4
#. default-sha256: a3f6c338c538be7ad4a637f45cd0764e93460315bdcd98e4d85723be7d815154
msgctxt "scenario5:scenario5_3B825B3F_B73A_424F_899B_CBEC47FC64B2"
msgid "⟪k:0⟫The negativity didn’t only come from my interactions with Michel, either."
msgstr "⟪k:0⟫A negatividade não vinha apenas das minhas interações com Michel, além disso."

#: scenario5:scenario5_7AFA77F6_FA10_4264_BB52_DF2C294495FE
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 09ab79d4f3f792ec20da6237f57a94f839077b829f766e82e970be31e5a36d9d
#. default-sha256: 5e207897d281e06c725a764ffafcc73239d70c6fb8bf51117cf300e1a4add1e2
msgctxt "scenario5:scenario5_7AFA77F6_FA10_4264_BB52_DF2C294495FE"
msgid ""
"⟪k:0⟫No, there seemed to be some kind of terrible presence within the mansion that twisted "
"people’s hearts."
msgstr ""
"⟪k:0⟫Não, parecia haver algum tipo de presença terrível dentro da mansão que torcia o coração das "
"pessoas."

#: scenario5:scenario5_1589DC9A_45CF_4954_92B8_A4547B1F788F
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: d1351cd2604015486a388e6ec4033f72468df1a35dccfaa79a546c068bff1a3c
#. default-sha256: 511318c45ad528e2540a69126493513190796276a256de549c775e79b2a595a1
msgctxt "scenario5:scenario5_1589DC9A_45CF_4954_92B8_A4547B1F788F"
msgid ""
"⟪k:0⟫The mansion was, in fact, a bit of a local legend, which I had been informed about before "
"being sent here."
msgstr ""
"⟪k:0⟫A mansão era, de fato, uma lenda local, sobre a qual fui informada antes de ser enviada para "
"cá."

#: scenario5:scenario5_7EB45A40_619F_4322_815C_A619C5B4A533
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: dedaf65727b31e68b89f4b09a8781c0b8037ef1e462455e31a52084267235c43
#. default-sha256: e1c4576637f6b5e1cbfcf761eda7e900ad3a4dd8fe1cba66327ff5f301e665a6
msgctxt "scenario5:scenario5_7EB45A40_619F_4322_815C_A619C5B4A533"
msgid ""
"⟪k:0⟫People claimed it was cursed, and that an evil witch had lived in it for many, many years."
msgstr ""
"⟪k:0⟫As pessoas diziam que era amaldiçoado, e que uma bruxa malvada viveu nela por muitos, muitos "
"anos."

#: scenario5:scenario5_75C08C9A_09D8_48D0_84FB_2B452D642BFC
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 6a80babbf705b38591e5adcdc83f6abd5c419c38ddd83c76d310365fe606ea8b
#. default-sha256: 53b2a8f7df930d2ed71cc84bb196ebb3060091a2fac4a78e4cfe002643023ca3
msgctxt "scenario5:scenario5_75C08C9A_09D8_48D0_84FB_2B452D642BFC"
msgid "⟪k:0⟫Michel joked that he was the witch, but I didn’t believe him."
msgstr "⟪k:0⟫Michel brincou dizendo que ele era a bruxa, mas eu não acreditei nele."

