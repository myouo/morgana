#: scenario5:scenario5_A1BC6589_AD46_4643_96C3_5BCB407C5728
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 5c7f699a5f02be8d9b662d8081bea5cc27e48ec753262cd41b723d386c622961
#. default-sha256: 3b9370772646c082c369429e3796a3a35ca4fef68a38d6a0afa73fcc422d4f0c
msgctxt "scenario5:scenario5_A1BC6589_AD46_4643_96C3_5BCB407C5728"
msgid ""
"⟪k:0⟫If there wasn’t so much fog, I would probably have been able to see little columns of orange "
"evening sunlight fighting their way through the trees,"
msgstr ""
"⟪k:0⟫Se não houvesse tanto nevoeiro, eu provavelmente seria capaz de ver pequenas colunas de sol "
"alaranjado abrindo caminho por entre as árvores,"

#: scenario5:scenario5_139A6283_5350_4BBB_9D26_9529B5C9F3DE
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: bb58c09af71669715b5a9159a25281be79af521229a11d6f8fa0a7c27b7bee3e
#. default-sha256: 245d210ee2837d1f9913ca53e8db7d595b533acc451b47f5c3f56d3fd79ed21b
msgctxt "scenario5:scenario5_139A6283_5350_4BBB_9D26_9529B5C9F3DE"
msgid ""
"⟪k:0⟫but the milky white mist seemed to swallow up all the light,⟪k:1⟫leaving nothing for the "
"surrounding area."
msgstr ""
"⟪k:0⟫mas a névoa branca leitosa parecia engolir toda a luz,⟪k:1⟫sobrando nada para a área ao "
"redor."

