#: scenario5:scenario5_4192DE52_71D2_4CD7_A2B6_2560383B81C3
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: fab7b5ff84d73ed34c4925cc81dba3a832612e73de8b3486b0dc73f1e0b8de60
#. default-sha256: cc1eff3b87d109614781378f925a09d1c7cdba0f0686e9d571e37a14ed819e35
msgctxt "scenario5:scenario5_4192DE52_71D2_4CD7_A2B6_2560383B81C3"
msgid ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫⟪k:4⟫⟪k:5⟫⟪k:6⟫⟪k:7⟫⟪k:8⟫⟪k:9⟫⟪k:10⟫⟪k:11⟫⟪k:12⟫⟪k:13⟫I didn’t really "
"understand Michel."
msgstr ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫⟪k:4⟫⟪k:5⟫⟪k:6⟫⟪k:7⟫⟪k:8⟫⟪k:9⟫⟪k:10⟫⟪k:11⟫⟪k:12⟫⟪k:13⟫Eu não entendia Michel, "
"realmente."

#: scenario5:scenario5_2175D33D_9FEE_4962_9030_ACDA650195EF
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: c7112b1511e33c36d6add3863c4f0e192b3e2be55cf1646b3ee578e59dd78351
#. default-sha256: eba0ea4c360a2f77b8d632a3030547ad43a10edda7b2f47fc87a93e5cc9d0190
msgctxt "scenario5:scenario5_2175D33D_9FEE_4962_9030_ACDA650195EF"
msgid "⟪k:0⟫But that was probably because we were still essentially strangers."
msgstr "⟪k:0⟫Mas isso era, provavelmente, porque ainda éramos basicamente estranhos."

#: scenario5:scenario5_B9E5076F_86BC_4FCD_8795_13236C3198BD
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 992f353b774af1adfd1b00f8e490887706d77657bc3693a3f147aadeafd98d75
#. default-sha256: 7df6e1cea66fa1aec1c011e2a2a941d3fc6e2ab4e3decb4c4d0569c4bc293bc2
msgctxt "scenario5:scenario5_B9E5076F_86BC_4FCD_8795_13236C3198BD"
msgid ""
"⟪k:0⟫Having been sent to the mansion as reparation for my mistakes,⟪k:1⟫I wasn’t sure who I might "
"find there,"
msgstr ""
"⟪k:0⟫Tendo sido enviada para a mansão como reparação por meus erros,⟪k:1⟫Eu não tinha certeza de "
"quem eu poderia encontrar lá,"

#: scenario5:scenario5_1A3ED3E4_ACAB_4EEC_A286_785C54D46722
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 338101bf93fa22cf22485cf0a91fd071dbaf7ed5495ff29169fa4d280b7c63f7
#. default-sha256: f4345ad58b43832802122332ae57476fdd86e131ea866d8f91bfc96e54808a8d
msgctxt "scenario5:scenario5_1A3ED3E4_ACAB_4EEC_A286_785C54D46722"
msgid ""
"⟪k:0⟫but I was tentatively convinced he wasn’t a ⟪k:1⟫terrible⟪k:2⟫ person.⟪k:3⟫⟪k:4⟫He didn’t do "
"anything to me—⟪k:5⟫⟪k:6⟫except stay away."
msgstr ""
"⟪k:0⟫mas eu estava provisoriamente convencida de que ele não era uma pessoa ⟪k:1⟫terrível⟪k:2⟫."
"⟪k:3⟫⟪k:4⟫Ele não fez nada para mim—⟪k:5⟫⟪k:6⟫exceto, ficar longe."

#: scenario5:scenario5_1A399BDC_0574_4BE2_B2F0_3315DDB85EE2
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 60e22701b1cde2b33a5af2f5c2f04a44bc9d3f49e33201a6e1ff19e8dfffa89c
#. default-sha256: 0a5cba876746595da32fcefbf3ad11b187995f7e7f0ba04f8ce069413e6193c6
msgctxt "scenario5:scenario5_1A399BDC_0574_4BE2_B2F0_3315DDB85EE2"
msgid "⟪k:0⟫Michel spent most of his time in his chambers,"
msgstr "⟪k:0⟫Michel passava a maior parte do tempo em seus aposentos,"

#: scenario5:scenario5_6AD7B8F3_2F9A_4C61_9642_13D41D84E7C8
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 5c4774b0c74601b0a63192b99851dc050d7a126bca399076854b9ead40892106
#. default-sha256: 025516c7537a11b2501e8f2dbd5ea585c9dc1b57d34ae3f1700c1ddd443a0bf4
msgctxt "scenario5:scenario5_6AD7B8F3_2F9A_4C61_9642_13D41D84E7C8"
msgid "⟪k:0⟫which he had told me to never enter under any circumstances,"
msgstr "⟪k:0⟫nos quais ele me disse para não entrar em nenhuma circunstância,"

#: scenario5:scenario5_837EFFAC_46B5_46CA_90AC_C53143E2947A
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: b2d5f74cb37dde824c03ad34d0c9aaaa5b8f3d24eac30049fc0878acbe34d758
#. default-sha256: 5b46d345b6ac5d3afcf8ec9a6a8fd07409afd46a68a1f355df1b67fbb2c3d679
msgctxt "scenario5:scenario5_837EFFAC_46B5_46CA_90AC_C53143E2947A"
msgid "⟪k:0⟫so we rarely encountered one another in the halls."
msgstr "⟪k:0⟫então raramente nos encontrávamos nos corredores."

#: scenario5:scenario5_5C61B705_A21D_410F_B346_EB157082420C
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: a06f0d84892c8577d302ad526e7bce246d425dfa463be3e1c572a3edd8f36979
#. default-sha256: 26b82a16b1e28f1836f1ed7bf281bd1fdec38d0f506c5d1ce8b4a5d308518dee
msgctxt "scenario5:scenario5_5C61B705_A21D_410F_B346_EB157082420C"
msgid ""
"⟪k:0⟫For that reason, I made an effort to be kind and cheerful on the sporadic occasions we ⟪k:1⟫"
"did⟪k:2⟫ cross paths."
msgstr ""
"⟪k:0⟫Por isso, me esforcei para ser gentil e alegre nas esporádicas ocasiões em que ⟪k:1⟫"
"ocorria⟪k:2⟫ de cruzarmos caminho."

#: scenario5:scenario5_DD88F4CD_6D98_4C70_B736_FA324FDB6E3E
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 58060174a3d0708416476dcaf32845b2597f667b97e76f9459b90728f4107d2e
#. default-sha256: 411d031db7bc398f18f23e231d47240a48af33a92d2d226fef68ae341f472ec7
msgctxt "scenario5:scenario5_DD88F4CD_6D98_4C70_B736_FA324FDB6E3E"
msgid "⟪k:0⟫I figured if I kept that up long enough,⟪k:1⟫he would eventually warm up to me."
msgstr "⟪k:0⟫Achei que se fizesse isso por tempo suficiente,⟪k:1⟫ele acabaria por gostar de mim."

#: scenario5:scenario5_9C8A8B5A_8305_40B6_B42D_DE03C5F8F9BC
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 195ea6d435d1e657b99d2158e3625d0c07753c2fcca4e87307cb97a17f02531b
#. default-sha256: a0f0c4834d45a88e1aaa759cb4f3114dfe623c89805033a675e2c5491c415ded
msgctxt "scenario5:scenario5_9C8A8B5A_8305_40B6_B42D_DE03C5F8F9BC"
msgid ""
"⟪k:0⟫And as new housemates, being able to enjoy our time together was obviously preferable to the "
"alternative."
msgstr ""
"⟪k:0⟫E como novos companheiros de casa, poder aproveitar nosso tempo juntos era obviamente "
"preferível à outra opção."

#: scenario5:scenario5_9C8A8B5A_8305_40B6_B42D_DE03C6F8F9BC
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: f649d070e3432bfe3194cf3e5055d547232b41cabea8864ae2a67de651dfd8d8
#. default-sha256: 8a1587bf1dfc3a89328a7dc9548561fb75fd12ecc36bfbaf58f5db0fefd51e48
msgctxt "scenario5:scenario5_9C8A8B5A_8305_40B6_B42D_DE03C6F8F9BC"
msgid ""
"⟪k:0⟫If I did manage to break the ice, I hoped we would be able to do some talking—⟪k:1⟫⟪k:2⟫"
"about the mansion, about him, about me."
msgstr ""
"⟪k:0⟫Se eu conseguisse quebrar o gelo, esperava que pudéssemos conversar um pouco—⟪k:1⟫⟪k:2⟫sobre "
"a mansão, sobre ele, sobre mim."

#: scenario5:scenario5_9C8A8B5A_8305_40B6_B42D_DE23C5F8F9BC
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: a547406f3397c19c7b54a851ec90ebaea33b1a6719aca70d042785dc86e89a4c
#. default-sha256: d3d24c2411bd76144b4a32fe572942e69b87d0e4c67757393114dcf4a3651928
msgctxt "scenario5:scenario5_9C8A8B5A_8305_40B6_B42D_DE23C5F8F9BC"
msgid "⟪k:0⟫I just had to keep working at it."
msgstr "⟪k:0⟫Eu só tinha que continuar trabalhando nisso."

#: scenario5:scenario5_94B28477_ABF4_482D_9AC5_C312F87772BC
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 36ec4a2cc6bc427be1eb2765ae2bbb01468ec967d52869f2620093d06206cc37
#. default-sha256: 4c9a7a6c2a3e5fdb8a923741a4a661d68b66568de02ca64b333301030e720ee4
msgctxt "scenario5:scenario5_94B28477_ABF4_482D_9AC5_C312F87772BC"
msgid ""
"⟪k:0⟫⟪k:1⟫Michel didn’t need me to take care of him.⟪k:2⟫⟪k:3⟫He handled his own day-to-day needs "
"and activities by himself,⟪k:4⟫and in fact, he didn’t ask me for anything."
msgstr ""
"⟪k:0⟫⟪k:1⟫Michel não precisava que eu cuidasse dele.⟪k:2⟫⟪k:3⟫Ele lidava com suas próprias "
"necessidades e atividades do dia-a-dia sozinho e, na verdade, ele não me pediu por nada."

#: scenario5:scenario5_2CB58756_5E47_4229_A0F4_2057BBBB5DC5
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: ca4d168e7dfe22c3d01da45fbd6839f2d0175ce8ddc648e9bde4642863c3e546
#. default-sha256: 27b6f7df24722d2df1c50064656f7b111eacc0cedfd7bc0937dba223d50ffdc9
msgctxt "scenario5:scenario5_2CB58756_5E47_4229_A0F4_2057BBBB5DC5"
msgid "⟪k:0⟫An aristocrat who had no use for his servant—⟪k:1⟫I hadn’t met anyone like him before."
msgstr ""
"⟪k:0⟫Um aristocrata que não tinha utilidade para sua serva—⟪k:1⟫eu não tinha conhecido ninguém "
"como ele antes."

#: scenario5:scenario5_08503938_3750_4B42_AD57_9D4057420069
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 441dda17642d7281392bef65d5856dcb55ee6cd7d0ac770e6bc17ee926064e21
#. default-sha256: 898a09b825dc4193e0ac941f5323d1937cc68f98952d69af5c56031be9f7418a
msgctxt "scenario5:scenario5_08503938_3750_4B42_AD57_9D4057420069"
msgid "⟪k:0⟫All right, then."
msgstr "⟪k:0⟫Tudo bem, então."

#: scenario5:scenario5_22229AC0_62EC_4C47_BBB6_981E435ED90D
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: cab733dc98378a3602f23c3173029b46afeeea712475a98b642ac0c98a8b6ebc
#. default-sha256: 5ef6c477fff82b253a43a98fa7a703de08e04b69aa48adca29a16dfe9287fb5a
msgctxt "scenario5:scenario5_22229AC0_62EC_4C47_BBB6_981E435ED90D"
msgid "⟪k:0⟫That meant about all I could do was clean."
msgstr "⟪k:0⟫Isso significava que tudo o que eu podia fazer era limpar."

#: scenario5:scenario5_EBDE2311_051B_4F20_8957_58F329E531C0
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 93725d24fae6f3904fc94c153d2405efb87a48a9bacd44f21d72ae2537a95b3a
#. default-sha256: 4e17a327e2c5c525c7d77db2f2fe07508c1185140dcb6a70a4545af6cb0ec0af
msgctxt "scenario5:scenario5_EBDE2311_051B_4F20_8957_58F329E531C0"
msgid "⟪k:0⟫I wasn’t sure how his room looked,⟪k:1⟫but the rest of the house was, quite frankly,"
msgstr ""
"⟪k:0⟫Eu não tinha certeza de como era o quarto dele,⟪k:1⟫mas o resto da casa era, francamente,"

#: scenario5:scenario5_28A590F8_3E65_4CBA_9BB6_6B6A1F40E6F7
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 9ca403dde4e2b8ffd7b101c7b42561a8d48b45c12f37aa7d86d3375ccf13cd6a
#. default-sha256: dad09aa11a5566c5fdffefb1a00dbd037f565c1eb7123677cc34db26f1093264
msgctxt "scenario5:scenario5_28A590F8_3E65_4CBA_9BB6_6B6A1F40E6F7"
msgid "⟪k:0⟫an absolute disaster."
msgstr "⟪k:0⟫um desastre absoluto."

#: scenario5:scenario5_9ABE020C_6F10_4175_8CBE_9513F1C4460F
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 683d9e1139630893aca36b70fdb511327aa38943b9d6834b3de001a99986ae6d
#. default-sha256: df9a41ad10eabbb24f66276438caae4cef642c8c3b98e1539f22589ca4315e21
msgctxt "scenario5:scenario5_9ABE020C_6F10_4175_8CBE_9513F1C4460F"
msgid "⟪k:0⟫The dust was so heavy it was obvious it hadn’t been touched in years."
msgstr "⟪k:0⟫A poeira era tão pesada que era óbvio que não era tocada há anos."

#: scenario5:scenario5_70932162_D4E5_48C0_AA9E_46305E93B326
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 83c1de768382dbaf14b29f07dfd98975868241bb674e04340a524fe59e62a1dc
#. default-sha256: 4345ce64b4faa02c6703fb25cf3447bcc487840afac5d35496bda847f65dac79
msgctxt "scenario5:scenario5_70932162_D4E5_48C0_AA9E_46305E93B326"
msgid "⟪k:0⟫Let’s get started!"
msgstr "⟪k:0⟫Vamos começar!"

#: scenario5:scenario5_7F83E47E_F419_4757_9041_BA63BE0ED8E3
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: bdb10a35184b9dd9b5d19bfe909bfa1c6cce8dc5dcd45987e64674714a86dae5
#. default-sha256: ba34bd25014b32e5fb6d2c9e228c5119b8bc9a7a51ab85409a189df00fa34b48
msgctxt "scenario5:scenario5_7F83E47E_F419_4757_9041_BA63BE0ED8E3"
msgid ""
"⟪k:0⟫It couldn’t be healthy to live in these conditions, so I set out to clean each room in the "
"house one by one."
msgstr ""
"⟪k:0⟫Não poderia ser saudável viver nessas condições, então comecei a limpar cada cômodo da casa, "
"um por um."

#: scenario5:scenario5_96BE2FEC_54AA_46B0_989A_AF2BB4AAAA82
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: ed79b9b96b17e1da06c9a9860689966ee98d56ffc70b9d6ffe83a7aaf354e31a
#. default-sha256: 35eb9dae43e6781f87e3e08ba6643d1f15b81828ec7383409ec317fb62886eb8
msgctxt "scenario5:scenario5_96BE2FEC_54AA_46B0_989A_AF2BB4AAAA82"
msgid "⟪k:0⟫That said, it wasn’t going to be an easy task."
msgstr "⟪k:0⟫Dito isso, não seria uma tarefa fácil."

#: scenario5:scenario5_903B6B3D_F1A4_4D9A_8915_EDFF16189AFC
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 3ab0d34b98e4ae2dc2a6c9370c3884f8e178cdd61ce9d179daa6df1db66591ad
#. default-sha256: a56c82176f68497f8f3c82ef67a1039bc5c193016536c44b74e882a0204b0b65
msgctxt "scenario5:scenario5_903B6B3D_F1A4_4D9A_8915_EDFF16189AFC"
msgid ""
"⟪k:0⟫Not because I was bad at cleaning—⟪k:1⟫⟪k:2⟫in fact, I considered myself quite good at it—"
msgstr ""
"⟪k:0⟫Não porque eu era ruim em limpeza—⟪k:1⟫⟪k:2⟫na verdade, eu me considerava muito boa nisso—"

#: scenario5:scenario5_6EED7906_7A20_4A87_9380_7D61E457C41A
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: f8f223fb2211c0e2bb498bb9cf4a86e0e1f72c7f40aba5e3fc742672f7787db4
#. default-sha256: 2d6d6bf08450d23c810ce7fc29405281a3712e12923ef0e57ffd5ec6046cfe2d
msgctxt "scenario5:scenario5_6EED7906_7A20_4A87_9380_7D61E457C41A"
msgid ""
"⟪k:0⟫but because it was near impossible to find all the dust and grime that needed cleaning under "
"the flickering light of a candle."
msgstr ""
"⟪k:0⟫mas porque era quase impossível encontrar toda a poeira e sujeira que precisavam ser limpas "
"sob a luz bruxuleante de uma vela."

#: scenario5:scenario5_B410BE8E_78D9_44E6_BB98_E6A927B785DA
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 7752fba3b85dd458cbd9b91f4a81e2b3973cb400e86c75f22e253f476888a8b5
#. default-sha256: a434ca63dc49a0b6e2f94024b44d17dd10ed59e09de799e9a1e4c9cd9869a028
msgctxt "scenario5:scenario5_B410BE8E_78D9_44E6_BB98_E6A927B785DA"
msgid ""
"⟪k:0⟫I can’t understand how anyone sane can live in this dark.⟪k:1⟫⟪k:2⟫What’s wrong with him?"
msgstr ""
"⟪k:0⟫Não consigo entender como alguém em sã consciência pode viver nesta escuridão.⟪k:1⟫⟪k:2⟫O "
"que há de errado com ele?"

#: scenario5:scenario5_356CFF91_0BC9_440F_B59D_17FAB597849E
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 446f61b96b1280f08d37f130a4dc8f91ceaca8b3652c7444f167ea107e5d65fe
#. default-sha256: 4dfe3f0f021273fc9e1dae15e4e55e9415bf94c69602dfcef63682ff49a3c2ac
msgctxt "scenario5:scenario5_356CFF91_0BC9_440F_B59D_17FAB597849E"
msgid "⟪k:0⟫Maybe... ⟪k:1⟫he’s actually a vampire."
msgstr "⟪k:0⟫Talvez...⟪k:1⟫ele seja um vampiro."

#: scenario5:scenario5_4CE48C0B_1CCE_4B76_9C3C_186F60FDDC5A
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 4e7dd869faab237acf7622deb9b5399fb869ef5139bdb2ef3fecd33961ba4851
#. default-sha256: dd18342b14a53e733470ab9e7f6c4b8e236f8a0e4c1318ba69d24437b6880da3
msgctxt "scenario5:scenario5_4CE48C0B_1CCE_4B76_9C3C_186F60FDDC5A"
msgid "⟪k:0⟫........................"
msgstr "⟪k:0⟫........................"

#: scenario5:scenario5_6490CE95_9D82_48C8_ABE5_66AB0FDCE1D1
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: d06ba5010ba218abd24b7b01c449ecdbeb8eb5573ad131741dd60208a7386f8d
#. default-sha256: 1061973631b82049065bb4af5bdd1d40fc90c5fe089cbdf1494ee23a823ed972
msgctxt "scenario5:scenario5_6490CE95_9D82_48C8_ABE5_66AB0FDCE1D1"
msgid ""
"⟪k:0⟫Oh god, hahaha, wouldn’t that be something.⟪k:1⟫⟪k:2⟫I can see it now... ⟪k:3⟫him sneaking "
"out every night to suck the blood of pretty girls.⟪k:4⟫⟪k:5⟫Priceless!"
msgstr ""
