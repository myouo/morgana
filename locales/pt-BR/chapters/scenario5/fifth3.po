#: scenario5:scenario5_A5ABC44B_1465_43F4_850E_1343EF233D08
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 50634ba4cc4bd18fcc179f9bae2fee8e1b0e627f203489c9b0e835f7f9e490e8
#. default-sha256: b02d9c70d12291fb3f830993b168d06dfbeb48345dbd800cd037fa062a9e088f
msgctxt "scenario5:scenario5_A5ABC44B_1465_43F4_850E_1343EF233D08"
msgid ""
"⟪k:0⟫No. Out with the negative thoughts. ⟪k:1⟫Gotta stay positive.⟪k:2⟫⟪k:3⟫Yeah! He hasn’t tried "
"to chase me out yet."
msgstr ""
"⟪k:0⟫Não. Fora com os pensamentos negativos. ⟪k:1⟫Preciso permanecer positiva.⟪k:2⟫⟪k:3⟫Sim! Ele "
"não tentou me expulsar ainda."

#: scenario5:scenario5_51CB0B3F_6BE5_4FF3_8496_E69F74237C28
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 2175f2526234d997197934730de6b3771289775afd8b98a9b9b4c10829c99615
#. default-sha256: 84ed8b9efb1f63d71ac7ec83a2f7b4050fb614b4ddf9f76561bab63c5e62d103
msgctxt "scenario5:scenario5_51CB0B3F_6BE5_4FF3_8496_E69F74237C28"
msgid "⟪k:0⟫I just... ⟪k:1⟫haven’t broken the ice."
msgstr "⟪k:0⟫Eu só... ⟪k:1⟫não quebrei o gelo."

#: scenario5:scenario5_F0A004FE_0504_4874_863A_BDC4B1385474
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 439182d86833314c652ffe91c19c66abc8b83b743ebbad693309db9c3d8e3a9b
#. default-sha256: 00031c4399b3c1b55bb6cbb42ca5bb84032cb4e586528f92e3aa77d74a037ead
msgctxt "scenario5:scenario5_F0A004FE_0504_4874_863A_BDC4B1385474"
msgid "⟪k:0⟫I had to stay positive. ⟪k:1⟫Optimistic. ⟪k:2⟫Happy thoughts. ⟪k:3⟫And be myself."
msgstr ""
"⟪k:0⟫Eu tinha que me manter positiva. ⟪k:1⟫Otimista. ⟪k:2⟫Pensamentos felizes. ⟪k:3⟫⟪k:4⟫E ser eu "
"mesma."

#: scenario5:scenario5_17E15F6A_C5C3_484C_AD9B_E119F8B8A747
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 46a5273071d5213f54bff5509ac81365dc35f9ed19ec838aa21c8fdba627582e
#. default-sha256: 50158304ea4bb09c1dc93c3d42c7a69101c8791320c16b5b69bbede06184158c
msgctxt "scenario5:scenario5_17E15F6A_C5C3_484C_AD9B_E119F8B8A747"
msgid ""
"⟪k:0⟫As long as I kept working at it, with enough time, Michel would surely come around and not "
"be so distant."
msgstr ""
"⟪k:0⟫Enquanto eu continuasse trabalhando nisso, com tempo suficiente, Michel certamente se "
"aproximaria e não seria tão distante."

#: scenario5:scenario5_53CFEAC8_81FA_438F_89DC_E760DAC769D9
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 2499e80f4dc1f30654236bf25743e1c5a6663cd0cb592a0fad19e484d376ded0
#. default-sha256: 9c5179eb7f68e5949444d9523176231a462ac2e4a44d37edbfdc1f7425cad030
msgctxt "scenario5:scenario5_53CFEAC8_81FA_438F_89DC_E760DAC769D9"
msgid ""
"⟪k:0⟫I’ve got a goal, so let’s get to work!⟪k:1⟫⟪k:2⟫First, I make supper, then I ask him to have "
"it with me!"
msgstr ""
"⟪k:0⟫Eu tenho um objetivo, então vamos trabalhar!⟪k:1⟫⟪k:2⟫Primeiro, faço o jantar, depois peço "
"para ele comer comigo!"

#: scenario5:scenario5_7BF7B634_FCB5_4F5B_AF9C_9DD60B9B5647
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 4432dbc6aca6a69922b2d1a37389a5bde894fd2945d1a6b269bf4d772cd862be
#. default-sha256: de3e8a81413fa87c9dc2ad8bbc4d49a7cfab9dd4ecc164464925baceae322565
msgctxt "scenario5:scenario5_7BF7B634_FCB5_4F5B_AF9C_9DD60B9B5647"
msgid "⟪k:0⟫Gotta be proactive when it comes to the reclusive types.⟪k:1⟫⟪k:2⟫All right, here goes!"
msgstr "⟪k:0⟫Temos que ser proativos quando se trata dos tipos reclusos.⟪k:1⟫⟪k:2⟫Tudo bem, lá vai!"

#: scenario5:scenario5_1833A9EF_9C5F_42E2_A025_321232DDA47F
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: a3a5a4360a5c0cf9ade5485aad065ec2c18ad5c2031bed700a5c2c47ac1b48ee
#. default-sha256: d212d95af6387351d74c45160627b32db2f6ee2d678132d2eb3b631ef4546554
msgctxt "scenario5:scenario5_1833A9EF_9C5F_42E2_A025_321232DDA47F"
msgid "⟪k:0⟫...Or, here ⟪k:1⟫would⟪k:2⟫ go..."
msgstr "⟪k:0⟫...Ou, lá ⟪k:1⟫iria⟪k:2⟫..."

#: scenario5:scenario5_B72CDCC4_4A01_424F_85BE_6835A62DB5E3
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: a91e765bc4a44c737240be3b56646b839a7e6aba34d2fa763e42272b6730b0a0
#. default-sha256: 309ced5d12d07f415b2fb7afc33c94ce2d76ceab8d1372539fa6f9b1a2f18acc
msgctxt "scenario5:scenario5_B72CDCC4_4A01_424F_85BE_6835A62DB5E3"
msgid "⟪k:0⟫but we’re almost out of supplies."
msgstr "⟪k:0⟫mas estamos quase sem suprimentos."

#: scenario5:scenario5_11BB8136_F92F_4ACC_9734_9C23776BACCA
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 81a10182fe6a1eb1a62d738fe759fd810f1c380bb8d337124fa3b4ff861d659d
#. default-sha256: 55968a5b2933e903e4f9670907f6fdd58ca316bc27507f11c56d8632afab7316
msgctxt "scenario5:scenario5_11BB8136_F92F_4ACC_9734_9C23776BACCA"
msgid "⟪k:0⟫Well, so much for that."
msgstr "⟪k:0⟫Bem, isso já era."

#: scenario5:scenario5_412A536C_C679_4625_A4B3_6C6F04C86EBB
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 58381a0681602f0ecd800accfd196bdd5047f9b4e216a31b8e78beabbd85ff43
#. default-sha256: 140966606aafbbb731a0746746b5f058775e2a0b799b75bd4d8c8007a4caec7a
msgctxt "scenario5:scenario5_412A536C_C679_4625_A4B3_6C6F04C86EBB"
msgid ""
"⟪k:0⟫The cellar was where the nonperishable food was stored. ⟪k:1⟫Dried foods, smoked meats, "
"cheeses, and a small scattering of root vegetables."
msgstr ""
"⟪k:0⟫A adega era onde os alimentos não perecíveis eram armazenados. ⟪k:1⟫Alimentos secos, carnes "
"defumadas, queijos e uma pequena quantidade de tubérculos."

#: scenario5:scenario5_C7595F5B_95E2_4441_AEA9_5031309B1B90
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 4f72094f808b68f9e9d18f6620272d77fffa589b88b79fdee2aa01f2cef4c8d7
#. default-sha256: cebbff116d31958736ada41c6f670f5f86f3ef77d316d914463af52bb95cfece
msgctxt "scenario5:scenario5_C7595F5B_95E2_4441_AEA9_5031309B1B90"
msgid "⟪k:0⟫Looking at this makes me feel like a soldier holding down a castle’s fortifications."
msgstr ""
"⟪k:0⟫Olhar para isso me faz sentir como um soldado guarnecendo as fortificações de um castelo."

#: scenario5:scenario5_DFC7153C_F91F_4BF4_8171_C97CFDF5C923
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: debc8ba9c5d7fffa53b619dbb1a4de0d069cafdac64f8bb69737ff4f8b33922e
#. default-sha256: 618a3d7e21f23f0551e8d600373a361f51de399b5db8fe07b921c4bd3e70f57a
msgctxt "scenario5:scenario5_DFC7153C_F91F_4BF4_8171_C97CFDF5C923"
msgid ""
"⟪k:0⟫Had Michel really gone ten years on nothing but this?⟪k:1⟫⟪k:2⟫I would have raised the white "
"flag long ago."
msgstr ""
"⟪k:0⟫Michel realmente passou dez anos com nada além disso?⟪k:1⟫⟪k:2⟫Eu teria erguido a bandeira "
"branca há muito tempo."

#: scenario5:scenario5_906466F2_7ED7_4E86_95B3_B101047690F5
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 9500449d7711d40b47c79a899478b74592800b9c4645be4950b97050b2797d34
#. default-sha256: 8338d7a28cf0c6bff4bdef0be74978ec072931e802b769d3fa6137f2497f1bd0
msgctxt "scenario5:scenario5_906466F2_7ED7_4E86_95B3_B101047690F5"
