#: scenario5:scenario5_5B8E17F4_A3C4_419A_A00C_994A0502EBCA
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 2add92a05dffd728b82378f28268f82df849746139b30d7215d54947a57b6050
#. default-sha256: ee5c716d7076c35a3ea696c09a7ced392839c2dfa22ab5d834b62efdec3df047
msgctxt "scenario5:scenario5_5B8E17F4_A3C4_419A_A00C_994A0502EBCA"
msgid "⟪k:0⟫Am I really that much of a nuisance?"
msgstr "⟪k:0⟫Será que eu sou tão chata assim?"

#: scenario5:scenario5_BA276AAF_86AF_4D04_9849_50FCA2D525C5
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: c0e8cea4890b24ec8b6502f19d490c537b48525a79949016d8aef0904ae992a8
#. default-sha256: e6cf9e7a569b607291a13fdef9c50c4f48952f7623351696ed701536459c2a39
msgctxt "scenario5:scenario5_BA276AAF_86AF_4D04_9849_50FCA2D525C5"
msgid ""
"⟪k:0⟫I’m not doing anything inappropriate, am I?⟪k:1⟫⟪k:2⟫I’m being pleasant and sociable, aren’t "
"I?"
msgstr ""
"⟪k:0⟫Não estou fazendo nada inapropriado, estou?⟪k:1⟫⟪k:2⟫Estou sendo agradável e sociável, não "
"estou?"

#: scenario5:scenario5_DF3F6E2A_FF8E_4D95_805F_7A18C50830D4
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: d25fc407a69ec73a216835c10053609d433addf822ff7cc799f4b704ba5d936e
#. default-sha256: 24408c40b0f63019d70856f9b97d83fa477aabf9af4cb75820a2933b8d929148
msgctxt "scenario5:scenario5_DF3F6E2A_FF8E_4D95_805F_7A18C50830D4"
msgid "⟪k:0⟫I haven’t given him any reason to not like me, I think.⟪k:1⟫⟪k:2⟫I hope..."
msgstr ""
"⟪k:0⟫Eu não dei a ele nenhuma razão para não gostar de mim, eu acho...⟪k:1⟫⟪k:2⟫Eu espero..."

#: scenario5:scenario5_C945864B_F126_41CF_AB15_A799D69A1064
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 39acf03a325f59f2713a70c215dbbf1ac3957c47c5b16e47a3fce9e808c835a1
#. default-sha256: 5f67c415af37090a851cacddad182e8ee3840d4ca4ced7fd888ddfa1608ff5b4
msgctxt "scenario5:scenario5_C945864B_F126_41CF_AB15_A799D69A1064"
msgid "⟪k:0⟫He had never been very enthusiastic about my staying here,"
msgstr "⟪k:0⟫Ele nunca tinha ficado muito entusiasmado com a minha estadia aqui,"

#: scenario5:scenario5_BA31EB28_082D_47A3_BB1A_CF08485A11A3
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: c6e07cccef2ea1e615aa90e20078cd88b665efe2656b4020c44e8f8fdd1d108d
#. default-sha256: 7e8474a9f8b2f2502f4573150fa7a1972fbcba0767ca56b6208e416948431ae9
msgctxt "scenario5:scenario5_BA31EB28_082D_47A3_BB1A_CF08485A11A3"
msgid "⟪k:0⟫but I hadn’t been given a choice. ⟪k:1⟫I had been sent here by his family."
msgstr "⟪k:0⟫mas não me foi dada escolha. ⟪k:1⟫Eu tinha sido enviada aqui pela família dele."

#: scenario5:scenario5_285A114B_CE40_48E8_A101_D05970835748
