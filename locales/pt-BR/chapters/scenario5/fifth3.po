#: scenario5:scenario5_7F9C6881_0D0B_448C_963B_E47E326BBE54
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: c1ab3306fca51fd02ea3fe023e965b7644f79065454541f0ac06b8eb34549ad8
#. default-sha256: 1bf4333aa419eb0564bfc60e1c97a3ec49b09eaeb7b090547677881bc9a60f12
msgctxt "scenario5:scenario5_7F9C6881_0D0B_448C_963B_E47E326BBE54"
msgid ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫⟪k:4⟫⟪k:5⟫⟪k:6⟫⟪k:7⟫⟪k:8⟫⟪k:9⟫⟪k:10⟫⟪k:11⟫⟪k:12⟫It had been a little under "
"two weeks since I had moved in with Michel."
msgstr ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫⟪k:4⟫⟪k:5⟫⟪k:6⟫⟪k:7⟫⟪k:8⟫⟪k:9⟫⟪k:10⟫⟪k:11⟫⟪k:12⟫Fazia pouco menos de duas "
"semanas desde que fui morar com Michel."

#: scenario5:scenario5_A2B2C3A3_E67B_4632_A11A_A01A64AC1CB0
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: ec3ac8787a91be7dce72ed08302422468dae0143ad1fd1d3ec216af724cff957
#. default-sha256: 8049a2769ed074c82196a1ee27c3004b9a6a0327efc48219d9a89d0d2873f4e0
msgctxt "scenario5:scenario5_A2B2C3A3_E67B_4632_A11A_A01A64AC1CB0"
msgid "⟪k:0⟫Though we lived in the same house, we rarely saw each other."
msgstr "⟪k:0⟫Embora vivessemos na mesma casa, raramente nos víamos."

#: scenario5:scenario5_2A965A44_8F80_40BF_A5E1_D86B24CE088C
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 1d6d119e242ce90a17b5b8d31bbd5f1d1d12e4229579ea2e686eb71eebdebacd
#. default-sha256: 368f9c0d8fd8caa345773be9382e93113bbe9fa9b1223502ed7414addc47a835
msgctxt "scenario5:scenario5_2A965A44_8F80_40BF_A5E1_D86B24CE088C"
msgid "⟪k:0⟫On unlucky days, I wouldn’t see him at all."
msgstr "⟪k:0⟫Em dias de azar, eu nem o via."

#: scenario5:scenario5_85E8BFB9_F381_4DD1_BD7C_4527A9E775B1
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 937eba452bea49420d1b18be6c8736463a8cb1ee8b9759e36db32449c21f42fd
#. default-sha256: af9b91b73c30992159fa75928ed75b4e4b110bff36ad07c73e6016ae663d0b37
msgctxt "scenario5:scenario5_85E8BFB9_F381_4DD1_BD7C_4527A9E775B1"
msgid ""
"⟪k:0⟫I wasn’t sure if he ate in his room or our schedules were simply misaligned, but we never "
"had any meals together."
msgstr ""
"⟪k:0⟫Eu não tinha certeza se ele comia em seu quarto ou nossos horários estavam simplesmente "
"desalinhados, mas nunca fazíamos refeições juntos."

#: scenario5:scenario5_A5BCFB35_20B8_4F12_9B50_57F5C20CAF1C
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: ab7ed6c506b0ba5189244fca8ba9c15568835ad6f9dd178085b5f690210ab0b9
#. default-sha256: eb311093ac22a0d86c3ab0fa38974c3d13c6bcd13308fe037e26e172f4e1045d
msgctxt "scenario5:scenario5_A5BCFB35_20B8_4F12_9B50_57F5C20CAF1C"
msgid "⟪k:0⟫Perhaps he was deliberately avoiding me."
msgstr "⟪k:0⟫Talvez ele estivesse deliberadamente me evitando."

#: scenario5:scenario5_CBF3FE2B_D765_47F6_BB1B_2ECF64E875C8
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: de569e1e947a23bdbb70b507d19c7acdcdf2175db230355a3dd4fb02d8b4046c
#. default-sha256: 0f683c2c0c658bcc9089719f8f806e144149ad064f16191314ec4aee8bbda219
msgctxt "scenario5:scenario5_CBF3FE2B_D765_47F6_BB1B_2ECF64E875C8"
msgid "⟪k:0⟫That has to be it..."
msgstr "⟪k:0⟫Tem que ser isso..."

#: scenario5:scenario5_8C1E720E_D5B5_4FCD_86BC_ACBADC321ACB
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: d50d5bf74fa4cd3720c42e69b30e39a3c0cda8b3cc351351141748691105b729
#. default-sha256: 45dcab03db7b7cc802badad0dbdeb518ac021e045f38249f0041bbc0dbd2fa0d
msgctxt "scenario5:scenario5_8C1E720E_D5B5_4FCD_86BC_ACBADC321ACB"
msgid "⟪k:0⟫I know servant and master don’t usually eat at the same table,⟪k:1⟫but even so..."
msgstr "⟪k:0⟫Eu sei que servo e mestre não costumam comer na mesma mesa,⟪k:1⟫mas mesmo assim..."

#: scenario5:scenario5_6CBD4980_1912_4BFE_B443_1D7A16551157
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: b287c4eae6d962a22ea7da0140f1903874677cf8edbbb0cd80b751376b574d42
