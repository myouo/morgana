msgid "⟪k:0⟫............"
msgstr "⟪k:0⟫............"

#: scenario9:scenario9_E6E37D27_E7E9_4AD8_B0AA_20F76E48BEC2
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 252ab31559932cf876ce7051c3f720e825f43fe5d55580899650e74e02e37c83
#. default-sha256: 3ed215a9f8a8dd281009a61f8064b32ac04872d89d1f2eb7c6bbb83069748d49
msgctxt "scenario9:scenario9_E6E37D27_E7E9_4AD8_B0AA_20F76E48BEC2"
msgid ""
"⟪k:0⟫Upon her death, Morgana’s soul was afflicted with great pain resulting from the hatred and "
"resentment she bore."
msgstr ""
"⟪k:0⟫Após sua morte, a alma de Morgana foi afligida por uma grande dor resultante do ódio e do "
"ressentimento que ela carregava."

#: scenario9:scenario9_61E105AB_CBC5_45F8_BB12_D4BBD464AF7B
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 8f6236dcb92b5f90344767ba2dd2d757613672199453b6fab370c6c45ea02e0c
#. default-sha256: 7126aad15cf65980886d9b3db92c24ba11ef41063f8dc1e171c2bebef4b62c68
msgctxt "scenario9:scenario9_61E105AB_CBC5_45F8_BB12_D4BBD464AF7B"
msgid ""
"⟪k:0⟫A saint must put herself second to all others.⟪k:1⟫⟪k:2⟫She must be caring, generous, "
"forgiving.⟪k:3⟫⟪k:4⟫And she must not bear any ill will for anyone."
msgstr ""
"⟪k:0⟫Uma santa deve se colocar em segundo lugar em relação a todos os outros.⟪k:1⟫⟪k:2⟫Ela deve "
"ser atenciosa, generosa e misericordiosa.⟪k:3⟫⟪k:4⟫E ela não pode guardar rancor por ninguém."

#: scenario9:scenario9_22806235_A709_4C41_AC81_AD9B75A68C5F
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 26d1369d08b7a79c615268e352437079fec4a8eac7b285180e2133dbdbdbf42c
#. default-sha256: 40253d38a15921ea25225423ee57e3f14b78950a6fca47a5a17fa74700fdab06
msgctxt "scenario9:scenario9_22806235_A709_4C41_AC81_AD9B75A68C5F"
msgid "⟪k:0⟫So that’s why you always seemed so... ⟪k:1⟫abnormally pure-hearted..."
msgstr "⟪k:0⟫Então é por isso que você sempre pareceu tão... ⟪k:1⟫anormalmente pura de coração..."

#: scenario9:scenario9_C7844E63_00A8_4A5C_9E40_77B244818EEF
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 1f7345027fcd5af8d6874e1e6ef55f9c66d154104d97fdd81c6ebe16c74b678e
#. default-sha256: 6a7e66eb512ed45f456f4eb4086d53fa3502dc7bf6adf1f86c72e89ede532d62
msgctxt "scenario9:scenario9_C7844E63_00A8_4A5C_9E40_77B244818EEF"
msgid "⟪k:0⟫I refuse to accept..."
msgstr "⟪k:0⟫Eu me recusei a aceitar..."

#: scenario9:scenario9_DB5FE44D_E8BF_4FE4_ADC3_359A9861FAAA
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 759c7ec3d29e385a7c49d46e2d947f66ed5cdfa29b67c23c43f0b469091f18eb
#. default-sha256: b71b43967187527be085286161dffeb1e90b3eb93d356af1ed26112ac1a20b83
msgctxt "scenario9:scenario9_DB5FE44D_E8BF_4FE4_ADC3_359A9861FAAA"
msgid "⟪k:0⟫I was never meant to be a soul of my own."
msgstr "⟪k:0⟫Eu nunca deveria ter sido uma alma própria."

#: scenario9:scenario9_ED3E19B4_F27A_4DBB_9407_E7BDA4CD3900
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: b69342dc4c8e1d944ddb02f0ed005914b6a940ef70cd8f8c5c5298a9527f8a88
#. default-sha256: 4ee44533079cc6a94af6d4d3f9fb1f6a41a07f92324b9c550595054a82680e47
msgctxt "scenario9:scenario9_ED3E19B4_F27A_4DBB_9407_E7BDA4CD3900"
msgid "⟪k:0⟫I wished to live,"
msgstr "⟪k:0⟫Eu desejei viver,"

#: scenario9:scenario9_9A5A72F1_0937_45A3_9907_771883651318
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: a50af7df0895a189ff485ab54df6fb25d4c580096afd89a550fc7eb365d83036
#. default-sha256: 19ee7d70645c8eda86a8692c3735e93f7058b4edfafc40380a5d2e1c1c6e46d2
msgctxt "scenario9:scenario9_9A5A72F1_0937_45A3_9907_771883651318"
msgid "⟪k:0⟫but your own wish?"
msgstr "⟪k:0⟫mas seu desejo?"

#: scenario9:scenario9_01EDA556_A383_47E5_9362_9F8E1A0E37F5
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: c05176fbd6aaa5533e00054a20902b966b87dde884a501eb0cb79138574568f3
#. default-sha256: 885c66b41e77d7315a781aae12e3dff523c40737320d8cd605275ebc001f4a4f
msgctxt "scenario9:scenario9_01EDA556_A383_47E5_9362_9F8E1A0E37F5"
msgid "⟪k:0⟫Which meant that my wish... ⟪k:1⟫had the consequence of granting Morgana’s with it."
msgstr ""
"⟪k:0⟫O que significava que meu desejo... ⟪k:1⟫teve como consequência conceder o de Morgana junto."

#: scenario9:scenario9_EA770485_F763_4E16_90CA_B38FFE952A0A
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 5061b9b0a54022f5e800e6ba47716acef5e5b6afebc9fc691f83a6b338eefe6a
#. default-sha256: 51a3c64dad1b34da79c31d4fb6c565b93aab7e68ae0785b5c336ab7cf1117808
msgctxt "scenario9:scenario9_EA770485_F763_4E16_90CA_B38FFE952A0A"
msgid ""
"⟪k:0⟫The house, having attained perpetuity, served as a place for those reconstructed by "
"Morgana’s curse to return to."
msgstr ""
"⟪k:0⟫A casa, tendo alcançado a perpetuidade, serviu como um lugar para aqueles reconstruídos pela "
"maldição de Morgana retornarem."

#: scenario9:scenario9_BF2BAD37_233B_4AAF_BBA1_1D0845550B0B
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 22059e55a3a13c65d11eb9a63ffc46da162eba9c9547b578876b697677870a1a
#. default-sha256: 7214f80cf243e593b288a6a4fd8c5c3d0fa5e5f55227930aa75f20b2de767cf7
msgctxt "scenario9:scenario9_BF2BAD37_233B_4AAF_BBA1_1D0845550B0B"
msgid "⟪k:0⟫I was the one most affected by her wish."
msgstr "⟪k:0⟫eu fui a mais afetada pelo desejo dela."

#: scenario9:scenario9_D948BE88_0FDF_4E12_B157_FE9A21E42EC8
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: ac1465b9916f865b02cd9f1a9ee7e27a6ffd49b6cfd457a2c0209206084ee6d5
#. default-sha256: 35f128039c165121028b7da6b9325edf0b0f05dfa7726a32eaff5a8f1aeea826
msgctxt "scenario9:scenario9_D948BE88_0FDF_4E12_B157_FE9A21E42EC8"
msgid ""
"⟪k:0⟫As much as I may have wanted to do good, for them to be happy...⟪k:1⟫⟪k:2⟫my fate was "
"dictated by her wish."
msgstr ""
"⟪k:0⟫Por mais que eu quisesse fazer o bem, que eles fossem felizes...⟪k:1⟫⟪k:2⟫meu destino foi "
"ditado pelo desejo dela."

#: scenario9:scenario9_CBA0F624_DC0B_454E_927C_7F0A72F8CF0C
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: fc6870704bec0b926cb9f721c006744745f65183eb2935375fab0a14859f1712
#. default-sha256: 5c29f96bb5892f09676b677d47d3f4ed454f334139c8e95a9a80cb66134b8451
msgctxt "scenario9:scenario9_CBA0F624_DC0B_454E_927C_7F0A72F8CF0C"
msgid "⟪k:0⟫In that position, my merely showing affection for anyone was damnable."
msgstr "⟪k:0⟫Nessa posição, minha mera demonstração de afeição por alguém era condenável."

