msgctxt "scenario9:scenario9_E4B3A56C_AE7E_4159_A51A_05132BF3EF3F"
msgid "⟪k:0⟫You didn’t intend for anything bad to befall anyone."
msgstr "⟪k:0⟫Você não pretendia que nada de ruim acontecesse a ninguém. "

#: scenario9:scenario9_C50A9C00_7CD9_4231_9A74_84B933568663
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 21284350a1af257a80acbc884a8b0f058421802dca9379f94977032a03313bd0
