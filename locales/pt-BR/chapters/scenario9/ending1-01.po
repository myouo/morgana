msgctxt "scenario9:scenario9_16985783_0C9E_45D6_976E_5508F0AB78BF"
msgid "⟪k:0⟫Extinguish your soul?"
msgstr "⟪k:0⟫Extinguir sua alma?"

#: scenario9:scenario9_6985F51E_3B8F_48EA_99A3_29D4E19BEBA9
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 8c335781391fd9d8d6cf396b4317c5e75448eedb9caa55f71b364bedf8c49506
