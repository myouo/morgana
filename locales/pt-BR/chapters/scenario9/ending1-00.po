msgid "⟪k:0⟫............"
msgstr "⟪k:0⟫............"

#: scenario9:scenario9_EEB2D58B_2A68_4E9C_8379_91E1270DF884
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 5806dc1770a4e1469aad22a499ad3333ad0f48607b0f3515a6ba900dc668d774
#. default-sha256: 9c247f69a7c9e0de1170c47c895469561f5f34fe31315d2727d8861aa1e08402
msgctxt "scenario9:scenario9_EEB2D58B_2A68_4E9C_8379_91E1270DF884"
msgid "⟪k:0⟫Why are you acting... ⟪k:1⟫like it’s all your fault?"
msgstr "⟪k:0⟫Por que está agindo... ⟪k:1⟫como se fosse tudo culpa sua?"

#: scenario9:scenario9_DF5DEAFE_AB08_4F9A_BCBA_1DA2539EC800
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 802eae5a35d488b62abd001a0b535516c9aa1dfd7777973372f89d14cdc19c60
#. default-sha256: 990d8eb8929c4ff65d48859e43f192a51ed2a86455d82e55b72c0e5f8d989538
msgctxt "scenario9:scenario9_DF5DEAFE_AB08_4F9A_BCBA_1DA2539EC800"
msgid "⟪k:0⟫Are you trying to say everyone would be better off without you?"
msgstr "⟪k:0⟫Está tentando dizer que todos estariam melhor sem você?"

#: scenario9:scenario9_924BB831_2A65_4066_B6DF_6B5AF8268651
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 0b53fe2a3f177d8fdfbf12419df7d6b59d45b670a213b172a1b01a2ba97f2469
#. default-sha256: 5d2f8c3708eaed8b057a14eac43ad19fd3f557febd73081bace839faf4054488
msgctxt "scenario9:scenario9_924BB831_2A65_4066_B6DF_6B5AF8268651"
msgid "⟪k:0⟫Like hell you were."
msgstr "⟪k:0⟫Pro inferno que é."

#: scenario9:scenario9_B139A233_E70D_4F3B_8565_A51B4A55377C
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 6c527cd6d05b444a3ebb41dd581504199a7d3571f8aae8baaca0be8ffc7f9c35
#. default-sha256: 8702185909d8b375deaa1bbafa7b1f8b82f0bbedd92fe7e36b0076fea96008fd
msgctxt "scenario9:scenario9_B139A233_E70D_4F3B_8565_A51B4A55377C"
msgid "⟪k:0⟫I was born to be a receptacle for her pain, to ease her suffering."
msgstr "⟪k:0⟫Eu nasci para ser um receptáculo da sua dor, para aliviar seu sofrimento."

#: scenario9:scenario9_8EC6D6CB_F486_41D7_BCDE_441BCF502863
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: a31b43c7e812016f6cfe5cc9619b57cdffb32393eb413c6ad6c86b06e48b6daf
#. default-sha256: d056dc8db2342e62d308b99abe957160caa860171761a620ee90c09e53920154
msgctxt "scenario9:scenario9_8EC6D6CB_F486_41D7_BCDE_441BCF502863"
msgid ""
"⟪k:0⟫That was not how she felt deep down, though.⟪k:1⟫⟪k:2⟫She was not a saint out of the "
"goodness of her heart."
msgstr ""
"⟪k:0⟫Não era assim que ela se sentia lá no fundo, no entanto.⟪k:1⟫⟪k:2⟫Ela não era uma santa por "
"bondade de coração."

#: scenario9:scenario9_27B4F3AD_B200_46E0_9E39_760FA23116D6
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 0677b94fec68148557cf08d419a631ed58f6e68dd07c6424492346be10ef1192
#. default-sha256: 4efabe9d14922cc2461853591b2b58c5c31a870c64e4cd8a7b0f3821ee7d813a
msgctxt "scenario9:scenario9_27B4F3AD_B200_46E0_9E39_760FA23116D6"
msgid ""
"⟪k:0⟫So she took all her “saintly” characteristics and gave them to me—⟪k:1⟫⟪k:2⟫caring for "
"others, putting herself second, being forgiving—"
msgstr ""
"⟪k:0⟫Assim, pegou todas as suas características “santas” e as deu para mim—⟪k:1⟫⟪k:2⟫se importar "
"com os outros, colocar-se em segundo lugar, ser misericordiosa—"

#: scenario9:scenario9_300588D5_5543_4925_9C59_B86D0CDF8E42
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 6f9ea9a11f52aac864c0c4dcde8247b50df9edc6ca55f284bcdb8dd80e7eb1a6
