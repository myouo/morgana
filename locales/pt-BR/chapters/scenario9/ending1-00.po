#: scenario9:scenario9_1E9F04AC_24CD_462E_9AC3_D4184EABDCD7
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 6ef209d8cf74952bd4ce0455dcafea00534ac9a4e6cdec530742832b0fcefc59
#. default-sha256: 22b034beddc8e643992291d6fee1aa655db986f29611b0d953a8b389545c1f98
msgctxt "scenario9:scenario9_1E9F04AC_24CD_462E_9AC3_D4184EABDCD7"
msgid "⟪k:0⟫And why... ⟪k:1⟫can I not speak?"
msgstr "⟪k:0⟫E por que... ⟪k:1⟫eu não consigo falar?"

#: scenario9:scenario9_FDA1CBD3_AAFE_4D07_AB73_5CB3BF3EE90A
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 368b3980ee9f6800927e4dead33b69303cc7b52509e353e291233f76fa852707
#. default-sha256: bcbf20af9843b7a065f146b8f0432a49148ba3ac74ec1e9f84b2cd57823b5ecd
msgctxt "scenario9:scenario9_FDA1CBD3_AAFE_4D07_AB73_5CB3BF3EE90A"
msgid "⟪k:0⟫I was able to return to this gathering place of souls thanks to your efforts."
msgstr "⟪k:0⟫Eu consegui retornar a este local de encontro de almas graças aos seus esforços."

#: scenario9:scenario9_D024F237_3183_4E5B_BE81_82AD558E0E75
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 454db4091e2e6c6196899d88d929bff4987d9b6ab27fa5c8101504785ab0b99b
#. default-sha256: bea098d136a1e255167f13fad551da3da20b6a8c432d8360cecf847b3b66c6f8
msgctxt "scenario9:scenario9_D024F237_3183_4E5B_BE81_82AD558E0E75"
msgid "⟪k:0⟫But my heart told me I had to do this now."
msgstr "⟪k:0⟫Mas meu coração me disse que eu tinha que fazer isso agora."

#: scenario9:scenario9_74D6CBEA_B305_4027_B19E_4D301A77EACC
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 9f0712eda4eb5f1b5a67c7a8b96521211a0546b43c45b85f97c740dfc0baa2e1
#. default-sha256: 8cb847197ee03c8c605acd06c8bf0ee041f41916a1b5e1e37030574340165449
msgctxt "scenario9:scenario9_74D6CBEA_B305_4027_B19E_4D301A77EACC"
msgid "⟪k:0⟫I have brought you here to ask for your assistance."
msgstr "⟪k:0⟫eu trouxe você aqui para pedir sua ajuda."

#: scenario9:scenario9_6BA1FB6E_E41D_48FA_90FD_50C8BA4E5933
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 6cd324b1de8f6af455d2f3cf845b97850c865cd374c52045dfcff0def1d44c82
#. default-sha256: 2e9117dc1436a3ce76c7dc9f0a03f5d91f1c818576bcd704b7cdb08b3fc67fbc
msgctxt "scenario9:scenario9_6BA1FB6E_E41D_48FA_90FD_50C8BA4E5933"
msgid "⟪k:0⟫take this blade, and with it, extinguish my soul."
msgstr "⟪k:0⟫pegue esta lâmina e com ela extinga minha alma."

#: scenario9:scenario9_46C9FD96_4824_4A8E_B09A_005FD2D06FB3
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: aa8aa03b05e9ab5feba2b092e2e141059003cecd6d18f1e21e24083cb34e26a3
#. default-sha256: e61eabf99ba12a00b4a2f0b4615deebe3d1085bd4e0d1ceffd3a2901bd089e40
msgctxt "scenario9:scenario9_46C9FD96_4824_4A8E_B09A_005FD2D06FB3"
msgid "⟪k:0⟫Because I wanted to save every last person caught in this tragic quagmire."
msgstr "⟪k:0⟫Porque queria salvar cada pessoa presa neste trágico atoleiro."

#: scenario9:scenario9_EB0AB613_6210_4CB4_B8ED_D5CAAEC5535D
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 4588f866a2e255f11394c4e897c15c79e22477133e88756ddc94d221ead30e0f
#. default-sha256: 59918a244e8fe2cee2dd475cdbc4a3dee01383a761074af50059670e655b48c4
msgctxt "scenario9:scenario9_EB0AB613_6210_4CB4_B8ED_D5CAAEC5535D"
msgid ""
"⟪k:0⟫You can’t tell me that after everything you’ve seen...⟪k:1⟫⟪k:2⟫you haven’t realized that I "
"have no place in their lives."
msgstr ""
"⟪k:0⟫Não pode me dizer que depois de tudo que viu...⟪k:1⟫⟪k:2⟫você não percebeu que eu não tenho "
"lugar na vida deles."

#: scenario9:scenario9_B62E9CEB_A857_4BDC_8BC4_DE2D0B129191
