msgstr "⟪k:0⟫Eu deveria ter permanecido dentro de Morgana, como parte dela."

#: scenario9:scenario9_107F121F_562F_4D89_9F82_76A29429BD7B
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 35ccc24a1e77ee2280a6af421fe21e46ad2c84f5b75fec52fb70f75152b39a91
#. default-sha256: b4ea255eb016eaa16591617ee4a543c530287312f1115a165d8c4b05d8dca1ed
msgctxt "scenario9:scenario9_107F121F_562F_4D89_9F82_76A29429BD7B"
msgid "⟪k:0⟫To become one... ⟪k:1⟫was to turn against the laws of the universe."
msgstr "⟪k:0⟫Tornar-se uma... ⟪k:1⟫era se voltar contra as leis do universo."

#: scenario9:scenario9_B3DA77E1_8EE0_4E8D_964B_3B154B0396F5
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: bc5ba8c375e40e955943b903572c42203a0967cb0450669da891873a421c7a65
