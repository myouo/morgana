msgctxt "scenario9:scenario9_68EEC317_9276_4E14_A303_77624A0F3FB5"
msgid ""
"⟪k:0⟫I realize that it’s cruel for me to ask this of you,⟪k:1⟫⟪k:2⟫and for that, I deeply "
"apologize."
msgstr ""
"⟪k:0⟫Eu percebo que é cruel da minha parte pedir isso a você,⟪k:1⟫⟪k:2⟫e por isso, peço profundas "
"desculpas."

#: scenario9:scenario9_148F91BC_E4C1_467E_B6E2_A38C3FA5AEE7
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 0a3e6d2c893ffca2a2d90dc21f246d40460b0747afb044623a685172c4f2cf15
