msgid ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫⟪k:4⟫⟪k:5⟫⟪k:6⟫⟪k:7⟫⟪k:8⟫⟪k:9⟫⟪k:10⟫⟪k:11⟫⟪k:12⟫⟪k:13⟫⟪k:14⟫⟪k:15⟫⟪k:16⟫⟪k:17⟫"
"⟪k:18⟫⟪k:19⟫⟪k:20⟫You⟪k:21⟫The Departed⟪k:22⟫ could not accept the Maid’s offer."
msgstr ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫⟪k:4⟫⟪k:5⟫⟪k:6⟫⟪k:7⟫⟪k:8⟫⟪k:9⟫⟪k:10⟫⟪k:11⟫⟪k:12⟫⟪k:13⟫⟪k:14⟫⟪k:15⟫⟪k:16⟫⟪k:17⟫"
"⟪k:18⟫⟪k:19⟫⟪k:20⟫Você⟪k:21⟫O Falecido⟪k:22⟫ não pôde aceitar a oferta da Criada."

#: badend2:badend2_33A5723D_E91F_4B4B_B3E7_29178B387314
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: f5e3d38d902ab754b1dc1b4b1f67080d2124c2fb92ad5e73537ea99e2f7f71d7
