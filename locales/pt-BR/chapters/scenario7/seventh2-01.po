#: scenario7:scenario7_89A6D2BA_A23B_4F01_B560_DA41FEB41DDD
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 8181760e66a3b8f1bd04e9c61930d841ff7280a50b9f38200700d7b1e8365a7f
#. default-sha256: 1166e9d5d3962767f865a3b69ae909dcf1c0d8b45c0f8ba9dfc6783e342f04ec
msgctxt "scenario7:scenario7_89A6D2BA_A23B_4F01_B560_DA41FEB41DDD"
msgid ""
"⟪k:0⟫Heavy clouds filled the sky, blocking out the sun and giving the impression of late evening "
"all throughout the day."
msgstr ""
"⟪k:0⟫Nuvens pesadas enchiam o céu, bloqueando o sol e dando a impressão de tarde da noite durante "
"o dia todo."

#: scenario7:scenario7_EA98D4F6_2D01_49A2_9CC9_08B6B91AF57B
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 729e74db9ddc23fe143eabcda28a3166c3d7d1afd7e00cd55fefe91fce661dca
#. default-sha256: 3a347a6e0c0eb41b84a74e9b5ae1047f0eb35cc6329eae237522619387f9f4a3
msgctxt "scenario7:scenario7_EA98D4F6_2D01_49A2_9CC9_08B6B91AF57B"
msgid ""
"⟪k:0⟫Which meant I could only go outside on days when the weather made most everyone else gloomy."
msgstr ""
"⟪k:0⟫O que significava que eu só poderia sair nos dias em que o clima deixasse quase todo mundo "
"triste."

#: scenario7:scenario7_62BE9474_951A_4850_AB0B_48F8BF4C4213
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 97a2e2a316ef24cfab2f3cbe5c69ff82d1d2b7b95c7b471437630434dbfae0ea
