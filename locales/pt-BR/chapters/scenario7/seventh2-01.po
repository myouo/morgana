msgid "⟪k:0⟫⟪k:1⟫⟪k:2⟫...?"
msgstr "⟪k:0⟫⟪k:1⟫⟪k:2⟫...?"

#: scenario7:scenario7_43E1C2D0_3F06_485B_BCC9_00626FFF67B2
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 68ac8d5be25f594f2dce8cd39b5ec7f81a283ba5724b6b9ebce0454574f6d988
#. default-sha256: 6685744647108ccf53ffc7bd55fd5ae889968e34c70f112d02249e159fce3d6d
msgctxt "scenario7:scenario7_43E1C2D0_3F06_485B_BCC9_00626FFF67B2"
msgid "⟪k:0⟫A warm breeze blew past, sending up a swirl of flower petals."
msgstr "⟪k:0⟫Uma brisa quente passou, enviando um redemoinho de pétalas de flores."

#: scenario7:scenario7_FE166405_06E9_48C9_B91E_7D545B24CDC6
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 24a48bcb93f99d0a53468411b16c3f2f09f5bbc5615509a63e7472476a5236be
#. default-sha256: c40b3dc51fe78d3f4ac9321c7c9f5c8ce13b53134cdbafd7520463ffd568789a
msgctxt "scenario7:scenario7_FE166405_06E9_48C9_B91E_7D545B24CDC6"
msgid "⟪k:0⟫The girl’s dress hung lightly over her frame, tracing her gentle curves."
msgstr "⟪k:0⟫O vestido da garota pendia levemente sobre seu corpo, traçando suas curvas suaves."

#: scenario7:scenario7_CFB6B5B7_B005_45AD_AEAE_EF9562430783
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: d520ab8a9fdf24705a3a8620d85639cab6959dbcfe5f7bb5d3651006978e8bfe
#. default-sha256: 9154b8ea2b2ffbc93524d139372a4333f7b1d5f424af70fd4a70aa4470876e4f
msgctxt "scenario7:scenario7_CFB6B5B7_B005_45AD_AEAE_EF9562430783"
msgid "⟪k:0⟫⟪k:1⟫And you are?"
msgstr "⟪k:0⟫⟪k:1⟫E você é?"

#: scenario7:scenario7_E59D31B4_85C2_4732_A368_4E4D1F67B857
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 7bdecfb87a0404655f4e9f31adfb9094416cf2f44545dc90741ce8924aae444f
#. default-sha256: a3c693f3f832eb37b857e056fbe6cd40755d8c1db3c85fa3c860406a579c7d1b
msgctxt "scenario7:scenario7_E59D31B4_85C2_4732_A368_4E4D1F67B857"
msgid "⟪k:0⟫⟪k:1⟫My name is Aimee.⟪k:2⟫⟪k:3⟫It’s a pleasure to finally meet you."
msgstr "⟪k:0⟫⟪k:1⟫Meu nome é Aimee.⟪k:2⟫⟪k:3⟫É um prazer finalmente conhecê-la."

#: scenario7:scenario7_F9079209_E85A_47FC_B2FA_F9843BD38D98
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 4c4983e5e8cad9b7131572f9f94bef8c37c87fced41f13ca7e02b6bc368bde41
#. default-sha256: 0768134c872c49e33c7046a1434b943836b7f9f863844bc6528a1d31c53fea8c
msgctxt "scenario7:scenario7_F9079209_E85A_47FC_B2FA_F9843BD38D98"
msgid "⟪k:0⟫she stepped toward me, kissing me softly on the cheek."
msgstr "⟪k:0⟫ela deu um passo em minha direção, beijando-me suavemente na bochecha."

#: scenario7:scenario7_BDFDDAED_DC39_40E0_BAAC_48879F664DE0
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 1b30174893a9dd9cb473cd9004c53b0dd0057b672fbed79f8030ebde4c88f6e7
#. default-sha256: 6727f15c972ab00980612711afd56d51beec92a74ca6d03af3ec22bec3573bcf
msgctxt "scenario7:scenario7_BDFDDAED_DC39_40E0_BAAC_48879F664DE0"
msgid "⟪k:0⟫Electrifyingly sweet."
msgstr "⟪k:0⟫Eletrizantemente doce."

#: scenario7:scenario7_09505D2C_BFC5_4070_A5DF_6C8CB3F33C4C
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 62f759a95f40b140835b53cb473114778153ccd29ea5822f4cc5d7502edace2e
#. default-sha256: 773e0ec4a1e8da5562fb9aec1a0190dae0a7d2cc26dd425699060b17aba8c3f8
msgctxt "scenario7:scenario7_09505D2C_BFC5_4070_A5DF_6C8CB3F33C4C"
msgid "⟪k:0⟫⟪k:1⟫I’m Georges’s fiancée."
msgstr "⟪k:0⟫⟪k:1⟫Eu sou a noiva de Georges."

#: scenario7:scenario7_0CC24CFF_DFBA_42EC_A670_E87AED53CB32
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 493fa511bebd9f3ce9f5720ce7ac68df86b4ee7fdb30a30ca197be8de2a01284
#. default-sha256: f7fd6be5166cca3519a86e41710787bd284d7f54e032c4487078db4a1b2fe1ae
msgctxt "scenario7:scenario7_0CC24CFF_DFBA_42EC_A670_E87AED53CB32"
msgid "⟪k:0⟫And it also"
msgstr "⟪k:0⟫E também"

#: scenario7:scenario7_7FC60674_11DD_464C_AB5F_B4B8A969DD1D
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 76e02b07e7f04694497e66550cd60a1abed1858fb08255d10feb2f416467720c
#. default-sha256: 0c694edfa8ad915025822f065868031f0e9668c9481e7a30548be694f95aa8de
msgctxt "scenario7:scenario7_7FC60674_11DD_464C_AB5F_B4B8A969DD1D"
msgid ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫⟪k:4⟫⟪k:5⟫⟪k:6⟫⟪k:7⟫⟪k:8⟫She was a noble girl by the name of Aimee Joubert. "
"⟪k:9⟫Though only fifteen, she was the very image of refined—⟪k:10⟫⟪k:11⟫polished to a shine."
msgstr ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫⟪k:4⟫⟪k:5⟫⟪k:6⟫⟪k:7⟫⟪k:8⟫Ela era uma garota nobre chamada Aimee Joubert. ⟪k:9⟫"
"Embora tivesse apenas quinze anos, ela era a própria imagem do refinado—⟪k:10⟫⟪k:11⟫polida até "
"brilhar."

#: scenario7:scenario7_CE727012_CD18_480E_AAB1_20A8B589F913
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: c1cd98cf55ff580dfd3a813e17197e01430fb8da7a4685e425625d8a133fb25f
#. default-sha256: 1a593c01609366f33df19c3f95d0e705b8d485d73d98a1bcaeae240ad2228f2e
msgctxt "scenario7:scenario7_CE727012_CD18_480E_AAB1_20A8B589F913"
msgid "⟪k:0⟫It came out of nowhere, ⟪k:1⟫and it seemed I was the only one who didn’t know."
msgstr "⟪k:0⟫Isso surgiu do nada, ⟪k:1⟫e parecia que eu era a única que não sabia."

#: scenario7:scenario7_4C7E4720_9197_41B4_925D_5BAB63DFAD73
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: a65b492416e187b6b845f4e09d59be0aac116bd70f802c4af262cca9d2885968
#. default-sha256: 371a73c356f61bdf3c47a497526698ee5c6383b11f50b3be1e305a65266f1eae
msgctxt "scenario7:scenario7_4C7E4720_9197_41B4_925D_5BAB63DFAD73"
msgid ""
"⟪k:0⟫That evening, when the family gathered around the table for supper, Aimee was there too. "
"⟪k:1⟫And they prepared an extravagant feast for the occasion."
msgstr ""
"⟪k:0⟫Naquela noite, quando a família se reuniu à mesa para jantar, Aimee estava lá também. ⟪k:1⟫E "
"eles prepararam uma festa extravagante para a ocasião."

#: scenario7:scenario7_2451AB79_1AEF_4C56_B230_8116FEE02F34
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 6627eafdd4f12982c81cf8cdacb884a93fd7b7c6ef555e9d9bbebb01cdd31cf6
#. default-sha256: ea4332955f4a6ec55d937a349c0c8f002944d811bcf2bdd5875e071af7f53b48
msgctxt "scenario7:scenario7_2451AB79_1AEF_4C56_B230_8116FEE02F34"
msgid "⟪k:0⟫Mother was pleased to have another girl around."
msgstr "⟪k:0⟫A Mãe estava feliz por ter outra garota por perto."

#: scenario7:scenario7_64269743_0DF3_4D1E_9780_A9512BF3F822
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: e51396594ee32edfb13dbfc70ff260476b00dbcb94f74622059a39b0c44ebc0a
#. default-sha256: 86335b65d58119daf9eb0277ebeaf7c1ebc7e04a803132aa6018c9e6536a28ce
msgctxt "scenario7:scenario7_64269743_0DF3_4D1E_9780_A9512BF3F822"
msgid ""
"⟪k:0⟫Or, more specifically, she was relieved to have found someone other than my brothers for me "
"to spend time with."
msgstr ""
"⟪k:0⟫Ou, mais especificamente, ela ficou aliviada por ter encontrado alguém que não fosse meus "
"irmãos para eu passar um tempo."

#: scenario7:scenario7_AFA09C65_DDDD_4F1D_8E4F_B475801780C8
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: cf699ce35fc18fae4f68d98e491b3f386e8e34885d2d9dd0a617309152dd635a
#. default-sha256: f98fe384fe5e781a225d8a56efaa06a41965c3a081f8e176e50dc2ef591ff7bc
msgctxt "scenario7:scenario7_AFA09C65_DDDD_4F1D_8E4F_B475801780C8"
msgid "⟪k:0⟫I felt much less... ⟪k:1⟫suffocated around her than my mother."
msgstr "⟪k:0⟫Eu me senti muito menos... ⟪k:1⟫sufocada perto dela do que de minha mãe."

#: scenario7:scenario7_FD5E8DB1_8AFB_4E85_A513_2395D28F0324
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 6e225508939d0ac7410cc18c3f505ab1079bbaa490fef91ea6a5db99fcd74d55
#. default-sha256: 3fad9111615e86390202a979ad7f5b648e5d41d0f4a6371a0ba8158f16172a9a
msgctxt "scenario7:scenario7_FD5E8DB1_8AFB_4E85_A513_2395D28F0324"
msgid "⟪k:0⟫A din the likes of which I had never heard in my life filled the great hall."
msgstr "⟪k:0⟫Um barulho como eu nunca tinha ouvido em minha vida encheu o grande salão."

#: scenario7:scenario7_FB6993ED_C256_4432_A9BF_47990377BB60
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 7a1c87d251cd352d515834587c0ca1be3a20f7f95537c7f54162e9522dc4ce9b
#. default-sha256: 86376d2edf6c79b34e05f0a8e42bccd0c299aaaf5bcdefb389fbf04e36566c42
msgctxt "scenario7:scenario7_FB6993ED_C256_4432_A9BF_47990377BB60"
msgid "⟪k:0⟫Everywhere I looked, there were people, people, people."
msgstr "⟪k:0⟫Onde quer que eu olhasse, havia pessoas, pessoas, pessoas."

#: scenario7:scenario7_AE3C5140_E779_4907_BA91_7508DDAFC3DA
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 4cf7fd9cb5230b0e1f07ea69afc0d7c5f966877faf67d114f7ea037e0ca5c24a
#. default-sha256: e85c41857e89f240a4ac27e2b2090adaaa92f5896c28d86f7af4e3758e0d5339
msgctxt "scenario7:scenario7_AE3C5140_E779_4907_BA91_7508DDAFC3DA"
msgid "⟪k:0⟫Voices from all directions."
msgstr "⟪k:0⟫Vozes de todas as direções."

#: scenario7:scenario7_9326FF57_90A9_44C3_9FA6_46CDCF4F59BB
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 479046542333e15dec0c3bbfd46f8ea7566c2e85551f15f8fca4e867c598714c
#. default-sha256: d8053a820658cf86883eb31e90fba3f128a0a7230c5c4b6b7a007a4617066bcc
msgctxt "scenario7:scenario7_9326FF57_90A9_44C3_9FA6_46CDCF4F59BB"
msgid ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫⟪k:4⟫⟪k:5⟫⟪k:6⟫Hey Dee, I feel like we’re critically short on waiters.⟪k:7⟫"
"⟪k:8⟫This don’t look good for us."
msgstr ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫⟪k:4⟫⟪k:5⟫⟪k:6⟫Ei Dee, sinto que estamos com uma séria falta de garçons.⟪k:7⟫"
"⟪k:8⟫Isso não vai soar bem para nós."

#: scenario7:scenario7_4AB296AE_1FCD_47C1_AE8A_959666A52A0A
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 61008bca6b089f89322f9f113621b61c52ad83b30888bc86d30b32af1373f33b
#. default-sha256: 6f848aba54a09a4f3f2b673860dde39e8ed6e64fa1cca2d236ed2ec2fced3daa
msgctxt "scenario7:scenario7_4AB296AE_1FCD_47C1_AE8A_959666A52A0A"
msgid ""
"⟪k:0⟫⟪k:1⟫They’re ⟪k:2⟫artistes⟪k:3⟫ like me. I met them at the court.⟪k:4⟫⟪k:5⟫Let’s see, we "
"have some painters, composers, sculptors, troubadours, poets, writers, you name it."
msgstr ""
"⟪k:0⟫⟪k:1⟫Eles são ⟪k:2⟫artistas⟪k:3⟫ como eu. Eu os conheci na corte.⟪k:4⟫⟪k:5⟫Vejamos, temos "
"alguns pintores, compositores, escultores, trovadores, poetas, escritores, o que você quiser."

#: scenario7:scenario7_371CF7E6_AB99_46C2_A916_9B22E1E37DAB
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: ea3f81cd0052c97428970ea2b25d3aad142b92b9c0b5370e76c2aa9bcf2d2ada
#. default-sha256: e0ed44802de1d34f69f848f87751b55daeda692bfc09d8ef8415c1dad2ab30e6
msgctxt "scenario7:scenario7_371CF7E6_AB99_46C2_A916_9B22E1E37DAB"
msgid "⟪k:0⟫⟪k:1⟫None of them have any connection to the Jouberts ⟪k:2⟫or⟪k:3⟫ Bollingers!"
msgstr "⟪k:0⟫⟪k:1⟫Nenhum deles tem qualquer ligação com os Jouberts ⟪k:2⟫ou⟪k:3⟫ os Bollingers!"

#: scenario7:scenario7_03A91D8F_173E_4C91_B91D_251A71428750
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 7eac0c6a536f681961221cb775efaa8773b7fa2755b21a24d1c3d40d1d7a5746
#. default-sha256: 96201d50a389f08b1c2c9689cbf619cb0ba9da8a9f9dd0052398fbf10d39e76c
msgctxt "scenario7:scenario7_03A91D8F_173E_4C91_B91D_251A71428750"
msgid ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫⟪k:4⟫Off in one corner, several men—⟪k:5⟫⟪k:6⟫presumably Georges’s friends—"
"⟪k:7⟫⟪k:8⟫gathered in a circle."
msgstr ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫⟪k:4⟫Em um canto, vários homens—⟪k:5⟫⟪k:6⟫presumivelmente amigos de Georges—"
"⟪k:7⟫⟪k:8⟫reuniam-se em um círculo."

#: scenario7:scenario7_BBBF8C7F_DC36_4327_B785_C5D10320209F
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: f473abb0ce7ab308de08e864562a160b8d25f68ad7f96c0bce0dafdbe4efe91c
#. default-sha256: 327aeac721a3c06c85d06a8035a21eaa5239878ff91f2b1f49e77abe0d25c12f
msgctxt "scenario7:scenario7_BBBF8C7F_DC36_4327_B785_C5D10320209F"
msgid ""
"⟪k:0⟫They stood out from the other aristocrats, both in appearance and the air they gave off. "
"⟪k:1⟫The clothes they wore. The embroidery hidden beneath their jacket cuffs."
msgstr ""
"⟪k:0⟫Eles se destacavam dos demais aristocratas, tanto na aparência quanto no ar que exalavam. "
"⟪k:1⟫As roupas que usavam. O bordado escondido sob os punhos da jaqueta."

#: scenario7:scenario7_01049DFE_0896_43B2_81A6_1E04BA9F3200
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: b01e04609cc04a17c234e0dea25049df684f2c671b3c62a1b816e55051f78ad5
#. default-sha256: e28e9bc8caa753908f2366aae3f6f89ef599214a16f27e76caf40239f09d7359
msgctxt "scenario7:scenario7_01049DFE_0896_43B2_81A6_1E04BA9F3200"
msgid ""
"⟪k:0⟫Their manner of speech. The way they held themselves. ⟪k:1⟫They were, simply put, a far cry "
"from the hardheaded Didier’s ideal party guests."
msgstr ""
"⟪k:0⟫Sua maneira de falar. A maneira como eles se portaram. ⟪k:1⟫Eles estavam, posto de maneira "
"simples, muito longe dos convidados de festa ideais para o cabeça-dura do Didier."

#: scenario7:scenario7_6B76385C_D544_4488_9F4C_9DA809AEB49F
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 0aa8918f87a59af6f59e8bf49f1bc22b59afcdc167038e70f3e81b966f60bbb7
#. default-sha256: 6edb1a5c6503887c6dcd483c1a8f010f4e59e02c091e781ac3de868ade64e1c9
msgctxt "scenario7:scenario7_6B76385C_D544_4488_9F4C_9DA809AEB49F"
msgid ""
"⟪k:0⟫If they had been strangers, I doubt their paths would cross much—⟪k:1⟫⟪k:2⟫⟪k:3⟫and if they "
"did, those intersections would be quite rocky."
msgstr ""
