#: scenario7:scenario7_BACD08A1_9263_4A2D_8B26_1FF261B8F58D
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 1d887f9eb83168d03d1c11028d3fb7d9413a2730c1cf658935c9e2ffb76392fd
#. default-sha256: 08006fe68c3fd1df0111b51cbcfd6201b80e8821bd6934d288363db14a971d69
msgctxt "scenario7:scenario7_BACD08A1_9263_4A2D_8B26_1FF261B8F58D"
msgid ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫⟪k:4⟫⟪k:5⟫⟪k:6⟫⟪k:7⟫Michelle! Ohh Mich⟪k:8⟫eeee⟪k:9⟫eeeelle! Are you in there?"
msgstr ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫⟪k:4⟫⟪k:5⟫⟪k:6⟫⟪k:7⟫Michelle! Ahh Mich⟪k:8⟫eeee⟪k:9⟫eeeelle! Você está aí?"

#: scenario7:scenario7_FB32878E_3B65_40D1_962A_0B9F5ADBCA69
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 553f983ce3a198e5ab6dc7ee1f75316b57bccfb18d363811816768fe222bdf82
#. default-sha256: 922585efb7c15a85d224faad6c1983edab438ac540fe711a9f7c9676701af060
msgctxt "scenario7:scenario7_FB32878E_3B65_40D1_962A_0B9F5ADBCA69"
msgid "⟪k:0⟫⟪k:1⟫⟪k:2⟫Did you need something, Georges?"
msgstr "⟪k:0⟫⟪k:1⟫⟪k:2⟫Precisa de alguma coisa, Georges?"

#: scenario7:scenario7_A55F8FEF_1AB7_4FE2_986A_3FBBE54321B0
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 2012e8ca21852ce2c993fb923cd2cb36105b1883c0160dab7c014d46b0be09ee
#. default-sha256: 6bf30892ca07bfacf76bbfbafc65e6e85a1a43b95839bb56f39e501612d8f5c7
msgctxt "scenario7:scenario7_A55F8FEF_1AB7_4FE2_986A_3FBBE54321B0"
msgid ""
"⟪k:0⟫⟪k:1⟫Oh, c’mon, don’t be like that.⟪k:2⟫⟪k:3⟫Do I have to “need something” to talk to you?"
msgstr ""
"⟪k:0⟫⟪k:1⟫Ah, vamos lá, não seja assim.⟪k:2⟫⟪k:3⟫Tenho que “precisar de algo” para falar com você?"

#: scenario7:scenario7_3ED6DA89_DABD_4E8E_A636_8C03D240695F
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 0f543b16e0b1694e107a90d3b6a455303ed872c7f053ab41b5bbeab3c49d8458
#. default-sha256: 061d2ec2892428f8b4c842e0de2f9d11280058509afc0ddaff79870f563d117b
msgctxt "scenario7:scenario7_3ED6DA89_DABD_4E8E_A636_8C03D240695F"
msgid ""
"⟪k:0⟫⟪k:1⟫N-⟪k:2⟫No, but you looked like you were in an unusually good mood,⟪k:3⟫so I thought..."
msgstr ""
"⟪k:0⟫⟪k:1⟫N-⟪k:2⟫Não, mas você parecia estar com um humor excepcionalmente bom, então eu pensei..."

#: scenario7:scenario7_CF12D587_2FF9_4EE4_991C_31AAEB65C73E
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: d7cc98b9611826a14cc3b3c319a4bb784062b38029188c1301f0a78ca3fd7b1b
#. default-sha256: 491fafc1b0253264a7283e28b55af20b5137af6218e6825e645a8fa10785c702
msgctxt "scenario7:scenario7_CF12D587_2FF9_4EE4_991C_31AAEB65C73E"
msgid "⟪k:0⟫⟪k:1⟫Well, why wouldn’t I be?⟪k:2⟫⟪k:3⟫It’s a wonderfully gloomy day out!"
msgstr ""
"⟪k:0⟫⟪k:1⟫Bem, por que eu não estaria?⟪k:2⟫⟪k:3⟫Está um dia maravilhosamente sombrio lá fora!"

#: scenario7:scenario7_B074DBC1_FA01_4CC8_954A_6C085E79F2EC
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 4785cd71f46f2a4ec42499bd735a5bc68c796d3f55d9a742e59062312594e542
#. default-sha256: b10d82a68a4d62c3150b0936b91ec0a6453ec8e4e51fd231ecb20cc3c4dfeb9e
