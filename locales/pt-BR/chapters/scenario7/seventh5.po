msgid "⟪k:0⟫⟪k:1⟫............"
msgstr "⟪k:0⟫⟪k:1⟫............"

#: scenario7:scenario7_2F81EBB3_F8A2_41F0_93EE_05BA4326A48B
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 515dc3ebede6307e95faf9e7695e089d7d78fd7216d025abb23737477df7b166
#. default-sha256: 672662529e6f1af62e3b4871a64d0ce57af8d05a7bca332a8cb2e39bea882d56
msgctxt "scenario7:scenario7_2F81EBB3_F8A2_41F0_93EE_05BA4326A48B"
msgid ""
"⟪k:0⟫⟪k:1⟫I would understand if it were clear out...⟪k:2⟫⟪k:3⟫but can you really say it’s "
"“wonderfully” gloomy?"
msgstr ""
"⟪k:0⟫⟪k:1⟫Eu entenderia se estivesse claro...⟪k:2⟫⟪k:3⟫mas realmente dá para dizer que é "
"“maravilhosamente” sombrio?"

#: scenario7:scenario7_DFA0EF82_350D_475B_8014_D38E3E4E9C6F
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 7c9f3a27632a6f9d02ad2e94a16b1b417d466736a979431c05ebd34617f5fbcb
#. default-sha256: 05044608a059097deb432d3fcb366e3bd0484d4b6d858ce1598fb9eeda3a1acb
msgctxt "scenario7:scenario7_DFA0EF82_350D_475B_8014_D38E3E4E9C6F"
msgid ""
"⟪k:0⟫⟪k:1⟫Well, you can’t be outside for very long when it’s not cloudy, so in our case, this is "
"perfect weather."
msgstr ""
"⟪k:0⟫⟪k:1⟫Bem, você não pode ficar muito tempo ao ar livre quando não está nublado, então, no "
"nosso caso, este é o clima perfeito."

#: scenario7:scenario7_E1821575_CA6E_403F_8D30_4330B21534A6
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: d6d63f8d5b95b010c20eab257e0113dee6788fb95cfef7ca24af3fbb990b2cb3
#. default-sha256: c9de2df8c36868adafc2eb1b0ab01e94d2f7404dacab36d2465d743f6c505ba6
msgctxt "scenario7:scenario7_E1821575_CA6E_403F_8D30_4330B21534A6"
msgid "⟪k:0⟫⟪k:1⟫Ah..."
msgstr "⟪k:0⟫⟪k:1⟫Ah..."

#: scenario7:scenario7_C01E4773_3075_4DCE_B133_8C7266956346
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 6f5c0f94be697babe3bacd6a5fae376121be268bbf0e03c960e4a7856f21fcc5
#. default-sha256: a18d7ef9e44b906fa251d6844c1fb8af5d8b4947b4df5d473c41651428521a1f
msgctxt "scenario7:scenario7_C01E4773_3075_4DCE_B133_8C7266956346"
msgid ""
"⟪k:0⟫⟪k:1⟫What do you say we go for a little stroll, while we can?⟪k:2⟫⟪k:3⟫Dee’s around today "
"too, so we can see if he’s up for it.⟪k:4⟫⟪k:5⟫It’ll be like old times."
msgstr ""
"⟪k:0⟫⟪k:1⟫O que você acha de darmos uma voltinha enquanto podemos?⟪k:2⟫⟪k:3⟫Dee também está por "
"aqui hoje, então podemos ver se ele está afim.⟪k:4⟫⟪k:5⟫Será como nos velhos tempos."

#: scenario7:scenario7_9406F46A_7FED_421F_A304_80D3F5789C3F
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: b69a5abb639f0289bc3f3e3c062b5e65b187b9293911c17f7f658eed9648c0fd
#. default-sha256: dce7b6e6bc73aa4cc54a4a24aa2367e61066dbd28c7454f305fc93cf214aa4db
msgctxt "scenario7:scenario7_9406F46A_7FED_421F_A304_80D3F5789C3F"
msgid ""
"⟪k:0⟫⟪k:1⟫We’ve been running around like headless chickens lately,⟪k:2⟫so we haven’t had much of "
"a chance for a sibling outing.⟪k:3⟫⟪k:4⟫We’ll have Mom make us a lunch, and then—"
msgstr ""
"⟪k:0⟫⟪k:1⟫Ultimamente temos corrido para lá e para cá,⟪k:2⟫então não tivemos muitas oportunidades "
"de um passeio entre irmãos.⟪k:3⟫⟪k:4⟫Vamos pedir para a Mãe preparar um almoço para nós e depois—"

#: scenario7:scenario7_2086E62F_87B2_47C7_B186_8D57CAE02078
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 4e90c72a7fe149e9902d2501bcc667dcae46990487c2d11ed437240e470dd52d
#. default-sha256: 7305b02ac0edfdb7f053a99352b3a3a856fb86e4aaf37df14100d0bf82e56ee4
msgctxt "scenario7:scenario7_2086E62F_87B2_47C7_B186_8D57CAE02078"
msgid "⟪k:0⟫⟪k:1⟫Ooh, we’ll take a couple horses up to the forest’s edge!"
msgstr "⟪k:0⟫⟪k:1⟫Aah, iremos com os cavalos até a orla da floresta!"

#: scenario7:scenario7_AB202D56_42D8_44B8_855B_BA820064EA7D
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 854af47b2d9034462a18bbe4ea51cd503ace4ce71a70aadcb0447e69f0e29dbe
#. default-sha256: aac4b4c6cd55ae08d37699c7fb21589cb99862fa2bdcc3ab0f8e0dede1f1473b
msgctxt "scenario7:scenario7_AB202D56_42D8_44B8_855B_BA820064EA7D"
msgid "⟪k:0⟫⟪k:1⟫I-⟪k:2⟫I’m fine with that if you are."
msgstr "⟪k:0⟫⟪k:1⟫E-⟪k:2⟫Está bom para mim se estiver para você."

#: scenario7:scenario7_1CC04FBE_D7D3_499E_8D23_9241BEE32370
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 3f5fa5bfe10518034e352f356527ffccd37dfdeb8edabaa7ba16ba557086e301
#. default-sha256: bcedebcd65fbf6238b598e63da0e643efee859b3777e6f01b24ec3e0791fd621
msgctxt "scenario7:scenario7_1CC04FBE_D7D3_499E_8D23_9241BEE32370"
msgid "⟪k:0⟫⟪k:1⟫You bet your bum I am. I asked, after all!⟪k:2⟫⟪k:3⟫Now c’mon, let’s go!"
msgstr "⟪k:0⟫⟪k:1⟫Pode apostar que sim. Eu que perguntei, afinal!⟪k:2⟫⟪k:3⟫Agora bora, vamos lá!"

#: scenario7:scenario7_34D266ED_1135_4E45_9C31_EA6D46852228
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 16a07920801ad9bbea60cbc2d96dd01710033c1dc3a6442645b581ddbaa8c8e9
#. default-sha256: 4dc975358b28e2bcb7a897a0a03c907d1d07beffa8728058923d25e72c6d4c29
msgctxt "scenario7:scenario7_34D266ED_1135_4E45_9C31_EA6D46852228"
msgid "⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫⟪k:4⟫⟪k:5⟫⟪k:6⟫⟪k:7⟫An outing, you say?"
msgstr "⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫⟪k:4⟫⟪k:5⟫⟪k:6⟫⟪k:7⟫Um passeio, você diz?"

#: scenario7:scenario7_54C4A907_7278_42D2_914B_8485A57F286B
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 5f2a977694dd94f110e99233466b00b1fb654473bb4f094a48ef67b8054d0d04
#. default-sha256: 9bbc5dccb6c31f0c039f202bba5c843b317178ba3e5daf43b4a16976b178e766
msgctxt "scenario7:scenario7_54C4A907_7278_42D2_914B_8485A57F286B"
msgid ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫Yepyep. Hop on a couple horses and head for the forest.⟪k:3⟫⟪k:4⟫We haven’t done "
"this in a while, so I figured why not."
msgstr ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫Aham aham. Montar em alguns cavalos e ir para a floresta.⟪k:3⟫⟪k:4⟫Já faz um tempo "
"que não fazemos isso, então pensei: por que não."

#: scenario7:scenario7_C7FE1404_21B8_4AFB_ACBC_CE0D1EBB2D6E
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 5b50efd81b9c75d92103ebfb1cbb7637d69c867376dbcc470ada6eea6da2f4b2
#. default-sha256: a27de533b091767b95f14c38eddf8101d6cb28af10d3f8ed0e0bcd25d6502330
msgctxt "scenario7:scenario7_C7FE1404_21B8_4AFB_ACBC_CE0D1EBB2D6E"
msgid ""
"⟪k:0⟫⟪k:1⟫I see. Well, if Michelle is coming, I see no reason to say no.⟪k:2⟫⟪k:3⟫Let’s set off "
"right away."
msgstr ""
"⟪k:0⟫⟪k:1⟫Entendo. Bem, se Michelle está indo, não vejo razão para dizer não.⟪k:2⟫⟪k:3⟫Vamos "
"partir imediatamente. "

#: scenario7:scenario7_0439C8F3_C6DE_422D_BA4F_F3A310E5967F
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: b3f028c225f754c5192c14c640a68161ade8fe99139271336e1d1644d836171f
#. default-sha256: abfec69a60fa2a2a9837454fb627a9082e298c17813def06fb19911a8fede008
msgctxt "scenario7:scenario7_0439C8F3_C6DE_422D_BA4F_F3A310E5967F"
msgid ""
"⟪k:0⟫⟪k:1⟫Whoa, whoa, slow down there.⟪k:2⟫⟪k:3⟫Are you saying you wouldn’t go if it was just me?"
"⟪k:4⟫⟪k:5⟫It’s Michelle or nothing?"
msgstr ""
"⟪k:0⟫⟪k:1⟫Opa, opa, devagar aí.⟪k:2⟫⟪k:3⟫Você está dizendo que não iria se fosse só eu?⟪k:4⟫⟪k:5⟫"
"É Michelle ou nada?"

#: scenario7:scenario7_8DF16205_0566_4025_B2D9_528D1AA14340
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 8a40cb7dc578d509fd17f8bca8e393b22455c8491c348cee7936e90462234c3d
#. default-sha256: 5d62f31fcf69d7c13f98d14fae94975ee06d011e587c2260bfd61e3cf95cb338
msgctxt "scenario7:scenario7_8DF16205_0566_4025_B2D9_528D1AA14340"
msgid ""
"⟪k:0⟫⟪k:1⟫Of course. Why on earth would I want to go horse-riding alone with you? ⟪k:2⟫I would "
"rather drown myself."
msgstr ""
"⟪k:0⟫⟪k:1⟫Claro. Por que diabos eu iria querer andar a cavalo sozinho com você? ⟪k:2⟫Eu "
"preferiria me afogar. "

#: scenario7:scenario7_D6BBF839_251E_423D_AD38_1E3477201973
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 430f30096dd643648a65d4938c5a77f0833d3d0d2f629e82960936ffd38940f8
#. default-sha256: f47b08849ef83bad3a64f8a3f5a4239f71c1efc380dec057781fc2be105e46e3
msgctxt "scenario7:scenario7_D6BBF839_251E_423D_AD38_1E3477201973"
msgid "⟪k:0⟫⟪k:1⟫⟪k:2⟫LE GAAAAAAAAAAAAAAAASP!"
msgstr "⟪k:0⟫⟪k:1⟫⟪k:2⟫LE GAAAAAAAAAAAAAAAASP!"

#: scenario7:scenario7_F4B2BA61_62B5_4150_BFC7_104328D10817
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: aee93825782ae20b4316205d7fc7d2247bff00557fc07864386afca3b70bef42
#. default-sha256: e0d855250022f5a39f2673c6987b2039bc6e8e64cccf5c68c2b9899f4657886c
msgctxt "scenario7:scenario7_F4B2BA61_62B5_4150_BFC7_104328D10817"
msgid "⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫Um, Didier... ⟪k:4⟫could I, perhaps, make a small request?"
msgstr "⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫Hum, Didier... ⟪k:4⟫posso, talvez, fazer um pequeno pedido?"

#: scenario7:scenario7_D5201F50_0026_463D_ACA6_0B41AE96A802
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 7d15a9112094f5c66553ae76f1c987b1e2b297a89606d880424f77dcd31b2ad6
#. default-sha256: 58dbf6a5d0f5323d953f55214869f52336172cece367e6c0f7a62d1e239156cc
msgctxt "scenario7:scenario7_D5201F50_0026_463D_ACA6_0B41AE96A802"
msgid "⟪k:0⟫⟪k:1⟫Go on, let’s hear it."
msgstr "⟪k:0⟫⟪k:1⟫Vamos lá, vamos ouvir."

#: scenario7:scenario7_50A8EFA1_E5B5_46CF_BAFF_2E5A5D2666AC
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 82fb641a38d4087df0a817d5d764be858c804c22b7a0d93068bd2379492f4f4b
#. default-sha256: e1e20ba33a17b7eaf8c484c623902979e351717a390b25fc2dd5251de85a7019
msgctxt "scenario7:scenario7_50A8EFA1_E5B5_46CF_BAFF_2E5A5D2666AC"
msgid "⟪k:0⟫⟪k:1⟫Do you mind if I... ⟪k:2⟫hold the horse’s reins?"
msgstr "⟪k:0⟫⟪k:1⟫Você se importa se eu... ⟪k:2⟫segurar as rédeas do cavalo?"

#: scenario7:scenario7_CD4C7EE4_B103_480B_8DB0_1A19F8854021
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 537641004538f6a31e6d56f74c870eb0b1c8b20f25c1236a0b7ce4c053f1fe54
#. default-sha256: fcc93482ed27ad572b6e2cfd03a3b84463a44facbe3234d76426d6fcad0fa3ab
msgctxt "scenario7:scenario7_CD4C7EE4_B103_480B_8DB0_1A19F8854021"
msgid ""
"⟪k:0⟫⟪k:1⟫Oh, that’s all? By all means.⟪k:2⟫⟪k:3⟫I’ll be there behind you to make sure nothing "
"happens, so have at it."
msgstr ""
"⟪k:0⟫⟪k:1⟫Ah, é só isso? Claro que sim.⟪k:2⟫⟪k:3⟫Estarei atrás de você para garantir que nada "
"aconteça, então vá em frente. "

#: scenario7:scenario7_FE8E2917_B186_4CDB_AABC_5C3944D5B965
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: e9f2dd75f49308cc5edf43f4e031adc0e8b390d75b08a39f7bbfa850172cc0b8
#. default-sha256: eb8afc31d6d77abfc1989b9fcb3b533502d567ebb2483437ce27932744d19bc9
msgctxt "scenario7:scenario7_FE8E2917_B186_4CDB_AABC_5C3944D5B965"
msgid ""
"⟪k:0⟫⟪k:1⟫But do be warned, my horse is a bit temperamental.⟪k:2⟫⟪k:3⟫If you’re not gentle, he’ll "
"start getting moody with you."
msgstr ""
