msgid "⟪k:0⟫And then there was me, the youngest—⟪k:1⟫⟪k:2⟫the only daughter."
msgstr "⟪k:0⟫E então havia eu, a mais nova—⟪k:1⟫⟪k:2⟫a única filha."

#: scenario7:scenario7_6C9D1053_1A98_4762_893E_69AFE856DEBF
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 2a6206b97ae9dc048da7b17f187acdd87a7dcc22d1f52c0f68025d721285ca4d
