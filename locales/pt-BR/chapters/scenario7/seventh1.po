msgctxt "scenario7:scenario7_A2D05211_ACC3_49DB_89DB_EEDF7A9D8979"
msgid "⟪k:0⟫Didier played chess with me, and Georges taught me how to draw."
msgstr "⟪k:0⟫Didier jogava xadrez comigo e Georges me ensinou a desenhar."

#: scenario7:scenario7_638139D8_135C_4AAA_86B3_F046485B7999
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 3df1a402ce539901de3045b79ebadb340bfc1eddef8ceda16c392b7f582a6e6f
