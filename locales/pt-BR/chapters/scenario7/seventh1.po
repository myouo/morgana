msgid ""
"⟪k:0⟫If I had been told I couldn’t do it because I lacked the strength,⟪k:1⟫I probably would have "
"accepted it."
msgstr ""
"⟪k:0⟫Se me dissessem que não podia porque me faltava a força,⟪k:1⟫eu provavelmente teria aceitado."

#: scenario7:scenario7_7C983434_7E1C_4DA1_979E_74604548F401
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: d7661928d0c0da53f013be30702647a9e404a9c611f2947678379c0a6594f200
#. default-sha256: 76c831190deca59921df41aba2906d385e3b9e733cbebe68ac069cf259875342
msgctxt "scenario7:scenario7_7C983434_7E1C_4DA1_979E_74604548F401"
msgid "⟪k:0⟫But the reason given was not that I was weak—⟪k:1⟫but that I was a girl."
msgstr "⟪k:0⟫Mas a razão dada não era que eu era fraca—⟪k:1⟫mas que eu era uma menina."

#: scenario7:scenario7_600D3ABE_49B0_4D6B_9593_986056A7D486
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
