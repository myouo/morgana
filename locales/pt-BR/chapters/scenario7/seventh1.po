msgctxt "scenario7:scenario7_F6FD7D33_A16B_4BEE_9AA7_52A0128B576F"
msgid "⟪k:0⟫The eldest, Didier, belonged to an order of knights that served the Church."
msgstr "⟪k:0⟫O mais velho, Didier, pertencia a uma ordem de cavaleiros que serviam a Igreja."

#: scenario7:scenario7_5CE21799_E4B2_4AA3_AFB1_271B4FB2579C
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 25b5c49180f5bde89fa8a258188f9c4eee0282cd601d7738cf35da08432343ec
