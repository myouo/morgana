msgid "⟪k:0⟫⟪k:1⟫You were at it for a long time."
msgstr "⟪k:0⟫⟪k:1⟫Você está bastante tempo nisso."

#: scenario7:scenario7_A0DBDD17_4A04_49B0_BAE8_A7578E73066D
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 0253cdf5a113b2687e3f5ebb389b29bae8406110ea64e906895061d3505ba3e4
