msgctxt "scenario7:scenario7_22C434B2_4CF3_4B38_B305_E352B14E7470"
msgid "⟪k:0⟫While hardly anything unusual, it bothered me deeply."
msgstr "⟪k:0⟫Embora nada incomum, isso me incomodava profundamente."

#: scenario7:scenario7_9DA2CE17_6D52_4AD7_8BE6_7554BB814987
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: daa4c7265f36265095910769bee5ecd79fa0f3411bab7fbf870e45886f550399
