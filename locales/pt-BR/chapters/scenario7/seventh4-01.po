#: scenario7:scenario7_2917C442_2C2F_4A42_8209_D81D50F57791
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 188ff5cca5def5affa16de337d250ac270d68438647c420f0ebb3148ab4dce6a
#. default-sha256: 8d890e24a6f1d8e07c2ec1d7c35887774292466d112ea183262fe7ebf1043e07
msgctxt "scenario7:scenario7_2917C442_2C2F_4A42_8209_D81D50F57791"
msgid ""
"⟪k:0⟫The only time the routine changed was when, on occasion, a servant would arrive bearing a "
"letter."
msgstr ""
"⟪k:0⟫A única vez que a rotina mudou foi quando, ocasionalmente, um criado chegou trazendo uma "
"carta."

#: scenario7:scenario7_A27261B4_309E_4583_92FE_6917A44D1D9F
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 830e4bb55904fe270879cbb0a062bb41908f992bba739c6c2e981dd7e41a6b5f
#. default-sha256: 8cd34737d045e758c0fa241c5ebf234ca00b215d17bd5a3cf4541bfa21e03c57
msgctxt "scenario7:scenario7_A27261B4_309E_4583_92FE_6917A44D1D9F"
msgid "⟪k:0⟫She demanded I speak like a girl, and I didn’t have the strength to defy her."
msgstr "⟪k:0⟫Ela exigia que eu falasse como uma menina, e eu não tinha forças para desafiá-la."

#: scenario7:scenario7_7019A919_831D_4189_B094_0BF9750DBEAA
