msgctxt "scenario7:scenario7_2B06C58F_460D_4798_B82E_E24EB9845EA2"
msgid "⟪k:0⟫But I marched for the tower, unconcerned."
msgstr "⟪k:0⟫Mas eu marchei para a torre, despreocupado."

#: scenario7:scenario7_923AF344_9FE7_4626_B420_7B87C0EBD422
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 8447ef55da0ff8d8bc152e8f0138ef0a4b6f2eb6544b5ca4f28478eadc670c35
