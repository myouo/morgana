msgid "⟪k:0⟫Thank you... ⟪k:1⟫for opening the door."
msgstr "⟪k:0⟫Obrigado... ⟪k:1⟫por abrir a porta."

#: scenario7:scenario7_D7BF15E8_BDB8_49BE_9389_3050755E9FC2
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 4e8b30325ff4b1473fdc2acf36de9d41caee96384d6c6826e2a01055d327b316
#. default-sha256: 35ce44bf90f3230f0956d70572f333d5c88d50a0affaecc5d2c13e3f7d54e10a
msgctxt "scenario7:scenario7_D7BF15E8_BDB8_49BE_9389_3050755E9FC2"
msgid ""
"⟪k:0⟫The skeleton, which had been sitting there as long as I had been at this house, had vanished "
"without a trace."
msgstr ""
"⟪k:0⟫O esqueleto, que estava ali desde que cheguei a esta casa, desapareceu sem deixar vestígios."

#: scenario7:scenario7_C1990B51_6F38_4EE4_9AB4_3AA0E740A217
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 5292c2c4bff95d091fed4637900eff89953cbb200618796b989d778487e1932d
#. default-sha256: 4eb752d6a0a4216c4c37ba71dc2ac323f23e8fdec69c615c98b919db303c6416
msgctxt "scenario7:scenario7_C1990B51_6F38_4EE4_9AB4_3AA0E740A217"
msgid ""
"⟪k:0⟫I spun around, my gaze darting back and forth across the chamber,⟪k:1⟫but there was no one "
"there—"
msgstr ""
"⟪k:0⟫Eu me virei, meu olhar disparando de um lado para o outro na câmara,⟪k:1⟫mas não havia "
"ninguém lá—"

#: scenario7:scenario7_3717CEB8_6B08_4EF7_A689_0AE58EACA40A
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: f93adb5f1a2d9194af19824032346b8c0172a115385b049fd40ff4ccbdd211b1
#. default-sha256: 5048d4e903db2816a6b385454c85bf74b06026fde2c91186c724c41384a922b3
msgctxt "scenario7:scenario7_3717CEB8_6B08_4EF7_A689_0AE58EACA40A"
msgid "⟪k:0⟫⟪k:1⟫You gave me the chance to have my revenge."
msgstr "⟪k:0⟫⟪k:1⟫Você me deu a chance de ter minha vingança."

#: scenario7:scenario7_5C785F31_06F7_4173_9DE7_2858777CFD91
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
