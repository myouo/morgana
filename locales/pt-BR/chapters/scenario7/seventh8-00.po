#: scenario7:scenario7_E057D1CB_B59B_439E_AE89_1CA6201F6CE0
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 001aa029995497bafd17c55ca7b1a8fad5ebf27253c301c9f3706bb69a2bbb1c
#. default-sha256: b8ff64cc207f9488837abfa6cf4edcc76bdfbfcc3ab0eeb2ce39ec461c13f8a5
msgctxt "scenario7:scenario7_E057D1CB_B59B_439E_AE89_1CA6201F6CE0"
msgid "⟪k:0⟫Oh, you poor dear. They locked you up here without telling you whose house it was?"
msgstr "⟪k:0⟫Oh, pobrezinho. Eles te trancaram aqui sem te dizer de quem era a casa?"

#: scenario7:scenario7_D110955E_8C94_4B5F_8B3B_023D2D661687
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: edcfe1921386bde1db2916ea2a91216ccee28ed185722667fec15802b39e1fed
#. default-sha256: f2a2d2747675b7245e1cf5f3ecd5cc380061e053b723ce2efccffc444819ff5d
msgctxt "scenario7:scenario7_D110955E_8C94_4B5F_8B3B_023D2D661687"
msgid "⟪k:0⟫You sad, pathetic thing...⟪k:1⟫⟪k:2⟫Though that’s exactly the kind of person I needed."
msgstr ""
"⟪k:0⟫Sua coisa triste e patética...⟪k:1⟫⟪k:2⟫Embora esse seja exatamente o tipo de pessoa de que "
"eu precisava."

#: scenario7:scenario7_021FDB46_4407_4465_A38D_7CB739227033
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: f935cd82188476032e632ebb1d293725110f327418c7d88a2e93d868f476a97c
#. default-sha256: 0ae06ab076829ef76376d9a24ed7bf8709034e7631a43e0f86d2ab7acc1e7569
msgctxt "scenario7:scenario7_021FDB46_4407_4465_A38D_7CB739227033"
msgid "⟪k:0⟫You’re... ⟪k:1⟫You’re not the witch, are you...?"
msgstr "⟪k:0⟫Você... ⟪k:1⟫Você não é a bruxa, é...?"

#: scenario7:scenario7_628FA3F9_73B9_45FC_9FBF_59CF1C8441D7
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: f2f6a91ffda10b74aca4067c691339888d023802355b597efd07a9078f1158d9
#. default-sha256: a46a442d26e19edecfa0b1216f5dd512040f4325cb093b7d34567a9f5b1ef3e0
msgctxt "scenario7:scenario7_628FA3F9_73B9_45FC_9FBF_59CF1C8441D7"
msgid "⟪k:0⟫I assumed... ⟪k:1⟫the witch was nothing but a legend. A tale..."
msgstr "⟪k:0⟫Eu presumi... ⟪k:1⟫que a bruxa não era nada além de uma lenda. Um conto..."

#: scenario7:scenario7_AD899BFA_FFBD_4B11_9952_AADF7BCE7E87
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 35ba3f33a371f12ffdfe6a0df9110ec5b7edd43b83a2701d4081d7158287d9f5
#. default-sha256: 7b5893c88c2e6d4fb48d8ff8a8218235179cb38931b97757451b386a99a5afa6
msgctxt "scenario7:scenario7_AD899BFA_FFBD_4B11_9952_AADF7BCE7E87"
msgid "⟪k:0⟫If you don’t believe me, I would be happy to show you.⟪k:1⟫⟪k:2⟫Let’s see..."
msgstr "⟪k:0⟫Se você não acredita em mim, ficarei feliz em lhe mostrar.⟪k:1⟫⟪k:2⟫Vamos ver..."

#: scenario7:scenario7_2285AF59_5718_4557_B850_3FC210CA1C53
