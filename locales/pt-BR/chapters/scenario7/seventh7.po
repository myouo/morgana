msgctxt "scenario7:scenario7_90291295_72F6_4C51_BFC6_381BD6CEF353"
msgid "⟪k:0⟫Darkness cuffs my hands and legs, restricting my movement."
msgstr "⟪k:0⟫A escuridão algema minhas mãos e pernas, restringindo meus movimentos."

#: scenario7:scenario7_2AD5BC36_5471_4DAF_8C37_9DDE094511FD
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: fe56dd425330bd50bf7ab1a92b009ee31573b14941ca81460c5f86e2e5ccc196
#. default-sha256: e7d92d2983ec19855529cd9b1b0b4217047caef5dc7ad65d6de6212590405992
msgctxt "scenario7:scenario7_2AD5BC36_5471_4DAF_8C37_9DDE094511FD"
msgid "⟪k:0⟫Images of the past I had kept buried away for so long stream past me."
msgstr "⟪k:0⟫Imagens do passado que eu havia mantido enterradas por tanto tempo passam por mim."

#: scenario7:scenario7_BA656386_6B5A_407B_A461_559136048884
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 412a4b2a414bf32c85ae803143b8aee9b0d4edd049ca5c311a07b0dd226e5317
