msgid "⟪k:0⟫⟪k:1⟫⟪k:2⟫............"
msgstr "⟪k:0⟫⟪k:1⟫⟪k:2⟫............"

#: scenario7:scenario7_DCE13B0D_57E6_4B52_AB7E_7C8D7DD09A97
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 0ed52232aca10051f06147f143dd3279bb0955d808ee4566f57699e2eb98c5c4
#. default-sha256: 8af86891b23278a20883c212297df145f91a964f748cc03dfe8d71ee56f3dec5
msgctxt "scenario7:scenario7_DCE13B0D_57E6_4B52_AB7E_7C8D7DD09A97"
msgid ""
"⟪k:0⟫Looking at them, I couldn’t help but remember the old days.⟪k:1⟫⟪k:2⟫Playing chess with "
"Didier. Learning to draw from Georges."
msgstr ""
"⟪k:0⟫Olhando para eles, não pude deixar de lembrar dos velhos tempos.⟪k:1⟫⟪k:2⟫Jogando xadrez com "
"Didier. Aprendendo a desenhar com Georges."

#: scenario7:scenario7_8D7B438A_C041_426F_B20E_4A9733C9449D
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 782350e9d9dd97dd2499e368caa7a408400c746410ec10314926ef5824cac6c3
#. default-sha256: 3378b031641dea20533e085fbae0ea67e26301826a157396116481c8dd797210
msgctxt "scenario7:scenario7_8D7B438A_C041_426F_B20E_4A9733C9449D"
msgid "⟪k:0⟫Our sibling outings."
msgstr "⟪k:0⟫Nossos passeios entre irmãos."

#: scenario7:scenario7_D803BB77_22AB_475F_8509_A45EEB5F5B91
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 4b206c83dd146d465516ce581323f0ce4b88228c397813d636808e716206bee4
#. default-sha256: 832377d9164603e71ef2c511ab3a088415588ee3e1421d0b8791787ca308dac5
msgctxt "scenario7:scenario7_D803BB77_22AB_475F_8509_A45EEB5F5B91"
msgid ""
"⟪k:0⟫However, the ominous sound of thunder crashing in the distance drowned out those memories."
msgstr "⟪k:0⟫No entanto, o som sinistro do estrondo do trovão à distância abafou essas memórias."

#: scenario7:scenario7_FCE8D84B_D01C_402F_B4D3_4CC436757271
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: c3e504b435b2f3eb78d328eebc6cf3a93035d59be4282ff3952856cabaf1dca3
#. default-sha256: 51a0b574d12de2f5f345235ef7c96e67fc2ec250a56b56cb31a36842b242ca54
msgctxt "scenario7:scenario7_FCE8D84B_D01C_402F_B4D3_4CC436757271"
msgid ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫The mansion is several days’ travel from here.⟪k:3⟫⟪k:4⟫Hopefully the carriage "
"isn’t too uncomfortable."
msgstr ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫A mansão fica a vários dias de viagem daqui.⟪k:3⟫⟪k:4⟫Espero que a carruagem não "
"seja muito desconfortável."

#: scenario7:scenario7_89F3AA26_DF35_434A_8F40_DF2869E9AD99
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 349a8ffff6d644aaf6240df58ef13afe7681e7df31381ee41fc97faa4b8f885f
