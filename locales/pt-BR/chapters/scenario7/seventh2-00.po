msgctxt "scenario7:scenario7_33EABD98_BC03_4C5B_A81A_10244168B25D"
msgid "⟪k:0⟫As I was meandering through the courtyard,"
msgstr "⟪k:0⟫Enquanto eu vagava pelo pátio,"

#: scenario7:scenario7_47DE9F2F_B236_42A3_8344_89543D58A343
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: daed04a8bb4096195a21062f9088b9bcde19f729999ec6ae07ef246fee9db940
#. default-sha256: 225ce014f3830938c8f6001e02481f28f12b20193ac6301c0748e6e0eaad13ea
msgctxt "scenario7:scenario7_47DE9F2F_B236_42A3_8344_89543D58A343"
msgid "⟪k:0⟫⟪k:1⟫⟪k:2⟫I spotted someone I had never seen before."
msgstr "⟪k:0⟫⟪k:1⟫⟪k:2⟫vi alguém que eu nunca tinha visto antes."

#: scenario7:scenario7_7A0FC6F3_CC1D_4374_8C85_9A990957566C
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 2fad645b7832b1c6507147b9af5c6e422ba4ceaf499ed9af354cb8095195c844
#. default-sha256: dafaf0784c97a5146c36fb72bdf1091a89d25bb18532d3ec2269cde8b52e58c0
msgctxt "scenario7:scenario7_7A0FC6F3_CC1D_4374_8C85_9A990957566C"
msgid "⟪k:0⟫⟪k:1⟫...Who are you?"
msgstr "⟪k:0⟫⟪k:1⟫...Quem é você?"

#: scenario7:scenario7_55F98633_ED37_45A9_8D4F_1F8F68725FB4
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 92bcda07573747522315e80df0aca59109e353ffe52551e3e19af807aca14c01
#. default-sha256: fd2cc7f911d4a8a2be5b14c875cb122334163a876da3faa4ced12add64d6cbd9
msgctxt "scenario7:scenario7_55F98633_ED37_45A9_8D4F_1F8F68725FB4"
msgid "⟪k:0⟫I asked bluntly, and the girl twirled around, smiling."
msgstr "⟪k:0⟫Eu perguntei sem rodeios, e a garota girou, sorrindo."

#: scenario7:scenario7_5541FDCB_DB15_422E_B325_810ED59E7372
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 51890d1d65d14a6ba0e92de832a2e0a1b99284637c3be9b68ad7ea5858f81c19
#. default-sha256: 5ae568f9c3e2277092dbbd2c64493e232f57422b452986d1f820256f476b807b
msgctxt "scenario7:scenario7_5541FDCB_DB15_422E_B325_810ED59E7372"
msgid ""
"⟪k:0⟫⟪k:1⟫My apologies. You just have such a beautiful courtyard here I let myself in for a "
"little walk."
msgstr ""
"⟪k:0⟫⟪k:1⟫Minhas desculpas. É só que você tem um pátio tão bonito aqui que eu entrei para uma "
"pequena caminhada."

#: scenario7:scenario7_45288BEE_D663_41C1_AF44_3429D72D3EE7
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: f40d8fee1de9fb40e5ee086699534019ba18af86eaae707699292247e0b6f511
#. default-sha256: c4ab59460f244adcda8f4c508d0ac7870ed8e47569571bd4dfa387e8d8a1b913
msgctxt "scenario7:scenario7_45288BEE_D663_41C1_AF44_3429D72D3EE7"
msgid ""
"⟪k:0⟫Long, chestnut hair flowed over round, feminine shoulders.⟪k:1⟫⟪k:2⟫It swayed slightly in "
"the wind."
msgstr ""
"⟪k:0⟫Longos cabelos cacau puro caíam sobre ombros redondos e femininos.⟪k:1⟫⟪k:2⟫Eles balançavam "
"ligeiramente ao vento."

#: scenario7:scenario7_0B2ABE52_A65A_4EF3_A1D8_199842CE8E31
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 022135e06654270428591fc972205b5d96fef304c294997e4a26b2da1ba1fca2
#. default-sha256: e158965ba156deb8e78587132f8e88b2401833af4b4a44cb63be54b7ad9eb130
msgctxt "scenario7:scenario7_0B2ABE52_A65A_4EF3_A1D8_199842CE8E31"
msgid "⟪k:0⟫The cloud of melancholy dissipated in the light of her smile."
msgstr "⟪k:0⟫A nuvem de melancolia dissipou-se à luz do seu sorriso."

#: scenario7:scenario7_4D4E9084_E870_492E_A998_C5D99E26EDB7
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 9212da8f31d74a060b184537b99d75b75364d2fe17d842c3a0524ed185ff7e2a
#. default-sha256: ce6a4efd1e72553705677b2f7ed060ff9478d3afe6afc9c69097f9abd8e97c28
msgctxt "scenario7:scenario7_4D4E9084_E870_492E_A998_C5D99E26EDB7"
msgid "⟪k:0⟫⟪k:1⟫You must be Michelle.⟪k:2⟫⟪k:3⟫You’re just as pretty as I heard."
msgstr "⟪k:0⟫⟪k:1⟫Você deve ser Michelle.⟪k:2⟫⟪k:3⟫É tão bonita quanto eu ouvi."

#: scenario7:scenario7_CCB94BB0_F5ED_434C_B5C7_F0C5C7FCCBAA
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 9385408c000ce1ebabd16799647ccdc2b4bb5dfd2d5e9c1f16c7e38710834d8c
#. default-sha256: ab844e62307c55f158f92084780065de284ee07854c7d8cf3550d069fb1ac9e4
msgctxt "scenario7:scenario7_CCB94BB0_F5ED_434C_B5C7_F0C5C7FCCBAA"
msgid ""
"⟪k:0⟫“Finally” meet me? What was she talking about?⟪k:1⟫⟪k:2⟫As I stood there, baffled by this "
"strange woman,"
msgstr ""
"⟪k:0⟫“Finalmente” me conhecer? Do que ela estava falando?⟪k:1⟫⟪k:2⟫Enquanto eu estava lá, "
"perplexa com esta estranha mulher,"

#: scenario7:scenario7_0C0861C5_D4B4_453C_8326_7C12D391459E
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: e4167499321e2d7f58efbd0d7493a5785af3f3fce608fa265facc5037e219787
#. default-sha256: 382cdcbb52b49611a2d397e1e264cb1aa2c5badbe232de3c1d9cb0ddf6c6251e
msgctxt "scenario7:scenario7_0C0861C5_D4B4_453C_8326_7C12D391459E"
msgid "⟪k:0⟫⟪k:1⟫I’m thrilled to make your acquaintance, Michelle."
msgstr "⟪k:0⟫⟪k:1⟫Estou entusiasmada em conhecê-la, Michelle."

#: scenario7:scenario7_395D00B7_3D6A_4726_82D2_4B0208B5AAE9
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 681d030a66d2fbb96be9f0c31f3cbbb049ade9b63b0220182de87c935c9e3e84
#. default-sha256: e084cc5fec383be97cb0108c6f29ee941a532e5aa4ef0010cfa09d93cf63deab
msgctxt "scenario7:scenario7_395D00B7_3D6A_4726_82D2_4B0208B5AAE9"
msgid "⟪k:0⟫Her voice was like someone pouring honey into my ear."
msgstr "⟪k:0⟫Sua voz era como alguém derramando mel em meu ouvido."

#: scenario7:scenario7_2E190DA1_1B5B_42B8_9724_46FD4AEA5E64
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 371c901589e06e5dfcf8c1b1b2849b22956dac4fabe2c301b344dbd5efd9efb5
#. default-sha256: cb9b226d737babd52623de5b53f5ae9b4362b8b72657122bbfe26f860779fed5
msgctxt "scenario7:scenario7_2E190DA1_1B5B_42B8_9724_46FD4AEA5E64"
msgid "⟪k:0⟫stuck another needle into my chest."
msgstr "⟪k:0⟫enfiou outra agulha no meu peito."

#: scenario7:scenario7_92BD0387_003C_458B_BBFA_677D0840B7BC
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 7dec5fff754d0a4605a13fbbc96499da3776ecdaed9602eced8273d8d42250d0
#. default-sha256: 80520d2962a55420571ce098bde10c67a1853cf13fa976bb2574711c5467aa9b
msgctxt "scenario7:scenario7_92BD0387_003C_458B_BBFA_677D0840B7BC"
msgid "⟪k:0⟫No one had told me my brother was to be married."
msgstr "⟪k:0⟫Ninguém me disse que meu irmão ia se casar."

#: scenario7:scenario7_2EA1FB27_A290_45D4_B001_ED2BAE059597
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: c78d949a63884a475046a64bcf19477e4fec03ee9fbb2350cbb0df18669d0fd8
#. default-sha256: 8f465a6a5a5988725434d9f52bfcd92cb1619fbfa2a0b59af449f00599e2bb15
msgctxt "scenario7:scenario7_2EA1FB27_A290_45D4_B001_ED2BAE059597"
msgid ""
"⟪k:0⟫My father Antonin looked so proud of his two boys—⟪k:1⟫⟪k:2⟫Didier soon to receive his "
"assignment, and Georges soon to be wed."
msgstr ""
"⟪k:0⟫Meu pai, Antonin, parecia tão orgulhoso de seus dois filhos—⟪k:1⟫⟪k:2⟫Didier logo recebendo "
"sua designação, e Georges logo se casando."

#: scenario7:scenario7_28390D52_0EA1_4574_8E8E_15A463F1A092
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: d16598f058391f77e22cea2a733430b7bf4d87aa3922c38e014b987ae25a8907
#. default-sha256: 96bcb60c595c1b3c71e6ea960b7aa480f4324cc3fd754d03c3aa2054a9738eaf
msgctxt "scenario7:scenario7_28390D52_0EA1_4574_8E8E_15A463F1A092"
msgid "⟪k:0⟫The banquet proceeded smoothly,"
msgstr "⟪k:0⟫O banquete decorreu sem problemas,"

#: scenario7:scenario7_40ADECC1_364A_41F8_AF37_4F3E4BECF6B9
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: aa8e88445db970902759af168f226796053d33c926b723e94cce2bbe7ac5262f
#. default-sha256: ed4cb27b36274eeb1fabb38124ea38a98880a913f47f554e76ed604678d2223c
msgctxt "scenario7:scenario7_40ADECC1_364A_41F8_AF37_4F3E4BECF6B9"
msgid "⟪k:0⟫not a doubt in the air that we were a happy family."
msgstr "⟪k:0⟫sem uma dúvida no ar de que éramos uma família feliz."

#: scenario7:scenario7_12A5BB5F_4099_4D82_9B68_037211FB700C
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: b09a300c15192f1060f21e20bfecc64ba8392cfb6f877a49abd916cf219b801d
#. default-sha256: bcfc8ca7cd0e0433def603ef9c1c908b53f378e73ef1ea4b86237abc28611183
msgctxt "scenario7:scenario7_12A5BB5F_4099_4D82_9B68_037211FB700C"
msgid "⟪k:0⟫But my mind was elsewhere."
msgstr "⟪k:0⟫Mas minha mente estava em outro lugar."

#: scenario7:scenario7_42746B8F_4494_49DF_A79B_BBA692F85693
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 50b697612b753219389582860a29bed739c1f3aa2e6f75ce47ed4e821674088d
#. default-sha256: 5b971b61fe909d7b69fe5aac1eb0988bc994bee22710823917b8102b768c61f7
msgctxt "scenario7:scenario7_42746B8F_4494_49DF_A79B_BBA692F85693"
msgid "⟪k:0⟫I found myself unconsciously chasing Aimee with my eyes."
msgstr "⟪k:0⟫Eu me vi inconscientemente buscando Aimee com meus olhos."

#: scenario7:scenario7_82923E7B_2641_4CE0_85D9_3B478E646923
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 69eb8cecd0434b2157168f5f9e92dedc74f30650da09a72e9c4bf41f6d28bfd7
#. default-sha256: 4d9091b285afefc606781eb59bf26e10ab169ff9544c2b5011d4dc1312e084fa
msgctxt "scenario7:scenario7_82923E7B_2641_4CE0_85D9_3B478E646923"
msgid ""
"⟪k:0⟫Watching the way those slender fingers gripped her spoon.⟪k:1⟫Her full lips parting to allow "
"a piece of fruit in."
msgstr ""
"⟪k:0⟫Observando a maneira como aqueles dedos finos agarravam sua colher.⟪k:1⟫Seus lábios carnudos "
"se abrindo para permitir que um pedaço de fruta entrasse."

#: scenario7:scenario7_991665B7_761E_4CBB_9097_F7C40F47BB38
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 953c5af373b4bc165e464c0d446fe8174835ead9265e708c6f62cbaa42fb2328
#. default-sha256: 593b326caa9de28d8b36ffabe97062f1d3e1fae50683f325369296ddcc945d7f
msgctxt "scenario7:scenario7_991665B7_761E_4CBB_9097_F7C40F47BB38"
msgid "⟪k:0⟫Her deep red tongue, visible for but the briefest of moments."
msgstr "⟪k:0⟫Sua língua vermelho-profundo, visível apenas pelo mais breve dos momentos."

#: scenario7:scenario7_3AAE7B4F_BF85_459B_B8D0_40E238F55F91
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: d4160cea8c6261c6290c3ed3926c0d6422787203cfeed4cc6fb16a3496f2c69a
#. default-sha256: 85a1f6869179d1663af791892aa259bb8722a38bfc320539f37219a87b70df8b
msgctxt "scenario7:scenario7_3AAE7B4F_BF85_459B_B8D0_40E238F55F91"
msgid ""
"⟪k:0⟫The way all the muscles in her face seemed to relax in bliss as sweet juices seeped into her "
"mouth."
msgstr ""
"⟪k:0⟫A maneira como todos os músculos de seu rosto pareciam relaxar em êxtase enquanto sucos "
"adocicados penetravam em sua boca."

#: scenario7:scenario7_936CDD6B_9C02_4118_9168_A93944FB0CB5
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: e25c64fc09d0441565c8adce71e449db58ac03a4ffe222625cacc7c2e15f171f
#. default-sha256: cfcb4d229aa1c1d9e642457bb7add31800693c374cf2cde416c6650fa30f60fe
msgctxt "scenario7:scenario7_936CDD6B_9C02_4118_9168_A93944FB0CB5"
msgid ""
"⟪k:0⟫The way she spoke, so soft and gentle, letting each sound hang in the air just briefly "
"before intoning the next."
msgstr ""
"⟪k:0⟫A maneira como ela falava, tão suave e gentil, deixando cada som pairar no ar apenas "
"brevemente antes de entoar o próximo."

#: scenario7:scenario7_0D190A50_753D_446D_888B_297A70987ADE
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: d1dbe202bbbc357581569e273e7f4a59b1b57b9089e2cc0e1a9cac2dd5562e19
#. default-sha256: 187b9c468be648fc12a7c1d2a91a10669197785c56df5e89f4cb7af8ce7c6586
msgctxt "scenario7:scenario7_0D190A50_753D_446D_888B_297A70987ADE"
msgid "⟪k:0⟫She was distinctly feminine—⟪k:1⟫⟪k:2⟫in a different way than my mother."
msgstr "⟪k:0⟫Ela era distintamente feminina—⟪k:1⟫⟪k:2⟫de uma maneira diferente da minha mãe."

#: scenario7:scenario7_D0282D63_AB66_4BCD_B5CC_D26348888576
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 2f335f2800d772f804585a28f651d387246e17a5f0645b7e9583a5f031f15747
#. default-sha256: fcb2a158acd27411cdf30420384b69d9d223fc28d5fbe171edc04e4340b9e414
msgctxt "scenario7:scenario7_D0282D63_AB66_4BCD_B5CC_D26348888576"
msgid "⟪k:0⟫Apparently, Aimee was going to be living at the Bollinger estate for some time."
msgstr "⟪k:0⟫Aparentemente, Aimee iria morar na propriedade Bollinger por algum tempo."

#: scenario7:scenario7_81C2E136_5BC7_4B56_8605_CACB3CA4CCA5
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 3a9b28294c06a5d460b489a9fb1948f3298d44dd8040acdd414116992b579234
#. default-sha256: 70f41ed185e4c073482d2c09838fd84ea39d736bd30f18f41890af597d8f543a
msgctxt "scenario7:scenario7_81C2E136_5BC7_4B56_8605_CACB3CA4CCA5"
msgid "⟪k:0⟫I had assumed I would hate being around another girl."
msgstr "⟪k:0⟫Eu tinha presumido que odiaria estar perto de outra garota."

#: scenario7:scenario7_F1C4B5DF_CCD9_42D9_8198_E5C7C2159996
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: ade2187da3a4f2858cab7a25d1e28202cfa3ee5372cf75369f4b2893b79653a3
#. default-sha256: bd9b56a7e90ef7aaccab4639dab08b208fc5e8eaf3ea12b66d036a2bf87e3857
msgctxt "scenario7:scenario7_F1C4B5DF_CCD9_42D9_8198_E5C7C2159996"
msgid "⟪k:0⟫Surely she wouldn’t be able to play chess, after all."
