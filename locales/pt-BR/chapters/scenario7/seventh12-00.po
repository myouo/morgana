msgid "⟪k:0⟫tools meant to punish me?"
msgstr "⟪k:0⟫ferramentas destinadas a me punir?"

#: scenario7:scenario7_5B464F04_9A92_4579_8C51_EC91CD240255
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 5cd1c4989ffd46687a94ae77586527b1da78fe31fb6408e71d87cb1e27cfaaa4
#. default-sha256: b46b509d2cb67401404e52c80cd19339dfe310c31fe37ece46fe073e367074bf
msgctxt "scenario7:scenario7_5B464F04_9A92_4579_8C51_EC91CD240255"
msgid "⟪k:0⟫Tell me, Didier..."
msgstr "⟪k:0⟫Diga-me, Didier..."

#: scenario7:scenario7_12D6FB59_6A51_4848_942F_F4928D9277D5
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: ec1401b43613a72dc73a235c9bbb9ebafb9fce0f972316bfe6066af0dafcdecd
#. default-sha256: 70958879fe14eaeae7907c636ede1ce793e018c112b8c34f544e77c415e633b9
msgctxt "scenario7:scenario7_12D6FB59_6A51_4848_942F_F4928D9277D5"
msgid "⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫Crucify the witch!"
msgstr "⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫Crucifique a bruxa!"

#: scenario7:scenario7_06E89998_6C35_4344_BE0B_EE8EF13FA4D4
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 3957912acc66c13bdf3af669e11ad147ce43f332416d5fe5744a0e1cfa4d6208
#. default-sha256: c60ba0ff07204e439912f972804a2d4f1984e1dda0258807707910ec395b92b7
msgctxt "scenario7:scenario7_06E89998_6C35_4344_BE0B_EE8EF13FA4D4"
msgid ""
"⟪k:0⟫Please, anything but that... ⟪k:1⟫I’m begging you...⟪k:2⟫⟪k:3⟫don’t expose me to these "
"people..."
msgstr ""
"⟪k:0⟫Por favor, tudo menos isso... ⟪k:1⟫Eu imploro a você...⟪k:2⟫⟪k:3⟫não me exponha a essas "
"pessoas..."

#: scenario7:scenario7_1281D409_8BEB_4CAE_888D_48DFD6D3CBC6
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 7dfab124cc1b3f9acafef8b233f351de833d19bf3a19310f8e8702fee0488225
#. default-sha256: 5c072c2ae1a7b2e47da63f2d68114c326b1950664400cfe2e6dd01fec83708d1
msgctxt "scenario7:scenario7_1281D409_8BEB_4CAE_888D_48DFD6D3CBC6"
msgid "⟪k:0⟫Don’t expose my body, Didier!"
msgstr "⟪k:0⟫Não exponha meu corpo, Didier!"

#: scenario7:scenario7_CF06DD32_7A5D_48DC_AA4A_7BDD93E968AC
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 00a06b825d2ea0faba896ee0d2913cead3b820f8f4d0edde85d2c302de318a7c
#. default-sha256: 781b44f32e41e52ffbc05cf4f1e19bc6a15a968b732926d8c29018145747836a
msgctxt "scenario7:scenario7_CF06DD32_7A5D_48DC_AA4A_7BDD93E968AC"
msgid "⟪k:0⟫I’m begging you—"
msgstr "⟪k:0⟫Eu estou te implorando—"

#: scenario7:scenario7_D05EA808_47E5_4593_A6B0_973EFD32CE3F
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 7afbeb610af85bb5f0c1ea444b8cead745018a0e41746bee99feb00379fa2515
