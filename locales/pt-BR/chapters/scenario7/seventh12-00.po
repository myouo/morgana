msgctxt "scenario7:scenario7_1DCF0803_C04F_40B6_958E_B00ADB3E0CED"
msgid "⟪k:0⟫until I was left fully nude."
msgstr "⟪k:0⟫até que ficasse completamente nu."

#: scenario7:scenario7_8239D993_E4CC_494D_AE65_0BC3127CD6EC
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
