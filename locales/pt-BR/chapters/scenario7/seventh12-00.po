msgctxt "scenario7:scenario7_D05EA808_47E5_4593_A6B0_973EFD32CE3F"
msgid ""
"⟪k:0⟫But of course, my voice had no way of reaching him,⟪k:1⟫⟪k:2⟫and he proceeded to remove my "
"clothing, piece by piece,"
msgstr ""
"⟪k:0⟫Mas é claro, minha voz não tinha como alcançá-lo,⟪k:1⟫⟪k:2⟫e ele começou a remover minha "
"roupa, pedaço por pedaço,"

#: scenario7:scenario7_1DCF0803_C04F_40B6_958E_B00ADB3E0CED
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 02e68e59a2ee3795f527d18c217f755e88877c10e2919f7cec8fb2e7ae2cbd48
