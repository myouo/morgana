msgid "⟪k:0⟫And then, with a mocking laugh, one man spoke,"
msgstr "⟪k:0⟫E então, com uma risada zombeteira, um homem falou, "

#: scenario7:scenario7_90C9BCAA_38F4_4491_BFFE_F74F8614A885
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: b37ab3d518f66490d4f0fc1ad39e5f1d0c4b2b040a4303765a2e5ddb2cfe38cc
#. default-sha256: 0ec543ddea6feb9434b44ff892826c41e188ca7373da628df4744fd90ac42abc
msgctxt "scenario7:scenario7_90C9BCAA_38F4_4491_BFFE_F74F8614A885"
msgid "⟪k:0⟫Ahh, so there it is... ⟪k:1⟫the devilish creature."
msgstr "⟪k:0⟫Ahh, então aí está... ⟪k:1⟫a criatura diabólica."

#: scenario7:scenario7_25AEB98A_D52B_4761_915D_8DA07D7F283F
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: cf9543343d9c7a1dbfaaaab550a94a3610e0e2ed9b351c63844b762efdbef291
#. default-sha256: eb811d30371f5e36c29acacd17decdb9bad214d315d4c6247bfab6ff47d9f783
msgctxt "scenario7:scenario7_25AEB98A_D52B_4761_915D_8DA07D7F283F"
