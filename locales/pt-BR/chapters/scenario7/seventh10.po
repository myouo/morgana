msgctxt "scenario7:scenario7_47F1DACD_3876_4775_99A0_E5423BACC6D6"
msgid "⟪k:0⟫⟪k:1⟫I am nothing like you.⟪k:2⟫⟪k:3⟫I am a human... ⟪k:4⟫nothing more."
msgstr "⟪k:0⟫⟪k:1⟫Eu não sou nada como você.⟪k:2⟫⟪k:3⟫Eu sou um humano... ⟪k:4⟫nada mais."

#: scenario7:scenario7_EF62B65E_16C7_4FCC_9043_63A39C0D7251
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 9833e26163fe35493b43ba47c59788db0e3656d567b0f73371c63f617446a6c2
