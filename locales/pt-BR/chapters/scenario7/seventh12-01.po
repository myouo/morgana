#: scenario7:scenario7_090A51F1_861C_4F72_B0D5_474947B3F7E3
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 04f00e539bff728b39a28fe222b7ed9d0113b5ed151b0bc440fae3e1af8e75ac
#. default-sha256: 3020e7cd286770fe9669da8c6c51e34df0be68eca4c9c531d212e03835ea5984
msgctxt "scenario7:scenario7_090A51F1_861C_4F72_B0D5_474947B3F7E3"
msgid ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫⟪k:4⟫⟪k:5⟫⟪k:6⟫⟪k:7⟫⟪k:8⟫⟪k:9⟫⟪k:10⟫⟪k:11⟫⟪k:12⟫⟪k:13⟫⟪k:14⟫⟪k:15⟫⟪k:16⟫⟪k:17⟫"
"⟪k:18⟫⟪k:19⟫⟪k:20⟫⟪k:21⟫⟪k:22⟫...And so, my life came to an end."
msgstr ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫⟪k:4⟫⟪k:5⟫⟪k:6⟫⟪k:7⟫⟪k:8⟫⟪k:9⟫⟪k:10⟫⟪k:11⟫⟪k:12⟫⟪k:13⟫⟪k:14⟫⟪k:15⟫⟪k:16⟫⟪k:17⟫"
"⟪k:18⟫⟪k:19⟫⟪k:20⟫⟪k:21⟫⟪k:22⟫...E assim, minha vida chegou ao fim."

#: scenario7:scenario7_5D8C55D5_BF96_41AE_A46B_B7820CB71569
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: bf8d69f96a31a8ab6de406ff997f9d68c453c2eb66d0ce3d1c52a0e63c9031e1
#. default-sha256: c23444a46bafe68b8edd3d7731c7f44caf47216d0bb756544fa317ae5fb1b5c0
msgctxt "scenario7:scenario7_5D8C55D5_BF96_41AE_A46B_B7820CB71569"
msgid "⟪k:0⟫But that wasn’t the end of the story."
msgstr "⟪k:0⟫Mas esse não foi o fim da história. "

#: scenario7:scenario7_C51746E0_7E56_4329_86EF_EDB666693DA2
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: d3f5df75809c57ebc7b0faaa679432cdb33c40487a15b18d41de1831405b6152
#. default-sha256: 556936c0637c323d7542fea53e379505006e4ad828e3c0910d4c6a7707b5572c
msgctxt "scenario7:scenario7_C51746E0_7E56_4329_86EF_EDB666693DA2"
msgid ""
"⟪k:0⟫I don’t know if what comes next could be called “my” story,⟪k:1⟫⟪k:2⟫but memories of these "
"events linger in my soul."
msgstr ""
"⟪k:0⟫Não sei se o que vem a seguir pode ser chamado de “minha” história,⟪k:1⟫⟪k:2⟫memórias desses "
"eventos permanecem em minha alma."

#: scenario7:scenario7_3DE6F1A1_7E45_4823_BB18_DFE93D6A6332
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 417f86c1e982c4f99d5056500f3d7deb518ca354b302aae67c206965bb1b1cef
#. default-sha256: 6bea5276ca626adede1264c1036dad48ecdd2138cc38cd72203f109f37de57e1
msgctxt "scenario7:scenario7_3DE6F1A1_7E45_4823_BB18_DFE93D6A6332"
msgid ""
"⟪k:0⟫How could I have ever imagined...⟪k:1⟫⟪k:2⟫that I would be made to witness my own misery "
"even in death?"
msgstr ""
"⟪k:0⟫Como eu poderia imaginar...⟪k:1⟫⟪k:2⟫que eu seria obrigado a testemunhar minha própria "
"miséria mesmo na morte?"

#: scenario7:scenario7_8C20439B_C5B4_4D4A_AFAB_5CCD52C9ED90
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 2170963e7dba5375434bc0943f787d5ef3350aadac0e647416c2f9feb5045942
#. default-sha256: 77809e73751a785be3e5d4e93147ee8225d6deff6e87983662af5bffd8da289e
msgctxt "scenario7:scenario7_8C20439B_C5B4_4D4A_AFAB_5CCD52C9ED90"
msgid "⟪k:0⟫And my soul—⟪k:1⟫⟪k:2⟫evidently still bound to my flesh—"
msgstr "⟪k:0⟫E minha alma—⟪k:1⟫⟪k:2⟫evidentemente ainda presa à minha carne—"

#: scenario7:scenario7_A3D92C5D_C2DD_4CE0_8512_FCF7FE870B04
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 3c2ee57a36c0aae5c5f2c5bc617065bd39257d78dac19d7ea9161a6b6b876ea2
#. default-sha256: 47fbbf984b0d1180bb7d758bd5b7e2cc6231e973901a5a18e6367c09c4e182d6
msgctxt "scenario7:scenario7_A3D92C5D_C2DD_4CE0_8512_FCF7FE870B04"
msgid "⟪k:0⟫was dragged along with it, against my will, down to the nearby village."
msgstr "⟪k:0⟫foi arrastada junto com ele, contra a minha vontade, até a aldeia próxima."

#: scenario7:scenario7_E61D0C8B_E817_4C49_8BCD_986BDDA99580
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: a8da8bb426a18ee610ab09461278ee61f7ce7bb14002ea5eb187b178ebe991dd
#. default-sha256: 6a14bca6e4269058a4c867e00fc4a98ad5fa19e8631807bb971b4f3ccac2baaa
msgctxt "scenario7:scenario7_E61D0C8B_E817_4C49_8BCD_986BDDA99580"
msgid "⟪k:0⟫⟪k:1⟫The knights have returned from their holy quest!"
msgstr "⟪k:0⟫⟪k:1⟫Os cavaleiros retornaram de sua busca sagrada!"

#: scenario7:scenario7_4BC5D94C_29C0_4512_8464_CFCAC63C2BC4
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 210e7981861916324168cf75644843de949df7d06988427c7719c8014d4205c3
#. default-sha256: cd0f76996e3251fdfbd25961a548351070605007281ec133bd56c84cd1a5e173
msgctxt "scenario7:scenario7_4BC5D94C_29C0_4512_8464_CFCAC63C2BC4"
msgid "⟪k:0⟫⟪k:1⟫Oh, how we’ve awaited your arrival!"
msgstr "⟪k:0⟫⟪k:1⟫Óh, como esperamos sua chegada!"

#: scenario7:scenario7_CB3ED887_927B_45F4_AD8F_4F1D0214AA0F
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: c4818af3b4ffb18963e28764947cdbd2b68fe67bcb7bac942219d7302e75892d
#. default-sha256: 836d2f05a97528d24606e36a139ac27e1cfb432d6acf3b23771cc1cfd3638418
msgctxt "scenario7:scenario7_CB3ED887_927B_45F4_AD8F_4F1D0214AA0F"
msgid "⟪k:0⟫⟪k:1⟫How glorious it is to see you!"
msgstr "⟪k:0⟫⟪k:1⟫Que glorioso é ver vocês!"

#: scenario7:scenario7_1E29A1D1_0BEE_452D_97A6_C04B078CD2D4
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 01a2d660aa94fcaf829776d6b2e6273211cd72571ce76d9f67798ceac864d6ec
#. default-sha256: 854dbd9f2f4211d1807ef93493dda6c8e11bce165ee42d776cb260e392f9c2cc
msgctxt "scenario7:scenario7_1E29A1D1_0BEE_452D_97A6_C04B078CD2D4"
msgid ""
"⟪k:0⟫Waiting for us there was a cluster of villagers.⟪k:1⟫⟪k:2⟫A large cross lay on the ground in "
"the center of the square."
msgstr ""
"⟪k:0⟫Esperando por nós havia um grupo de aldeões.⟪k:1⟫⟪k:2⟫Uma grande cruz jazia no chão no "
"centro da praça."

#: scenario7:scenario7_A1924AEC_E6D6_462F_BDE5_51024E31F01B
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 87d88b308bcf33698c9e43646c8a25e46aa3691bd832debeb357e114395ff1ce
#. default-sha256: 378b85bde7f09036ffea6c1a97a8d09dfee610dbf670bf97bdd1e52b326efcdc
msgctxt "scenario7:scenario7_A1924AEC_E6D6_462F_BDE5_51024E31F01B"
msgid ""
"⟪k:0⟫Holding torches, they formed a crowd around the knights, several of them familiar faces."
msgstr ""
"⟪k:0⟫Segurando tochas, eles formaram uma multidão ao redor dos cavaleiros, vários deles rostos "
"familiares."

#: scenario7:scenario7_F52A9436_A594_40DB_8213_25E1D487198D
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: e9569095f29ce5731e0fc581503510134e745cf0f121601b46ecf5388fb9643b
#. default-sha256: 2c49b50004fe659249f1989b902026bd8351724d6161e11daff11c8a6a5adbc0
msgctxt "scenario7:scenario7_F52A9436_A594_40DB_8213_25E1D487198D"
msgid ""
"⟪k:0⟫No longer shall we live in fear of the curse befalling us!⟪k:1⟫⟪k:2⟫Eternal peace is assured!"
msgstr ""
"⟪k:0⟫Não viveremos mais com medo da maldição que nos sobrevirá!⟪k:1⟫⟪k:2⟫Paz eterna está "
"garantida!"

#: scenario7:scenario7_16B2FCE2_C477_4BD9_8C7D_E88D8A4AF579
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 0eb260d6850a79968a580328960f19a4ba679dd715a23199628574c676007c58
#. default-sha256: d4045d963a401ccd86ff865eabf35e07130ed39a65ff358867c755aff64d4bb1
msgctxt "scenario7:scenario7_16B2FCE2_C477_4BD9_8C7D_E88D8A4AF579"
msgid "⟪k:0⟫Why, then... ⟪k:1⟫were they acting like I was at fault?"
msgstr "⟪k:0⟫Por que, então... ⟪k:1⟫eles estavam agindo como se eu fosse o culpado?"

#: scenario7:scenario7_4CEDA84C_E7DE_4F7A_8E6C_4075FF9ED2EC
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 9d3551617c5c47ea8a812db49cc87a74221de91a3b7660ef797c722423901be8
#. default-sha256: 3c2f5dfbb0212c834531867eb06f21f2100b4f961dd4ea81183025fb18f766d6
msgctxt "scenario7:scenario7_4CEDA84C_E7DE_4F7A_8E6C_4075FF9ED2EC"
msgid "⟪k:0⟫Why was I the sinner, and why did I need to be judged?"
msgstr "⟪k:0⟫Por que eu era o pecador, e por que eu precisava ser julgado?"

#: scenario7:scenario7_2A266E31_4BB9_464A_9B6B_7551BF55087C
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 9e94a25b35f8b21d6144f458bc9e8354c7417f5e9bd050a324a4862a536ecb19
#. default-sha256: 6489361bcfcff74cd456ac87238202ca665cd30335803dd8087df644c6186651
msgctxt "scenario7:scenario7_2A266E31_4BB9_464A_9B6B_7551BF55087C"
msgid ""
"⟪k:0⟫My soul trembled at the overwhelming fervor consuming the crowd, ⟪k:1⟫their zealous desire "
"to see judgment cast."
msgstr ""
"⟪k:0⟫Minha alma tremeu diante do fervor avassalador que consumia a multidão, ⟪k:1⟫seu desejo "
"zeloso de ver o julgamento lançado."

#: scenario7:scenario7_4055B4D2_8A2F_48DF_801C_6AA7C0D5ADC8
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: bcbabb33f2cd999ec18116bc7ed06d5ed2f16734a638f42694c5f51cc57d707d
#. default-sha256: 87d13ae5a14c5d6bcc58b9e15acdb56b9889d32751c77bfdc98b5c721cc6e452
msgctxt "scenario7:scenario7_4055B4D2_8A2F_48DF_801C_6AA7C0D5ADC8"
msgid "⟪k:0⟫Please don’t do this, Didier...⟪k:1⟫⟪k:2⟫Please, hear my voice..."
msgstr "⟪k:0⟫Por favor, não faça isso, Didier...⟪k:1⟫⟪k:2⟫Por favor, ouça minha voz..."

#: scenario7:scenario7_90CACC1B_FB5C_4F6A_A11B_C62ACBF86CA5
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 232cd75f883fa023c4d6eaae6a98a63527a37ed2d757f8760115ab673c3733ee
#. default-sha256: 5413f74d9f0cf4a9876fa010c73400407c3aa17bda3e0facae218dd58e03bc8c
msgctxt "scenario7:scenario7_90CACC1B_FB5C_4F6A_A11B_C62ACBF86CA5"
msgid "⟪k:0⟫Please, tell me ⟪k:1⟫you⟪k:2⟫, at least, don’t think I did those things..."
msgstr ""
"⟪k:0⟫Por favor, me diga que ⟪k:1⟫você⟪k:2⟫, pelo menos, não pensa que eu fiz essas coisas..."

#: scenario7:scenario7_1809491C_BCB6_4470_BD73_A9E1B6453A66
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: fce4999172b8a0d786c49624b3751dcdb6b0c94c606a1462c6c1a0ffb1a87b6c
#. default-sha256: 01fce4ce52c7073a43d1b831b6561c9c33c8463b646806c1c57abc5732ad3b65
msgctxt "scenario7:scenario7_1809491C_BCB6_4470_BD73_A9E1B6453A66"
msgid "⟪k:0⟫Don’t put me on that cross...⟪k:1⟫⟪k:2⟫If it was Mother who sold me out to the Church,"
msgstr "⟪k:0⟫Não me coloque nessa cruz...⟪k:1⟫⟪k:2⟫Se foi a Mãe que me vendeu para a Igreja,"

#: scenario7:scenario7_748FDB2D_891F_4063_B06B_CA7A27FC96BC
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 2f1b9a020099235f172d2889436515f6325f02b23d002eb416a0a0ce80510877
#. default-sha256: dd564c7a35dedb2936b31d5d3cf4ca3699b40b7c3af5c4b9d5549bdb732f7bcb
msgctxt "scenario7:scenario7_748FDB2D_891F_4063_B06B_CA7A27FC96BC"
msgid ""
"⟪k:0⟫The nails and rope for the crucifixion are here.⟪k:1⟫⟪k:2⟫We would have you, O knight, "
"deliver the Lord’s judgment unto this vile witch!"
msgstr ""
"⟪k:0⟫Os pregos e a corda para a crucificação estão aqui.⟪k:1⟫⟪k:2⟫Gostaríamos que você, Ó "
"cavaleiro, entregasse o julgamento do Senhor a esta bruxa vil!"

#: scenario7:scenario7_FE7C6CF8_459E_46AF_AA1C_47F64264FA6A
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: e761ec92b58307cb53f49c6def1221e9b298f3525f40d5c2cb6351e2054a79f2
#. default-sha256: a6fc38a7f31336ab0dfe274f49400ee31590f8ecd73f8fcd2d478a03b056f55c
msgctxt "scenario7:scenario7_FE7C6CF8_459E_46AF_AA1C_47F64264FA6A"
msgid "⟪k:0⟫Didier..."
msgstr "⟪k:0⟫Didier..."

#: scenario7:scenario7_83319B1E_A3C6_4451_9E94_294CD95D46DE
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 6120f14fdaafa615cdc517f613f622c99485be58fbd9b335c04bb6497fa50c10
#. default-sha256: a5e3f36d4c998b3844e412fdf008938dc6537efdc8d940dc8f5c1159c124b1b6
msgctxt "scenario7:scenario7_83319B1E_A3C6_4451_9E94_294CD95D46DE"
msgid "⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫Crucifixion!"
msgstr "⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫Crucificação!"

#: scenario7:scenario7_4307D535_FE8B_4BE6_BCDC_93F1F1C3CF34
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 9939a9337ddf30bda428a93a3c0ed641ea39b2a498c0329fb12608cec7437eb0
#. default-sha256: 99a231e146902292214bc1d1e92418cf88b9defda89f7ef0a1758bb0f3132f34
msgctxt "scenario7:scenario7_4307D535_FE8B_4BE6_BCDC_93F1F1C3CF34"
msgid "⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫Crucify it!"
msgstr "⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫Crucifica ela!"

#: scenario7:scenario7_BE5EED1B_42A0_45A3_A6C7_15DD67C76C1B
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 54c7c565dfaf102c70fee9434aafdbcb153dd54f349ff9dc32e2506ac45e1e76
#. default-sha256: 416ffe50bfc35ae8d09c24c022f18abd579d7049cfaa29fc450d13368f91eec2
msgctxt "scenario7:scenario7_BE5EED1B_42A0_45A3_A6C7_15DD67C76C1B"
msgid ""
"⟪k:0⟫My brother lowered my corpse to the ground and began removing my clothing, ⟪k:1⟫and in that "
"very moment, I realized the purpose of hanging someone from a cross."
msgstr ""
"⟪k:0⟫Meu irmão abaixou meu cadáver até o chão e começou a tirar minhas roupas, ⟪k:1⟫e naquele "
"exato momento, percebi o propósito de pendurar alguém em uma cruz."

#: scenario7:scenario7_B88FDF38_E3ED_4B5C_B13B_53B336DCF166
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 3811c89397d571d1a9972ccfd79ec19027e78f886c05fed9ab99ff436ee45b68
#. default-sha256: 2dcc1bc43e5e1fb8f76f53c9fd6de2395a53a56f9268b2ea881916b2b7cdbfe8
msgctxt "scenario7:scenario7_B88FDF38_E3ED_4B5C_B13B_53B336DCF166"
msgid "⟪k:0⟫Overwhelmed by hopelessness, tears streamed down my face."
msgstr "⟪k:0⟫Dominado pela desesperança, lágrimas escorriam pelo meu rosto."

#: scenario7:scenario7_F330EC48_B442_43BB_867C_F9A5674ECE91
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: cf8d7c8215636cd5662518d250160fff575a41f8387f44ed1df058237586e59a
#. default-sha256: 6f297a398cd0878691c7002d64ca8d9e298d532a92e3932b0ed7116d4fb927af
msgctxt "scenario7:scenario7_F330EC48_B442_43BB_867C_F9A5674ECE91"
msgid "⟪k:0⟫don’t do it!"
msgstr "⟪k:0⟫não faça isso!"

#: scenario7:scenario7_BFF95DC4_C5B9_4167_A118_3B8955B2FC84
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 3748a90540bf9004b4b4507b68aed647f4f8434ff0a351eb2bab275c5e46b3c4
#. default-sha256: 9d83177e4e26581e4a7579b35d0f4034584424db0590b66eef8544cc033036e8
msgctxt "scenario7:scenario7_BFF95DC4_C5B9_4167_A118_3B8955B2FC84"
msgid ""
"⟪k:0⟫For a brief moment, an unpleasant silence spread through the crowd. ⟪k:1⟫The erratic "
"crackling of their torches was the only sound that could be heard in the square."
msgstr ""
"⟪k:0⟫Por um breve momento, um silêncio desagradável espalhou-se pela multidão. ⟪k:1⟫O crepitar "
"errático das suas tochas era o único som que se ouvia na praça."

#: scenario7:scenario7_00E0D90C_518C_432E_A046_E7253A8B1690
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: b022d7ed062335ca97c637f0f6691984f74bb384f95c6f521b1f524cc0ced8c4
#. default-sha256: f5236944027677c386eed6da6018d7248d26c55822a31ef7c127276ad7f8c725
