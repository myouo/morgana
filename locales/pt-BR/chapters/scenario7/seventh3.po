#: scenario7:scenario7_F1D91C51_4F99_4780_829C_DFD37ACB336A
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 181a56c12233a71e27a7c208bebe8c2a887f3829b8013b2c43dfdff441be5cc1
#. default-sha256: dcaa498621b24bb65243f311d3edf3eafc61c9aa60f40a3747c2b947d4a1f466
msgctxt "scenario7:scenario7_F1D91C51_4F99_4780_829C_DFD37ACB336A"
msgid ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫⟪k:4⟫⟪k:5⟫⟪k:6⟫⟪k:7⟫⟪k:8⟫⟪k:9⟫⟪k:10⟫⟪k:11⟫The next day, I awoke with a "
"terrible fever."
msgstr ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫⟪k:4⟫⟪k:5⟫⟪k:6⟫⟪k:7⟫⟪k:8⟫⟪k:9⟫⟪k:10⟫⟪k:11⟫No dia seguinte acordei com uma "
"febre terrível."

#: scenario7:scenario7_5A90CE79_FF7B_4187_BAE0_20AF39FCD941
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 106f17c66307ec40ceea1aa13304944f727ae573e2a2d8607ca69e3536193d5c
#. default-sha256: 130de9e5a0c26a018b3cce7ae15e658f300a5499416f3358517aa0e938ba7e55
msgctxt "scenario7:scenario7_5A90CE79_FF7B_4187_BAE0_20AF39FCD941"
msgid ""
"⟪k:0⟫I hovered in a sweltering wave of heat, unable to tell dream and reality apart, listening to "
"a seemingly endless stream of cracking noises."
msgstr ""
"⟪k:0⟫Eu pairava em uma onda de calor sufocante, incapaz de distinguir o sonho da realidade, "
"ouvindo um fluxo aparentemente interminável de ruídos de estalos."

#: scenario7:scenario7_2358D0B0_F81B_49DC_98A5_0E40E057D26E
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: bb9da36fcc0485ea8541158dc5b3e6ebbc8f27ef9b8462c39e653bc40a0297d7
#. default-sha256: 812f5a5ced2229b583291543a7a5dd608d0b32127796a987520ffeb4c7f8349d
msgctxt "scenario7:scenario7_2358D0B0_F81B_49DC_98A5_0E40E057D26E"
msgid "⟪k:0⟫The sounds were coming from inside my body.⟪k:1⟫⟪k:2⟫I thought I was falling apart."
msgstr "⟪k:0⟫Os sons vinham de dentro do meu corpo.⟪k:1⟫⟪k:2⟫Eu pensei que estava desmoronando."

#: scenario7:scenario7_9A6ABD87_065F_45B1_98C4_5C7CEDE5CDE5
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: b517bfc052d81f6489ac836db6957a2cfce15423acdc74a1e545294be0349ac0
#. default-sha256: eb38248c45b5b689b68326c8f3f095e5c685e49ca0f0bee85fb77b7670df1d00
msgctxt "scenario7:scenario7_9A6ABD87_065F_45B1_98C4_5C7CEDE5CDE5"
msgid "⟪k:0⟫Mother was horribly worried."
msgstr "⟪k:0⟫A mãe estava terrivelmente preocupada."

#: scenario7:scenario7_BE7745A7_EBC2_4845_902B_6BB1BD2FE613
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 9f0a4fd6b8f64c0fd0fd8ca144a2ef78391680ebb745ebc9b9254e22f7fb0060
#. default-sha256: 6f5f7668da5a60a8546fc6a9c17ff35369a89521f1205e2865a96734ac7bf389
msgctxt "scenario7:scenario7_BE7745A7_EBC2_4845_902B_6BB1BD2FE613"
msgid "⟪k:0⟫I had never been the most healthy child, but I had never fallen this ill either."
msgstr "⟪k:0⟫Nunca fui a criança mais saudável, mas também nunca fiquei tão doente."

#: scenario7:scenario7_9A50E480_AE92_4FBF_90B9_11ED809885BD
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 7421744c50ce1473862ce398af29f7506686dba11401ac9dd49f535719af0454
#. default-sha256: 4bc03ac697c14a5db092b7fc9c12324b6ca441fd29abc7b9c642b01e2ad47bda
msgctxt "scenario7:scenario7_9A50E480_AE92_4FBF_90B9_11ED809885BD"
msgid ""
"⟪k:0⟫I couldn’t get out of bed.⟪k:1⟫⟪k:2⟫My voice was raspy, like an old woman’s.⟪k:3⟫⟪k:4⟫I was "
"genuinely afraid I would wither away and die."
msgstr ""
"⟪k:0⟫Não conseguia sair da cama.⟪k:1⟫⟪k:2⟫Minha voz era rouca, como a de uma velha.⟪k:3⟫⟪k:4⟫Eu "
"estava realmente com medo de murchar e morrer."

#: scenario7:scenario7_9DFE4400_A100_4512_A293_640E884E0448
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 20c5ffcfaeecf7751b884d973b0b9f083b8e62e76c931cc45410657fbb914242
#. default-sha256: 51d59858ff893438a3c5f240aed8cdc3d64b4383f18f9abe5586a12dd1587792
msgctxt "scenario7:scenario7_9DFE4400_A100_4512_A293_640E884E0448"
msgid "⟪k:0⟫Mother called in doctor after doctor to see me, but they all said it was the flu."
msgstr "⟪k:0⟫A Mãe chamou médico após médico para me ver, mas todos disseram que era gripe."

#: scenario7:scenario7_9B0872F9_8B72_4CCD_BCA1_00968A4D19CC
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 5bf2251976df6dd1e3dc90d1d2937749364b54c0ac6a6931a0cf5514e80b7cd4
#. default-sha256: 08123d9680231605b55ff8073a7395328c0b56b92082e3a4d02c7f5419491987
msgctxt "scenario7:scenario7_9B0872F9_8B72_4CCD_BCA1_00968A4D19CC"
msgid "⟪k:0⟫That bodily pain was common with a fever."
msgstr "⟪k:0⟫Aquela dor corporal era comum com febre."

#: scenario7:scenario7_B0834569_89A7_4A75_8EEB_ADC8174E35E9
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 856a57097069d5206e1edee94d6157131c510254bd6518189933fedea8530680
#. default-sha256: c70049d091e58135245fad8a8b62c03994a54b976edeea6b110a7219571ef637
msgctxt "scenario7:scenario7_B0834569_89A7_4A75_8EEB_ADC8174E35E9"
msgid "⟪k:0⟫While there was a doctor in the house, Mother was able to remain relatively calm,"
msgstr "⟪k:0⟫Enquanto houvesse um médico em casa, Mãe conseguia manter-se relativamente calma,"

#: scenario7:scenario7_5B8AFEEF_7744_4E0A_B95A_8D0ADFF881A3
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 5781ece64fe8a48d809f678926af0a5576bcb5b03708a7b3dd38c724d33660bb
#. default-sha256: 641042dcc6445ced93330606f5d3b75958cc0d4ce3faa891b5b56ee9892594bd
msgctxt "scenario7:scenario7_5B8AFEEF_7744_4E0A_B95A_8D0ADFF881A3"
msgid ""
"⟪k:0⟫but once they were gone, the anxiety came back. ⟪k:1⟫She stayed with me, day and night, even "
"foregoing sleep."
msgstr ""
"⟪k:0⟫mas assim que fossem embora, a ansiedade voltava. ⟪k:1⟫Ela ficou comigo dia e noite, mesmo "
"sem dormir."

#: scenario7:scenario7_930E5261_C89B_49F8_B299_A99BF37D8E3D
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 14d4bd7a6058d48609869a82cdb8cf193a997f78fdd972b4149f577e69f3a691
#. default-sha256: 18c1b790645d0a17652fbc64aa442ab331499625936e5e4446743461b832240b
msgctxt "scenario7:scenario7_930E5261_C89B_49F8_B299_A99BF37D8E3D"
msgid "⟪k:0⟫Her hands gripped mine. They held me fast."
msgstr "⟪k:0⟫Suas mãos agarravam as minhas. Elas me mantinham lá."

#: scenario7:scenario7_CB48627A_80F4_499B_BD28_D389CCD92A26
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: ef347bbaeff34637ecf5b176dd76e379090c1b4853aaf15b9efae4cef2b4c54e
#. default-sha256: 15b70e2db64233e0ebc0fd8c1e76cd007d5295f714386f10275d3b064db03d5d
msgctxt "scenario7:scenario7_CB48627A_80F4_499B_BD28_D389CCD92A26"
msgid "⟪k:0⟫She had her head bowed, as if in prayer."
msgstr "⟪k:0⟫Ela tinha a cabeça baixa, como se estivesse rezando."

#: scenario7:scenario7_884467C2_57AC_43E9_BAD3_47857FA710BE
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 41ccecd9c05a334060a2140f7fdc201e49d834373e593ee8c870330a2ff5f63d
#. default-sha256: f92fabcb7419f3578f81d12dc6c6482bc1005ccd46f9e1167840a8e94676dd96
msgctxt "scenario7:scenario7_884467C2_57AC_43E9_BAD3_47857FA710BE"
msgid ""
"⟪k:0⟫Don’t worry... ⟪k:1⟫It’ll be all right, Michelle.⟪k:2⟫⟪k:3⟫God is watching over you... ⟪k:4⟫"
"He will protect you..."
msgstr ""
"⟪k:0⟫Não se preocupe... ⟪k:1⟫Vai ficar tudo bem, Michelle.⟪k:2⟫⟪k:3⟫Deus está cuidando de você... "
"⟪k:4⟫Ele irá protegê-la..."

#: scenario7:scenario7_DBA90755_DFD7_4EC8_A226_250D17981B38
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 0a139e8fac965b6a456f0ee12bd4a5879b74cf57a1eec1a956a2f41d3d3ba16f
#. default-sha256: e5fad0cfd96e2c0c5f001fbaab633c8a1531bd0e2cf599a21118ae25cf0dcce0
msgctxt "scenario7:scenario7_DBA90755_DFD7_4EC8_A226_250D17981B38"
msgid "⟪k:0⟫You are His child...⟪k:1⟫⟪k:2⟫You are His angel sent to Earth..."
msgstr "⟪k:0⟫Você é filha Dele...⟪k:1⟫⟪k:2⟫Você é Seu anjo enviado à Terra..."

#: scenario7:scenario7_F151E5BB_71B9_4D70_B606_94E38C173BAA
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: e7d26706fb6c6b1bd086502231f064fa0833062af35f796165b4bc484cc549a8
#. default-sha256: 2c4803a5a0c7a89ed82750be70861a3aae8d0f43342f4439c3a9f73fd556232e
msgctxt "scenario7:scenario7_F151E5BB_71B9_4D70_B606_94E38C173BAA"
msgid "⟪k:0⟫He will not forsake you...⟪k:1⟫⟪k:2⟫The doctors say it’s just the flu..."
msgstr "⟪k:0⟫Ele não vai te abandonar...⟪k:1⟫⟪k:2⟫Os médicos dizem que é apenas uma gripe..."

#: scenario7:scenario7_8F36946A_C49E_475F_9514_0BD7E7BC2449
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 26e4d33de9c3e6714aef4ac92433d889a35cce71902aa4a228fbd84e78d255aa
#. default-sha256: 801e8975202df52c5925b5d5ea75c7cd2cbe827118341e65aa849204835d0ab2
msgctxt "scenario7:scenario7_8F36946A_C49E_475F_9514_0BD7E7BC2449"
msgid ""
"⟪k:0⟫Though her words seemed to be directed at me, there was a vacantness in her voice, as if "
"they were really for herself."
msgstr ""
"⟪k:0⟫Embora suas palavras parecessem dirigidas a mim, havia um vazio em sua voz, como se fossem "
"realmente para ela mesma."

#: scenario7:scenario7_3E6EACDC_4063_44A7_A907_1D8A41C134C3
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: c911ed4e8c057aafc47516d88433f6162da6696e40a4990a643ccbf618b6b78d
#. default-sha256: f5a87c07ae8f284d4c732bea5ba24fcfa948b46234321e70cff9387ae3ea9731
msgctxt "scenario7:scenario7_3E6EACDC_4063_44A7_A907_1D8A41C134C3"
msgid "⟪k:0⟫For so long, she had wanted a daughter."
msgstr "⟪k:0⟫Por muito tempo, ela tinha querido uma filha."

#: scenario7:scenario7_AE779766_B600_44A3_826C_F89A5EA9FB46
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: d57a600b37779377a76ad22b879f9ee9e86e33a5b27613b7f3d9591f6ba845c9
#. default-sha256: ec0a8c9e213317b7d575e292d1b55d32c2208e4b5ae9b83f57513dcc5ef929e7
msgctxt "scenario7:scenario7_AE779766_B600_44A3_826C_F89A5EA9FB46"
msgid "⟪k:0⟫I couldn’t understand her fixation,"
msgstr "⟪k:0⟫Eu não conseguia entender a fixação dela,"

#: scenario7:scenario7_D55C7EBE_B4DE_40DE_A881_F0DC1A124062
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: a61749bd21a70652d7a3f67738c5c4b7aa8504869385d9fa28cdda20e2982f60
#. default-sha256: b8c46a8ea5cc99681561022637686056b160a95780e44f12de5899578accb427
msgctxt "scenario7:scenario7_D55C7EBE_B4DE_40DE_A881_F0DC1A124062"
msgid ""
"⟪k:0⟫but seeing her there through my cloudy eyes, I wanted to apologize for ever thinking "
"spending time with her was agonizing."
msgstr ""
"⟪k:0⟫mas ao vê-la ali através dos meus olhos turvos, queria me desculpar por ter pensado que "
"passar tempo com ela era agonizante."

#: scenario7:scenario7_E8A1882A_69ED_4483_985D_36EC44A05515
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 7bc8a98d260d9322c7588cf9213abdfa862534074074a577435c3a27babf1e0b
#. default-sha256: 2defafbad40ad0de06a4a3a5f7ad89e178b205cecbb0466bbf7e8d13446baff7
msgctxt "scenario7:scenario7_E8A1882A_69ED_4483_985D_36EC44A05515"
msgid "⟪k:0⟫How are you feeling?⟪k:1⟫⟪k:2⟫Your mother’s here for you. Don’t worry."
msgstr "⟪k:0⟫Como está se sentindo?⟪k:1⟫⟪k:2⟫Sua mãe está aqui para você. Não se preocupe."

#: scenario7:scenario7_4BFC0A0A_CF7B_43E8_AFE0_C0BD252C0900
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 249b67b97b0e0076794d36a435394e634206d68c17495fb7bc78fab63f77c353
#. default-sha256: 944f7bbdcc5dc5c3eb661ffc52ba3fdcfb8b366c6570dc8f342562cc40ae6386
msgctxt "scenario7:scenario7_4BFC0A0A_CF7B_43E8_AFE0_C0BD252C0900"
msgid "⟪k:0⟫But the only sound that came from my mouth was a faint gasp."
msgstr "⟪k:0⟫Mas o único som que saiu da minha boca foi um leve suspiro."

#: scenario7:scenario7_ABF6BBD6_A164_4D4A_9737_D1FF16AD80E6
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 2f37a785addc55da968fd4286ea3f54b58fa28164d6ea392ef93f27046ca47ca
#. default-sha256: 73cbc251f08dae6b58ac1c1b67fa7ef798bf2c6b5adcdb47e172d4949f380312
msgctxt "scenario7:scenario7_ABF6BBD6_A164_4D4A_9737_D1FF16AD80E6"
msgid "⟪k:0⟫I drifted in and out of sleep, Mother’s hand wrapped around my own."
msgstr "⟪k:0⟫Eu vagava dentro e fora do sono, a mão de Mãe envolvendo a minha."

#: scenario7:scenario7_BE583775_9281_49FD_AD87_8E850FF4C7F2
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 639e22ca5098373589f432e049ec4f0c6752d67495fbb6bd53b4c01212363de8
#. default-sha256: 38be7f4341a7376f096624bb9bbeebdaeda69c7f4c5073af1d5a342c1e5b8cfc
msgctxt "scenario7:scenario7_BE583775_9281_49FD_AD87_8E850FF4C7F2"
msgid "⟪k:0⟫And I had numerous dreams."
msgstr "⟪k:0⟫E tive vários sonhos."

#: scenario7:scenario7_A98538DF_E530_42E4_857B_6E0DB5206773
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 998c701f0a83e6d49e2c19fdf0088536865ba40c821fe055f8d513ae078776f1
#. default-sha256: 759096e0ebde937628bb6d0ea1aa89fe5fccca082530c9a366c5fae0dbe45143
msgctxt "scenario7:scenario7_A98538DF_E530_42E4_857B_6E0DB5206773"
msgid "⟪k:0⟫⟪k:1⟫⟪k:2⟫In my dreams, I was a man."
msgstr "⟪k:0⟫⟪k:1⟫⟪k:2⟫Nos meus sonhos, eu era um homem."

#: scenario7:scenario7_17B971C9_54DD_4ECA_879A_10A0738677A7
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 57c57a1c6b2b7ad4956f64d3fe5ad52d9631d35cf514c174ed94777b1dd8dcb0
#. default-sha256: a85c4507b206a3648c136a38766810b34934ca40d87d95ebed01272bab1576eb
msgctxt "scenario7:scenario7_17B971C9_54DD_4ECA_879A_10A0738677A7"
msgid "⟪k:0⟫⟪k:1⟫⟪k:2⟫In my dreams, I was Didier and I was Georges."
msgstr "⟪k:0⟫⟪k:1⟫⟪k:2⟫Nos meus sonhos, eu era Didier e eu era Georges."

#: scenario7:scenario7_56939500_E8C9_47AA_ADD1_22312681BFA3
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 4b70878e7cca1c4984b97602649c2a4b20c4a95ad735e9833c02d3d9a0f8a042
#. default-sha256: c3d2d222e3f51a566eb5a0973113d7006489ed5663a1fee8b9e9f82f7d5225a6
msgctxt "scenario7:scenario7_56939500_E8C9_47AA_ADD1_22312681BFA3"
msgid "⟪k:0⟫⟪k:1⟫⟪k:2⟫In my dreams, I fell in love with Aimee,"
msgstr "⟪k:0⟫⟪k:1⟫⟪k:2⟫Nos meus sonhos, me apaixonei por Aimee,"

#: scenario7:scenario7_3D45B051_380A_4FD6_96A7_200F6F0BFD4C
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: bc93950f54704317957fe53a127bb0a7eb0e06e56936efeea54bf571030dba29
#. default-sha256: 843060981b742bf9cd66fea6eb83b2c25af23e463a047083cd8483f32ef46cea
msgctxt "scenario7:scenario7_3D45B051_380A_4FD6_96A7_200F6F0BFD4C"
msgid "⟪k:0⟫⟪k:1⟫⟪k:2⟫and in my dreams, I loved her."
msgstr "⟪k:0⟫⟪k:1⟫⟪k:2⟫e nos meus sonhos, eu a amei."

#: scenario7:scenario7_1A60B55F_1C1C_4AD1_8561_832959556D49
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 3a13d465bd4f1cf177be99c217c273ca51409fc1ca0d83ac09f74656a5bba84b
#. default-sha256: b4bcbcfb1f7abdad374afc3d7caaa733e7b9cb5091787f5e86bb9addfdb10b30
msgctxt "scenario7:scenario7_1A60B55F_1C1C_4AD1_8561_832959556D49"
msgid "⟪k:0⟫⟪k:1⟫⟪k:2⟫You’re disgusting."
msgstr "⟪k:0⟫⟪k:1⟫⟪k:2⟫Você é nojenta."

#: scenario7:scenario7_9495A7DD_8CBA_48AE_A956_46AAABF77D9A
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
