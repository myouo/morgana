msgid "⟪k:0⟫⟪k:1⟫⟪k:2⟫............"
msgstr "⟪k:0⟫⟪k:1⟫⟪k:2⟫............"

#: badend3:badend3_5E64EA09_117B_4525_A7F3_166A536C201C
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 1ea07270dca1a835080cd99e0babff1f753b3398233f5b046f355cfd299bddb0
#. default-sha256: 4134460502d8b4c4cf6e849d113434a140759c881ef03487d2cfab0ff698d995
msgctxt "badend3:badend3_5E64EA09_117B_4525_A7F3_166A536C201C"
msgid "⟪k:0⟫⟪k:1⟫Hehehe. I am getting excited now.⟪k:2⟫⟪k:3⟫What should we do first?"
msgstr "⟪k:0⟫⟪k:1⟫Hehehe. Estou ficando animada agora.⟪k:2⟫⟪k:3⟫O que deveríamos fazer primeiro?"

#: badend3:badend3_432A5F2E_31DA_49C2_A4E2_ABE599E5AE13
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 0d70143dfbb45e0c5434e4242136c31f9bcba061d936dd99f1be241a6afdd62b
#. default-sha256: 6afcd430a0896289f86e06649b180e049aad860143fc80a430c7dfaaa1e8a2c0
msgctxt "badend3:badend3_432A5F2E_31DA_49C2_A4E2_ABE599E5AE13"
msgid ""
"⟪k:0⟫⟪k:1⟫Oh, I know. We should throw a party in commemoration of your decision to remain here "
"with me."
msgstr ""
"⟪k:0⟫⟪k:1⟫Ah, eu sei. Devíamos dar uma festa em comemoração à sua decisão de ficar aqui comigo."

#: badend3:badend3_BF9EC4E9_3B95_4859_AFAD_0E0CCD71D182
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 1e62c63cb99baaa5a1d3fb8bccb56caa6446780770d8a258e35f9bea50c7858e
#. default-sha256: c5a2e268313327862914b28f55f8da0931aacf5c4ec929adb7ce2f91bdb1c8f2
msgctxt "badend3:badend3_BF9EC4E9_3B95_4859_AFAD_0E0CCD71D182"
msgid "⟪k:0⟫I shall prepare the most wonderful feast, my sweet girl."
msgstr "⟪k:0⟫Eu prepararei o mais maravilhoso banquete, minha doce menina."

#: badend3:badend3_4180AD12_835B_41D8_983B_14CDBAD51201
