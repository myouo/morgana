msgctxt "badend3:badend3_1CBBB369_2794_43B9_9D76_29CBF71151CD"
msgid "⟪k:0⟫⟪k:1⟫I..."
msgstr "⟪k:0⟫⟪k:1⟫Eu..."

#: badend3:badend3_7617E012_B4C3_4E0E_9BDF_9A7BF2BC9F7F
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 5566f10e488cd8785f856c912740e5e914b3d32d69b1d7e7c45d583d861a66bd
#. default-sha256: 53030daef521461828bf00469588ed84d27b519a3d5c24adc2a9e73933dd4b42
msgctxt "badend3:badend3_7617E012_B4C3_4E0E_9BDF_9A7BF2BC9F7F"
msgid "⟪k:0⟫⟪k:1⟫Of course you may."
msgstr "⟪k:0⟫⟪k:1⟫Claro que você pode."

#: badend3:badend3_B66E0276_AEE5_48AA_84C5_BBE775A309AE
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: bb84a26da333e5c6445c2a6ec7cec290c22f0c4b8f5c1c7744f80d91b49e7bc5
#. default-sha256: 851bef1b23bf29cdeda4cf10037e10dc452e6185660dd5d4b155239e5a9e414d
msgctxt "badend3:badend3_B66E0276_AEE5_48AA_84C5_BBE775A309AE"
msgid ""
"⟪k:0⟫⟪k:1⟫I was the one who asked you...⟪k:2⟫⟪k:3⟫to forget about everything and live in eternal "
"darkness with me."
msgstr ""
"⟪k:0⟫⟪k:1⟫Fui eu quem te pediu...⟪k:2⟫⟪k:3⟫para esquecer tudo e viver na escuridão eterna comigo."

#: badend3:badend3_889CF03A_8988_4A6B_9154_05B232166190
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 6edc4a387f5c9cfef45df7a7ab026c87b20c14de0a8050311a278eed4c95f6bc
#. default-sha256: 0bec7ab5d06df13ceb6f0169f3986d94290dd1c4f4fe376d42512e113786154f
msgctxt "badend3:badend3_889CF03A_8988_4A6B_9154_05B232166190"
msgid "⟪k:0⟫⟪k:1⟫Hehe... ⟪k:2⟫what a silly question.⟪k:3⟫⟪k:4⟫Did you think I would ever say no?"
msgstr "⟪k:0⟫⟪k:1⟫Hehe... ⟪k:2⟫que pergunta boba.⟪k:3⟫⟪k:4⟫Você achou que eu diria não?"

#: badend3:badend3_CD69DE7F_D1E0_4D28_A5A9_DD42EFFE124E
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 39c0e93329f60a83b73e46ee3edd9cee836203fc6af66970bef729a512d7ea0c
#. default-sha256: 1c812955ab9bac78e3a90e06d812791e1961c834f796f1436b7f9a497f0f3238
msgctxt "badend3:badend3_CD69DE7F_D1E0_4D28_A5A9_DD42EFFE124E"
msgid "⟪k:0⟫⟪k:1⟫⟪k:2⟫............"
msgstr "⟪k:0⟫⟪k:1⟫⟪k:2⟫............"

#: badend3:badend3_58A47977_610A_406A_A124_07F807C0BEC9
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: b941ae257f9725157b9de77ba0d243923ab4913378407c3f5be98b0c5f4d4f56
#. default-sha256: a655d79e9838e28292e4e47781105ebf08d2c85a19e06b0ede460fc092d12596
msgctxt "badend3:badend3_58A47977_610A_406A_A124_07F807C0BEC9"
msgid "⟪k:0⟫Right...⟪k:1⟫⟪k:2⟫You did, didn’t you?"
msgstr "⟪k:0⟫Certo...⟪k:1⟫⟪k:2⟫Você pediu, não pediu?"

#: badend3:badend3_BCB801E7_1364_4128_8DD0_6657F4D6B165
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: eb1add4e2107d851337a9198acc85ee44cb25a56130dfcd1c382ef77ba5f679f
#. default-sha256: 4158abc11e0bbe8a86763362ecf79135e67917ff3c084136f7f70949405ff3cf
msgctxt "badend3:badend3_BCB801E7_1364_4128_8DD0_6657F4D6B165"
msgid ""
"⟪k:0⟫⟪k:1⟫Yes, I did. ⟪k:2⟫Worry not, I will banish the memory.⟪k:3⟫⟪k:4⟫I am sure you were "
"simply disoriented at having learned who you are."
msgstr ""
"⟪k:0⟫⟪k:1⟫Sim, eu pedi. ⟪k:2⟫Não se preocupe, eu banirei essa memória.⟪k:3⟫⟪k:4⟫Tenho certeza de "
"que ficou simplesmente desorientado por ter descoberto quem você é."

#: badend3:badend3_A1187E10_34D3_4C5E_8103_EA7C68FA9C4A
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: bf323f02028ea7883931470f958399072b7dc08545e59ed8027c58abb339689e
#. default-sha256: eb919e29f7da019a1af4449a4e26424e17af9d0ea69a722d3536f26ae6cc3872
msgctxt "badend3:badend3_A1187E10_34D3_4C5E_8103_EA7C68FA9C4A"
msgid "⟪k:0⟫⟪k:1⟫There is nothing to fear.⟪k:2⟫⟪k:3⟫Only happiness awaits you."
msgstr "⟪k:0⟫⟪k:1⟫Não há nada a temer.⟪k:2⟫⟪k:3⟫Só a felicidade te espera."

#: badend3:badend3_3F28DBBC_B943_4C4C_B38C_3B9F909A66AC
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 39c0e93329f60a83b73e46ee3edd9cee836203fc6af66970bef729a512d7ea0c
#. default-sha256: 1c812955ab9bac78e3a90e06d812791e1961c834f796f1436b7f9a497f0f3238
