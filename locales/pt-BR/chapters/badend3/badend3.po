#: badend3:badend3_F205E639_DF0B_4F13_BC4F_A7D8A77FE9A0
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: db7ed5e13f5862f96bf0a8b097d33bb90e019742e8e02a11c1f40fd4c512a255
#. default-sha256: 05eadf2400d554a2e695955d0ef3dd35df6867863e8da14782f60ff8c7eac9e6
msgctxt "badend3:badend3_F205E639_DF0B_4F13_BC4F_A7D8A77FE9A0"
msgid ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫I would just ask you to allow me one thing...⟪k:3⟫⟪k:4⟫To remain by your side."
msgstr ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫Eu só queria pedir que me permitisse uma coisa...⟪k:3⟫⟪k:4⟫Permanecer ao seu lado."

#: badend3:badend3_1CBBB369_2794_43B9_9D76_29CBF71151CD
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 292dfa58afc5ee02f14ae70af236377c82d0099b1ed0fb01fab3fc9450424854
