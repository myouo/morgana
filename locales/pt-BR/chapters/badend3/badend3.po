msgid "⟪k:0⟫⟪k:1⟫⟪k:2⟫............"
msgstr "⟪k:0⟫⟪k:1⟫⟪k:2⟫............"

#: badend3:badend3_63F96811_C8E8_4907_87B9_416FA37B0D60
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 9a9801ac31932cac7cc476e903c1e37ccf3dad3ccf0ef8d664f2c06bed6b0a9e
#. default-sha256: 5a4aedb5b31f1d06fe615f925858a648c333906b478bdf3bee3e8854e95cb82f
msgctxt "badend3:badend3_63F96811_C8E8_4907_87B9_416FA37B0D60"
msgid ""
"⟪k:0⟫No, mine is a more cowardly fear.⟪k:1⟫⟪k:2⟫I’m just afraid she’ll no longer take my hand."
msgstr ""
"⟪k:0⟫Não, o que tenho é um medo mais covarde.⟪k:1⟫⟪k:2⟫Só tenho medo que ela não pegue mais minha "
"mão."

#: badend3:badend3_9B32C9AE_4431_40EB_8BDD_4E5E2BDCC447
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 2aebfbda608046b84096761ff173ded3a30f49904a043c8b7be364d244306a00
#. default-sha256: 75829c87a833d2daa11f5d2c24d69355f22ec2e100155a04fc0281bbf7f2d163
msgctxt "badend3:badend3_9B32C9AE_4431_40EB_8BDD_4E5E2BDCC447"
msgid "⟪k:0⟫⟪k:1⟫All right... ⟪k:2⟫then..."
msgstr "⟪k:0⟫⟪k:1⟫Tudo bem... ⟪k:2⟫então..."

#: badend3:badend3_F984F247_AA15_40B3_9095_233FAF5E052E
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 5586a1f958453422918ce47c9f5187fb67e3732090e5039774fe6b6e8b5d4cae
#. default-sha256: ce13333746691ddb2ca5eead053b216bf5abadb244154315128a32ba690d2b43
msgctxt "badend3:badend3_F984F247_AA15_40B3_9095_233FAF5E052E"
msgid "⟪k:0⟫What should have been behind the door... ⟪k:1⟫was our life together."
msgstr "⟪k:0⟫O que deveria estar atrás da porta... ⟪k:1⟫era a nossa vida juntos."

#: badend3:badend3_F35D6B1C_3494_447D_A012_22EF8C656B19
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 0923170572b7e929e6ea96d8f389130b1aa8909beb4f3fd6a95c8ff0e96f42e7
#. default-sha256: 6a93fe29b28a846cee19b5c36ef4bcb0f9b55752b7dca4ac6b6ee047f59387e9
msgctxt "badend3:badend3_F35D6B1C_3494_447D_A012_22EF8C656B19"
msgid ""
"⟪k:0⟫But for her, there’s nothing but misery there anymore.⟪k:1⟫⟪k:2⟫In our time together, and in "
"me."
msgstr ""
"⟪k:0⟫Mas para ela, não há mais nada além de miséria.⟪k:1⟫⟪k:2⟫No nosso tempo juntos e em mim."

#: badend3:badend3_B135271A_95CE_45F0_A7ED_3B803136CB56
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 93ae1f7047f3f66cb2db37c4b8a2304e47629cd1222edc3feb13220d156705b4
#. default-sha256: f026ece2d4da8f67cfd7382e9e2935721dcf6ef3630d47c703fa8beba268bdb1
msgctxt "badend3:badend3_B135271A_95CE_45F0_A7ED_3B803136CB56"
msgid ""
"⟪k:0⟫Forget everything I’ve said.⟪k:1⟫⟪k:2⟫The tale within the fourth door was the whole truth."
msgstr ""
"⟪k:0⟫Esqueça tudo o que eu disse.⟪k:1⟫⟪k:2⟫A história dentro da quarta porta era toda a verdade."

#: badend3:badend3_A6302219_4360_40D0_9A8C_5619F188455C
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 5977351324d6a1035f7b49c10ccb19d8dc1acd7ce2c7a962ed592452b21e51f7
#. default-sha256: 10b08cae12a0e969ed6ad544fbf6e7d7b0edc0b08fb2559cc6dcc0f54d8dfa6d
msgctxt "badend3:badend3_A6302219_4360_40D0_9A8C_5619F188455C"
msgid "⟪k:0⟫I can live with that."
msgstr "⟪k:0⟫Eu posso viver com isso."

#: badend3:badend3_FAF57415_6FEA_4EBA_83E5_5340DBE4ADA7
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 57db94a85badfb5b1f2df7e2478eb679be6ca44aef2976c59239381936ab4729
#. default-sha256: 6eba272befa0746d5e17298f73b93018dff10f0bac17d1ec97be3828a1c9c62d
