#: badend3:badend3_C70F299F_DA84_4B00_9E9E_EDA04274BA9A
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: e1fb42b83780b19d87e578da247f17c0a2270b40ed7f90234feea3061fb2e71d
#. default-sha256: c0160bdac9bc1c992a06fe0f7dee19a7fcd61a545bdc0288353edacbc6d8eede
msgctxt "badend3:badend3_C70F299F_DA84_4B00_9E9E_EDA04274BA9A"
msgid ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫⟪k:4⟫⟪k:5⟫⟪k:6⟫⟪k:7⟫⟪k:8⟫⟪k:9⟫⟪k:10⟫⟪k:11⟫⟪k:12⟫⟪k:13⟫⟪k:14⟫⟪k:15⟫⟪k:16⟫I "
"can’t force her to do something she doesn’t want to."
msgstr ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫⟪k:4⟫⟪k:5⟫⟪k:6⟫⟪k:7⟫⟪k:8⟫⟪k:9⟫⟪k:10⟫⟪k:11⟫⟪k:12⟫⟪k:13⟫⟪k:14⟫⟪k:15⟫⟪k:16⟫Não "
"posso forçá-la a fazer algo que ela não quer."

#: badend3:badend3_74F825C4_270A_4F90_9221_8B5CA412E57C
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 795ced219f9db7ad87e6c358a8fb7a0f861d2ef7e54baf533ac6f78c1a460422
#. default-sha256: fb127eeea3c0637619c3cf43667a44dc8457bf5e78418b4110a939ba9660142b
msgctxt "badend3:badend3_74F825C4_270A_4F90_9221_8B5CA412E57C"
msgid ""
"⟪k:0⟫If she doesn’t reclaim herself on her own... ⟪k:1⟫I’ll never get to hear her say my name "
"again..."
msgstr "⟪k:0⟫Se ela não reivindicar a si mesma... ⟪k:1⟫Eu nunca mais vou ouvi-la dizer meu nome..."

#: badend3:badend3_547360EE_32D4_4534_8ED5_5D740F96586D
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 1949ed9a7cf31f5f9b60bd45b18f6d979a7ccb065cd2820656608621a98f31ae
#. default-sha256: 032910212d0b8f049ff356cae170baa9c05b407de288a20cb4f53297b6a29118
msgctxt "badend3:badend3_547360EE_32D4_4534_8ED5_5D740F96586D"
msgid ""
"⟪k:0⟫But if she wants to leave all that behind her... ⟪k:1⟫then it’s not my place to interfere."
msgstr "⟪k:0⟫Mas se ela quer deixar tudo isso para trás... ⟪k:1⟫então não cabe a mim interferir."

#: badend3:badend3_547360EE_32D4_4534_8ED5_5D740F96686D
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 06df935edd4ac6cd70f622ce2b8a31f01c8f121973ee3f63a390ae3dd050b900
#. default-sha256: 5d7c1d478bf71c218996952cdb269d64f98ab65545f4bb3ebaf0ef200b7c6372
msgctxt "badend3:badend3_547360EE_32D4_4534_8ED5_5D740F96686D"
msgid ""
"⟪k:0⟫I’ve done things that would warrant her wanting to rewrite her past, erasing me entirely."
msgstr ""
"⟪k:0⟫Eu fiz coisas que justificariam que ela quisesse reescrever seu passado, apagando-me "
"completamente."

#: badend3:badend3_14501C98_A043_4232_9EFD_BCFC5DCC400A
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 69c7dce33ebaae4cb80cdca1241a7ff1118d494b5b3603f0b370a21ba1a0591b
#. default-sha256: c3cffb1d6349afd7643f0ba02ba14dbb0f0fc465bd916b86d95bec4e40ea9490
msgctxt "badend3:badend3_14501C98_A043_4232_9EFD_BCFC5DCC400A"
msgid "⟪k:0⟫But I think, more than anything..."
msgstr "⟪k:0⟫Mas eu acho que, mais do que tudo..."

#: badend3:badend3_71304866_D2C8_406C_A8AF_B269483EF474
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 9a0e7023010e42c6a43f0271f70b81150b8f0bfc922880e0ee1d66379aabe227
#. default-sha256: 6971803b8a9bde58a1849b061181a0e644327725819eee5509b126776d008e56
msgctxt "badend3:badend3_71304866_D2C8_406C_A8AF_B269483EF474"
msgid "⟪k:0⟫I’m afraid of hurting her, of breaking her any more than she already is."
msgstr "⟪k:0⟫Tenho medo de machucá-la, de quebrá-la ainda mais do que ela já está."

#: badend3:badend3_202FBE8C_5025_42D3_AB14_844F51FDD442
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 39c0e93329f60a83b73e46ee3edd9cee836203fc6af66970bef729a512d7ea0c
#. default-sha256: 1c812955ab9bac78e3a90e06d812791e1961c834f796f1436b7f9a497f0f3238
