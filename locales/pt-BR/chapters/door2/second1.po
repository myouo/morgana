#: scenario2:scenario2_D0AD09AE_120B_46E6_95B8_2C114A440F45
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: f87eafebdb809528c080f59a1c2b41b5721c42b76ebc805ae4ab1263990af8cc
#. default-sha256: 293e0dbe3478fe94e37bf23512f5358f30bfc13fbeef7470644f7e8f91635b49
msgctxt "scenario2:scenario2_D0AD09AE_120B_46E6_95B8_2C114A440F45"
msgid "⟪k:0⟫⟪k:1⟫⟪k:2⟫Oh my.⟪k:3⟫This is quite something."
msgstr "⟪k:0⟫⟪k:1⟫⟪k:2⟫Ó céus.⟪k:3⟫O que temos aqui?"

#: scenario2:scenario2_7D398619_A634_4060_A0C0_05D4DFC99173
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: ebf005dfa63a97cbe3c762cc15c3fe3dc5c3d6c8b91569bf7187290f4cd6b636
#. default-sha256: 4589078d498039cfde58c104a6fa7d2ca9b39f086e168fa27f515f225703c6f5
