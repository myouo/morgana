msgctxt "scenario2:scenario2_47547A2F_83BE_4437_861A_9135AF6DFC45"
msgid "⟪k:0⟫I was in quite the predicament."
msgstr "⟪k:0⟫Eu estava em um baita dilema."

#: scenario2:scenario2_9BDF0362_1EAE_4AA9_B4BF_FC6AADF9D3D7
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 9c11157edc072ed6e3b1a64a9fb62f9cd8c16190f4815f312e707172586853e6
