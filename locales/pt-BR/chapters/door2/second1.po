msgid "⟪k:0⟫⟪k:1⟫The very first thing I sensed was an almost unbearable stench."
msgstr "⟪k:0⟫⟪k:1⟫A primeira coisa que senti foi um fedor quase insuportável."

#: scenario2:scenario2_29CF1136_6DBF_4845_85A3_1D0EB75DE064
