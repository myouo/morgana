msgid "⟪k:0⟫Is anyone... ⟪k:1⟫Is anyone there?"
msgstr "⟪k:0⟫Tem alguém...⟪k:1⟫Tem alguém aí?"

#: scenario2:scenario2_E3B8080E_64F4_494C_8748_E633AB9B7B86
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 57ef73711b7e5dbf051da2a67948b06e423eb0d3c14a7e9cfdfbe98976d23878
#. default-sha256: 254627df902b667e8aa5240bbec821cd093e1b32be335d8605c82e334db23761
msgctxt "scenario2:scenario2_E3B8080E_64F4_494C_8748_E633AB9B7B86"
msgid "⟪k:0⟫I’ve lost my way.⟪k:1⟫⟪k:2⟫Would you please be so kind as to spare me a little food?"
msgstr "⟪k:0⟫Eu me perdi.⟪k:1⟫⟪k:2⟫Você poderia, por gentileza, me dar um pouco de comida?"

#: scenario2:scenario2_393C0C24_4D7B_48DD_9E86_86F245D56355
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 51596af1264432af090c43e2acacb30048f02e79ee154a44b56172a57079cc36
#. default-sha256: 5b9f52178399260f6259d786d23d4d88c4e22696ca86b0a88298b7fea99dc719
msgctxt "scenario2:scenario2_393C0C24_4D7B_48DD_9E86_86F245D56355"
msgid "⟪k:0⟫(Ahh, there. ⟪k:1⟫There it is.⟪k:2⟫⟪k:3⟫There comes the poor little offering.)"
msgstr "⟪k:0⟫(Ahh, aí está. ⟪k:1⟫Aí está.⟪k:2⟫⟪k:3⟫Lá vem a pobre oferenda.)"

#: scenario2:scenario2_279D4872_C4C0_47DC_8CB3_5822826870D7
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: a2a4694451251fd7109be56a665417f76d50d7c83af310b5def0e0d5df1a7a0c
#. default-sha256: 50ee8d00180cc966113e024c0fb3ef49a878fa789ac0529e53c2e98c07371132
msgctxt "scenario2:scenario2_279D4872_C4C0_47DC_8CB3_5822826870D7"
msgid ""
"⟪k:0⟫(They never learn.⟪k:1⟫⟪k:2⟫They just keep coming, again and again.⟪k:3⟫⟪k:4⟫The mansion "
"keeps granting my wish.)"
msgstr ""
"⟪k:0⟫(Eles nunca aprendem.⟪k:1⟫⟪k:2⟫Continuam vindo, de novo e de novo.⟪k:3⟫⟪k:4⟫A mansão "
"continua concedendo meu desejo.)"

#: scenario2:scenario2_AAC6CF58_B448_4F28_812F_98CBE17BDAD9
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 132ce120eeca91de4348d282f7c3a9ec9e81cb5703789dfd2913e5bb1fabfab3
