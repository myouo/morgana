#: scenario2:scenario2_D22FE458_8A7D_4673_90FE_7646580B8285
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: eb055a31afe53505613c6cb06040ad61c88cb2b767d65738eba8aee78557093a
#. default-sha256: 8272f807dff4710cb06656a4f5520dae266ae0ec415603aa9ca1fd8c9050846d
msgctxt "scenario2:scenario2_D22FE458_8A7D_4673_90FE_7646580B8285"
msgid "⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫His psyche drifted erratically between human and beast."
msgstr "⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫Sua psique oscilava erraticamente entre humano e fera."

#: scenario2:scenario2_613DC2C4_840E_4A8F_9D57_5CAB67B354D1
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 2cadd044406cc23da6ee55e5551b817898a0867358ce6e8bc7f47536e67f9b9f
#. default-sha256: 4f7aaaa1cca4806ea6be3291104e04729b74f852feed3cf4fda207055c1a7cf9
msgctxt "scenario2:scenario2_613DC2C4_840E_4A8F_9D57_5CAB67B354D1"
msgid ""
"⟪k:0⟫If he accepted himself as human, it might cause memories better left buried to return to him."
msgstr ""
"⟪k:0⟫Se ele se aceitasse como humano, poderia fazer com que memórias melhor deixadas enterradas "
"voltassem para ele."

#: scenario2:scenario2_4E8DBE94_0F0F_455E_BD75_60909F199278
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 540262f9aadcbd282b647a02d0dd38ffbabbea0f8e449c56516a57985d02b56c
#. default-sha256: 2be4cbb78b1c741e8ace357d76dd7fd07499bf68ccf85a9baba20e569d6aeca4
msgctxt "scenario2:scenario2_4E8DBE94_0F0F_455E_BD75_60909F199278"
msgid ""
"⟪k:0⟫If he accepted himself as a beast, in exchange for his memories,⟪k:1⟫he would no longer be "
"able to rejoin human society."
msgstr ""
"⟪k:0⟫Se ele se aceitasse como uma fera, em troca de suas memórias,⟪k:1⟫não seria mais capaz de se "
"juntar à sociedade humana."

#: scenario2:scenario2_27E0A2EF_2853_4A32_A306_7FD78DEF8BD7
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 072474d8757bb060687f956ab2c6e4a3d7a3733fe5c98e9d6b0036dd055a651b
#. default-sha256: 41132acb86f890bae61a9798647b6e68df2f0c8ac58bb138ebf3f0f66dc78db3
msgctxt "scenario2:scenario2_27E0A2EF_2853_4A32_A306_7FD78DEF8BD7"
msgid "⟪k:0⟫The White-Haired Girl fervently supported him in these precarious times."
msgstr "⟪k:0⟫A Garota de Cabelos Brancos o amparou fervorosamente nesses tempos precários."

#: scenario2:scenario2_85DB32B0_F282_4C4F_AADE_25DF44D1793A
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: fc3bc9403e4dc394b69ed59c4ffaf27fd3930245110180dcf8f7c88d7f653ab9
#. default-sha256: 7b31749454394b78422189de6edf50ad15f4f32ee7256f069c9a8f95d9aff069
msgctxt "scenario2:scenario2_85DB32B0_F282_4C4F_AADE_25DF44D1793A"
msgid "⟪k:0⟫I was quite amazed. ⟪k:1⟫I had never imagined she would grow to be such a strong woman."
msgstr ""
"⟪k:0⟫Fiquei bastante maravilhada. ⟪k:1⟫Eu nunca imaginei que ela se tornaria uma mulher tão forte."

#: scenario2:scenario2_81BAC672_0240_4367_B8F1_AEEE5EF63437
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 78ef878649e76b51937e6450e3ba5dc9f5fefd91dfe204040b1520de84d0470c
#. default-sha256: 0a9f9c80f37ad3a4c01629d066c793678742d5a8357290629b1d12c521526237
msgctxt "scenario2:scenario2_81BAC672_0240_4367_B8F1_AEEE5EF63437"
msgid ""
"⟪k:0⟫Nevertheless, God is a cruel master. ⟪k:1⟫For what strength He gave her spiritually, He took "
"in equal part from her physically."
msgstr ""
"⟪k:0⟫No entanto, Deus é um mestre cruel. ⟪k:1⟫Pois a força que Ele deu a ela espiritualmente, Ele "
"tomou em igual parte dela fisicamente."

#: scenario2:scenario2_05F0A744_A738_48CE_AC4F_1752BD288946
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 98b76302b80de65aa73282911f45517107afd96def2988954da29cc01b1c3b6a
#. default-sha256: b0978f2a8b33032cdf92aacf5dbb90f3f91164fc248f14fb4c24566786bd70dd
msgctxt "scenario2:scenario2_05F0A744_A738_48CE_AC4F_1752BD288946"
msgid ""
"⟪k:0⟫Though she persisted, day in and day out, to stay by the man’s side, one day, she suddenly "
"fell ill."
msgstr ""
"⟪k:0⟫Embora ela perseverasse, dia após dia, em ficar ao lado do homem, um dia, ela de repente "
"adoeceu."

#: scenario2:scenario2_634710E0_4271_494D_8734_B73C81AB4A91
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 8d1ada3249d6c2d2c5efbe0d7804405dc9a69000fb193ec611ec66fd8a92e4ce
#. default-sha256: 71c80a55531b56bcf13fcaf826cc087e4c8292eb07bbdee5f528b935fda56354
msgctxt "scenario2:scenario2_634710E0_4271_494D_8734_B73C81AB4A91"
msgid ""
"⟪k:0⟫With her in the throes of a high fever and not knowing the cause, he fell into a perpetual "
"panic."
msgstr "⟪k:0⟫Com ela no auge de uma febre alta e sem saber a causa, ele caiu em um perpétuo pânico."

#: scenario2:scenario2_3AE81AF8_72E6_46B9_87D7_D2F4F26D2594
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 6f896fd4f12aac9deb79ffa8fd12ecc72129e9315662eb5f51134d8db1311a43
#. default-sha256: f30ceba2894f1e58f923cb97f2a6dc3a2a42ba493fd360b93c38af16d088bf77
msgctxt "scenario2:scenario2_3AE81AF8_72E6_46B9_87D7_D2F4F26D2594"
msgid ""
"⟪k:0⟫There was no medicine in the mansion. ⟪k:1⟫They could hardly manage to put together "
"sufficiently nutritious meals."
msgstr ""
"⟪k:0⟫Não havia remédio na mansão. ⟪k:1⟫Eles mal conseguiam preparar refeições suficientemente "
"nutritivas."

#: scenario2:scenario2_86C68658_873A_40A0_944A_3AFF8C8C15F3
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 63ae9fc118745bd5ab11889b6b5e06285448a96bc531781ce3bed27084f34291
#. default-sha256: c8af64c7ee2eada8e81280a51dbdc005f174540583026bfad0fba44292345711
msgctxt "scenario2:scenario2_86C68658_873A_40A0_944A_3AFF8C8C15F3"
msgid ""
"⟪k:0⟫Though there was no medicine, maybe there was something else that could make her feel better."
msgstr ""
"⟪k:0⟫Embora não houvesse remédio, talvez houvesse algo mais que pudesse fazê-la se sentir melhor."

#: scenario2:scenario2_781579D4_483E_40FE_AF37_18A0F7978D13
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 5271a1fb97071911512571266c81132ce9d09e27aad23555e1d2b3899f212726
#. default-sha256: f81f602ff32975403caab2702cfde547a4c696c9ed8e632a0a975dfd107eaf9d
msgctxt "scenario2:scenario2_781579D4_483E_40FE_AF37_18A0F7978D13"
msgid "⟪k:0⟫However, everything he could think of required him to leave the house."
msgstr "⟪k:0⟫No entanto, tudo o que ele conseguia pensar exigia que ele saísse da casa."

#: scenario2:scenario2_FF92B370_1B1F_450C_8CEE_E0A7058049B4
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: a1f9f137036c08937b10099638bbfe3805f8ecde70f563553d24d89d6b75d95a
