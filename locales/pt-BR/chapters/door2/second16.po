msgctxt "scenario2:scenario2_675D2378_B607_43CE_8DAB_78E22BDD345D"
msgid "⟪k:0⟫⟪k:1⟫I’m considering..."
msgstr "⟪k:0⟫⟪k:1⟫Estou considerando..."

#: scenario2:scenario2_4C48DE42_33E8_45EB_82F7_FCF9CFA52535
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: b7f2c105a16968de1159b7767a605380999564bcd46a411e345be56ca3668a9a
#. default-sha256: cb4c02fa8f54ba38e3d5d5538731e244d25940d98b448c401abb48184177e04b
msgctxt "scenario2:scenario2_4C48DE42_33E8_45EB_82F7_FCF9CFA52535"
msgid "⟪k:0⟫⟪k:1⟫visiting the village."
msgstr "⟪k:0⟫⟪k:1⟫visitar a aldeia."

#: scenario2:scenario2_5AA70BC1_FCF0_46EF_9164_F66F9D0A6DA0
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 3a31edbbdd41d1d50d501c8f5ba2a9d237bafeeec6836c007944e5607298e606
#. default-sha256: e7e5c6b10a40cb191bc0fd82a57bde4cc8b5771fd0c11e8a366946926b42c84d
msgctxt "scenario2:scenario2_5AA70BC1_FCF0_46EF_9164_F66F9D0A6DA0"
msgid "⟪k:0⟫⟪k:1⟫I see...⟪k:2⟫⟪k:3⟫You’re going to the village..."
msgstr "⟪k:0⟫⟪k:1⟫Entendo...⟪k:2⟫⟪k:3⟫Você vai para a aldeia..."

#: scenario2:scenario2_0E72AAEA_BFA9_466B_AAC8_843C1EAB28C9
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: d5e691675afc03fd4cd1c477687bc13c73009a632883581b5a4d94ab4e644169
#. default-sha256: 60bef6a2ebcc9b30373f7545a757bd7b84feb086401cc4bc9fe2225ebec52726
msgctxt "scenario2:scenario2_0E72AAEA_BFA9_466B_AAC8_843C1EAB28C9"
msgid "⟪k:0⟫⟪k:1⟫I thought I might be able to get some medicine."
msgstr "⟪k:0⟫⟪k:1⟫Achei que poderia conseguir algum remédio."

#: scenario2:scenario2_31BBE612_F46E_46E3_8340_8AC43F461A39
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 52c0ce499cccf6a7625fc1f5caf53ac26aea580f3b57ce938be8f95d4a0afafa
#. default-sha256: 7fd74fb6c1dfd0abe60e8f184feb2d2879cd3fa6973a96fce876660278057104
msgctxt "scenario2:scenario2_31BBE612_F46E_46E3_8340_8AC43F461A39"
msgid ""
"⟪k:0⟫I would prefer to bring a doctor here...⟪k:1⟫⟪k:2⟫but no one would come if they learned you "
"were in this mansion."
msgstr ""
"⟪k:0⟫Preferiria trazer um médico aqui...⟪k:1⟫⟪k:2⟫mas ninguém viria se soubesse que você está "
"nesta mansão."

#: scenario2:scenario2_4837F3A8_618A_4A41_8BCA_9F65184841C2
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: e0f140c6600c496cc8520d10b5a3096109ca7ff1489fb09a24522a99a713efdc
#. default-sha256: 0b1d9d1550242a0f5af23c3195db12eb87bba93b20d2bb6e8f0d0b194718811e
msgctxt "scenario2:scenario2_4837F3A8_618A_4A41_8BCA_9F65184841C2"
msgid "⟪k:0⟫⟪k:1⟫So..."
msgstr "⟪k:0⟫⟪k:1⟫Então..."

#: scenario2:scenario2_BF0A6369_E0B3_4637_8924_C2EC4BCA7C2F
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 5f062f19e11019ffdc7025f47a268829ec02a481b19f593a75d4302de1100c62
#. default-sha256: 27604f87459cae3b1427cd855dada47c54680df30e40568fdcefb2eb0c7b5b85
msgctxt "scenario2:scenario2_BF0A6369_E0B3_4637_8924_C2EC4BCA7C2F"
msgid "⟪k:0⟫He was planning to put on a disguise—⟪k:1⟫⟪k:2⟫to enter the village as a person."
msgstr ""
"⟪k:0⟫Ele estava planejando colocar um disfarce—⟪k:1⟫⟪k:2⟫para entrar na aldeia como uma pessoa."

#: scenario2:scenario2_7C2E41D3_243D_485A_BD38_AD1A0ADB69D8
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 8ea051dcf6d39f5af3676836ec252a7e3e36e217cdf340d09bbf0cb68a5762a6
#. default-sha256: 673a7f14c9e83cc65622294eed6a9c07d3ac1021aab08d8d24e32207454201ef
msgctxt "scenario2:scenario2_7C2E41D3_243D_485A_BD38_AD1A0ADB69D8"
msgid "⟪k:0⟫The White-Haired Girl smiled when she heard his idea."
msgstr "⟪k:0⟫A Garota de Cabelos Brancos sorriu quando ouviu sua ideia."

#: scenario2:scenario2_C3594EDB_5862_465C_8F1E_DE54E325F513
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 404b8682863b4385f3321f50d883dea3d441a24d050cbb5cc168bbac4df82289
#. default-sha256: 9350f4544ee95dc93e1f8f86f9879cb79c77827371c197a9390359c411d13b7b
msgctxt "scenario2:scenario2_C3594EDB_5862_465C_8F1E_DE54E325F513"
msgid "⟪k:0⟫She had, after all, always wanted him to think of himself as human."
msgstr "⟪k:0⟫Afinal, ela sempre quis que ele pensasse em si mesmo como humano."

#: scenario2:scenario2_70401842_E177_492C_93E8_5FA5249EBE4C
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: ffbdbc03c35dbe655c83d583a961f622a2872c1172bacee9f16976d9ddcbb297
#. default-sha256: 3021b53578b08f9f7d071d3862f2c266958967e11f88f796991eab1287d856de
msgctxt "scenario2:scenario2_70401842_E177_492C_93E8_5FA5249EBE4C"
msgid "⟪k:0⟫However, because she was so pure-hearted, she did not comprehend..."
msgstr "⟪k:0⟫No entanto, porque ela era tão pura de coração, não compreendia..."

#: scenario2:scenario2_46DD207F_F77B_462E_AE51_E870377CD651
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: c1419af123954a9bb2b21fbedb0b11133bef0c3feaa0e73c7a2590fcf09e8fb3
#. default-sha256: e87cf2eba718181e048fe12d8121d04819e453ec4426f3e65e66905155199256
msgctxt "scenario2:scenario2_46DD207F_F77B_462E_AE51_E870377CD651"
msgid "⟪k:0⟫the full extent of the slaughter he had confessed to committing."
msgstr "⟪k:0⟫a extensão do massacre que ele confessou ter cometido."

#: scenario2:scenario2_05DDE8BA_3870_4B45_BA3C_233D3FC7144F
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 653b8e10aa7934d9815d5f979ea2b094f0ae54836eda7e13ea1b034a75acb6ed
#. default-sha256: b98a99b83b316d18f1bbbcd75590ab5022cafec5ae42f79aafdde59c5983d427
msgctxt "scenario2:scenario2_05DDE8BA_3870_4B45_BA3C_233D3FC7144F"
msgid ""
"⟪k:0⟫The revenge he had taken on those who had chased him around.⟪k:1⟫⟪k:2⟫How sinister his "
"cackling and furious his reaping."
msgstr ""
"⟪k:0⟫A vingança que ele havia proporcionado àqueles que o perseguiram.⟪k:1⟫⟪k:2⟫Que sinistra foi "
"sua gargalhada e furiosa sua colheita."

#: scenario2:scenario2_571DB84B_714D_4092_9951_39A38108CD82
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 3371f54329d0cd3186e38a11432211090cfbb0d2b48f5152c8ad699550f0d9ca
#. default-sha256: b024324c7d678d163a7c0578c9c1b942e4f22032205130f9ce1ed3663a41df3e
msgctxt "scenario2:scenario2_571DB84B_714D_4092_9951_39A38108CD82"
msgid "⟪k:0⟫She did not grasp just how serious it was."
msgstr "⟪k:0⟫Ela não entendeu o quão sério foi."

#: scenario2:scenario2_82CF0A9B_B3E4_43E0_92C6_7F34EB21A356
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 9a28235f0d674cfd37c6bfaae4025b3a0caac9329ab1f024b8d403a2012e20e4
#. default-sha256: c2ab671a5e5185554035cbcc27bcb037d88d53c48818fd9b6237173923bf3e29
msgctxt "scenario2:scenario2_82CF0A9B_B3E4_43E0_92C6_7F34EB21A356"
msgid "⟪k:0⟫She had faith that Bestia had kindness in his heart."
msgstr "⟪k:0⟫Ela tinha fé que Bestia tinha bondade em seu coração."

