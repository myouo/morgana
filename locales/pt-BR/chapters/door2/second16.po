msgid "⟪k:0⟫⟪k:1⟫............"
msgstr "⟪k:0⟫⟪k:1⟫............"

#: scenario2:scenario2_001F0AE2_2F0B_404C_AA1A_D785C93AA9B9
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: e5d4866723e8ab041773dc80d8989461cd10963148c6420538c877ebf2685950
#. default-sha256: 86d67d338d66a286065221eaa9d848a0caa29f9fc9bf8a18950dc38dd5eae640
msgctxt "scenario2:scenario2_001F0AE2_2F0B_404C_AA1A_D785C93AA9B9"
msgid "⟪k:0⟫⟪k:1⟫Is there anything you would like?"
msgstr "⟪k:0⟫⟪k:1⟫Há algo que você queira?"

#: scenario2:scenario2_A0151887_D25E_4A14_BE0E_3B9B75139582
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 2c8ecad6cacc04b0f73e0a048db095d9ecb882376693f4bd1664ee463cad5874
#. default-sha256: f46ba0154f70737fcd4f834269cb922e9819ab7f17afcfcf02eda92cf33a02f1
msgctxt "scenario2:scenario2_A0151887_D25E_4A14_BE0E_3B9B75139582"
msgid "⟪k:0⟫⟪k:1⟫Anything... ⟪k:2⟫I would like...?"
msgstr "⟪k:0⟫⟪k:1⟫Algo...⟪k:2⟫que eu queira...?"

#: scenario2:scenario2_675D2378_B607_43CE_8DAB_78E22BDD345D
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 998eefdd391b6c1ea4553137bc68930786b0a4eb02a626f1df2045ed4b429999
