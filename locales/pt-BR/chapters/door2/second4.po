msgid "⟪k:0⟫I must satisfy these ⟪k:1⟫urges⟪k:2⟫!"
msgstr "⟪k:0⟫Preciso satisfazer estes ⟪k:1⟫impulsos⟪k:2⟫!"

#: scenario2:scenario2_3658F769_8C7F_480E_A8E0_F7FA9C5DE928
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 8b288f80bbd9e1ccec3c233bbd4f773dbb161d8e77eac694a6d708d4d15173c7
