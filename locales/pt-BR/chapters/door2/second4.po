#: scenario2:scenario2_AF534BF7_1E63_4858_9822_AE827236AD2A
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 8f5982f02a0eb27c40e65e6bb91fd0782a8c3ef8a68708d95fcb687aa99b92a7
#. default-sha256: 2a07295518aa3e8e89211b62968154a5f2f2979f584570cf9a8408a2dbcf1190
msgctxt "scenario2:scenario2_AF534BF7_1E63_4858_9822_AE827236AD2A"
msgid ""
"⟪k:0⟫Despite all the effort he had put into learning to act like a human,⟪k:1⟫he now ripped the "
"velvet curtains off the wall, howling shrilly..."
msgstr ""
"⟪k:0⟫Apesar de todo o esforço que ele havia feito para aprender a agir como um humano,⟪k:1⟫agora "
"arrancava as cortinas de veludo da parede, uivando estridentemente..."

#: scenario2:scenario2_BA98E10A_4FFE_4B82_BC86_489544991836
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 3097f545b391a39a1dc7a01309ca468811590ac9627017352fbb3eae257b0730
#. default-sha256: 01c3b862cd4fe75ff189600f033fd58fa0b8f5a6662f6358fa1d435b0aefb9cc
msgctxt "scenario2:scenario2_BA98E10A_4FFE_4B82_BC86_489544991836"
msgid "⟪k:0⟫stomping back and forth through the hallways,⟪k:1⟫and ravaging the garden."
msgstr "⟪k:0⟫andando de um lado para o outro pelos corredores,⟪k:1⟫e devastando o jardim."

#: scenario2:scenario2_6C475E70_A81C_4BFD_ABE3_D949B020BD8D
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 0176ff2c9fdd33850a247bde8842569cb3743a35208bdbf80703cfa9fa7be29f
#. default-sha256: 098628005cfdca1c9b1a0da589efe8440367dd6d17fac94f0c7e5e97b659e108
msgctxt "scenario2:scenario2_6C475E70_A81C_4BFD_ABE3_D949B020BD8D"
msgid "⟪k:0⟫I watched him intently, though from a distance."
msgstr "⟪k:0⟫Eu o observei atentamente, embora à distância."

#: scenario2:scenario2_76DF26B7_C79C_43E6_ABEE_EA8D8BD55483
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 236ff633db76c19c07c5801d995c70a7b347ed552d2e638b3a88769fddf57c4f
#. default-sha256: c4c35f72222b4ac5095e1b781588e45f8d923e8c64ec202272dc316367f46a60
msgctxt "scenario2:scenario2_76DF26B7_C79C_43E6_ABEE_EA8D8BD55483"
msgid "⟪k:0⟫Bestia was not merely a beast,⟪k:1⟫but an out-of-control, bloodthirsty beast."
msgstr "⟪k:0⟫Bestia não era apenas uma fera,⟪k:1⟫e sim uma fera descontrolada e sanguinária."

#: scenario2:scenario2_BB3EA482_6936_4D0F_A580_E91CE2D177F0
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 4f94b02b80df9fae6f2ebc090acf3905e0f6e01398aec22a14a13890efba8532
#. default-sha256: d85274e01c508c4670ec1a46bd706c9279227269f6990e3d15448c06e2dd4601
msgctxt "scenario2:scenario2_BB3EA482_6936_4D0F_A580_E91CE2D177F0"
msgid ""
"⟪k:0⟫Just a few days ago, we had been tending the garden together,⟪k:1⟫but that was no longer "
"possible."
msgstr ""
"⟪k:0⟫Apenas alguns dias atrás, estávamos cuidando do jardim juntos,⟪k:1⟫mas isso não era mais "
"possível."

#: scenario2:scenario2_F3463257_B8F0_4A65_9B30_63C2DAA67D32
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
