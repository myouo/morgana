msgctxt "scenario2:scenario2_74DDD056_1D04_48D8_ABCF_32277ECC01DF"
msgid "⟪k:0⟫Did I mishear you when you asked for peace?"
msgstr "⟪k:0⟫Eu me enganei ao ouvir você pedir paz?"

#: scenario2:scenario2_261F42AA_8689_4AD7_8968_57FF4EEECC49
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: bec665f0a3b166fab8b31a78fbd8fe43049c2511bf89a26304b45724820ef4a5
#. default-sha256: 48bc56b4419406ae0acf09f70150f2c709cf57cfdfeec0fc05b696657e9977f8
msgctxt "scenario2:scenario2_261F42AA_8689_4AD7_8968_57FF4EEECC49"
msgid "⟪k:0⟫⟪k:1⟫I was mistaken...⟪k:2⟫⟪k:3⟫Asking for peace won’t solve anything!⟪k:4⟫"
msgstr "⟪k:0⟫⟪k:1⟫Eu estava errado...⟪k:2⟫⟪k:3⟫Pedir paz não vai resolver nada!⟪k:4⟫"

#: scenario2:scenario2_2FB5527E_7BE5_42EC_856F_6A709DB470D9
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: b96cd643e9191dca615a52c11ea0596a30a1e6b829903b122ab02aa9fa5b3a0c
#. default-sha256: fdea6d9cb025336e99b67f1493d2c121db6f7d817c17fff231d6558f84bd0210
msgctxt "scenario2:scenario2_2FB5527E_7BE5_42EC_856F_6A709DB470D9"
msgid ""
"⟪k:0⟫Blood! Despair! Eyes filled with terror!⟪k:1⟫⟪k:2⟫⟪k:3⟫These⟪k:4⟫ are the things I need!"
msgstr ""
"⟪k:0⟫Sangue! Desespero! Olhos cheios de terror!⟪k:1⟫⟪k:2⟫⟪k:3⟫Essas⟪k:4⟫ são as coisas de que eu "
"preciso!"

#: scenario2:scenario2_7BEAD8C7_5402_4EAA_B237_D81D80A53B63
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 1530c686ae59f31cd07a61ed7ab73804b23006de30efe4178fb69c3046c5c9a1
