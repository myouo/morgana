#: scenario2:scenario2_111F5064_ADFE_466A_A14C_A75FD5928ADF
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: d8b05e43aa60ecb7a86f0094b73b3c76a9f7edfac2ff7f3e5760611084e03fa0
#. default-sha256: 47b3460063c663743ac4a3d1928c5a7f7cf19871970a3b2dcde438e0e8875d86
msgctxt "scenario2:scenario2_111F5064_ADFE_466A_A14C_A75FD5928ADF"
msgid "⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫⟪k:4⟫⟪k:5⟫⟪k:6⟫⟪k:7⟫⟪k:8⟫...Master. Master."
msgstr "⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫⟪k:4⟫⟪k:5⟫⟪k:6⟫⟪k:7⟫⟪k:8⟫...Mestre. Mestre."

#: scenario2:scenario2_11F56EE0_9C38_4F29_B74A_6FCC8A325BC3
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 87bd13392cbc040627886c57602e8646bd0c760887c500ebd4ae09005d30d2ca
#. default-sha256: 71116a6e160a2ec637eee559fc2c38f768d4afdb10110bfa45b4271348cd4dd5
msgctxt "scenario2:scenario2_11F56EE0_9C38_4F29_B74A_6FCC8A325BC3"
msgid "⟪k:0⟫Ahh... ⟪k:1⟫you have awakened. ⟪k:2⟫You gave me quite the startle."
msgstr "⟪k:0⟫Ahh... ⟪k:1⟫você despertou. ⟪k:2⟫Me deu um baita susto."

#: scenario2:scenario2_89EE87C6_5B9A_4A0A_A1DF_5919B15040CC
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: fee192d955b60127ea0914386be4b3b1b6a5dc78df0bdf83297b62cee2eeaabb
#. default-sha256: 907679fcf865052236078fef1a87e4f8b22be7761b49e57abca9652477483f47
msgctxt "scenario2:scenario2_89EE87C6_5B9A_4A0A_A1DF_5919B15040CC"
msgid ""
"⟪k:0⟫Do you not remember? ⟪k:1⟫You suddenly started staring off into the distance, and you would "
"not respond to anything I said."
msgstr ""
"⟪k:0⟫Você não se lembra? ⟪k:1⟫De repente começou a olhar para o vazio e não respondia a nada que "
"eu dissesse."

#: scenario2:scenario2_1CC76CC7_F747_47C2_8887_23081832279C
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: c9ebca9f8cf57aa411824c684fd31b60297a1d44d805b1dd4b4b407af108f31d
#. default-sha256: f823c41f465036682971d01a2c404e4aa7b2ee5fde7eb28f4b69949a37cf63c7
msgctxt "scenario2:scenario2_1CC76CC7_F747_47C2_8887_23081832279C"
msgid "⟪k:0⟫Hehe. I thought you were playing a prank on me."
msgstr "⟪k:0⟫Hehe. Achei que você estava fazendo uma pegadinha comigo."

#: scenario2:scenario2_1AD64425_BDF5_4EA6_9999_FD49546236A4
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 78ae9ad78d9ebf047013f65aecbd0ee21c993541690013aaaf382752fbb7c5a3
#. default-sha256: 769f4271f93e7fa4cac7762c99e323888261311eedb7683f00503f6444b0d14b
msgctxt "scenario2:scenario2_1AD64425_BDF5_4EA6_9999_FD49546236A4"
msgid "⟪k:0⟫Your hand? ⟪k:1⟫Oh, yes, I did not let go of it."
msgstr "⟪k:0⟫Sua mão? ⟪k:1⟫Ah, sim, eu não larguei."

#: scenario2:scenario2_1A399BDF_5BE1_4A36_AB0A_D560CD523861
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: bf63a65af06df77d4837d8e7300338cbf3a0334a654f6a6b5421c9296cea2695
#. default-sha256: 28bfe867dc228fb10577d058de5c6647b49107048cc3d82fd7363b4cd6d6ad93
msgctxt "scenario2:scenario2_1A399BDF_5BE1_4A36_AB0A_D560CD523861"
msgid "⟪k:0⟫For if I had, we would be in quite the predicament."
msgstr "⟪k:0⟫Pois se eu tivesse, estaríamos em uma situação bastante difícil."

#: scenario2:scenario2_F848F63F_7A17_4B90_B2F5_A318014EACD6
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 2a111f27752e38d21320e8ceaa3ad65195b541f356c27e7b7043165764a1c31d
#. default-sha256: 7f2fa51d0e61ab0cf4e6f956120bf8856b16dd8abf536867ee6a61724cedeb4d
msgctxt "scenario2:scenario2_F848F63F_7A17_4B90_B2F5_A318014EACD6"
msgid "⟪k:0⟫Someone approaching the mansion, you say? ⟪k:1⟫You saw them?"
msgstr "⟪k:0⟫Alguém se aproximando da mansão, você diz? ⟪k:1⟫Você os viu?"

#: scenario2:scenario2_A1598863_CBF6_41E4_BCFE_3F9793B411E7
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 81655735a9badb51cfacf1d2fb89a2bb8c29752e622e57726580f0e42aa5014e
#. default-sha256: e49fe60ca03ee589f5735b6885e33be99af35ffe5024ac50fd1c1ddf95afdc2e
msgctxt "scenario2:scenario2_A1598863_CBF6_41E4_BCFE_3F9793B411E7"
msgid ""
"⟪k:0⟫Those images... ⟪k:1⟫were not shown to you by me. ⟪k:2⟫If you saw something, then it was by "
"your own powers."
msgstr ""
"⟪k:0⟫Essas imagens...⟪k:1⟫não lhe foram mostradas por mim. ⟪k:2⟫Se viu algo, então foi por seus "
"próprios poderes."

#: scenario2:scenario2_71F90BF4_07DD_4E07_A132_1B71D3313736
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 56cd63c91f747ea3b35a75a47711a56e4fa723f51a7d6bc049acea942257c7e5
#. default-sha256: 4f4834fc3a9edf48850f9990c2fa90bddd381e852d228612a8b711749fe73fb1
msgctxt "scenario2:scenario2_71F90BF4_07DD_4E07_A132_1B71D3313736"
msgid "⟪k:0⟫But if you think about it, that is nothing unusual."
msgstr "⟪k:0⟫Mas se você pensar sobre isso, não é nada incomum."

#: scenario2:scenario2_2BC8B724_D335_4767_B5CD_FCB8966C49A9
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 2dc961816793a9f37995b2ff53ae1642dba1906462df2bdb91ced6158fd00899
#. default-sha256: e452b1702a392caa01c2f36a7361a204d6fca3c998da53c2d5a62a8e719830dd
msgctxt "scenario2:scenario2_2BC8B724_D335_4767_B5CD_FCB8966C49A9"
msgid "⟪k:0⟫You are, after all, the master of this house."
msgstr "⟪k:0⟫Você é, afinal, o mestre desta casa."

#: scenario2:scenario2_1B8C40FB_85CC_4FE2_AC7E_E24F642F5E44
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: e30a54df8c8bbbcebd6365715b6da0aa95e09aad71667e8fb4e02bb308e03f4b
#. default-sha256: 4a85f03393e7031cc04d3e5b2e17ec409c89403a56b4137ac334eb1e243b128a
msgctxt "scenario2:scenario2_1B8C40FB_85CC_4FE2_AC7E_E24F642F5E44"
msgid "⟪k:0⟫You should, in all actuality, be able to do anything I can do by yourself, Master."
msgstr ""
"⟪k:0⟫Você deveria, na verdade, ser capaz de fazer qualquer coisa que eu possa fazer sozinha, "
"Mestre."

#: scenario2:scenario2_7E71B94D_DC7F_4E9D_A51F_AD26D219E9FC
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 8d12c5747c5ade7682ed753dd156514cf47d693f3c0d03ac119e18ef5cd2f8f1
#. default-sha256: 0fd25403f40820b63b23defcb09cdb29860af13456076370968fd158a18a3f89
msgctxt "scenario2:scenario2_7E71B94D_DC7F_4E9D_A51F_AD26D219E9FC"
msgid "⟪k:0⟫So it is very possible you could have knowledge that I do not."
msgstr "⟪k:0⟫Portanto, é muito possível que você tenha um conhecimento que eu não tenho."

#: scenario2:scenario2_6E2FABCA_9F64_48A0_B7E6_6CD0ADBD4555
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: bc873ba1b040c40084963a63cd1a1fdb7cba2399f6135c8146c2861b399c9228
#. default-sha256: 16e6e0f871803eba96961003efdd3b1b5774b0e8bdc4f6b8f2742fe4f3d46c81
msgctxt "scenario2:scenario2_6E2FABCA_9F64_48A0_B7E6_6CD0ADBD4555"
msgid "⟪k:0⟫Now, let us return to the mansion’s tale."
msgstr "⟪k:0⟫Agora, vamos voltar ao conto da mansão."

#: scenario2:scenario2_0F1BEE93_B1C4_4A09_B39D_E7D9E7B6F528
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 274694618829ccc7d4714704f723a0c5b844c54d62ac6a3bc302763766edcaa3
#. default-sha256: 11451214e6429cec155f01b338a1ec5da0d8e5232ee54c974547af118c3489d4
msgctxt "scenario2:scenario2_0F1BEE93_B1C4_4A09_B39D_E7D9E7B6F528"
msgid "⟪k:0⟫After the second beast paid a visit, Bestia began to destabilize again."
msgstr ""
"⟪k:0⟫Depois que a segunda fera fez uma visita, Bestia começou a se desestabilizar novamente."

#: scenario2:scenario2_9192764E_EBB3_456D_8944_942876725FB3
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 290b139dc365240545e1154dd13cdd07f240213408fd72f49e24135abe8f1301
#. default-sha256: f6e5e3f1e2cacfb813412257bed6fe695969b90954e663d9a2907038ef899996
msgctxt "scenario2:scenario2_9192764E_EBB3_456D_8944_942876725FB3"
msgid "⟪k:0⟫The White-Haired Girl would soothe his heart, but the calm was only ephemeral."
msgstr "⟪k:0⟫A Garota de Cabelos Brancos acalmaria seu coração, mas a calma era apenas efêmera."

#: scenario2:scenario2_E9596033_9464_4E27_AE7A_5F6978E107B7
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 8abf83c58421ae3af0ed1ae1a429c75089ee4b0fb396585ea024f287863beae8
#. default-sha256: 5b613889db4514458fb2281d1072cf1dded9df75960e64b012bb61f6a38919d7
msgctxt "scenario2:scenario2_E9596033_9464_4E27_AE7A_5F6978E107B7"
msgid "⟪k:0⟫He was like a cracked glass ball."
msgstr "⟪k:0⟫Ele era como uma bola de vidro rachada."

#: scenario2:scenario2_A0605F8E_692A_4C13_9EBC_6804BCFE93B3
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 816118baf81e566c0851cb4f9fa0483860151dcc1d1cef7956a99916b39fafaa
#. default-sha256: d0618af8eddaeff88fe25d001ddc757c3a829bfcbdc7428774e52ff8dc569172
msgctxt "scenario2:scenario2_A0605F8E_692A_4C13_9EBC_6804BCFE93B3"
msgid ""
"⟪k:0⟫If you dropped him, that would be the end. ⟪k:1⟫If you put too much force into handling him, "
"he would shatter. ⟪k:2⟫He was very difficult to care for."
msgstr ""
"⟪k:0⟫Se você o derrubasse, seria o fim. ⟪k:1⟫Se você colocasse muita força ao manuseá-lo, ele "
"quebraria. ⟪k:2⟫ Ele era muito difícil de cuidar."

#: scenario2:scenario2_0B4F9443_56C3_456D_B951_B6010DA695FE
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 7c32de1ba2ecf3353a733a3d763f78a699bdaf3fb891be255fc79c3124ad6a44
#. default-sha256: be3896cb5d5eca471623273a057996b8c6258696e9627b7289e8469a388b0ca9
msgctxt "scenario2:scenario2_0B4F9443_56C3_456D_B951_B6010DA695FE"
msgid ""
"⟪k:0⟫And cracks do not heal. ⟪k:1⟫The damage still remains, even if the two sides appear to be "
"held together firmly in place."
msgstr ""
"⟪k:0⟫E rachaduras não cicatrizam. ⟪k:1⟫O dano ainda permanece, mesmo que os dois lados pareçam "
"estar firmemente presos no lugar."

#: scenario2:scenario2_5A7A7FC0_467A_41A0_9F25_8AB72A3349B6
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: adbf517f404a736f86f4e453b518d97a2db750d5a25af6fe4b149b9371199310
#. default-sha256: 0abc23802833bd36c9d37b71b227366bf7f61d9b3d2af343236520dfae1e9694
msgctxt "scenario2:scenario2_5A7A7FC0_467A_41A0_9F25_8AB72A3349B6"
msgid "⟪k:0⟫Furthermore, they slowly, gradually, and without intervention spread."
msgstr "⟪k:0⟫Além do mais, elas se espalham lenta e gradualmente, sem parar."

#: scenario2:scenario2_F3BEFB24_9F16_4AFE_BBF4_CCCC02D9858D
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 01334060b07831be37e1a3a351fe84590f2682a5c0c3b802ba0bfdff423e86a2
#. default-sha256: 036a696e6200c00c3863cc645094afb5b956b55ea73436478e54b121cb06abe0
msgctxt "scenario2:scenario2_F3BEFB24_9F16_4AFE_BBF4_CCCC02D9858D"
msgid "⟪k:0⟫The beast appeared to be afraid of someone’s voice."
msgstr "⟪k:0⟫A fera parecia ter medo da voz de alguém."

#: scenario2:scenario2_3CCE8F83_81C4_47D8_99D2_C77A99D5C210
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 7ed527a9797fcd613789b41d67bd1cf6271ccddd0bb5366f6ab7c604d28e5068
#. default-sha256: 46192abd2d88edc78c6d55f274fe1bfdd11fae66b3dd354979c167297fccd4e2
msgctxt "scenario2:scenario2_3CCE8F83_81C4_47D8_99D2_C77A99D5C210"
msgid "⟪k:0⟫He would on occasion stare into empty space and shout, cover his ears, and groan."
msgstr "⟪k:0⟫De vez em quando olhava para o nada e gritava, tapava os ouvidos e gemia."

#: scenario2:scenario2_3602D6A7_C211_42BD_B283_E0DEACB10FD7
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 95d571ff353e074466ec92b939424e41c25fa6bfa6d0a4cee407e4e42b144b11
#. default-sha256: 41bac34b7eb835c60e09e9987d4c0ffff3295c649864f4165767c83a17c4c88f
msgctxt "scenario2:scenario2_3602D6A7_C211_42BD_B283_E0DEACB10FD7"
msgid ""
"⟪k:0⟫One day, he shattered all the windows in the mansion, crushed the silverware I had just "
"polished to a shine..."
msgstr ""
"⟪k:0⟫Um dia, ele quebrou todas as janelas da mansão, esmagou os talheres que eu tinha acabado de "
"polir até brilhar..."

#: scenario2:scenario2_E717A328_7A1E_4C98_AEC3_5BA798EE0BCD
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 68bee30d8e78663c22c84d97eefe471c57b5d9816a18b5f9153e18f34277436f
#. default-sha256: 2c4d6af66429c18b6240e2579349e0e3beb0d33d46fb2714de0b02ca67feb21f
msgctxt "scenario2:scenario2_E717A328_7A1E_4C98_AEC3_5BA798EE0BCD"
msgid "⟪k:0⟫and destroyed all the mirrors."
msgstr "⟪k:0⟫e destruiu todos os espelhos."

#: scenario2:scenario2_3D6268C8_5E43_4895_85B3_41C34C8C23E7
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 26ca570255e1f6051b035de9157e130c50c230ad7dea5f99d6dbf595074a9804
#. default-sha256: e1cbac0476f883dec16ba4c26f1e4b0f18fceea037730b6cbfc94ee3db406647
msgctxt "scenario2:scenario2_3D6268C8_5E43_4895_85B3_41C34C8C23E7"
msgid "⟪k:0⟫I assume he did not want to see his beastly self."
msgstr "⟪k:0⟫Suponho que ele não queria ver seu eu bestial."

#: scenario2:scenario2_E6660BE9_C4A9_4F2A_900C_9387CC154EA2
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 9b7f45feff3c767802ed0c0566ce906aa1dc776095d4479f11229bffed947cc0
#. default-sha256: 97383117b5944c24e292fe23c1852577963d9592861424cabb9c27f7a92843e3
msgctxt "scenario2:scenario2_E6660BE9_C4A9_4F2A_900C_9387CC154EA2"
msgid ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫⟪k:4⟫⟪k:5⟫⟪k:6⟫⟪k:7⟫⟪k:8⟫⟪k:9⟫More... ⟪k:10⟫There’s more!⟪k:11⟫⟪k:12⟫There’s "
"still more that reflects my image!"
msgstr ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫⟪k:4⟫⟪k:5⟫⟪k:6⟫⟪k:7⟫⟪k:8⟫⟪k:9⟫Mais...⟪k:10⟫Existem mais!⟪k:11⟫⟪k:12⟫Ainda "
"existem coisas que refletem a minha imagem!"

#: scenario2:scenario2_0E8A774D_89D2_40BB_B08E_32EBA92EA1AD
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: ab700ba478414489141e42cacd52656eee0c2b1ff65b2f02ac237848de4bfa5d
#. default-sha256: 18ca97b96378e589b61ea577cac009079ec201e2b8acb2d4765b25272e854b0a
msgctxt "scenario2:scenario2_0E8A774D_89D2_40BB_B08E_32EBA92EA1AD"
msgid "⟪k:0⟫Windows! Mirrors! Vases! Dishes!⟪k:1⟫They all show my reflection!"
msgstr "⟪k:0⟫Janelas! Espelhos! Vasos! Pratos!⟪k:1⟫Todos eles mostram meu reflexo!"

#: scenario2:scenario2_30E1C98F_85D0_415D_9596_F850209C4998
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: b243a57d037e7ead8a9bb1534a9f20dd8c62cc9aef7578cadbd292604d68059a
#. default-sha256: 8351304a2ca9dc4fdcc03a24a5a6de1566e1eac83b6e4cbb6e6a269a16b761f2
msgctxt "scenario2:scenario2_30E1C98F_85D0_415D_9596_F850209C4998"
msgid "⟪k:0⟫⟪k:1⟫⟪k:2⟫Wh-⟪k:3⟫What are you doing?"
msgstr "⟪k:0⟫⟪k:1⟫⟪k:2⟫Que-⟪k:3⟫O que você está fazendo?"

#: scenario2:scenario2_F54E30E6_55AA_42BA_AD2E_92886CDE897F
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 02c30cfe8e60a0efb2c2a87b51da931a048c9d3d245d1764dcd37c13ad14e322
#. default-sha256: d613d9ff452b4d143e5d2a2e9dd577dd905ecd056e61292ad536d4adefea0095
msgctxt "scenario2:scenario2_F54E30E6_55AA_42BA_AD2E_92886CDE897F"
msgid ""
"⟪k:0⟫⟪k:1⟫I have no need of anything that reflects me!⟪k:2⟫You can understand that, can’t you?!"
msgstr "⟪k:0⟫⟪k:1⟫Não preciso de nada que me reflita!⟪k:2⟫Você pode entender isso, não pode?!"

#: scenario2:scenario2_C37A06CA_F7DA_4690_930A_171C363FC46F
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
