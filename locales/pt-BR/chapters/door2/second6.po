msgctxt "scenario2:scenario2_B9787E55_09F7_40B2_B99F_E1824044313A"
msgid ""
"⟪k:0⟫(I don’t want you to know how many people I’ve tortured,⟪k:1⟫how many I’ve slaughtered, how "
"much blood I’ve imbibed...)"
msgstr ""
"⟪k:0⟫(Eu não quero que você saiba quantas pessoas eu torturei,⟪k:1⟫quantos eu massacrei, quanto "
"sangue eu bebi...)"

#: scenario2:scenario2_FF7D2F93_0EE1_4904_82BC_CFBF1E4C29EF
