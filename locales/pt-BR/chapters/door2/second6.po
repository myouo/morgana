msgstr "⟪k:0⟫⟪k:1⟫Não...⟪k:2⟫⟪k:3⟫"

#: scenario2:scenario2_FA13F74E_6111_4089_8272_900D124FD583
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: fa90f45dd694749ce6263b0d48d6a85aba2e0e42ab1090afc56915a4e2bc8867
#. default-sha256: 1282ff2255245e979de9406f36f0c18fdae9d5863508bb95d593e494f5182abe
msgctxt "scenario2:scenario2_FA13F74E_6111_4089_8272_900D124FD583"
msgid ""
"⟪k:0⟫(But you ⟪k:1⟫would⟪k:2⟫. ⟪k:3⟫If you could see me,⟪k:4⟫you would react the same as everyone "
"else.⟪k:5⟫⟪k:6⟫You would mock me; ⟪k:7⟫you would despise me;⟪k:8⟫you would want to kill me.)"
msgstr ""
"⟪k:0⟫(Mas você ⟪k:1⟫teria⟪k:2⟫. ⟪k:3⟫Se você pudesse me ver,⟪k:4⟫você reagiria da mesma forma que "
"todos os outros.⟪k:5⟫⟪k:6⟫Você zombaria de mim;⟪k:7⟫você me desprezaria;⟪k:8⟫você iria querer me "
"matar.)"

#: scenario2:scenario2_ADED7667_51B0_42A8_966B_728429B71DF1
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 887103f7aead464667e8485e6e54ef25fc96739efe501d7d73b8a90776df4911
