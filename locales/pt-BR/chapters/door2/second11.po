msgid "⟪k:0⟫⟪k:1⟫I remember that day clear as crystal."
msgstr "⟪k:0⟫⟪k:1⟫Eu me lembro daquele dia claramente."

#: scenario2:scenario2_E78553CD_4C95_4319_A3B1_62E2A964DE0C
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 0ae7d03cedcaacf717065062b340af21e0f114ee56253a485cad43e7440390f1
#. default-sha256: 02ed16b7a90af26acda0b04af405edf38e3bc22c82996266851fd58d9a71fe0c
msgctxt "scenario2:scenario2_E78553CD_4C95_4319_A3B1_62E2A964DE0C"
msgid ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫⟪k:4⟫⟪k:5⟫⟪k:6⟫⟪k:7⟫⟪k:8⟫⟪k:9⟫Ah, yes, I have to say, the food here is ⟪k:10⟫"
"spectacular⟪k:11⟫.⟪k:12⟫⟪k:13⟫And I love that they give you so much meat.⟪k:14⟫⟪k:15⟫Though I "
"thought my gut’d explode the first time I saw it, hahaha!"
msgstr ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫⟪k:4⟫⟪k:5⟫⟪k:6⟫⟪k:7⟫⟪k:8⟫⟪k:9⟫Ah, sim, devo dizer, a comida aqui é ⟪k:10⟫"
"espetacular⟪k:11⟫.⟪k:12⟫⟪k:13⟫E eu adoro que sirvam tanta carne.⟪k:14⟫⟪k:15⟫Embora eu tenha "
"achado que minhas tripas fossem explodir da primeira vez que vi, hahaha!"

#: scenario2:scenario2_525F4CC9_9163_4241_937D_1FD6C484547A
