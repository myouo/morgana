msgid "⟪k:0⟫It’s hot."
msgstr "⟪k:0⟫Está quente."

#: scenario2:scenario2_48688F6C_4A2D_4F6F_8035_0F50B05DBDCA
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: d977877b7fc314664380af25f0303b3b817e861bcacfc8883f3357162e57b322
#. default-sha256: e226af4ddf7942aea0897d5ce43cff2eeec2fdf0361bb0659c5f3d78a8739a32
msgctxt "scenario2:scenario2_48688F6C_4A2D_4F6F_8035_0F50B05DBDCA"
msgid ""
"⟪k:0⟫My parents’ relationship is on thin ice, but the air feels like it’s on fire. ⟪k:1⟫It’s much "
"too hot."
msgstr ""
"⟪k:0⟫O relacionamento dos meus pais está em gelo fino, mas o ar parece estar pegando fogo. ⟪k:1⟫"
"Está quente demais."

#: scenario2:scenario2_9E8AA447_803D_4FF2_867B_0D87BF0DBCA8
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 79cc3f709542c39e8f3caa3854dfa340233cb667a028ff6da66f7398d8a8c150
#. default-sha256: c09ccda5eaa892f91386a7cc475278a0a021fb2a456e2ddbe92efe03c0d14137
msgctxt "scenario2:scenario2_9E8AA447_803D_4FF2_867B_0D87BF0DBCA8"
msgid ""
"⟪k:0⟫My dad loves this seaside restaurant. ⟪k:1⟫It actually specializes in fish, but he always "
"asks for meat."
msgstr ""
"⟪k:0⟫Meu pai ama este restaurante à beira-mar. ⟪k:1⟫Na verdade é especializado em peixe, mas ele "
"sempre pede carne."

#: scenario2:scenario2_7568A884_1212_4814_AD60_5BB3B1D66CA4
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: b6cc3e00ee959f6e2c3f27b299f8107f2d07219f1c6d53f8b49920a22783ab22
#. default-sha256: 28b04bdbcbd2752f9023492181f3d09a2b8c7d0e67d4eb2e78ece22e76b46035
msgctxt "scenario2:scenario2_7568A884_1212_4814_AD60_5BB3B1D66CA4"
msgid ""
"⟪k:0⟫Though “always” isn’t very often. He’s out of the country most of the time, so we rarely eat "
"together as a family."
msgstr ""
"⟪k:0⟫Embora “sempre” não aconteça com muita frequência. Ele fica fora do país a maior parte do "
"tempo, então raramente comemos juntos como família."

#: scenario2:scenario2_4714BF7B_C21A_4DE6_A54C_A5E914690614
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 6e7b8cd769edc97510a31e0e2a3bc90886c6a9a1f85b252fe4e605e05f755740
#. default-sha256: 8ac837f29c8acc1dd247a35e9f819cd577e4ba3e60f4d36dd510de60a8afd031
msgctxt "scenario2:scenario2_4714BF7B_C21A_4DE6_A54C_A5E914690614"
msgid "⟪k:0⟫For that reason, I can usually put up with a little heat for a family gathering..."
msgstr ""
"⟪k:0⟫Por essa razão, normalmente consigo suportar um pouco de calor por uma reunião familiar..."

#: scenario2:scenario2_661F5F0B_7579_4EB8_8409_389E7F436747
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
