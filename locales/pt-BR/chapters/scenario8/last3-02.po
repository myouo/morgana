msgid "⟪k:0⟫⟪k:1⟫⟪k:2⟫Oh, ⟪k:3⟫uh, ⟪k:4⟫yeah... ⟪k:5⟫a bit..."
msgstr "⟪k:0⟫⟪k:1⟫⟪k:2⟫Ah, ⟪k:3⟫uh, ⟪k:4⟫sim... ⟪k:5⟫um pouco..."

#: scenario8:scenario8_456D81FB_F82E_47BD_97A1_82A739013DE9
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: a3a3fe34fafae237c90937b48fe6bba05db1996d13d7461811dd6188f44f17f5
