msgid "⟪k:0⟫⟪k:1⟫⟪k:2⟫Whatever you say..."
msgstr "⟪k:0⟫⟪k:1⟫⟪k:2⟫Se você diz..."

#: scenario8:scenario8_9595E7DE_C5BA_4AE0_81B9_A11C331F0E2D
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 7edfb88e88b2b37aed3e3e177859a4c9ce766277cda30154267a73715bce2ee8
#. default-sha256: b998c5c960adedfbd5ee412a664c48fefd162084373f3d76fa47aa45727a99d2
msgctxt "scenario8:scenario8_9595E7DE_C5BA_4AE0_81B9_A11C331F0E2D"
msgid ""
"⟪k:0⟫⟪k:1⟫Forget about all that stuff at home.⟪k:2⟫⟪k:3⟫We’ve got each other! We can do this!"
msgstr ""
"⟪k:0⟫⟪k:1⟫Esqueça tudo aquilo que aconteceu lá em casa.⟪k:2⟫⟪k:3⟫Nós temos um ao outro! Nós "
"podemos fazer isso!"

#: scenario8:scenario8_85C710CC_5FC8_4871_A087_9B1BF1901128
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 52f8c284ef9463c901dea856c501c58d5f5319879b9fa4783942f50767bb00fa
#. default-sha256: 46ce5364bfe4040c9a4716ad7d22b0594fa5b459bdf43b70a09c10a81873b1a1
msgctxt "scenario8:scenario8_85C710CC_5FC8_4871_A087_9B1BF1901128"
msgid "⟪k:0⟫⟪k:1⟫It’ll all work out, dearest Mell.⟪k:2⟫⟪k:3⟫I’ll always be here for you."
msgstr "⟪k:0⟫⟪k:1⟫Tudo vai dar certo, querido Mell.⟪k:2⟫⟪k:3⟫Eu sempre estarei aqui por você."

#: scenario8:scenario8_0D01B5C2_D45E_475E_B13F_467EE109DEE2
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 2efff7dd12165d9296dc06f496a274136954a52d5c3f64bff1b0eb34c94d6421
#. default-sha256: aeb9d7926982444c16bd348ce21ffab6c0092b107e3d819aef7231af141b8b48
msgctxt "scenario8:scenario8_0D01B5C2_D45E_475E_B13F_467EE109DEE2"
msgid "⟪k:0⟫I suppose so..."
msgstr "⟪k:0⟫Eu suponho..."

#: scenario8:scenario8_276FC91D_6FDC_4871_B020_4A14D8E5C672
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 74e7d24c3fa4d4043084b5cbab43cb2178484726c1c8ad1d64ec4145183ffea4
#. default-sha256: 0a15dc2a67b8eb643cf1f287bb419000f33024248dc8ed40b8732892d3bc5101
msgctxt "scenario8:scenario8_276FC91D_6FDC_4871_B020_4A14D8E5C672"
msgid ""
"⟪k:0⟫My whole life had changed so abruptly, so dramatically,⟪k:1⟫that my mind just wasn’t able to "
"keep up."
msgstr ""
"⟪k:0⟫Toda a minha vida mudou tão abruptamente, tão dramaticamente,⟪k:1⟫que minha mente "
"simplesmente não era capaz de acompanhar."

#: scenario8:scenario8_C48E29E4_2F8A_4181_BFEC_D4F2E839E1CF
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 0186e68b1b463d92cf4d71bb908c07762da4717a6d7a672ce53534f8f9e8dbe9
#. default-sha256: cc2c9aa34b224b7b7fe94d9ebdc2ceb1626c410a0bff9305228c54e5ec58107b
msgctxt "scenario8:scenario8_C48E29E4_2F8A_4181_BFEC_D4F2E839E1CF"
msgid "⟪k:0⟫Our new life together was quiet and unremarkable."
msgstr "⟪k:0⟫Nossa nova vida juntos foi tranquila e normal."

#: scenario8:scenario8_CD5F140F_2A30_4E96_B8D2_45E6694D1B3E
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 0f500f2fc6f16946c7c91d527e0b0d4b303adc9ad41e2be26397cffa6ff81185
