msgctxt "scenario8:scenario8_456D81FB_F82E_47BD_97A1_82A739013DE9"
msgid ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫Ahaha... ⟪k:3⟫You’ve got quite the sweet tooth.⟪k:4⟫⟪k:5⟫You’re going to make "
"yourself sick like that."
msgstr "⟪k:0⟫⟪k:1⟫⟪k:2⟫Ahaha... ⟪k:3⟫Você gosta muito de doces.⟪k:4⟫⟪k:5⟫Vai ficar doente assim."

#: scenario8:scenario8_E889B4A3_99B7_4667_B645_7DCF4851A94B
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 59cf93ad3fdb9af30b0575b15d7c7070b0e02f9de910343ddd61b6f69abd202e
#. default-sha256: ddcb56eaccebe6312419a29a1a35c6a2d36495bc6dbacd62b7dd1bbda6101afc
msgctxt "scenario8:scenario8_E889B4A3_99B7_4667_B645_7DCF4851A94B"
msgid "⟪k:0⟫⟪k:1⟫Nope. You’ve been frowny all day."
msgstr "⟪k:0⟫⟪k:1⟫Não. Você esteve carrancudo o dia todo."

#: scenario8:scenario8_767724A6_D98E_4BD5_AFF8_BA858482FB90
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 747b4b291081e37d35fa7bb296f28200fe7f9ae2d3379d65be76bb7ab91efd22
#. default-sha256: b802d33e5c341d915ae18ef645d5c951406d77a84796a56729eb353b24e6d1fd
