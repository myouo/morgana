msgctxt "scenario8:scenario8_2BF65C28_D0EF_4D1A_8512_2F5231A14D79"
msgid ""
"⟪k:0⟫I would go to bed at night afraid I’d wake up the next morning...⟪k:1⟫⟪k:2⟫and Nellie "
"wouldn’t."
msgstr ""
"⟪k:0⟫Eu ia para a cama à noite com medo de acordar na manhã seguinte...⟪k:1⟫⟪k:2⟫e Nellie não."

#: scenario8:scenario8_758D1741_451D_42C8_8E0D_94FF9BF61F48
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: fcc895a495f7ffe8697b7558420ebe5e33f498ea3c44e27451489f72d5568f9e
