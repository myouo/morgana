#: scenario8:scenario8_F7A52E00_EF02_4FB0_BE20_DDA30BC28DD2
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 99fe287229c4710f71e41954d2ebe7019e15ef80cb448922c428ff777bd780d8
#. default-sha256: c0f96c0f7e21ab1fb4244d1e52ef3cb9c4d37757af116b3e0e6b465351dc9868
msgctxt "scenario8:scenario8_F7A52E00_EF02_4FB0_BE20_DDA30BC28DD2"
msgid ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫⟪k:4⟫Oh, thank goodness!⟪k:5⟫⟪k:6⟫You were out so good I was scared you might "
"be dead for a minute!"
msgstr ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫⟪k:4⟫Ah, graças a Deus!⟪k:5⟫⟪k:6⟫Você estava tão apagado que por um minuto "
"fiquei com medo de que pudesse estar morto!"

#: scenario8:scenario8_77876211_4445_42BD_AB95_32AD2A489D48
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 770e7aab21424e4d616bc7ca650a2b0e9cb9155d2d1066b152fe290e7f79dd32
