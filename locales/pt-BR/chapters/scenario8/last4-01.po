msgid "⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫The courtyard?"
msgstr "⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫O quintal?"

#: scenario8:scenario8_B64CB175_0E23_4863_BC09_19D1FF388D0C
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: daef9f84cfc70b9aacc5f1ab8cb4e60ff044d0ab44bb221f9797cac17f3b6f78
#. default-sha256: 40ddfcf73484f2f0937c3c31113e3025fbb5f11421061562eee4afa8beaccf99
msgctxt "scenario8:scenario8_B64CB175_0E23_4863_BC09_19D1FF388D0C"
msgid "⟪k:0⟫but the other two are bound to find out if either of us do anything too conspicuous."
msgstr "⟪k:0⟫mas os outros dois vão descobrir se algum de nós fizer algo muito perceptível."

#: scenario8:scenario8_682B4051_76FA_4FCA_8928_FBB0B107C8EC
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 5e2b0b7d325fbfa0b819b671cfff4785df4dd8fd6f30424f99ae17d0ecd18fa1
