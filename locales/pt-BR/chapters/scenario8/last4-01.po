msgid "⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫Mell. Do you know where I could find the nun?"
msgstr "⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫Mell. Você sabe onde eu poderia encontrar a freira?"

#: scenario8:scenario8_8C48AD16_D741_4098_8BC8_3C515E421164
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 157d1f627205ee6ec6f021b1cbdba6a530b3ec743629e1eabad96e11013265a2
