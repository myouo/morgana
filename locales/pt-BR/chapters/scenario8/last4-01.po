msgctxt "scenario8:scenario8_77876211_4445_42BD_AB95_32AD2A489D48"
msgid "⟪k:0⟫⟪k:1⟫⟪k:2⟫Good morning.⟪k:3⟫How are you feeling?"
msgstr "⟪k:0⟫⟪k:1⟫⟪k:2⟫Bom dia.⟪k:3⟫Como você está se sentindo?"

#: scenario8:scenario8_389ACB9F_C2DB_4348_B201_718B1D928DE7
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 35eb338ea12a127764c6f95ce9fb4ca350fe251528a45632e4d50d0e9ca41bdc
