msgid "⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫Dining hall...?"
msgstr "⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫Refeitório...?"

#: scenario8:scenario8_8F2B740D_2847_41C8_BB0A_628B80A27314
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 25bfa2131c0c3684eb63807d41d3d73f33eab41b6b043264330a1d97ca630019
#. default-sha256: d33b89d9df772a979c3ee6572a3e51e9c9e1c71443637b85bbb7a347d6ec6c1d
msgctxt "scenario8:scenario8_8F2B740D_2847_41C8_BB0A_628B80A27314"
msgid ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫There’s quite the crowd—⟪k:3⟫⟪k:4⟫all the people here helping with festival prep—"
"⟪k:5⟫⟪k:6⟫so you should probably hurry if you want to get some."
msgstr ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫Há uma multidão—⟪k:3⟫⟪k:4⟫todas as pessoas aqui ajudando com a preparação do "
"festival—⟪k:5⟫⟪k:6⟫então você provavelmente deveria se apressar se quiser pegar alguma coisa."

#: scenario8:scenario8_BEF42CD6_E478_4B9C_840F_05222C5DCC16
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: a9d27c8aff576a7c3dfa7ea3835146f00b4e2fa077eae4b00befeb6655243dfe
#. default-sha256: 897e2fbed4cf008f9be67650cbaec86702df7aef860104d043a05759c594a359
msgctxt "scenario8:scenario8_BEF42CD6_E478_4B9C_840F_05222C5DCC16"
msgid "⟪k:0⟫⟪k:1⟫(My mind’s still waking up...)"
msgstr "⟪k:0⟫⟪k:1⟫(Minha mente ainda está acordando...)"

#: scenario8:scenario8_C7E8CD0E_A37C_4F74_9BA4_F882B2547D9B
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: dfda081a9f9b7330680227df382b107825d38bd992907f9197adf105ee8770f3
#. default-sha256: 018647e5c9ae7b40e001ac6a51b2a2d6d3b041faccadc5f3c339f86b03183660
msgctxt "scenario8:scenario8_C7E8CD0E_A37C_4F74_9BA4_F882B2547D9B"
msgid ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫As I mentioned yesterday, the heart of the harvest festival is here at the church, "
"but it’s a city-wide event."
msgstr ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫Como mencionei ontem, o coração do festival da colheita é aqui na igreja, mas é um "
"evento que acontece em toda a cidade."

#: scenario8:scenario8_53575B42_7B18_4E16_8B25_177FB4D8788D
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 4a97b3c2d6a7e1ae182f2e0bba7d6edf3d4ae1d7e3b18ee4551388ca424838dd
