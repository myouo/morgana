msgctxt "scenario8:scenario8_1D6B76B2_FE19_4B42_89FA_6CA963539A69"
msgid "⟪k:0⟫⟪k:1⟫⟪k:2⟫I suppose."
msgstr "⟪k:0⟫⟪k:1⟫⟪k:2⟫Creio que sim."

#: scenario8:scenario8_8449313A_BEBB_4E43_AB30_486BF6FF69DA
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: c93267201ba5ebeab56b2ec6e136826a2b3e51d7f3656826694316973f15097a
