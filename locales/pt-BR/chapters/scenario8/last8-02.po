msgctxt "scenario8:scenario8_47E25499_1CB1_4FCD_812C_5E2E7E83CFEF"
msgid "⟪k:0⟫Look at this..."
msgstr "⟪k:0⟫Veja isso..."

#: scenario8:scenario8_7A46B2FE_18AB_4BAF_89BD_43662D335722
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 72a35a656768489b4219336dacefafae38f6880825ea5fcb2ffe44c5b4097339
#. default-sha256: d68f90462a11264c78b0a086c06532d234627eb068d46c7bb00d83a5989d1321
msgctxt "scenario8:scenario8_7A46B2FE_18AB_4BAF_89BD_43662D335722"
msgid "⟪k:0⟫They stood no chance against my strength!"
msgstr "⟪k:0⟫Eles não tiveram chance contra minha força!"

#: scenario8:scenario8_B7204B16_FEB5_4ED8_9B3C_52F11A5F5D88
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: e0031b2c3800a37790d47a4311278eb1136fae7c6e3c076487e9eb38cad1b324
#. default-sha256: 0f850584f916cedee0462c41c44bb46c9d222f9708c42eb8926fa1888079962c
msgctxt "scenario8:scenario8_B7204B16_FEB5_4ED8_9B3C_52F11A5F5D88"
msgid ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫After taking the keys off one of the slave traders, I returned to the carriage, "
"doing my best to act calm and suppress the bubbling exhilaration."
msgstr ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫Depois de tirar as chaves de um dos traficantes de escravos, voltei para a "
"carruagem, fazendo o meu melhor para agir com calma e suprimir a euforia borbulhante."

#: scenario8:scenario8_22D704DB_3077_46C5_B94C_2FE52D04285E
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 4196eb226ea08eb8c739528890603d9ca6bd79aec92b2b930a30c2f5a543a588
