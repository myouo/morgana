msgid ""
"⟪k:0⟫And why—⟪k:1⟫⟪k:2⟫⟪k:3⟫⟪k:4⟫⟪k:5⟫⟪k:6⟫                                             ⟪k:7⟫"
"should I care?"
msgstr ""
"⟪k:0⟫E por que—⟪k:1⟫⟪k:2⟫⟪k:3⟫⟪k:4⟫⟪k:5⟫⟪k:6⟫                                             ⟪k:7⟫eu "
"deveria me importar?"

#: scenario8:scenario8_47E25499_1CB1_4FCD_812C_5E2E7E83CFEF
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: f2f22add3d6ea359fc370979e194dde650f80d712a41a658a9b8fc199e286f00
