msgctxt "scenario8:scenario8_E99D19E3_A167_4F57_A7DA_8791B0F2861E"
msgid "⟪k:0⟫⟪k:1⟫clouds of dust wisping across the bare dirt trail."
msgstr "⟪k:0⟫⟪k:1⟫nuvens de poeira se espalhando pela trilha de terra nua."

#: scenario8:scenario8_40E7908F_A47F_49C9_A203_5A99E5B51E79
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: e75374183b80c1249170e1cc2a8b330a839b3fc761c84bbd24701b2d8669d98e
