#: scenario8:scenario8_4D5B1952_FBB7_450D_B213_2EECB2E8B062
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 4e00cc3eb28401ad4380113232b3badaa6e0478ea8c6731d4edbfd6fbf66e93c
#. default-sha256: ee7f3f805e7d3f5a908c2355ecc319ab588a1cd5772dabfed7263037f7cb3b68
msgctxt "scenario8:scenario8_4D5B1952_FBB7_450D_B213_2EECB2E8B062"
msgid ""
"⟪k:0⟫⟪k:1⟫I remember the Silk Road,⟪k:2⟫⟪k:3⟫stretching out before me as far as the eye can see,"
msgstr ""
"⟪k:0⟫⟪k:1⟫Eu me lembro da Rota da Seda,⟪k:2⟫⟪k:3⟫estendendo-se diante de mim até onde os olhos "
"podem ver,"

#: scenario8:scenario8_E99D19E3_A167_4F57_A7DA_8791B0F2861E
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 89dac1387d01f414175fbbe1689db231e59492c929043e191b51015463689bf4
