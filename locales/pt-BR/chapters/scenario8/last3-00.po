#: scenario8:scenario8_D1B494DA_31AD_409F_91EE_C3F61A2683A9
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: f5fa6577d5f9c4847f59fcca9003f767e58ec02655fb90aa2b13d35302d21f60
#. default-sha256: 44a4d57fb9760b520d30657c8a144122c91a036d06a5cbd7498b9480db641d05
msgctxt "scenario8:scenario8_D1B494DA_31AD_409F_91EE_C3F61A2683A9"
msgid ""
"⟪k:0⟫⟪k:1⟫On days when it was nice out,⟪k:2⟫⟪k:3⟫I would take walks around the house’s grounds,"
msgstr "⟪k:0⟫⟪k:1⟫Em dias bonitos,⟪k:2⟫⟪k:3⟫eu passearia pelo terreno de casa,"

#: scenario8:scenario8_A9BABB81_749F_4964_9AD1_E69F58DEE34D
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: b079c137e725c58a05ad9281de3c32b137332b8354f7407e45c89150b816345b
#. default-sha256: 19b5423ed21bd76f9efabd26329f5dc46d4b4e1ae88045f939cb1bd4ec22aebb
msgctxt "scenario8:scenario8_A9BABB81_749F_4964_9AD1_E69F58DEE34D"
msgid "⟪k:0⟫⟪k:1⟫sometimes napping beneath a tree."
msgstr "⟪k:0⟫⟪k:1⟫às vezes tirando um cochilo debaixo de uma árvore."

#: scenario8:scenario8_4BED022D_815C_4FFF_B1B1_70419C5FC109
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 7b90e736e07f4ffec218fbe4a01c4e993ac5160afae65f47ebea5cbe4cb9fbe7
#. default-sha256: 532d6bc252306ba7ff53aad9f1949a46064e526fc8702453f3fe5fbfb2ee2e5b
msgctxt "scenario8:scenario8_4BED022D_815C_4FFF_B1B1_70419C5FC109"
msgid "⟪k:0⟫⟪k:1⟫whereas mine is flat and dull."
msgstr "⟪k:0⟫⟪k:1⟫enquanto o meu é insípido e sem graça."

#: scenario8:scenario8_E3166BAA_BA5A_4E7B_9D32_689B25DD9633
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 3b48a97b19386c1594332bee39ab364357bc7ca51984cad882726203e477e5a6
#. default-sha256: 38cca209dd372c8efc6f1c4dc843ac33ddaffec07c09093141484569b7ea8231
msgctxt "scenario8:scenario8_E3166BAA_BA5A_4E7B_9D32_689B25DD9633"
msgid "⟪k:0⟫⟪k:1⟫You shone like a tiny little dancing sun."
msgstr "⟪k:0⟫⟪k:1⟫O seu brilhava como um pequeno sol dançante."

#: scenario8:scenario8_0114CDC6_DD89_463C_AF9E_DD612D17C3A0
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: acde638df32b5c3dc46eada7fd696187bc16da75847692ed0c46c4b41c967f64
#. default-sha256: bf457b5735f92a1076ef043c87e9c1610c7874076ac398d3053fd8fd5ea23fb8
msgctxt "scenario8:scenario8_0114CDC6_DD89_463C_AF9E_DD612D17C3A0"
msgid "⟪k:0⟫⟪k:1⟫At the time, I assumed that was how life would always be."
msgstr "⟪k:0⟫⟪k:1⟫Na época, presumi que a vida sempre seria assim."

#: scenario8:scenario8_026D5E20_738D_4C2B_A483_A709FFB94996
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 49a03b17a842a665cb9db1f493731dd25b58c9e849c17491be5f01e165fd794c
#. default-sha256: 7ce8829149ec38a1b823f85183ffc272423e5523e05e16a8def741e2877c5499
msgctxt "scenario8:scenario8_026D5E20_738D_4C2B_A483_A709FFB94996"
msgid ""
"⟪k:0⟫Part of me wanted to know why nobody bothered talking to me,⟪k:1⟫and part of me was "
"relieved. ⟪k:2⟫Somewhere inside, I knew I didn’t have what it took."
msgstr ""
"⟪k:0⟫Parte de mim queria saber por que ninguém se preocupou em falar comigo,⟪k:1⟫e parte de mim "
"ficou aliviada. ⟪k:2⟫Em algum lugar lá dentro, eu sabia que não tinha o que era preciso."

#: scenario8:scenario8_0C1CDE28_7606_473D_B23B_F7FB5A3A1B49
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 7327d4f2a932f9eb6086d20c5fb8874a5ed46bacd5b3f9e8d82cb2ff839fc526
#. default-sha256: cf59610d813403cc742a1ed3d8931ea88fcaaa3784851b270c338f6973b93114
msgctxt "scenario8:scenario8_0C1CDE28_7606_473D_B23B_F7FB5A3A1B49"
msgid "⟪k:0⟫and in response, he formally disowned me."
msgstr "⟪k:0⟫e em resposta, me renegou formalmente."

#: scenario8:scenario8_70CAA6B3_33FB_4FAC_ACFC_5AAD1525E679
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 4a8018f5f623d0979ef64e2379aed506b2399b0b1551432ff3ebab73b185692e
#. default-sha256: 16afe82fcb5881438daff375601c0697d4b28e6943debb4a51866a8b5f83c989
msgctxt "scenario8:scenario8_70CAA6B3_33FB_4FAC_ACFC_5AAD1525E679"
msgid ""
"⟪k:0⟫You’re not the only one who still had some growing up to do, Nellie...⟪k:1⟫⟪k:2⟫I wasn’t "
"quite the adult I’d thought I was either."
msgstr ""
"⟪k:0⟫Você não é a única que ainda precisa crescer, Nellie...⟪k:1⟫⟪k:2⟫Eu também não era o adulto "
"que pensei que era."

#: scenario8:scenario8_FA7D6747_967F_4BD1_8158_BB4648567C75
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: e9f86d7b7f7557c714d86693f97f5eac1facaa1b79eb8ce4ab89c07927d0a0e4
#. default-sha256: 3fa469623051a6e23c6fbf72f060f042e594a17bc6e3b823e0a12c504d53eb15
msgctxt "scenario8:scenario8_FA7D6747_967F_4BD1_8158_BB4648567C75"
msgid ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫Fortunately—⟪k:3⟫⟪k:4⟫if you want to call it fortune—⟪k:5⟫⟪k:6⟫I was given enough "
"money to live on for a decent length of time, as well as a place to stay."
msgstr ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫Por sorte—⟪k:3⟫⟪k:4⟫se você quiser chamar isso de sorte—⟪k:5⟫⟪k:6⟫recebi dinheiro "
"suficiente para viver por um período decente de tempo, bem como um lugar para ficar."

#: scenario8:scenario8_82CD33D1_0CF8_440F_B31F_CA3D47AD9315
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 65f0f31ad42b512aa1ba0d9c770d7acec51160b3fe0aaf480170c55542822619
#. default-sha256: 0c9766ef989205c04b2abaf3a26ad073a24f5011c8c6f0c55df10bd83f74278f
msgctxt "scenario8:scenario8_82CD33D1_0CF8_440F_B31F_CA3D47AD9315"
msgid "⟪k:0⟫⟪k:1⟫⟪k:2⟫...Oh?"
msgstr "⟪k:0⟫⟪k:1⟫⟪k:2⟫...Ah?"

#: scenario8:scenario8_F0F66272_1A70_4843_A7E7_E74FE97787A7
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: baad8a9333061676c5b329594e1deef39a60b8fe39aa797c105a0de3658368ac
#. default-sha256: 58b6ae228a520ee3dd1e6ec6fea3922a68e33f49f09b1e789245f004cf3f008e
msgctxt "scenario8:scenario8_F0F66272_1A70_4843_A7E7_E74FE97787A7"
msgid ""
"⟪k:0⟫⟪k:1⟫I don’t need composers to come and write me songs for my birthday. ⟪k:2⟫As long as I "
"have the one thing that matters most to me, I can do without anything else."
msgstr ""
"⟪k:0⟫⟪k:1⟫Não preciso que compositores venham escrever músicas para meu aniversário. ⟪k:2⟫"
"Enquanto eu tiver aquilo que é mais importante para mim, posso viver sem mais nada."

#: scenario8:scenario8_4CAD8A9E_DEF1_4D17_9955_4D40055BA4EB
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: f3271ffd61ba6340e872f8d98ea4dcb47161a0b4f2e0426490f6e32784613f48
#. default-sha256: f907ce6bc30e7bb8ee7d44634c25eaa57f96ab5b91ab82ee1f167b00f07a2bdc
msgctxt "scenario8:scenario8_4CAD8A9E_DEF1_4D17_9955_4D40055BA4EB"
msgid ""
"⟪k:0⟫We may not have a huge yard, but the sun shines everywhere.⟪k:1⟫⟪k:2⟫Flowers can grow even "
"without a gardener tending to them."
msgstr ""
"⟪k:0⟫Podemos não ter um quintal enorme, mas o sol brilha em todos os lugares.⟪k:1⟫⟪k:2⟫Flores "
"podem crescer mesmo sem um jardineiro cuidando delas."

#: scenario8:scenario8_0781453F_274D_4AFD_AE30_1C99F1552F2F
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: cb24f93a9cc96a15bddf566a51d4e22ef4b31ed30ca5f4470ee6fff33f2a8cad
#. default-sha256: 0273b8156edd57477341ec220ee54f04879e186a8d430cb6783cf3bd217de1b1
msgctxt "scenario8:scenario8_0781453F_274D_4AFD_AE30_1C99F1552F2F"
msgid "⟪k:0⟫What else sounds good? ⟪k:1⟫Hmm... ⟪k:2⟫I’m craving cookies!"
msgstr "⟪k:0⟫O que mais parece bom? ⟪k:1⟫Hmm... ⟪k:2⟫ Estou com vontade de biscoitos!"

#: scenario8:scenario8_16735FB1_6A43_4AAC_A996_D588EFCC1B56
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 7789ff520a0f2cc24a1f38e848823d013f2b35cc78458dfce5dfb6c38319fc54
#. default-sha256: 4c9bec18bd3993bae6b36f1a2ee0ccc2454fad1485207c1fb574b98ec12d053d
msgctxt "scenario8:scenario8_16735FB1_6A43_4AAC_A996_D588EFCC1B56"
msgid "⟪k:0⟫⟪k:1⟫That’s the first smile I’ve seen since we got here."
msgstr "⟪k:0⟫⟪k:1⟫Esse é o primeiro sorriso que vejo desde que chegamos aqui."

#: scenario8:scenario8_7A6088F2_2857_4496_9125_BCEA0EA68271
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 92f21b8141c1863eda6c0a3d0d134e7af02ac8cd486dc24a53498c92599b0b34
#. default-sha256: eb91b2d16dc8cd380bc10dbb6f46d5d52561169cb03e17a0941405a1c297e103
msgctxt "scenario8:scenario8_7A6088F2_2857_4496_9125_BCEA0EA68271"
msgid ""
"⟪k:0⟫⟪k:1⟫Who cares that we’re not rich anymore?⟪k:2⟫⟪k:3⟫We’ll figure things out in no time."
msgstr ""
"⟪k:0⟫⟪k:1⟫Quem se importa se não somos mais ricos?⟪k:2⟫⟪k:3⟫Nós vamos dar um jeito em pouco tempo."

#: scenario8:scenario8_65533E70_3D7C_4305_92E2_C898165BAD9F
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 320253cc7c9760d5ef89f5df7b468c80c67aa2629306340fe26b704b0d3ac00e
#. default-sha256: 3dbee552e5767b5d7b4feffe572a94ec7ccde83b36261abf0c83e22189c4742c
msgctxt "scenario8:scenario8_65533E70_3D7C_4305_92E2_C898165BAD9F"
msgid "⟪k:0⟫And then we’ll have even more fun than we did back there!"
msgstr "⟪k:0⟫E então nos divertiremos ainda mais do que antes!"

#: scenario8:scenario8_89CC1705_38AE_40B2_BCEF_1A28D235D33D
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 5b8af39429c5a01d16c2b9da1415882fbb574403ce7bacef870930c3e76da3b2
#. default-sha256: b5dbbcdf0bab80d6855e4fbf24f14e576ee5d68d906ed6ca210f6c21c9385284
msgctxt "scenario8:scenario8_89CC1705_38AE_40B2_BCEF_1A28D235D33D"
msgid ""
"⟪k:0⟫⟪k:1⟫You’ve got yourself an adorable little princess!⟪k:2⟫⟪k:3⟫What more could you possibly "
"need?"
msgstr "⟪k:0⟫⟪k:1⟫Você tem uma princesinha adorável!⟪k:2⟫⟪k:3⟫O que mais poderia precisar?"

#: scenario8:scenario8_8871344A_3F24_4690_8C8C_8A34F4D9E84D
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: a31d2ee03a7062c2b210df745e3782e1bdaf76740e8ffd23f35daf05db0001f6
#. default-sha256: a8df108200c8551263d0802ec860fb91c514f565605cd68be42e45da81ef6343
msgctxt "scenario8:scenario8_8871344A_3F24_4690_8C8C_8A34F4D9E84D"
msgid "⟪k:0⟫⟪k:1⟫Cheer up!"
msgstr "⟪k:0⟫⟪k:1⟫Anime-se!"

#: scenario8:scenario8_3E139956_A055_4D47_B55D_3FAAA6856A23
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 411cf75970ac63aafe5d306a7dbb97e5623a854579bd240ec495da84806b9012
#. default-sha256: a3bcd1d0a74e03b2c70070aa3992003b7310fe50dc1a52a32d4e8e38c5df3457
msgctxt "scenario8:scenario8_3E139956_A055_4D47_B55D_3FAAA6856A23"
msgid ""
"⟪k:0⟫⟪k:1⟫Ohoho. Did you think for a second I wouldn’t?⟪k:2⟫⟪k:3⟫I’m your princess, dearest Mell!"
msgstr ""
"⟪k:0⟫⟪k:1⟫Ohoho. Você pensou por um segundo que eu não iria?⟪k:2⟫⟪k:3⟫Eu sou sua princesa, "
"querido Mell!"

#: scenario8:scenario8_3ED2A53C_3AFD_4A2F_89B6_974A96B940D5
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 8caab7c11e7eefeb8968ccd473b0a4b3425b75ed985a70c1045414ff743e9e37
#. default-sha256: 69fdb20c4088a6bd94084a457a97744229ccac3f7cc253c2d100f68f317a7831
msgctxt "scenario8:scenario8_3ED2A53C_3AFD_4A2F_89B6_974A96B940D5"
msgid "⟪k:0⟫⟪k:1⟫And princesses belong with their princes."
msgstr "⟪k:0⟫⟪k:1⟫E as princesas pertencem aos seus príncipes."

#: scenario8:scenario8_76276090_6E2F_4AF5_81BB_20FBB6F318B9
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 60f4a240f81b0b3e98e192e7d1ac1bc4d7717b9a7bc1fd510094b3bb23d93fc0
#. default-sha256: 633a8adab0279b04d99144e4583e4e7a0b7009cb3ec9ac0f00e43a2ba2872e51
msgctxt "scenario8:scenario8_76276090_6E2F_4AF5_81BB_20FBB6F318B9"
msgid "⟪k:0⟫but Nellie calling me her prince gave me the illusion of being worth something."
msgstr "⟪k:0⟫mas Nellie me chamando de seu príncipe me deu a ilusão de valer alguma coisa."

#: scenario8:scenario8_3F2F6511_96BF_4686_99A5_2288F805FB64
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 35867ad279f5e347dc38e566f354456469018619a73375d7dd91f0f23e180bab
#. default-sha256: 05fbbfd916801c49dc542d7d73ca589b028d91f0d1515cd6d6120a6794f09693
msgctxt "scenario8:scenario8_3F2F6511_96BF_4686_99A5_2288F805FB64"
msgid ""
"⟪k:0⟫It made me feel like I could keep on being that richly blessed young man, even this far away "
"from home."
msgstr ""
"⟪k:0⟫Isso me fez sentir que poderia continuar sendo aquele jovem ricamente abençoado, mesmo tão "
"longe de casa."

#: scenario8:scenario8_CC8CE97C_57A4_4844_94E7_B1E25F7B1C5E
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 0f6fa70786a2e8821299d7abb8a71c6304b57cacc1db9f4c04ece918549405e9
#. default-sha256: 3995f9a2e9f4f4a9a000ce43911280acec3a8b5f28cce389d521d98ebb55461b
msgctxt "scenario8:scenario8_CC8CE97C_57A4_4844_94E7_B1E25F7B1C5E"
msgid "⟪k:0⟫but to be quite honest, I couldn’t gather the motivation to do much of anything."
msgstr "⟪k:0⟫mas, para ser bem sincero, não consegui reunir motivação para fazer muita coisa."

#: scenario8:scenario8_63C6DAC9_1B4B_48E4_B46D_DCEA67D4D6F3
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 7301a65547bb1c4092eebcebaddf1d633db7f7dc4ba9c1e05d9a939d6099ce6c
#. default-sha256: 862dd2cc60ea93d55cc0cc0b9849fe3453a46efedbc1ab13d26b471f4eb4e2c8
msgctxt "scenario8:scenario8_63C6DAC9_1B4B_48E4_B46D_DCEA67D4D6F3"
msgid "⟪k:0⟫It had knocked me on my backside,⟪k:1⟫and I didn’t have the strength to get back up."
msgstr "⟪k:0⟫Isso me derrubou  de costas,⟪k:1⟫e eu não tive forças para me levantar."

#: scenario8:scenario8_ADDC0075_5107_434C_B85B_C7D0503F1A53
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 5f7b46a26ce867b3779c93dc9c3ec8764af6d7f76878aa772008a44318816079
#. default-sha256: d71fc33ec064959fb16bc799d122fa147e5fcf261ed04425c5371e69de25d55b
msgctxt "scenario8:scenario8_ADDC0075_5107_434C_B85B_C7D0503F1A53"
msgid "⟪k:0⟫I couldn’t tell Nellie that, of course, so this is what I said instead:"
msgstr "⟪k:0⟫Eu não poderia dizer isso a Nellie, é claro, então foi isso que falei:"

#: scenario8:scenario8_C7BB2910_3DBF_482D_A538_4565683DF042
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 5224c06de4287dc711273d186770e3ffe84ab246c9163cdffae45d9b0b17e06b
#. default-sha256: 205ce2fac3f9d8803ebf370fff2027b0716cdf9ac6389429598ea1853b5fbda9
msgctxt "scenario8:scenario8_C7BB2910_3DBF_482D_A538_4565683DF042"
msgid "⟪k:0⟫And she happily took me at my word."
msgstr "⟪k:0⟫E ela alegremente acreditou na minha palavra."

#: scenario8:scenario8_0B99D07D_BF8B_4995_8F5F_912A75899300
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 63af290495384688c5dc901c6d2a5071a857c88f197ebeb5baa75771ef23f346
#. default-sha256: 836457679cd20c91186a8136b922a8f47cf350cfb0366a8368a27561620c5692
msgctxt "scenario8:scenario8_0B99D07D_BF8B_4995_8F5F_912A75899300"
msgid "⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫I got a, ⟪k:4⟫uh... ⟪k:5⟫a chicken..."
msgstr "⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫Eu peguei, ⟪k:4⟫uh... ⟪k:5⟫uma galinha..."

#: scenario8:scenario8_53B51C9D_A0DC_4863_B9CD_DAC5AAFCC9A8
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 305ccfa4e3ad9ebb128ce64627453cdef0761a080c5ecf0d022a1c131d984217
