msgid "⟪k:0⟫Undo our shackles, please!"
msgstr "⟪k:0⟫Desfaça nossas algemas, por favor!"

#: scenario8:scenario8_64824487_E115_4F4F_BFD9_18DCE692F95E
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 60e0a264b0dac96c5184ba9dbb2fab4f8ebefd308c54ae6bfac7687af82af6e2
