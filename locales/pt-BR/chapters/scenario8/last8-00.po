msgctxt "scenario8:scenario8_63E11C4C_470B_45C4_BDF5_9D1910BA3315"
msgid "⟪k:0⟫More... ⟪k:1⟫I need more...⟪k:2⟫⟪k:3⟫I need moooooooooooore!"
msgstr "⟪k:0⟫Mais... ⟪k:1⟫eu preciso de mais...⟪k:2⟫⟪k:3⟫Eu preciso de maaaaaaaaaaaais!"

#: scenario8:scenario8_38158AE4_64C6_491B_98D3_B0BE5DA55015
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: be27c4b624b57f9b03be0decd65e2f59481d6f829669ee1d073502e1c6911af9
#. default-sha256: 2851038216cf0a4799537687f6c491e054a53c2e39b6e41e82b055ca0f8444e8
msgctxt "scenario8:scenario8_38158AE4_64C6_491B_98D3_B0BE5DA55015"
msgid "⟪k:0⟫But she said nothing, simply removing my shackles as commanded."
msgstr "⟪k:0⟫Mas ela não disse nada, apenas removendo minhas algemas conforme ordenado."

#: scenario8:scenario8_707AA80E_C68A_4C08_8E5F_B7EA77E984E7
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 423726d328a9c341314832f5b81bbcd0b9a5f262dec7eed6d6ce8b40e86ce382
#. default-sha256: 1b62957b2e168f205456ee6d80c343378a26671b281b6a00714cb8f672e58dca
