msgid "⟪k:0⟫⟪k:1⟫We can have our lives back!"
msgstr "⟪k:0⟫⟪k:1⟫Podemos ter nossas vidas de volta!"

#: scenario8:scenario8_D2F5D64A_E594_4284_9082_612E7FE2398A
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 3d2d6ab360049502228f5fd12ee5ef4d5fe076cf9c02703e0820bdedcaacd429
