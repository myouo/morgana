msgctxt "scenario8:scenario8_8D93A337_D2B1_4263_88A0_79A5D2C433CA"
msgid "⟪k:0⟫For a moment, I was filled with a sense of tranquility,"
msgstr "⟪k:0⟫Por um momento, fui tomado por uma sensação de tranquilidade,"

#: scenario8:scenario8_DD5FAAB1_FB91_428F_A8DF_2C1B7B49DC0C
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 230701895929a5f7b2eec8e8b4d19640feeb50e80f555a6235e8de91df2caef4
