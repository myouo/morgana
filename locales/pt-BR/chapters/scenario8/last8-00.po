#: scenario8:scenario8_6859F8BA_2B60_443D_A146_6359F9BCC8F3
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: e957b7b12f8b97275e9da4aaa5f03830cd145abfa838e26d6df902215324b88b
#. default-sha256: 0fcecc651e71ba25206a238ad5ea26483abfc4706b29eb416c9a0f9e83a51f85
msgctxt "scenario8:scenario8_6859F8BA_2B60_443D_A146_6359F9BCC8F3"
msgid "⟪k:0⟫⟪k:1⟫That endless expanse of red earth"
msgstr "⟪k:0⟫⟪k:1⟫Aquela extensão infinita de terra vermelha"

#: scenario8:scenario8_A4A3F35D_D62F_4F2A_B280_64EB88F05101
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 7f0624ae9c5be9636e1858766bd0fb66c0f6401197dc4df8d1026a5f71a6e4e7
#. default-sha256: 3074d6d418fc06d89f88a55454aebfb09ef48bcee7e09ea17d736ff53a6c4b4b
msgctxt "scenario8:scenario8_A4A3F35D_D62F_4F2A_B280_64EB88F05101"
msgid "⟪k:0⟫⟪k:1⟫remains branded into the very fabric of my mind."
msgstr "⟪k:0⟫⟪k:1⟫permanece marcada no próprio tecido da minha mente."

#: scenario8:scenario8_86014BCE_50E9_48BD_9AD2_C18A9B08E47F
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 0f84774febf4c547045cead5b304b5e426b436183268e3048822622e014bf68e
#. default-sha256: b2947e867481e8b54d6ea1bcf5d7aeadcb3382bbac9a29c3da68d2b614c4d90f
msgctxt "scenario8:scenario8_86014BCE_50E9_48BD_9AD2_C18A9B08E47F"
msgid "⟪k:0⟫That’s where it was decided someone built like I am would be the most use, I suppose."
msgstr "⟪k:0⟫Foi aí que foi decidido que alguém com o meu porte seria mais útil, suponho."

#: scenario8:scenario8_EFE14CCC_A8CF_4BAA_BE17_57EA45F3D07C
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 4866b304484c07fb8983df2ea6d2403918d23519cccc308242d1fa3d93d76e03
#. default-sha256: faa5f375d70922efd5bd12daabb44ade23c550c56fb8ce45a193a1ee86d5d7d1
msgctxt "scenario8:scenario8_EFE14CCC_A8CF_4BAA_BE17_57EA45F3D07C"
msgid ""
"⟪k:0⟫But I could tell from their tone of voice and expressions that the things they were saying "
"were not friendly. ⟪k:1⟫They seemed to be mocking me, laughing at me."
msgstr ""
"⟪k:0⟫Mas eu podia perceber pelo tom de voz e expressões que as coisas que eles estavam dizendo "
"não eram amigáveis. ⟪k:1⟫Eles pareciam estar zombando de mim, rindo de mim."

#: scenario8:scenario8_CDC5F7AC_8330_457D_B164_F088B8DEC181
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 2838c081f005f7e97b6d5c131924c2e4019b05cfca44bbd3bde86fc78ccb670a
#. default-sha256: b0aeb7dc8e5accb54bca8c8502fa15995d0592c17515f7bd9b59f8f38fcc92a7
msgctxt "scenario8:scenario8_CDC5F7AC_8330_457D_B164_F088B8DEC181"
msgid ""
"⟪k:0⟫As you might expect, I attempted to protest,⟪k:1⟫but evidently, I had been beaten quite "
"badly while I was unconscious."
msgstr ""
"⟪k:0⟫Como você deve ter imaginado, tentei protestar,⟪k:1⟫mas, evidentemente, eu tinha sido "
"espancado violentamente enquanto estava inconsciente."

#: scenario8:scenario8_189711F9_D6CC_485D_95C3_728672FF3E07
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 8b34321c6020795c42e87f6b2d2229ae6c2c79e3df64a38f55428d9dc6624d29
#. default-sha256: 8b41560ba8d7c26ce32dde16f0a21c3967a68c27a26661aaffa9a15ae9876de9
msgctxt "scenario8:scenario8_189711F9_D6CC_485D_95C3_728672FF3E07"
msgid ""
"⟪k:0⟫My joints were stiff and swollen, on top of my dehydration,⟪k:1⟫so I could barely move, let "
"alone put up a fight."
msgstr ""
"⟪k:0⟫Minhas articulações estavam rígidas e inchadas, além de eu estar desidratado,⟪k:1⟫então eu "
"mal conseguia me mover, muito menos lutar."

#: scenario8:scenario8_64D83DD8_B6FF_487B_AA17_AC0B63B424CF
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: d6028f9413128be2fac57c4bb09a01ad55326a494db10ecea8f8fd7cca723d07
#. default-sha256: 55c6243b5a32fbce2b6b7855ad8001d0c4fefbf7d0d233dc248ae562f4a316a7
msgctxt "scenario8:scenario8_64D83DD8_B6FF_487B_AA17_AC0B63B424CF"
msgid ""
"⟪k:0⟫As strong as I might have been at full health, I was in no condition to do anything then."
msgstr ""
"⟪k:0⟫Por mais forte que eu fosse com saúde plena, não estava em condições de fazer nada naquele "
"momento."

#: scenario8:scenario8_475C661B_0BE8_4B09_A455_E9CE8A5CCB88
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: be44470ff91001e520a8613563e9940467e4dad4a733102ddbe7a4a85c6c8fee
#. default-sha256: 7626aabbb65b37f320928740f6970477e46bed2a1ca9fece5abb01541cb89e77
msgctxt "scenario8:scenario8_475C661B_0BE8_4B09_A455_E9CE8A5CCB88"
msgid ""
"⟪k:0⟫They had many words to describe me, none of them flattering.⟪k:1⟫⟪k:2⟫Some of them would "
"even call me “beast.”"
msgstr ""
"⟪k:0⟫Eles tinham muitas palavras para me descrever, nenhuma delas lisonjeira.⟪k:1⟫⟪k:2⟫Alguns "
"deles até me chamavam de \"besta\"."

#: scenario8:scenario8_5244F813_E939_4660_BDB7_59797A6E7A7D
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: c41cfcac4623983ddca4269c96b8b5fe0caf0937b6cf548d5b6ba148fb813d11
#. default-sha256: e74f397f16e10576f22001db15b9295bf27e8d24f3b47e9a4ee08cc9ce178bc2
msgctxt "scenario8:scenario8_5244F813_E939_4660_BDB7_59797A6E7A7D"
msgid ""
"⟪k:0⟫The slave trader’s guards were armed, of course.⟪k:1⟫⟪k:2⟫Swords hanging from their hips, "
"ready to cut down anyone who showed any sign of resistance."
msgstr ""
"⟪k:0⟫Os guardas do traficante de escravos estavam armados, é claro.⟪k:1⟫⟪k:2⟫Espadas penduradas "
"em seus quadris, prontos para cortar qualquer um que mostrasse qualquer sinal de resistência."

#: scenario8:scenario8_95934EAA_5C56_448B_B646_04C8D400B5E6
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 74c1332db4c63efc951850f2d5a842f6632bc2951213de879782550285952380
#. default-sha256: 018fe9314ae01088ba5aee3852530e2fd70b15f0de89da3ef738cf1eb910e876
msgctxt "scenario8:scenario8_95934EAA_5C56_448B_B646_04C8D400B5E6"
msgid "⟪k:0⟫So they sat there, lamenting their fate."
msgstr "⟪k:0⟫Então eles estavam ali parados, lamentando seu destino."

#: scenario8:scenario8_54ADD76B_A412_4AFA_BA50_2C9D1C49BD83
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 528947852f8e557465fff4a62ef4a3af0b0f216723f63ffe8e6d6d93b3a40d41
#. default-sha256: b3f43938975d90002ded023c0c55b968ebf37263af28b614be3d0489a0474643
msgctxt "scenario8:scenario8_54ADD76B_A412_4AFA_BA50_2C9D1C49BD83"
msgid ""
"⟪k:0⟫Glancing over at her, I caught a glimpse of her face—⟪k:1⟫⟪k:2⟫⟪k:3⟫large chunks of skin "
"seemed to have fallen off it."
msgstr ""
"⟪k:0⟫Olhando para ela, tive um vislumbre de seu rosto—⟪k:1⟫⟪k:2⟫⟪k:3⟫grandes pedaços de pele "
"pareciam ter caído dele."

#: scenario8:scenario8_3C09BB0D_D06D_4694_AFEE_33B7DB1722FE
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 43fbc76a506b4e8216a9abc361508ea83cf3555f59c472c6d869b5f11ac3dff5
#. default-sha256: 65d57f7827f0731e2e3a24f8638b5309a21e2814d739c95b5b325a395cdb5a84
msgctxt "scenario8:scenario8_3C09BB0D_D06D_4694_AFEE_33B7DB1722FE"
msgid "⟪k:0⟫It was, suffice it to say, an unusual sight."
msgstr "⟪k:0⟫Era, basta dizer, uma visão incomum."

#: scenario8:scenario8_EA4C890F_1548_4752_A156_2A7C16C62C10
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 6e5dbe392c074afa3a412a2d8c276acec6bad941429b158de61a7446249da142
#. default-sha256: f3d93c273d1e2ebf5551688073b816e4437e92db70914171c7d963d5f346ca65
msgctxt "scenario8:scenario8_EA4C890F_1548_4752_A156_2A7C16C62C10"
msgid ""
"⟪k:0⟫I’m not sure how to describe it... ⟪k:1⟫but it seemed different somehow from everyone else "
"crying in the carriage. It was almost like..."
msgstr ""
"⟪k:0⟫Não sei bem como descrever... ⟪k:1⟫mas de alguma forma parecia diferente de todos os outros "
"chorando na carruagem. Era quase como..."

#: scenario8:scenario8_F2B7BADB_C3EA_40B1_AEE7_6D49DE1D5C3D
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: ee9bf0418da76c11a95c8920c535a86294b5847ada4c2e6b408bdb89e25ffd5e
#. default-sha256: c70267cdaa1ce23ed133e0129ffb5d1c4078d90bdfbbc7ff76515249765b0024
msgctxt "scenario8:scenario8_F2B7BADB_C3EA_40B1_AEE7_6D49DE1D5C3D"
msgid "⟪k:0⟫her tears were not for herself."
msgstr "⟪k:0⟫suas lágrimas não fossem por ela mesma."

#: scenario8:scenario8_4121FD91_F6D5_45F3_9CE9_623725AE1CC9
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: f881840274e09bb2c70d04166f17506989544b174dd634915337236a78771ac0
#. default-sha256: cd7ddcb4ca572030a1edd5cd782c2c53b030926210d12bf07399d0ff5d43e6b4
msgctxt "scenario8:scenario8_4121FD91_F6D5_45F3_9CE9_623725AE1CC9"
msgid "⟪k:0⟫Why are you crying?"
msgstr "⟪k:0⟫Por que você está chorando?"

#: scenario8:scenario8_D6308C27_83A4_4537_B693_124430D2D1DC
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: fd6ca8fbd235f6a213fea6c409bbbc5f34e7084c4343404ec9683377bfa7601e
