msgid ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫I figure this is probably my last chance to say it,⟪k:3⟫⟪k:4⟫so... ⟪k:5⟫thank you "
"for convincing me to hand over my key."
msgstr ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫Acho que esta é provavelmente minha última chance de dizer isso,⟪k:3⟫⟪k:4⟫então... "
"⟪k:5⟫obrigado por me convencer a entregar minha chave."

#: scenario8:scenario8_FF87DF36_1317_4F06_B292_9C10C06315C2
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: f7e3b986e40436241377d770b8f9b8141978871731ac14e3e7f4faeb3040b8e8
#. default-sha256: a4b326729504b80a0ca5174ccaa79ff3144ca39f313777a8497a6492218ecac4
msgctxt "scenario8:scenario8_FF87DF36_1317_4F06_B292_9C10C06315C2"
msgid "⟪k:0⟫⟪k:1⟫For giving me the courage to open my eyes."
msgstr "⟪k:0⟫⟪k:1⟫Por me dar a coragem de abrir os olhos."

#: scenario8:scenario8_00F54393_691B_4C8B_9333_2734C66DD262
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 6f0b5b971e5d535155b4c7d03516f44c58347d34148f3b8a6d433a0fe4cc52d4
