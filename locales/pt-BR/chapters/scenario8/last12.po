msgid "⟪k:0⟫⟪k:1⟫I wasn’t able to prevent Morgana’s death,"
msgstr "⟪k:0⟫⟪k:1⟫Não fui capaz de evitar a morte de Morgana,"

#: scenario8:scenario8_5936BA73_B67E_4639_9327_7606198B04B6
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: a5ff7abaddf66f34b074242c52c80deed7906ebe38d07a6e83a093d88670e3e4
