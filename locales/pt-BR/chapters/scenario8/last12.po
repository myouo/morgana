#: scenario8:scenario8_AED42863_A424_4B04_8542_1D46FD5715DA
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: ede338ebb5d36f725cd84da54e14599484a035c46a6500a70f2b949d6bbf68d5
#. default-sha256: 0695642ebce7ce18acd63e7c0019240c8a43004c128c6ccbc92a3a9b7cb54359
msgctxt "scenario8:scenario8_AED42863_A424_4B04_8542_1D46FD5715DA"
msgid "⟪k:0⟫⟪k:1⟫He opens the door, heading the four-man procession out of the tower, as he had in."
msgstr ""
"⟪k:0⟫⟪k:1⟫Ele abre a porta, conduzindo a procissão de quatro homens para fora da torre, como "
"havia feito na entrada."

#: scenario8:scenario8_C1DB5E46_FA01_4DD6_8F5E_004447434A7E
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 5d169fe00d32a51f70765d76be8392a4118854035e0a38e7dabf378abd49a79d
#. default-sha256: bdeb89b7d0d79f1df2c20f563dfc423f604c9b7acbf5a5c6bb7430c014d8a684
msgctxt "scenario8:scenario8_C1DB5E46_FA01_4DD6_8F5E_004447434A7E"
msgid "⟪k:0⟫I walk at the back of the line."
msgstr "⟪k:0⟫Eu ando no final da fila."

#: scenario8:scenario8_B95A895B_0AE5_4A8E_B7B5_384C42CA534F
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 949caae5ffa2eb0aa5a2c24b3e90f3dc2691e5f77fd2f0e8a089ec732991ea1d
#. default-sha256: a9c9a09d585ba65b2a3bcc7fc9306433119ab000bf58f89a7205840a0cfa1a95
msgctxt "scenario8:scenario8_B95A895B_0AE5_4A8E_B7B5_384C42CA534F"
msgid ""
"⟪k:0⟫Each step they take down the spiral staircase is slow and ponderous,⟪k:1⟫⟪k:2⟫as if weighted "
"down by the knowledge of their sins."
msgstr ""
"⟪k:0⟫Cada passo que eles dão na escada em espiral é lento e pesado,⟪k:1⟫⟪k:2⟫como se "
"sobrecarregados pelo conhecimento de seus pecados."

#: scenario8:scenario8_BEE19C25_4387_4098_BC3E_91D6906BBC5A
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: c1a836f8a1d759da49f1395e0b4c23f24bb115433bd0ba077df4a5c0be8c2513
#. default-sha256: 1181e9d494e19680cd302ba3108e7a59bda83a781d5474ff746fdce15f5c3b4f
msgctxt "scenario8:scenario8_BEE19C25_4387_4098_BC3E_91D6906BBC5A"
msgid "⟪k:0⟫That they must make their way..."
msgstr "⟪k:0⟫Que eles devem seguir o caminho..."

#: scenario8:scenario8_C4712DCB_C162_4710_879A_2EEF4DA9452E
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 2ef2fc66721b9fcd2f56068dd49c53a64d0172d30ae83dd7cb584834538aeb1b
