msgid "⟪k:0⟫I ⟪k:1⟫accomplished⟪k:2⟫ something."
msgstr "⟪k:0⟫Eu ⟪k:1⟫consegui⟪k:2⟫ algo."

#: scenario8:scenario8_9C6ECEBE_D077_4098_BD2B_1FA6B64D6C53
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 5229a0ba0c4c71a7bc1448b82802513499a623135fe9f5cb183335f9de50d07c
#. default-sha256: 3fe39f133cb6131a13ada7a184f490f5630e3a9a042f76b31465ed07edd2979b
msgctxt "scenario8:scenario8_9C6ECEBE_D077_4098_BD2B_1FA6B64D6C53"
msgid "⟪k:0⟫The sum of everything I did these three days..."
msgstr "⟪k:0⟫A soma de tudo que fiz nesses três dias..."

#: scenario8:scenario8_CB3C7978_9C00_4437_A359_E6D28E83A517
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: ff5da8cbdeedfd677161502c546eb2701b57179547b6ea304fc9b3b49492a7a5
