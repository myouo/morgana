msgctxt "scenario8:scenario8_C4712DCB_C162_4710_879A_2EEF4DA9452E"
msgid "⟪k:0⟫to the place they will make their atonement."
msgstr "⟪k:0⟫para o lugar onde farão sua expiação."

#: scenario8:scenario8_C16EBD60_51C9_4BC5_8094_E87636C13BEB
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: fc07115910b7110b372bedba9fd8223d48b6ba9cd948c934272863a7081b1d88
