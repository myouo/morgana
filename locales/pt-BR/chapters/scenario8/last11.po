#: scenario8:scenario8_78C4A1AD_06F0_404A_A911_289C2D1A8545
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 818de018497f45e2c4c24a4e87935e1bdd923df945cbde7b52a09c4fce88b3b3
#. default-sha256: 6e8559c938efbd680f342fb25c443d7e3ba568981d655a234950abd242ff47cd
msgctxt "scenario8:scenario8_78C4A1AD_06F0_404A_A911_289C2D1A8545"
msgid "⟪k:0⟫the lock disengaging and the door giving a deep groan as it swings open."
msgstr "⟪k:0⟫a fechadura se abre e a porta solta um rangido profundo ao ceder."

#: scenario8:scenario8_23F4E655_115E_47D8_81D4_32424412E816
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: f287398f236614b393945366c9afc8fb963ac547b58e6bbd5fae570eddea2b9f
#. default-sha256: 23a510e91c8ba3653ca7d11768931734881c777dd588acac53caa0d42c0ade98
msgctxt "scenario8:scenario8_23F4E655_115E_47D8_81D4_32424412E816"
msgid "⟪k:0⟫⟪k:1⟫⟪k:2⟫Beyond it, a spiral staircase extends high into the sky."
msgstr "⟪k:0⟫⟪k:1⟫⟪k:2⟫Atrás dela, uma escada em espiral se estende alto em direção ao céu."

#: scenario8:scenario8_039FE425_1400_4CF4_91E9_3587DDD3BA30
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 3f49c901fb69cba584bb4b9e9dee3beccff1d79f4888651fcfc6c5b292ef65ba
#. default-sha256: 57912d97d5a3591fe53d17071e4d7bd115358d4a5e58096bc4dc86f4716fe410
msgctxt "scenario8:scenario8_039FE425_1400_4CF4_91E9_3587DDD3BA30"
msgid ""
"⟪k:0⟫Every time I’ve climbed these stairs, it’s always been a solemn affair—⟪k:1⟫and now is no "
"different."
msgstr ""
"⟪k:0⟫Cada vez que subi essas escadas, foi sempre um momento solene—⟪k:1⟫e agora não é diferente."

#: scenario8:scenario8_2940BC09_DF88_414F_83CD_7E63A3C23521
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 1519e9d5712b11af49bcb29d852f94f524293059fd575f47084169d8c2381517
#. default-sha256: 5d085510e059dd8356776928a5b404378267c80932bbbb919fdf294ab0305dbc
msgctxt "scenario8:scenario8_2940BC09_DF88_414F_83CD_7E63A3C23521"
msgid ""
"⟪k:0⟫I’ve succeeded, though. I’ve got them all here,⟪k:1⟫ready to set her free before she’s "
"supposed to die."
msgstr ""
"⟪k:0⟫Mas eu consegui. Tenho todos eles aqui,⟪k:1⟫pronto para libertá-la antes que ela morra."

#: scenario8:scenario8_1A5A083C_156A_46D0_A0BC_EED6903904BE
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 89623c37548ae519ccbe7c7a3a53b121f79314f212b3e173e696f9dca17db991
