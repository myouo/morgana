#: scenario8:scenario8_4AF3C7D2_339F_448B_B256_1268AAE11D3D
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 380a359217b86c79fff51aa712d28b841ab8ad96be197fdfa52ddc1f2b1f1c61
#. default-sha256: c1169eac879e3303a825ae53c02bf9545117cb6e6af81fc11d85435fb514ec64
msgctxt "scenario8:scenario8_4AF3C7D2_339F_448B_B256_1268AAE11D3D"
msgid ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫⟪k:4⟫⟪k:5⟫⟪k:6⟫⟪k:7⟫⟪k:8⟫⟪k:9⟫⟪k:10⟫⟪k:11⟫⟪k:12⟫⟪k:13⟫⟪k:14⟫⟪k:15⟫As you "
"know, I am not from this land."
msgstr ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫⟪k:4⟫⟪k:5⟫⟪k:6⟫⟪k:7⟫⟪k:8⟫⟪k:9⟫⟪k:10⟫⟪k:11⟫⟪k:12⟫⟪k:13⟫⟪k:14⟫⟪k:15⟫Como sabe, "
"eu não sou desta terra."

#: scenario8:scenario8_F654B6ED_85D3_4495_9C45_7DB4B48E14FC
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: b91b89c1b183b46c640198269acb073dadb98bc4669e9cdb53b89d5688f3d6ce
#. default-sha256: 09331d75dc1588244f5249554964504abcd86596ae4e3baa37382258a90a7baf
msgctxt "scenario8:scenario8_F654B6ED_85D3_4495_9C45_7DB4B48E14FC"
msgid "⟪k:0⟫⟪k:1⟫The issue is,"
msgstr "⟪k:0⟫⟪k:1⟫O problema é,"

#: scenario8:scenario8_7CA8498D_9531_4EE3_B774_EF2F2164929C
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 70855b9f8e9b9471ada8159b73aa4c137d347082b1895028cbfd4722aa10fc4d
#. default-sha256: d1072bb19bc9daf97c0f0cafcbd562e9712b32f107f8bd65253769c85b7cb1bd
msgctxt "scenario8:scenario8_7CA8498D_9531_4EE3_B774_EF2F2164929C"
msgid "⟪k:0⟫⟪k:1⟫I don’t know any more about where I came from than you."
msgstr "⟪k:0⟫⟪k:1⟫que não sei mais sobre de onde vim do que você."

#: scenario8:scenario8_62E45312_CA49_40BA_A281_F36395ADB333
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 93006e67b7feccd5caa62f7bdb0495ab0635181db736f35951798f527106c358
#. default-sha256: b81634fbb8cabfb235e9c6fde431de294772127bfed10f775cf0fb30fcf3ae3e
msgctxt "scenario8:scenario8_62E45312_CA49_40BA_A281_F36395ADB333"
msgid "⟪k:0⟫⟪k:1⟫most of my memories are gone."
msgstr "⟪k:0⟫⟪k:1⟫a maioria das minhas memórias se foram."

#: scenario8:scenario8_46ABE5C8_45D1_4BD6_B048_61D189617F6A
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: c7d661bf4c56a5f62e07f9244abc59faf7d0b9ca26d351fb127973791ba5f360
#. default-sha256: dd723a314011750c9abe05cc1325ae9a16d1e59493ab42b420ad98f2b4342b1c
msgctxt "scenario8:scenario8_46ABE5C8_45D1_4BD6_B048_61D189617F6A"
msgid "⟪k:0⟫or perhaps a messenger."
msgstr "⟪k:0⟫ou talvez fosse um mensageiro."

#: scenario8:scenario8_EB475B59_2055_49A4_8FC2_25857E677057
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 6441b23db78bd3fecfb2cf84de6e2eda15969a76545c29e0e9f80b55f9a09e31
#. default-sha256: a82242853badeac457557ac328ca3bd7e3141ed26be55b4d181f74dd88db8409
msgctxt "scenario8:scenario8_EB475B59_2055_49A4_8FC2_25857E677057"
msgid ""
"⟪k:0⟫I vaguely remember being waylaid.⟪k:1⟫⟪k:2⟫We were vastly outnumbered, massacred with little "
"resistance.⟪k:3⟫⟪k:4⟫Or at least, I assume that’s what happened."
msgstr ""
"⟪k:0⟫Lembro-me vagamente de ter sido emboscado.⟪k:1⟫⟪k:2⟫Em grande desvantagem numérica, fomos "
"massacrados sem muita resistência.⟪k:3⟫⟪k:4⟫Ou pelo menos, presumo que foi isso que aconteceu."

#: scenario8:scenario8_91A0BF4C_661D_4FD5_92CC_7791798CE7F3
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: deb310f46efa0403ef31cef4b1de21a8681ae9e335598d8b12614232cfb129df
#. default-sha256: f22ea1c0f62383f01effdcf5eb9d9f5b766a32da6f551a36e6c4c0ff1e9f8499
msgctxt "scenario8:scenario8_91A0BF4C_661D_4FD5_92CC_7791798CE7F3"
msgid ""
"⟪k:0⟫I was a slave for one grueling, torturous year.⟪k:1⟫⟪k:2⟫No one treated me like a human "
"being.⟪k:3⟫⟪k:4⟫There was no one from the same part of the world as me."
msgstr ""
"⟪k:0⟫Eu fui um escravo por um ano torturante e extenuante.⟪k:1⟫⟪k:2⟫Ninguém me tratou como um ser "
"humano.⟪k:3⟫⟪k:4⟫Não havia ninguém da mesma parte do mundo que eu."

#: scenario8:scenario8_D0CD0533_F04D_43F6_BA35_FF5B6565F2CC
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 2d1848b7fbaaf3328d6256609da6c175fd125520fc8708a4dba6fee3b97008a2
#. default-sha256: 2d0923a9311a4d7f19248c6c5be92961b1f21018edad56f6fbeb58335e3ce68a
msgctxt "scenario8:scenario8_D0CD0533_F04D_43F6_BA35_FF5B6565F2CC"
msgid "⟪k:0⟫And there was no one to come to my aid."
msgstr "⟪k:0⟫E não havia ninguém para vir em meu auxílio."

#: scenario8:scenario8_B49E446F_A5CA_4682_9308_20113A8DA388
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 69c23e377cf3ea5da6af31d00ad3b155d4ac7f4a688ac5ca719503be4e390808
#. default-sha256: 5b76a5d49b98e32f501474bc36298268f94faf8ce96b40ebc1f33fabab9cfb61
msgctxt "scenario8:scenario8_B49E446F_A5CA_4682_9308_20113A8DA388"
msgid ""
"⟪k:0⟫But to be honest, I think I was happier ⟪k:1⟫not⟪k:2⟫ understanding what people were saying "
"about me."
msgstr ""
"⟪k:0⟫Mas para ser honesto, acho que eu era mais feliz ⟪k:1⟫não⟪k:2⟫ entendendo o que as pessoas "
"estavam dizendo sobre mim."

#: scenario8:scenario8_5C79E8CC_1756_4827_82A1_033BDCF716E7
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 8fdbd70e58a6d4b9350b4f81957661cf4601e1fb3b3165bb9b6a132c9a5c40ac
#. default-sha256: ac9d2826a406912bbd3d861eb21af84780ebea1361db4cc575a16e23d437ad4e
msgctxt "scenario8:scenario8_5C79E8CC_1756_4827_82A1_033BDCF716E7"
msgid ""
"⟪k:0⟫And the longer I was treated as something less than human,⟪k:1⟫the more I began to question "
"whether I really ⟪k:2⟫was⟪k:3⟫ one."
msgstr ""
"⟪k:0⟫E quanto mais eu era tratado como algo menos que humano,⟪k:1⟫mais eu começava a questionar "
"se eu realmente ⟪k:2⟫era⟪k:3⟫ um."

#: scenario8:scenario8_5D4E2E70_2BA6_4308_8F92_A45288D8602A
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: bf222947782104d6abfeb327dfbac103591c41a901062e648516ff4e12f148fb
#. default-sha256: ba310e281c79074bd77ab6fca52e4907c6602dc688216d9c9f54a5d818aaba76
msgctxt "scenario8:scenario8_5D4E2E70_2BA6_4308_8F92_A45288D8602A"
msgid ""
"⟪k:0⟫It was packed front to back with slaves—⟪k:1⟫⟪k:2⟫⟪k:3⟫or soon-to-be slaves, I suppose I "
"should say."
msgstr "⟪k:0⟫Estava lotada de escravos—⟪k:1⟫⟪k:2⟫⟪k:3⟫ou futuros escravos, suponho que deva dizer."

#: scenario8:scenario8_5598B724_4321_4338_A2FA_062604A78166
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 7fbe99367ad9450a2ce59cbca629340d0eff8cacd56fbb6e77ec557cc449d0b3
#. default-sha256: c619d38b859d741e291f1c9b5d1c4c30d4f0fcf82f9b9ac2131a5bc13803891e
msgctxt "scenario8:scenario8_5598B724_4321_4338_A2FA_062604A78166"
msgid ""
"⟪k:0⟫But beyond that, I didn’t think much of it.⟪k:1⟫⟪k:2⟫I didn’t find it disturbing or "
"unpleasant..."
msgstr "⟪k:0⟫Mas, além disso, não pensei muito.⟪k:1⟫⟪k:2⟫Não achei perturbador ou desagradável..."

#: scenario8:scenario8_B22846FD_AE3C_4CE5_B1E7_CBF181370F41
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 82a03938bfba0c5dccb4377ec55c681f775018263fc1190102822e30ad29e7c1
#. default-sha256: afa0ea1c3e8609513a2f0354dc1b1eb15c06759aa07303416ef3d5101aaae900
msgctxt "scenario8:scenario8_B22846FD_AE3C_4CE5_B1E7_CBF181370F41"
msgid ""
"⟪k:0⟫At my question, the girl turned her head up to look at me.⟪k:1⟫⟪k:2⟫Surprise crossed her "
"face for a few brief seconds,⟪k:3⟫but that was her only reaction to my appearance."
msgstr ""
"⟪k:0⟫Quando perguntei, a menina virou a cabeça para me olhar.⟪k:1⟫⟪k:2⟫Surpresa cruzou seu rosto "
"por alguns breves segundos,⟪k:3⟫mas essa foi a única reação dela à minha aparência."

#: scenario8:scenario8_90FE4610_3F11_4A96_8E4F_A3D7F00D11B6
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: d85f56708631887b66745b4ac68c9ed02e4df430812df226213f0fcb397926a6
#. default-sha256: 15b4b5ab23f9f9e5272904e863a23f0a29834bf7ccaf1ebf496b4f7da9bd9753
msgctxt "scenario8:scenario8_90FE4610_3F11_4A96_8E4F_A3D7F00D11B6"
msgid ""
"⟪k:0⟫I assume her thought process was roughly the same as mine, so she felt no need to fear me."
msgstr ""
"⟪k:0⟫Presumo que o seu raciocínio era mais ou menos o mesmo que o meu, então ela não sentiu "
"necessidade de me temer."

#: scenario8:scenario8_85A2FDBC_1AFC_48DF_AC4C_7707E3DE1EB4
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 47e9397bbe390d8afa1c327b232cdc03c05a20b26e28557cce030cf667f2ba8c
#. default-sha256: 8ce3d80d6c23dd54641e7ace04b1eae9bf1c8e6b993402541a971eefae994b1b
msgctxt "scenario8:scenario8_85A2FDBC_1AFC_48DF_AC4C_7707E3DE1EB4"
msgid "⟪k:0⟫I’m sad because I didn’t get the chance to show my gratitude to people very dear to me."
msgstr ""
"⟪k:0⟫Estou triste porque não tive a oportunidade de demonstrar minha gratidão a pessoas muito "
"queridas para mim."

#: scenario8:scenario8_587E1576_703A_451D_82BC_2C5A4C09DD62
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 4130bbc53212a08c86ef1c6be9ce5a6d3eecbc89f9ea9c18d65fa31512c0dae8
#. default-sha256: d6c252cd673b0eb49e674f6ba6425f27974d971ff230341f54aad96c71f2fc09
msgctxt "scenario8:scenario8_587E1576_703A_451D_82BC_2C5A4C09DD62"
msgid "⟪k:0⟫her voice, despite being soft, cut through the crying and wailing of the other slaves."
msgstr "⟪k:0⟫sua voz, apesar de suave, atravessava o choro e o lamento dos outros escravos."

#: scenario8:scenario8_A555FD47_344D_49EA_8C98_1E6339700658
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 8191907f5b2510efa4653b6147a7fb31bf37c9df18fdab17147f367b3731a3f4
#. default-sha256: 13351bbcf83758dfbd7040a544997be2a0f6f93027a83b76934a8cab47b099bc
msgctxt "scenario8:scenario8_A555FD47_344D_49EA_8C98_1E6339700658"
msgid "⟪k:0⟫I pictured it like... ⟪k:1⟫a single patch of clear water in the middle of a swamp,"
msgstr "⟪k:0⟫Eu pensei nela como... ⟪k:1⟫um único fio de água limpa no meio de um pântano,"

#: scenario8:scenario8_1523D91D_0AAD_47FB_85DC_F5D0923DFD5B
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: b723aa0c5fb777e1489690fe5073d1765e4182fe6cbdf2b7c73972cf3b32eb87
#. default-sha256: 4ea36b9f2a980620c07dcd627ca1cede471a73a2434143bc84b2b425510a1ff1
msgctxt "scenario8:scenario8_1523D91D_0AAD_47FB_85DC_F5D0923DFD5B"
msgid "⟪k:0⟫I’ll apologize... ⟪k:1⟫anything!"
msgstr "⟪k:0⟫Eu pedirei desculpas... ⟪k:1⟫qualquer coisa!"

#: scenario8:scenario8_D8E48D86_DFF4_4599_8060_1E6E498FA011
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 1811f75d3f4e2e81c3afd5e1515602c13ac3341aa9d80353b155fb66b99948b1
#. default-sha256: 48f41697b22461c825c2f67ac00db3078091b23a05c42741f58ec0ffc02c435d
msgctxt "scenario8:scenario8_D8E48D86_DFF4_4599_8060_1E6E498FA011"
msgid "⟪k:0⟫............"
msgstr "⟪k:0⟫............"

#: scenario8:scenario8_089B583B_F350_4F78_9032_45D919E1EB2B
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 1133a022a8709bb476a08eace8175d05685378a4e3bcde05a0a98bcf834bfd19
#. default-sha256: b87665d11429f37897c48cb1f4e2e3cab99c8be152b3993532248f379dd553dd
msgctxt "scenario8:scenario8_089B583B_F350_4F78_9032_45D919E1EB2B"
msgid "⟪k:0⟫Ahahahahahahaha!"
msgstr "⟪k:0⟫Ahahahahahahaha!"

#: scenario8:scenario8_4383889C_5F68_4126_A404_75D6368BC473
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: c2c67e949716cdda59d626b04095bee007b31fd402a9802c565c63fd8e9fb669
#. default-sha256: a808068cda8e10e1049889169ee26a73c72592b31e24b5665cafe0f284ba2552
msgctxt "scenario8:scenario8_4383889C_5F68_4126_A404_75D6368BC473"
msgid ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫⟪k:4⟫⟪k:5⟫Holding a sword in my hand felt amazingly... ⟪k:6⟫⟪k:7⟫right⟪k:8⟫."
"⟪k:9⟫⟪k:10⟫Whatever work I once did must have required me to use a blade."
msgstr ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫⟪k:4⟫⟪k:5⟫Segurar uma espada na minha mão parecia incrivelmente... ⟪k:6⟫⟪k:7⟫"
"certo ⟪k:8⟫.⟪k:9⟫⟪k:10⟫Qualquer trabalho que eu fazia antes deveria ter exigido que eu usasse uma "
"lâmina."

#: scenario8:scenario8_89902CC0_AFC6_42A0_A5A4_BBC64B3B4FC1
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 54596012742dcbde37ad87290e74c4e2576b770422c61e8df0f33a48aef55222
#. default-sha256: a2d3031d299847773aa47b3a12f1f78c98f941c940fc1ac72805bcd78f62022c
msgctxt "scenario8:scenario8_89902CC0_AFC6_42A0_A5A4_BBC64B3B4FC1"
msgid ""
"⟪k:0⟫Dead bodies sprawled out around me.⟪k:1⟫⟪k:2⟫Corpses I had made. Lives I had snuffed out."
msgstr ""
"⟪k:0⟫Cadáveres se espalhavam ao meu redor.⟪k:1⟫⟪k:2⟫Corpos que eu havia produzido. Vidas que eu "
"havia extinguido."

#: scenario8:scenario8_0A0C1F49_22F0_451C_B592_62052AAB7555
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 09e75409705cd92af618e0f3a97e48ef82cb6ffdf75a2daabcb4ad50f6d59df5
#. default-sha256: d4c6f34fdf26ce7f92145aa28b10b8623e253bb96db00bdbeda6afcf78003c2d
msgctxt "scenario8:scenario8_0A0C1F49_22F0_451C_B592_62052AAB7555"
msgid ""
"⟪k:0⟫I don’t have the words to describe the high it gave me killing those men, the power I felt "
"over them."
msgstr ""
"⟪k:0⟫Não tenho palavras para descrever a euforia que senti ao matar aqueles homens, o poder que "
"senti sobre eles."

#: scenario8:scenario8_ECE749DB_420F_4DC2_AB04_C067F0CDB9CE
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: eec2558c1b7c89a84fef607bd25978a9c11f24824d41bebef465c8b2449664c4
#. default-sha256: dc7f41ff3d45cb2225ae978b24b955ddc5c1c2885000923c7864e4d9ccb689a0
msgctxt "scenario8:scenario8_ECE749DB_420F_4DC2_AB04_C067F0CDB9CE"
msgid ""
"⟪k:0⟫I was driven mad by the stench of blood filling the air.⟪k:1⟫⟪k:2⟫No, it just drew out what "
"was always there."
msgstr ""
"⟪k:0⟫Fiquei louco com o cheiro de sangue que enchia o ar.⟪k:1⟫⟪k:2⟫Não, apenas extraiu o que "
"sempre esteve lá."

#: scenario8:scenario8_965466F8_4A8D_4E15_8294_3DB6C0042AF9
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 31aa1eeca5b4a6c60945e278af23182ba37457185bffffa64a8d4e62dc9d4aad
#. default-sha256: 7d98b5029372f88972d9ddc66ae989fcbff7efc4dabcbc4e3628a57f88807fc3
msgctxt "scenario8:scenario8_965466F8_4A8D_4E15_8294_3DB6C0042AF9"
msgid "⟪k:0⟫If I weren’t already deranged,"
msgstr "⟪k:0⟫Se eu já não fosse transtornado,"

#: scenario8:scenario8_E30A0CCB_D763_4642_86A5_DE4025B02443
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: e747653cd6f3c08f0692afe065b3beffbd6681d5dd6044cb6fcf4f69ed630a4f
#. default-sha256: 1b7eaa80e0a314e543364bb26695c61590467a4f03ba22cbd9a0ce7c454c9c2d
msgctxt "scenario8:scenario8_E30A0CCB_D763_4642_86A5_DE4025B02443"
msgid "⟪k:0⟫Hey. You. Unlock my shackles for me."
msgstr "⟪k:0⟫Ei. Você. Solte minhas algemas para mim."

#: scenario8:scenario8_976A8293_FA85_4068_9959_A0747028E43D
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
