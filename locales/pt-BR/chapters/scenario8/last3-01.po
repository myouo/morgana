msgid ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫Wha— ⟪k:3⟫⟪k:4⟫Th-⟪k:5⟫That can’t be right...⟪k:6⟫⟪k:7⟫I’m sure I’ve been smiling."
msgstr ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫Que— ⟪k:3⟫⟪k:4⟫I-⟪k:5⟫Isso não pode estar certo...⟪k:6⟫⟪k:7⟫Tenho certeza de que "
"estive sorrindo."

#: scenario8:scenario8_71D278E8_A4E6_4699_99AB_D18D8754EC03
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 3bc83000f55e4c98ee1897826129a9bebd1512a1b7d7bc8fd7a690be5c5bc5eb
#. default-sha256: 7d0ef0595ef5960bcc631b55751217fcecb9aafb449b5e74625776d4b3204e7d
msgctxt "scenario8:scenario8_71D278E8_A4E6_4699_99AB_D18D8754EC03"
msgid "⟪k:0⟫I’m really glad you decided to come with me."
msgstr "⟪k:0⟫Estou muito feliz que você decidiu vir comigo."

#: scenario8:scenario8_CD72C044_BFA1_41D0_8B39_3193E6CED39F
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 3729322a8da9e70d5f0b05bd360524d934255a6c5c52bdc75781f50416bad308
#. default-sha256: 197305e5e83ec3afd7febc222812646b020ceb3054dfdeea9632b3216e43ea3c
msgctxt "scenario8:scenario8_CD72C044_BFA1_41D0_8B39_3193E6CED39F"
msgid ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫Until that day, I had never known how good it felt to have someone who wanted me "
"in their life—"
msgstr ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫Até aquele dia, eu nunca tinha sabido como era bom ter alguém que me queria em sua "
"vida—"

#: scenario8:scenario8_DCB637E0_5BB5_4D40_BF49_0311E5C87F0E
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: f9d370805a9c141fddf1eb65b0a37af42da69687ea308f981c0ce675ec305cba
