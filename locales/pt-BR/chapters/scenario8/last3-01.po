#: scenario8:scenario8_7271CF53_2F9D_4C71_BB5A_EFD55E3FD8B8
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 27504ec3e945e6a6bc7d32f6f020848c2df051e48c876d222d1c9efb30a25a3e
#. default-sha256: f27af94f2ac864c1db7795514717078b448c4e495fee031b6a7504c73196cc35
msgctxt "scenario8:scenario8_7271CF53_2F9D_4C71_BB5A_EFD55E3FD8B8"
msgid ""
"⟪k:0⟫After discussions I had no part in, it was decided that my uncle would be the next head. "
"⟪k:1⟫That they weren’t confident I had the spine to do the job properly."
msgstr ""
"⟪k:0⟫Após discussões das quais não participei, foi decidido que meu tio seria o próximo chefe. "
"⟪k:1⟫Que eles não estavam confiantes de que eu tinha determinação para fazer o trabalho "
"corretamente."

#: scenario8:scenario8_14AA6030_BFFC_4D54_8F5F_CD1BA4D4AA3D
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: b956a202be6795b0533a2e192a1ada436695980b1cd4125a8ce20367607f65c2
#. default-sha256: e1b4c8bf541f562691ec18ecac7bb8f628a64f123f01660679158d2828c15e75
msgctxt "scenario8:scenario8_14AA6030_BFFC_4D54_8F5F_CD1BA4D4AA3D"
msgid "⟪k:0⟫I wasn’t sure what to think."
msgstr "⟪k:0⟫Eu não tinha certeza do que pensar."

#: scenario8:scenario8_826116EA_6045_40AC_A4A1_DE73A200E194
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 4d32b80da00d4bf0053da36f7f0d01f75b87d496660b17a4459c9124a502be8d
#. default-sha256: 0efa8e2dd33f7a69dc5edd8eebab48103b9326410acc3073c534829e0337cc40
msgctxt "scenario8:scenario8_826116EA_6045_40AC_A4A1_DE73A200E194"
msgid "⟪k:0⟫If it meant I could go on with my quiet life,⟪k:1⟫I didn’t care who they picked."
msgstr ""
"⟪k:0⟫Se isso significasse que eu poderia continuar com minha vida tranquila,⟪k:1⟫não me importava "
"com quem eles escolhessem."

#: scenario8:scenario8_3A7480C5_2579_4E5D_BD3A_355A5A2BB7BC
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 95c84f431f1c371b20e5a6eba68e0403d5e1899693686761cc6b760db592ed61
#. default-sha256: eb379e8be5a61396a178781bb3e76a476ccb9e2dff55981c8457e5e5288fa95a
msgctxt "scenario8:scenario8_3A7480C5_2579_4E5D_BD3A_355A5A2BB7BC"
msgid ""
"⟪k:0⟫My uncle, though, seemed to have caught on to my apathy,⟪k:1⟫which he did not take kindly to,"
msgstr "⟪k:0⟫Meu tio, porém, parecia ter percebido minha apatia,⟪k:1⟫que não aceitou entusiasmado,"

#: scenario8:scenario8_0F9B4C2F_8D4B_457A_9E21_31B09E682CB3
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 866c66707370fcf1a60f791acb180dd031693ae6d4787f19661cc1df941e106b
#. default-sha256: dc05795c172b095489dc98744eaa6f455c9b85ffe593bbba1a2875d5ac61b708
msgctxt "scenario8:scenario8_0F9B4C2F_8D4B_457A_9E21_31B09E682CB3"
msgid "⟪k:0⟫⟪k:1⟫So this is our new home, dearest Mell!"
msgstr "⟪k:0⟫⟪k:1⟫Então esta é a nossa nova casa, querido Mell!"

