msgctxt "scenario8:scenario8_75447CBB_525D_40EE_A675_182108C12D34"
msgid "⟪k:0⟫“I’m staying home because I want to be with you as much as possible.”"
msgstr "⟪k:0⟫“Vou ficar em casa porque quero estar com você tanto quanto possível.”"

#: scenario8:scenario8_8D5AB42A_967E_45D3_B838_B7700592D49C
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 48f50ae52a4539e85cc015c6e820e3579bd4d934a50937be0eb19d4da9c57fd8
