#: scenario8:scenario8_BA103644_E5BA_4A61_A657_15137CCE2AB1
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 31191cbb327415064c78b6f4dd69d92c921ec6f739c5a2aeda45688ee858420b
#. default-sha256: 4ff0c1e851dde7e2893894b7759c9c0356c4147aa393da52de2345371d68036e
msgctxt "scenario8:scenario8_BA103644_E5BA_4A61_A657_15137CCE2AB1"
msgid ""
"⟪k:0⟫You’re not going to go and say you want to return home in a couple months when you realize "
"life isn’t as luxurious here as it was back there, are you?"
msgstr ""
"⟪k:0⟫Você não vai dizer que quer voltar para casa em alguns meses quando perceber que a vida não "
"é tão luxuosa aqui como era lá atrás, não é?"

#: scenario8:scenario8_D53E37F5_E62E_43EB_85DE_F5F5852B0380
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 2c64b97f2e072ca0b4f8ee88badcd99b9a588ab184a88b1e3df3d7aca6b59812
#. default-sha256: ae2b1f2be7c8c6ca0e4074ca3ec7deb6ae5bffc5c9c4240a7398d9f87fecba83
msgctxt "scenario8:scenario8_D53E37F5_E62E_43EB_85DE_F5F5852B0380"
msgid "⟪k:0⟫⟪k:1⟫There’s only one thing in the whole wide world I really need."
msgstr "⟪k:0⟫⟪k:1⟫Só há uma coisa no mundo inteiro que eu realmente preciso."

#: scenario8:scenario8_E9C7B0D6_955F_47A6_A1B6_B3B638AA981D
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 6e825ada6c93fc11365fbf34df83159e1d0e0b349f1d88ec5dd153b3f31cdeb8
