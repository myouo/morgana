msgctxt "scenario8:scenario8_78516612_89A0_4842_AE37_8A5A650138DF"
msgid ""
"⟪k:0⟫I was hardly prince material—⟪k:1⟫⟪k:2⟫I wasn’t strong or handsome or regal enough for that—"
msgstr ""
"⟪k:0⟫Eu dificilmente tinha algo de príncipe—⟪k:1⟫⟪k:2⟫eu não era forte, bonito ou majestoso o "
"suficiente para isso—"

#: scenario8:scenario8_75447CBB_525D_40EE_A675_182108C12D34
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 18701cb92e7d34d1b70c00060096ba784c87b34484783e2afabe95461e0b4163
