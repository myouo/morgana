msgid "⟪k:0⟫⟪k:1⟫⟪k:2⟫When did I first start straying from the path?⟪k:3⟫"
msgstr "⟪k:0⟫⟪k:1⟫⟪k:2⟫Quando eu comecei a me desviar do caminho?⟪k:3⟫"

#: scenario8:scenario8_5CE02E04_DBFD_40AC_9C60_98554641767A
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 8f93a36406eb38a18fb7aa3863fdfbdc728335e2aae5f996a3d00dede553c1ca
#. default-sha256: 07b42266e570bfdc14f950d0fce46046bdf26f5c48b225df25f3bfb17cd5c895
msgctxt "scenario8:scenario8_5CE02E04_DBFD_40AC_9C60_98554641767A"
msgid ""
"⟪k:0⟫⟪k:1⟫“Yes, I know her. ⟪k:2⟫Or, I knew her, years ago...”⟪k:3⟫⟪k:4⟫⟪k:5⟫“I see... What do "
"you want to do then, lord? ⟪k:6⟫You look sick.”⟪k:7⟫⟪k:8⟫⟪k:9⟫“This doesn’t change anything... We "
"lock the witch up and proceed as planned.”"
msgstr ""
"⟪k:0⟫⟪k:1⟫“Sim, eu a conheço. ⟪k:2⟫Ou, eu a conheci, anos atrás...”⟪k:3⟫⟪k:4⟫⟪k:5⟫“Eu entendo... "
"O que quer fazer então, lorde? ⟪k:6⟫Você parece doente.”⟪k:7⟫⟪k:8⟫⟪k:9⟫“Isso não muda nada... Nós "
"prendemos a bruxa e procedemos conforme o planejado.”"

#: scenario8:scenario8_6D2C6D70_9BC3_4FD6_88A7_E24794741573
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: cce52c2706d2f968f80934866c3efba96e46126a763530ff288c0152fce974a6
