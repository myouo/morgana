msgctxt "scenario5:scenario5_D2E7F490_BA4E_4388_A083_E16CDDD4F1A1"
msgid "⟪k:0⟫Lead the way!"
msgstr "⟪k:0⟫好的，⟪k:1⟫拜托您了！"

#: scenario5:scenario5_EEF21F5F_2D34_417F_A3AA_95A49C57C2AF
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: cc9ef77d785ba2e3cb2ccbbc46ba2b983777016699de2e1b6359d6d0623ea808
