msgctxt "scenario5:scenario5_A6033E7A_86D1_4124_8A68_8D00A54D929B"
msgid "⟪k:0⟫but I shall not let go of her hand."
msgstr "⟪k:0⟫我也——⟪k:1⟫决不松开这只紧握的手。"

