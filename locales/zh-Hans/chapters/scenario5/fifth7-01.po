msgctxt "scenario5:scenario5_A19B5A9B_6DEE_40FC_AF38_4A0E1A518C20"
msgid "⟪k:0⟫but I found peace in that nothingness."
msgstr "⟪k:0⟫但也正因为什么都没有，⟪k:1⟫才让我倍感平静。"

#: scenario5:scenario5_71E64260_D9AD_4229_8124_626865BE8383
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: fde3f4badb9c05a32f1a94170ab162b932533df8647cddf40e218df0b53e9b9a
