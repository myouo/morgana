msgid "⟪k:0⟫............"
msgstr "⟪k:0⟫…………"

#: scenario5:scenario5_9FB03DE8_0D5D_4717_8FB2_F44670EFEC03
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 88247a672885628d1ca4f6e92dc0881edc2ac0acbbc62d78e1dcc475fea54a33
