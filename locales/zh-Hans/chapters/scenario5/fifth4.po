msgctxt "scenario5:scenario5_544B30C8_2862_43A1_8AF6_ABB4BC74ACEF"
msgid "⟪k:0⟫We needed another source of money, beyond what the shop took in."
msgstr "⟪k:0⟫……钱是必要的东西。⟪k:1⟫不能光靠做买卖，⟪k:2⟫还得从其他途径赚到钱。"

#: scenario5:scenario5_2950F572_63BF_42D2_90BD_943E614D3831
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 579c081644bcb7e25f7286216a7fa0e573106c9b113242881037d4f7daf7f3f1
