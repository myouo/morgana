msgctxt "scenario5:scenario5_B3899674_34FA_4458_A891_DA3A390A1B3D"
msgid "⟪k:0⟫Demon? ⟪k:1⟫Him? ⟪k:2⟫Michel?"
msgstr "⟪k:0⟫恶魔……？⟪k:1⟫是指他——⟪k:2⟫……米歇尔吗？"

#: scenario5:scenario5_29464700_1C60_48FD_9C75_F3152E457AF3
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 4dbae6c3ef8d2b1167718a93bdef8d24424aaa151fccb7cb1190750fb87cbd42
#. default-sha256: 4cd6c4bc14dd52dd4080654ad39e217dfad48ce47893ec54e56be82bdd47b0d6
msgctxt "scenario5:scenario5_29464700_1C60_48FD_9C75_F3152E457AF3"
msgid "⟪k:0⟫N-⟪k:1⟫No, he’s not curs—"
msgstr "⟪k:0⟫不……⟪k:1⟫不是的，⟪k:2⟫他并没有被诅咒——"

#: scenario5:scenario5_AE7C1CB4_95F7_4057_8995_BE29E66375D5
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 79cbc2207863b29262b7597376e66597d91a45cfa406929420a0a0dff8602bf6
#. default-sha256: a49da60b46892f6e9c2e8a37eedc2a1f0036f71d0b0c3c3591ed30b7ec61480b
msgctxt "scenario5:scenario5_AE7C1CB4_95F7_4057_8995_BE29E66375D5"
msgid "⟪k:0⟫⟪k:1⟫⟪k:2⟫Indeed! I am cursed!"
msgstr "⟪k:0⟫⟪k:1⟫⟪k:2⟫没错！⟪k:3⟫我就是被诅咒之人！"

#: scenario5:scenario5_384DD30F_A1C3_4A73_BFCF_B7E3DFACBC6F
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 46de7d818bfbf5259064db61e650003443778dd6061e87adb1529c9f3856b4bb
#. default-sha256: 8010b6a2156a9811e2e5dc0fea3288e7b661dc6eda87b2aab4b28d6b129b487f
msgctxt "scenario5:scenario5_384DD30F_A1C3_4A73_BFCF_B7E3DFACBC6F"
msgid ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫⟪k:4⟫⟪k:5⟫⟪k:6⟫⟪k:7⟫⟪k:8⟫The witch’s curse is real!⟪k:9⟫⟪k:10⟫I have "
"inherited it, in its entirety—⟪k:11⟫⟪k:12⟫as well as her purpose!"
msgstr ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫⟪k:4⟫⟪k:5⟫⟪k:6⟫⟪k:7⟫⟪k:8⟫魔女的诅咒确实存在！⟪k:9⟫不管是魔女的意志、⟪k:10⟫抑或"
"所有的诅咒，⟪k:11⟫都已经由我来继承了！"

#: scenario5:scenario5_E59C58D1_E3D3_41A7_B771_B1C16E79855D
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 0160b0d00564ad7396366b3fe2d94be4d4f3917e86bc2d3d3c18551d0dd9247c
#. default-sha256: 0dc8121c19449a84dabd8125f091a6c8477a271df04e1a104193577365c413df
msgctxt "scenario5:scenario5_E59C58D1_E3D3_41A7_B771_B1C16E79855D"
msgid "⟪k:0⟫—!"
msgstr "⟪k:0⟫…………！"

#: scenario5:scenario5_0CB33A79_4C6F_4949_B116_CA3F9D4681BF
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: b394f2d6e301318aea0880fc0bdcc1f8b416c0030828eedd0b9c1dc80587b40d
#. default-sha256: 368dbb2979d8b18938382f2860ef520659ba88f244c38bab9dee7267960421b4
msgctxt "scenario5:scenario5_0CB33A79_4C6F_4949_B116_CA3F9D4681BF"
msgid "⟪k:0⟫A witch, a demon, a spirit impure!⟪k:1⟫⟪k:2⟫Call me whatever you wish!"
msgstr "⟪k:0⟫魔女也好，⟪k:1⟫恶魔也罢，⟪k:2⟫或是不净之人，⟪k:3⟫随你们怎么叫我！"

#: scenario5:scenario5_711B9A6F_4494_4E8B_ACFC_EC7EEB85D949
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: c1fed2291c2a7412d552b55805f8381c48901e42823153d83943905eb706fbb5
#. default-sha256: c41fd350de2f0c825f29569da1c4037b83841c34a9de4423fdd4d519b9b57c34
msgctxt "scenario5:scenario5_711B9A6F_4494_4E8B_ACFC_EC7EEB85D949"
msgid "⟪k:0⟫For the truth shall not change!⟪k:1⟫⟪k:2⟫I carry within me an eternal curse!"
msgstr "⟪k:0⟫只有一件事是事实，⟪k:1⟫那即是——这具躯体内寄宿着无穷无尽的诅咒！"

#: scenario5:scenario5_711B9A6F_4494_4E8B_ACFC_EC7EEB95D949
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: b8745bb3cbd69498b47c8ff3d36e7e8a3f253a36a4b7c456a717c6e36244fc4e
#. default-sha256: b50b99f1a71bfce30d5e9e8129cdcef257f7082b0c8e35e3e91b4dd2f8102bf0
msgctxt "scenario5:scenario5_711B9A6F_4494_4E8B_ACFC_EC7EEB95D949"
msgid ""
"⟪k:0⟫Behold my flesh, pale as the moon!⟪k:1⟫⟪k:2⟫No red blood flows beneath this skin, as it does "
"yours!"
msgstr ""
"⟪k:0⟫看吧！⟪k:1⟫这苍白而毫无血色的肌肤！⟪k:2⟫⟪k:3⟫我皮肤下流淌的，⟪k:4⟫并非你们那种红色的鲜血！"

#: scenario5:scenario5_711B9A6F_4494_4E8B_ACFC_EC7EEB85D959
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 892e70466106f55bd8614441aae937d80327d86c49fbbf23894641a65e3d0035
#. default-sha256: a5b11b3621173722f8232e6941b8f13c4c15ac96d54f8024da2562be952930a2
msgctxt "scenario5:scenario5_711B9A6F_4494_4E8B_ACFC_EC7EEB85D959"
msgid ""
"⟪k:0⟫Behold my hair, utterly devoid of color,⟪k:1⟫⟪k:2⟫offered up to the Devil as part of our "
"pact!"
msgstr "⟪k:0⟫看吧！⟪k:1⟫这失去了一切色彩的白发！⟪k:2⟫⟪k:3⟫我付出所有色泽，⟪k:4⟫与恶魔缔结了契约！"

#: scenario5:scenario5_711B9A6F_4494_4E8B_ACFC_EC7EEB85D999
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 772e81f1e60876812ce9e197208509c92d1cedd7bfb3a19edd9a3f8cbf76743a
#. default-sha256: 42318f380067746d630de7ffeeb586f284e201b1441af4364e084bc11f41604a
msgctxt "scenario5:scenario5_711B9A6F_4494_4E8B_ACFC_EC7EEB85D999"
msgid "⟪k:0⟫Behold these crimson eyes!⟪k:1⟫⟪k:2⟫A symbol of the lifeblood spilt at my hands!"
msgstr ""
"⟪k:0⟫看吧！⟪k:1⟫这红色的瞳孔！⟪k:2⟫⟪k:3⟫这正是……被我夺去的无数生命流逝的血色，才让我染上了红瞳的证"
"据！"

#: scenario5:scenario5_711B9A6F_4494_4E8B_ACFC_EC7EEB85D849
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 3960217283e562f847834cb68a3840acc55eef6f642756465ecc6b8bbe34da35
#. default-sha256: f208be1d6f4988d1072ad1612f0cbb019623adc1d0fa1337072cba0fc7db6686
msgctxt "scenario5:scenario5_711B9A6F_4494_4E8B_ACFC_EC7EEB85D849"
msgid "⟪k:0⟫Ah... ⟪k:1⟫aaah..."
msgstr "⟪k:0⟫啊……⟪k:1⟫啊啊………"

#: scenario5:scenario5_E22FD1CE_DC1F_4F16_898F_96EFD80B6207
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 04d1ec42103c3a40437a9090f9a63b60463c8b6738e6752ac3d83ce0c88daa40
#. default-sha256: 9ba91c407bc6eaff0c03ede952f593e0dea0ba30eb83e08c56279526d50c6730
msgctxt "scenario5:scenario5_E22FD1CE_DC1F_4F16_898F_96EFD80B6207"
msgid "⟪k:0⟫I shall bring calamity upon you, as the witch of legend!"
msgstr "⟪k:0⟫正如同传闻所言——我将给你们降下灾祸！"

#: scenario5:scenario5_B5DDA295_5464_46AA_A330_C83F64301F84
