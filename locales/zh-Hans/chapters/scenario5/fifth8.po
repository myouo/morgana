#: scenario5:scenario5_DA07594C_05BB_4C6E_90E6_10C58B6D020E
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: a6a45139e23c9565c3c3260376977e421cc22429ac8c1b19d9704d083d5d6b97
#. default-sha256: 06b2d393aa6d4ce03171538ca04222b1a85ae477a607eec79126386ec24c390e
msgctxt "scenario5:scenario5_DA07594C_05BB_4C6E_90E6_10C58B6D020E"
msgid "⟪k:0⟫⟪k:1⟫⟪k:2⟫It would seem you are not aware whose house you’re trying to break into."
msgstr "⟪k:0⟫⟪k:1⟫⟪k:2⟫你们似乎完全不明白，⟪k:3⟫自己究竟踏足到了何地啊……"

#: scenario5:scenario5_2571D8CD_C2FB_4FEC_9C6F_2070907546C7
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: bb9b2ef330a689f3da5ea7ab60f8f260b43e56a63827644943ee780cb89783c0
#. default-sha256: e00b0f28933d0902c910393052776dd696a29dac21a7b4136689254ff90144fa
msgctxt "scenario5:scenario5_2571D8CD_C2FB_4FEC_9C6F_2070907546C7"
msgid ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫⟪k:4⟫⟪k:5⟫⟪k:6⟫⟪k:7⟫⟪k:8⟫⟪k:9⟫⟪k:10⟫⟪k:11⟫⟪k:12⟫The world went silent, like "
"time had come to a stop.⟪k:13⟫⟪k:14⟫No one could manage to say a word,"
msgstr ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫⟪k:4⟫⟪k:5⟫⟪k:6⟫⟪k:7⟫⟪k:8⟫⟪k:9⟫⟪k:10⟫⟪k:11⟫⟪k:12⟫——时间仿佛静止在那里，⟪k:13⟫万"
"籁无声。⟪k:14⟫⟪k:15⟫没有一个人，⟪k:16⟫能说出话来……"

#: scenario5:scenario5_5B8B418A_299A_4647_BACA_BA4B0FA7E40C
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: f92f8d72052a48abf7cbabf7385d2aa29d112935e82083da7db371c06b52ea69
#. default-sha256: a42a206d76c3a286db09b505e341618c20df2aa0054d26576992fd4efbd1db43
msgctxt "scenario5:scenario5_5B8B418A_299A_4647_BACA_BA4B0FA7E40C"
msgid "⟪k:0⟫only stare at the man who had appeared from within the mansion."
msgstr "⟪k:0⟫从房屋深处现身的，⟪k:1⟫正是那个男人。"

#: scenario5:scenario5_40BE19F6_C685_4BBB_AF0E_7D7350FEEDE2
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: ae6d93a02766b9c656299f43bf4f4f7e5f81f3992848d9699d35658e867df750
#. default-sha256: 51c90880e3ea71f574d1356ab629ebc78e59ca8f6664af9203d3f3ab3f656f44
msgctxt "scenario5:scenario5_40BE19F6_C685_4BBB_AF0E_7D7350FEEDE2"
msgid "⟪k:0⟫Surely you know what this place is called."
msgstr "⟪k:0⟫这座馆有何等传闻，⟪k:1⟫你们不会不知道吧……"

#: scenario5:scenario5_F9198B71_C35F_4BD1_84C0_071E80B99ABA
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 5a9052b85c2c1efcae8fcb7050ea3082702eeb2a24c9fcdd68482ea3f06d9040
#. default-sha256: 8cde5ee1eb6db5779e08e994abdd7dbdafc1e0ac5a422b4c7732ff3a34fe25f6
msgctxt "scenario5:scenario5_F9198B71_C35F_4BD1_84C0_071E80B99ABA"
msgid "⟪k:0⟫Beneath the dazzling midday sun,"
msgstr "⟪k:0⟫耀眼的阳光照射下的那个人——"

#: scenario5:scenario5_231177F8_A960_411F_BAD4_D4A6BF6A7379
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 20d4d77927df4087813cc8ef829f1c0dc0dcb1cb5e3909a945189d74552b5843
#. default-sha256: c1fc191ec33bf4079cea7cd07e0738dbf87ad8f7df0a49f4b60e718943d72c2b
msgctxt "scenario5:scenario5_231177F8_A960_411F_BAD4_D4A6BF6A7379"
msgid "⟪k:0⟫he had bone-chillingly alabaster skin and long, nearly translucently pale hair."
msgstr "⟪k:0⟫有着叫人背脊发凉的白色肌肤，⟪k:1⟫而他的长发，⟪k:2⟫更是纯白得几近透明。"

#: scenario5:scenario5_2D3C3470_7C9F_4431_B67D_D05BDB14A582
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 37d3fafd2dec48f536ad0eb639023df5cca8e837c43009cbf1a4ff3a1bd57eac
#. default-sha256: 4bf44bac5da3ae96d6313753300ae2a93651e131aa4b0547a53ffa2a46b8fc00
msgctxt "scenario5:scenario5_2D3C3470_7C9F_4431_B67D_D05BDB14A582"
msgid "⟪k:0⟫So surely you came prepared for whatever you would find..."
msgstr "⟪k:0⟫既然知道那些传闻，⟪k:1⟫想必你们已经做好觉悟了吧……"

#: scenario5:scenario5_D92D32C1_0A19_4E83_8C64_C449FF8172C1
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 2fcab3fb469106ffefda89aa8807e80ca891aaf30ebd463a6c7e3d0871fcb448
#. default-sha256: c2e94b6159fb6ebc8582953c3c176ea29014f89a2ccd2301cbc7c669ea25af88
msgctxt "scenario5:scenario5_D92D32C1_0A19_4E83_8C64_C449FF8172C1"
msgid "⟪k:0⟫And his eyes..."
msgstr "⟪k:0⟫然后，⟪k:1⟫他斜视投来一瞥——"

#: scenario5:scenario5_D8D799E7_FF18_48BA_B6E3_2BE52A033C20
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: e8885db8ff90c2e7f162f8204bc29392759215e003439d93f9ee3c0304bff7f9
#. default-sha256: 774d8c9bdaa5e6907c0bb8c2a245501f3ce6bfbda26d9334b11c981ac8f2379c
msgctxt "scenario5:scenario5_D8D799E7_FF18_48BA_B6E3_2BE52A033C20"
msgid "⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫⟪k:4⟫were like two blazing infernos staring out across the mob."
msgstr "⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫⟪k:4⟫那红色的瞳孔，⟪k:5⟫仿若摇曳着的火苗。"

#: scenario5:scenario5_C3378308_A7A1_4887_A697_04438710BFDE
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 949c2e354606f3278e1ddf90306699009816d36a6d5e45fa74b5d2fec2a0c85d
#. default-sha256: b88b2f3b8a44da9329fed1e9ec48dacd48f26714fb4607d8fa53f305d208c829
msgctxt "scenario5:scenario5_C3378308_A7A1_4887_A697_04438710BFDE"
msgid "⟪k:0⟫⟪k:1⟫...A-⟪k:2⟫A demon..."
msgstr "⟪k:0⟫⟪k:1⟫………恶、⟪k:2⟫恶魔啊………"

#: scenario5:scenario5_BFA40E06_D27F_497F_B8CF_AE295E4DD6A5
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 1c592c6155881d6b2943287142924882154ed7e1ba0a26245b6c6fcf9284a1d4
#. default-sha256: 58070a05cad81711d643e4652654dbf67b20cae7c15db369d41975756494edc2
msgctxt "scenario5:scenario5_BFA40E06_D27F_497F_B8CF_AE295E4DD6A5"
msgid "⟪k:0⟫Someone muttered, probably unconsciously."
msgstr "⟪k:0⟫有谁惊慌失措地嘟囔道。"

#: scenario5:scenario5_82BBF69C_0AA9_4DFA_BC35_4C07A8FFD1EB
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 32d4065939e8df7cd093e275aebdd56bf3918cc0da64a1ae0946bfad9bd6e28e
#. default-sha256: 867ba516e4633821d20a32f68feeeeda49ced8edc52b7fd2e3facf9e91a8726e
msgctxt "scenario5:scenario5_82BBF69C_0AA9_4DFA_BC35_4C07A8FFD1EB"
msgid "⟪k:0⟫He did, indeed, look like something not of this world."
msgstr "⟪k:0⟫的确，⟪k:1⟫眼前他的容貌——⟪k:2⟫完全不像普通的人类。"

#: scenario5:scenario5_4E2AFB9D_7BB0_47E8_9C5E_82973E743E92
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 1d8582fcbed605b755c12fcdc2852f0528abc17297de9f0287695b523b7279ac
#. default-sha256: f37de3ec1a9a46c1be8a5f7bc5e7119528eae67325ce9a988a4fab8e31b0bebc
msgctxt "scenario5:scenario5_4E2AFB9D_7BB0_47E8_9C5E_82973E743E92"
msgid "⟪k:0⟫Aaah, ⟪k:1⟫i-⟪k:2⟫it’s a demon!⟪k:3⟫The rumors about this place were true!"
msgstr "⟪k:0⟫啊、⟪k:1⟫啊啊……⟪k:2⟫是恶魔啊！⟪k:3⟫传闻是真的！⟪k:4⟫这座馆真的被诅咒了……！"

#: scenario5:scenario5_4D6A6178_F6D8_4178_A294_DC884CA04616
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 0e31a0ebfd8880fc8a3f904ba8cc4093a5a67971cb92f947d2df824d6279c918
#. default-sha256: 0cec94d77ccae108776ade8c2a2587543b5ca7203cbfc701ad3c81a85ca838bb
msgctxt "scenario5:scenario5_4D6A6178_F6D8_4178_A294_DC884CA04616"
msgid "⟪k:0⟫A cursed demon lives there!"
msgstr "⟪k:0⟫这就是……被诅咒的恶魔……！！"

#: scenario5:scenario5_B3899674_34FA_4458_A891_DA3A390A1B3D
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 77902f8286c28c8875316a9a1b087ce993165926f5e96029fff7382109ac18bf
