msgctxt "scenario5:scenario5_72D2410D_6DD9_449E_AB27_4AEBC7485B4F"
msgid "⟪k:0⟫He brought his head in. ⟪k:1⟫I closed my eyes, and—"
msgstr "⟪k:0⟫就这样，他的脸慢慢地靠近。⟪k:1⟫我也自然地眯起眼睛，⟪k:2⟫然后——"

