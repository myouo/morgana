msgid "⟪k:0⟫⟪k:1⟫⟪k:2⟫Giselle..."
msgstr "⟪k:0⟫⟪k:1⟫⟪k:2⟫……吉赛儿……"

#: scenario5:scenario5_7426F5EF_9110_47F0_A693_0D4F57D7DD4E
