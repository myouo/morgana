msgid "⟪k:0⟫I had to do it,"
msgstr "⟪k:0⟫必须要问清楚……"

#: scenario5:scenario5_D831D3C4_8153_499F_8E4E_3289F4DFA12D
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: b8ae6081eca840bbb5c4caf30f9091affd53f4c1f8719f2c8cf93e8a090e09f6
#. default-sha256: a752860095ea69f3cdecbb40519404719e9c021168b3aa51fb19a2a8b74b18b6
msgctxt "scenario5:scenario5_D831D3C4_8153_499F_8E4E_3289F4DFA12D"
msgid "⟪k:0⟫even if down that road lay truths I would be happier not seeing."
msgstr "⟪k:0⟫就算，⟪k:1⟫那是我不能接受的真实，⟪k:2⟫也必须问清楚——"

#: scenario5:scenario5_11AD9665_548E_4721_9E8C_08EE36F08894
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
