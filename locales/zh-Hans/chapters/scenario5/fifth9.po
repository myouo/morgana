msgid "⟪k:0⟫⟪k:1⟫⟪k:2⟫I..."
msgstr "⟪k:0⟫⟪k:1⟫⟪k:2⟫………那是因为…………"

#: scenario5:scenario5_0C4432C5_4125_4ADD_B0B3_F2A8BF3982BD
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: c7f36d19d094eeaf54fe38c7e15ea12a3bc5d2883c7e2b946d428a9962129714
#. default-sha256: 46caebc7d0d8753ff7d832cc8d16e2497166286a05647acbac9e068963ccedb0
msgctxt "scenario5:scenario5_0C4432C5_4125_4ADD_B0B3_F2A8BF3982BD"
msgid "⟪k:0⟫⟪k:1⟫And I very much doubt...⟪k:2⟫⟪k:3⟫you will find what I have to say agreeable."
msgstr "⟪k:0⟫⟪k:1⟫更何况我说的话，⟪k:2⟫一定……⟪k:3⟫⟪k:4⟫是你不愿意听的事吧。"

#: scenario5:scenario5_3A40C90A_CD29_4C3F_8EC8_3B58B76D783A
