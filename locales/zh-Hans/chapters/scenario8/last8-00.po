#: scenario8:scenario8_6859F8BA_2B60_443D_A146_6359F9BCC8F3
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 908d9bd4705578992c0f080c5bfd24e691388b935183c46b81e922d27350583b
#. default-sha256: b3256d096fa683a456da76cce160a5fede786efa06301c904f857147561c8b3c
msgctxt "scenario8:scenario8_6859F8BA_2B60_443D_A146_6359F9BCC8F3"
msgid "⟪k:0⟫⟪k:1⟫That endless expanse of red earth"
msgstr "⟪k:0⟫⟪k:1⟫发红的土壤一直延续到天边——"

#: scenario8:scenario8_A4A3F35D_D62F_4F2A_B280_64EB88F05101
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: ff1c2ecc545f5fc2aedc8085d594ab2f1020346f4b21775b69087152918ab6d6
#. default-sha256: aaf193c48200841c4a91c44660727bebb4442e218076d265b5c8192a753ded35
msgctxt "scenario8:scenario8_A4A3F35D_D62F_4F2A_B280_64EB88F05101"
msgid "⟪k:0⟫⟪k:1⟫remains branded into the very fabric of my mind."
msgstr "⟪k:0⟫⟪k:1⟫那副景色深深刻在我脑海里。"

#: scenario8:scenario8_86014BCE_50E9_48BD_9AD2_C18A9B08E47F
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: b5f65ab9e8824e56770727b5e1178801633ab215e7644aea3956803cc9997ffc
#. default-sha256: 0c26404f18f59d97f0cbe7e685324645f3653a6e7ab39279a361fb72fd1f0d0f
msgctxt "scenario8:scenario8_86014BCE_50E9_48BD_9AD2_C18A9B08E47F"
msgid "⟪k:0⟫That’s where it was decided someone built like I am would be the most use, I suppose."
msgstr "⟪k:0⟫可能是因为我身体结实……⟪k:1⟫使唤起来更顺手。"

#: scenario8:scenario8_EFE14CCC_A8CF_4BAA_BE17_57EA45F3D07C
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 0600502338988b2d31ff6530e0b2bcdabf2ff431303f504c108fcafd6c3446a6
#. default-sha256: 88f0bd40d2527b89ac80a842439e3213f311b99c74db6eb1a9e10295f652e417
msgctxt "scenario8:scenario8_EFE14CCC_A8CF_4BAA_BE17_57EA45F3D07C"
msgid ""
"⟪k:0⟫But I could tell from their tone of voice and expressions that the things they were saying "
"were not friendly. ⟪k:1⟫They seemed to be mocking me, laughing at me."
msgstr ""
"⟪k:0⟫可是，⟪k:1⟫光看表情和语调我就能明白，⟪k:2⟫那些家伙绝不友好。⟪k:3⟫语气里混杂着侮蔑和嘲笑……"

#: scenario8:scenario8_CDC5F7AC_8330_457D_B164_F088B8DEC181
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: d55b493d5fefaded8f5972c8e91737e7b5f83dd4baef088a6dc4a10d6fa997f4
#. default-sha256: b60c1671ce10bf03819b8166c9b87c6808a213a989d4dfa60c20461a982fabbd
msgctxt "scenario8:scenario8_CDC5F7AC_8330_457D_B164_F088B8DEC181"
msgid ""
"⟪k:0⟫As you might expect, I attempted to protest,⟪k:1⟫but evidently, I had been beaten quite "
"badly while I was unconscious."
msgstr ""
"⟪k:0⟫当然……我试着去抵抗，⟪k:1⟫可是我已经被他们狠狠地打过了，⟪k:2⟫全身各处都剧痛不止，⟪k:3⟫无法自如"
"地活动——"

#: scenario8:scenario8_189711F9_D6CC_485D_95C3_728672FF3E07
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: ffb225a59905eccc42ec04ef2c576ca093ee63e470b8eac716f0a08571c87f91
#. default-sha256: 1e3e556ecb822356d4b9a84a61bb38bbaa70ac95e719f24259212c64999f5aa4
msgctxt "scenario8:scenario8_189711F9_D6CC_485D_95C3_728672FF3E07"
msgid ""
"⟪k:0⟫My joints were stiff and swollen, on top of my dehydration,⟪k:1⟫so I could barely move, let "
"alone put up a fight."
msgstr "⟪k:0⟫应该也没怎么喝过水吧，⟪k:1⟫喉咙十分干渴……身体使不上力。"

#: scenario8:scenario8_64D83DD8_B6FF_487B_AA17_AC0B63B424CF
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 67ba2bc8018c89eedd6de23bc9c88ad1460670d6b4c6c09c490083d7bcb8d184
#. default-sha256: b76e2477f26a86545692cb420010df785f9a5e8b5986fa016cf72499a2295c23
msgctxt "scenario8:scenario8_64D83DD8_B6FF_487B_AA17_AC0B63B424CF"
msgid ""
"⟪k:0⟫As strong as I might have been at full health, I was in no condition to do anything then."
msgstr "⟪k:0⟫不管我力气多大，⟪k:1⟫在那种状况下什么都做不到。"

#: scenario8:scenario8_475C661B_0BE8_4B09_A455_E9CE8A5CCB88
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: f9b60adfa9ebf6e8b309ecc8fff5f4e816e0a954ef6923cdf38746af7172a5e8
#. default-sha256: 7ea46f9a1ded9236fb09ae48c34a1bfdcd730d5c1175ea36e0bda0ee7b036924
msgctxt "scenario8:scenario8_475C661B_0BE8_4B09_A455_E9CE8A5CCB88"
msgid ""
"⟪k:0⟫They had many words to describe me, none of them flattering.⟪k:1⟫⟪k:2⟫Some of them would "
"even call me “beast.”"
msgstr "⟪k:0⟫那些家伙用各种字眼来辱骂我。⟪k:1⟫对了，⟪k:2⟫我还曾被称作野兽……"

#: scenario8:scenario8_5244F813_E939_4660_BDB7_59797A6E7A7D
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: bd71e8b5aef31014383ed17b3be1821af480b24f0d5581f8d2c2c35cb49c55e8
#. default-sha256: 7f328d5142e4866ee5d9938dfbdff005a7edcbe36ef586fb38e156be654aa3b2
msgctxt "scenario8:scenario8_5244F813_E939_4660_BDB7_59797A6E7A7D"
msgid ""
"⟪k:0⟫The slave trader’s guards were armed, of course.⟪k:1⟫⟪k:2⟫Swords hanging from their hips, "
"ready to cut down anyone who showed any sign of resistance."
msgstr ""
"⟪k:0⟫奴隶商人的护卫监视着马车，⟪k:1⟫当然佩戴着剑——⟪k:2⟫⟪k:3⟫看也明白，若是抵抗的话就会被他杀掉。"

#: scenario8:scenario8_95934EAA_5C56_448B_B646_04C8D400B5E6
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 537c6fa3f84914c412f37e62d66e4a486b1c4b79762bc232b6bd4b3c7378fde1
#. default-sha256: e070f2355453bab2d6eb01e3aaa4521add7ef8b1ee7a93b2a42f5084892f4b13
msgctxt "scenario8:scenario8_95934EAA_5C56_448B_B646_04C8D400B5E6"
msgid "⟪k:0⟫So they sat there, lamenting their fate."
msgstr "⟪k:0⟫所以……⟪k:1⟫大家都在叹息忧虑自己的未来。"

#: scenario8:scenario8_54ADD76B_A412_4AFA_BA50_2C9D1C49BD83
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: c5932c97532b560ef94158e44edf2a5bbae8fd803cf84f13d680e66a7558a04e
#. default-sha256: f37fe0092e2db6eda36add59ade06169ab549724525d12a71edd7afd8e7c9206
msgctxt "scenario8:scenario8_54ADD76B_A412_4AFA_BA50_2C9D1C49BD83"
msgid ""
"⟪k:0⟫Glancing over at her, I caught a glimpse of her face—⟪k:1⟫⟪k:2⟫⟪k:3⟫large chunks of skin "
"seemed to have fallen off it."
msgstr "⟪k:0⟫我从一旁打量她的脸，⟪k:1⟫看到了奇妙的景象。⟪k:2⟫⟪k:3⟫那……应该说是皮肤溃烂吗……"

#: scenario8:scenario8_3C09BB0D_D06D_4694_AFEE_33B7DB1722FE
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: fb7da0801f47082d51355d25406a5d5efaae74fdf993ae2e8d2eb342504fc906
#. default-sha256: f4203bfe88c89a1de65a3f0e6577c7377f4ba02730f800d2a07459ab9b904778
msgctxt "scenario8:scenario8_3C09BB0D_D06D_4694_AFEE_33B7DB1722FE"
msgid "⟪k:0⟫It was, suffice it to say, an unusual sight."
msgstr "⟪k:0⟫她的脸非常丑陋。"

#: scenario8:scenario8_EA4C890F_1548_4752_A156_2A7C16C62C10
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: e6e6b51874303cb3631876acc1bc41c3bb42cce426a81fa57dfc7873bf98ee32
#. default-sha256: 1eb6ae893102d90c70ef1e3b2508c2b1128754855234a1be32ee8adaa2c35a1b
msgctxt "scenario8:scenario8_EA4C890F_1548_4752_A156_2A7C16C62C10"
msgid ""
"⟪k:0⟫I’m not sure how to describe it... ⟪k:1⟫but it seemed different somehow from everyone else "
"crying in the carriage. It was almost like..."
msgstr "⟪k:0⟫该怎么说呢……看起来和其他人不一样。⟪k:1⟫⟪k:2⟫哭泣的人多得是，⟪k:3⟫而她却……⟪k:4⟫没错——"

#: scenario8:scenario8_F2B7BADB_C3EA_40B1_AEE7_6D49DE1D5C3D
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 9bbdb6c347ce4cc4aff78245d4950ee3cb0290e81c373a58de72fafd0c0a1fd8
#. default-sha256: 45fb8f26a65797e2b3057eedfcd008f0bf07b03c1cfdc003c709ff895d4c30c3
msgctxt "scenario8:scenario8_F2B7BADB_C3EA_40B1_AEE7_6D49DE1D5C3D"
msgid "⟪k:0⟫her tears were not for herself."
msgstr "⟪k:0⟫她并不是在哀叹自己。"

#: scenario8:scenario8_4121FD91_F6D5_45F3_9CE9_623725AE1CC9
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: c580e1139a264683255b8fae95c923035298dbd953def1a656ce8799ef659f31
#. default-sha256: 0c7d25ec62994eac74f1bcfd03f78f5a5e4f9df6753ef24712059980acf0c7b8
msgctxt "scenario8:scenario8_4121FD91_F6D5_45F3_9CE9_623725AE1CC9"
msgid "⟪k:0⟫Why are you crying?"
msgstr "⟪k:0⟫……你，为何而哭……？"

#: scenario8:scenario8_D6308C27_83A4_4537_B693_124430D2D1DC
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 3e790ec04b539eff383b5110593be9fe52b0244f1633a9b99bc32ed3930fde6c
#. default-sha256: 25515174aece14e8d39abbe2ec1cb79f5c6309e4d24b5a55fc8d69d3ed214532
msgctxt "scenario8:scenario8_D6308C27_83A4_4537_B693_124430D2D1DC"
msgid "⟪k:0⟫After a moment’s hesitation, she said,"
msgstr "⟪k:0⟫她犹豫了片刻——⟪k:1⟫这样说道。"

#: scenario8:scenario8_8D93A337_D2B1_4263_88A0_79A5D2C433CA
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 4135873467ed88cef8a3955e80f6abf94410adc9eb8c41f462105d0ec316ed43
#. default-sha256: e7c571ca787153e3101743ebde1fa352656c680bd0e42479f3fdea92f81d71d2
msgctxt "scenario8:scenario8_8D93A337_D2B1_4263_88A0_79A5D2C433CA"
msgid "⟪k:0⟫For a moment, I was filled with a sense of tranquility,"
msgstr "⟪k:0⟫平静的风……⟪k:1⟫稍稍吹入了我的心中。"

#: scenario8:scenario8_DD5FAAB1_FB91_428F_A8DF_2C1B7B49DC0C
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: da394ef375f1a0c7b68ea3ff7650192764ff59b622ee51d4ccae650fd6cea811
#. default-sha256: da0457816d98cfdda0998bf14f38aba3efac209e8f294e3bab71e8cf79fb8568
msgctxt "scenario8:scenario8_DD5FAAB1_FB91_428F_A8DF_2C1B7B49DC0C"
msgid "⟪k:0⟫and though you may not believe it,"
msgstr "⟪k:0⟫那时，⟪k:1⟫我……⟪k:2⟫或许你不会相信……"

#: scenario8:scenario8_6C1999A0_BBCE_491A_9F11_3AA8BB65B59D
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: cf8ed4648ed3afdb45d2b1c13108eae2da5d812713868b61182c40636bdf455a
#. default-sha256: 0c3715fc13252b9b465ecd37d4567216edc709efaafc362160ca03daf270ea39
msgctxt "scenario8:scenario8_6C1999A0_BBCE_491A_9F11_3AA8BB65B59D"
msgid "⟪k:0⟫This is no lie, I promise."
msgstr "⟪k:0⟫此言……⟪k:1⟫绝非虚假……"

#: scenario8:scenario8_D377934A_089F_403D_A7CE_0876CD37C5EE
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 2e8c0f7410f16003d0903d8e84e331d32fb41ddb4c67f0521825054991950a40
#. default-sha256: d02989f0a4281aaba62e649af9c739240e481475646ac17d289b90b0d401df39
msgctxt "scenario8:scenario8_D377934A_089F_403D_A7CE_0876CD37C5EE"
msgid "⟪k:0⟫............"
msgstr "⟪k:0⟫…………"

#: scenario8:scenario8_C75B6762_6766_41AE_BA3B_52BF6A5BD0F5
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: d26e13f44dc44eccccd87f00bc7df5a48fffa914a7b0d7ed2a8671e45d940bde
#. default-sha256: b43090f21f92dc0253aca1b318e501730413113d294058e0763b6b7cfccd1dc6
msgctxt "scenario8:scenario8_C75B6762_6766_41AE_BA3B_52BF6A5BD0F5"
msgid "⟪k:0⟫I’m begging you!"
msgstr "⟪k:0⟫……拜托了！！"

#: scenario8:scenario8_1774CFC9_2512_4570_AE5C_B1ACDF30C87C
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: feb4a54a0a5e4c80beff167d62af16572f55c8c9a58ed825f171b0277282598e
#. default-sha256: 519f8e34e05c014490619b224c76d68c522f0a5dcbef23aaa859e7f54bc2c2e7
msgctxt "scenario8:scenario8_1774CFC9_2512_4570_AE5C_B1ACDF30C87C"
msgid ""
"⟪k:0⟫They let their guard down because we were restrained.⟪k:1⟫⟪k:2⟫The thought of anyone "
"resisting never once crossed their minds."
msgstr "⟪k:0⟫或许……是奴隶身上的枷锁让那些家伙大意了。⟪k:1⟫⟪k:2⟫他们根本没想象到——会有人敢反抗。"

#: scenario8:scenario8_A91022C2_DDC8_404F_9E06_8CCEBACC812E
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 4c17aec919ccdac3cd0fc319847d342d4a2173a82364965adb8768a7f9b7fb53
#. default-sha256: 3a8b36391cb6975edbc2ea0e4b59d55de4b3c96f7fb5242107f159c924cdc069
msgctxt "scenario8:scenario8_A91022C2_DDC8_404F_9E06_8CCEBACC812E"
msgid "⟪k:0⟫Haha... ⟪k:1⟫hahahaha... ⟪k:2⟫heehee!"
msgstr "⟪k:0⟫哈哈……⟪k:1⟫……哈哈哈哈……⟪k:2⟫……嘻嘻……！"

#: scenario8:scenario8_63E11C4C_470B_45C4_BDF5_9D1910BA3315
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 91379276a72800cfa1d21c6632329c69530fe075a6590dc1760fbf5f566e9de9
#. default-sha256: 7ad210047e2de16a0fafb4d77a77c45cdb783cae15fa6ad8de9a31514ef66490
msgctxt "scenario8:scenario8_63E11C4C_470B_45C4_BDF5_9D1910BA3315"
msgid "⟪k:0⟫More... ⟪k:1⟫I need more...⟪k:2⟫⟪k:3⟫I need moooooooooooore!"
msgstr "⟪k:0⟫不够……⟪k:1⟫还不够……⟪k:2⟫还不够——！"

#: scenario8:scenario8_38158AE4_64C6_491B_98D3_B0BE5DA55015
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 824c8c17960fb879c55717ea1d45e47875d200a77cc9635940d3e15ba482212c
#. default-sha256: 949b9c47a5f751b243ec56364ac290080f3571d630b0f284a0ce565d0ea790f8
msgctxt "scenario8:scenario8_38158AE4_64C6_491B_98D3_B0BE5DA55015"
msgid "⟪k:0⟫But she said nothing, simply removing my shackles as commanded."
msgstr "⟪k:0⟫她一声不吭地为我解开了枷锁。"

#: scenario8:scenario8_707AA80E_C68A_4C08_8E5F_B7EA77E984E7
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: fd5c8b24977297394306a2f28e42f3ae4607b05bed1460ea57f8d1c202fe90f7
#. default-sha256: be573f6f89503499468259a9d577ada28796aa0d52fff3bad68c9e80e8fb92fd
msgctxt "scenario8:scenario8_707AA80E_C68A_4C08_8E5F_B7EA77E984E7"
msgid "⟪k:0⟫⟪k:1⟫We can have our lives back!"
msgstr "⟪k:0⟫……就能重新回到平和的生活……！"

#: scenario8:scenario8_D2F5D64A_E594_4284_9082_612E7FE2398A
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: f1be7a3cec60ceb37200c6d778a8500418247c964d8a3a99d2098ea5a968dcdb
#. default-sha256: 99dbf6340752bc5b36ce4600f20c8e1eccca6deea0625f1041fb52456851e603
msgctxt "scenario8:scenario8_D2F5D64A_E594_4284_9082_612E7FE2398A"
msgid "⟪k:0⟫Undo our shackles, please!"
msgstr "⟪k:0⟫请你解开我们的枷锁！"

#: scenario8:scenario8_64824487_E115_4F4F_BFD9_18DCE692F95E
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: c9781ab1a4038070ffa629598c7d6c480d702ebf71e657ca72bcd41d356447a0
#. default-sha256: a9100dfd10649f43d039c4ae6c50811e60cc33202b0e0d680783d68c3078e068
msgctxt "scenario8:scenario8_64824487_E115_4F4F_BFD9_18DCE692F95E"
msgid "⟪k:0⟫...What?"
msgstr "⟪k:0⟫……哎？"

#: scenario8:scenario8_E0FF7BD7_1173_4629_BCC6_D320C1A7BDDB
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: ee69f5c75104218adeb2899310874f64175501f2dbebac033590e8a7177c455b
#. default-sha256: 8ff8676f45c5aa682d6f6f48dc480e38e430a8fdec28856f866a4e87b1e9b700
msgctxt "scenario8:scenario8_E0FF7BD7_1173_4629_BCC6_D320C1A7BDDB"
msgid "⟪k:0⟫More... ⟪k:1⟫I need... ⟪k:2⟫I need more..."
msgstr "⟪k:0⟫不够……⟪k:1⟫完全……不够……"

