msgid "⟪k:0⟫Come on..."
msgstr "⟪k:0⟫……喂……"

#: scenario8:scenario8_676F36FE_D222_4CE8_AD37_C5209D73A750
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 69022268e80daf95eb17ca5a2dbe4d24a4cd9e41638704de76e8f890ed2942c4
