#: scenario8:scenario8_3B4BE779_C9C7_482C_A89E_5FF6CDF9661D
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 40b0036b85c0c7bee1707ec29d46d3dd5f8bc176d38c7196ffa393ffd2a27d61
#. default-sha256: 6309d9321079a03460689e452d3d22c5ef97d3d44e77f757f538ae5daf3d0fab
msgctxt "scenario8:scenario8_3B4BE779_C9C7_482C_A89E_5FF6CDF9661D"
msgid "⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫Do you guys hear... ⟪k:4⟫talking... ⟪k:5⟫behind the door?"
msgstr "⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫喂……⟪k:4⟫门里面……⟪k:5⟫是不是有说话的声音？"

#: scenario8:scenario8_52A585C6_D183_4D44_9B87_E24EC8892F9F
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 793358377289463efa393b1473b5d40ef2413d611fca1dfef4fa835fbe56827b
#. default-sha256: ddeb57d495ac1e0d07dc5ab23948860d9467c13866086db0832f1fb2869d1c5d
msgctxt "scenario8:scenario8_52A585C6_D183_4D44_9B87_E24EC8892F9F"
msgid "⟪k:0⟫⟪k:1⟫⟪k:2⟫...Is there someone else in there with her?"
msgstr "⟪k:0⟫⟪k:1⟫⟪k:2⟫……还有其他人……？"

#: scenario8:scenario8_8FE029FB_D592_49EB_9D67_18DFF2710A8C
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: f0d23d2a63597e377ea8d33f5f9c6415d2042cc16f742f220e2849972861f3c0
#. default-sha256: a424a39ce8fdedafdb134cbd16c018dc22995326b14d0d8f127cfa2af748e780
msgctxt "scenario8:scenario8_8FE029FB_D592_49EB_9D67_18DFF2710A8C"
msgid "⟪k:0⟫⟪k:1⟫⟪k:2⟫There couldn’t be. It’s only Morgana."
msgstr "⟪k:0⟫⟪k:1⟫⟪k:2⟫……不可能，⟪k:3⟫在里面的人只有莫尔加娜……"

#: scenario8:scenario8_90CC1DC7_EBA9_415C_975A_E1CCEC9571C7
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 0e36f3e93ce1a56021d45eabb2a7b7ad8168ef73a9124a673f28364e8c5badd4
#. default-sha256: 5016f3ed954c052db28fdc364c0e6db5b7cfb8845a5aa0d1c9f117ce97422055
msgctxt "scenario8:scenario8_90CC1DC7_EBA9_415C_975A_E1CCEC9571C7"
