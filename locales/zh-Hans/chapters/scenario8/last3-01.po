msgid "⟪k:0⟫Oh, please... ⟪k:1⟫please don’t put up a fight..."
msgstr "⟪k:0⟫别乱动哦……⟪k:1⟫拜托你了……"

#: scenario8:scenario8_E0FF32B2_BEF8_47AC_BADC_C9A0BA265F09
