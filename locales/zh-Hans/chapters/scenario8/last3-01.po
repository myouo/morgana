msgid "⟪k:0⟫⟪k:1⟫⟪k:2⟫Nellie..."
msgstr "⟪k:0⟫⟪k:1⟫⟪k:2⟫奈莉……"

#: scenario8:scenario8_4628AC94_86B1_412F_AF1B_3E7270C71B3D
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: fe1275931972b0709c9412ffc5685a7f5692b124b398085b1e15d099ccf55ae1
