msgctxt "scenario8:scenario8_30426D9F_11EC_4A91_8E52_B06B67C70361"
msgid "⟪k:0⟫⟪k:1⟫Eeeeeew! No way! Absolutely not! Not in a million years!"
msgstr "⟪k:0⟫⟪k:1⟫不要！⟪k:2⟫不行！⟪k:3⟫绝对不行！⟪k:4⟫⟪k:5⟫这种事情，⟪k:6⟫奈莉绝对做不来啊！！"

#: scenario8:scenario8_CBA189C6_D4F7_4EBA_A64C_A8A869AB74C1
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 929563383f7a3bf744b1bc7147cfabf01980b80e87cfa47939ecd835c9608b38
