msgid "⟪k:0⟫One... ⟪k:1⟫two... ⟪k:2⟫three!"
msgstr "⟪k:0⟫………一、二！"

#: scenario8:scenario8_8679902E_3CEE_4D0F_88B8_EFC38308A715
