msgid "⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫............"
msgstr "⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫…………"

#: scenario8:scenario8_E681D104_B68C_446D_B5FE_E46E6C1477B6
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 1be16223c765a6d85b1c46f2283f6c80c4d030ba707ab415b79d271aa5d41852
#. default-sha256: de41329de88dc8b6a811fcbf6abe23f898ef56aded35a76301429a847d4cb74c
msgctxt "scenario8:scenario8_E681D104_B68C_446D_B5FE_E46E6C1477B6"
msgid ""
"⟪k:0⟫⟪k:1⟫But it’s all... ⟪k:2⟫covered in feathers and flapping about...⟪k:3⟫⟪k:4⟫How are we "
"supposed to cook it?"
msgstr "⟪k:0⟫⟪k:1⟫但是……⟪k:2⟫它的羽毛这么松软，⟪k:3⟫还很有精神地动着呢……⟪k:4⟫要怎么把它做成菜啊。"

#: scenario8:scenario8_30426D9F_11EC_4A91_8E52_B06B67C70361
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: e4100ed839991ac8482137152d2c7dafb60e347bcf54bd05430c3bdb9fec456f
