#: scenario8:scenario8_D1B494DA_31AD_409F_91EE_C3F61A2683A9
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 0416b87489f2433bf0a231fa86abccfceb1f8046ebe34b3e655de77f46efbe5c
#. default-sha256: 106a17017014a75b4be1b0d72254e55a1b3f4240d241d0141f56c7bf4e353b30
msgctxt "scenario8:scenario8_D1B494DA_31AD_409F_91EE_C3F61A2683A9"
msgid ""
"⟪k:0⟫⟪k:1⟫On days when it was nice out,⟪k:2⟫⟪k:3⟫I would take walks around the house’s grounds,"
msgstr "⟪k:0⟫⟪k:1⟫晴朗的时候便在老家的庭院中散步——"

#: scenario8:scenario8_A9BABB81_749F_4964_9AD1_E69F58DEE34D
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 38bf197d061e0e90b8ceac82f3e2297dfec9fc6288a6a00806e8a1d6bc3a432a
#. default-sha256: 2642d6a28f2efc15bba6b50e2ddcadb0011f6c24c291f3059be63c05c8fbeba8
msgctxt "scenario8:scenario8_A9BABB81_749F_4964_9AD1_E69F58DEE34D"
msgid "⟪k:0⟫⟪k:1⟫sometimes napping beneath a tree."
msgstr "⟪k:0⟫⟪k:1⟫然后躺在树荫下午睡……"

#: scenario8:scenario8_4BED022D_815C_4FFF_B1B1_70419C5FC109
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 45e9585b89587a7a1654e99d9c828a97cca5fff92f47c990c1f57b2f694d1f3a
#. default-sha256: 464cb6c9faecae27204c6385873570d5b93c4dfa84842b090e201223d4a257ed
msgctxt "scenario8:scenario8_4BED022D_815C_4FFF_B1B1_70419C5FC109"
msgid "⟪k:0⟫⟪k:1⟫whereas mine is flat and dull."
msgstr "⟪k:0⟫⟪k:1⟫和我的完全不同。"

#: scenario8:scenario8_E3166BAA_BA5A_4E7B_9D32_689B25DD9633
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 0b59295b0af14bf4c480272f5f0fb013df3af30be18716118fa7a6e2e4fc95fb
#. default-sha256: 29382601c5a0436d6ab0def448961e5aae273828bb6d61f20f9529a06d4ab1e0
msgctxt "scenario8:scenario8_E3166BAA_BA5A_4E7B_9D32_689B25DD9633"
msgid "⟪k:0⟫⟪k:1⟫You shone like a tiny little dancing sun."
msgstr "⟪k:0⟫⟪k:1⟫如同太阳一样。"

#: scenario8:scenario8_0114CDC6_DD89_463C_AF9E_DD612D17C3A0
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: b538cb690c0b7611d05744c22964d39fe2e859fa62451f9befb759c75e73fcf0
#. default-sha256: 28264c989216efc986e90db2d428d6ce3b45a2ecbe348d1577bba1791537b764
msgctxt "scenario8:scenario8_0114CDC6_DD89_463C_AF9E_DD612D17C3A0"
msgid "⟪k:0⟫⟪k:1⟫At the time, I assumed that was how life would always be."
msgstr "⟪k:0⟫⟪k:1⟫这样安稳的日子……"

#: scenario8:scenario8_026D5E20_738D_4C2B_A483_A709FFB94996
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 71fd55572c9626fe83b7385733da8b711711da77b53352c1c4651178909abc2e
#. default-sha256: 9309672a65bf7d45c5cef94062b6efcec01e69be736f3bf70099f7fa6b4bda85
msgctxt "scenario8:scenario8_026D5E20_738D_4C2B_A483_A709FFB94996"
msgid ""
"⟪k:0⟫Part of me wanted to know why nobody bothered talking to me,⟪k:1⟫and part of me was "
"relieved. ⟪k:2⟫Somewhere inside, I knew I didn’t have what it took."
msgstr "⟪k:0⟫但是，⟪k:1⟫内心的某处却像是放下了块巨石般。⟪k:2⟫我是明白的。⟪k:3⟫我并没有拨烦之才。"

#: scenario8:scenario8_0C1CDE28_7606_473D_B23B_F7FB5A3A1B49
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: ef8f1f3c51da8a87c80732086af404ffd6634bce468795157eba1ab72e2d0412
#. default-sha256: 4863edc9da1c7c735b9f5f7dcf0d42ca14171f7d13e0a12e1cf243f1cebc8a1f
msgctxt "scenario8:scenario8_0C1CDE28_7606_473D_B23B_F7FB5A3A1B49"
msgid "⟪k:0⟫and in response, he formally disowned me."
msgstr "⟪k:0⟫于是，⟪k:1⟫叔父他——和我断绝了关系。"

#: scenario8:scenario8_70CAA6B3_33FB_4FAC_ACFC_5AAD1525E679
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: d1a4e4baea9b9035851b07a22eccd895ba4d2cf34ebac8927114f36d6b3ea431
#. default-sha256: 8bae7f2c733b9a78a358aca4d23bffbf55ebce1bce72b8be18c7e64b8a114a02
msgctxt "scenario8:scenario8_70CAA6B3_33FB_4FAC_ACFC_5AAD1525E679"
msgid ""
"⟪k:0⟫You’re not the only one who still had some growing up to do, Nellie...⟪k:1⟫⟪k:2⟫I wasn’t "
"quite the adult I’d thought I was either."
msgstr "⟪k:0⟫还没成为大人的……⟪k:1⟫⟪k:2⟫不止奈莉一人……⟪k:3⟫我也是一样的。"

#: scenario8:scenario8_FA7D6747_967F_4BD1_8158_BB4648567C75
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: b4610cf238d61f1dbf8beb9080b819931e4b000e630e60d2f84ceb725ed7c733
#. default-sha256: 103211c80ee9bb31437f83686ad5e6fcc387b4b6653481b035b70736b6121eae
msgctxt "scenario8:scenario8_FA7D6747_967F_4BD1_8158_BB4648567C75"
msgid ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫Fortunately—⟪k:3⟫⟪k:4⟫if you want to call it fortune—⟪k:5⟫⟪k:6⟫I was given enough "
"money to live on for a decent length of time, as well as a place to stay."
msgstr ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫该说是不幸中的万幸么，⟪k:3⟫虽然被赶出家门，⟪k:4⟫叔父姑且给我留了能够暂时生活下去的"
"钱。"

#: scenario8:scenario8_2ACB9DF5_AC71_4539_99AC_FB660B3619B3
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 1caeb98252c207f7d5980ca6ad8a7d01989da615adf21d26c59cfc44daa78b78
#. default-sha256: 5df96ca9af8602ba2105b86cbcc9d5c8588a7c855e4ab26a580cc98de4d8fbaa
msgctxt "scenario8:scenario8_2ACB9DF5_AC71_4539_99AC_FB660B3619B3"
msgid ""
"⟪k:0⟫从那以后，⟪k:1⟫我失去了住所……⟪k:2⟫⟪k:3⟫叔父在离老家很远的地方，⟪k:4⟫给我准备了一座房子。"
msgstr ""
"⟪k:0⟫从那以后，⟪k:1⟫我失去了住所……⟪k:2⟫⟪k:3⟫叔父在离老家很远的地方，⟪k:4⟫给我准备了一座房子。"

#: scenario8:scenario8_82CD33D1_0CF8_440F_B31F_CA3D47AD9315
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: f3288d6e15a8ad8664db97a97b453dc42b1590031bf06c717affbf84881d35d3
#. default-sha256: 46dbb81b003d6309e54cc976ebda984b51e5ae57603bac8d77b320e994ceb35c
msgctxt "scenario8:scenario8_82CD33D1_0CF8_440F_B31F_CA3D47AD9315"
msgid "⟪k:0⟫⟪k:1⟫⟪k:2⟫...Oh?"
msgstr "⟪k:0⟫⟪k:1⟫⟪k:2⟫哎………？"

#: scenario8:scenario8_F0F66272_1A70_4843_A7E7_E74FE97787A7
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: cba942434501fe0e0205e90ffea02848a7fc3b8500ed216e35cc09ad5f81c876
#. default-sha256: c6c76334e0a9571775b84f30f733fef71046d269370a9db07e8521f4765ff72d
msgctxt "scenario8:scenario8_F0F66272_1A70_4843_A7E7_E74FE97787A7"
msgid ""
"⟪k:0⟫⟪k:1⟫I don’t need composers to come and write me songs for my birthday. ⟪k:2⟫As long as I "
"have the one thing that matters most to me, I can do without anything else."
msgstr ""
"⟪k:0⟫⟪k:1⟫生日的时候，⟪k:2⟫也不需要音乐家给我谱曲当做生日礼物——只要最重要的东西在身边，⟪k:3⟫就可以"
"了。"

#: scenario8:scenario8_4CAD8A9E_DEF1_4D17_9955_4D40055BA4EB
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 0e37b06297c0e9de9719db25704fefbd0ba18fc6271c5d38705270198dff3b41
#. default-sha256: 790241eda1ff9e2d30c9a0cf99b4299c93031ddbf19cd2972566680f55f20bec
msgctxt "scenario8:scenario8_4CAD8A9E_DEF1_4D17_9955_4D40055BA4EB"
msgid ""
"⟪k:0⟫We may not have a huge yard, but the sun shines everywhere.⟪k:1⟫⟪k:2⟫Flowers can grow even "
"without a gardener tending to them."
msgstr ""
"⟪k:0⟫就算没有庭院，⟪k:1⟫太阳不是也一直闪耀着吗。⟪k:2⟫⟪k:3⟫没有园丁的打理，⟪k:4⟫花也会盛开啊。"

#: scenario8:scenario8_0781453F_274D_4AFD_AE30_1C99F1552F2F
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 11a97208e5d18d94e98290174f145edf3fc69e320416436fe8a06a0349cc96b1
#. default-sha256: 3beab16c2153803e30ba7350cd09f4a117bb9b94fcee27ad79169ad9310c5e27
msgctxt "scenario8:scenario8_0781453F_274D_4AFD_AE30_1C99F1552F2F"
msgid "⟪k:0⟫What else sounds good? ⟪k:1⟫Hmm... ⟪k:2⟫I’m craving cookies!"
msgstr "⟪k:0⟫还要别的什么吗？⟪k:1⟫奈莉还想做甜甜的曲奇呢！"

#: scenario8:scenario8_16735FB1_6A43_4AAC_A996_D588EFCC1B56
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 5afcc404676ae017d6b8b83b961fc8d9c89cdd4269dacb98e0eb4a3b0d8c51e7
#. default-sha256: f515811b00ed5f50d78c2207217e6ead08532f648c8f806c9331646edd7845bf
msgctxt "scenario8:scenario8_16735FB1_6A43_4AAC_A996_D588EFCC1B56"
msgid "⟪k:0⟫⟪k:1⟫That’s the first smile I’ve seen since we got here."
msgstr "⟪k:0⟫⟪k:1⟫哥哥大人，⟪k:2⟫终于笑了呢。"

#: scenario8:scenario8_7A6088F2_2857_4496_9125_BCEA0EA68271
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: c0a629a3a572a40890c551cac37afaf84f38ade785e303da409770b291f6c5e4
#. default-sha256: ad4437c6912739132f4cdee974699dc8da7d21687f2d1ef08dce8b1a777f1fcd
msgctxt "scenario8:scenario8_7A6088F2_2857_4496_9125_BCEA0EA68271"
msgid ""
"⟪k:0⟫⟪k:1⟫Who cares that we’re not rich anymore?⟪k:2⟫⟪k:3⟫We’ll figure things out in no time."
msgstr "⟪k:0⟫⟪k:1⟫成为平民算不了什么啊。⟪k:2⟫⟪k:3⟫奈莉和哥哥大人的话，⟪k:4⟫马上就能学会很多事情——"

#: scenario8:scenario8_65533E70_3D7C_4305_92E2_C898165BAD9F
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 10c295e0aa488f89541a0b5e9e7fd879d52a99512adbd971972ebe7d3b311124
#. default-sha256: 25fe39fc7e287e2032375f5c30fedcb4cdc190139f683aa312a13e88f6ce07ae
msgctxt "scenario8:scenario8_65533E70_3D7C_4305_92E2_C898165BAD9F"
msgid "⟪k:0⟫And then we’ll have even more fun than we did back there!"
msgstr "⟪k:0⟫一定能过上比之前还要开心的生活！"

#: scenario8:scenario8_89CC1705_38AE_40B2_BCEF_1A28D235D33D
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 611f5626b0dbb4bd973958374ca68343a5b58ee81e2e812ae6a3cb758a9172d0
#. default-sha256: 99d29594194753aec45e6db44950c517bd664282eb4248298c005ca5639225d3
msgctxt "scenario8:scenario8_89CC1705_38AE_40B2_BCEF_1A28D235D33D"
msgid ""
"⟪k:0⟫⟪k:1⟫You’ve got yourself an adorable little princess!⟪k:2⟫⟪k:3⟫What more could you possibly "
"need?"
msgstr "⟪k:0⟫⟪k:1⟫奈莉会一直，⟪k:2⟫当哥哥大人可爱的公主殿下的！⟪k:3⟫⟪k:4⟫这不就够了吗？"

#: scenario8:scenario8_8871344A_3F24_4690_8C8C_8A34F4D9E84D
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: a09f8431e621ef19cfdded1e9b911a7e73506d6c9fb54456e4238b3e9f318f23
#. default-sha256: 556fa1d300a7cee880e0ab375cb023cf5af74db0746759b290fc0eb5bc38ab02
msgctxt "scenario8:scenario8_8871344A_3F24_4690_8C8C_8A34F4D9E84D"
msgid "⟪k:0⟫⟪k:1⟫Cheer up!"
msgstr "⟪k:0⟫⟪k:1⟫呐，⟪k:2⟫哥哥大人，⟪k:3⟫打起精神来吧？"

#: scenario8:scenario8_3E139956_A055_4D47_B55D_3FAAA6856A23
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: f6a6385952ee6bde3674fe204ec70b06ee05e6d70015ba1140fc8f1111fa7c95
#. default-sha256: de517832dc780818fc472d510fd65ae1594a519e48863c08d5e45b85e2523f19
msgctxt "scenario8:scenario8_3E139956_A055_4D47_B55D_3FAAA6856A23"
msgid ""
"⟪k:0⟫⟪k:1⟫Ohoho. Did you think for a second I wouldn’t?⟪k:2⟫⟪k:3⟫I’m your princess, dearest Mell!"
msgstr ""
"⟪k:0⟫⟪k:1⟫……呵呵，⟪k:2⟫奈莉在哥哥大人身边不是理所当然的事吗？⟪k:3⟫⟪k:4⟫因为奈莉，⟪k:5⟫是哥哥大人的"
"公主殿下嘛！"

#: scenario8:scenario8_3ED2A53C_3AFD_4A2F_89B6_974A96B940D5
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 3e8af8b8748ecc1d5842daed85826b84f0c870675afa4fa7e5e2f16ca3b05a6e
#. default-sha256: 9b0e41507a14c4e929f114b62b299ce17f4f3e48cfe1183d23dbcfcb826b4d5a
msgctxt "scenario8:scenario8_3ED2A53C_3AFD_4A2F_89B6_974A96B940D5"
msgid "⟪k:0⟫⟪k:1⟫And princesses belong with their princes."
msgstr "⟪k:0⟫⟪k:1⟫公主殿下就应该一直在王子殿下的身边啊。"

#: scenario8:scenario8_76276090_6E2F_4AF5_81BB_20FBB6F318B9
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: e51f506786d3b388ce39526cb2241b302e2380f7aca60c48cc5953fc4ac4b5f4
#. default-sha256: 0e119c64c19fc79495e30c873575b7f8747efe4f594d58d6aa92901397dc98df
msgctxt "scenario8:scenario8_76276090_6E2F_4AF5_81BB_20FBB6F318B9"
msgid "⟪k:0⟫but Nellie calling me her prince gave me the illusion of being worth something."
msgstr "⟪k:0⟫但既然奈莉这么说了，⟪k:1⟫我就误以为自己还是有价值的。"

#: scenario8:scenario8_3F2F6511_96BF_4686_99A5_2288F805FB64
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 0fcafcd5f3d030a97f3a41e54263a818f60ea4d7cd3e52c556d562a7b36abf4e
#. default-sha256: fc6a4bfa068fc636064a4ab7d2782636280b9e89f49f4c4f340862ce4ccb671c
msgctxt "scenario8:scenario8_3F2F6511_96BF_4686_99A5_2288F805FB64"
msgid ""
"⟪k:0⟫It made me feel like I could keep on being that richly blessed young man, even this far away "
"from home."
msgstr "⟪k:0⟫误以为就像以前一样，⟪k:1⟫自己还能继续将那份幸运……维持下去。"

#: scenario8:scenario8_CC8CE97C_57A4_4844_94E7_B1E25F7B1C5E
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: ab887c78d31f186572384ef1ed336fd0672d167c940bf0830f0a6faaae29690f
#. default-sha256: 627830f0efdcf09e537fe0dd708085c148aad32b5603d53d218ddc17882d7499
msgctxt "scenario8:scenario8_CC8CE97C_57A4_4844_94E7_B1E25F7B1C5E"
msgid "⟪k:0⟫but to be quite honest, I couldn’t gather the motivation to do much of anything."
msgstr "⟪k:0⟫但说老实话……⟪k:1⟫其实，⟪k:2⟫我一点干劲都没有。"

#: scenario8:scenario8_63C6DAC9_1B4B_48E4_B46D_DCEA67D4D6F3
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 472dde1c3941765a2681507f290769580da627c3ea5231e29fda61a8a589f375
#. default-sha256: 8ff6bff1187c5f6d970bb8af048ca164e7df2c76c5d80f9faad5893d6b3a18d7
msgctxt "scenario8:scenario8_63C6DAC9_1B4B_48E4_B46D_DCEA67D4D6F3"
msgid "⟪k:0⟫It had knocked me on my backside,⟪k:1⟫and I didn’t have the strength to get back up."
msgstr "⟪k:0⟫打击太大了……⟪k:1⟫无法鼓起干劲。"

#: scenario8:scenario8_ADDC0075_5107_434C_B85B_C7D0503F1A53
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 6a5c27fa05f19b05a6124e6095035318a5ba24a987dae0cea43b053e77d8589a
#. default-sha256: 836fa84548bba9569d1180b5dcd8ec4b8d36dab0df82fe61a9945582f5a91d5b
msgctxt "scenario8:scenario8_ADDC0075_5107_434C_B85B_C7D0503F1A53"
msgid "⟪k:0⟫I couldn’t tell Nellie that, of course, so this is what I said instead:"
msgstr "⟪k:0⟫但是，⟪k:1⟫这些话当然不能告诉奈莉。⟪k:2⟫所以我，⟪k:3⟫这么对她说道。"

#: scenario8:scenario8_C7BB2910_3DBF_482D_A538_4565683DF042
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 27e417b720ac517b9d73dbd07ec237798065fec53fd15e5d5689a67ad2b64978
#. default-sha256: 3758c9025c62cb8bbabd21056587443b1e045c2913de2efbba3f4dd9e1d76e64
