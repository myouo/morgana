msgctxt "scenario8:scenario8_7000DBC8_446A_4CB0_AEAB_C85BBA32B424"
msgid "⟪k:0⟫⟪k:1⟫Victims of this terrible tyrant!"
msgstr "⟪k:0⟫⟪k:1⟫苦于苛政的百姓们！"

#: scenario8:scenario8_7127F800_978D_415A_8267_11EC7B9C8592
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 2faa53c097fa6dd2b5943662f1c443101332594e214f1b51955462005dae318b
#. default-sha256: 0854f5e69724f1dc0987aa0288287a4ebf9d05f2bbe0486be7b325cd705d246f
msgctxt "scenario8:scenario8_7127F800_978D_415A_8267_11EC7B9C8592"
msgid "⟪k:0⟫⟪k:1⟫The time has come to start anew!"
msgstr "⟪k:0⟫⟪k:1⟫现在正是革命之时！"

#: scenario8:scenario8_40D851D5_8FD4_4474_8B95_059DFDDEDC73
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: aba32902f761570e70bd4ef5689cd9125a6a461badcc4c9e3542d7c124aba8db
