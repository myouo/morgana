msgctxt "scenario8:scenario8_F6ACCCD6_9C77_43C8_9909_208AA8649AA1"
msgid "⟪k:0⟫(And today, you’re the fire to my oil.)"
msgstr "⟪k:0⟫（刚刚，⟪k:1⟫她好像随意地说出了很伤人的话啊……）"

