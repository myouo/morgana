msgctxt "scenario8:scenario8_6971D90D_6A3C_4F04_901C_F6B27FFBCE89"
msgid "⟪k:0⟫⟪k:1⟫⟪k:2⟫...Ah... ⟪k:3⟫r-⟪k:4⟫right... ⟪k:5⟫it was..."
msgstr "⟪k:0⟫⟪k:1⟫⟪k:2⟫……啊……⟪k:3⟫确、⟪k:4⟫确实……是这样呢……"

#: scenario8:scenario8_AF506607_D9DD_4D8A_BA11_5EC5B392ADF7
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: cf701329d3328920b6f81f81ea4b02bd0f8a7d1e35ea6c118368a4c0af94c213
#. default-sha256: 14193a1f5db12449d018fe5ab9f7eda406e9d6eacfb07083b1330b3a96fcdc99
msgctxt "scenario8:scenario8_AF506607_D9DD_4D8A_BA11_5EC5B392ADF7"
msgid "⟪k:0⟫⟪k:1⟫⟪k:2⟫...Hmm?"
msgstr "⟪k:0⟫⟪k:1⟫⟪k:2⟫嗯………？"

#: scenario8:scenario8_F480A4C3_8233_4415_B4ED_CE9DAD21C337
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: ef36f081295257b30c88a8884e1bc6e7688f7f3a338df2da896f0395126587f5
#. default-sha256: 7acc2e42daec56f346eca74ddce0690ba90d1854a897dc1860cb0a79cc081e2e
msgctxt "scenario8:scenario8_F480A4C3_8233_4415_B4ED_CE9DAD21C337"
msgid "⟪k:0⟫⟪k:1⟫⟪k:2⟫No need to apologize for the truth."
msgstr "⟪k:0⟫⟪k:1⟫⟪k:2⟫用不着道歉啦，⟪k:3⟫你说的是事实嘛。⟪k:4⟫⟪k:5⟫而且，⟪k:6⟫那个——"

#: scenario8:scenario8_F6ACCCD6_9C77_43C8_9909_208AA8649AA1
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 0251f0bd50524c612c725a2cd1556d13df952cf2e7130fb1a642be386f06bf9a
