msgid "⟪k:0⟫⟪k:1⟫............"
msgstr "⟪k:0⟫⟪k:1⟫…………"

#: scenario8:scenario8_6971D90D_6A3C_4F04_901C_F6B27FFBCE89
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 4016d43b6ea5f7b4fbafe4c0260908269835a655d3b9b60dfc23015ddfd10b1f
