msgid "⟪k:0⟫⟪k:1⟫No, I don’t ⟪k:2⟫want⟪k:3⟫ to."
msgstr "⟪k:0⟫⟪k:1⟫不……⟪k:2⟫是不想再视而不见。"

#: scenario8:scenario8_0EC45386_CC26_4273_9642_877D8503B806
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 6bef9e025a4ab159bed1789f4c5c2feaa36339be97d2dcec432bae8f4215b0ca
