msgid "⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫Yes?"
msgstr "⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫……请讲。"

#: scenario8:scenario8_0357EF2B_3EF5_4C3A_BAC0_D828E0C3AB1A
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: b8c9fb8ee0f192d38b2d81e3c45cc59ad0bb69b332db7413e92ef55f301ee551
