msgid "⟪k:0⟫⟪k:1⟫For giving me the courage to open my eyes."
msgstr "⟪k:0⟫⟪k:1⟫谢谢你，⟪k:2⟫给我面对的勇气……"

#: scenario8:scenario8_00F54393_691B_4C8B_9333_2734C66DD262
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: fd9cae06f9b953fa7a36d86c4bba5ab9a707247b74424b2efd88841535ab8358
