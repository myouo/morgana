msgid "⟪k:0⟫⟪k:1⟫Y-⟪k:2⟫Yes, but..."
msgstr "⟪k:0⟫⟪k:1⟫虽、⟪k:2⟫虽然是这样啦……"

#: scenario8:scenario8_73427DE4_86F4_4374_BF45_C20454200F78
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 157a76609495efba3b436de0ccf155fb37fc09aee1b3caf5dbd216a13aca0943
