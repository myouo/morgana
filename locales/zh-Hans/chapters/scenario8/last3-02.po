msgid "⟪k:0⟫⟪k:1⟫............"
msgstr "⟪k:0⟫⟪k:1⟫…………"

#: scenario8:scenario8_3C079421_56E1_4F15_93A3_DA796E86F4D7
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 42d25615fa23c65464c0d9dc9fbd4d74ccdc1ccff7161bb0568269ad241f9c0b
