msgid "⟪k:0⟫⟪k:1⟫⟪k:2⟫...O-⟪k:3⟫Okay."
msgstr "⟪k:0⟫⟪k:1⟫⟪k:2⟫………嗯、⟪k:3⟫嗯。"

#: scenario8:scenario8_E3CEB4C4_51B4_4C52_A66E_756397078185
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: f2af0c2cb36b62cec557f5cf398a1b0b3e9fbce1587b1aee91e07ee0be11cbf9
