#: scenario8:scenario8_D2028BE3_1C49_4685_9BA6_05D8B7988A70
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: cca11a2c5e10749015cb08d6ba49b27274bac1dd09bcafe8b02c0da6df6d1fab
#. default-sha256: a8012814a7d9ab5636ef5ed6c461978342ebdbe44fbbe01a146018325fcd9963
msgctxt "scenario8:scenario8_D2028BE3_1C49_4685_9BA6_05D8B7988A70"
msgid "⟪k:0⟫Hahahahahahah... ⟪k:1⟫hee, ⟪k:2⟫heehee, ⟪k:3⟫ahaha, ⟪k:4⟫hahahaha!"
msgstr "⟪k:0⟫哈哈哈哈哈哈……⟪k:1⟫嘻、⟪k:2⟫嘻嘻，⟪k:3⟫啊哈，⟪k:4⟫哈哈哈哈……！"

#: scenario8:scenario8_146F5F6C_B470_4D37_810A_EE5AD2905462
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 1c399a55d6328d24878d431df5cf9b0025b927011935761f4e0aac37b1236116
#. default-sha256: af46e1ef08757e37262842d1109a92d73f08ca8cbca00c7cfcbf2e4fb9153c54
msgctxt "scenario8:scenario8_146F5F6C_B470_4D37_810A_EE5AD2905462"
msgid "⟪k:0⟫the corpses would have had nothing to stimulate in the first place."
msgstr "⟪k:0⟫就不会对人的尸体感到兴奋……"

