msgctxt "scenario8:scenario8_99D8C435_D1A6_4250_BEE5_FAF503B4FCAE"
msgid "⟪k:0⟫let me hear that curiously calming voice of hers,"
msgstr "⟪k:0⟫如果能让我听到可以平息躁动的声音……"

#: scenario8:scenario8_DBE0621A_8875_469C_A011_E3A4837A33B9
