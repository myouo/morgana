msgid "⟪k:0⟫⟪k:1⟫............"
msgstr "⟪k:0⟫⟪k:1⟫…………"

#: scenario8:scenario8_2EB39580_FF7B_4387_B185_A520655DDDAA
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: ba3756f1207c78ab2ac49a528f33537103c9e0e4cfe46a396bfe9b06d6338cab
#. default-sha256: 781b9ae4047bcb0b8b1f98d63968f3ab4661b665b14ffe29934ff5065241c201
msgctxt "scenario8:scenario8_2EB39580_FF7B_4387_B185_A520655DDDAA"
msgid ""
"⟪k:0⟫⟪k:1⟫We’ll probably have more luck asking than just searching for her. ⟪k:2⟫If we can’t find "
"Mell, the nun might know."
msgstr ""
"⟪k:0⟫⟪k:1⟫比起没头没脑地找，⟪k:2⟫还是先向人打听试试吧。⟪k:3⟫⟪k:4⟫要是找不到梅尔的话，⟪k:5⟫就先去问"
"问修女好了。"

#: scenario8:scenario8_49B91D93_C7F9_4BB2_B3FC_8873EEEDA737
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 675ccc5efbd0a20c700116cef71ff00aa7d5b3640fd4b1e384259cdb520356aa
#. default-sha256: 54982c33ead68ed6b1f4f34e55f457c34311e609660cd853b50e636f75eb4143
msgctxt "scenario8:scenario8_49B91D93_C7F9_4BB2_B3FC_8873EEEDA737"
msgid "⟪k:0⟫The man is practically beaming, and judging by the vial in his hand,"
msgstr "⟪k:0⟫老人脸上洋溢着幸福的笑容。⟪k:1⟫那笑容似乎，⟪k:2⟫不仅仅是出于对修女的喜爱与信赖。"

#: scenario8:scenario8_4A9271DD_A8CC_4C84_AD1C_5E56EA43DC0A
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 1db612cb22927d72a546d1ec75fae3f121677da3da564d904ac9ec68a3998ade
#. default-sha256: 51a28cae13a7007b919c96c17bb315a47ad2285dddc066dab250d1630d5c7c64
msgctxt "scenario8:scenario8_4A9271DD_A8CC_4C84_AD1C_5E56EA43DC0A"
msgid "⟪k:0⟫⟪k:1⟫⟪k:2⟫We come from the future, so we know just how dangerous this is..."
msgstr "⟪k:0⟫⟪k:1⟫⟪k:2⟫我们知道将来发生的事……⟪k:3⟫⟪k:4⟫所以非常明白这样下去会有多危险……"

#: scenario8:scenario8_E3C4D349_6165_42E5_9315_528017A9ED61
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 222f563bab84f29d037ad059c8dbacff08a3ad6f3223f25b4e9d7f1830fbe100
#. default-sha256: e7c74979c93f81cae65494ead383466402e3d91156e93722243581dd42b8336d
