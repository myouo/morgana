msgid "⟪k:0⟫⟪k:1⟫⟪k:2⟫............"
msgstr "⟪k:0⟫⟪k:1⟫⟪k:2⟫…………"

#: scenario8:scenario8_A79F4CA2_AD04_40C7_B8B5_A0D9E54A03F7
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: a224aa64f5dde6e19ca6782adc77de51004e351832948462cd535a12465d6b68
#. default-sha256: cdf162ded543864a99783d2d92fb23a04dfc4b4c987abfca0cf9fc5ade839dff
msgctxt "scenario8:scenario8_A79F4CA2_AD04_40C7_B8B5_A0D9E54A03F7"
msgid "⟪k:0⟫⟪k:1⟫⟪k:2⟫Wh-⟪k:3⟫What makes you say that?"
msgstr "⟪k:0⟫⟪k:1⟫⟪k:2⟫怎、⟪k:3⟫怎么了？⟪k:4⟫要是别的人的话会很麻烦吗？"

#: scenario8:scenario8_7674CD59_B5A7_4FE7_8A2A_858A866DF114
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: eae9bce115ba9741b478f53834a0f7101bd4b11b86788f670ba76588153292bd
