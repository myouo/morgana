#: scenario8:scenario8_9BDA91B8_539C_4F5D_847A_7DA133F4322E
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 9a954d408ff886445206710624726734efb901b8e8a8b448c261c259f50f4225
#. default-sha256: 9e522275707a9836c61c0271e9e5314d3c64df38c00ec616821a08b6c5a1fb0d
msgctxt "scenario8:scenario8_9BDA91B8_539C_4F5D_847A_7DA133F4322E"
msgid "⟪k:0⟫Her response perplexed me to no end."
msgstr "⟪k:0⟫……老实说，⟪k:1⟫我很难理解。"

#: scenario8:scenario8_EC49C8BB_5FDB_4AE8_9EBB_AA9063A1CF4E
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 7c99f3d9b7acbc471c8003e6c1a9e1423b276554a396e3fc8bf528284e1b9c87
#. default-sha256: f3810932796d8b3bb0ddad0262c325e4f560aec48e7e731364bbacc2a350ded5
msgctxt "scenario8:scenario8_EC49C8BB_5FDB_4AE8_9EBB_AA9063A1CF4E"
msgid ""
"⟪k:0⟫Why was she concerned about showing gratitude?⟪k:1⟫⟪k:2⟫Why was she not despairing of her "
"own circumstances?"
msgstr "⟪k:0⟫为什么在这种情况下，⟪k:1⟫还惦记着要对别人道谢？⟪k:2⟫⟪k:3⟫为什么不哀叹自己的境遇？"

#: scenario8:scenario8_588F204E_BD55_492F_AE46_FEE88E4B0992
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: dc592653f5ac9352bd182289f73b26bdef4f9ea5f08a9ad05761389d1ebd6afe
#. default-sha256: 3b0e43cf8b6f764ff5050100d6b59db7a6059b99e9a75dcee2e64ea4f9165b8d
msgctxt "scenario8:scenario8_588F204E_BD55_492F_AE46_FEE88E4B0992"
msgid ""
"⟪k:0⟫Why was ⟪k:1⟫that⟪k:2⟫ the emotion that gripped her in that moment,⟪k:3⟫not hatred for the "
"slave trader or sorrow for herself?"
msgstr "⟪k:0⟫既不是憎恨奴隶商人，⟪k:1⟫也不是可怜自己……⟪k:2⟫为什么要为没能道谢而哭泣？"

#: scenario8:scenario8_E741F2EC_7327_47BE_A7F8_6829F55F4BD7
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 46bc33635329e89d2708ee5261747fe1ac4149613e52ea51748a7a8a078d1b90
#. default-sha256: 25c08cdf8075f77bb4aad0e40903aceadf404510807ebe41ed362392dcb0d939
msgctxt "scenario8:scenario8_E741F2EC_7327_47BE_A7F8_6829F55F4BD7"
msgid "⟪k:0⟫But that wasn’t the only thing I found curious—"
msgstr "⟪k:0⟫……令我诧异的，⟪k:1⟫不仅仅是她的话……还有她的声音。"

#: scenario8:scenario8_5208504F_1AAE_4F72_B6CB_E7190415914C
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 6fbf023bf27cef33664bcd885199e19e45079c1cc734f0e9319123febedf3746
#. default-sha256: 1924b279d96ceaad856cd453568e92b0cfa17b545c37caf78db95719fb1db26a
msgctxt "scenario8:scenario8_5208504F_1AAE_4F72_B6CB_E7190415914C"
msgid "⟪k:0⟫untainted by its surroundings, gently undulating."
msgstr "⟪k:0⟫它和任何事物都没有交集，⟪k:1⟫不会被任何事物污染，⟪k:2⟫缓缓地摇曳着。"

#: scenario8:scenario8_E504084A_9C20_45F3_912C_A7D0B10F5E4A
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 1283102cf5d6a431c838c8f3bca1d552c8ca1aadffec5acc260f72748d48b2c2
#. default-sha256: e9a16a3578677f7dc44ad9d957b47b6bdc4ab3c2d47d19f99cedf2d1b7ae50e9
msgctxt "scenario8:scenario8_E504084A_9C20_45F3_912C_A7D0B10F5E4A"
msgid ""
"⟪k:0⟫One sentence was all she said, but there was something unbelievably calming about the sound "
"of it."
msgstr "⟪k:0⟫少女仅仅说了这一句话，⟪k:1⟫却给我心中带来了惊人的安宁。"

#: scenario8:scenario8_B8A4CC39_B636_4246_8280_80E8593A0BC9
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: f5b7701de705ba79ffe4d52d21dac16809e592248da28011636a1416e05f8862
#. default-sha256: b279676b9d2f5fa9474be2993d3b8b706e1116c16403cd81123f9e03664ec8df
msgctxt "scenario8:scenario8_B8A4CC39_B636_4246_8280_80E8593A0BC9"
msgid ""
"⟪k:0⟫I wanted to get her out of that filthy carriage,⟪k:1⟫⟪k:2⟫to undo the shackles threatening "
"to taint her."
msgstr "⟪k:0⟫我想把她……从这辆肮脏的马车中解放出来……⟪k:1⟫⟪k:2⟫想为她除去那污秽的枷锁……"

#: scenario8:scenario8_A6C67B8C_AC73_47DE_B7BA_2A35F735CC4D
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 05a8eb8fd787be0463544fe274eb366ef677d86aa54f1ece9612364db93d5659
#. default-sha256: 12ea1569ae2ce7af46232dd63f7a798d628c9ad8a4d5b785d419b017cc324998
msgctxt "scenario8:scenario8_A6C67B8C_AC73_47DE_B7BA_2A35F735CC4D"
msgid "⟪k:0⟫Please! Y-⟪k:1⟫You can have all my money!⟪k:2⟫You can go free, if that’s what you want!"
msgstr "⟪k:0⟫拜托了！⟪k:1⟫要、⟪k:2⟫要钱的话都给你……！⟪k:3⟫也会给你自由！"

#: scenario8:scenario8_E9304167_6DA8_4048_B3A9_C40F51B84193
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 2e8c0f7410f16003d0903d8e84e331d32fb41ddb4c67f0521825054991950a40
