msgctxt "scenario8:scenario8_E9304167_6DA8_4048_B3A9_C40F51B84193"
msgid "⟪k:0⟫............"
msgstr "⟪k:0⟫…………"

#: scenario8:scenario8_7DBA9456_045C_4B81_80D9_855C84B146AD
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 4445f25713dff5d6e7a2501ae787ed51b816d214190cafc7414afd4332368a00
#. default-sha256: 5ada24e259486c92301ea9887d27fd3aa566a37d22f385be476f0dfca157b5f7
msgctxt "scenario8:scenario8_7DBA9456_045C_4B81_80D9_855C84B146AD"
msgid "⟪k:0⟫What... ⟪k:1⟫Why are you laughing?!⟪k:2⟫⟪k:3⟫Please spare me!"
msgstr "⟪k:0⟫喂……⟪k:1⟫喂，⟪k:2⟫你在笑什么……！⟪k:3⟫⟪k:4⟫拜托了，⟪k:5⟫饶了我吧！！"

#: scenario8:scenario8_356BBD69_CC39_40EF_B716_3DC3E83C717F
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 92fec970e4f7b50ba8e455fb83050ae48abaf3f3c92d05a0359e2547d37c8fdc
#. default-sha256: cbf2302626b0a5b5007e13f1b03de83d0c7e02855cff51c9088707f1f830e0a8
msgctxt "scenario8:scenario8_356BBD69_CC39_40EF_B716_3DC3E83C717F"
msgid ""
"⟪k:0⟫And why—⟪k:1⟫⟪k:2⟫⟪k:3⟫⟪k:4⟫⟪k:5⟫⟪k:6⟫                                             ⟪k:7⟫"
"should I care?"
msgstr "⟪k:0⟫那——⟪k:1⟫⟪k:2⟫⟪k:3⟫　　　　　　　　又何妨？"

#: scenario8:scenario8_47E25499_1CB1_4FCD_812C_5E2E7E83CFEF
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: aaa2eec7a0f1b0caf17a5540ea901fdd4ae64b532b13e9ec8af2417a3ea206de
#. default-sha256: edb567e942dc8d907bfcc69a8dd64f3385224ca0239051009622ecf4c4a39872
msgctxt "scenario8:scenario8_47E25499_1CB1_4FCD_812C_5E2E7E83CFEF"
msgid "⟪k:0⟫Look at this..."
msgstr "⟪k:0⟫喂……⟪k:1⟫快看啊……"

#: scenario8:scenario8_7A46B2FE_18AB_4BAF_89BD_43662D335722
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: c16c81a7bf4ba100f1d9d599d4d938a35a67db679a46f63f64214f6f1e0cb97e
#. default-sha256: c33cae90682d5500a8e6494b4b3ec947511cb9b5f396924ca4cd867a97583129
msgctxt "scenario8:scenario8_7A46B2FE_18AB_4BAF_89BD_43662D335722"
msgid "⟪k:0⟫They stood no chance against my strength!"
msgstr "⟪k:0⟫在我的力量面前……⟪k:1⟫那些家伙只能屈服！"

#: scenario8:scenario8_B7204B16_FEB5_4ED8_9B3C_52F11A5F5D88
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: ac4270ada4e6611af589c5b1f4f2dc311b585b8fe72e134ccb5b6033e048a9a0
#. default-sha256: 3137674bb13d6c6e976441fa1011d0d11057b289a8957bd94b06db42c3cea6ff
msgctxt "scenario8:scenario8_B7204B16_FEB5_4ED8_9B3C_52F11A5F5D88"
msgid ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫After taking the keys off one of the slave traders, I returned to the carriage, "
"doing my best to act calm and suppress the bubbling exhilaration."
msgstr ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫……我从奴隶商人身上夺走钥匙，⟪k:3⟫回到马车上。⟪k:4⟫⟪k:5⟫我勉强压抑住兴奋，⟪k:6⟫装出"
"平静的样子。"

#: scenario8:scenario8_22D704DB_3077_46C5_B94C_2FE52D04285E
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: e957c213b66eae0a04724bae41c4a1e1dd1790d57cb1e5a236e5fea4fef2d1bd
#. default-sha256: efbb6f657277162deef7661bd2d9bbf3ac5de3afc66f1d831d8b9a7117c75de6
msgctxt "scenario8:scenario8_22D704DB_3077_46C5_B94C_2FE52D04285E"
msgid "⟪k:0⟫⟪k:1⟫You.⟪k:2⟫"
msgstr "⟪k:0⟫……喂……"

#: scenario8:scenario8_B05D0D1C_5531_4869_B128_1EE982010B41
