#: scenario3:scenario3_D94E54B6_BEB8_42C3_911C_659E587625D6
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: a0e1a99dc5ac8f3c0ae8c8c5c0b306b5bbaf1a12c6691374e1eb181d5fedc47d
#. default-sha256: bcb9e65f6bcc8ea6277b0a8eb149953133c90ae50b9469243431edcc11bc7099
msgctxt "scenario3:scenario3_D94E54B6_BEB8_42C3_911C_659E587625D6"
msgid "⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫⟪k:4⟫⟪k:5⟫⟪k:6⟫⟪k:7⟫⟪k:8⟫⟪k:9⟫...Jacopo?"
msgstr "⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫⟪k:4⟫⟪k:5⟫⟪k:6⟫⟪k:7⟫⟪k:8⟫⟪k:9⟫……雅各布……？"

#: scenario3:scenario3_2DF7179A_50DD_48A1_B9C4_D0C6B18EBD99
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 8dcbae6c8b1359e7570ce0a2d157f54dcd3584b92d26aab5ba487a1a1c2791b5
#. default-sha256: d02989f0a4281aaba62e649af9c739240e481475646ac17d289b90b0d401df39
msgctxt "scenario3:scenario3_2DF7179A_50DD_48A1_B9C4_D0C6B18EBD99"
msgid "⟪k:0⟫............"
msgstr "⟪k:0⟫…………"

#: scenario3:scenario3_07C975E2_D356_4E7B_844A_489E8DC63ADD
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 7a66ce0c6a1dd0aab0339e895172be01a1ae4bdb881a8d47570ef9f29d6ff9aa
#. default-sha256: b37e979cfabd7c18f9e080e707bb9de66e1de31286b5c59b9786ecce59fdf1f0
msgctxt "scenario3:scenario3_07C975E2_D356_4E7B_844A_489E8DC63ADD"
msgid "⟪k:0⟫Where’s your dad?⟪k:1⟫⟪k:2⟫Or are you here alone?"
msgstr "⟪k:0⟫父亲他们呢？⟪k:1⟫你一个人来这里的吗？"

#: scenario3:scenario3_FB79E208_7D31_47CF_A0DA_ABBDAFA22C4F
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 152c9f9044037d6a155fadbff84077afd73093c90ff56630ef32b3a06250a322
#. default-sha256: 08ac173a5afd2908542dae6138c7153af9cadbde23016f8606f6c73528afc67a
msgctxt "scenario3:scenario3_FB79E208_7D31_47CF_A0DA_ABBDAFA22C4F"
msgid "⟪k:0⟫He... ⟪k:1⟫didn’t even tell me..."
msgstr "⟪k:0⟫父亲他不肯告诉我……"

#: scenario3:scenario3_6FE290DD_7AD9_4B2C_A50A_31C5965984F5
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 37154053d5e862f74bcc66bdf28daee5e315a8e02e05282b2ca4bcf9d3d9a73f
#. default-sha256: 38a8aeec7600acac9b8758aaeac52dce35d00fb4b53b5575e1d708c0e63bb86c
msgctxt "scenario3:scenario3_6FE290DD_7AD9_4B2C_A50A_31C5965984F5"
msgid "⟪k:0⟫Ah..."
msgstr "⟪k:0⟫是吗……"

#: scenario3:scenario3_CDA793AA_8C43_4FEC_9F5D_017005C93182
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: a73628b839308c42db09fb3a7a7456dc2b09c51eee6809a443e9d5518ea48cd2
#. default-sha256: b79ef664191f4d0fc5d5e9b7581458e8eee290c21b0ed2d4595cad5a2174b305
msgctxt "scenario3:scenario3_CDA793AA_8C43_4FEC_9F5D_017005C93182"
msgid ""
"⟪k:0⟫There’s... ⟪k:1⟫no reason you have to leave town.⟪k:2⟫⟪k:3⟫My old man says the Campanellas "
"have more power."
msgstr ""
"⟪k:0⟫再怎么说……⟪k:1⟫也没有必要连你都必须离开啊。⟪k:2⟫⟪k:3⟫在这个城市，⟪k:4⟫更强的是坎帕内拉一家，"
"⟪k:5⟫老爹是这么说的。"

#: scenario3:scenario3_16A96EA9_EC19_443A_9899_DD960278A6BB
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 391fa7635c1e133f151d18ba64f238b761ec06d2d69822b12558b3a8b5d3cb69
#. default-sha256: 6b8ea4b47e9b807945bd0d59c4cc2704680b59073e8f7cbf90cbc46ef3c9ed08
msgctxt "scenario3:scenario3_16A96EA9_EC19_443A_9899_DD960278A6BB"
msgid "⟪k:0⟫I should be the one leaving."
msgstr "⟪k:0⟫那样的话，⟪k:1⟫该走的是我们才对吧。"

#: scenario3:scenario3_4A434A8E_FC21_45BB_B783_9126F1B071DF
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 614c136fededcfef9efa0b1f8f938c67a1837bf967f3e585c90e1c69ff4c6f96
#. default-sha256: b4da9b00aac06e824cffd8d6023af4ddbdcfe78bcd674b4eabd14f28b493a54e
msgctxt "scenario3:scenario3_4A434A8E_FC21_45BB_B783_9126F1B071DF"
msgid ""
"⟪k:0⟫It’s not that simple.⟪k:1⟫Grownups have a lot to consider.⟪k:2⟫⟪k:3⟫So don’t give me that "
"look, Jacopo."
msgstr "⟪k:0⟫大人的世界很复杂的啊。⟪k:1⟫⟪k:2⟫雅各布没必要露出那种表情啦。"

#: scenario3:scenario3_ED963991_E6FC_4B9D_8FD8_2632C7573FA6
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 8dcbae6c8b1359e7570ce0a2d157f54dcd3584b92d26aab5ba487a1a1c2791b5
#. default-sha256: d02989f0a4281aaba62e649af9c739240e481475646ac17d289b90b0d401df39
msgctxt "scenario3:scenario3_ED963991_E6FC_4B9D_8FD8_2632C7573FA6"
msgid "⟪k:0⟫............"
msgstr "⟪k:0⟫…………"

#: scenario3:scenario3_94BEA963_2835_4F52_912F_6D6743EBAE65
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 0b3b89b940f675fae64cce7a16824e8da7e05fd12cf36a6ccba805b47d2ac5b3
#. default-sha256: 7d897d403179ce3bb55abd01919436302fbba23c5f900d489fc9f28bcc2d8f7e
msgctxt "scenario3:scenario3_94BEA963_2835_4F52_912F_6D6743EBAE65"
msgid ""
"⟪k:0⟫We were kids, but we’d both kinda started to catch on—⟪k:1⟫⟪k:2⟫to the situation with our "
"families, and to the bonds that land held on us."
msgstr ""
"⟪k:0⟫我们虽然都是小孩，⟪k:1⟫但也隐约察觉到了呢。⟪k:2⟫⟪k:3⟫彼此家族的事情，⟪k:4⟫还有这片土地上的纷"
"争。"

#: scenario3:scenario3_B0E1009B_E596_43B6_8C25_F53242CA2929
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: fe57a87a3ccf8e467e49c25d5ee75ad2361237fc4f6e39356031c0389e665161
#. default-sha256: 0ecf5d9e83f7db0615a22c9f2bb40086b2489160d967562a68fccb89804a2d02
msgctxt "scenario3:scenario3_B0E1009B_E596_43B6_8C25_F53242CA2929"
msgid "⟪k:0⟫Although we didn’t know any of the details at the time."
msgstr "⟪k:0⟫当时虽然还不怎么清楚内情。"

#: scenario3:scenario3_420E9C01_B49E_4D3D_9484_B9EB1E8426BC
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 336684648a7360fcd610799c112a3ec921d87c11e05b4f232360f928189d2c9e
#. default-sha256: 2f4fef95fdbf629a425d9a87eb1ac82259434c417afd8d8b4f003d262572407c
msgctxt "scenario3:scenario3_420E9C01_B49E_4D3D_9484_B9EB1E8426BC"
msgid ""
"⟪k:0⟫My grandpa owned all the land the city was built on, but he was a very conservative man. "
"⟪k:1⟫He didn’t try to spread his influence, instead opting to fortify what he already had."
msgstr ""
"⟪k:0⟫这片地区的大地主是我的爷爷。⟪k:1⟫可是，⟪k:2⟫他是个保守的人。⟪k:3⟫⟪k:4⟫不是去扩张势力，⟪k:5⟫而"
"是巩固内部的类型……"

#: scenario3:scenario3_44E5E60F_619F_4783_9AF8_6D59FB70B4CA
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: d300027987b7c21a7693641742d19ef4a23293e34c3188b0d50f5b663a0d99d1
#. default-sha256: 15b6a5948802cde323af84620916f8a28f4e2fb05ef57e19bec4149ba3356916
msgctxt "scenario3:scenario3_44E5E60F_619F_4783_9AF8_6D59FB70B4CA"
msgid ""
"⟪k:0⟫I don’t know exactly when it first started, but organizations were used to administrate "
"cities."
msgstr "⟪k:0⟫不知道从什么时候开始的，⟪k:1⟫为了管理地区而创立了组织。"

#: scenario3:scenario3_FE03D2C2_CE9D_49A0_AD09_93D508BD862D
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 57b3ebc4ef460b5959ebc4fe1b7ea48b92ad3cae1a3d9a3d707e0606c4111a8b
#. default-sha256: 78be6092033528956ba2ca011c0d839dc857e8602591a9d92df0d9ab053e0c70
msgctxt "scenario3:scenario3_FE03D2C2_CE9D_49A0_AD09_93D508BD862D"
msgid "⟪k:0⟫And when we were kids, my dad was the capofamiglia, and my grandpa his consigliere."
msgstr "⟪k:0⟫在我们还是小孩的时候，⟪k:1⟫我的父亲是首领<capo>，⟪k:2⟫爷爷则是顾问<consigliere>。"

#: scenario3:scenario3_DE4155A7_D75E_47AA_BA2F_C5237A5D2575
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 00d33ccf0cc98ae4668eae1d5ed2ceb1dcab7aaa681a6161a5c4105726c6492e
#. default-sha256: 8a181f39dcc5880c887dffac6a0eacf70ac23933f1936f1a64eae11b779d5c6c
msgctxt "scenario3:scenario3_DE4155A7_D75E_47AA_BA2F_C5237A5D2575"
msgid ""
"⟪k:0⟫But just because he was an adviser didn’t mean he was powerless. ⟪k:1⟫While my dad made the "
"decisions, my grandpa was the only one allowed to fight him on them."
msgstr ""
"⟪k:0⟫不过，⟪k:1⟫虽说是顾问，⟪k:2⟫也不容小觑呢。⟪k:3⟫⟪k:4⟫决定权虽在父亲手上，⟪k:5⟫但掌握话语权的却"
"是爷爷。"

#: scenario3:scenario3_56045517_5319_4499_BB6B_D42414E734FE
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 7d14f20f0f30537db7d66cdb35f80b680090236c86414bf9b5362a4affeb3293
#. default-sha256: 2ddfac73b0655d2167352f042edd201aa1c81dd63101a6d38110f9dda37eac01
msgctxt "scenario3:scenario3_56045517_5319_4499_BB6B_D42414E734FE"
msgid ""
"⟪k:0⟫Your father was a capodecina that served under my dad; ⟪k:1⟫he wasn’t especially happy about "
"that."
msgstr "⟪k:0⟫你的父亲，⟪k:1⟫在我父亲手下的担任干部<capo・regime>的职位，他很不喜欢这种体制。"

#: scenario3:scenario3_E92A8C87_218D_41CE_9786_583BDA361FB7
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 62bf4070780eca25c540f544c3178126c77dee6d0830a546af644471f61fbf51
#. default-sha256: 16dd21cd4d64f57b86624f152856cde37c8351fcb39755676eb6040f5c155650
msgctxt "scenario3:scenario3_E92A8C87_218D_41CE_9786_583BDA361FB7"
msgid ""
"⟪k:0⟫But parents’ quarreling doesn’t affect their kids—⟪k:1⟫⟪k:2⟫or at least, that’s what I "
"thought at the time, and what you probably thought too."
msgstr ""
"⟪k:0⟫可是，⟪k:1⟫长辈之间的纷争和孩子没关系吧？⟪k:2⟫⟪k:3⟫至少我是这么想的，⟪k:4⟫你也是这么想的吧。"

#: scenario3:scenario3_28B62F9C_A22F_4061_8C74_AF06E01EF4AE
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 554215c7198c53d48988f2d07e9b5f3b73ca06e7fd9a1917f6660be0fce722f6
#. default-sha256: c3a87994e323dddcc55141ffe99872833b410fc0437374d11174048562851893
msgctxt "scenario3:scenario3_28B62F9C_A22F_4061_8C74_AF06E01EF4AE"
msgid ""
"⟪k:0⟫But there was still a chance we could be caught in the crossfire, so my dad decided to send "
"me and my mom away."
msgstr ""
"⟪k:0⟫虽然这么说，⟪k:1⟫这些事没准会殃及到孩子也是事实……⟪k:2⟫⟪k:3⟫所以父亲想让我和母亲远离这些是非。"

#: scenario3:scenario3_F203B666_9A02_4FA1_97BC_4021E9442EBC
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 9581da393fb51165dc074d9cf61f0423f405319bf01d98d0d389a61b09d8a1ea
#. default-sha256: 15db5cec5d7c9e7cfe47501513881f1b58bd1e602e4cbd36738fb6a4cd561596
msgctxt "scenario3:scenario3_F203B666_9A02_4FA1_97BC_4021E9442EBC"
msgid "⟪k:0⟫Off the island and to the north were some more prosperous areas."
msgstr "⟪k:0⟫离开这座岛，⟪k:1⟫去更北边的——繁荣的地方。"

#: scenario3:scenario3_EFB90E92_858C_4A69_8A70_A1F053E3BA3A
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 84fe1b180136e891d0cab4f01675f91e53ea8e631522ea26919074733b4e9129
#. default-sha256: 532d0af4e014a42ed5d434b33da4065f1df096a20e11f5496f9daabace23b33f
msgctxt "scenario3:scenario3_EFB90E92_858C_4A69_8A70_A1F053E3BA3A"
msgid ""
"⟪k:0⟫He thought that by sending us there, we could live our lives clean, regardless of where we "
"came from."
msgstr ""
"⟪k:0⟫他说往北走的话，⟪k:1⟫像我们这种出身的人——⟪k:2⟫也能过上精彩的人生吧。⟪k:3⟫他是这么认为的。"

#: scenario3:scenario3_FB5A0103_4072_4CE8_97DE_29C346E2241A
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 144d11220c6cc947beb8c3ed75c5d0cef2e83e40b2c00a4f95b874d3033e7037
#. default-sha256: a974e7499220df12b772e1f40fd0c854ad80ad166badf7b7cb2642549fdc31b0
msgctxt "scenario3:scenario3_FB5A0103_4072_4CE8_97DE_29C346E2241A"
msgid "⟪k:0⟫There’s no changing what’s in your blood, though."
msgstr "⟪k:0⟫明明无论去到哪里，⟪k:1⟫血统都是不会改变的。"

#: scenario3:scenario3_65B10959_E51A_4BFE_BAD9_71004141E3EF
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 733af3f3865ef78375b48e32b6dfe3c4d253d37d3be4aa57c51b933795ef3380
#. default-sha256: 3077ededc5c0c98e8532781764c37988db9766a1b7dddfae8244af9fe6313a0d
msgctxt "scenario3:scenario3_65B10959_E51A_4BFE_BAD9_71004141E3EF"
msgid ""
"⟪k:0⟫You could have told me too.⟪k:1⟫⟪k:2⟫Or were you planning on leaving without saying anything?"
msgstr "⟪k:0⟫……你也是，⟪k:1⟫告诉我就好了。⟪k:2⟫⟪k:3⟫打算什么都不说，⟪k:4⟫就这么离开吗？"

#: scenario3:scenario3_238D2C70_8B02_445E_A29F_79A27DE018DE
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: d030dfe43d8f0fdbc936428945cdbb87409efac1d13424970758c268c7f9486e
#. default-sha256: 84cd7ee338b085ab8bc5a9068797f80bb6b48386e3cafbe0f8e8708e374edb86
msgctxt "scenario3:scenario3_238D2C70_8B02_445E_A29F_79A27DE018DE"
msgid "⟪k:0⟫No, it was just... ⟪k:1⟫all decided so quickly."
msgstr "⟪k:0⟫并不是那样……⟪k:1⟫可已经决定好了，⟪k:2⟫也很匆忙。"

#: scenario3:scenario3_526F465D_F414_4B7B_BDFB_CBB6009BBC02
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 334f205190d1972837ac1bbb15c8e4d2a2ffce8aa8a4c2320a8aab417111ef54
#. default-sha256: b1f70e106e29227b6ae687151c9cf2b1f1e200c2182e1bd3ebc02ed8449f9ea4
msgctxt "scenario3:scenario3_526F465D_F414_4B7B_BDFB_CBB6009BBC02"
msgid "⟪k:0⟫Why do you sound so accepting?"
msgstr "⟪k:0⟫为什么……⟪k:1⟫这么武断地下结论啊。"

#: scenario3:scenario3_E46D378D_F8E2_4F01_9878_B209DD6FB66B
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: e1efe48f4da1958d806d9d8b33d72c6bde53198f360763f292ba6b6591f77095
#. default-sha256: ae475a13090ce4b7687d42593a3bbcacd5d1273b314bdca01245f71e22683247
msgctxt "scenario3:scenario3_E46D378D_F8E2_4F01_9878_B209DD6FB66B"
msgid ""
"⟪k:0⟫Adults have a lot to consider?⟪k:1⟫You bet they do! But you could at least let them know "
"you’re opposed to it, Maria! But no, your tail went straight between your legs as soon as you "
"were told."
msgstr ""
"⟪k:0⟫大人的世界很复杂？⟪k:1⟫ 确实如此！⟪k:2⟫可是玛利亚，⟪k:3⟫你连一点反抗的意思都没有，⟪k:4⟫从一开"
"始就打算老实听话吗！"

#: scenario3:scenario3_DD4238B2_DF1E_4F6E_8239_B8DCDE698AFF
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 050801e68960252376710d3b87c93f631f06dcac9e2e3a602afe37d68e0379d9
#. default-sha256: d5bf9387a755dad94f1bd97b3c2c6e9056ad403ce973402e0e1595e00e03e323
msgctxt "scenario3:scenario3_DD4238B2_DF1E_4F6E_8239_B8DCDE698AFF"
msgid "⟪k:0⟫You just gave up and accepted it straight away!"
msgstr "⟪k:0⟫居然一开始就断定没办法……！"

#: scenario3:scenario3_6ACE91E0_57E9_42AB_A176_501F27BA5E25
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 399f13a436692b52a1ebd4d207e666c9781adfb917133e449e67ee4679b90361
