#: scenario3:scenario3_88E8A41E_A9B3_4AD5_BB26_E648A814EDB1
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 060ce9b48a3bcda0374ffbb1f8838cf1e9ad267ce4797f29950b6404014bedb0
#. default-sha256: 4f2da25417983bf96309e927d3c52bd711941f3b35f35af03bdd5a6bedb7992a
msgctxt "scenario3:scenario3_88E8A41E_A9B3_4AD5_BB26_E648A814EDB1"
msgid "⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫⟪k:4⟫⟪k:5⟫⟪k:6⟫⟪k:7⟫............"
msgstr "⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫⟪k:4⟫⟪k:5⟫⟪k:6⟫⟪k:7⟫…………"

#: scenario3:scenario3_A4D825DA_EBE9_49C2_91AB_B085D9CB8EA5
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 4471cbcf96d77b13948afd365ecb6d4d19a6f3cbea12325b68625798a0f6b234
#. default-sha256: b77ef0755a0ef2763b34bd4c826482b4e7b769fec35f1f8401de9a7e78ba5add
msgctxt "scenario3:scenario3_A4D825DA_EBE9_49C2_91AB_B085D9CB8EA5"
msgid ""
"⟪k:0⟫Looking down dejectedly at the undrunken tea, the White-Haired Girl walked alone down the "
"corridor."
msgstr "⟪k:0⟫白发少女，⟪k:1⟫一边寂寞地看着没人喝的红茶，一边孤身一人走过走廊。"

#: scenario3:scenario3_F7BCD182_8814_4357_9D96_A99E95E4FC85
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 328d9a3eecf4225836af185054a9c58067a2656ea9a7b287201910484cc57724
#. default-sha256: c1aca8bd80728a3ad43368c2a57fd4af6a7155242471017e1e61a35b55751154
msgctxt "scenario3:scenario3_F7BCD182_8814_4357_9D96_A99E95E4FC85"
msgid ""
"⟪k:0⟫Though its calming scent filled the air, there was nobody around to have their heart warmed "
"by it."
msgstr ""
"⟪k:0⟫尽管红茶散发着可以使人心情安宁的香气，⟪k:1⟫但能因此而展露出温和笑容的人，却一个也没有。⟪k:2⟫"

#: scenario3:scenario3_8B9C3D09_7F27_4EB1_A73D_A37B088B6E26
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 1374a7dbb267599de2ca6444cd877d2890f915df27de0556f53ce6685b9a4233
#. default-sha256: 865d85749555c01cda74aee0cb56893267ec7db2d87d96ba29ba57aecef7779f
msgctxt "scenario3:scenario3_8B9C3D09_7F27_4EB1_A73D_A37B088B6E26"
msgid "⟪k:0⟫Nor was there anyone to alleviate her loneliness."
msgstr "⟪k:0⟫没有能慰藉她孤独的人……"

#: scenario3:scenario3_773BF3F5_3E27_413D_B02F_76AAC10204C2
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 17cde8f5fa8b955937f9a48925cb464a6dcf74398d2942c3af3fb68c1bb169f7
#. default-sha256: 7800ce8d5463473c69e77ea9293f9872febcfa22506db05917d02b9084d6264b
msgctxt "scenario3:scenario3_773BF3F5_3E27_413D_B02F_76AAC10204C2"
msgid ""
"⟪k:0⟫Despite being the master’s wife, the maids who crossed her path in the halls said nary a "
"word to her."
msgstr "⟪k:0⟫明明身为这座馆的女主人，⟪k:1⟫但擦身而过的女仆们，⟪k:2⟫连招呼都不和她打。"

#: scenario3:scenario3_B9F11270_C774_4CE1_82C9_98BFE4C943F9
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 68aa094051674e953589322b75910679222b4a9cad9592bfca4dc3bcf4d19ad3
#. default-sha256: d02989f0a4281aaba62e649af9c739240e481475646ac17d289b90b0d401df39
msgctxt "scenario3:scenario3_B9F11270_C774_4CE1_82C9_98BFE4C943F9"
msgid "⟪k:0⟫............"
msgstr "⟪k:0⟫…………"

#: scenario3:scenario3_D1CC945B_1426_486D_A007_7D0E685D60C7
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 68ec4c34dc3422b6ade1233984c3d1f5ca481295e9412878a94793c595173265
#. default-sha256: 3d81e76e0f3367b97156633c5b762db853b8b1b5e61bc4a6f95e88f05aae3cc0
msgctxt "scenario3:scenario3_D1CC945B_1426_486D_A007_7D0E685D60C7"
msgid "⟪k:0⟫As a matter of fact—"
msgstr "⟪k:0⟫不，⟪k:1⟫不仅如此——"

#: scenario3:scenario3_2648BE34_8454_4A6E_A4B9_1544D81DC629
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: b3d2c211b33a1e5575241f562bdaedbf2c4e002ad581b5ed488f668e0a11eeda
#. default-sha256: 1a09e2dc07692e136d3adef88084c12ec8c5b5cda935ca86a5a24bcdb15f0c0b
msgctxt "scenario3:scenario3_2648BE34_8454_4A6E_A4B9_1544D81DC629"
msgid "⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫...!"
msgstr "⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫…………啊！"

#: scenario3:scenario3_3FDDECF2_46DB_4622_9B83_A8AD0DCF0D84
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 55e68a133e6266a1c034f6faa4fad64febe1ff0b9eec7b82857cb041fc6b2400
#. default-sha256: b0cb23a3406cf64c56e28a2631524420c3838e201d40dfd7c1e474115ce4c55b
msgctxt "scenario3:scenario3_3FDDECF2_46DB_4622_9B83_A8AD0DCF0D84"
msgid "⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫⟪k:4⟫⟪k:5⟫⟪k:6⟫⟪k:7⟫Oh dear.⟪k:8⟫I beg your pardon, Madam."
msgstr "⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫⟪k:4⟫⟪k:5⟫⟪k:6⟫⟪k:7⟫哎呀，⟪k:8⟫对不起呢夫人？"

#: scenario3:scenario3_B4165425_8A41_45A9_87B1_4540C8B167C8
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: a9dd7bf7a36263d797144ca846a42920e4c9a59673bedcbb7173b2cae7938e7f
#. default-sha256: fc9e55460e49f4d90aea38ab60203969c60d0ee1e960b5ed1dffacd4e9810c0e
msgctxt "scenario3:scenario3_B4165425_8A41_45A9_87B1_4540C8B167C8"
msgid "⟪k:0⟫Ah... ⟪k:1⟫it’s fine..."
msgstr "⟪k:0⟫啊……⟪k:1⟫没事……"

#: scenario3:scenario3_9747367B_ECC6_47EA_B0E3_2CB573183AC4
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 19fad13f307859da9dbc053211be5faaef49243b79813c80fa9acd77e6ce7819
#. default-sha256: da4075052ed0b112815dd4c9802dafe53af09885632e7001b6a285bb8c0203c7
msgctxt "scenario3:scenario3_9747367B_ECC6_47EA_B0E3_2CB573183AC4"
msgid "⟪k:0⟫—one even bumped into her, stifling a laugh as she trotted off."
msgstr "⟪k:0⟫甚至连撞到她，⟪k:1⟫偷偷忍住窃笑声，⟪k:2⟫扬长而去的女仆也大有人在。"

#: scenario3:scenario3_CD736832_7BEC_4174_A5C4_33B2132F2C71
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 208ee9da4715fe777e84827cae3640eb6e22c41c5b06d0ec67f979a66b47f493
#. default-sha256: 1cb28bd39c2a1cbe1706560452b57e027dd8fd735ad61e115a18a9d8ba5ca727
msgctxt "scenario3:scenario3_CD736832_7BEC_4174_A5C4_33B2132F2C71"
msgid ""
"⟪k:0⟫In all likelihood, she had done it intentionally. ⟪k:1⟫The poor White-Haired Girl, who had "
"fallen to the floor, stared helplessly at the broken cups."
msgstr ""
"⟪k:0⟫估计，⟪k:1⟫是故意那么做的吧？⟪k:2⟫可怜地摔倒在地的白发少女，⟪k:3⟫无可奈何地凝视着碎掉的茶具。"

#: scenario3:scenario3_755AD335_1E15_49D6_A108_2117706A1AC7
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: b07f3c880d8f53f1e20d91af31a2c7b990bae0c9e565c10bab431f37cb5b8520
#. default-sha256: c617afa12cd27c128eb771a2507d0a45bb4467fe8574904415d67fe01ef34a8f
msgctxt "scenario3:scenario3_755AD335_1E15_49D6_A108_2117706A1AC7"
msgid "⟪k:0⟫The tea she had made for her husband was forming a stain in the carpet."
msgstr "⟪k:0⟫特意为丈夫泡的红茶也尽数洒落，⟪k:1⟫在地毯上浸染开来。"

#: scenario3:scenario3_D9217328_537E_44AE_A7D1_F2142D1419F2
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: c2beba49bbc4dcdfde81ff63b2202dfa2d78ac36346aaca762b4d8e40782ebbd
#. default-sha256: 1ea9ad765816ad330d45fc9743f33a4be0a8b8d5bb02b3491d1f882c8a0a39a8
msgctxt "scenario3:scenario3_D9217328_537E_44AE_A7D1_F2142D1419F2"
msgid "⟪k:0⟫The maids’ behavior toward the mistress of the house was absolutely unacceptable."
msgstr "⟪k:0⟫女仆居然用这种行为对待主人的妻子，⟪k:1⟫这是绝不该被允许的行为。"

#: scenario3:scenario3_FCE0642B_DBE2_4935_A25D_FAE1492D1023
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 963a63e18a280d5b17b5c06536c269bf8d76cf9b62768f48b8eae9d3378e55ff
#. default-sha256: ccaadd4112924ac01c6bd245d797229b141830e209f99bb8011d532c6ca5662c
msgctxt "scenario3:scenario3_FCE0642B_DBE2_4935_A25D_FAE1492D1023"
msgid ""
"⟪k:0⟫Nonetheless, it was commonplace—⟪k:1⟫⟪k:2⟫⟪k:3⟫all because of the way Jacopo treated her."
msgstr "⟪k:0⟫可是，⟪k:1⟫在这座馆里大家都对此习以为常。⟪k:2⟫⟪k:3⟫这些，⟪k:4⟫全都是因为雅各布的态度。"

#: scenario3:scenario3_D68D42FA_CF32_457E_9CB5_30FBC93EEFC8
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 0dd4ae5f58fbdff7065e3d404270fcbb47f021e1a3ca8ec449bae1aca996ec40
#. default-sha256: de690d19535412357a0814e04f52e682d27a0e4e8b84efe90a1497c67669ece3
msgctxt "scenario3:scenario3_D68D42FA_CF32_457E_9CB5_30FBC93EEFC8"
msgid ""
"⟪k:0⟫The more the man of the house acted cruel to her,⟪k:1⟫the less weight her position as his "
"wife held to the servants."
msgstr "⟪k:0⟫因为洋馆的主人对妻子的态度十分恶劣，⟪k:1⟫所以妻子的地位也逐渐不保。"

#: scenario3:scenario3_1855FFDE_01E4_46FF_B383_E9128B81C961
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: df51488f513a19eb6c7a66c4fffea5bfdd89bc4c7afcdf4b92ce94d3ecb7feaa
#. default-sha256: 8deccda349656f9fc9cf074ee9da249f4bd0b17112793c7651075e0a7c6d2d78
msgctxt "scenario3:scenario3_1855FFDE_01E4_46FF_B383_E9128B81C961"
msgid ""
"⟪k:0⟫Day in and day out, the maids worked busily—⟪k:1⟫⟪k:2⟫offered little opportunity for leisure—"
"⟪k:3⟫⟪k:4⟫so they would naturally have accumulated quite a bit of stress."
msgstr "⟪k:0⟫女仆们每天都过着没有娱乐时间、⟪k:1⟫忙得团团转的日子。⟪k:2⟫⟪k:3⟫自然也积攒了不少怨气。"

#: scenario3:scenario3_93CD596B_710F_4B6D_A9BE_C45CAFB41920
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: dd09cbc7c15ac767fd85f06a511bcf0709a06fa18f69583730ebb9b4f5a2bd42
#. default-sha256: 7cb84bbc957bba42fbe91c60ccfc351b38b67652a346ddf7878102149f0b1003
msgctxt "scenario3:scenario3_93CD596B_710F_4B6D_A9BE_C45CAFB41920"
msgid "⟪k:0⟫And she became the target for them to let off this steam."
msgstr "⟪k:0⟫她们竟然将这些怨气发泄到白发少女身上。⟪k:1⟫"

#: scenario3:scenario3_A6A74DB4_B6EB_4691_8E51_D0B71446E496
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 9b64830331006b47d1b37701f4365b65dc3db9e3a0573c97434a3044a8933840
#. default-sha256: 6d4b3e7a87b759489415fad873081d1d6f959ab7d2d22a768bab9a4b6d91eabf
msgctxt "scenario3:scenario3_A6A74DB4_B6EB_4691_8E51_D0B71446E496"
msgid "⟪k:0⟫Not directly, but through a more subdued kind of harassment from the shadows."
msgstr "⟪k:0⟫并非直截了当，⟪k:1⟫而是像这样，⟪k:2⟫用阴险手段去刁难她。"

#: scenario3:scenario3_C90492EF_7D04_424F_9879_017BF694F1CA
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: c92b96bc2528c9b72ff2a72dfb1260f5d8753fb8b0cee024c61795c6e8a8d432
#. default-sha256: 42779c4006c213da29cd2a1add784f4f363c05edfdb5d123b9a52dccd3042464
msgctxt "scenario3:scenario3_C90492EF_7D04_424F_9879_017BF694F1CA"
msgid ""
"⟪k:0⟫She must have felt quite miserable. ⟪k:1⟫I imagine she would have been better off as one of "
"the maids."
msgstr ""
"⟪k:0⟫从白发少女的角度来看，⟪k:1⟫这实在是悲惨至极。⟪k:2⟫⟪k:3⟫不过，⟪k:4⟫对女仆们来说，⟪k:5⟫或许是大"
"快人心也说不定。"

#: scenario3:scenario3_FB205E25_E6F8_4865_B3E7_3319368D8FCC
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: be298658b7c772aa32c866376d418294c10c4e78f6dbc981edcdced3efc1a910
#. default-sha256: 2314fcbd3f2dfcea18d4bf2042060f169826ab2c25c61ca3e6ecdb7f28a9c837
msgctxt "scenario3:scenario3_FB205E25_E6F8_4865_B3E7_3319368D8FCC"
msgid ""
"⟪k:0⟫On the surface, and in front of others, they showed respect for her as Jacopo’s bride. But "
"behind closed doors, they acted very much the opposite."
msgstr "⟪k:0⟫表面上，⟪k:1⟫她作为雅各布的妻子受人尊敬——⟪k:2⟫背地里却遭受着这样的对待。"

#: scenario3:scenario3_E95184CC_AC3F_4BCB_A653_912ADADA02DF
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: fc99491eb82f6eb2a4bdbda6dfe76b6c034469fd6f11429bd9a00a354d91ce0b
#. default-sha256: c08df44a917ca44d7e02fc7c2117a3db1661f068b12452a794f0403a943366e4
msgctxt "scenario3:scenario3_E95184CC_AC3F_4BCB_A653_912ADADA02DF"
msgid ""
"⟪k:0⟫The disparity between the treatment she received around others—⟪k:1⟫⟪k:2⟫the treatment she "
"was ⟪k:3⟫supposed⟪k:4⟫ to receive at all times—⟪k:5⟫⟪k:6⟫and the way she was actually treated "
"made the abuse that much worse."
msgstr ""
"⟪k:0⟫本来应受到的表面的待遇，⟪k:1⟫与现实遭受着的私底下的待遇。⟪k:2⟫⟪k:3⟫这样的反差，⟪k:4⟫将她彻底"
"击溃。"

#: scenario3:scenario3_267EE02A_941F_4448_8B47_CA74E017EE6D
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: f8bbca9e2b615318aebeced0938959920564ac79e7ccd299fe4da94953ea166f
#. default-sha256: 6f6bfcbb7b9e2ca368dc6181b1e50c97d8a56e3d7435a11861ccbab7de3e7c78
msgctxt "scenario3:scenario3_267EE02A_941F_4448_8B47_CA74E017EE6D"
msgid ""
"⟪k:0⟫And furthermore, as you have seen through the other doors, Master, she was a very reserved "
"young woman."
msgstr "⟪k:0⟫此外，⟪k:1⟫她正如老爷您所见一般，⟪k:2⟫是逆来顺受的人。⟪k:3⟫既做不到出声指责女仆——⟪k:4⟫"

#: scenario3:scenario3_9BDAD077_9CE6_4C39_8E22_6ABFFEE3ECF1
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 341ebd514fe294f731eb4d0449132316e1c1485f16125ad12eefc22f30519cb0
#. default-sha256: 40be371e817ef12b050ae60b45fc5344644586494d5ad8f94feb723879442910
msgctxt "scenario3:scenario3_9BDAD077_9CE6_4C39_8E22_6ABFFEE3ECF1"
msgid "⟪k:0⟫She could neither raise her voice in reprimand nor raise her hand in retaliation."
msgstr "⟪k:0⟫也做不出反抗的行动。"

#: scenario3:scenario3_2D2FF13F_3EAF_4424_8601_4E4DA6F69371
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 19c5cc42b75a8f36935d10bd072719b5d2dc7949b2c0de6794ce6567ab284cd8
#. default-sha256: 6486bafd83cb088d94954acb1685927d7aa5bad4b999c8880c45ccebec2af656
msgctxt "scenario3:scenario3_2D2FF13F_3EAF_4424_8601_4E4DA6F69371"
msgid "⟪k:0⟫I have to get this cleaned up..."
msgstr "⟪k:0⟫……不赶快收拾好的话……"

#: scenario3:scenario3_01A7312C_4E02_430F_B6A7_45F2AA7F94C5
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: c481a06323c4d9d16d94e020d75d08c75b68e07b1b6ae1534f9c001876f0d26b
#. default-sha256: b340f73e9a3b76202ca0319847e181c42a2833b11bb28b9b156b7e36aba68e16
msgctxt "scenario3:scenario3_01A7312C_4E02_430F_B6A7_45F2AA7F94C5"
msgid "⟪k:0⟫She extended her spindly fingers toward the shards of shattered porcelain."
msgstr "⟪k:0⟫她将纤细的手指，⟪k:1⟫伸向了陶器碎片。"

#: scenario3:scenario3_6C35B0D2_1AEF_4680_A1A4_3B4661C2E547
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: b2637875adad3f1c05f2862dfa6599c8197ecf76b7225df369d7293335550b7f
#. default-sha256: 404f462814265bc8bf9ab2f39a7a119325f52501bd487989a97a999f1fa54605
msgctxt "scenario3:scenario3_6C35B0D2_1AEF_4680_A1A4_3B4661C2E547"
msgid "⟪k:0⟫Ah..."
