msgctxt "scenario3:scenario3_5BB701E4_DD4A_498E_8FC8_1AF132DF6C84"
msgid "⟪k:0⟫⟪k:1⟫Who else could have written it?⟪k:2⟫It’s in her handwriting..."
msgstr "⟪k:0⟫⟪k:1⟫除了夫人还会有谁啊，⟪k:2⟫笔迹也是夫人的……"

#: scenario3:scenario3_4EDA082F_906A_43F4_94E5_04D1190033D6
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: b7e67a096bbcefd5b1a178a9af2aea85203749345a24184a6a6ec00ce284e483
#. default-sha256: f6be87bbab643c889f054eed8c0d364b2d38519e939265991665a0324461a537
msgctxt "scenario3:scenario3_4EDA082F_906A_43F4_94E5_04D1190033D6"
msgid "⟪k:0⟫⟪k:1⟫Why... ⟪k:2⟫Why?!⟪k:3⟫Why must she continue to betray me?!"
msgstr "⟪k:0⟫⟪k:1⟫为什么……⟪k:2⟫为什么……！⟪k:3⟫为什么那家伙总是这样背叛我！！"

#: scenario3:scenario3_A1AB147C_DC3A_44FA_B5BC_F5B6FE6F1D56
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: e2681ee787d35edb91f7812da8df9cb01783c63f1ed69935a86a10c27ff8ef40
#. default-sha256: 1b7732d4c1cf3fa79ca7e31d30fb6fbc10f35debe062f2f75d05e03403096c14
msgctxt "scenario3:scenario3_A1AB147C_DC3A_44FA_B5BC_F5B6FE6F1D56"
msgid "⟪k:0⟫Has she not taken enough already?!⟪k:1⟫What else could she possibly want from me?!"
msgstr "⟪k:0⟫还嫌不够吗——！⟪k:1⟫还想从我这里夺走什么才满足！"

#: scenario3:scenario3_97EBAC32_A89C_4B29_B468_333EE3FE3BB8
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: bc664db150ec08ab9ba63c6549ef0cc37d51a9a5840f0181078ce244a2245ac1
#. default-sha256: dda1271952dec9fde6d03d4bf1daa558ca35e070e8ef02f76aa5be32e0c8e7bd
msgctxt "scenario3:scenario3_97EBAC32_A89C_4B29_B468_333EE3FE3BB8"
msgid "⟪k:0⟫I told her to stay away from my gatherings!⟪k:1⟫I had the rose garden torn down!"
msgstr "⟪k:0⟫说过让她不要在聚会上露脸！⟪k:1⟫ 蔷薇园也毁掉了！"

#: scenario3:scenario3_94B079D8_7624_490E_8E12_1AA61EC4CD7E
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 35e3d41b5893cb0bbf2e8da28a4b48e7bf649c4f4e5328c59c8c978a46d4bc0d
#. default-sha256: 4e9dffb8386ca5ce45803b5660b8102078802780565a79d7dc568dcf95893090
msgctxt "scenario3:scenario3_94B079D8_7624_490E_8E12_1AA61EC4CD7E"
msgid "⟪k:0⟫And yet still... ⟪k:1⟫she finds other men—!"
msgstr "⟪k:0⟫可是，⟪k:1⟫还在，⟪k:2⟫和……其他男人……！"

#: scenario3:scenario3_4C875E8F_EAB6_42A4_96A3_49E3618C9C8C
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 9a1b3f2f8ccac0d70c1cf935397bb3a5125a227fedf276e1b44b319a44406458
#. default-sha256: 1c6c5ee9534ccdcb0e72765b9285395196437ac92a64a998e55fa461a376294d
msgctxt "scenario3:scenario3_4C875E8F_EAB6_42A4_96A3_49E3618C9C8C"
msgid ""
"⟪k:0⟫I warned her!⟪k:1⟫Told her it wouldn’t happen again!⟪k:2⟫That if she betrayed me one more "
"time, I’d kill her!"
msgstr "⟪k:0⟫都说过了，⟪k:1⟫不要背叛我……⟪k:2⟫⟪k:3⟫说过不要有第二次——否则就杀了她！！"

#: scenario3:scenario3_056B5CAF_3DF7_475B_9599_4F8E78478EFE
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: ed3a68a08360d08a41c2fcd511ab86b93b6e64c6ebfd1036a6af7c7b47513e4b
#. default-sha256: 6b137dfe2e5e2847fce8ce1925a2bdab7f22d1632df1780031ea85f2cf044eab
msgctxt "scenario3:scenario3_056B5CAF_3DF7_475B_9599_4F8E78478EFE"
msgid "⟪k:0⟫⟪k:1⟫Jacopo..."
msgstr "⟪k:0⟫⟪k:1⟫……雅各布……"

#: scenario3:scenario3_6EC9BC0C_6BBB_4442_9FEB_25A76E9167B2
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: bc1016ce33a0d296d18e959a1b0acce6111d712e5418ee3c3ca7cc085e9e902c
#. default-sha256: a5202265149978615f6bd3bd9ee0f701d87e7bd39588db07b7a20b2d4c111dad
msgctxt "scenario3:scenario3_6EC9BC0C_6BBB_4442_9FEB_25A76E9167B2"
msgid ""
"⟪k:0⟫⟪k:1⟫Out of my way, Maria! I have to talk to her!⟪k:2⟫Ask her what this letter’s about! Who "
"this man is!"
msgstr ""
"⟪k:0⟫⟪k:1⟫走开，⟪k:2⟫玛利亚！！⟪k:3⟫我要和那家伙谈谈！⟪k:4⟫这封信到底是怎么回事——这个男的到底是"
"谁！⟪k:5⟫我要问个清楚……！"

#: scenario3:scenario3_6B96DA7E_07C1_4CF3_A411_58AB52CF3395
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: b71615ab08b2ff302f33dd090e21289926e94298078b43dbf8c5c1f48279924a
#. default-sha256: ac369e9edab04038affb6018f83463f85f9d3f1f36645498b822e7658bbea120
msgctxt "scenario3:scenario3_6B96DA7E_07C1_4CF3_A411_58AB52CF3395"
msgid "⟪k:0⟫And depending on how she answers—"
msgstr "⟪k:0⟫根据回应，⟪k:1⟫把她——！"

#: scenario3:scenario3_39EC63E7_CD1C_4029_A26C_7E95139CD432
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 6fdea52f55c39ec3017da001927fb84b66a4929d459226304431853b7ac09f77
#. default-sha256: 793cd950f1da52e1507b23039cc79f014dccf0b269c3a342cf811ae7683b0f21
msgctxt "scenario3:scenario3_39EC63E7_CD1C_4029_A26C_7E95139CD432"
msgid "⟪k:0⟫⟪k:1⟫Hold it, Jacopo! Calm down!"
