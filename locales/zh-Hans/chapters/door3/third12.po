msgctxt "scenario3:scenario3_C36D05BF_1019_4FD0_A1BE_592FC25DA236"
msgid "⟪k:0⟫How... ⟪k:1⟫How did things end up this way?"
msgstr "⟪k:0⟫为什么……⟪k:1⟫会变成这样子呢……"

#: scenario3:scenario3_B160FB80_A524_4386_B4F3_E09D32BB5AD9
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: b1cfebe0e2ce3089ab493dbcfb3f4a959f6d0899c0a5d35be28088020abaee68
