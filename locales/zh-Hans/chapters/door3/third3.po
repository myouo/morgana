msgid "⟪k:0⟫⟪k:1⟫Why are you so intent on obtaining power?"
msgstr "⟪k:0⟫⟪k:1⟫你为什么，⟪k:2⟫这么想要获得更高的地位呢？"

#: scenario3:scenario3_4B9CADDC_7F83_43EC_A67A_85FA34646CEA
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: d5dbbb3545f57e19e7a8230a3b41a7a3f1d395425ed12473a00931a040fa27fc
