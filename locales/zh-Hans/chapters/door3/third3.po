msgctxt "scenario3:scenario3_007F1346_C85E_48E8_93A2_FDB14A468D04"
msgid "⟪k:0⟫⟪k:1⟫Your country?"
msgstr "⟪k:0⟫⟪k:1⟫国家……？"

#: scenario3:scenario3_E1EF9A59_4A8F_415D_A250_F06E12584AED
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 36ed24b47b26de8df61811ded7fd0c5b524180eb6b4aa3b15c6db3681ac4953b
