msgid "⟪k:0⟫⟪k:1⟫A..."
msgstr "⟪k:0⟫⟪k:1⟫……这是……"

#: scenario7:scenario7_9C229545_33D1_471B_BC3C_74EEADDDC7E9
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 506c60f2d60b2fc2b17b938b028079a805f9f4abf501f5e2cc86335b111f00f6
