msgctxt "scenario7:scenario7_3DC55A11_A712_4E8A_8838_C3E23C0B0603"
msgid "⟪k:0⟫I was... ⟪k:1⟫entirely alone."
msgstr "⟪k:0⟫这下……我彻底变成孤身一人了。"

#: scenario7:scenario7_482E3049_2539_49D9_B7CA_842612330E9C
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: f22df1168b0bd21a23962248a4b6bc3253c79e202d328901ba2320097965fcdb
