msgid "⟪k:0⟫No. That wasn’t it."
msgstr "⟪k:0⟫不是的，⟪k:1⟫并不是这样。"

#: scenario7:scenario7_3B2189D6_0FF1_4071_8148_E8C36D0D64A9
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 6ef96f2a421f246d02b9a586fe08bb38bbd77e1b3469cc9a6d287ca490bafc74
