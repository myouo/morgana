#: scenario7:scenario7_17FE593C_D11B_4B3A_9B4A_FF51BD304787
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 96e04fc1cfa5a651b64b79ea429a99d5bc585a1bc81111f12185ac5eee68054e
#. default-sha256: 76eae9c85f2433fdb35169e691d1def529cadb0d8f4115a1fa7e85de1d25e539
msgctxt "scenario7:scenario7_17FE593C_D11B_4B3A_9B4A_FF51BD304787"
msgid "⟪k:0⟫Now, I can make those men suffer a hell even worse than the one they put me through..."
msgstr "⟪k:0⟫那些让我坠入无间之渊的男人们……⟪k:1⟫⟪k:2⟫我要让他们体会到……"

#: scenario7:scenario7_7C059B14_A129_4954_80FC_3C436FFA9B93
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 3aacae7bd33100ca105a14ef2e7d7cefcfdefd9ae81b725b643ff1947870f09b
