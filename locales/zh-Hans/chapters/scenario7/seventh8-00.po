msgstr "⟪k:0⟫啊哈哈哈哈哈哈…………"

#: scenario7:scenario7_E057D1CB_B59B_439E_AE89_1CA6201F6CE0
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 73d7796d1e58b779467f891b3d965307e54afafee277118efb74c9c5edc003d7
#. default-sha256: c963bd24d4f19a810b98a2ea8949b3deb8539cefa9ccd3a02d6e658e31f6c9b7
msgctxt "scenario7:scenario7_E057D1CB_B59B_439E_AE89_1CA6201F6CE0"
msgid "⟪k:0⟫Oh, you poor dear. They locked you up here without telling you whose house it was?"
msgstr "⟪k:0⟫你连这都不知道，⟪k:1⟫就被关在这座洋馆里了？⟪k:2⟫⟪k:3⟫啊啊……真是个可怜的人……"

#: scenario7:scenario7_D110955E_8C94_4B5F_8B3B_023D2D661687
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: b862becbad218cdfd12f08218fafde2b7593158b791b305cf548e163e8d97cc5
#. default-sha256: 000d6b0871ef69cfecd4747b19b21837682852b95d115f451be07006cb75dabb
msgctxt "scenario7:scenario7_D110955E_8C94_4B5F_8B3B_023D2D661687"
msgid "⟪k:0⟫You sad, pathetic thing...⟪k:1⟫⟪k:2⟫Though that’s exactly the kind of person I needed."
msgstr "⟪k:0⟫真可怜……⟪k:1⟫不过我正需要你这样的人。"

#: scenario7:scenario7_021FDB46_4407_4465_A38D_7CB739227033
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 981d6ba85a8d2fc00525d8647912482e5f97b7ced5eea6a8ddc5f156f9a848b0
#. default-sha256: 825f8c53a421954b8b15e68053525db8c311cbc04d8786a68fb5e757918a271a
msgctxt "scenario7:scenario7_021FDB46_4407_4465_A38D_7CB739227033"
msgid "⟪k:0⟫You’re... ⟪k:1⟫You’re not the witch, are you...?"
msgstr "⟪k:0⟫……难道……⟪k:1⟫你真的是魔女吗……"

#: scenario7:scenario7_628FA3F9_73B9_45FC_9FBF_59CF1C8441D7
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 5357e1a1cfcb5d133573cb6fa5badc6448945a8ff0ab73ca326728c8a77200d5
#. default-sha256: 1cd8068b8c1925b496ee6ec03783c5869ee1f4d82f283af05359406f0974c76f
msgctxt "scenario7:scenario7_628FA3F9_73B9_45FC_9FBF_59CF1C8441D7"
