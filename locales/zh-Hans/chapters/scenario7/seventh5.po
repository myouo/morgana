msgctxt "scenario7:scenario7_D5201F50_0026_463D_ACA6_0B41AE96A802"
msgid "⟪k:0⟫⟪k:1⟫Go on, let’s hear it."
msgstr "⟪k:0⟫⟪k:1⟫嗯，⟪k:2⟫什么请求？⟪k:3⟫说说看。"

#: scenario7:scenario7_50A8EFA1_E5B5_46CF_BAFF_2E5A5D2666AC
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 1b005a87e52b262d471b4729efdf9363bfdb4a9ee8f3d2f4eed22dd2ccebff1f
#. default-sha256: 86c4923c786cc43180821fc59d621caf6ace624f684f7796c0c99e0dbac5b3f5
msgctxt "scenario7:scenario7_50A8EFA1_E5B5_46CF_BAFF_2E5A5D2666AC"
msgid "⟪k:0⟫⟪k:1⟫Do you mind if I... ⟪k:2⟫hold the horse’s reins?"
msgstr "⟪k:0⟫⟪k:1⟫可以让我……⟪k:2⟫握缰绳吗？"

#: scenario7:scenario7_CD4C7EE4_B103_480B_8DB0_1A19F8854021
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 74ecac159c77e2eefb3576cd959be1d64b2f3136bd01455fabdd3cc97d953384
#. default-sha256: d0fb294a80eecaf4b306e8cd3f5f4c1e99bce44f3f3e341b598b33c5e4fbdebf
msgctxt "scenario7:scenario7_CD4C7EE4_B103_480B_8DB0_1A19F8854021"
msgid ""
"⟪k:0⟫⟪k:1⟫Oh, that’s all? By all means.⟪k:2⟫⟪k:3⟫I’ll be there behind you to make sure nothing "
"happens, so have at it."
msgstr "⟪k:0⟫⟪k:1⟫怎么，⟪k:2⟫想握缰绳吗。⟪k:3⟫当然可以。⟪k:4⟫⟪k:5⟫我在后面扶着你，⟪k:6⟫放心地骑吧。"

#: scenario7:scenario7_FE8E2917_B186_4CDB_AABC_5C3944D5B965
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: b2254125f6af6a4642174decb996223c0bd468f7d73cb941a75e82e51cbe954a
#. default-sha256: d6f3deaabf13ed82df38749ccad9c77bb0c99452a94214e35a3b198daf8703a5
