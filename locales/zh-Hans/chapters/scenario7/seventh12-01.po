#: scenario7:scenario7_090A51F1_861C_4F72_B0D5_474947B3F7E3
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: d34f27714e2dacbc04879c852c67a32d49f81d284e7c93b35266858e5e24cdd4
#. default-sha256: d0682a4c5b31831fc132b4ed288f7c39665ac3d981073cd32e3f73b5f1d235aa
msgctxt "scenario7:scenario7_090A51F1_861C_4F72_B0D5_474947B3F7E3"
msgid ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫⟪k:4⟫⟪k:5⟫⟪k:6⟫⟪k:7⟫⟪k:8⟫⟪k:9⟫⟪k:10⟫⟪k:11⟫⟪k:12⟫⟪k:13⟫⟪k:14⟫⟪k:15⟫⟪k:16⟫⟪k:17⟫"
"⟪k:18⟫⟪k:19⟫⟪k:20⟫⟪k:21⟫⟪k:22⟫...And so, my life came to an end."
msgstr ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫⟪k:4⟫⟪k:5⟫⟪k:6⟫⟪k:7⟫⟪k:8⟫⟪k:9⟫⟪k:10⟫⟪k:11⟫⟪k:12⟫⟪k:13⟫⟪k:14⟫⟪k:15⟫⟪k:16⟫⟪k:17⟫"
"⟪k:18⟫⟪k:19⟫⟪k:20⟫⟪k:21⟫⟪k:22⟫……这就是，⟪k:23⟫我的结局。"

#: scenario7:scenario7_5D8C55D5_BF96_41AE_A46B_B7820CB71569
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 25461217837166ecd1aa449e6a978f8e51818205a79df7ad7d9acf6e7d18d067
#. default-sha256: 852658365ddb6d2aa4bf3f56df3b575d89f6b04966189bd5819d40b30720a7fd
msgctxt "scenario7:scenario7_5D8C55D5_BF96_41AE_A46B_B7820CB71569"
msgid "⟪k:0⟫But that wasn’t the end of the story."
msgstr "⟪k:0⟫但是，⟪k:1⟫还没有……结束。"

#: scenario7:scenario7_C51746E0_7E56_4329_86EF_EDB666693DA2
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: f12dae9cd20efe6645e6634d21799c5881f11e4dfc45da4b953ff7b9fad6e920
#. default-sha256: 04e5efc417b83a912f7631f2193e93da6b6de6de1dde38f63a876ccda18a7645
msgctxt "scenario7:scenario7_C51746E0_7E56_4329_86EF_EDB666693DA2"
msgid ""
"⟪k:0⟫I don’t know if what comes next could be called “my” story,⟪k:1⟫⟪k:2⟫but memories of these "
"events linger in my soul."
msgstr "⟪k:0⟫虽然不知道能不能将其称为后续……⟪k:1⟫⟪k:2⟫我留有灵魂的记忆。"

#: scenario7:scenario7_3DE6F1A1_7E45_4823_BB18_DFE93D6A6332
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: f4471f70001fc411983b146602e702d674959395939aa71c8c2ea086e3854f38
#. default-sha256: 648f5a8aaf3adc210eaae19c745312aa320fef9838811314fb44d41b43b7437f
msgctxt "scenario7:scenario7_3DE6F1A1_7E45_4823_BB18_DFE93D6A6332"
msgid ""
"⟪k:0⟫How could I have ever imagined...⟪k:1⟫⟪k:2⟫that I would be made to witness my own misery "
"even in death?"
msgstr "⟪k:0⟫又有谁能料到……⟪k:1⟫即便失去性命，⟪k:2⟫也不得不观看那绝望的光景呢……"

#: scenario7:scenario7_8C20439B_C5B4_4D4A_AFAB_5CCD52C9ED90
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: abee2533b0d19566f564ed4e5f948ddabd462abd9c6c40a454caa48491d944e0
#. default-sha256: a1aac92e8de474ff42b0c2829f577a2d1895bac31157ebce9009ce95d53cdb11
msgctxt "scenario7:scenario7_8C20439B_C5B4_4D4A_AFAB_5CCD52C9ED90"
msgid "⟪k:0⟫And my soul—⟪k:1⟫⟪k:2⟫evidently still bound to my flesh—"
msgstr "⟪k:0⟫我的肉体和灵魂或许还有联系——⟪k:1⟫⟪k:2⟫不管我如何拒绝，⟪k:3⟫灵魂也会被肉体牢牢拴住……"

#: scenario7:scenario7_A3D92C5D_C2DD_4CE0_8512_FCF7FE870B04
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 003359ffa3009ffa2351f4a2179d829ad03ea053085755c7138eba8128d2bc0a
#. default-sha256: 1d28c8dffa069879d5e683f26704b4018405ed9a40231e8fe8a73893d8619c3d
msgctxt "scenario7:scenario7_A3D92C5D_C2DD_4CE0_8512_FCF7FE870B04"
msgid "⟪k:0⟫was dragged along with it, against my will, down to the nearby village."
msgstr "⟪k:0⟫我和自己的尸体一同前往那座村庄。"

#: scenario7:scenario7_E61D0C8B_E817_4C49_8BCD_986BDDA99580
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 9ba5320a31a0250abff53715c99d5c161aa1352cf7b485d75e28a923408b96e0
#. default-sha256: 2a759d8c3bf8c83075d9cdae64fe678d66d6377263c696490bb4ba0a0472463e
msgctxt "scenario7:scenario7_E61D0C8B_E817_4C49_8BCD_986BDDA99580"
msgid "⟪k:0⟫⟪k:1⟫The knights have returned from their holy quest!"
msgstr "⟪k:0⟫⟪k:1⟫骑士大人们凯旋归来了！"

#: scenario7:scenario7_4BC5D94C_29C0_4512_8464_CFCAC63C2BC4
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 1a93be4666ba35dc5bd3914ddba0752eefe24c8389e88248ad2af10bf4f1f6ee
#. default-sha256: d02ef664d14af1c9d158e84edacce867a4ff5b66acdeac07f63ac0fcf3f7a854
msgctxt "scenario7:scenario7_4BC5D94C_29C0_4512_8464_CFCAC63C2BC4"
msgid "⟪k:0⟫⟪k:1⟫Oh, how we’ve awaited your arrival!"
msgstr "⟪k:0⟫⟪k:1⟫啊啊骑士大人！"

#: scenario7:scenario7_CB3ED887_927B_45F4_AD8F_4F1D0214AA0F
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 713497128b604ede6c9385f086b2bcd944e1e39b68df4ad65d4dd96d49102034
#. default-sha256: 97078be1beb4bea93939994bffb8a1db460d11f3a905f46cf47ec5073f5d499e
msgctxt "scenario7:scenario7_CB3ED887_927B_45F4_AD8F_4F1D0214AA0F"
msgid "⟪k:0⟫⟪k:1⟫How glorious it is to see you!"
msgstr "⟪k:0⟫⟪k:1⟫我们等您很久了！"

#: scenario7:scenario7_1E29A1D1_0BEE_452D_97A6_C04B078CD2D4
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 2ed3b05320d2fe184647181591b45e0cbca75ae22c66d8fce3656dcf7317b981
#. default-sha256: 7e2d5691e0c35a21b444ad59b9491ebe28015fffcd2566a83c90fa7b92839ea7
msgctxt "scenario7:scenario7_1E29A1D1_0BEE_452D_97A6_C04B078CD2D4"
msgid ""
"⟪k:0⟫Waiting for us there was a cluster of villagers.⟪k:1⟫⟪k:2⟫A large cross lay on the ground in "
"the center of the square."
msgstr "⟪k:0⟫迎接我们的，⟪k:1⟫是聚集在广场上的村民们。⟪k:2⟫⟪k:3⟫广场中央横放着一个巨大的十字架。"

#: scenario7:scenario7_A1924AEC_E6D6_462F_BDE5_51024E31F01B
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 8f84806994cc75dfcd8169b2b3355cf9f43f11f2d9edf4d59e0fc0a8c8371e5d
#. default-sha256: fbc564d6e705afcc99f735bbcf908f770fd68b621e61282508398fc4681be977
msgctxt "scenario7:scenario7_A1924AEC_E6D6_462F_BDE5_51024E31F01B"
msgid ""
"⟪k:0⟫Holding torches, they formed a crowd around the knights, several of them familiar faces."
msgstr "⟪k:0⟫在围着骑士们、⟪k:1⟫手里拿着火把的民众之中，⟪k:2⟫有几张面熟的脸。"

#: scenario7:scenario7_F52A9436_A594_40DB_8213_25E1D487198D
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 82678a5dffa147217534a856af5b904f3f46fe009a1ca7b4b70c2b90708ada7c
#. default-sha256: 6ee4ca1667035356cf0df527229d05617c712cb34f0ba645deeefaf7a0dd531f
msgctxt "scenario7:scenario7_F52A9436_A594_40DB_8213_25E1D487198D"
msgid ""
"⟪k:0⟫No longer shall we live in fear of the curse befalling us!⟪k:1⟫⟪k:2⟫Eternal peace is assured!"
msgstr "⟪k:0⟫这下再也不会有诅咒降到村里了！⟪k:1⟫村子得到了永久的安宁！"

#: scenario7:scenario7_16B2FCE2_C477_4BD9_8C7D_E88D8A4AF579
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 8fef28ffa84d1ec5cc2cecc57b501f384a66592b21afd93ba55ac782fefcf41e
#. default-sha256: 6c31a79123bd4640e04ade6953f8e39ab344abac5c20addcae26e529cd1b3c60
msgctxt "scenario7:scenario7_16B2FCE2_C477_4BD9_8C7D_E88D8A4AF579"
msgid "⟪k:0⟫Why, then... ⟪k:1⟫were they acting like I was at fault?"
msgstr "⟪k:0⟫然而，⟪k:1⟫为什么……一切都要怪到我头上呢？"

#: scenario7:scenario7_4CEDA84C_E7DE_4F7A_8E6C_4075FF9ED2EC
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 0c2e0014845c6ca25a6a4f0eb4b1d686029d733c3d259cfbb2cd5e7decd7ac68
#. default-sha256: 4b527440bb8e2ffd13f5c88cf693734727f0c4e2615ade56b2ea76b0e0265fc7
msgctxt "scenario7:scenario7_4CEDA84C_E7DE_4F7A_8E6C_4075FF9ED2EC"
msgid "⟪k:0⟫Why was I the sinner, and why did I need to be judged?"
msgstr "⟪k:0⟫为什么我必须承担罪名，⟪k:1⟫必须被制裁呢？"

#: scenario7:scenario7_2A266E31_4BB9_464A_9B6B_7551BF55087C
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 9ce518c33ff151dd25bad40577c5df177f0965c9c09976f7fef29d98491c895c
#. default-sha256: d4cc472a078284db98d4bed1416836cc0503d794a31822cbf482458a34e4f9bf
msgctxt "scenario7:scenario7_2A266E31_4BB9_464A_9B6B_7551BF55087C"
msgid ""
"⟪k:0⟫My soul trembled at the overwhelming fervor consuming the crowd, ⟪k:1⟫their zealous desire "
"to see judgment cast."
msgstr "⟪k:0⟫在审判魔女的热烈氛围中——⟪k:1⟫⟪k:2⟫我的心在颤抖。"

#: scenario7:scenario7_4055B4D2_8A2F_48DF_801C_6AA7C0D5ADC8
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: d30ad46a3101d22376685ed13de7fa1f0044cd4a6f9dbce6d3400b057ba9e9b7
#. default-sha256: 8a54f3291f89cef9efe776c0c9ee35b3dcbc2e34e6bb9998f0f89514ec31f942
msgctxt "scenario7:scenario7_4055B4D2_8A2F_48DF_801C_6AA7C0D5ADC8"
msgid "⟪k:0⟫Please don’t do this, Didier...⟪k:1⟫⟪k:2⟫Please, hear my voice..."
msgstr "⟪k:0⟫哥哥……⟪k:1⟫求你了，⟪k:2⟫请住手……⟪k:3⟫⟪k:4⟫请听听我的乞求……"

#: scenario7:scenario7_90CACC1B_FB5C_4F6A_A11B_C62ACBF86CA5
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 994c92205883876bb4734d1fbf62e8e198ec52bd006c6d745ae9d3ed2e97d745
#. default-sha256: b1d9540b565eb3f9aa80433f19c0e1c6a24e851af00b3c886b8c821d85888c2e
msgctxt "scenario7:scenario7_90CACC1B_FB5C_4F6A_A11B_C62ACBF86CA5"
msgid "⟪k:0⟫Please, tell me ⟪k:1⟫you⟪k:2⟫, at least, don’t think I did those things..."
msgstr "⟪k:0⟫哥哥，⟪k:1⟫请你明白……⟪k:2⟫⟪k:3⟫我只求你能明白……"

#: scenario7:scenario7_1809491C_BCB6_4470_BD73_A9E1B6453A66
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: b85c053ca1f321872489a41bfea6565ed2ca901e901c6e625c20bc082dd7d7ef
#. default-sha256: f0a2c1709a32fb7b4a4deda08a2a568804d39dcf0635e4156dc96a0a27554011
msgctxt "scenario7:scenario7_1809491C_BCB6_4470_BD73_A9E1B6453A66"
msgid "⟪k:0⟫Don’t put me on that cross...⟪k:1⟫⟪k:2⟫If it was Mother who sold me out to the Church,"
msgstr "⟪k:0⟫请不要把我的尸体钉在十字架上……⟪k:1⟫⟪k:2⟫如果母亲将我作为魔女出卖给教会的话——"

#: scenario7:scenario7_748FDB2D_891F_4063_B06B_CA7A27FC96BC
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: d73e1c5cba831c436b5b1135bcfd9496ee6ecf86ae19103fbc3523e031d92483
#. default-sha256: dcde5370f064a86ac9135f069449b6e959d2b375db645815f41a54a8956b552f
msgctxt "scenario7:scenario7_748FDB2D_891F_4063_B06B_CA7A27FC96BC"
msgid ""
"⟪k:0⟫The nails and rope for the crucifixion are here.⟪k:1⟫⟪k:2⟫We would have you, O knight, "
"deliver the Lord’s judgment unto this vile witch!"
msgstr "⟪k:0⟫我们准备好了铁钉和麻绳。⟪k:1⟫⟪k:2⟫骑士大人……⟪k:3⟫请你亲手给那个魔女下达最后的裁决！"

#: scenario7:scenario7_FE7C6CF8_459E_46AF_AA1C_47F64264FA6A
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 2820cc9a6dd90c1bc1dd71156265651bb7652e2c9da0b92479a04fd7ca83c4e3
#. default-sha256: 1dcdc3383657f9d3b9f1ea100dba6d27f358814198e8bc1383c15e88d1010cfb
msgctxt "scenario7:scenario7_FE7C6CF8_459E_46AF_AA1C_47F64264FA6A"
msgid "⟪k:0⟫Didier..."
msgstr "⟪k:0⟫……哥哥……"

#: scenario7:scenario7_83319B1E_A3C6_4451_9E94_294CD95D46DE
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: d09b9391f94c6713a03ee89e935df9974015d74c985bde99c34af9872441081c
#. default-sha256: e4996a888450f0a3de79aea77b36b58137629693cf22c4a69d8a71f64b636f73
msgctxt "scenario7:scenario7_83319B1E_A3C6_4451_9E94_294CD95D46DE"
msgid "⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫Crucifixion!"
msgstr "⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫钉上十字架！"

#: scenario7:scenario7_4307D535_FE8B_4BE6_BCDC_93F1F1C3CF34
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: d09b9391f94c6713a03ee89e935df9974015d74c985bde99c34af9872441081c
#. default-sha256: e4996a888450f0a3de79aea77b36b58137629693cf22c4a69d8a71f64b636f73
msgctxt "scenario7:scenario7_4307D535_FE8B_4BE6_BCDC_93F1F1C3CF34"
msgid "⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫Crucify it!"
msgstr "⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫钉上十字架！"

#: scenario7:scenario7_BE5EED1B_42A0_45A3_A6C7_15DD67C76C1B
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: ec6e603be118588f685b7c0049143992db564e3f98f7fc266fd2a6278a9573ae
#. default-sha256: deaa5faae98393c18b4207bfc6d2d84fd513c037385c924588e21bcb834a5bef
msgctxt "scenario7:scenario7_BE5EED1B_42A0_45A3_A6C7_15DD67C76C1B"
msgid ""
"⟪k:0⟫My brother lowered my corpse to the ground and began removing my clothing, ⟪k:1⟫and in that "
"very moment, I realized the purpose of hanging someone from a cross."
msgstr ""
"⟪k:0⟫……哥哥将我的尸体放在地面上，⟪k:1⟫朝我的衣服伸出手。⟪k:2⟫⟪k:3⟫直到那一瞬间，⟪k:4⟫我才理解钉上"
"十字架的真正意思——"

#: scenario7:scenario7_B88FDF38_E3ED_4B5C_B13B_53B336DCF166
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 8dd9e987115655c222d332f8b2ad1a60d0ddb67c612b67c52e1d9693cc73de48
#. default-sha256: ed1ab9a2353842ad8978f486a53f3e485284aaf0c5c8404caee1a244407bc84c
msgctxt "scenario7:scenario7_B88FDF38_E3ED_4B5C_B13B_53B336DCF166"
msgid "⟪k:0⟫Overwhelmed by hopelessness, tears streamed down my face."
msgstr "⟪k:0⟫莫大的绝望令我泪如雨下。"

#: scenario7:scenario7_F330EC48_B442_43BB_867C_F9A5674ECE91
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 247cbad90e1ba9f236c7a2fc1136d6078004a2c320a400a9fb34da04cfff922b
#. default-sha256: e8fee1e192aaab86281af999f19778116bba6d1efc24be5642ae4af6b428571f
msgctxt "scenario7:scenario7_F330EC48_B442_43BB_867C_F9A5674ECE91"
msgid "⟪k:0⟫don’t do it!"
msgstr "⟪k:0⟫……放过我……！！"

#: scenario7:scenario7_BFF95DC4_C5B9_4167_A118_3B8955B2FC84
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 472dfd0b9ff287a95e19159f92e5ef8fac6102479af6fd18df6c08a744af5668
#. default-sha256: cafefcd02f5fc898472659b6d6bc15e635589cede3ba735fb4d6a383bfb0a718
msgctxt "scenario7:scenario7_BFF95DC4_C5B9_4167_A118_3B8955B2FC84"
msgid ""
"⟪k:0⟫For a brief moment, an unpleasant silence spread through the crowd. ⟪k:1⟫The erratic "
"crackling of their torches was the only sound that could be heard in the square."
msgstr "⟪k:0⟫周围霎时弥漫起诡异的气氛。⟪k:1⟫⟪k:2⟫四下里鸦雀无声，⟪k:3⟫只有火把烧得劈啪作响。"

#: scenario7:scenario7_00E0D90C_518C_432E_A046_E7253A8B1690
