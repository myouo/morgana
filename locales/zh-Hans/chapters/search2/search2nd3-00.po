msgid "⟪k:0⟫⟪k:1⟫“to keep her church from collapsing.⟪k:2⟫⟪k:3⟫To keep her world from collapsing.”"
msgstr "⟪k:0⟫⟪k:1⟫「所以只有牺牲你了」"

#: search2:search2_513CF30B_D0B2_4BF0_81E9_01C712E15CA3
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: eb0501797dbc94a769aa88b6b9646e434209c9e01768e4667bc627e9a78c994c
