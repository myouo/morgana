msgctxt "search2:search2_16F47D88_4BCD_468F_8FE9_489758DEDEC8"
msgid ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫⟪k:4⟫⟪k:5⟫⟪k:6⟫⟪k:7⟫⟪k:8⟫⟪k:9⟫⟪k:10⟫⟪k:11⟫⟪k:12⟫⟪k:13⟫⟪k:14⟫⟪k:15⟫⟪k:16⟫⟪k:17⟫"
"⟪k:18⟫Without warning,"
msgstr ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫⟪k:4⟫⟪k:5⟫⟪k:6⟫⟪k:7⟫⟪k:8⟫⟪k:9⟫⟪k:10⟫⟪k:11⟫⟪k:12⟫⟪k:13⟫⟪k:14⟫⟪k:15⟫⟪k:16⟫⟪k:17⟫"
"⟪k:18⟫突然——"

#: search2:search2_E5541F19_CBBB_4C58_818C_CC5A2401D251
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 4891836784739f8cc7f68b90114d54c251bf217ec537c5bac0f2a3f5693b2268
#. default-sha256: 8a112b770bc5f1baef20b3a48a20fe80c7343243a772d5102fd20eec133f02fc
msgctxt "search2:search2_E5541F19_CBBB_4C58_818C_CC5A2401D251"
msgid "⟪k:0⟫without any time to prepare, the darkness drains away."
msgstr "⟪k:0⟫毫无前兆地，⟪k:1⟫眼前的世界消散了。"

#: search2:search2_C21895CE_0E48_4EC9_918C_4252AD916AAB
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 68eb01527c426f309859f3000cfcec8dde901d6c1fbb020934a95bf116053b5d
#. default-sha256: 1cbe99253c7e5125bf950f79998d5d61484e1e636ddc107debaffe6fa50b4b0a
msgctxt "search2:search2_C21895CE_0E48_4EC9_918C_4252AD916AAB"
msgid ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫The world fades in and out of view, giving way to very real images of a past I "
"never lived."
msgstr "⟪k:0⟫⟪k:1⟫⟪k:2⟫在闪烁的视界中——⟪k:3⟫我没经历过的光景，⟪k:4⟫伴随着现实感浮现、⟪k:5⟫又消失。"

#: search2:search2_78B84E7B_419B_420D_9137_54755F733266
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 6de6ed76f9c37905b98989f0be32ea29d0e51a09ea8a1273045cedb79e6618c2
#. default-sha256: 2e61e29f18dd4649f4bada1cd0bf4ad3deb685564988c7788191a17e08f484eb
