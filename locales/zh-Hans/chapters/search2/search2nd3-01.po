msgctxt "search2:search2_D1457BE5_C85C_468F_8ACF_0338463EBFED"
msgid "⟪k:0⟫Rgh... ⟪k:1⟫ngh... ⟪k:2⟫gggh!"
msgstr "⟪k:0⟫……！⟪k:1⟫呜⟪k:2⟫……呃……！！"

#: search2:search2_02897E03_ADEA_4850_B4E8_EF06E8054C40
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 93065e2c120d04fbfe8e30dffaea1b06b0d4d3a2ec1147b14bae221ed123aaee
#. default-sha256: 9365953f2e22e07e3a64ebdfc6500d025bd6a1c9c9a5206b3ce54b13f2f4b974
msgctxt "search2:search2_02897E03_ADEA_4850_B4E8_EF06E8054C40"
msgid "⟪k:0⟫But when my mouth opens to vomit, blood pours into it."
msgstr "⟪k:0⟫但是，⟪k:1⟫我正想张嘴呕吐的时候，⟪k:2⟫不知是谁的血，⟪k:3⟫毫不留情地喷到了我的嘴里。"

#: search2:search2_6A45F86A_347A_4152_8DFF_AE847CA7BED5
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: e944f0f1254d1e8b3ddc1f87d97c78e3fde9a07917f9222d8e4db2e963ec66b3
#. default-sha256: 9a8f9e41de083ed21ce2502fa16fcadf102c251602237fa67c65bc69f2baae94
msgctxt "search2:search2_6A45F86A_347A_4152_8DFF_AE847CA7BED5"
msgid ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫⟪k:4⟫⟪k:5⟫⟪k:6⟫⟪k:7⟫⟪k:8⟫⟪k:9⟫⟪k:10⟫⟪k:11⟫⟪k:12⟫⟪k:13⟫Ah, ⟪k:14⟫aah, ⟪k:15⟫"
"aaaaagh...!⟪k:16⟫⟪k:17⟫Ngh... ⟪k:18⟫Let go of me!"
msgstr ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫⟪k:4⟫⟪k:5⟫⟪k:6⟫⟪k:7⟫⟪k:8⟫⟪k:9⟫⟪k:10⟫⟪k:11⟫⟪k:12⟫⟪k:13⟫啊，⟪k:14⟫啊啊啊，⟪k:15⟫"
"啊啊啊………！⟪k:16⟫……为、⟪k:17⟫为什么……！！"

