msgctxt "search2:search2_C3C31414_3C27_45F6_A85E_DC497DD51F33"
msgid "⟪k:0⟫⟪k:1⟫⟪k:2⟫“Why... I never wanted her to die...⟪k:3⟫⟪k:4⟫⟪k:5⟫Was she not eating?!”"
msgstr "⟪k:0⟫⟪k:1⟫⟪k:2⟫「为什么……明明没打算……杀她的……⟪k:3⟫⟪k:4⟫⟪k:5⟫⟪k:6⟫　她没有……吃东西吗！？」"

#: search2:search2_5EF2B737_0293_40B2_83B5_54BF14C686A0
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 57639a7e334cd9383f43f2df4ef2d83c043aea2aa9e77afb1b02ef0903063a45
