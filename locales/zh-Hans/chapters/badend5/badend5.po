msgctxt "badend5:badend5_6351FB7A_66F2_4D5F_92D5_D0504CA5F338"
msgid "⟪k:0⟫Is something the matter, Michel?"
msgstr "⟪k:0⟫……米歇尔……？⟪k:1⟫你怎么了……？"

#: badend5:badend5_722EB74A_896C_4447_842A_63300AF6F85E
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 242f83879e2d18e06ee5b8afa08e08718b62cc3057e20ae0ef1b6a0040479fa5
