#: badend5:badend5_BBEF13A2_BB0F_4A79_B501_E9A68ED3ECA9
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: ccb85d1e865dbf0cbd38d5eb70a059135b149530e1783fc5c1b3eff0ae5b676e
#. default-sha256: cd7a8082c2545f6cf7fde41be048e13aa4424312634cca4770f2fc76bfaeb799
msgctxt "badend5:badend5_BBEF13A2_BB0F_4A79_B501_E9A68ED3ECA9"
msgid ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫⟪k:4⟫⟪k:5⟫⟪k:6⟫⟪k:7⟫⟪k:8⟫⟪k:9⟫⟪k:10⟫⟪k:11⟫⟪k:12⟫⟪k:13⟫⟪k:14⟫⟪k:15⟫⟪k:16⟫"
"You’ve made the right decision, Michel."
msgstr ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫⟪k:4⟫⟪k:5⟫⟪k:6⟫⟪k:7⟫⟪k:8⟫⟪k:9⟫⟪k:10⟫⟪k:11⟫⟪k:12⟫⟪k:13⟫⟪k:14⟫⟪k:15⟫对……⟪k:16⟫这"
"样就好了，⟪k:17⟫米歇尔。"

#: badend5:badend5_83564003_4394_490F_B68B_0F69DF183169
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 3ed9907c827d47f4a6c4875e336f54af78827b69519502752f527b49145c54be
#. default-sha256: b29e9e2cbe626bc7cf0cba8bfed834388f05dc0324d26a22529f6322add525f6
msgctxt "badend5:badend5_83564003_4394_490F_B68B_0F69DF183169"
msgid "⟪k:0⟫Your tragic tale has finally come to an end."
msgstr "⟪k:0⟫这样以来——你的辛酸历程也可以画上句号了。"

#: badend5:badend5_B76F5D6E_10F3_4739_9D24_003030A012AB
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 1d04f69b42f5bab83fc0ddf3337c964291fb574f9cb550e039395e10134f16e3
#. default-sha256: 9e8916b464cb9b53253c829ad70cc3b91cb6fb00b83e53ff84e510667661964f
msgctxt "badend5:badend5_B76F5D6E_10F3_4739_9D24_003030A012AB"
msgid ""
"⟪k:0⟫You’re free from the grip of this cursed mansion—⟪k:1⟫⟪k:2⟫free to begin your life anew."
msgstr "⟪k:0⟫然后，⟪k:1⟫你就可以从这被诅咒的馆中解放——⟪k:2⟫⟪k:3⟫迎来崭新的人生……"

#: badend5:badend5_B5231881_9804_4A29_9A8D_C27497A519D2
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 3f63f4fb77f7918caefa69c71884b5d3cc9757cc387e7e9c228b0f0ae5df7717
#. default-sha256: 3486cd6eb2605b958fae3aa3c5e1e32ba49d53304774b049d0cae18852f984d4
msgctxt "badend5:badend5_B5231881_9804_4A29_9A8D_C27497A519D2"
msgid "⟪k:0⟫I wish you a wonderful life,"
msgstr "⟪k:0⟫那肯定是——充满着光芒的，⟪k:1⟫美妙的人生吧。"

#: badend5:badend5_D76E6452_7102_4582_A162_5866DDAB8A55
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 213db08e77451b6802d8944ecf0c3f9adbf1bfe44ca8bfc70c9b8725e9be7c92
#. default-sha256: 6dbe27b1d5cc0fe2cbac9db15a50c0a4eb877ead8cb5c4d5349833b7aa889ff9
msgctxt "badend5:badend5_D76E6452_7102_4582_A162_5866DDAB8A55"
msgid "⟪k:0⟫richly fulfilling and abounding in light."
msgstr "⟪k:0⟫我……⟪k:1⟫衷心地祈祷你能拥有美好的人生。"

#: badend5:badend5_60370D30_8D56_42CF_B457_4881616FC1D7
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 3922e40acac24ac27971e7c5fa9ce96e8f3c51ff87a96ff38ce9b83cc66b8d30
#. default-sha256: bab75cb34715feb323e204e74166e7bf6705c233e7db89afc0ec743e7dd3b841
msgctxt "badend5:badend5_60370D30_8D56_42CF_B457_4881616FC1D7"
msgid ""
"⟪k:0⟫For you, my dear friend, I will not cast a curse,⟪k:1⟫⟪k:2⟫but give you my utmost blessing."
msgstr "⟪k:0⟫为我亲爱的友人所献上的绝非诅咒——⟪k:1⟫⟪k:2⟫而是祝福的祈愿。"

#: badend5:badend5_7BEEFB39_D103_4CE7_A33F_220A478E40E8
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: cf274c7d67e0bbf8354fb19724d93d398c0b6286f4684a612e094874ec8a3395
#. default-sha256: d02989f0a4281aaba62e649af9c739240e481475646ac17d289b90b0d401df39
