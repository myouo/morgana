msgid "⟪k:0⟫............"
msgstr "⟪k:0⟫…………"

#: badend5:badend5_97113EAB_1C5C_404C_959A_3651C60A21A5
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 663c7a851f4768a987dd29d02f1172e0acbce0da170768f2bd0f5965d629204d
#. default-sha256: ed3804a57ee406427e0721cbe39f6a920cdfb48da55fe1e9b1d2c9ab5ef748f4
msgctxt "badend5:badend5_97113EAB_1C5C_404C_959A_3651C60A21A5"
msgid "⟪k:0⟫It was a day just like any other."
msgstr "⟪k:0⟫——同往常一样，⟪k:1⟫日常的光景。"

#: badend5:badend5_16E70DB7_800A_4AB5_8915_E9E4B83CA6A1
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: e06d63c9bfc8289f90f051d63dbc58365aa16d289530bf5829794367309e769d
#. default-sha256: 73613457320f95ac172dfd5628c53701b92fb0e8ac5aec89020be6f268245a69
msgctxt "badend5:badend5_16E70DB7_800A_4AB5_8915_E9E4B83CA6A1"
msgid ""
