msgid "⟪k:0⟫...Huh?"
msgstr "⟪k:0⟫………哎………"

#: badend5:badend5_F770B190_B8F6_499E_8CEC_B78F26A93231
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: b6b039933e1eac0f5dc3a908965bb1672c8392e3a1e77839cffe2869e2b2e2ea
#. default-sha256: 0a814059e7ebf82c7dbb2ab2f65f1e1635fc4ce41268bda8f66db0825f17700e
msgctxt "badend5:badend5_F770B190_B8F6_499E_8CEC_B78F26A93231"
msgid ""
"⟪k:0⟫I’ve been trying to get your attention for some time,⟪k:1⟫⟪k:2⟫but you were just staring off "
"into the distance."
msgstr "⟪k:0⟫总觉得，⟪k:1⟫你看起来很恍惚呢……⟪k:2⟫⟪k:3⟫我……⟪k:4⟫叫了你好几次了哦……？"

#: badend5:badend5_0011E79A_AD44_4DF5_AAC0_047855618F3F
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: cf274c7d67e0bbf8354fb19724d93d398c0b6286f4684a612e094874ec8a3395
