msgid "⟪k:0⟫............"
msgstr "⟪k:0⟫…………"

#: badend5:badend5_5D7A5D26_0D02_4F27_98DD_7C5277A389E1
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 749e04507ff8386e7a0b2615fbeb641bf2e13110cf828729b2352d047f368580
#. default-sha256: f816628058fc5be021bb0fbb7077962a3f7578e2929b6ea6a7cb41aedfa53f02
msgctxt "badend5:badend5_5D7A5D26_0D02_4F27_98DD_7C5277A389E1"
msgid ""
"⟪k:0⟫Farewell, Michel.⟪k:1⟫⟪k:2⟫Until our souls cross paths once more⟪k:3⟫in the boundless sphere "
"of fate."
msgstr "⟪k:0⟫永别了，⟪k:1⟫米歇尔。⟪k:2⟫⟪k:3⟫——我与你的灵魂，⟪k:4⟫再也不会相遇了吧。"

#: badend5:badend5_DEE888BB_381A_408C_97B0_38685773FEBA
