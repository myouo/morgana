#: badend5:badend5_121A7CDC_3548_4519_9C0D_1EACDCD8F100
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 428a1bd01005ad78b2a4bddfe83e941b103835e4bf343515828782d7aed56314
#. default-sha256: 22e28da30c9c3026677471b8a972e3306677bee0338841fb50cd5bbe6ff5a87c
msgctxt "badend5:badend5_121A7CDC_3548_4519_9C0D_1EACDCD8F100"
msgid "⟪k:0⟫Oh, ⟪k:1⟫um, ⟪k:2⟫sorry. I’m fine."
msgstr "⟪k:0⟫啊啊……⟪k:1⟫没什么……⟪k:2⟫抱歉。"

#: badend5:badend5_14843988_FD1C_4853_853A_52A5802A150B
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: e5e8b066a9aee7740f14715b5f0528785b0b177920635a086c524325389421ac
#. default-sha256: 72f86cd58f7d722e5f600cdc5859fa7e52de86a62adc065e57b06ecce6cf8379
msgctxt "badend5:badend5_14843988_FD1C_4853_853A_52A5802A150B"
msgid "⟪k:0⟫What were... ⟪k:1⟫you saying, again?"
msgstr "⟪k:0⟫……那个……⟪k:1⟫我们刚才在说什么来着……"

#: badend5:badend5_22A3A367_B50D_46BE_8D2A_00044CB8B667
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 79f6635ecd259524d8ffbfd1666a756c077a7034318bb324769e8f836f9b19d5
#. default-sha256: 657705e20fea108b18e468c533f4047217ea0a3041763599aa9263def3a454cc
msgctxt "badend5:badend5_22A3A367_B50D_46BE_8D2A_00044CB8B667"
msgid ""
"⟪k:0⟫Are you sure you’re okay?⟪k:1⟫⟪k:2⟫I was saying we need to settle on a destination for our "
"trip next month."
msgstr "⟪k:0⟫……你真的没事么……？⟪k:1⟫⟪k:2⟫我们刚才在说……⟪k:3⟫下个月该去哪里旅行的事。"

#: badend5:badend5_86396821_A704_466D_BDC8_B9DA192F8AC1
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 23ed167f1022ee36031c14c692eb323c2ac1b9b7619462b1aa16a798e23c8ac2
#. default-sha256: a98be2ab674ef57de628057575fb422d5fe5e502be70561fe0218899959166ad
msgctxt "badend5:badend5_86396821_A704_466D_BDC8_B9DA192F8AC1"
msgid "⟪k:0⟫Ahh... ⟪k:1⟫Anywhere you’d like is fine with me."
msgstr "⟪k:0⟫……啊啊……⟪k:1⟫去你……喜欢的地方便好了。"

#: badend5:badend5_7B84C3A8_4D0F_4F9F_BAC2_E5C67DB83917
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 87500297f9cb4a784ff1da8fdac20ed5379d1da0cd11f8c2f200adc4fd3d71b9
#. default-sha256: abddbd436c3510f53fcc4f7dc11058cdcff345cb6072adfffcb55ce6ddd0ade5
msgctxt "badend5:badend5_7B84C3A8_4D0F_4F9F_BAC2_E5C67DB83917"
msgid ""
"⟪k:0⟫Hehe... ⟪k:1⟫that’s always how it goes with you, isn’t it?⟪k:2⟫⟪k:3⟫You are allowed to have "
"an opinion of your own, you know."
msgstr "⟪k:0⟫呵呵……⟪k:1⟫你总是这么说呢。⟪k:2⟫⟪k:3⟫偶尔，⟪k:4⟫也要去点你喜欢的地方啊。"

#: badend5:badend5_8FAE56BF_1795_4ACC_B488_406EB3C79BEC
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 97f4bc3e471af130458f9be3cef6561a96e5bce767fe4c0b8be3b3157bb2eb63
#. default-sha256: 0909ae2bc3f56adc1bdc0de031fd300d1f3031ec7ab4abda368c7dd3bd658393
msgctxt "badend5:badend5_8FAE56BF_1795_4ACC_B488_406EB3C79BEC"
msgid "⟪k:0⟫We’ll end up going to Prague again if you let me pick."
msgstr "⟪k:0⟫要是我决定的话，⟪k:1⟫又要去布拉格了哦……？"

#: badend5:badend5_4F9A34C5_FB50_441D_A1C9_B99B9E40C585
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: cd3a3ff2d5a8c07bd3e03b42770a89251722b6ac1467a564cc5d05fe62438dc3
#. default-sha256: b5c9526e28ab21f7a6f816b47943a6efe5241fd510bc58a3d77684276558cc0b
msgctxt "badend5:badend5_4F9A34C5_FB50_441D_A1C9_B99B9E40C585"
msgid ""
"⟪k:0⟫There’s nothing wrong with Prague.⟪k:1⟫⟪k:2⟫We can go see Mucha’s stained-glass window at "
"the St. Vitus Cathedral and visit the Petřín Gardens again."
msgstr "⟪k:0⟫布拉格么，⟪k:1⟫我觉得挺好的……⟪k:2⟫⟪k:3⟫还想去看穆夏的彩色玻璃，⟪k:4⟫去逛佩特辛公园。"

#: badend5:badend5_DDC5A25E_7AAF_4FF8_957F_F3CCFF4C6A23
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 271a9891f8440b16a09b7013bf55b8a4b88cdc1090f376f504c668a829856638
#. default-sha256: 8233d89cfb05328b01c7c3c848206cfcc96d55ad43df3e2a63759049a7d21529
msgctxt "badend5:badend5_DDC5A25E_7AAF_4FF8_957F_F3CCFF4C6A23"
msgid "⟪k:0⟫And maybe this time, we won’t be late for the Walk of the Apostles at the clock tower."
msgstr "⟪k:0⟫这次我们要选对时间，⟪k:1⟫去看布拉格旧市政厅钟楼上的十二使徒啊。"

#: badend5:badend5_235E0583_6691_45E7_BA54_F8BFDE73790C
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 45101f062606d1620cf08553484e7ac2595ad04be7ee55c32e5323ed0981aa8d
#. default-sha256: 4a282a324e414c94d37dd315c295328f0dc97224296dc08efab91027950415b6
msgctxt "badend5:badend5_235E0583_6691_45E7_BA54_F8BFDE73790C"
msgid "⟪k:0⟫All right, then we should start looking at hotels."
msgstr "⟪k:0⟫这样啊……⟪k:1⟫那么，⟪k:2⟫我们找一下布拉格的宾馆吧。"

#: badend5:badend5_BE7D8084_75C7_447A_AA86_79065F6C5CC7
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: cf274c7d67e0bbf8354fb19724d93d398c0b6286f4684a612e094874ec8a3395
#. default-sha256: d02989f0a4281aaba62e649af9c739240e481475646ac17d289b90b0d401df39
