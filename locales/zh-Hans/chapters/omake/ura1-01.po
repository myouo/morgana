msgid ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫I wish I knew how all these uninvited souls kept finding their way to my mansion."
msgstr "⟪k:0⟫⟪k:1⟫⟪k:2⟫真奇怪，⟪k:3⟫又有人不请自来。"

#: omake:omake_0FC36204_061C_4057_9C29_685A6FDCAD5A
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 2b0a3e1c20015873d05940ff0fcf647766671860bc5fd0398ef8a3752dac097d
#. default-sha256: 0a18326582ee4f93bed9232b7f4334109dad8ed3c878389ad2943fde74e98310
msgctxt "omake:omake_0FC36204_061C_4057_9C29_685A6FDCAD5A"
msgid ""
"⟪k:0⟫⟪k:1⟫If you just completed the game and would like some time to dwell on it, you are welcome "
"to head back now."
msgstr ""
"⟪k:0⟫⟪k:1⟫对本篇进行了许多恶搞。⟪k:2⟫⟪k:3⟫如果你刚通关游戏，⟪k:4⟫还想沉浸在余韵之中，⟪k:5⟫可以以后"
"再来。"

#: omake:omake_9790113F_2F86_4B78_AC2E_10D8DB9E56B1
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: e800c8050b3666eb32012b8db42d23861902d38badea2e040f4864d3eac1a04f
