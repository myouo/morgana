#: omake:omake_FC88912E_2931_41A4_92DD_9E4111F94673
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 99eab26e885132af58029e7e25fcec097e26ae83df45f585db4387d735dd15ff
#. default-sha256: 46e75fc00ee2820c2e782e5972b1648c563484e3e4fb23896bd9b78e61c6a96b
msgctxt "omake:omake_FC88912E_2931_41A4_92DD_9E4111F94673"
msgid "⟪k:0⟫⟪k:1⟫⟪k:2⟫Well, never mind that for now."
msgstr "⟪k:0⟫⟪k:1⟫⟪k:2⟫……算了。⟪k:3⟫这时候就不计较那些琐事了。"

#: omake:omake_842EAA67_89AC_4204_B51D_994B16A9A5B6
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: df48a0014c553640d1a4c6ff2fed252b8a0ff16dc7c31cfb251c9db1ee19de8d
#. default-sha256: d3159e1d2479ff3c576882e5dc792517e9a52c4ecef51547a4929e1fc3bfa15d
msgctxt "omake:omake_842EAA67_89AC_4204_B51D_994B16A9A5B6"
msgid ""
"⟪k:0⟫I would ask you what you thought of it,⟪k:1⟫but unfortunately, that is beyond even my powers."
msgstr "⟪k:0⟫本想问问你有什么感想，⟪k:1⟫可惜听不到你的声音。"

#: omake:omake_F9A09CB9_71D9_41BD_8D28_DFAE4B4D5048
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: e095ecfd6177b6ed67cb90825cbf2b19ff89f8a9cbbad165633f8fa19e1f3eb3
#. default-sha256: b87950b27d61aaac3300f80f4c5052bd0f234a12a095f999d2663bca70240a2e
msgctxt "omake:omake_F9A09CB9_71D9_41BD_8D28_DFAE4B4D5048"
msgid "⟪k:0⟫⟪k:1⟫⟪k:2⟫...You’ve got a strong stomach, at least."
msgstr "⟪k:0⟫⟪k:1⟫⟪k:2⟫是吗……⟪k:3⟫有胆量。"

#: omake:omake_3D14B59C_669A_473A_81E7_82B165B4E507
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 1076615460523375bd494128a932fd6440045adc347ee766a6c95ecdbe3a83cb
#. default-sha256: 9c4c211d17cbbcbbd860ce61bbb88a476d39c8bfa3a833ceb3f055245beda787
msgctxt "omake:omake_3D14B59C_669A_473A_81E7_82B165B4E507"
msgid ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫Before we begin our little trek, I would like to emphasize that this is,⟪k:3⟫as "
"the title implies, a look behind the curtains of ⟪k:4⟫The House in Fata Morgana⟪k:5⟫."
msgstr "⟪k:0⟫⟪k:1⟫⟪k:2⟫那就走吧……⟪k:3⟫不过在此之前先声明，⟪k:4⟫正如标题所写，这里是幕后。"

#: omake:omake_5973E007_064C_48B3_A4D6_641D2CD416FC
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 25c9acf84d0be13636bb7da3707ee658acdf92946ac0db6393e9d919864dafd7
#. default-sha256: 14a5da8008135427bd5cfdbe80e514a34813c81f5e6ee95303e005157b68676f
msgctxt "omake:omake_5973E007_064C_48B3_A4D6_641D2CD416FC"
msgid ""
"⟪k:0⟫You’ll be making your way into the heads of the staff themselves,⟪k:1⟫and I promise you—⟪k:2⟫"
"⟪k:3⟫it’s not a pretty sight."
msgstr "⟪k:0⟫⟪k:1⟫还想继续的话，⟪k:2⟫那就走吧。⟪k:3⟫⟪k:4⟫到制作人员各种发牢骚的幕后看看吧。"

#: omake:omake_8A3E8667_5714_4479_945B_89A82141E83A
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 2c76e52143c594cd4ea4dcf190bebab068e92d576821ecedc4adf91c40c24f23
#. default-sha256: 66aa3eb5bae9d9abed6d9e306f318e211bafc01e9fe0f9a4ccb49bf5bfb215ca
msgctxt "omake:omake_8A3E8667_5714_4479_945B_89A82141E83A"
msgid "⟪k:0⟫Let us be off, then."
msgstr "⟪k:0⟫那就走吧。"

#: omake:omake_0D388061_5E2E_478A_ACF1_CABD30013371
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 054236876aa85a1a86db0fb75ee2520fa72e0380a6c7f46981c374c914e423b1
#. default-sha256: 5c6f33058983af3266b4fd858d9fbf065487b0335e4308eafcd9c1b45bcd196a
msgctxt "omake:omake_0D388061_5E2E_478A_ACF1_CABD30013371"
msgid ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫⟪k:4⟫⟪k:5⟫⟪k:6⟫Ah! I found another split end!⟪k:7⟫⟪k:8⟫Look, this one’s split "
"into three!"
msgstr ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫⟪k:4⟫⟪k:5⟫⟪k:6⟫啊，⟪k:7⟫又发现分叉了！⟪k:8⟫你看这里，⟪k:9⟫头发尖分了三根出来！"

#: omake:omake_C02C6675_80EB_49E5_9A4B_007813BB63CA
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: f07b676489e66439d0cb9653539f7ffd6bfba332a6c34dd818d9cc3610f3208b
#. default-sha256: 3131339cf408c1e45a18e6fc0e1a22d1770b2765626aabc4fdce0d3995788579
msgctxt "omake:omake_C02C6675_80EB_49E5_9A4B_007813BB63CA"
msgid ""
"⟪k:0⟫I-⟪k:1⟫I— ⟪k:2⟫⟪k:3⟫I didn’t actually mean that!⟪k:4⟫⟪k:5⟫I was just, ⟪k:6⟫you know, ⟪k:7⟫a "
"little overwhelmed at the time!⟪k:8⟫About how unexpectedly handsome you were!⟪k:9⟫But I couldn’t "
"bring myself to say it!"
msgstr "⟪k:0⟫那、⟪k:1⟫那其实是！⟪k:2⟫遮羞的说辞……！"

#: omake:omake_DE51EA4A_A870_40CF_91A4_9D835B779A79
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: d0bc8233fe7bbe6ee070f3ab41eb6a6d0186e4e8fd1d2b6689646facbf4eff49
#. default-sha256: a298c72b9d797605e2704b960f96f24eed5f1a75558be939f8b4d9018afc341d
msgctxt "omake:omake_DE51EA4A_A870_40CF_91A4_9D835B779A79"
msgid "⟪k:0⟫I hope you two sickening lovebirds spontaneously combust..."
msgstr "⟪k:0⟫……笨蛋情侣爆炸吧……"

#: omake:omake_7F2F89CD_77AE_4D18_96BE_501ABA446818
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: bc32ecd33a9450704723b9a680b335acae61a50b97f8d1be2a791b40c68719ca
#. default-sha256: 6e402474807c3c196b86d8b3fe2be3083c1ffa26b7a1df4884a93540910f9174
msgctxt "omake:omake_7F2F89CD_77AE_4D18_96BE_501ABA446818"
msgid ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫As the true master of this house, I am everywhere at all times.⟪k:3⟫⟪k:4⟫Even in "
"the bathrooms."
msgstr ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫我是洋馆真正的主人，⟪k:3⟫可以随时随地神出鬼没。⟪k:4⟫对了，⟪k:5⟫也能在你上厕所时出"
"现。"

#: omake:omake_05A8DDD2_7450_494D_9A7A_1B323EC72C6E
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 2045e23d80795bd213db6766fb73bf356ca8ffedebf75a150ab7364ef0f68cf4
#. default-sha256: 25c4d1e85c94ab9f432c6f3b99c5e923d01b64c426e6077166c5bcf1b1ebd52e
msgctxt "omake:omake_05A8DDD2_7450_494D_9A7A_1B323EC72C6E"
msgid ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫I think that’s enough toilet humor for the time being.⟪k:3⟫⟪k:4⟫Especially in "
"front of our guest."
msgstr "⟪k:0⟫⟪k:1⟫⟪k:2⟫上厕所这个话题先到此为止吧。⟪k:3⟫⟪k:4⟫毕竟有客人在场。"

#: omake:omake_FD6983FC_6500_4BC7_BE9D_0AC6E8F24B4A
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 3844776cbc4349622290e1a71271720e420a57d1aca7baf5a10fd5d71213d1bd
#. default-sha256: c0bd11c8e9cbb59993f3b59073de08b1d708b57c69c652041b025049b0b41a52
msgctxt "omake:omake_FD6983FC_6500_4BC7_BE9D_0AC6E8F24B4A"
msgid "⟪k:0⟫⟪k:1⟫It just... ⟪k:2⟫never really seemed that way to me..."
msgstr "⟪k:0⟫⟪k:1⟫因为，⟪k:2⟫我没有什么自觉……"

#: omake:omake_8BA87D65_BDE0_4565_B0AE_E16CA2BF4C6D
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 36563689e9ed2379d3a41691401fea24dd64ee6331e79a1dda771ba47139b159
#. default-sha256: 788fdfbb8a7e8bae7c8b16f237f22b5d440b011f175c7231cf18f0a23b9aea2c
msgctxt "omake:omake_8BA87D65_BDE0_4565_B0AE_E16CA2BF4C6D"
msgid ""
"⟪k:0⟫⟪k:1⟫But once you reclaimed yourself, you were most definitely playing the protagonist. ⟪k:2⟫"
"Especially the final chapter! You had me swooning by the end!"
msgstr ""
"⟪k:0⟫⟪k:1⟫但是，⟪k:2⟫找回自己之后就是个合格的主角了。⟪k:3⟫⟪k:4⟫尤其是最终章！⟪k:5⟫最后那一段太帅"
"了。"

#: omake:omake_48AEFCD0_9BAB_438B_A1E5_5BD013A1151B
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: dc9ba08894c2e5c5fee7f79d7d3eac734b347e2ebe6f8ea2d8190283585137e9
#. default-sha256: 432fa427e93d874f548275f5b094c842c636d47feba7596d2243f60417a6e6df
msgctxt "omake:omake_48AEFCD0_9BAB_438B_A1E5_5BD013A1151B"
msgid ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫What do you think, my dear? ⟪k:3⟫What any respectable behind-the-scenes extra "
"would do, of course—"
msgstr ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫哎呀，⟪k:3⟫那还用说吗。⟪k:4⟫⟪k:5⟫既然是幕后，⟪k:6⟫就像所有幕后都会做的，⟪k:7⟫我们去"
"逛逛各个房间——"

#: omake:omake_2A7F3CA3_1134_4621_BF76_8BE0B1176ACB
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 89d4afa6b35c0f2c2926fc28a5421e1ea3033f8d6de24632fe6d2f322b042dc2
#. default-sha256: 7f317dd4367d496dd324fdbeb017d5221b5b20beda812fa994eddd8292003d50
msgctxt "omake:omake_2A7F3CA3_1134_4621_BF76_8BE0B1176ACB"
msgid "⟪k:0⟫we’re going visit each room in the mansion and faff about like a bunch of fools."
msgstr "⟪k:0⟫然后肆意评价一下他们。"

#: omake:omake_060CE94C_E0AE_47B9_9D2B_6BC0BB35989D
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 8f2c67a012fa2037f5d7178ff1405a753315b3022908576084c0356dce3a71cd
#. default-sha256: 6acd0ff8a216f6b9177e6ad878e4b3118cf11b596b1ee5db2e00e9d234551ad1
msgctxt "omake:omake_060CE94C_E0AE_47B9_9D2B_6BC0BB35989D"
msgid "⟪k:0⟫⟪k:1⟫............"
msgstr "⟪k:0⟫⟪k:1⟫…………"

#: omake:omake_DD46117D_9ECB_4B85_BC2C_B5C1D59040E9
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: f00ca037ad04029463136ada597d24bb0b7427334179b80db13f81bbe0523157
#. default-sha256: 55d732f36d31217e5152595f85d18b5f33121f25f50df2680b77da199aada4a5
msgctxt "omake:omake_DD46117D_9ECB_4B85_BC2C_B5C1D59040E9"
msgid ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫You can’t deny a lot of readers probably didn’t expect the creepy white-haired "
"recluse to turn out to be the main character."
msgstr "⟪k:0⟫⟪k:1⟫⟪k:2⟫我想，⟪k:3⟫很多人都吓了一跳吧。⟪k:4⟫⟪k:5⟫谁会想到这个可疑的长发男是主角呢。"

#: omake:omake_AB7DE4F2_5BDB_46C5_B426_851B3684F16C
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 2777807a94ccb560f0e2bfbfd49b8b5d34cec9ebb594542cd4bc0d3f11bb03e3
#. default-sha256: a95d0d147ba1cdd99cef4bf8a72d215f065f96cc6d1118287613dde7e2ef189f
msgctxt "omake:omake_AB7DE4F2_5BDB_46C5_B426_851B3684F16C"
msgid ""
"⟪k:0⟫Though perhaps there are some people whose interpretations did not change throughout the "
"course of the tales."
msgstr ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫在进入我的主线之前，⟪k:3⟫从第一章到第三章应该都有发生认知逆转。⟪k:4⟫虽然也有人并没"
"有逆转。"

#: omake:omake_409E38F1_AD87_424A_9225_01F6D09C8F9D
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 84d4f5cb04e5d416b1e9c781ff0e6e85f169468b545ae72a24fb9db69ffa43c9
#. default-sha256: cd31464f666c8274e4555e89cf65f9fc41517ce8f92b6bece3d2a31125ba7c4a
msgctxt "omake:omake_409E38F1_AD87_424A_9225_01F6D09C8F9D"
msgid "⟪k:0⟫⟪k:1⟫No, that’s not how you pronounce his name.⟪k:2⟫⟪k:3⟫As I recall, it’s Eucalyptus—"
msgstr "⟪k:0⟫⟪k:1⟫不，⟪k:2⟫发音错了。⟪k:3⟫我记得是心忠——"

#: omake:omake_0563CC2F_1F91_4F15_AA9C_CA7CEC8E9CA9
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 2de85857f5f4b1f3d6f4c1da2991ab28c1fcc996e41376c1f771b20bfc6ece3f
#. default-sha256: fd6bf3060fea9384368e863458b12f6625d21d046ac6e92ebc54ccf977b6506a
msgctxt "omake:omake_0563CC2F_1F91_4F15_AA9C_CA7CEC8E9CA9"
msgid ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫You already made that joke. Let it go, please.⟪k:3⟫⟪k:4⟫That creature doesn’t need "
"a name. Just call him “the beast.”"
msgstr "⟪k:0⟫⟪k:1⟫⟪k:2⟫你们就别玩那个梗了……⟪k:3⟫⟪k:4⟫他不需要名字，喊他野兽就行了。"

#: omake:omake_E6ED0CF4_EA96_43F7_8609_288EDFB5E6DA
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: fc0698231227adb4bdc7d188919402f5a8a083ac0a623c605b8d3989faad9249
#. default-sha256: a37505e18d33fde65ecd48161af758bea5e486bb55b9e652f4c6ccc8283a0d8f
msgctxt "omake:omake_E6ED0CF4_EA96_43F7_8609_288EDFB5E6DA"
msgid ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫At the end of that chapter, you learn what kind of man he really was, which then "
"ties into the revelations in the final chapter."
msgstr "⟪k:0⟫⟪k:1⟫⟪k:2⟫他们最后显露出的才是本性。⟪k:3⟫正因为了解了他们，⟪k:4⟫才有最终章的好结局。"

#: omake:omake_C5A798EB_B811_4ED8_AFAC_A061A9511D1D
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 8d7d8a5188dd299ec9ea11860ebafc8b9b14d013414579fbf1f30da7056444bd
#. default-sha256: 371ae450d795bcc856e5fbda8a7e2289bb30b283fa068b7047396c472ede9956
msgctxt "omake:omake_C5A798EB_B811_4ED8_AFAC_A061A9511D1D"
msgid "⟪k:0⟫⟪k:1⟫.................."
msgstr "⟪k:0⟫⟪k:1⟫………………"

#: omake:omake_50B816BD_A179_493D_9A53_C8C56CE248FA
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 36b0f3243f5ceb2793a0ebf9149dbb227079b4ea7b86e121a3aa8ebe00d5ba07
#. default-sha256: 493347cb267aae689d98e86b9529668ddd6871b11602c4268f30cecb9acc2a6c
msgctxt "omake:omake_50B816BD_A179_493D_9A53_C8C56CE248FA"
msgid "⟪k:0⟫I don’t hold it against you, though."
msgstr "⟪k:0⟫但现在一点也不怪你。"

#: omake:omake_6F5B9841_CFC1_491F_A9B2_FBB2DF203B6D
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 51296ce80ded034d5babdf77e96c7913f819ba7d21e17d944cc3ad1b5cf8fc00
#. default-sha256: 6acd0ff8a216f6b9177e6ad878e4b3118cf11b596b1ee5db2e00e9d234551ad1
msgctxt "omake:omake_6F5B9841_CFC1_491F_A9B2_FBB2DF203B6D"
msgid "⟪k:0⟫⟪k:1⟫............"
msgstr "⟪k:0⟫⟪k:1⟫…………"

#: omake:omake_0A72F11A_330D_41F5_9178_3472164D57AD
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 8054bd95a2f32ef4685d491c406fd037fb3b721b83add256472341ca4586577a
#. default-sha256: f27fdc7674894c97240e05da16366241e4d1bf079e0b7e6c9e394778fb762d39
msgctxt "omake:omake_0A72F11A_330D_41F5_9178_3472164D57AD"
msgid ""
"⟪k:0⟫(I really need to peel these two apart. ⟪k:1⟫We’ll never finish if they keep making goo-goo "
"eyes at each other every ten seconds...)"
msgstr "⟪k:0⟫（还是把他们俩分开吧。⟪k:1⟫⟪k:2⟫　每十秒钟就秀一次恩爱……）"

#: omake:omake_BB639CDC_9C11_4274_88F5_23A805F58DCC
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 01f7f8dfb727727e0f1b307b59cc527c620650f7d7239655e42ce8a7354b4f8e
#. default-sha256: 854741ef6a253b4e89fdbe56397e2b6f1e3d4f4d314f1958e3a9b2cbb1b1fefe
