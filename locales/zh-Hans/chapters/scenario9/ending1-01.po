msgid "⟪k:0⟫But what are you doing here?"
msgstr "⟪k:0⟫可是……⟪k:1⟫你为什么会在这里……？"

#: scenario9:scenario9_2350185D_01F0_4ECC_8739_736AF54BE615
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 68009661ae79da3ba6f2c4464a8c9a3d5ab99e5046692ab9a6ee015326c50e34
