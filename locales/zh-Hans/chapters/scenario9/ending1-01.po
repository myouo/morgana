msgid "⟪k:0⟫What? ⟪k:1⟫Why is... ⟪k:2⟫the White-Haired Girl here...?"
msgstr "⟪k:0⟫为什么……⟪k:1⟫白发少女会在这里……"

#: scenario9:scenario9_EDA5A59B_1C8D_42AA_B3CE_97BFD760A867
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 2d0ddaf0fa881699456d486896918a391dc2190f9d737c86cd4b61e092b4566b
