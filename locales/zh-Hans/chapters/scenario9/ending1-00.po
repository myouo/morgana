msgctxt "scenario9:scenario9_BFFABA15_63BD_40FC_B8ED_40BF543856FA"
msgid "⟪k:0⟫Do you know who I am?"
msgstr "⟪k:0⟫你是否……⟪k:1⟫了解我的事情呢……？"

#: scenario9:scenario9_1E9F04AC_24CD_462E_9AC3_D4184EABDCD7
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 5671e0cde3f7717d4539156514936a88033c80420b463e65539ea6b6898eafb3
#. default-sha256: 08a0c53cef03af991ba8bb252615f6b0f7cd42c72576e8fa27d087a1497115f3
msgctxt "scenario9:scenario9_1E9F04AC_24CD_462E_9AC3_D4184EABDCD7"
msgid "⟪k:0⟫And why... ⟪k:1⟫can I not speak?"
msgstr "⟪k:0⟫为什么……⟪k:1⟫我明明想说话……⟪k:2⟫却发不出声音……？"

#: scenario9:scenario9_FDA1CBD3_AAFE_4D07_AB73_5CB3BF3EE90A
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 6c2240d48e056dce1d975dea71dfdf64aa42f366eeeb6cf56fc6daf4355642d7
#. default-sha256: d81b8c2645ad63e3b198913b86627d19cda882a15785764e98eb4ad3d857c55a
msgctxt "scenario9:scenario9_FDA1CBD3_AAFE_4D07_AB73_5CB3BF3EE90A"
msgid "⟪k:0⟫I was able to return to this gathering place of souls thanks to your efforts."
msgstr "⟪k:0⟫你揭露了莫尔加娜死亡的真相……⟪k:1⟫所以我也能回到这灵魂聚集之所。"

#: scenario9:scenario9_D024F237_3183_4E5B_BE81_82AD558E0E75
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: a77c8fd5f0aebc53e942f0f2167cb7a3bcc6d4f4c8eef4557dfcc2538f10bdb7
#. default-sha256: e7346218dfc029aa6b47cbdce33b9564f4fb4fca7c566532b1615512050d0eab
msgctxt "scenario9:scenario9_D024F237_3183_4E5B_BE81_82AD558E0E75"
msgid "⟪k:0⟫But my heart told me I had to do this now."
msgstr "⟪k:0⟫但是……⟪k:1⟫只有你准备回去的这一瞬，⟪k:2⟫我才能与你接触。"

#: scenario9:scenario9_74D6CBEA_B305_4027_B19E_4D301A77EACC
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 955bb0cd82b6cc95a63ece97858a161471a7a6277378b49df3891baacc5d3cb5
#. default-sha256: 284585f8f39bf8c732bd0342c2726fa9d8c7f5597a2dc26d58ddce068b19efdf
msgctxt "scenario9:scenario9_74D6CBEA_B305_4027_B19E_4D301A77EACC"
msgid "⟪k:0⟫I have brought you here to ask for your assistance."
msgstr "⟪k:0⟫我有一事相求，⟪k:1⟫所以将你呼唤至此处。"

#: scenario9:scenario9_6BA1FB6E_E41D_48FA_90FD_50C8BA4E5933
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 2551aa6626a5b86729fa07af7dcbb94921b7cb5423a2f6d19f44bb31b75bccd7
#. default-sha256: b5e4c83999192c33984058caf2c2f078c667b7175d21839a87b54aff92a1c2c3
msgctxt "scenario9:scenario9_6BA1FB6E_E41D_48FA_90FD_50C8BA4E5933"
msgid "⟪k:0⟫take this blade, and with it, extinguish my soul."
msgstr "⟪k:0⟫请用这把剑，⟪k:1⟫彻底消灭我的灵魂。"

#: scenario9:scenario9_46C9FD96_4824_4A8E_B09A_005FD2D06FB3
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 7b2051c8c5ba2f92a89f22ef28611b0b3636b851586f9bedd92c4b5170afd49e
#. default-sha256: 3c92a38311e16a256c3106e1e3b6b76399ac7ca0d8fa63fbf2051af0b97264ba
msgctxt "scenario9:scenario9_46C9FD96_4824_4A8E_B09A_005FD2D06FB3"
msgid "⟪k:0⟫Because I wanted to save every last person caught in this tragic quagmire."
msgstr "⟪k:0⟫把大家从这个不幸的漩涡中拯救出来……⟪k:1⟫才努力至此的……"

#: scenario9:scenario9_EB0AB613_6210_4CB4_B8ED_D5CAAEC5535D
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: d47da2af1460bc64520017b17ceb5d79b70fe1e0b846bfdf7f759929e743f7b7
#. default-sha256: 5c218e4f58bc22aa85d2e46be7832810ab179bf813c760e4d40d7873ea11b519
msgctxt "scenario9:scenario9_EB0AB613_6210_4CB4_B8ED_D5CAAEC5535D"
msgid ""
"⟪k:0⟫You can’t tell me that after everything you’ve seen...⟪k:1⟫⟪k:2⟫you haven’t realized that I "
"have no place in their lives."
msgstr "⟪k:0⟫看到过去他们之间的关系……⟪k:1⟫你应该明白我是个特异存在……不是吗？"

#: scenario9:scenario9_B62E9CEB_A857_4BDC_8BC4_DE2D0B129191
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: aaba99fb8f61b15b1bb78a50050be88237b14498235dc75515ae9eb74cbb18be
