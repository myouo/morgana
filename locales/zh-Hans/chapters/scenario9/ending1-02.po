msgctxt "scenario9:scenario9_8D172889_250D_45C2_B1D8_4CF77A59EA23"
msgid "⟪k:0⟫I pray you will be able to help me."
msgstr "⟪k:0⟫无论如何……⟪k:1⟫请你听我说。"

#: scenario9:scenario9_67E6FE66_E9AF_49A2_BAB8_937EC9E55832
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: ccfa2fb81ad4cccb659d45aa336f2464c8cc991b3e07853f37283a52c835ce2f
