msgctxt "scenario9:scenario9_D103C95F_E067_4B9E_A23E_5D1E2174843E"
msgid "⟪k:0⟫To live."
msgstr "⟪k:0⟫……想要生存下去……"

#: scenario9:scenario9_A7F6DEB0_17A1_48CC_BD38_B89FF9CE350D
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 0e09c5f6d3a31725903b10a4f2e3aaab05a73a5036b8a937769d598a558e9744
