msgctxt "scenario9:scenario9_3553894F_EA73_4C5E_BD18_85D9258CD87B"
msgid "⟪k:0⟫And you’re trying to tell me that makes you culpable?"
msgstr "⟪k:0⟫现在却说……⟪k:1⟫自己才是加害者……"

#: scenario9:scenario9_53DD53DC_BE1F_481A_B933_EBB17AB7A0C5
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
