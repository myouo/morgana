msgctxt "scenario9:scenario9_67FA079F_C169_4B07_9CED_0EC33DBAB5BE"
msgid ""
"⟪k:0⟫If I hadn’t been there, the ambitious businessman would not have been betrayed by his close "
"friend."
msgstr "⟪k:0⟫如果没有我……⟪k:1⟫曾经是领主的男性，⟪k:2⟫也不会被好友背叛。"

#: scenario9:scenario9_D04265D7_EB6F_45D2_AEEF_A130826FF259
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: dbca6ba0dc9edee492c8584f1f73f2df973dd8b24f6798f8d9935e05508d1522
