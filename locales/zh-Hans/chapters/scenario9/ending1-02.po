msgctxt "scenario9:scenario9_530F73F2_8854_456F_9C0E_38F07572BA08"
msgid "⟪k:0⟫To remember who I am."
msgstr "⟪k:0⟫终于……全部都回想起来了。"

#: scenario9:scenario9_BC25A711_5E45_4DC4_8C15_3BF938940FA9
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: fb79b5d9ebe10bdc617d1d8cd96628d121b2aafa229491382dfe1f746ca05da3
#. default-sha256: 860e5ebb08bcbb543b54e2526f8889de18ed72e294886d336d3b89c37ef4bc81
msgctxt "scenario9:scenario9_BC25A711_5E45_4DC4_8C15_3BF938940FA9"
msgid "⟪k:0⟫You mean that you’re a part of Morgana?"
msgstr "⟪k:0⟫回想起自己是……⟪k:1⟫莫尔加娜灵魂的一部分了吗……？"

#: scenario9:scenario9_6E4A8859_8DE0_46C7_ADD1_3C484B066284
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 2aab9d76d7a75f757c5023c405dbe59ea6f7384c5ad5a0521ee5278d7695cef9
#. default-sha256: 7f33b6620814b0260a85d29a057044ef1a5648c2d388c039eeabf6c596c82dd7
msgctxt "scenario9:scenario9_6E4A8859_8DE0_46C7_ADD1_3C484B066284"
msgid ""
"⟪k:0⟫My apologies. Bringing your soul here without any preparation has left you in a bit of a... "
"⟪k:1⟫nebulous state."
msgstr "⟪k:0⟫对不起……⟪k:1⟫突然将你的灵魂呼唤到我身边来——⟪k:2⟫让你的存在变得不稳定了。"

#: scenario9:scenario9_848F96ED_BA6F_4955_9574_ACD71035010C
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 939f28cae4f00a58987759ba6678184550a34c3e42bac68f5d1c615f9fce346d
#. default-sha256: feb447aac1691467d3d22dc371cfbd786f500cfd0145b92191453df8f4d5255f
msgctxt "scenario9:scenario9_848F96ED_BA6F_4955_9574_ACD71035010C"
msgid "⟪k:0⟫Though you have no voice, I can feel your presence quite clearly."
msgstr "⟪k:0⟫现在……⟪k:1⟫我虽然无法听到你的声音……⟪k:2⟫但能强烈感受到你的存在。"

#: scenario9:scenario9_F99BC3F3_7E85_4E9C_A5B6_4FD65CB2734C
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 8792f6b4b72303cbf8e46add435f88ee093ad0206d10c97edd262a8c5f7cd772
#. default-sha256: 56c6f5ace547079cbe3a19e32b87d255b732503ad3c4335152cbbcb54dbccf4d
msgctxt "scenario9:scenario9_F99BC3F3_7E85_4E9C_A5B6_4FD65CB2734C"
msgid "⟪k:0⟫O Michel, namesake of the great archangel Michael and man of tremendous virtue,"
msgstr "⟪k:0⟫米歇尔……⟪k:1⟫有着天使之名的高尚之人啊……"

#: scenario9:scenario9_8D172889_250D_45C2_B1D8_4CF77A59EA23
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: fde7cb874f8b3c8ba4a49e986665cba5a6ea4c8741c1377e9d07c6a965fa9ce1
