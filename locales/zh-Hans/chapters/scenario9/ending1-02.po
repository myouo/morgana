msgctxt "scenario9:scenario9_D04265D7_EB6F_45D2_AEEF_A130826FF259"
msgid "⟪k:0⟫You always acted... ⟪k:1⟫out of the good of your heart."
msgstr "⟪k:0⟫不如说……⟪k:1⟫一直做着善行……"

#: scenario9:scenario9_3553894F_EA73_4C5E_BD18_85D9258CD87B
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 758062ddaeeeaf948d9214f1282c19ca37f1c96600aa8b42389dfd8ecdd94a9d
