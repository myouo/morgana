msgid "⟪k:0⟫............"
msgstr "⟪k:0⟫…………"

#: scenario9:scenario9_43DC30D4_AB74_4542_B8EC_FC2318FD4AB9
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: afb7aa327e27a5cdd0ead8d7e618049fbfede2244bdb4576e572c0a3831e881b
