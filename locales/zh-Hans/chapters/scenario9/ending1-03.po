#: scenario9:scenario9_D4862E8D_0992_442C_82B4_6E6CBBB09432
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: b68ac1eb0928e4dfb8f86398f7e3a8f8a213b00d70122ec0c27c30db681cc4ab
#. default-sha256: 31979145fa283664e82a3e734b747f916bf13e9a6eff3a1ea4100f7c05d43164
msgctxt "scenario9:scenario9_D4862E8D_0992_442C_82B4_6E6CBBB09432"
msgid "⟪k:0⟫You’re not a defect..."
msgstr "⟪k:0⟫你才不是……⟪k:1⟫什么异物……"

#: scenario9:scenario9_CC95A959_3809_4FE9_AAC3_5963A5D0B1FE
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: e743c5d13fca7e52e38cf82f4e84b4409e6fc8b72952cb21c8e93d946f4b607f
#. default-sha256: 9379c5f09ed7c17262d8fc9e6f8c4c7b4bfda7eb703151321543c67e9fec803a
