#: scenario9:scenario9_CDE192CC_D8E1_483D_ADDA_BF5B772FFBF8
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 2624a02289590082f3b8f7ec1b0ab8f2ef6a83ba03a12aba70aaccabb3cfca45
#. default-sha256: c2f00bc34ab927b13e8ff772a0a56eb7f856785f67b353195e5bf52105a0fe23
msgctxt "scenario9:scenario9_CDE192CC_D8E1_483D_ADDA_BF5B772FFBF8"
msgid "⟪k:0⟫that there’s anything wrong with wanting to live."
msgstr "⟪k:0⟫难道你想……⟪k:1⟫这么说吗……"

#: scenario9:scenario9_427B61FA_F1B1_48B4_A6BF_CD32FDF16F18
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: dca73f1cd05bf09a54e7eb10866e0db0fb00f46d7688a9a6abc2c6931c0bc064
#. default-sha256: 2b0c4e7cd591d97f301a8dfbed7bdb7e37c72ba9af4389acf233bc8c8a9b2a0d
msgctxt "scenario9:scenario9_427B61FA_F1B1_48B4_A6BF_CD32FDF16F18"
msgid "⟪k:0⟫I was supposed to remain within Morgana, as a part of her."
msgstr "⟪k:0⟫本来，⟪k:1⟫我无法成为独立的灵魂。"

#: scenario9:scenario9_107F121F_562F_4D89_9F82_76A29429BD7B
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 0a700e0fe76174371cd02dcb42a1568de06ad4ae93afed729ce1a49a32ab46ca
#. default-sha256: e588fad700db7947e6a9c863689a81126334110822955861dd43cf434cccaec0
msgctxt "scenario9:scenario9_107F121F_562F_4D89_9F82_76A29429BD7B"
msgid "⟪k:0⟫To become one... ⟪k:1⟫was to turn against the laws of the universe."
msgstr "⟪k:0⟫这样的我，⟪k:1⟫以人类的身份存在——⟪k:2⟫⟪k:3⟫是违背世界常理之事。"

#: scenario9:scenario9_B3DA77E1_8EE0_4E8D_964B_3B154B0396F5
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: c92a8bfccdf047c509aa7369cc5c7972273179c2f10093a6f8c03f12d3d16e3b
#. default-sha256: b98f23f5346145a5fce5fd51929fcd324395f5cb62d913deb0d1b352cf5403ac
msgctxt "scenario9:scenario9_B3DA77E1_8EE0_4E8D_964B_3B154B0396F5"
msgid "⟪k:0⟫Because that was where she lingered—⟪k:1⟫⟪k:2⟫the girl from which I was formed."
msgstr "⟪k:0⟫因为，⟪k:1⟫作为我的本体的她，⟪k:2⟫还残留在这里。"

#: scenario9:scenario9_13865182_DB1B_4F73_B3AA_181FDF2483F0
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 809ea6520e8828c23a1131f5a084cc9705c8c81692a2051f1169822b775a6903
#. default-sha256: bcee96ebe99f0f07136932cd3745d1220ea416ed272cfb26cbc4723d4f522203
msgctxt "scenario9:scenario9_13865182_DB1B_4F73_B3AA_181FDF2483F0"
msgid "⟪k:0⟫Falling in love was an act of villainy."
msgstr "⟪k:0⟫我与谁坠入爱河……⟪k:1⟫亦是罪孽。"

#: scenario9:scenario9_D33E3A1B_B033_473B_9FC2_8153900A76B5
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: aaba99fb8f61b15b1bb78a50050be88237b14498235dc75515ae9eb74cbb18be
