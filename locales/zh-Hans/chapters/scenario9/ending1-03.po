msgid "⟪k:0⟫Why is there a sword in your hands?"
msgstr "⟪k:0⟫那把剑……⟪k:1⟫又是什么……？"

#: scenario9:scenario9_68EEC317_9276_4E14_A303_77624A0F3FB5
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 50a110235630465fa14e3a8b9fe017801846fa844a003cb66b184c0871d5b90b
