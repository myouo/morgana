msgctxt "scenario9:scenario9_68EEC317_9276_4E14_A303_77624A0F3FB5"
msgid ""
"⟪k:0⟫I realize that it’s cruel for me to ask this of you,⟪k:1⟫⟪k:2⟫and for that, I deeply "
"apologize."
msgstr "⟪k:0⟫我也明白……⟪k:1⟫这是强迫你去做残酷无比之事。⟪k:2⟫⟪k:3⟫对此……我感到十分抱歉。"

#: scenario9:scenario9_148F91BC_E4C1_467E_B6E2_A38C3FA5AEE7
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 7a55dac51ce2f726b8d12d0de575dbd884f4c68843dd6e96e57e855031c1b8a5
