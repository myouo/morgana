msgctxt "scenario9:scenario9_DE0645BD_A94B_49F2_97B1_549192018D30"
msgid "⟪k:0⟫That includes you."
msgstr "⟪k:0⟫就算是你……⟪k:1⟫也不例外……"

#: scenario9:scenario9_47FB5147_8F88_4FBA_BD47_47D48530ED8A
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 9339422de002a134a1bc73c1f87caf4934433fd7f402c44b868f293d2be9bcea
#. default-sha256: e9ead24428aa0eada105faff80e7b23956b33af0b1a3f082c29c2fe544a8ae52
msgctxt "scenario9:scenario9_47FB5147_8F88_4FBA_BD47_47D48530ED8A"
msgid "⟪k:0⟫I was not a victim in the tragedies...⟪k:1⟫⟪k:2⟫I am culpable for them."
msgstr "⟪k:0⟫因为我……并不是被卷进悲剧的无辜被害者……⟪k:1⟫⟪k:2⟫而是制造悲剧的加害者。"

#: scenario9:scenario9_830104B4_BEF4_412F_BDDC_A90871F518EB
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 72a7f96c4d7a869cccc7c59d7af4d705f7fd4189e8fe4ee569219063270d50be
