#: scenario4:scenario4_9B4D4193_13FE_49FC_892E_D05717C95ED5
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 083a2046d63c87a63a07f7bda7c20cda839b831e19af1a276078c782af948935
#. default-sha256: 4e820c5fe56d024cd1ee8aad6d3df0aa14b9739d440990806ac739058897506a
msgctxt "scenario4:scenario4_9B4D4193_13FE_49FC_892E_D05717C95ED5"
msgid ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫⟪k:4⟫⟪k:5⟫⟪k:6⟫⟪k:7⟫⟪k:8⟫⟪k:9⟫⟪k:10⟫⟪k:11⟫⟪k:12⟫⟪k:13⟫⟪k:14⟫⟪k:15⟫⟪k:16⟫⟪k:17⟫"
"⟪k:18⟫⟪k:19⟫⟪k:20⟫⟪k:21⟫⟪k:22⟫⟪k:23⟫⟪k:24⟫⟪k:25⟫But an unfathomable amount of time has passed,"
"⟪k:26⟫and the two have still yet to reunite."
msgstr ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫⟪k:4⟫⟪k:5⟫⟪k:6⟫⟪k:7⟫⟪k:8⟫⟪k:9⟫⟪k:10⟫⟪k:11⟫⟪k:12⟫⟪k:13⟫⟪k:14⟫⟪k:15⟫⟪k:16⟫⟪k:17⟫"
"⟪k:18⟫⟪k:19⟫⟪k:20⟫⟪k:21⟫⟪k:22⟫⟪k:23⟫⟪k:24⟫⟪k:25⟫然而，⟪k:26⟫虽然那段往昔已十分遥远，不知流逝了多少"
"岁月。⟪k:27⟫⟪k:28⟫但至今，⟪k:29⟫他和她，⟪k:30⟫还没有得以重逢。"

#: scenario4:scenario4_94BC561E_5672_48E3_9852_2DF7363FDBD5
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 752011fa379ce764dedad2bc126d04d26020819c431bb056ae1235b558765201
#. default-sha256: 6c2b6bcca53e8033e47f0b189681fcb03e8304c6aef8175d51001981a643dbb4
msgctxt "scenario4:scenario4_94BC561E_5672_48E3_9852_2DF7363FDBD5"
msgid "⟪k:0⟫Have they, Master?"
msgstr "⟪k:0⟫下仆说的……没错吧？⟪k:1⟫是这样吧？"

#: scenario4:scenario4_20C1EAD2_203A_4D3B_BBFB_F297200A554C
