msgid "⟪k:0⟫...I can’t remember."
msgstr "⟪k:0⟫…………剩下的，⟪k:1⟫全都想不起来了。"

#: badend3:badend3_76C25893_D9E0_4442_8A32_70B6F7F55630
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: c4ca21a907cc7a619f7695deb81c2e8074cb71e67cad0a1ba0c551bb9ce5b5c8
