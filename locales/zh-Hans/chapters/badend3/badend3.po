#: badend3:badend3_C70F299F_DA84_4B00_9E9E_EDA04274BA9A
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 4bfc0ff4221ef4550e29068d56cca9e67f287382ba413ae7e1bbca34d1551008
#. default-sha256: e206c8a03881a306e57afb7a5cfeff840ec205d8b18e7aa07969c141e6f8b24a
msgctxt "badend3:badend3_C70F299F_DA84_4B00_9E9E_EDA04274BA9A"
msgid ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫⟪k:4⟫⟪k:5⟫⟪k:6⟫⟪k:7⟫⟪k:8⟫⟪k:9⟫⟪k:10⟫⟪k:11⟫⟪k:12⟫⟪k:13⟫⟪k:14⟫⟪k:15⟫⟪k:16⟫I "
"can’t force her to do something she doesn’t want to."
msgstr ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫⟪k:4⟫⟪k:5⟫⟪k:6⟫⟪k:7⟫⟪k:8⟫⟪k:9⟫⟪k:10⟫⟪k:11⟫⟪k:12⟫⟪k:13⟫⟪k:14⟫⟪k:15⟫……我无法强人"
"所难……"

#: badend3:badend3_74F825C4_270A_4F90_9221_8B5CA412E57C
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 6604ef2a79b93e383fe159512cc4fa6dadb51aa5c9375520541c7d3a6d67ac50
#. default-sha256: 295f8df4408fb8af2de045648d96903c2275b02b7dd9655a6a24648f4ada1e06
msgctxt "badend3:badend3_74F825C4_270A_4F90_9221_8B5CA412E57C"
msgid ""
"⟪k:0⟫If she doesn’t reclaim herself on her own... ⟪k:1⟫I’ll never get to hear her say my name "
"again..."
msgstr "⟪k:0⟫如果她真的不能找回自我的话……⟪k:1⟫⟪k:2⟫就永远，⟪k:3⟫都不会说出我的名字了吧……⟪k:4⟫"

#: badend3:badend3_547360EE_32D4_4534_8ED5_5D740F96586D
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 295e8da11c479659ad6829dce52e46859b3b8214af72047e3ffde55b7414f3be
#. default-sha256: 26b09bbecb422d33c4e863fea769ce2f2535eab525dc38cf7c68db2ed815843c
msgctxt "badend3:badend3_547360EE_32D4_4534_8ED5_5D740F96586D"
msgid ""
"⟪k:0⟫But if she wants to leave all that behind her... ⟪k:1⟫then it’s not my place to interfere."
msgstr "⟪k:0⟫但如果，⟪k:1⟫这是她执意要舍弃的过去……⟪k:2⟫⟪k:3⟫想必谁也无法介入其中……"

#: badend3:badend3_547360EE_32D4_4534_8ED5_5D740F96686D
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: a7785473c97beb239decedfa4936108b42f1245de6f9ae16a8a7780d983dee2c
#. default-sha256: a9bf398abab5e9baa8844b7a2e77b4ca356dd464f6d8203934e806ef19a3d3a6
msgctxt "badend3:badend3_547360EE_32D4_4534_8ED5_5D740F96686D"
msgid ""
"⟪k:0⟫I’ve done things that would warrant her wanting to rewrite her past, erasing me entirely."
msgstr "⟪k:0⟫为此，⟪k:1⟫她甚至都不惜修改这段往事，⟪k:2⟫更到了打算消除我「存在」的程度。"

#: badend3:badend3_14501C98_A043_4232_9EFD_BCFC5DCC400A
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 2f430b1f84d8a38e6ea32c7e6e0c05221ae9a9beb9e01b84f3cb95cf7342ebe4
#. default-sha256: a5d15b77de330d063dd2f3769aeb921569b6708d73845743102efbfc20b17035
msgctxt "badend3:badend3_14501C98_A043_4232_9EFD_BCFC5DCC400A"
msgid "⟪k:0⟫But I think, more than anything..."
msgstr "⟪k:0⟫比起其他，⟪k:1⟫我——⟪k:2⟫一定……"

#: badend3:badend3_71304866_D2C8_406C_A8AF_B269483EF474
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 8b906d656017f25448b66ff06e32b07d587d08d487ccbfd6ec26ab520e922b2d
#. default-sha256: 0abb214f4fb85becd70e592e0854100b16639b5df0033dc362950db30a5522f1
msgctxt "badend3:badend3_71304866_D2C8_406C_A8AF_B269483EF474"
msgid "⟪k:0⟫I’m afraid of hurting her, of breaking her any more than she already is."
msgstr "⟪k:0⟫更害怕她会受到更多的伤害……⟪k:1⟫甚至招致她崩溃。"

#: badend3:badend3_202FBE8C_5025_42D3_AB14_844F51FDD442
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 5e4832fc8aed08f076c0ec173fcec820ad76a28f1d4e4b7d818933f80c5a1f5d
#. default-sha256: f936bce13f82773c0ea58fb2496a5d34db99b0ef1661f312f19380767e14ae85
msgctxt "badend3:badend3_202FBE8C_5025_42D3_AB14_844F51FDD442"
msgid "⟪k:0⟫⟪k:1⟫⟪k:2⟫............"
msgstr "⟪k:0⟫⟪k:1⟫⟪k:2⟫…………"

#: badend3:badend3_63F96811_C8E8_4907_87B9_416FA37B0D60
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 0ef24fc1aee86798332b8ab4f120bd722b02b69b31f311b16dbd09e2e700eb73
#. default-sha256: 01468d9315ab053a474b82cb12b7ede28cc242a1a00c8d3a11f32fbb10d6b1ff
msgctxt "badend3:badend3_63F96811_C8E8_4907_87B9_416FA37B0D60"
msgid ""
"⟪k:0⟫No, mine is a more cowardly fear.⟪k:1⟫⟪k:2⟫I’m just afraid she’ll no longer take my hand."
msgstr ""
"⟪k:0⟫不，⟪k:1⟫并非如此……⟪k:2⟫我只是胆怯而已。⟪k:3⟫⟪k:4⟫害怕着……⟪k:5⟫会再也无法触碰到她的手。"

#: badend3:badend3_9B32C9AE_4431_40EB_8BDD_4E5E2BDCC447
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 21969b9f33780faddd4288a3d5a20ed91cbb532ca5abe32f3256faa84a99587c
#. default-sha256: b13a3cfb8e1620bb5fc3535cd9870015f9bdbe9e6cd7cbab40f79b2130799137
msgctxt "badend3:badend3_9B32C9AE_4431_40EB_8BDD_4E5E2BDCC447"
msgid "⟪k:0⟫⟪k:1⟫All right... ⟪k:2⟫then..."
msgstr "⟪k:0⟫⟪k:1⟫我……⟪k:2⟫明白了……"

#: badend3:badend3_F984F247_AA15_40B3_9095_233FAF5E052E
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 65d6835e911dae22dfb228da6e863b700baf80a1845768755261f176b0a5be69
#. default-sha256: 357052a2559a6aa001bd61f6c717db8573f3fa05b649fc10d9c20b92c801f4ec
msgctxt "badend3:badend3_F984F247_AA15_40B3_9095_233FAF5E052E"
msgid "⟪k:0⟫What should have been behind the door... ⟪k:1⟫was our life together."
msgstr "⟪k:0⟫理应在那扇「门」深处的，⟪k:1⟫其实……⟪k:2⟫⟪k:3⟫就是我和她的那段过往。"

#: badend3:badend3_F35D6B1C_3494_447D_A012_22EF8C656B19
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 576a6f1675982a2c2740cab036a3a42dbc7393d5dc4a864c6825b4d486732692
#. default-sha256: 8248ced288add7ac551a2932ca75f675f563bc889a9f189ea19c522cd6a7b0df
msgctxt "badend3:badend3_F35D6B1C_3494_447D_A012_22EF8C656B19"
msgid ""
"⟪k:0⟫But for her, there’s nothing but misery there anymore.⟪k:1⟫⟪k:2⟫In our time together, and in "
"me."
msgstr "⟪k:0⟫然而那些……⟪k:1⟫对她来说，⟪k:2⟫只不过是痛苦的每一天。⟪k:3⟫⟪k:4⟫连我的「存在」也是如此。"

#: badend3:badend3_B135271A_95CE_45F0_A7ED_3B803136CB56
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 20b577ea75bd83c905c23c51c5111ec1d2012a595acdc7e719c654366b6adabd
#. default-sha256: 3196eb4a48567ba7a27d1d1defa99f47373e568bc5a64653e159971714ca14ca
msgctxt "badend3:badend3_B135271A_95CE_45F0_A7ED_3B803136CB56"
msgid ""
"⟪k:0⟫Forget everything I’ve said.⟪k:1⟫⟪k:2⟫The tale within the fourth door was the whole truth."
msgstr "⟪k:0⟫……请忘了我说过的话吧。⟪k:1⟫⟪k:2⟫你展示给我看的门的那侧……⟪k:3⟫便是所有的真实。"

#: badend3:badend3_A6302219_4360_40D0_9A8C_5619F188455C
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 044730e8cf9a6b26a33d5ed89b940e41c63167cd347fca6a6434e07c7f8ab9e9
#. default-sha256: ab3289b1ca9e4d563f35bf0644276776269464a8db45cdabc1b08788988e3e01
msgctxt "badend3:badend3_A6302219_4360_40D0_9A8C_5619F188455C"
msgid "⟪k:0⟫I can live with that."
msgstr "⟪k:0⟫那就足够了……"

#: badend3:badend3_FAF57415_6FEA_4EBA_83E5_5340DBE4ADA7
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: df1b4f7e143594260064b30cc5bd6b4deb8236b789ae1351a66c2bcc4d13cd45
#. default-sha256: 2aa1d7460ff430b8623d3605c35ac74b41d2146c07c950d741560ead598cbc1a
msgctxt "badend3:badend3_FAF57415_6FEA_4EBA_83E5_5340DBE4ADA7"
msgid "⟪k:0⟫⟪k:1⟫....................."
msgstr "⟪k:0⟫⟪k:1⟫…………………"

#: badend3:badend3_F205E639_DF0B_4F13_BC4F_A7D8A77FE9A0
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 3204452aed5348bb6ea33dba3b95c7420a6eecc2acb6fc4e17225786dfc5d14b
#. default-sha256: 4980b0123d738c94c4515302105e52eb471137ca866f47185072a2786e304bd8
msgctxt "badend3:badend3_F205E639_DF0B_4F13_BC4F_A7D8A77FE9A0"
msgid ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫I would just ask you to allow me one thing...⟪k:3⟫⟪k:4⟫To remain by your side."
msgstr "⟪k:0⟫⟪k:1⟫⟪k:2⟫只有一件事，⟪k:3⟫希望你能答应……⟪k:4⟫⟪k:5⟫让我……⟪k:6⟫留在你的身边……"

#: badend3:badend3_1CBBB369_2794_43B9_9D76_29CBF71151CD
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 1e2b2e6216298e2d854b46b2d9cb1a7c4c12b2fb8bb862355a4193c6ae1a6464
#. default-sha256: 8e1064cac73d2de02fd78273af28d85c80a2310dea86c677e7c53e3c44fb5956
msgctxt "badend3:badend3_1CBBB369_2794_43B9_9D76_29CBF71151CD"
msgid "⟪k:0⟫⟪k:1⟫I..."
msgstr "⟪k:0⟫⟪k:1⟫……这种事……"

#: badend3:badend3_7617E012_B4C3_4E0E_9BDF_9A7BF2BC9F7F
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: b63d83d04689a3bba71003f3cdd31e8e5fa6660bdf5480f655e83119822fe1db
#. default-sha256: 53e3b7673b0c4860de24e2e3feda6aa8d9590320fb1a9d02bab97a073dc16487
msgctxt "badend3:badend3_7617E012_B4C3_4E0E_9BDF_9A7BF2BC9F7F"
msgid "⟪k:0⟫⟪k:1⟫Of course you may."
msgstr "⟪k:0⟫⟪k:1⟫当然可以，⟪k:2⟫不是已经这样决定了吗？⟪k:3⟫⟪k:4⟫因为下仆之前，⟪k:5⟫就如此提及过。"

#: badend3:badend3_B66E0276_AEE5_48AA_84C5_BBE775A309AE
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 3ac61fb3ff4b5922f2cca39f73122132417f93f0609ca5cd9593e22917d4e58a
#. default-sha256: a65b3087cae39f6a7b218d3bb466fb8388eb4675e5cf9c96dda7334e3441e830
msgctxt "badend3:badend3_B66E0276_AEE5_48AA_84C5_BBE775A309AE"
msgid ""
"⟪k:0⟫⟪k:1⟫I was the one who asked you...⟪k:2⟫⟪k:3⟫to forget about everything and live in eternal "
"darkness with me."
msgstr "⟪k:0⟫⟪k:1⟫在这永恒不变的黑暗中，⟪k:2⟫把一切都忘却……⟪k:3⟫⟪k:4⟫与下仆一起度过余生。"

#: badend3:badend3_889CF03A_8988_4A6B_9154_05B232166190
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: e989a296144fe3575ad1a6654e5aaf43a0a20d0f22ea9a7193722d1585cc46d3
#. default-sha256: fca408032a8595e9d2ef5a99973274861db7ceaf61c98cda04cea6d70c8028f4
msgctxt "badend3:badend3_889CF03A_8988_4A6B_9154_05B232166190"
msgid "⟪k:0⟫⟪k:1⟫Hehe... ⟪k:2⟫what a silly question.⟪k:3⟫⟪k:4⟫Did you think I would ever say no?"
msgstr "⟪k:0⟫⟪k:1⟫呵呵……⟪k:2⟫您真是个奇怪的人。⟪k:3⟫明明知道下仆我是不会拒绝的。"

#: badend3:badend3_CD69DE7F_D1E0_4D28_A5A9_DD42EFFE124E
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 5e4832fc8aed08f076c0ec173fcec820ad76a28f1d4e4b7d818933f80c5a1f5d
#. default-sha256: f936bce13f82773c0ea58fb2496a5d34db99b0ef1661f312f19380767e14ae85
msgctxt "badend3:badend3_CD69DE7F_D1E0_4D28_A5A9_DD42EFFE124E"
msgid "⟪k:0⟫⟪k:1⟫⟪k:2⟫............"
msgstr "⟪k:0⟫⟪k:1⟫⟪k:2⟫…………"

#: badend3:badend3_58A47977_610A_406A_A124_07F807C0BEC9
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: dd87f121ed63cf6ec7c7eea27d22db4cff81fa446899d2d61dbff004121ff7f2
#. default-sha256: 970cc279155a907f0697769e99488e8dc62a8a2ef094d0d4f5d7de21e421ce01
msgctxt "badend3:badend3_58A47977_610A_406A_A124_07F807C0BEC9"
msgid "⟪k:0⟫Right...⟪k:1⟫⟪k:2⟫You did, didn’t you?"
msgstr "⟪k:0⟫是么……⟪k:1⟫大概……是这样吧……"

#: badend3:badend3_BCB801E7_1364_4128_8DD0_6657F4D6B165
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: dcf3b753638133f082bf5c3e44d423d0a79fc0f9e1f6b44485c729ec6709a244
#. default-sha256: bb81968c2761cd8e8dd065e81b8efd4877fd80eec15f3e978d5d3b66a33bfddd
msgctxt "badend3:badend3_BCB801E7_1364_4128_8DD0_6657F4D6B165"
msgid ""
"⟪k:0⟫⟪k:1⟫Yes, I did. ⟪k:2⟫Worry not, I will banish the memory.⟪k:3⟫⟪k:4⟫I am sure you were "
"simply disoriented at having learned who you are."
msgstr ""
"⟪k:0⟫⟪k:1⟫嗯，⟪k:2⟫正是如此。⟪k:3⟫没关系，⟪k:4⟫您刚才说的话，⟪k:5⟫下仆会将其忘却的。⟪k:6⟫⟪k:7⟫一定"
"是您找回自我时，⟪k:8⟫产生了混乱吧。"

#: badend3:badend3_A1187E10_34D3_4C5E_8103_EA7C68FA9C4A
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 62da62da4a0c7c60024563d8b82bff9f9a256b08246ba04f993fafd30dcbb6b2
#. default-sha256: bd4dcc05939b66621d87d3ea174ca30225bbeacbff55836feba53c25e47baada
msgctxt "badend3:badend3_A1187E10_34D3_4C5E_8103_EA7C68FA9C4A"
msgid "⟪k:0⟫⟪k:1⟫There is nothing to fear.⟪k:2⟫⟪k:3⟫Only happiness awaits you."
msgstr ""
"⟪k:0⟫⟪k:1⟫但是，⟪k:2⟫已经没事了。⟪k:3⟫不会再有可怕之事了。⟪k:4⟫⟪k:5⟫是的，⟪k:6⟫今后等待我们的，"
"⟪k:7⟫只有幸福。"

#: badend3:badend3_3F28DBBC_B943_4C4C_B38C_3B9F909A66AC
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 5e4832fc8aed08f076c0ec173fcec820ad76a28f1d4e4b7d818933f80c5a1f5d
#. default-sha256: f936bce13f82773c0ea58fb2496a5d34db99b0ef1661f312f19380767e14ae85
msgctxt "badend3:badend3_3F28DBBC_B943_4C4C_B38C_3B9F909A66AC"
msgid "⟪k:0⟫⟪k:1⟫⟪k:2⟫............"
msgstr "⟪k:0⟫⟪k:1⟫⟪k:2⟫…………"

#: badend3:badend3_5E64EA09_117B_4525_A7F3_166A536C201C
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: cc015bcf7dad27803e991a5fca4be926870d041f415007f6316e2cc31106adac
#. default-sha256: 05978a0309f205b4a03beb473133a2a8da201fa97748b52746b60d67b8090f5f
msgctxt "badend3:badend3_5E64EA09_117B_4525_A7F3_166A536C201C"
msgid "⟪k:0⟫⟪k:1⟫Hehehe. I am getting excited now.⟪k:2⟫⟪k:3⟫What should we do first?"
msgstr "⟪k:0⟫⟪k:1⟫呵呵，⟪k:2⟫接下来的日子想必会非常愉快吧。⟪k:3⟫⟪k:4⟫首先要做些什么呢？"

#: badend3:badend3_432A5F2E_31DA_49C2_A4E2_ABE599E5AE13
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 4fb5b8f774f2589708992938a20f71edd01f30fda7bde4352dcbe7d41e96c19c
#. default-sha256: 9a03d0440f20d9e58533935625cab3224ec157d04295c2f418ac3d7c55f2d2ae
msgctxt "badend3:badend3_432A5F2E_31DA_49C2_A4E2_ABE599E5AE13"
msgid ""
"⟪k:0⟫⟪k:1⟫Oh, I know. We should throw a party in commemoration of your decision to remain here "
