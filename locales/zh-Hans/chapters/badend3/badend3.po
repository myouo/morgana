msgctxt "badend3:badend3_04CA0963_58FC_4FFE_AD57_D1DD77712DF6"
msgid "⟪k:0⟫But she won’t say my name."
msgstr "⟪k:0⟫……她绝不叫我的名字。"

#: badend3:badend3_99892610_1DF8_4619_982C_10B67EF1C9FE
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: e2ada6e4cd60302783ad1a1f30020d862158ee4cf60cdf482b007185f4566bcd
