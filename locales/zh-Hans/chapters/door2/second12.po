#: scenario2:scenario2_111F5064_ADFE_466A_A14C_A75FD5928ADF
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 6f843bef42a0b069bc10406ffe3fd48d60adb8b5f56263ef988ad0cf0c50c230
#. default-sha256: 7860bf68db29d4d3b544d3df5748d3e3d503366882f8defef774e70681194965
msgctxt "scenario2:scenario2_111F5064_ADFE_466A_A14C_A75FD5928ADF"
msgid "⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫⟪k:4⟫⟪k:5⟫⟪k:6⟫⟪k:7⟫⟪k:8⟫...Master. Master."
msgstr "⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫⟪k:4⟫⟪k:5⟫⟪k:6⟫⟪k:7⟫⟪k:8⟫……老爷，⟪k:9⟫老爷。"

#: scenario2:scenario2_11F56EE0_9C38_4F29_B74A_6FCC8A325BC3
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: a2e01f2fd468e189f82f4f16c274b2b9b5969274f0f2bcf5ee53de5fbf5a018b
#. default-sha256: 51a1d7d6819ec18507e7f140c52fada10730ed6d69621738bb97686c27cfc2ee
msgctxt "scenario2:scenario2_11F56EE0_9C38_4F29_B74A_6FCC8A325BC3"
msgid "⟪k:0⟫Ahh... ⟪k:1⟫you have awakened. ⟪k:2⟫You gave me quite the startle."
msgstr "⟪k:0⟫啊……⟪k:1⟫您醒了吗？⟪k:2⟫下仆，⟪k:3⟫非常吃惊啊。"

#: scenario2:scenario2_89EE87C6_5B9A_4A0A_A1DF_5919B15040CC
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 21d5f7c1a95754ca05652ceae35d70fc067af758fb8efd89829407041a5a96b1
#. default-sha256: 6b5f39336ae5e6499756ae0d4e47e556d47cf2b85175b30e9b972b16d546dade
msgctxt "scenario2:scenario2_89EE87C6_5B9A_4A0A_A1DF_5919B15040CC"
msgid ""
"⟪k:0⟫Do you not remember? ⟪k:1⟫You suddenly started staring off into the distance, and you would "
"not respond to anything I said."
msgstr "⟪k:0⟫您不记得了吗？⟪k:1⟫您突然看向远方，⟪k:2⟫听不到下仆的声音了。"

#: scenario2:scenario2_1CC76CC7_F747_47C2_8887_23081832279C
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: e5ef6dc9bf7cbfb84fc2a6ea4affce09434512ab73620c0f46ac00a87f2b399a
#. default-sha256: 8b9144cd2e45e6b9f427a2c98983df121aff2412ab479dd1fdbdf659590b82ef
msgctxt "scenario2:scenario2_1CC76CC7_F747_47C2_8887_23081832279C"
msgid "⟪k:0⟫Hehe. I thought you were playing a prank on me."
msgstr "⟪k:0⟫呵呵，⟪k:1⟫还以为您在对下仆恶作剧呢。"

#: scenario2:scenario2_1AD64425_BDF5_4EA6_9999_FD49546236A4
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: b85858369dd811cc08065beb819429dd608821b20c0cb15ad0ef41596bfba939
#. default-sha256: b30a781486e6c366cecd13f19c8ca5d6dcd44da549a11e29eabbffa2c04e1889
msgctxt "scenario2:scenario2_1AD64425_BDF5_4EA6_9999_FD49546236A4"
msgid "⟪k:0⟫Your hand? ⟪k:1⟫Oh, yes, I did not let go of it."
msgstr "⟪k:0⟫手吗？⟪k:1⟫没问题，⟪k:2⟫一直牵着下仆的手呢。"

#: scenario2:scenario2_1A399BDF_5BE1_4A36_AB0A_D560CD523861
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: eb95f4bfd692fc16188c97a214b47370f7e4a011a96e0234782519082bcff82c
#. default-sha256: d8ae1d25dc99ae5cfcffcdecb7d9f7f7ae8d47c711102fee522e6e9dffaaaaec
msgctxt "scenario2:scenario2_1A399BDF_5BE1_4A36_AB0A_D560CD523861"
msgid "⟪k:0⟫For if I had, we would be in quite the predicament."
msgstr "⟪k:0⟫因为……⟪k:1⟫如果下仆松开您的手的话，⟪k:2⟫会发生不得了的事。"

#: scenario2:scenario2_F848F63F_7A17_4B90_B2F5_A318014EACD6
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 37c691d78b499fcda1e07f839c6a97b085f7d986a692fb542c85e315addb6d2e
#. default-sha256: 1957f42bbebc05113a256e0146d36649603e762ded027b7534b547a4a17d4961
msgctxt "scenario2:scenario2_F848F63F_7A17_4B90_B2F5_A318014EACD6"
msgid "⟪k:0⟫Someone approaching the mansion, you say? ⟪k:1⟫You saw them?"
msgstr "⟪k:0⟫哎……⟪k:1⟫您还看到了，⟪k:2⟫有人想要接近馆吗？"

#: scenario2:scenario2_A1598863_CBF6_41E4_BCFE_3F9793B411E7
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 305f8b3686d0874b8e1c7b9344d1122f442de063f78c868757566118106edab2
#. default-sha256: b7307afbdf68cfebc911ca9516098401ea865577bd737af67521709d87599290
msgctxt "scenario2:scenario2_A1598863_CBF6_41E4_BCFE_3F9793B411E7"
msgid ""
"⟪k:0⟫Those images... ⟪k:1⟫were not shown to you by me. ⟪k:2⟫If you saw something, then it was by "
"your own powers."
msgstr "⟪k:0⟫这不是下仆让您见到的景象……⟪k:1⟫如果您见到了其他景象的话，⟪k:2⟫那就是您自己的力量所致。"

#: scenario2:scenario2_71F90BF4_07DD_4E07_A132_1B71D3313736
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 26e9c716ec2f849ac6d63d879ecd4c3a6019e8ae5260c3902112a5da64e5d296
#. default-sha256: 4adde9972820c43c4d0da4910d077c0a46f36101f05922822b9d1ac83c68c9fb
msgctxt "scenario2:scenario2_71F90BF4_07DD_4E07_A132_1B71D3313736"
msgid "⟪k:0⟫But if you think about it, that is nothing unusual."
msgstr "⟪k:0⟫但是，⟪k:1⟫仔细想想这也在情理之中。"

#: scenario2:scenario2_2BC8B724_D335_4767_B5CD_FCB8966C49A9
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: b37748f68c1cc72d538a7217cc3dac01456040dd5e2b33277f9447b323be17e2
#. default-sha256: 3d5e16a212ae5753a402be619b77cdaba6c407dc5f0e16d835360b2bc01a0212
msgctxt "scenario2:scenario2_2BC8B724_D335_4767_B5CD_FCB8966C49A9"
msgid "⟪k:0⟫You are, after all, the master of this house."
msgstr "⟪k:0⟫因为您，⟪k:1⟫就是这座「馆」的主人。"

#: scenario2:scenario2_1B8C40FB_85CC_4FE2_AC7E_E24F642F5E44
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: b1bf2c2de74706e41e44b956c1593b0526e276a16edf90220b72614611c86abf
#. default-sha256: 852dc3f5e295fe531439d40c85db73610f7adfd3ce826149ddb9157e4453f359
msgctxt "scenario2:scenario2_1B8C40FB_85CC_4FE2_AC7E_E24F642F5E44"
msgid "⟪k:0⟫You should, in all actuality, be able to do anything I can do by yourself, Master."
msgstr "⟪k:0⟫下仆可以做的事情，⟪k:1⟫您原本也可以一个人做得到。"

#: scenario2:scenario2_7E71B94D_DC7F_4E9D_A51F_AD26D219E9FC
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: b228b6cb32201725097e35c2e4afa95b2f27c96fabfea77afe0581add419dad2
#. default-sha256: e4494277528ce45e9e1faf9eb32b70d6f5d8d1e96529f9f5e7ba28f8437068d1
msgctxt "scenario2:scenario2_7E71B94D_DC7F_4E9D_A51F_AD26D219E9FC"
msgid "⟪k:0⟫So it is very possible you could have knowledge that I do not."
msgstr "⟪k:0⟫所以……⟪k:1⟫您知道下仆不知道的事情，⟪k:2⟫⟪k:3⟫也不是不可能啊。"

#: scenario2:scenario2_6E2FABCA_9F64_48A0_B7E6_6CD0ADBD4555
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: b40159dadef785c5e801c50d1f1821a392b4fd1c39e81e39b94093b53fdd5a44
#. default-sha256: 2cf3cf1c64d3d6b09afdc4ae70fe9bb83808c33ded370836a5a6216d21ece66e
msgctxt "scenario2:scenario2_6E2FABCA_9F64_48A0_B7E6_6CD0ADBD4555"
msgid "⟪k:0⟫Now, let us return to the mansion’s tale."
msgstr "⟪k:0⟫那么，⟪k:1⟫让我们回到馆这边来吧。"

#: scenario2:scenario2_0F1BEE93_B1C4_4A09_B39D_E7D9E7B6F528
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: c0967a5a55f8e2adef058af1b35ac9e99e0d3bccdc5181ef2e9c11a108d1f0f2
#. default-sha256: 2308acb113a7a43c9dd5e04a1227deede9122821bacfaf4c50f17a0cd599b19d
msgctxt "scenario2:scenario2_0F1BEE93_B1C4_4A09_B39D_E7D9E7B6F528"
msgid "⟪k:0⟫After the second beast paid a visit, Bestia began to destabilize again."
msgstr "⟪k:0⟫和巴斯蒂亚相同的野兽出现以后，⟪k:1⟫他又变得狂躁不安了。"

#: scenario2:scenario2_9192764E_EBB3_456D_8944_942876725FB3
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 687e86b457feb6eb6615d27362cae76a6a0567c977030dadff2005d8bc5cbeb8
#. default-sha256: 646e6f834fbaca80238e71bfd9971735bcd6d073484285d79fb810ba31f33d93
msgctxt "scenario2:scenario2_9192764E_EBB3_456D_8944_942876725FB3"
msgid "⟪k:0⟫The White-Haired Girl would soothe his heart, but the calm was only ephemeral."
msgstr "⟪k:0⟫即使白发少女可以治愈他的心灵，⟪k:1⟫⟪k:2⟫他也只能冷静一时。"

#: scenario2:scenario2_E9596033_9464_4E27_AE7A_5F6978E107B7
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 6708a5e0c2100c00c2bc129cf9cff688eca08672e76fc5d01b544ff181969d25
#. default-sha256: 00a08459db5c19d89df6787cf8bca0f454eee246875eca2372aac521b8d60860
msgctxt "scenario2:scenario2_E9596033_9464_4E27_AE7A_5F6978E107B7"
msgid "⟪k:0⟫He was like a cracked glass ball."
msgstr "⟪k:0⟫他又变得，⟪k:1⟫像有了裂痕的玻璃珠一样——"

#: scenario2:scenario2_A0605F8E_692A_4C13_9EBC_6804BCFE93B3
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 8ca270dd950e53ec08900aab3505e3e1edcad78de2563d5b174c3d79a5c53b73
#. default-sha256: f23ebda99a26444084b07b0ad7bf5cb76bbfdcc53c1320756eaf1c496c29cb60
msgctxt "scenario2:scenario2_A0605F8E_692A_4C13_9EBC_6804BCFE93B3"
msgid ""
"⟪k:0⟫If you dropped him, that would be the end. ⟪k:1⟫If you put too much force into handling him, "
"he would shatter. ⟪k:2⟫He was very difficult to care for."
msgstr "⟪k:0⟫掉在地上的话就会摔个粉碎，⟪k:1⟫抓地过于用力也会破裂——⟪k:2⟫很难掌握尺度。"

#: scenario2:scenario2_0B4F9443_56C3_456D_B951_B6010DA695FE
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 90fc0887f4b217e1972f4c587ac136dfd143049d0aa9fe5cfe0912bc0a872354
#. default-sha256: 8d6a92774173df964595cd62fa8efd0751758e0df394a36fcad26f9d13d51b52
msgctxt "scenario2:scenario2_0B4F9443_56C3_456D_B951_B6010DA695FE"
msgid ""
"⟪k:0⟫And cracks do not heal. ⟪k:1⟫The damage still remains, even if the two sides appear to be "
"held together firmly in place."
msgstr "⟪k:0⟫而且，⟪k:1⟫裂痕也不能被修复。⟪k:2⟫⟪k:3⟫即使看起来黏在一起了，⟪k:4⟫但是裂痕依然存在。"

#: scenario2:scenario2_5A7A7FC0_467A_41A0_9F25_8AB72A3349B6
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 7b7f1ffdfb43d982bf4d04b09f1f12c04f91e1931f5a95625aa900b6f96654d2
#. default-sha256: 3b78248d2f55e82c45568919e2b96371d29b1e10bf790aa072eea5bcb02d0484
msgctxt "scenario2:scenario2_5A7A7FC0_467A_41A0_9F25_8AB72A3349B6"
msgid "⟪k:0⟫Furthermore, they slowly, gradually, and without intervention spread."
msgstr "⟪k:0⟫接着，⟪k:1⟫裂痕就会慢慢地、慢慢地，⟪k:2⟫自然而然地扩大。"

#: scenario2:scenario2_F3BEFB24_9F16_4AFE_BBF4_CCCC02D9858D
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: ff73d5ac03c6429ba9122e0b26c7c2dbbc1ee85d0e1ae08073a5192e647f9422
#. default-sha256: a6bfc248af5f997e99f62422a016d85adcd9f025faa1328d7e4a4d554da65b00
msgctxt "scenario2:scenario2_F3BEFB24_9F16_4AFE_BBF4_CCCC02D9858D"
msgid "⟪k:0⟫The beast appeared to be afraid of someone’s voice."
msgstr "⟪k:0⟫野兽，⟪k:1⟫害怕着某人发出的声音。"

#: scenario2:scenario2_3CCE8F83_81C4_47D8_99D2_C77A99D5C210
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 67dd23036ca2aafae0e7e265d34f058cb8b4c19366c4f6387654246a3ac7398e
#. default-sha256: b2c2fc5b24818723642b9c2422831cb4aed92b91f2adc05b97cd5e4da8c0fa09
msgctxt "scenario2:scenario2_3CCE8F83_81C4_47D8_99D2_C77A99D5C210"
msgid "⟪k:0⟫He would on occasion stare into empty space and shout, cover his ears, and groan."
msgstr "⟪k:0⟫有时仰望着天，⟪k:1⟫破口大骂，⟪k:2⟫堵住耳朵，⟪k:3⟫不住呻吟。"

#: scenario2:scenario2_3602D6A7_C211_42BD_B283_E0DEACB10FD7
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 61384005b0031d3e4f7a1320becdf5160a37351b8ea15c8d9a0b6f5ccd8d7c51
#. default-sha256: d7d9eb0335f85d65a5a887643b469f6b70722aec2ff18b3f7f0cfac8c94c3a3b
msgctxt "scenario2:scenario2_3602D6A7_C211_42BD_B283_E0DEACB10FD7"
msgid ""
"⟪k:0⟫One day, he shattered all the windows in the mansion, crushed the silverware I had just "
"polished to a shine..."
msgstr "⟪k:0⟫有时破坏馆的窗户，⟪k:1⟫连下仆辛辛苦苦擦干净的餐具也被摔个粉碎……"

#: scenario2:scenario2_E717A328_7A1E_4C98_AEC3_5BA798EE0BCD
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: da0190332088bc226d9a5bd198705c3124880acd5febb5134208928e66d31a9e
#. default-sha256: 6c8aa22c8da22d4fec09ffe5d21f2712159ebddf82916773f32651ee642bb3b5
msgctxt "scenario2:scenario2_E717A328_7A1E_4C98_AEC3_5BA798EE0BCD"
msgid "⟪k:0⟫and destroyed all the mirrors."
msgstr "⟪k:0⟫是的，⟪k:1⟫连穿衣镜也被摔坏了。"

#: scenario2:scenario2_3D6268C8_5E43_4895_85B3_41C34C8C23E7
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 8072edcc52a11c8fbdd85a35d39d0e2c91943529f348c6858c617f523a5e7c2e
#. default-sha256: 0e2095b139cb306282308894a3d695bbe16bde2108d8bc5d4594fa0ba220061b
msgctxt "scenario2:scenario2_3D6268C8_5E43_4895_85B3_41C34C8C23E7"
msgid "⟪k:0⟫I assume he did not want to see his beastly self."
msgstr "⟪k:0⟫他一定是——⟪k:1⟫不想看到变成野兽的自己吧。"

#: scenario2:scenario2_E6660BE9_C4A9_4F2A_900C_9387CC154EA2
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 98253c9856195cdc2c55c4de4cac58dfcf99437660d07fdc4805189784790da7
#. default-sha256: 9054590110c83f343dcc98a79f767d974c454a5c24322e58275ea1e433eab596
msgctxt "scenario2:scenario2_E6660BE9_C4A9_4F2A_900C_9387CC154EA2"
msgid ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫⟪k:4⟫⟪k:5⟫⟪k:6⟫⟪k:7⟫⟪k:8⟫⟪k:9⟫More... ⟪k:10⟫There’s more!⟪k:11⟫⟪k:12⟫There’s "
"still more that reflects my image!"
msgstr ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫⟪k:4⟫⟪k:5⟫⟪k:6⟫⟪k:7⟫⟪k:8⟫⟪k:9⟫还有……⟪k:10⟫还有啊！⟪k:11⟫怎么还有……⟪k:12⟫能映出"
"我相貌的东西啊！"

#: scenario2:scenario2_0E8A774D_89D2_40BB_B08E_32EBA92EA1AD
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 35f712744050cac7137b0836fa84b547a76c99edcc0dc81f467df46eb9a8ea38
#. default-sha256: 992866633254d3420e0fe95077d11a35f6d08eb6bbe069640ba0cd9e2505d6cb
msgctxt "scenario2:scenario2_0E8A774D_89D2_40BB_B08E_32EBA92EA1AD"
msgid "⟪k:0⟫Windows! Mirrors! Vases! Dishes!⟪k:1⟫They all show my reflection!"
msgstr "⟪k:0⟫窗户！⟪k:1⟫镜子！⟪k:2⟫水壶！⟪k:3⟫餐具也是……⟪k:4⟫都能映出我的相貌！"

#: scenario2:scenario2_30E1C98F_85D0_415D_9596_F850209C4998
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: ce27f6c8fae2f324755577dfdf8cdbc1f41f6abcc999210d98676b0d31c35e23
#. default-sha256: abc900ed6dc8a5f40954259c910301203e2692265edeaa3d3fd5872b13ce0d4c
msgctxt "scenario2:scenario2_30E1C98F_85D0_415D_9596_F850209C4998"
msgid "⟪k:0⟫⟪k:1⟫⟪k:2⟫Wh-⟪k:3⟫What are you doing?"
msgstr "⟪k:0⟫⟪k:1⟫⟪k:2⟫……您⟪k:3⟫……您这是在干什么？"

