#: scenario2:scenario2_4FB9BE99_E991_4348_BF2C_AAE9EC246D9C
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 59b1811781d210744c0855067d0c755b49383a7d6c91d43625cd0af520707ac0
#. default-sha256: 1b5016901a223d2beb7fc0b64d175b1ba09d96781cdc72eb986a3b31419c7010
msgctxt "scenario2:scenario2_4FB9BE99_E991_4348_BF2C_AAE9EC246D9C"
msgid ""
"⟪k:0⟫(They tried to kill me. ⟪k:1⟫They looked like they were going to kill me. ⟪k:2⟫I almost "
"died.)"
msgstr "⟪k:0⟫（他们要杀我。⟪k:1⟫那是要杀人的眼神。⟪k:2⟫我要被杀了）"

#: scenario2:scenario2_6878EECE_F0A0_4A0C_99B8_F31B7856AA18
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 168804d1e89b8a6fc00f3d4716aaf2066902b5e82f4220518bf7355837d59ba1
#. default-sha256: 17f7027181ab00a88120ac62ac390810c116227c985846724bb7a3ae5f13fd2d
msgctxt "scenario2:scenario2_6878EECE_F0A0_4A0C_99B8_F31B7856AA18"
msgid ""
"⟪k:0⟫(I’m on the verge of death even now.⟪k:1⟫⟪k:2⟫My throat is sore. It hurts...⟪k:3⟫⟪k:4⟫No, I "
"don’t feel pain anymore.⟪k:5⟫⟪k:6⟫It burns? ⟪k:7⟫Does it burn?)"
msgstr ""
"⟪k:0⟫（现在……⟪k:1⟫我要被杀了。⟪k:2⟫脖子被人掐住了。⟪k:3⟫甚至……⟪k:4⟫连痛觉都消失了。⟪k:5⟫热？⟪k:6⟫"
"热吗？ ）"

#: scenario2:scenario2_8465DC16_4693_4DB0_A6F3_7B138CE27BBE
