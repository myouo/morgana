msgid "⟪k:0⟫⟪k:1⟫Mmm..."
msgstr "⟪k:0⟫⟪k:1⟫嗯……"

#: scenario2:scenario2_59EC1995_9F69_4928_B63F_A488984FD7D5
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: dc1e871c85c207f1ad6e8372bb5772e78e832c3693216daff84c8270ce56669c
