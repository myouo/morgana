msgctxt "scenario2:scenario2_9270F5AA_73DF_4E06_B990_CAA0DAE3F39B"
msgid "⟪k:0⟫That’s not what I meant!"
msgstr "⟪k:0⟫不是这样的！"

#: scenario2:scenario2_8CB2E2B1_B83D_435B_B406_C5A1239B2153
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: ceb1740b5177286b64b34575eb1688e999899650c98e84ad8fb391d4a5c9d1ca
