msgid "⟪k:0⟫⟪k:1⟫Heh... ⟪k:2⟫hahaha."
msgstr "⟪k:0⟫⟪k:1⟫没有……⟪k:2⟫哈哈哈。"

#: scenario2:scenario2_80C3940B_11E4_4E06_9951_89B2F8319147
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 4a603b6ce95dc397d4ff64a9a96d61d8126f09b61e0f00f94d5b210786f8a869
#. default-sha256: 73edad6933941668ad6dda9bf0b545389d52aea03596e34e52cc8df9997f0872
msgctxt "scenario2:scenario2_80C3940B_11E4_4E06_9951_89B2F8319147"
msgid "⟪k:0⟫⟪k:1⟫⟪k:2⟫I’m a huge fan of this country’s food."
msgstr "⟪k:0⟫⟪k:1⟫⟪k:2⟫我喜欢这个国家的食物。"

#: scenario2:scenario2_1DD2EEC4_9504_480C_A032_69636D6B850E
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: b5870c453722810831a536cb1968cddd7af6732d2ca36cab58306ff7df5c1830
