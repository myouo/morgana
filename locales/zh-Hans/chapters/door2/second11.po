msgid "⟪k:0⟫⟪k:1⟫I could hear the cry of seagulls from the restaurant’s terrace."
msgstr "⟪k:0⟫⟪k:1⟫餐馆的露台上，海猫在鸣叫。"

#: scenario2:scenario2_1E8DEAC5_3FD8_4F83_89B7_1E384764178A
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: e9ae614420b6959eba4601ae3b9601b874c9cbe447377253c0aef008dba02682
