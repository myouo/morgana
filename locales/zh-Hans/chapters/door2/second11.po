msgid "⟪k:0⟫⟪k:1⟫The heat was searing."
msgstr "⟪k:0⟫⟪k:1⟫烈日炎炎。"

#: scenario2:scenario2_CFD43D05_666D_4CA7_A856_FF12D3099C17
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: fd2c9a9c4c89ec34033527f56a2bd29ea552a549856084a0aa5964e9d6e6ed91
