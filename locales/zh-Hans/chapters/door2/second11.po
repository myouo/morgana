msgid "⟪k:0⟫⟪k:1⟫I thought for sure I would get burnt"
msgstr "⟪k:0⟫⟪k:1⟫在热得快把人煮熟的盛夏，阳光像恶魔一样狠狠地照射着。"

#: scenario2:scenario2_6E0919BF_7CA9_41E4_A5E1_8827B1C7E69F
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: a881139c1ce9a8e954576f012ba7d7708b49b7a06f8665ae6b0e72dfe5701d6f
#. default-sha256: 844915fa28f073b3823ce3089404bc589a3311d1431cc01801a95e471d26cc3c
msgctxt "scenario2:scenario2_6E0919BF_7CA9_41E4_A5E1_8827B1C7E69F"
msgid "⟪k:0⟫⟪k:1⟫sitting beneath the hellishly pounding sun⟪k:2⟫⟪k:3⟫on that sweltering summer day."
msgstr "⟪k:0⟫⟪k:1⟫让人不禁想到「啊，要被烤焦了」。"

#: scenario2:scenario2_995BF6DF_D742_4CF8_947F_12E82EAC6804
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: ae121aa7bd456084cbf6dd2e528410eb253c1d11aebf04df1f53b62a4bd2b3ee
#. default-sha256: c3440b8596beee06162c73de857b98452401741e15ebf2806789a9dbf404033b
msgctxt "scenario2:scenario2_995BF6DF_D742_4CF8_947F_12E82EAC6804"
msgid "⟪k:0⟫⟪k:1⟫It’s only ever on days such as those⟪k:2⟫⟪k:3⟫that we end up having lunch outside."
msgstr "⟪k:0⟫⟪k:1⟫偏偏这种天气，还要去外面吃饭。"

#: scenario2:scenario2_2CB60A18_9FD7_4795_B2D0_05EDFC4001B0
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 6abdaa0ba65332bbacdac78bb5dfed440eca9be7dd34a22f0f32531e4e441f77
