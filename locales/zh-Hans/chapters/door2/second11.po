msgid "⟪k:0⟫⟪k:1⟫⟪k:2⟫I-⟪k:3⟫Indeed... ⟪k:4⟫Yes, it is."
msgstr "⟪k:0⟫⟪k:1⟫⟪k:2⟫啊……⟪k:3⟫啊，⟪k:4⟫是的……"

#: scenario2:scenario2_3A8CFF89_3E95_459A_8AC8_A88B0B6A63BF
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 27d8a5e257234a032ccba340720714441facc9559dd46bb839c65eaba76c6f52
