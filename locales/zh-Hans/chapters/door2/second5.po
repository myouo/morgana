msgid "⟪k:0⟫............"
msgstr "⟪k:0⟫…………"

#: scenario2:scenario2_8673E044_1B98_4FBC_BB7C_DC6901A79B14
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 9a0802b8215f112c5bcea9671a49d465e9223470fbb54c01b5642aeb52a038d2
#. default-sha256: 84b67157827a38affb1a4e663c7179ba8f76cfa96414eb415e383501ed022f0c
msgctxt "scenario2:scenario2_8673E044_1B98_4FBC_BB7C_DC6901A79B14"
msgid "⟪k:0⟫⟪k:1⟫⟪k:2⟫Then... ⟪k:3⟫I suppose I shall take you up on your generosity."
msgstr "⟪k:0⟫⟪k:1⟫⟪k:2⟫那么……⟪k:3⟫我就恭敬不如从命了……"

#: scenario2:scenario2_4085474D_5FA7_4CF4_ABDB_FDCE6F5B07F2
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 4c9f86d6f28ba8f56341a343d023f08b0c54e52566133e00faec7c193c2db719
