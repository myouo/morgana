msgctxt "scenario2:scenario2_E3B8080E_64F4_494C_8748_E633AB9B7B86"
msgid "⟪k:0⟫I’ve lost my way.⟪k:1⟫⟪k:2⟫Would you please be so kind as to spare me a little food?"
msgstr "⟪k:0⟫我迷路了。⟪k:1⟫拜托了，⟪k:2⟫能给我一点食物吗？"

#: scenario2:scenario2_393C0C24_4D7B_48DD_9E86_86F245D56355
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: ab3728f28af4833f835bbd010527d4631d4447661818ce76cca2ff12fa52ee96
#. default-sha256: 67fc436962bc67d38bf430bfb17c5e5ca1464fbccd5ea6c96a03c771dd0fb2fe
msgctxt "scenario2:scenario2_393C0C24_4D7B_48DD_9E86_86F245D56355"
msgid "⟪k:0⟫(Ahh, there. ⟪k:1⟫There it is.⟪k:2⟫⟪k:3⟫There comes the poor little offering.)"
msgstr "⟪k:0⟫（啊啊、⟪k:1⟫来了。⟪k:2⟫来了。⟪k:3⟫可怜的贡品来了）"

#: scenario2:scenario2_279D4872_C4C0_47DC_8CB3_5822826870D7
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 594da1b343da8e93a6b7e685631beb01788c7a015042ff7907b3356f0878e524
#. default-sha256: 6a2d71209c4867f9c61de76ef9e446e5918c6ffd7693b2986d63232ec16e14d7
msgctxt "scenario2:scenario2_279D4872_C4C0_47DC_8CB3_5822826870D7"
msgid ""
"⟪k:0⟫(They never learn.⟪k:1⟫⟪k:2⟫They just keep coming, again and again.⟪k:3⟫⟪k:4⟫The mansion "
"keeps granting my wish.)"
msgstr "⟪k:0⟫（也不接受教训，⟪k:1⟫总是、⟪k:2⟫总是、⟪k:3⟫到这里来。⟪k:4⟫ 「馆」一直在实现我的愿望）"

#: scenario2:scenario2_AAC6CF58_B448_4F28_812F_98CBE17BDAD9
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 496642027eb7fa4eb4c40ef8b766e7278474c4939ae1758b0924c474c01e6347
#. default-sha256: 621f03340fbad208bbd1768445a56b64e3c893a2f32c3a083df7f29d78c14da8
msgctxt "scenario2:scenario2_AAC6CF58_B448_4F28_812F_98CBE17BDAD9"
msgid "⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫⟪k:4⟫I would be glad to provide you some food."
msgstr "⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫⟪k:4⟫……食物的话，⟪k:5⟫我会让女仆准备的。"

#: scenario2:scenario2_0E8D56ED_B04A_4486_8890_8D54FDBC5C4C
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 6dce5311a4e81d0692c8f25175382d9ac0db37cbcd3640785d610dffff2d9149
