msgid "⟪k:0⟫Is anyone... ⟪k:1⟫Is anyone there?"
msgstr "⟪k:0⟫请问……⟪k:1⟫有人在吗？"

#: scenario2:scenario2_E3B8080E_64F4_494C_8748_E633AB9B7B86
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: dfb5f8fd822637578a1ca18a65d3f36cfe2ebca756a8c996980c8b251a8cfe87
