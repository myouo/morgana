#: scenario2:scenario2_1E6C256C_B493_478B_9873_8BF3B45AB41F
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 4fdaf35024dc77424da7f4f025d287c9001275d718d7af956d1ee72db9831d0a
#. default-sha256: f0e0eda0a08dd95d089d9a83ec8c607d475264b76c9a89d6835d44f1f9990b28
msgctxt "scenario2:scenario2_1E6C256C_B493_478B_9873_8BF3B45AB41F"
msgid ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫⟪k:4⟫⟪k:5⟫⟪k:6⟫Without exception, everyone who had wandered into the mansion "
"had lost their lives before the sun rose the next morning."
msgstr ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫⟪k:4⟫⟪k:5⟫⟪k:6⟫到这个馆的迷路者，⟪k:7⟫无一例外，⟪k:8⟫还没有等到天明，⟪k:9⟫就命"
"丧黄泉了。"

#: scenario2:scenario2_C93420F3_8FFA_40B7_B856_1FE1F8A0466F
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 679977c086a04ed14928c9916427807dd26df858e357bdc36826c42bebf11c92
#. default-sha256: d4b5542697ac6aa975bd3bb8b25bcd19a15007cfe7d4328cb3a8e8ce7e18c2b2
msgctxt "scenario2:scenario2_C93420F3_8FFA_40B7_B856_1FE1F8A0466F"
msgid "⟪k:0⟫She was the first visitor who had not met this fate."
msgstr "⟪k:0⟫所以，⟪k:1⟫她是第一个例外。"

#: scenario2:scenario2_CAC6C91A_DD29_4811_9238_F2717385F7F9
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 4aa600b175b5dbab85be3fefc398bd662b0aa033aec5e40e49a81d7951c98a55
#. default-sha256: 638e555c0f0ae22bed73075a046a09799d9d82c8d3eb6b07aff416e44da9efdb
msgctxt "scenario2:scenario2_CAC6C91A_DD29_4811_9238_F2717385F7F9"
msgid ""
"⟪k:0⟫Over time, Bestia’s madness gradually subsided; ⟪k:1⟫he even began to seem rather tame. ⟪k:2⟫"
"You would hardly believe it was the same beast who had once reveled in those perverse festivities."
msgstr ""
"⟪k:0⟫巴斯蒂亚渐渐隐藏了自己的狂气，⟪k:1⟫而且变得温和多了。⟪k:2⟫根本看不出来他曾经是享受扭曲盛宴的"
"野兽。"

#: scenario2:scenario2_1D47DDF0_66D0_43BB_9984_D2296BE1DCDC
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: ec2ed1450fa8164095f43db6d949ed4cb260307588161c05180ab893800f974c
#. default-sha256: 58c7b758f2ca1cbe806781bf44b552ef4928df016d0e35b5d9b669e5eb2a1edc
msgctxt "scenario2:scenario2_1D47DDF0_66D0_43BB_9984_D2296BE1DCDC"
msgid "⟪k:0⟫He was, I imagine, at a loss for how to behave."
msgstr "⟪k:0⟫也许连野兽自己，⟪k:1⟫也不知该如何是好了。"

#: scenario2:scenario2_1FE82314_7A96_4ED8_9B20_9E78C3AB7AA3
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 058739f3901730b21eb0fca1480474799d96ed36219db964bf0d6273d1e40818
#. default-sha256: a6c298090e660b9cb969af20ed2bcd63be53f629c9032197f0dce61f124a5040
msgctxt "scenario2:scenario2_1FE82314_7A96_4ED8_9B20_9E78C3AB7AA3"
msgid "⟪k:0⟫I too would be flustered in the constant presence of such beauty."
msgstr "⟪k:0⟫有如此美人相伴，⟪k:1⟫就连下仆我也有所动摇呢。"

#: scenario2:scenario2_E0F46256_924E_4B46_9D3D_844EE9C51BC8
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: a2bc44084fdf486c56c8e5de955473b86d527116f927f3ea9cc80279c8575e7c
#. default-sha256: 50f9363bcfb0f8fdbf88a256810190b5ef4f71ddd39be0659c2b84d0d0ab4524
msgctxt "scenario2:scenario2_E0F46256_924E_4B46_9D3D_844EE9C51BC8"
msgid ""
"⟪k:0⟫But it was not just her appearance; ⟪k:1⟫she had said she wished to live with him—⟪k:2⟫⟪k:3⟫"
"a beast who had committed countless atrocities. ⟪k:4⟫Perplexing indeed."
msgstr ""
"⟪k:0⟫而且不只是美丽……⟪k:1⟫她还说，⟪k:2⟫想要与不重复着禁忌之事的自己的命运斗争。⟪k:3⟫真是一件怪事"
"吧？ "

#: scenario2:scenario2_B50B9D3C_4359_45FB_A6A0_304B59FEF526
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 55c365a7855146fa034272e042b3221e2e1f6ca991a9b3ea8e10e80b69738f30
#. default-sha256: 4f2da25417983bf96309e927d3c52bd711941f3b35f35af03bdd5a6bedb7992a
msgctxt "scenario2:scenario2_B50B9D3C_4359_45FB_A6A0_304B59FEF526"
msgid "⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫⟪k:4⟫⟪k:5⟫⟪k:6⟫⟪k:7⟫............"
msgstr "⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫⟪k:4⟫⟪k:5⟫⟪k:6⟫⟪k:7⟫…………"

#: scenario2:scenario2_BCBD67FC_A76D_41C8_85A8_CB3C53F9EF2D
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 642e6913c31f93a563e5e88c3ce55112f87d52a37726cca610e2e7c2d8efa0a1
#. default-sha256: a9d98ccc42d7742c974dd1dfdb9530605c83a749ff89973f7a3560ec26c1b887
msgctxt "scenario2:scenario2_BCBD67FC_A76D_41C8_85A8_CB3C53F9EF2D"
msgid "⟪k:0⟫⟪k:1⟫...What is the matter?"
msgstr "⟪k:0⟫⟪k:1⟫…………您怎么了？"

#: scenario2:scenario2_B5BD6D06_AAF2_49FD_BAD8_8B3BA4A5AD55
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 00b27eb916a354530712ebcbbc665df5788ac85f7f615c34f84fac6e96c64540
#. default-sha256: f8944738ed122113e51d21b980dd8cc445735c2c797dab7a91f3eb7cb38601ef
msgctxt "scenario2:scenario2_B5BD6D06_AAF2_49FD_BAD8_8B3BA4A5AD55"
msgid "⟪k:0⟫⟪k:1⟫Do you honestly not fear me?"
msgstr "⟪k:0⟫⟪k:1⟫你……⟪k:2⟫你真的不怕我吗？"

#: scenario2:scenario2_FB16E62F_6D73_4768_AC4F_888E6DAFFCCD
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 0e3edb200d4010005b2adf1be3247451745cfdc3a362a58b517fa3a0b310fed5
#. default-sha256: dc72d7da4c2fced3a646b2e4ce189f54db30bfe1258ad3b5079de736bb5c5a1b
msgctxt "scenario2:scenario2_FB16E62F_6D73_4768_AC4F_888E6DAFFCCD"
msgid "⟪k:0⟫⟪k:1⟫Do I appear to be afraid of you?"
msgstr "⟪k:0⟫⟪k:1⟫我看起来像是在害怕吗？"

#: scenario2:scenario2_819774A8_0F00_452F_8CA5_49691425E1DE
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: b26697be49f4d0c317b09cf3d5891866cc459822b049d9e65858540ec3456c7e
#. default-sha256: c83112c658acbfb06323d578987395631b4d90e4aa4cea8a3b99a8350d955cc6
msgctxt "scenario2:scenario2_819774A8_0F00_452F_8CA5_49691425E1DE"
msgid "⟪k:0⟫⟪k:1⟫No... ⟪k:2⟫y-⟪k:3⟫you do not."
msgstr "⟪k:0⟫⟪k:1⟫不……⟪k:2⟫不像。"

#: scenario2:scenario2_FA13F74E_6111_4089_8272_900D124FD583
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: f27ecc255bb0144555e576c041c0d5bbf6a5e4a85a433c50ed16b7e62ffe7250
#. default-sha256: 29eeb946671b68afbe0c3eebedd58e3773250631f91938fd80f517544d9fd6dd
msgctxt "scenario2:scenario2_FA13F74E_6111_4089_8272_900D124FD583"
msgid ""
"⟪k:0⟫(But you ⟪k:1⟫would⟪k:2⟫. ⟪k:3⟫If you could see me,⟪k:4⟫you would react the same as everyone "
"else.⟪k:5⟫⟪k:6⟫You would mock me; ⟪k:7⟫you would despise me;⟪k:8⟫you would want to kill me.)"
msgstr ""
"⟪k:0⟫（但是……⟪k:1⟫我很害怕。⟪k:2⟫你如果见到我的样子，⟪k:3⟫也会变得和其他人一样。⟪k:4⟫蔑视我、⟪k:5⟫"
"憎恨我、⟪k:6⟫想要杀我）"

#: scenario2:scenario2_ADED7667_51B0_42A8_966B_728429B71DF1
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: e68e27122941335d07e4456a12058fb2d092455b80f7cbc58bfdcebdbe6d7a70
#. default-sha256: 87921c257c0b319aea291d96e580e9fc1fcc25cbb5c202178ce2ed9e97e33996
msgctxt "scenario2:scenario2_ADED7667_51B0_42A8_966B_728429B71DF1"
msgid "⟪k:0⟫(You don’t know what I’ve done, because you can’t see.)"
msgstr "⟪k:0⟫（因为她看不见……⟪k:1⟫所以不清楚我到底干了什么事）"

#: scenario2:scenario2_5FDA6BE2_1924_4963_BEDA_BF537EC984FF
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 1a8ffc7bf9538f01c4459c89174c0650efb6777f32acf845afa0d54539ccaa26
#. default-sha256: dc5d368bed23b859aee5801a4a5d2921a77f565eab8dd8c00e9ff588da05e3db
msgctxt "scenario2:scenario2_5FDA6BE2_1924_4963_BEDA_BF537EC984FF"
msgid "⟪k:0⟫(I ⟪k:1⟫enjoyed⟪k:2⟫ it.)"
msgstr "⟪k:0⟫（我喜欢……）"

#: scenario2:scenario2_13329D0F_E001_4658_8979_1CED36B9A9DC
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 19423571b7343272dde10fc33fc5f2580e2b4a9ce0c3f7b9ab2e2f2b412e0b10
#. default-sha256: d14c275d8d0056a1f9382a48b8076eab0c5d2a414b8ee589c30617763f2f23b0
msgctxt "scenario2:scenario2_13329D0F_E001_4658_8979_1CED36B9A9DC"
msgid "⟪k:0⟫(I basked in their terror.)"
msgstr "⟪k:0⟫（看别人恐惧的样子）"

#: scenario2:scenario2_CF810AEE_F1A6_4B2C_8B58_3FFE098C534E
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: b444ff333d5efaceceb76c5e696d1a5a3bcf3cd1f8616aa93e97600c04b81b9a
#. default-sha256: 6f143e4da48bcad7de90ca64b7b6c10b65a7b1d8f1a1b8bfbae0c87bd30ada4e
msgctxt "scenario2:scenario2_CF810AEE_F1A6_4B2C_8B58_3FFE098C534E"
msgid "⟪k:0⟫(So why... ⟪k:1⟫Why do I not want you to find out?)"
msgstr "⟪k:0⟫（但是……⟪k:1⟫我为什么……⟪k:2⟫不想被她发现呢）"

#: scenario2:scenario2_B9787E55_09F7_40B2_B99F_E1824044313A
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 12a02b0e11402011a6f7db45d4d5fe20d97379a39d795260bc4ed00c15e21def
#. default-sha256: f6609142e24f7e071f639a8344edc3549a2364423e010daa24c1ac3a9a759db4
msgctxt "scenario2:scenario2_B9787E55_09F7_40B2_B99F_E1824044313A"
msgid ""
"⟪k:0⟫(I don’t want you to know how many people I’ve tortured,⟪k:1⟫how many I’ve slaughtered, how "
"much blood I’ve imbibed...)"
msgstr "⟪k:0⟫（是的，⟪k:1⟫不想被她发现……⟪k:2⟫我杀人如麻，⟪k:3⟫嗜血如命）"

#: scenario2:scenario2_FF7D2F93_0EE1_4904_82BC_CFBF1E4C29EF
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 45135022fc1aa3fc57bd3c6480382c840775d95ef40941f955ccae6c171936ac
#. default-sha256: 0dd965732d9271f11f1df0a9d0db65e27b48265853c7452e24c0035e738bc597
msgctxt "scenario2:scenario2_FF7D2F93_0EE1_4904_82BC_CFBF1E4C29EF"
msgid "⟪k:0⟫(all the horrible things I’ve done.)"
msgstr "⟪k:0⟫（不知干了多少过分的事）"

#: scenario2:scenario2_0A61BE1F_38C0_4EDA_BF3F_E5B5FACFAD54
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: a619f3648386a321de5b8b888c8b077a302080c937777763aa81e8faca1b7f02
#. default-sha256: b59d9cdf83a6e89d46599e25ad58166eaabaac06c828d201006f321718de531d
msgctxt "scenario2:scenario2_0A61BE1F_38C0_4EDA_BF3F_E5B5FACFAD54"
msgid "⟪k:0⟫(“Horrible”? I’m ⟪k:1⟫aware⟪k:2⟫ that what I’ve done is wrong?)"
msgstr "⟪k:0⟫（过分——⟪k:1⟫过分？⟪k:2⟫我还有自知之明啊）"

#: scenario2:scenario2_215A2D46_B2AB_4C00_8D11_BCA5D5A8AF86
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: fa1a44bd74035d9af62b1028b50b48d6e58342c50ed5badef58b4fdc3a8113dd
#. default-sha256: 61e2f6f71ab678c3d24fd3e89a56f9f251f275b4bb025f4c23306ebb766a015c
msgctxt "scenario2:scenario2_215A2D46_B2AB_4C00_8D11_BCA5D5A8AF86"
msgid "⟪k:0⟫(But I relished in it...)"
msgstr "⟪k:0⟫（我不是很享受吗……）"

#: scenario2:scenario2_B81F4DF4_2CAE_4BFB_9662_057572CF1458
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 18221b7c1d2a8f22a63cbe8dd5e7e7d1969d1f9f4b76571d023f31c82842ddfa
#. default-sha256: 9c162d99016a01fc6cc3f8c720e11dfefa981df8e9cb26ac033aeb75008dedda
msgctxt "scenario2:scenario2_B81F4DF4_2CAE_4BFB_9662_057572CF1458"
msgid "⟪k:0⟫(I wanted... ⟪k:1⟫for so long... ⟪k:2⟫to slaughter them...)"
msgstr "⟪k:0⟫（不是一直……⟪k:1⟫想杀人吗……）"

#: scenario2:scenario2_5AA9AE97_F7A2_4AFA_A2FD_3B7BBDA70572
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: d373d2a52571dd2a930191e072ecd086750e58c77746c62105fd43b7f9d2cac1
#. default-sha256: 3398526cc541d1476975013fb404e57ec9469feda0cdca0832d5eb2098d70e38
msgctxt "scenario2:scenario2_5AA9AE97_F7A2_4AFA_A2FD_3B7BBDA70572"
msgid "⟪k:0⟫(I desperately desired to see blood—⟪k:1⟫⟪k:2⟫human blood...)"
msgstr "⟪k:0⟫（不是十分渴望见到人的鲜血吗？）"

#: scenario2:scenario2_D48F470C_5E20_4CC0_84F6_388845B1A72F
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 57f38aa4ae6eaa35d5b94fd08b93d5bdc47fb4bea451e26b2ad9e3e2f98b5b32
#. default-sha256: eb520b385808f491bacaf3521e794d76ebb3210f147c7eabedac2b7f9f1bbdc5
msgctxt "scenario2:scenario2_D48F470C_5E20_4CC0_84F6_388845B1A72F"
msgid "⟪k:0⟫(What is it I crave? Murder? Or laughter?)"
msgstr "⟪k:0⟫（我是什么啊？⟪k:1⟫我不是想杀人吗 ？⟪k:2⟫不是想嘲笑那些人类吗？⟪k:3⟫）"

#: scenario2:scenario2_47464B74_3291_424D_B8E6_799F589CED24
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 16df574fa56d5ce03c0550cfec109c2b17b1883d8549594799b0e687b282bf93
#. default-sha256: a0e1938f55d8dd0d5eb7f1242e26a0c90fa6128b80e229bda5ef1bf5482f7cd0
msgctxt "scenario2:scenario2_47464B74_3291_424D_B8E6_799F589CED24"
msgid "⟪k:0⟫(I said... ⟪k:1⟫that I had no need for peace, yet here I am...)"
msgstr "⟪k:0⟫（我明明说过，⟪k:1⟫不需要平静的生活——）"

#: scenario2:scenario2_8994C00C_0D88_487E_804B_8DE5B11C8C54
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: e5c0027b1c38b39f152437f5ba10a34d40e102e3186a1344f6e4f566527a14ea
#. default-sha256: e423c4f9ba3172d329a7df5cfaabf59d4a9479fcca0e64390164f3e682e9810f
msgctxt "scenario2:scenario2_8994C00C_0D88_487E_804B_8DE5B11C8C54"
msgid "⟪k:0⟫⟪k:1⟫Is something the matter?"
msgstr "⟪k:0⟫⟪k:1⟫………您怎么了？ "

#: scenario2:scenario2_D01C2A63_1F68_4FAA_A4F0_1AF90DC52647
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: a2b145689c2650929c10e988aab712c60c1a46e1012e7760c888243c8138fb14
#. default-sha256: 0ffefa0a32820252d0355d9dd611ccbbeebddef171c9d24b87d65b2f76b2df5f
msgctxt "scenario2:scenario2_D01C2A63_1F68_4FAA_A4F0_1AF90DC52647"
msgid "⟪k:0⟫⟪k:1⟫No, ⟪k:2⟫uh, ⟪k:3⟫some tea..."
msgstr "⟪k:0⟫⟪k:1⟫没什么，⟪k:2⟫沏茶……"

#: scenario2:scenario2_EC7C9912_7445_4D8E_B611_A08CA62ACB9D
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 07187f3384a84ede994eb4859868aa97f08643d08cade5f4041b3e43b04e7725
#. default-sha256: c10c55c90bb3562755f03adb5e844d53dbf69df38f7d1595e0a36b5dbb3bcfb0
msgctxt "scenario2:scenario2_EC7C9912_7445_4D8E_B611_A08CA62ACB9D"
msgid "⟪k:0⟫⟪k:1⟫Oh, shall I make some?⟪k:2⟫⟪k:3⟫Are you thirsty?"
msgstr "⟪k:0⟫⟪k:1⟫啊……⟪k:2⟫我来给您沏茶吧。⟪k:3⟫您口渴了吧？ "

