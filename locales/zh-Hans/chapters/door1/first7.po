msgid "⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫............"
msgstr "⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫…………"

#: scenario:scenario_BC97EB88_FDFF_4D90_AB47_4F0D1FC6292F
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 68aa094051674e953589322b75910679222b4a9cad9592bfca4dc3bcf4d19ad3
#. default-sha256: d02989f0a4281aaba62e649af9c739240e481475646ac17d289b90b0d401df39
msgctxt "scenario:scenario_BC97EB88_FDFF_4D90_AB47_4F0D1FC6292F"
msgid "⟪k:0⟫............"
msgstr "⟪k:0⟫…………"

#: scenario:scenario_1E811AC6_6801_426B_A54D_0CA525E34CCE
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: a213e7310a1d589802eb75ec4b3b20578579736a0f376f3374ebd1004d67235f
#. default-sha256: 92bdcdab0d29d8abb1443657ff3cab60ee9459267478461c998fc3ca41ec16c1
msgctxt "scenario:scenario_1E811AC6_6801_426B_A54D_0CA525E34CCE"
msgid "⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫⟪k:4⟫...⟪k:5⟫⟪k:6⟫Boo!"
msgstr "⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫⟪k:4⟫……——哇！"

#: scenario:scenario_C0A92B75_E7CB_491A_9F5A_B1375AC091C4
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 65c12225385af074a1c84c599d67b6222a1602924854083be8ff8b8675004daf
#. default-sha256: 3cd4adb7aed29208bf6d3f9d88bc5a4e0ae2341745191006525631af02519d5d
msgctxt "scenario:scenario_C0A92B75_E7CB_491A_9F5A_B1375AC091C4"
msgid "⟪k:0⟫⟪k:1⟫⟪k:2⟫Aah!"
msgstr "⟪k:0⟫⟪k:1⟫⟪k:2⟫哎呀！？"

