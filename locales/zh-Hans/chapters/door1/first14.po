msgid "⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫⟪k:4⟫⟪k:5⟫⟪k:6⟫⟪k:7⟫⟪k:8⟫⟪k:9⟫⟪k:10⟫F-⟪k:11⟫Father!⟪k:12⟫"
msgstr "⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫⟪k:4⟫⟪k:5⟫⟪k:6⟫⟪k:7⟫⟪k:8⟫⟪k:9⟫⟪k:10⟫神、⟪k:11⟫神父先生……！⟪k:12⟫"

#: scenario:scenario_B8F5453A_3E8A_4557_A72E_D24859653357
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 5f2351c5f70bc5388a428c336c4a2c09ec9e9f67e4fd309c6bd51bd0158192e7
