msgstr "⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫…………"

#: search:search_CC47AC18_588C_46BE_AFC9_C288EFF64651
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 4ba73fea9bc0e692ef2394147248a6494b51bf047066049fa83e027a6ab37131
#. default-sha256: 09cae2a1b090642ef19601c622d9ef0bf8c64eb3a883719c2d9eaa03b264b1a0
