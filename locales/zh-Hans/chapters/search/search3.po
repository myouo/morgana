msgid "⟪k:0⟫(She seems very... ⟪k:1⟫perky...)"
msgstr "⟪k:0⟫（……她……⟪k:1⟫看起来有点神情恍惚……）"

#: search:search_67ED44BC_7182_42C1_9862_18B5637A2D30
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 7724abe24058f6545972bd955e1fdb06e18dff16d4253e4f980cdf44bf0ee4df
