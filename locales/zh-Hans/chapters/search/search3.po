msgid "⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫Again...?"
msgstr "⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫……再……"

#: search:search_913C6C5B_DE65_459D_8148_136B8DAAABE2
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 75812da6fd86720a2804b724427a1be3e0d68d338e7c31d53f550b2eef5d1771
#. default-sha256: f187a4fb8396977b4fbdd202f28b6fb44664e379a5d3d8fae0a9423f2ff012c1
msgctxt "search:search_913C6C5B_DE65_459D_8148_136B8DAAABE2"
msgid "⟪k:0⟫You said... ⟪k:1⟫you were waiting for me..."
msgstr "⟪k:0⟫……你说过你在等我……"

#: search:search_B320244E_8E13_4AA2_8770_DAFE48335C47
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: cc9e2d28293a6ac3b60ea466d4aa7283136ced16811370671db0bce08cd64633
#. default-sha256: 538ea28c218d346853146255072f77437222411d0b8173ff5e38e4ff935eaaac
msgctxt "search:search_B320244E_8E13_4AA2_8770_DAFE48335C47"
msgid ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫I did, indeed, say that when you first arrived.⟪k:3⟫⟪k:4⟫I have been waiting for "
"your return for a very long time."
msgstr "⟪k:0⟫⟪k:1⟫⟪k:2⟫嗯，⟪k:3⟫正如当初说的那样，⟪k:4⟫下仆一直在等待着您。⟪k:5⟫真的等了很久……"

#: search:search_140202FB_9473_4BAF_BFD0_E32CA5DCC3E3
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 7b94cd8d8fb5a3c5d73c4b527e3706f44aa936220dfae29b3caf4f1cd24a31cb
#. default-sha256: 2387d31290f211fab8c101f78874603dc5405e63a458fea5e746aebe343f39f3
msgctxt "search:search_140202FB_9473_4BAF_BFD0_E32CA5DCC3E3"
msgid "⟪k:0⟫⟪k:1⟫...That would make me a ghost, then, you say?"
msgstr "⟪k:0⟫或许已经等了几百年。⟪k:1⟫⟪k:2⟫⟪k:3⟫……哎呀，⟪k:4⟫您问下仆是不是幽灵？"

#: search:search_DAC8EDDB_1F01_4E99_AFD4_33E3259798C1
