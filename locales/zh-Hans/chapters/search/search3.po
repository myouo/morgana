msgid "⟪k:0⟫⟪k:1⟫⟪k:2⟫(If we were ⟪k:3⟫both⟪k:4⟫ dead...)"
msgstr "⟪k:0⟫⟪k:1⟫⟪k:2⟫（……如果我们都是死者的话……）"

#: search:search_EBB3EA2C_FB0A_4A58_BB2A_C84DC8B99CB5
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: e74f19b9cfa0bcb6f7036e20a5affdd8b232f3b956aa95988f1bf9403d5afd76
#. default-sha256: a4b0d7f66e1db53067b0a375703fc5d47a7df6aa96064f161da8941cb3e73983
