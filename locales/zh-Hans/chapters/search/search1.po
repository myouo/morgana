msgctxt "search:search_53E12C05_26DB_47D1_9EB4_35E31462CE24"
msgid "⟪k:0⟫⟪k:1⟫Splendid."
msgstr "⟪k:0⟫⟪k:1⟫是吗，⟪k:2⟫太好了。"

#: search:search_AA1E2BF7_D662_4D19_BFD8_D0B8B08D191A
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: c6b1bdd5cc2e2140acc223d4f0b73cd653484932ce8269ba0939388c312872d1
#. default-sha256: 4731450f1597a6e78b49d1f0774476d9b68b8ba699a14d7dd3114c32df32c668
msgctxt "search:search_AA1E2BF7_D662_4D19_BFD8_D0B8B08D191A"
msgid ""
"⟪k:0⟫Been so long since I’ve had a conversation,⟪k:1⟫I was afraid I might’ve forgotten how to "
"talk.⟪k:2⟫⟪k:3⟫So tell me, who might you be?"
msgstr "⟪k:0⟫真的很久没有和人说话了……⟪k:1⟫几乎都快忘了该怎么说话了。⟪k:2⟫喂，⟪k:3⟫你到底是谁啊？"

#: search:search_E1EF2AD4_F041_48C4_AB86_840D600A6EB6
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: dc70bdba7324589325cb8c98761b91fe3b761cb76cc8e7031d09994ce431ce0c
#. default-sha256: d720bb2dac4c16491c5ca96f54b214ef814334ebbdad21786d517365965e9f5e
msgctxt "search:search_E1EF2AD4_F041_48C4_AB86_840D600A6EB6"
msgid "⟪k:0⟫⟪k:1⟫I don’t know...⟪k:2⟫⟪k:3⟫I don’t know anything..."
msgstr "⟪k:0⟫⟪k:1⟫……不知道，⟪k:2⟫我什么都不知道……"

#: search:search_4D53616D_8E16_476F_8EAA_1318DB2A3890
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 998978605c1e8bf82869786a35fc890bdbbbd762d607adfbf4fb612c77a11ec0
#. default-sha256: 29ebc42a8e900c1440660c8ee392553a2ffb900533bc6777bb9070a232d03651
msgctxt "search:search_4D53616D_8E16_476F_8EAA_1318DB2A3890"
msgid "⟪k:0⟫⟪k:1⟫You don’t know?⟪k:2⟫⟪k:3⟫Well, isn’t that quite the pickle."
msgstr "⟪k:0⟫⟪k:1⟫不知道？⟪k:2⟫这样啊，⟪k:3⟫那可真是麻烦了呢。"

#: search:search_8833BD8D_AEEA_4661_B533_6DE38CFDC60E
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: f2232be274e3dcfe6808613c42e1a9f68d92db435cae588e11e5ff0313ce3580
#. default-sha256: 2895b9373d879be84d1cf3a3e21f54d6213d6b9a234aa396792dc9dd5c679831
msgctxt "search:search_8833BD8D_AEEA_4661_B533_6DE38CFDC60E"
msgid ""
"⟪k:0⟫Then how ’bout we have a little chat, eh?⟪k:1⟫⟪k:2⟫You got yourself turned around and aren’t "
"sure where to go, yeah?"
msgstr "⟪k:0⟫那么，⟪k:1⟫好不容易有机会，⟪k:2⟫我们说些什么吧？⟪k:3⟫你是迷路了吧？"

#: search:search_55D06A8D_6D62_4964_B686_5578F59611EC
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 730fc1874f14f441ced44fdbe795acc913660fc51a85aa2fd5f55f0f058e77d9
