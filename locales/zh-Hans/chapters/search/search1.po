msgctxt "search:search_E274FD87_12D4_4405_8215_FA3F45F727AD"
msgid ""
"⟪k:0⟫Been a while since I’ve talked to anyone.⟪k:1⟫⟪k:2⟫So tell me, you can hear me all right, "
"can’tcha?"
msgstr "⟪k:0⟫已经很久没和谁交流了。⟪k:1⟫喂，⟪k:2⟫能听到我的声音吗？"

#: search:search_3A7FA097_8099_4B4C_90DB_0DE1D276157B
