msgctxt "badend4:unlabelled:badend4:20"
msgid "为什么……⟪k:0⟫我那个时候要犹豫——"
msgstr "为什么……⟪k:0⟫我那个时候要犹豫——"

#: badend4:unlabelled:badend4:21
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: b0e6e6c5817ab86d7486cf1525e6df76a38fe42b0206629834b4e0af50b0faa9
