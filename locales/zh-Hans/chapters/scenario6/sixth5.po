#. native-sha256: 19100ac282140955c18e1d81ab5111cc5d7fd6331d38da91f57ff3570c52b66c
#. default-sha256: 6f1eda3f375443220f0f56fe56e6ad3ef79687ee1be4c887505f64fbe46893df
msgctxt "scenario6:scenario6_409F3110_1A13_408B_BE13_46672FF5AEFE"
msgid ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫⟪k:4⟫⟪k:5⟫⟪k:6⟫⟪k:7⟫⟪k:8⟫⟪k:9⟫⟪k:10⟫⟪k:11⟫⟪k:12⟫⟪k:13⟫⟪k:14⟫Time pressed "
"onward,"
msgstr ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫⟪k:4⟫⟪k:5⟫⟪k:6⟫⟪k:7⟫⟪k:8⟫⟪k:9⟫⟪k:10⟫⟪k:11⟫⟪k:12⟫⟪k:13⟫⟪k:14⟫然后，⟪k:15⟫时光流"
"转……"

#: scenario6:scenario6_E00C943F_4D75_42F5_B79C_13668E56E37E
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: ae3b5a9f30a73f2b1c6e11f9e7df0b81420de2c4d858f8c63026d22577bea7fb
#. default-sha256: d811c9a33779b7e1bbe64aee15e1ce1449560d51f4c5a08429cd8b671cbab5bf
msgctxt "scenario6:scenario6_E00C943F_4D75_42F5_B79C_13668E56E37E"
msgid "⟪k:0⟫and then, at long last, you arrived."
msgstr "⟪k:0⟫你终于，⟪k:1⟫出现在了我的面前——"

#: scenario6:scenario6_DD418C23_5115_4DCC_BC33_8D2938BF2673
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: b348dfe330049098f92b658ab5198d4794183263b42623f2fffa95da74015aec
#. default-sha256: ea6db7f55fee4763791ea84612caaeee8b7f12496a52f209f9b343780c8f701e
msgctxt "scenario6:scenario6_DD418C23_5115_4DCC_BC33_8D2938BF2673"
msgid ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫⟪k:4⟫⟪k:5⟫⟪k:6⟫⟪k:7⟫⟪k:8⟫Oh, splendid...⟪k:9⟫⟪k:10⟫You have finally awoken."
msgstr "⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫⟪k:4⟫⟪k:5⟫⟪k:6⟫⟪k:7⟫⟪k:8⟫啊……⟪k:9⟫您终于醒来了。"

#: scenario6:scenario6_D6CCF4FC_DAA4_44F3_A35A_928A6859D487
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 39cea45cf04b913c151f310fd39ccc0b26aa92d2d6bc7191377964f8baf0e8b5
#. default-sha256: 6895a562460ff55ba973f779d9749eaed7825156a2d9096ac4acffdcf2465673
msgctxt "scenario6:scenario6_D6CCF4FC_DAA4_44F3_A35A_928A6859D487"
msgid "⟪k:0⟫I have simply been waiting so long for this moment."
msgstr "⟪k:0⟫下仆我梦寐以求的一刻终于到来了……"

#: scenario6:scenario6_EFCBAFD9_6E52_4944_8753_711F7D9B6242
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 675f7429522eb87284ddf3565355d9ed8a256184cfa1d0f4ef53abfa51551c38
#. default-sha256: decc8583f8e3e431c93b791902f4296d97baba5972fd953530b9c1c6bbeebda3
msgctxt "scenario6:scenario6_EFCBAFD9_6E52_4944_8753_711F7D9B6242"
msgid ""
"⟪k:0⟫Tending to the mansion all by my lonesome,⟪k:1⟫ensuring it was ready for your return, Master—"
"⟪k:2⟫⟪k:3⟫⟪k:4⟫whenever that time may be."
msgstr "⟪k:0⟫下仆独自一人修缮着这间屋子，⟪k:1⟫⟪k:2⟫时刻做好迎接老爷归来的准备。"

#: scenario6:scenario6_0C8D0830_48A8_4A58_A8AC_3AE5EA6582BC
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: b1874c122aaec16081e3ecfe5fec0f216ae264da5419f1ea0c5c8f4f837ef798
#. default-sha256: 0cb274104236f677b94fcf983e833f029974aaccb3a4e5f847bf52fe4fee056a
msgctxt "scenario6:scenario6_0C8D0830_48A8_4A58_A8AC_3AE5EA6582BC"
msgid ""
"⟪k:0⟫When I caught sight of you through the window,⟪k:1⟫my heart fluttered. ⟪k:2⟫The time had "
"finally arrived."
msgstr "⟪k:0⟫从窗边看到您身影的那一刻，⟪k:1⟫下仆想，⟪k:2⟫如此之久的等待，总算有价值了——"

#: scenario6:scenario6_67B74B9F_702E_4DDA_9756_FBF35BA48BFA
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 1f99ca1bedadb8b28541a3e0de00fa370d2d7af5eb1eb1e5004a221c3bc3663d
#. default-sha256: db2a984edc5353e34449b8898b377208997a640717673036332884109ccf2e9f
msgctxt "scenario6:scenario6_67B74B9F_702E_4DDA_9756_FBF35BA48BFA"
msgid "⟪k:0⟫⟪k:1⟫Oh my, you do not know who I am?⟪k:2⟫⟪k:3⟫Do you not know who you are, either?"
msgstr "⟪k:0⟫⟪k:1⟫哎呀，⟪k:2⟫您问下仆是谁？⟪k:3⟫⟪k:4⟫莫非您……⟪k:5⟫连自己是谁也不记得了？"

#: scenario6:scenario6_2D316048_7959_4D35_9CC6_A42713AAF5F1
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: e25d53d4dc1a3f50c7bde68b919960e5401d440ff8f77f3fa5240a39671626d0
#. default-sha256: d778d33e7606a8c2d8d735acc0de6ba53f499d987d6ca50ee6c89f53c61b52f1
msgctxt "scenario6:scenario6_2D316048_7959_4D35_9CC6_A42713AAF5F1"
msgid "⟪k:0⟫That is quite the predicament."
msgstr "⟪k:0⟫那还真是……令人伤脑筋呀。"

#: scenario6:scenario6_39AFFC0F_BAC7_44C7_9951_ACB95A3C6BFA
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: fb1f8bc9b6162700e500413f76b8e83196b7e5f9795ed5afab00777579450118
#. default-sha256: 553deee63abee39a841aa957a0661073389ba4b5565eeb46788fb807a09b92fb
msgctxt "scenario6:scenario6_39AFFC0F_BAC7_44C7_9951_ACB95A3C6BFA"
msgid "⟪k:0⟫⟪k:1⟫Then how about this?"
msgstr "⟪k:0⟫⟪k:1⟫为了能让您回忆起一切，不如这样……"

#: scenario6:scenario6_F56C1453_143C_4056_A206_C584B42B7282
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: fb094ee303651b9bdc14d49e1fb6bebd7948264cb0a83e36fd2a411eb08d95a4
#. default-sha256: a480cace1fcc8433c7698f88d00fa31bbcfd273cdb7fca529c029ed422dc2fb4
msgctxt "scenario6:scenario6_F56C1453_143C_4056_A206_C584B42B7282"
msgid ""
"⟪k:0⟫I am a servant of this mansion, and as such, I am familiar with the many incidents that have "
"taken place here.⟪k:1⟫⟪k:2⟫I shall show you the history of this house, Master."
msgstr ""
"⟪k:0⟫下仆我身为馆内的女仆，⟪k:1⟫对发生在此的种种事件了如指掌。⟪k:2⟫不如，⟪k:3⟫由我来带您一览这座馆"
"的陈年往事。"

#: scenario6:scenario6_82B04417_9973_4CFA_B57C_199EC1D32C00
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 7d0c559094e0f135e7947c906ad6b8d6a5c0e9ae4310e108efbfec4c35302109
#. default-sha256: 08e103233587c00bd7764014e1b7365252bc6cea988fa9720bb81484b4c5cde5
msgctxt "scenario6:scenario6_82B04417_9973_4CFA_B57C_199EC1D32C00"
msgid ""
"⟪k:0⟫⟪k:1⟫Let us be off, then.⟪k:2⟫⟪k:3⟫And fear not—⟪k:4⟫⟪k:5⟫I merely entreat you not to let go "
"of my hand."
msgstr ""
"⟪k:0⟫⟪k:1⟫既然如此，⟪k:2⟫老爷请安心随下仆来。⟪k:3⟫⟪k:4⟫请务必抓紧下仆的手，⟪k:5⟫片刻都不要松开。"

#: scenario6:scenario6_4863F686_6A3A_40FA_8698_038389769158
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 0be80434c4a0fa4588ebec506786227c4bc4fd9e8eed5f14dbd37680b487b1b2
#. default-sha256: b69d29b6093c34936fdbab4c338b5a989df4345dff4cc5ec6ed80e11d7171f5f
msgctxt "scenario6:scenario6_4863F686_6A3A_40FA_8698_038389769158"
msgid ""
"⟪k:0⟫Should you hold it tightly, you need not worry about being washed away by the waves of "
"history."
msgstr "⟪k:0⟫牵着下仆的手，⟪k:1⟫老爷您就不会被卷进历史的波浪之中。"

#: scenario6:scenario6_24F59810_6B2E_4DD4_AB93_1073D746BA04
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 11e5e0eaca97cf85f8ddc0538c0f220d9535242d6f0f57452fcf34aa03aefa6d
#. default-sha256: 485e2e9a8626330c09ad88cf10e51a60109a84f7ac4b9a56222a1913d81a6e12
msgctxt "scenario6:scenario6_24F59810_6B2E_4DD4_AB93_1073D746BA04"
msgid "⟪k:0⟫No matter what happens, you mustn’t let go of my hand."
msgstr "⟪k:0⟫是的……无论遇到什么，⟪k:1⟫都请不要放开下仆的手……"

#: scenario6:scenario6_163EC0D0_E2FF_4174_9059_D4A83D451B52
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 1dae017aea2d0baaaf525eb715b45b6ac0fe0eb6c94d238183c03d733b429d60
#. default-sha256: acc5e2b6e68b23e3cc66d66c85bcbe6700613ca1febc665b9ab29e1c1b78162b
msgctxt "scenario6:scenario6_163EC0D0_E2FF_4174_9059_D4A83D451B52"
msgid "⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫⟪k:4⟫⟪k:5⟫No matter what happens..."
msgstr "⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫⟪k:4⟫⟪k:5⟫无论遇到什么……"

#: scenario6:scenario6_4DF94911_E146_44DB_9E37_A31671194188
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 36395dc45febc391d73b708147b74aa3f570b7e35b4c423fb3f6aabe7e9666aa
#. default-sha256: f87a65b8b8f2912d872d75a4b416191e738a2ce67f31d12041bb4188a6703165
msgctxt "scenario6:scenario6_4DF94911_E146_44DB_9E37_A31671194188"
msgid "⟪k:0⟫⟪k:1⟫no matter what you see..."
msgstr "⟪k:0⟫⟪k:1⟫无论发生什么……"

#: scenario6:scenario6_BF129CA0_712B_4687_BB76_D5CAAE6E3137
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 06c5e8602261c71141b62792c8873e93680e9a1689220e09baa4233672e9149f
#. default-sha256: 2517b406fc452596a16100050de81a3712032d952d29bb2fcbe7354a94b8ab3c
msgctxt "scenario6:scenario6_BF129CA0_712B_4687_BB76_D5CAAE6E3137"
msgid "⟪k:0⟫⟪k:1⟫never again..."
msgstr "⟪k:0⟫⟪k:1⟫请你不要再——"

#: scenario6:scenario6_9CB7481D_46BE_4B1A_ACA9_2845B727CBC5
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: fe8b88d283673f269267b57779e72f6c4c4ff6aa9c9d6e9fc5f942b06298d828
#. default-sha256: 3e77b047a01a2e52596f8acbedf944e63f6fcd5c3069c2adbc6100aeda9fb585
msgctxt "scenario6:scenario6_9CB7481D_46BE_4B1A_ACA9_2845B727CBC5"
msgid "⟪k:0⟫⟪k:1⟫let go of this hand..."
msgstr "⟪k:0⟫⟪k:1⟫放开我的手……"

#: scenario6:scenario6_18E2B9AF_AE3C_41CE_A368_93578918249C
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 2c5425f504c135dd210f6176571ddef02aa0d46d8359f6da8fdd3d057e6543d7
#. default-sha256: a862caaa984eeb6c75c650a20ab38e4cb14932d7682c56e137f10f406343679e
msgctxt "scenario6:scenario6_18E2B9AF_AE3C_41CE_A368_93578918249C"
msgid "⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫⟪k:4⟫That... ⟪k:5⟫is everything."
msgstr "⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫⟪k:4⟫……这就是……⟪k:5⟫故事的始末。"

#: scenario6:scenario6_99153502_C32A_4E03_9DD6_822B712B48DF
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 82e844c7dcbb9de76b8f7e9d7ad5da8c015811fc83b2c0b5d71a3a546fb0e700
#. default-sha256: 1b80dd7da9632b1b06ef56111ee994f75ffb1669581e4ce6d718c2fd99abdb51
msgctxt "scenario6:scenario6_99153502_C32A_4E03_9DD6_822B712B48DF"
msgid "⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫............"
msgstr "⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫…………"

#: scenario6:scenario6_1266F294_ED32_406E_94D6_8CCA1AF6B90C
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 8f8c7d60f6cac334ef7b9934c2fe8008465136305591f7b61283436b8bbd208d
#. default-sha256: c510811b5523773479dead07831cf2131131a38df7822dcb043dfc23d3b16807
msgctxt "scenario6:scenario6_1266F294_ED32_406E_94D6_8CCA1AF6B90C"
msgid "⟪k:0⟫I prepared a number of things to say when she was finished with her tale,"
msgstr "⟪k:0⟫等她讲完了故事，⟪k:1⟫⟪k:2⟫我明明有许多话想对她说——"

#: scenario6:scenario6_0CF713FA_806D_4B6A_BAA0_BF374F4C56E0
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 549ad201168fbed2eb7f0252f2d2997bfc1a1be3329af7bb55b2ff8011574e16
#. default-sha256: d77d197553590027b53509c6d60e11b516f935b5a2aa8740b7dbc6c625734d8f
msgctxt "scenario6:scenario6_0CF713FA_806D_4B6A_BAA0_BF374F4C56E0"
msgid "⟪k:0⟫but I can’t manage to put any of them into words."
msgstr "⟪k:0⟫却全都说不出口。"

#: scenario6:scenario6_1F1C88CC_6A6E_4ECC_868A_58408AC2ABA6
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 9aaa5b60c50ca90f9900e3d917a4f7bc61e89b3ebbf2e1ed3bf697b7b86e9188
#. default-sha256: 42d669413488aea40592ff948692d4696f3df34fbf465739f4d9ab2413a1b455
msgctxt "scenario6:scenario6_1F1C88CC_6A6E_4ECC_868A_58408AC2ABA6"
msgid "⟪k:0⟫I almost hate myself for thinking it would be so easy."
msgstr "⟪k:0⟫我必须让她取回迷失的自我……⟪k:1⟫并且，我必须接受她的真相……"

#: scenario6:scenario6_E53F052F_E604_466B_A462_5229FDF0E856
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: e5ab44a29d9c04981a306c1997508d1304b5dcad7523739fa90863c6f069f11b
#. default-sha256: 607f1c2dd68138fb804b800c95aa7464539e68eb4db20a84e910a8e63bd9efbf
msgctxt "scenario6:scenario6_E53F052F_E604_466B_A462_5229FDF0E856"
msgid ""
"⟪k:0⟫For letting myself hope I could simply pull her back to her old self,⟪k:1⟫accept whatever "
"had happened to her,"
msgstr "⟪k:0⟫「只要再一次紧握住她的手——⟪k:1⟫⟪k:2⟫这样的话，⟪k:3⟫一切都能解决，⟪k:4⟫一切都将结束」——"

#: scenario6:scenario6_F3D5627E_7C28_445A_9C3F_932FF496F53E
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: fa537914f44f3e3342fd55c49a540711027b967998a062ec0a9a665b43a42eb4
#. default-sha256: 3c1ccf06962dd5e9a4d2c7917db3c6abea923fef4d434f5cb50b1c31c95cd628
msgctxt "scenario6:scenario6_F3D5627E_7C28_445A_9C3F_932FF496F53E"
msgid "⟪k:0⟫take her hand in mine, and that would solve everything."
msgstr "⟪k:0⟫我无法原谅自己，⟪k:1⟫竟然抱有这样轻率的期待……"

#: scenario6:scenario6_218D7FBB_C459_4977_BB6A_96B43570A67F
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: f7e0e00d9388dc555bc44efdc558a09cf20b8353ac5afc9ef90e88cc7c566f7e
#. default-sha256: 804d0aa0471c844c08a9eb2fe47c76f74f66f86802353d2fd4e7853d6ac311e4
msgctxt "scenario6:scenario6_218D7FBB_C459_4977_BB6A_96B43570A67F"
msgid "⟪k:0⟫The truth is so much worse than I imagined—⟪k:1⟫⟪k:2⟫so much more harrowing."
msgstr "⟪k:0⟫因为她的真相，⟪k:1⟫比我想象中的更加残酷——⟪k:2⟫⟪k:3⟫更加令人绝望。"

#: scenario6:scenario6_16D0120E_43DD_41D0_A19C_830C0C139E1D
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: cbf6d13f14f885154ac8caf93f3819ccd6b2d79aabbfd4c402aa9be32f850390
#. default-sha256: 77daea59794df68ffa1e674d8a74610e19a1ad62d70f834fdee5d0b47b36206a
msgctxt "scenario6:scenario6_16D0120E_43DD_41D0_A19C_830C0C139E1D"
msgid "⟪k:0⟫She was subjected not only to her own terrible fate,"
msgstr "⟪k:0⟫她，⟪k:1⟫不仅仅忍受着自身的残酷命运——"

#: scenario6:scenario6_581895C7_70CD_4803_BFC6_FB50FAB30442
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 4b9abf4af6db707f14f248e0b99e2f1139255627ed47475316825f311d01e6e3
