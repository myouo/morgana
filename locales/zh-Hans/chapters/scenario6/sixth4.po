#: scenario6:scenario6_556C1399_D7A0_4B38_A6DB_6946491A8160
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: c68f27ae8929aeba2acef8fedf519ec83596094cc80b6b1027094d959b9b5fa0
#. default-sha256: 40f13d0eb42f9f5923811d3359d26d19d3e522c1a12107e5501c839cbffe29fb
msgctxt "scenario6:scenario6_556C1399_D7A0_4B38_A6DB_6946491A8160"
msgid ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫⟪k:4⟫⟪k:5⟫⟪k:6⟫⟪k:7⟫⟪k:8⟫⟪k:9⟫⟪k:10⟫⟪k:11⟫⟪k:12⟫⟪k:13⟫⟪k:14⟫⟪k:15⟫⟪k:16⟫⟪k:17⟫"
"⟪k:18⟫⟪k:19⟫⟪k:20⟫⟪k:21⟫⟪k:22⟫⟪k:23⟫⟪k:24⟫⟪k:25⟫⟪k:26⟫⟪k:27⟫⟪k:28⟫⟪k:29⟫⟪k:30⟫⟪k:31⟫⟪k:32⟫⟪k:33⟫"
"⟪k:34⟫⟪k:35⟫⟪k:36⟫⟪k:37⟫I apologize for making you listen to my dreadful stories for so long. "
"⟪k:38⟫You must be quite weary of them by now."
msgstr ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫⟪k:4⟫⟪k:5⟫⟪k:6⟫⟪k:7⟫⟪k:8⟫⟪k:9⟫⟪k:10⟫⟪k:11⟫⟪k:12⟫⟪k:13⟫⟪k:14⟫⟪k:15⟫⟪k:16⟫⟪k:17⟫"
"⟪k:18⟫⟪k:19⟫⟪k:20⟫⟪k:21⟫⟪k:22⟫⟪k:23⟫⟪k:24⟫⟪k:25⟫⟪k:26⟫⟪k:27⟫⟪k:28⟫⟪k:29⟫⟪k:30⟫⟪k:31⟫⟪k:32⟫⟪k:33⟫"
"⟪k:34⟫⟪k:35⟫⟪k:36⟫⟪k:37⟫——讲了这么久残忍的故事，⟪k:38⟫真的十分抱歉。⟪k:39⟫想必你也听累了吧？"

#: scenario6:scenario6_22E7D063_B796_4594_A606_5DBD3B193E2D
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 910b896190d34556db9864fd593a7e21edf9f377741a8f70b5ca7ea6d9e45c4b
#. default-sha256: d84bd3770032898a026b8fac471f74b4779bd48695e499986bd964c0dc9ca251
msgctxt "scenario6:scenario6_22E7D063_B796_4594_A606_5DBD3B193E2D"
msgid "⟪k:0⟫But worry not, for this is the final one."
msgstr "⟪k:0⟫但是，⟪k:1⟫接下来就是尾声了。"

#: scenario6:scenario6_5FFD9067_E11D_4279_AA9B_4F0DC72D8A27
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 7fcd2d37f80d8c6125027f5706a5eb20d2635b19d9d455713c9b689cbfd5076e
#. default-sha256: 035093edbbfe2d41e02b23a35dadcb392427f2f6e198db7edaba7e11b1a07fec
msgctxt "scenario6:scenario6_5FFD9067_E11D_4279_AA9B_4F0DC72D8A27"
msgid "⟪k:0⟫And despite being the end, it is neither dramatic nor exciting."
msgstr "⟪k:0⟫然而，⟪k:1⟫说是尾声，⟪k:2⟫迎来的并不是戏剧性的结局。"

#: scenario6:scenario6_72F9EB16_EAA9_4710_9482_6C51B1F9FC15
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: c2d656a9ac51e970c4892b2579c1ad2da4efcf66f5b41514ba40a09e4fee1eec
#. default-sha256: 8f72da5aec4e29fdcf4dee310975aa399998b115ed07c45b68b018f1115bfd30
msgctxt "scenario6:scenario6_72F9EB16_EAA9_4710_9482_6C51B1F9FC15"
msgid "⟪k:0⟫It was a single phrase—⟪k:1⟫⟪k:2⟫the most insignificant of things—"
msgstr "⟪k:0⟫让我完全迷失自我，⟪k:1⟫忘却自己曾是吉赛儿的契机——"

#: scenario6:scenario6_076A4C37_956A_4FC0_B6F2_2CEC0EEF1EB9
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: fcaa79f9c5adfd03c10e441346542c09d0ec11d4a56cefa7dbc2ca314ee298f5
#. default-sha256: 9faeb47f20d4fdb8248a5838a948f6297941665f37bf0e33982a2c14fe2f9c08
msgctxt "scenario6:scenario6_076A4C37_956A_4FC0_B6F2_2CEC0EEF1EB9"
msgid ""
"⟪k:0⟫that caused me to completely lose myself and forget I had, long ago, been the woman called "
"Giselle."
msgstr "⟪k:0⟫仅仅是一句话。"

#: scenario6:scenario6_FF896C7C_8BFE_4088_A051_EDE1EE66FF96
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 9123305903dcfbabb618d439691df97665b207312354eb08dafa2e755a157db0
#. default-sha256: 796e7524fe6dc933662abb6e8b58f912653198ae23a7a418a525db396ee36368
msgctxt "scenario6:scenario6_FF896C7C_8BFE_4088_A051_EDE1EE66FF96"
msgid "⟪k:0⟫There was no malice in it. ⟪k:1⟫It was but a simple greeting."
msgstr "⟪k:0⟫话里并没有包含恶意，⟪k:1⟫仅仅是不经意的，⟪k:2⟫一句寒暄。"

#: scenario6:scenario6_53347EC4_B414_492B_993D_8757F2C0E14B
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: cc17b17e1fa7fedd9e8f029b556a764f7d745c45a4198c94fe00af66c8e9e903
#. default-sha256: 382f91169629e02f91bfc9a4b77af5c989289f05a4a462ce557ffa74dd24cca3
msgctxt "scenario6:scenario6_53347EC4_B414_492B_993D_8757F2C0E14B"
msgid "⟪k:0⟫⟪k:1⟫⟪k:2⟫Do you remember how, the first time she arrived,"
msgstr "⟪k:0⟫⟪k:1⟫⟪k:2⟫你还记得吗？"

#: scenario6:scenario6_10F6EC42_4F81_46A1_BC78_36A8A802846B
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 681fd6f55f31cec23e09948a07cdb5680b9b0bcafd407e88fea683ed4a204583
#. default-sha256: bcc04c66bd87931ba1471702441a6013ee095151c39856848c42810acb93a63b
msgctxt "scenario6:scenario6_10F6EC42_4F81_46A1_BC78_36A8A802846B"
msgid ""
"⟪k:0⟫“Michel” said I had a peculiar presence about me?⟪k:1⟫⟪k:2⟫She felt something there between "
"us."
msgstr ""
"⟪k:0⟫她第一眼看见我的时候，⟪k:1⟫说我「是个不可思议的人」。⟪k:2⟫就是说，对于我，⟪k:3⟫她应该有些印"
"象。"

#: scenario6:scenario6_FEA9E9B7_5E6D_4C21_8873_F2ABE720FA54
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: a977dfb81724cc340762467c0d3f290c22b25c9c06234b5674c2db5d7704cc35
#. default-sha256: 1446d1359b38cde589b2838914bf1403417d062c87c4aa84dd54be7d8065a12e
msgctxt "scenario6:scenario6_FEA9E9B7_5E6D_4C21_8873_F2ABE720FA54"
msgid ""
"⟪k:0⟫And the second time, she said something about me seemed familiar.⟪k:1⟫⟪k:2⟫She did not "
"remember why, but her soul recognized the bonds we shared."
msgstr ""
"⟪k:0⟫第二次遇见的时候，⟪k:1⟫她说我「令人怀念」。⟪k:2⟫即便不记得了，⟪k:3⟫她的灵魂深处依旧知晓我们之"
"间的感情。"

#: scenario6:scenario6_F06992C8_18FF_4B48_8EA8_D9231880549E
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 193ecf795810680a4d4505d51e3ec37e5b6854b0790ea88dbfd72fe9a93cbd57
#. default-sha256: 7caed1c355c2b94a2318e5ead01da8603c0274b755ca83a6c698e1bfb1e176ee
msgctxt "scenario6:scenario6_F06992C8_18FF_4B48_8EA8_D9231880549E"
msgid ""
"⟪k:0⟫So I assumed that the next time she showed up, she would feel something even stronger, ⟪k:1⟫"
"or perhaps even have her memories."
msgstr ""
"⟪k:0⟫因此，⟪k:1⟫第三次的重逢……我还以为，她会回忆起我们之间更深刻的渊源。⟪k:2⟫或者，⟪k:3⟫直接回忆起"
"我俩的过去——"

#: scenario6:scenario6_1051D477_1775_45A0_8D7B_5C6294BD13D1
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 122efe6e85321df9e3977472bdda7656559c0c295428329faeef79e16178fb78
#. default-sha256: c12e5c0d449ad7cdfc399ffcdd7d70f6e014d5308fec22cdb11a80fe9eb8e5af
msgctxt "scenario6:scenario6_1051D477_1775_45A0_8D7B_5C6294BD13D1"
msgid ""
"⟪k:0⟫Despite having been let down again and again, I still held on to the faintest glimmer of "
"hope."
msgstr "⟪k:0⟫即便我几次深受打击，⟪k:1⟫但直到最后的最后，⟪k:2⟫我仍怀抱着一缕希望。"

#: scenario6:scenario6_5D0DB885_0ECC_4ECB_9B27_6A1CF4DE51C3
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 01326b552d8753c20a18aa494041b51b5da4cc31d25eea8e64e184d22b0769eb
#. default-sha256: 4967d49fc7ad8d1e1d0dae577965474ff6b0203fe4b682ba8fcd012bfca0dcce
msgctxt "scenario6:scenario6_5D0DB885_0ECC_4ECB_9B27_6A1CF4DE51C3"
msgid "⟪k:0⟫But when she appeared, ⟪k:1⟫she was someone else’s wife."
msgstr "⟪k:0⟫但是，⟪k:1⟫那个时代的她——⟪k:2⟫最初就是他人的妻子。"

#: scenario6:scenario6_CCAA917E_5CB3_4728_BF9E_D35A17A92BF1
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 86d9340c5d4dc7da3f855af2530937a5e760c1dbd3dd3f02a91ae3196b69d963
#. default-sha256: e3d4d31d8257a05e6e04ab61006bfcf6c012bb81f2e8953bb41ea23b153b6150
msgctxt "scenario6:scenario6_CCAA917E_5CB3_4728_BF9E_D35A17A92BF1"
msgid "⟪k:0⟫⟪k:1⟫⟪k:2⟫Hey! Hey, head maid!⟪k:3⟫⟪k:4⟫Get out here!"
msgstr "⟪k:0⟫⟪k:1⟫⟪k:2⟫喂——⟪k:3⟫喂！⟪k:4⟫女仆长！⟪k:5⟫女仆长在哪！"

#: scenario6:scenario6_B9FFC48D_8468_4417_89FD_3726CB41A310
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: c376b750eebeaf8dc18efe7208249d81af1eb0eaef7e57ddae0109be953eed16
#. default-sha256: 3c62dae121e570477c2b8e1172bf48832429f2ee54277bd729238eb0eed5f984
msgctxt "scenario6:scenario6_B9FFC48D_8468_4417_89FD_3726CB41A310"
msgid "⟪k:0⟫⟪k:1⟫⟪k:2⟫I am right here, sir.⟪k:3⟫⟪k:4⟫Is something the matter?"
msgstr "⟪k:0⟫⟪k:1⟫⟪k:2⟫……是，⟪k:3⟫下仆在这。⟪k:4⟫老爷您如此大声叫喊，⟪k:5⟫请问有何吩咐？"

#: scenario6:scenario6_03232306_DBE0_4747_B3FA_10B5730DBEB3
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 5c7f83ff85e1c290b9772a3c32f600cb5bb463e65afbe2bb75edd46ee0829ae7
#. default-sha256: 91277d53078ca4f9103a6de685c4b5a16f33595ad92453b0ea01d6de6778055a
msgctxt "scenario6:scenario6_03232306_DBE0_4747_B3FA_10B5730DBEB3"
msgid ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫I figured you should get to know her as soon as possible,⟪k:3⟫⟪k:4⟫since you’ll be "
"spending a lot of time looking after her."
msgstr ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫我只是在想，⟪k:3⟫女仆长姑且还是要见上一面的。⟪k:4⟫⟪k:5⟫毕竟今后是由你来打理生活起居"
"的。"

#: scenario6:scenario6_D13813BA_B5BC_4EC9_A313_D3F0B67349BD
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 972b9353d3654f05251e2b7c3a0db172cf910c1e156c33afdab68c0a218ada9a
#. default-sha256: 5a83dc00917507cc28e95470635bbcd0964df192155fec2cd2e319fbfe4096cf
msgctxt "scenario6:scenario6_D13813BA_B5BC_4EC9_A313_D3F0B67349BD"
msgid "⟪k:0⟫⟪k:1⟫...?"
msgstr "⟪k:0⟫⟪k:1⟫………？"

#: scenario6:scenario6_16E316EF_B176_4919_8842_25639A4FFD25
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 28d09e525ae257d7022845189f8a6ed028f7a7c3f06c1cc2684d53dd45b29c30
#. default-sha256: 3aff14804035de535a9c647416eb083acff9c8fa0c4a5e908dfce12c158bfe3e
msgctxt "scenario6:scenario6_16E316EF_B176_4919_8842_25639A4FFD25"
msgid ""
"⟪k:0⟫⟪k:1⟫Hey, get out here!⟪k:2⟫⟪k:3⟫Christ, there’s not a goddamned confident bone in your "
"body, is there?"
msgstr "⟪k:0⟫⟪k:1⟫喂，⟪k:2⟫快过来！⟪k:3⟫真是的，⟪k:4⟫你老磨磨蹭蹭的。"

#: scenario6:scenario6_14684D65_8FA9_4010_953A_C2D2C8D024EC
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 1385bb61b12a00e572f6796ab9b5c76920fe8c9fb72470affa966660be97e0ea
#. default-sha256: 4cef1d3e9e1ebb3d1ec8a9a195b257a61fe9ccbe13fd4ce06f4ede79d0adc874
msgctxt "scenario6:scenario6_14684D65_8FA9_4010_953A_C2D2C8D024EC"
msgid "⟪k:0⟫⟪k:1⟫⟪k:2⟫Ah, ⟪k:3⟫I-⟪k:4⟫I’m sorry... ⟪k:5⟫I’ll be right out!"
msgstr "⟪k:0⟫⟪k:1⟫⟪k:2⟫啊，⟪k:3⟫对、⟪k:4⟫对不起……⟪k:5⟫我马上过去……！"

#: scenario6:scenario6_E7BB3F86_5C78_42D9_A0E8_5D77D70DB695
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: e5afb6de4253c1c3130ac5364618e3876c77041a4ca7c0b5b9117ef754408615
#. default-sha256: 9f96cd27982b1c7aecb218102f76c25b4eac6aee235b21dd6376df4c3a603316
msgctxt "scenario6:scenario6_E7BB3F86_5C78_42D9_A0E8_5D77D70DB695"
msgid "⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫⟪k:4⟫⟪k:5⟫—!"
msgstr "⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫⟪k:4⟫⟪k:5⟫…………！"

#: scenario6:scenario6_49BC5947_A133_4885_A7D0_F9CCD63F605C
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 30cac956cfe6931f722dd072a191e1b3a8f72ef849ef15d8d871bf806d91efa7
#. default-sha256: fa52b98030ef0bdc0adcd4e2fe46405ee411a57f9c2dde4ce8ae1542d85e1d75
msgctxt "scenario6:scenario6_49BC5947_A133_4885_A7D0_F9CCD63F605C"
msgid "⟪k:0⟫⟪k:1⟫...Mi—"
msgstr "⟪k:0⟫⟪k:1⟫………………米⟪k:2⟫…………"

#: scenario6:scenario6_8CE9F3FD_FF79_4F19_9C53_3646DD9D5407
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 9460a3e25e262d6535ee6d87ad70bcbdc864fffc70f7a8210d7ed0749482b433
#. default-sha256: 3ab769d3e5c3208d4f35912404a4f7d7c04dd60ef242a1742ae4e959900447b8
msgctxt "scenario6:scenario6_8CE9F3FD_FF79_4F19_9C53_3646DD9D5407"
msgid "⟪k:0⟫The first thing she said when she saw me was,"
msgstr "⟪k:0⟫然后，⟪k:1⟫在最初见面的时候。⟪k:2⟫她这样说道。"

#: scenario6:scenario6_05C8C434_3889_4466_9C5F_9C967728EF84
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: a5a55bbdad9904c23f2970497eca07edf208845a56d2f4405ea3958abd137617
#. default-sha256: b6ceb0384fae528be049f75ce13919ef7f89fe1fedb63441f646664f00c4bbbc
msgctxt "scenario6:scenario6_05C8C434_3889_4466_9C5F_9C967728EF84"
msgid "⟪k:0⟫⟪k:1⟫⟪k:2⟫It’s a pleasure to meet you."
msgstr "⟪k:0⟫⟪k:1⟫⟪k:2⟫初次见面。"

#: scenario6:scenario6_083071E8_9111_45AE_8A4B_D0C4122FF24C
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 9eae298c7341bf8a0feca62c8a79709bb1dffa1519e42e491f1cbf32c706156c
#. default-sha256: 5eb40425efd09e6fd2abc40bdd3800fb90abb2fcda9186f60d7e7456e1f027d9
msgctxt "scenario6:scenario6_083071E8_9111_45AE_8A4B_D0C4122FF24C"
msgid "⟪k:0⟫⟪k:1⟫⟪k:2⟫“It’s a pleasure to meet you.”"
msgstr "⟪k:0⟫⟪k:1⟫⟪k:2⟫「初次见面」。"

#: scenario6:scenario6_666D9EDB_836D_4578_AA5F_8AD6C8F27534
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 6a4955ece107931c9eeff4ade22fa6af981a52fd9f290547985614b13cdc7d75
#. default-sha256: 7d6a2c4be32770674274a5e9d8f7fb2e6434e936b612feb6c69d95a22f7899ae
msgctxt "scenario6:scenario6_666D9EDB_836D_4578_AA5F_8AD6C8F27534"
msgid "⟪k:0⟫What had I spent all that time waiting for?"
msgstr "⟪k:0⟫我在等待中度过的、漫长的时光，⟪k:1⟫到底，⟪k:2⟫算是什么呢？"

#: scenario6:scenario6_88DA40EB_7F6A_4485_BBEE_ACE5B0922BA6
