msgid "⟪k:0⟫............"
msgstr "⟪k:0⟫…………"

#: scenario6:scenario6_7B26F9EF_ABA1_4645_A700_F7B61B22ED50
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: bb992188c9ac31c22d1cdd491611b72f1fc7519f2add5c810965b647755a8270
#. default-sha256: c47ee30c491afd85efb14cd7621c29e5327f6bd4358a644c3e1b25fd50f88a02
msgctxt "scenario6:scenario6_7B26F9EF_ABA1_4645_A700_F7B61B22ED50"
msgid "⟪k:0⟫Now go on.⟪k:1⟫⟪k:2⟫I’m quite looking forward to this..."
msgstr "⟪k:0⟫好了，⟪k:1⟫快去吧。⟪k:2⟫我期待你的表现……"

#: scenario6:scenario6_C3C24115_B057_484A_BDCF_F58B0F781072
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: c5fb6be4f4bc2cc7b46581fc0b62bfb94e15b29d62bc57dcbe1f500a146d7275
