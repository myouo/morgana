#: scenario3:scenario3_D4A6FA98_A7C3_4324_8BC0_7853D9A17202
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 922495e674459195e978ec86138274691bb104b6e50620ba0955813fdcc8f3bd
#. default-sha256: 41c41b2c487114271aae49bbe06eccb57300d48fe7001ad85c182174f475ee6b
msgctxt "scenario3:scenario3_D4A6FA98_A7C3_4324_8BC0_7853D9A17202"
msgid ""
"⟪k:0⟫The night before the opening ceremony, the master of the house headed for his wife’s shed."
msgstr ""
"⟪k:0⟫The night before the opening ceremony, the master of the house headed for his wife’s shed."

#: scenario3:scenario3_00629B75_CB74_4C66_AEB9_43218111BC59
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: df1f3804bb7a6f5e5fa8135caefe062b64b8da7f322b50410f1ba810e6b5cd60
#. default-sha256: f86ec53db6a42611e356212a614a91fd2aacfddb000585fd198b8b3937b7b908
msgctxt "scenario3:scenario3_00629B75_CB74_4C66_AEB9_43218111BC59"
msgid ""
"⟪k:0⟫There was a tension on his face, but a surety in his step.⟪k:1⟫⟪k:2⟫He had found the resolve "
"to speak with her."
msgstr ""
"⟪k:0⟫There was a tension on his face, but a surety in his step.⟪k:1⟫⟪k:2⟫He had found the resolve "
"to speak with her."

#: scenario3:scenario3_07151B49_FE0E_49DD_BCB1_6B1E509795E3
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: d9bd141e54e1d7c76c5033b7dfa7bfb344d5d76feed67ada69f6d597a4b1befd
#. default-sha256: 0b1d926d3925e9e24c62784f559c73fe901fb3bd371a6427509612eccbe797ee
msgctxt "scenario3:scenario3_07151B49_FE0E_49DD_BCB1_6B1E509795E3"
msgid ""
"⟪k:0⟫Having locked her away for so long in the shed like a common prisoner, Jacopo was hardly "
"optimistic about what she might say to him."
msgstr ""
"⟪k:0⟫Having locked her away for so long in the shed like a common prisoner, Jacopo was hardly "
"optimistic about what she might say to him."

#: scenario3:scenario3_74DF934A_2B1D_4AC2_A228_28F59D2EFD3E
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: c8938d835396b49cce151569449ceee57be55ad911776519d10b97605e99a8fc
#. default-sha256: d8583cd16236b796751a6055c870b178d5697c0f62235a2f32cbd407a7b67e5c
msgctxt "scenario3:scenario3_74DF934A_2B1D_4AC2_A228_28F59D2EFD3E"
msgid ""
"⟪k:0⟫He had undeniably mistreated her, said heartless and cruel things to her, and even gotten "
"physically violent with her."
msgstr ""
"⟪k:0⟫He had undeniably mistreated her, said heartless and cruel things to her, and even gotten "
"physically violent with her."

#: scenario3:scenario3_8AB2F328_F485_4FC7_83A6_FC5D21CE79D4
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 461d85cf6dc96c2a421261bb087a266e55e99c691260fb5dbecac0dd9e04726c
#. default-sha256: 4b2d21df9d1f5508fb9b2a2dbc7514122194c1bfb3dc76509e6063c5fb7f4409
msgctxt "scenario3:scenario3_8AB2F328_F485_4FC7_83A6_FC5D21CE79D4"
msgid "⟪k:0⟫His actions were inexcusable, even if they were in response to her infidelity."
msgstr "⟪k:0⟫His actions were inexcusable, even if they were in response to her infidelity."

#: scenario3:scenario3_647B08CC_5594_438B_BA30_D4E9D0929645
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 5ae5dad4f0db2da48aebacc26ef568e017acef766d6f84fd94a2a461387a139d
#. default-sha256: 615b062d06e5ab1121ce46ae012689ce1fe2b7f3172591ce018968f717258093
msgctxt "scenario3:scenario3_647B08CC_5594_438B_BA30_D4E9D0929645"
msgid ""
"⟪k:0⟫Of course, the very infidelity which had driven him to such behavior had not, in fact, taken "
"place, but he was unaware of that."
msgstr ""
"⟪k:0⟫Of course, the very infidelity which had driven him to such behavior had not, in fact, taken "
"place, but he was unaware of that."

#: scenario3:scenario3_385304CF_5B4C_49D0_90A2_B0F045A80595
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 5dd4d1924fe1aef405110b1c9c877809e8b991fd571c6a7cff1631893c42e29a
#. default-sha256: ccf1efcb452f00a21420327a72f98716bef408dbd1189591c2de35d16004702f
msgctxt "scenario3:scenario3_385304CF_5B4C_49D0_90A2_B0F045A80595"
msgid ""
"⟪k:0⟫There was a chance they would never reconcile their misunderstandings, and that this "
"predicament would not have a positive resolution, but he still clung to a tiny fragment of hope."
msgstr ""
"⟪k:0⟫There was a chance they would never reconcile their misunderstandings, and that this "
"predicament would not have a positive resolution, but he still clung to a tiny fragment of hope."

#: scenario3:scenario3_23DE3C47_FF4D_4DD6_A52E_50ED583D252A
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 02ec2a9321dbcd9ff6a0ae3650e361bf9ebba9a93a9d8723fff6d7644e4522ad
#. default-sha256: 5eacd00439f7ede453af3abcd02bf6fa76b27583ff982fd41be946c32e1a5de8
msgctxt "scenario3:scenario3_23DE3C47_FF4D_4DD6_A52E_50ED583D252A"
msgid "⟪k:0⟫He wanted to start over with the White-Haired Girl, to make a new future with her."
msgstr "⟪k:0⟫He wanted to start over with the White-Haired Girl, to make a new future with her."

#: scenario3:scenario3_53EE63C7_F841_468E_ACF2_685521941970
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 4702d6c794215eeee1c3640f13da30c24ad2cb479cccde95cc1fe02a011ed22f
#. default-sha256: d2b468e4d5f0c5d53d71a3a1e63c2891b71a2f35eca795cbdcac171d435e3fee
msgctxt "scenario3:scenario3_53EE63C7_F841_468E_ACF2_685521941970"
msgid ""
"⟪k:0⟫With that desire burning strong in his heart, he stood before the door to her shed and "
"called out to her."
msgstr ""
"⟪k:0⟫With that desire burning strong in his heart, he stood before the door to her shed and "
"called out to her."

#: scenario3:scenario3_4B0BB762_4B96_4477_B69D_442908B2BD4E
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: f0d8b1139e20baf43fdff2fb98cea6603ac3d24684af9ada36142a12858e0c05
#. default-sha256: cd5ff403ae2d781e6451fe1a4a71306a8fcbf0237dec5b8e46ee657a4fd4d954
msgctxt "scenario3:scenario3_4B0BB762_4B96_4477_B69D_442908B2BD4E"
msgid "⟪k:0⟫⟪k:1⟫⟪k:2⟫Are you awake?⟪k:3⟫⟪k:4⟫It’s me, Jacopo.⟪k:5⟫⟪k:6⟫May I come in?"
msgstr "⟪k:0⟫⟪k:1⟫⟪k:2⟫Are you awake?⟪k:3⟫⟪k:4⟫It’s me, Jacopo.⟪k:5⟫⟪k:6⟫May I come in?"

#: scenario3:scenario3_5AAE587A_3589_4AB5_8902_3829339585B7
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: b429493f3690549f5ee8ccd8bf980c8e290bc752b5f5950ca768811c1ebd875e
#. default-sha256: e0124060156fa5d288d24ae6dfb6aab0059b5ecc7c59aeab5a6481893e48f948
msgctxt "scenario3:scenario3_5AAE587A_3589_4AB5_8902_3829339585B7"
msgid ""
"⟪k:0⟫I won’t hurt you.⟪k:1⟫⟪k:2⟫I will not raise my hand against you again.⟪k:3⟫⟪k:4⟫I swear to "
"you, I will do you no harm."
msgstr ""
"⟪k:0⟫I won’t hurt you.⟪k:1⟫⟪k:2⟫I will not raise my hand against you again.⟪k:3⟫⟪k:4⟫I swear to "
