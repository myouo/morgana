msgctxt "scenario3:scenario3_93CD596B_710F_4B6D_A9BE_C45CAFB41920"
msgid "⟪k:0⟫And she became the target for them to let off this steam."
msgstr "⟪k:0⟫And she became the target for them to let off this steam."

#: scenario3:scenario3_A6A74DB4_B6EB_4691_8E51_D0B71446E496
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 42aa865ced870ce684c9f7345be69ebd7450a8bc5a58bf0ad41eecdadb2696d9
