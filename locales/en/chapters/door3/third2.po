msgctxt "scenario3:scenario3_FCE0642B_DBE2_4935_A25D_FAE1492D1023"
msgid ""
"⟪k:0⟫Nonetheless, it was commonplace—⟪k:1⟫⟪k:2⟫⟪k:3⟫all because of the way Jacopo treated her."
msgstr ""
"⟪k:0⟫Nonetheless, it was commonplace—⟪k:1⟫⟪k:2⟫⟪k:3⟫all because of the way Jacopo treated her."

#: scenario3:scenario3_D68D42FA_CF32_457E_9CB5_30FBC93EEFC8
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 71c1aaeee55e05da7b13d180463e71315037f18e3ec98677d7019215106977ce
