msgctxt "scenario3:scenario3_D9217328_537E_44AE_A7D1_F2142D1419F2"
msgid "⟪k:0⟫The maids’ behavior toward the mistress of the house was absolutely unacceptable."
msgstr "⟪k:0⟫The maids’ behavior toward the mistress of the house was absolutely unacceptable."

#: scenario3:scenario3_FCE0642B_DBE2_4935_A25D_FAE1492D1023
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: f7c56ea8749ea59c7d463e183ab40a63a61aee95b370cd8e727d83e971230659
