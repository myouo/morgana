msgctxt "scenario3:scenario3_A6A74DB4_B6EB_4691_8E51_D0B71446E496"
msgid "⟪k:0⟫Not directly, but through a more subdued kind of harassment from the shadows."
msgstr "⟪k:0⟫Not directly, but through a more subdued kind of harassment from the shadows."

#: scenario3:scenario3_C90492EF_7D04_424F_9879_017BF694F1CA
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: eff959f87fa20b1534e93d83383bca89b3f486a4a9d69f2eca08268e18f9eb19
