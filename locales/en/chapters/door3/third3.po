msgid "⟪k:0⟫⟪k:1⟫Where would you like to go?"
msgstr "⟪k:0⟫⟪k:1⟫Where would you like to go?"

#: scenario3:scenario3_FE685075_25D4_49F5_97E0_C69DFB2EBA08
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 61a369bc78da2aba89769722226e6ba279213418d7162f2ccdf2309aa4b54510
#. default-sha256: 554be42c7a065c6bb8b0fc091750e295e2de71a1f781e4400e7c955e1e1f0fac
