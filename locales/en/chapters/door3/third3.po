msgctxt "scenario3:scenario3_C3545ABA_5D3E_4590_BE8E_3ADF12576978"
msgid "⟪k:0⟫He looked at me with uncertainty and asked:"
msgstr "⟪k:0⟫He looked at me with uncertainty and asked:"

#: scenario3:scenario3_8D48F148_7278_46E4_8DF7_4D8AACB4C7D1
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
