#: scenario:first_6F184769_6CDF_4639_9190_C2DD93C8ECA0
#. Edit msgstr; keep msgctxt and msgid unchanged.
msgctxt "page:first_6F184769_6CDF_4639_9190_C2DD93C8ECA0"
msgid "Your consciousness, wavering like a ship at sea, was slowly drawn back to the surface."
msgstr "Your consciousness, wavering like a ship at sea, was slowly drawn back to the surface."

#: scenario:first_55CA7F50_AD2F_4ACE_8C13_092E88A5B7F7
#. Edit msgstr; keep msgctxt and msgid unchanged.
msgctxt "page:first_55CA7F50_AD2F_4ACE_8C13_092E88A5B7F7"
msgid "{{gb:pause:0}}{{gb:style:1}}...ter.{{gb:endstyle:2}}"
msgstr "{{gb:pause:0}}{{gb:style:1}}...ter.{{gb:endstyle:2}}"

#: scenario:first_ABDB8EDE_1354_4370_883C_999B93387DB8
#. Edit msgstr; keep msgctxt and msgid unchanged.
msgctxt "page:first_ABDB8EDE_1354_4370_883C_999B93387DB8"
msgid "With each new breath, feeling gradually returned to Your fingers."
msgstr "With each new breath, feeling gradually returned to Your fingers."

#: scenario:first_9F186082_C02E_43C0_8505_AB881358FCFF
#. Edit msgstr; keep msgctxt and msgid unchanged.
msgctxt "page:first_9F186082_C02E_43C0_8505_AB881358FCFF"
msgid "{{gb:pause:0}}{{gb:style:1}}Master.{{gb:endstyle:2}}"
msgstr "{{gb:pause:0}}{{gb:style:1}}Master.{{gb:endstyle:2}}"

#: scenario:first_7EA48DE0_2E43_4621_A279_8BC9819C1FB0
#. Edit msgstr; keep msgctxt and msgid unchanged.
msgctxt "page:first_7EA48DE0_2E43_4621_A279_8BC9819C1FB0"
msgid "You could hear the pattering of rain from somewhere."
msgstr "You could hear the pattering of rain from somewhere."

#: scenario:first_A3960FA7_8974_4185_BD95_776DC75AF63E
#. Edit msgstr; keep msgctxt and msgid unchanged.
msgctxt "page:first_A3960FA7_8974_4185_BD95_776DC75AF63E"
msgid "{{gb:pause:0}}{{gb:style:1}}Master?{{gb:endstyle:2}}"
msgstr "{{gb:pause:0}}{{gb:style:1}}Master?{{gb:endstyle:2}}"

#: scenario:first_AFF24FCE_C014_426C_BC92_821420911E35
#. Edit msgstr; keep msgctxt and msgid unchanged.
msgctxt "page:first_AFF24FCE_C014_426C_BC92_821420911E35"
msgid "And the sound of a crackling fire."
msgstr "And the sound of a crackling fire."

#: scenario:first_ADB4F9C1_6C1D_466C_A6AE_D704E26D16A5
#. Edit msgstr; keep msgctxt and msgid unchanged.
msgctxt "page:first_ADB4F9C1_6C1D_466C_A6AE_D704E26D16A5"
msgid "{{gb:pause:0}}{{gb:style:1}}Wake up, Master.{{gb:endstyle:2}}"
msgstr "{{gb:pause:0}}{{gb:style:1}}Wake up, Master.{{gb:endstyle:2}}"

#: scenario:first_64AED7C6_7E70_4797_95B8_5FEA87FCEBDA
#. Edit msgstr; keep msgctxt and msgid unchanged.
msgctxt "page:first_64AED7C6_7E70_4797_95B8_5FEA87FCEBDA"
msgid ""
"{{gb:style:0}}Creak, {{gb:endstyle:1}}{{gb:pauseunits:2}}{{gb:style:3}}creak, {{gb:endstyle:4}}"
"{{gb:pauseunits:5}}{{gb:style:6}}creak.{{gb:endstyle:7}}"
msgstr ""
"{{gb:style:0}}Creak, {{gb:endstyle:1}}{{gb:pauseunits:2}}{{gb:style:3}}creak, {{gb:endstyle:4}}"
"{{gb:pauseunits:5}}{{gb:style:6}}creak.{{gb:endstyle:7}}"

#: scenario:first_E1C002DC_8CA6_44E2_992F_B987DBE0095F
#. Edit msgstr; keep msgctxt and msgid unchanged.
msgctxt "page:first_E1C002DC_8CA6_44E2_992F_B987DBE0095F"
msgid "{{gb:pause:0}}{{gb:style:1}}Wake up.{{gb:endstyle:2}}"
msgstr "{{gb:pause:0}}{{gb:style:1}}Wake up.{{gb:endstyle:2}}"

#: scenario:first_E1C86CAA_4E54_4AE6_9F69_C5E4B731EB51
#. Edit msgstr; keep msgctxt and msgid unchanged.
msgctxt "page:first_E1C86CAA_4E54_4AE6_9F69_C5E4B731EB51"
msgid ""
"{{gb:pauseunits:0}}{{gb:pauseunits:1}}When You came to, You were rocking back and forth in a "
"rocking chair."
msgstr ""
"{{gb:pauseunits:0}}{{gb:pauseunits:1}}When You came to, You were rocking back and forth in a "
"rocking chair."

#: scenario:scenario_D4FF2400_8393_4FDF_99CA_C8E8DDEBEA27
#. Edit msgstr; keep msgctxt and msgid unchanged.
msgctxt "page:scenario_D4FF2400_8393_4FDF_99CA_C8E8DDEBEA27"
msgid ""
"The room was dimly lit; {{gb:confirm:0}}aside from the flickering of the fireplace, there was no "
"other illumination."
msgstr ""
"The room was dimly lit; {{gb:confirm:0}}aside from the flickering of the fireplace, there was no "
"other illumination."

#: scenario:first_9B1F8BB5_7AD3_47AF_B692_87373028E8E7
#. Edit msgstr; keep msgctxt and msgid unchanged.
msgctxt "page:first_9B1F8BB5_7AD3_47AF_B692_87373028E8E7"
msgid ""
"No light shone through the closed windows;{{gb:break:0}}there was only the pitter-patter of rain "
"on the glass.{{gb:confirm:1}}{{gb:break:2}}It was as though the whole mansion had been enveloped "
"in darkness."
msgstr ""
"No light shone through the closed windows;{{gb:break:0}}there was only the pitter-patter of rain "
"on the glass.{{gb:confirm:1}}{{gb:break:2}}It was as though the whole mansion had been enveloped "
"in darkness."

#: scenario:first_3675C0FE_B595_46A4_8729_173AACA6B810
#. Edit msgstr; keep msgctxt and msgid unchanged.
msgctxt "page:first_3675C0FE_B595_46A4_8729_173AACA6B810"
msgid "Oh, splendid...{{gb:confirm:0}}{{gb:break:1}}You have finally awoken."
msgstr "Oh, splendid...{{gb:confirm:0}}{{gb:break:1}}You have finally awoken."

#: scenario:scenario_DEF8E5D2_5E70_458C_B883_CF0620E61EC1
#. Edit msgstr; keep msgctxt and msgid unchanged.
msgctxt "page:scenario_DEF8E5D2_5E70_458C_B883_CF0620E61EC1"
msgid ""
"Someone called out to You.{{gb:confirm:0}}{{gb:break:1}}You were about to search the room, but "
"that turned out to be unnecessary."
msgstr ""
"Someone called out to You.{{gb:confirm:0}}{{gb:break:1}}You were about to search the room, but "
"that turned out to be unnecessary."

#: scenario:first_BE2E91F1_927C_45A2_ADA5_26E15DE54290
#. Edit msgstr; keep msgctxt and msgid unchanged.
msgctxt "page:first_BE2E91F1_927C_45A2_ADA5_26E15DE54290"
msgid "The source of the voice was crouching beside the chair, looking up at You with emerald eyes."
msgstr ""
"The source of the voice was crouching beside the chair, looking up at You with emerald eyes."

#: scenario:scenario_EEDD192A_1898_4B57_B932_63297D4A85E9
#. Edit msgstr; keep msgctxt and msgid unchanged.
msgctxt "page:scenario_EEDD192A_1898_4B57_B932_63297D4A85E9"
msgid "............"
msgstr "............"

#: scenario:scenario_EEDD192A_1898_4B57_B932_63297D4A75E9
#. Edit msgstr; keep msgctxt and msgid unchanged.
msgctxt "page:scenario_EEDD192A_1898_4B57_B932_63297D4A75E9"
msgid "Good morning, Master."
msgstr "Good morning, Master."

#: scenario:scenario_EEDD192A_1898_4B57_B992_63297D4A75E9
#. Edit msgstr; keep msgctxt and msgid unchanged.
msgctxt "page:scenario_EEDD192A_1898_4B57_B992_63297D4A75E9"
msgid ""
"Hehe, what is the matter?{{gb:confirm:0}}{{gb:break:1}}Are you still waking up?{{gb:confirm:2}}"
"{{gb:break:3}}You seem rather drowsy."
msgstr ""
"Hehe, what is the matter?{{gb:confirm:0}}{{gb:break:1}}Are you still waking up?{{gb:confirm:2}}"
"{{gb:break:3}}You seem rather drowsy."

#: scenario:scenario_EEDD192A_1898_4B57_B932_63297D4A75E9-repeat2
#. Edit msgstr; keep msgctxt and msgid unchanged.
msgctxt "page:scenario_EEDD192A_1898_4B57_B932_63297D4A75E9-repeat2"
msgid ""
"Come now, you must gather yourself.{{gb:confirm:0}}{{gb:break:1}}Though I {{gb:style:2}}"
"am{{gb:endstyle:3}} glad to hear your voice."
msgstr ""
"Come now, you must gather yourself.{{gb:confirm:0}}{{gb:break:1}}Though I {{gb:style:2}}"
"am{{gb:endstyle:3}} glad to hear your voice."

#: scenario:scenario_EEDD192A_2898_6B57_B992_63297D4A75E9
#. Edit msgstr; keep msgctxt and msgid unchanged.
msgctxt "page:scenario_EEDD192A_2898_6B57_B992_63297D4A75E9"
msgid ""
"Oh my, is something the matter?{{gb:confirm:0}}{{gb:break:1}}Why do you stare at me like that?"
"{{gb:confirm:2}}{{gb:break:3}}Is there something on my face?"
msgstr ""
"Oh my, is something the matter?{{gb:confirm:0}}{{gb:break:1}}Why do you stare at me like that?"
"{{gb:confirm:2}}{{gb:break:3}}Is there something on my face?"

#: scenario:scenario_EEDD992A_1898_4B57_B932_63297D4A75E9
#. Edit msgstr; keep msgctxt and msgid unchanged.
msgctxt "page:scenario_EEDD992A_1898_4B57_B932_63297D4A75E9"
msgid ""
"“It was a surprising sight to wake up to”?{{gb:confirm:0}}{{gb:break:1}}Hehehe, I didn’t mean to "
"startle you."
msgstr ""
"“It was a surprising sight to wake up to”?{{gb:confirm:0}}{{gb:break:1}}Hehehe, I didn’t mean to "
"startle you."

#: scenario:scenario_EEDD192A_1898_4B57_B932_63297D4A74E9
#. Edit msgstr; keep msgctxt and msgid unchanged.
msgctxt "page:scenario_EEDD192A_1898_4B57_B932_63297D4A74E9"
msgid "I have simply been waiting so long for this moment."
msgstr "I have simply been waiting so long for this moment."

#: scenario:scenario_030F1964_1AB1_46F1_B13A_535FD494EBEE
#. Edit msgstr; keep msgctxt and msgid unchanged.
msgctxt "page:scenario_030F1964_1AB1_46F1_B13A_535FD494EBEE"
msgid ""
"Tending to the mansion all by my lonesome,{{gb:break:0}}ensuring it was ready for your return—"
"{{gb:pauseunits:1}}{{gb:pauseunits:2}}{{gb:break:3}}whenever that time may be."
msgstr ""
"Tending to the mansion all by my lonesome,{{gb:break:0}}ensuring it was ready for your return—"
"{{gb:pauseunits:1}}{{gb:pauseunits:2}}{{gb:break:3}}whenever that time may be."

#: scenario:scenario_9DF01A0E_BF40_442E_8434_CCA03BD6ED84
#. Edit msgstr; keep msgctxt and msgid unchanged.
msgctxt "page:scenario_9DF01A0E_BF40_442E_8434_CCA03BD6ED84"
msgid ""
"When I caught sight of you through the window,{{gb:break:0}}my heart fluttered. {{gb:confirm:1}}"
"The time had finally arrived."
msgstr ""
"When I caught sight of you through the window,{{gb:break:0}}my heart fluttered. {{gb:confirm:1}}"
"The time had finally arrived."

#: scenario:scenario_786CFC51_1180_4979_843D_DFAA8FF5CB56
#. Edit msgstr; keep msgctxt and msgid unchanged.
msgctxt "page:scenario_786CFC51_1180_4979_843D_DFAA8FF5CB56"
msgid "You were perplexed."
msgstr "You were perplexed."

#: scenario:scenario_01950270_4712_4CC8_9591_BA6A0E93D4D4
#. Edit msgstr; keep msgctxt and msgid unchanged.
msgctxt "page:scenario_01950270_4712_4CC8_9591_BA6A0E93D4D4"
msgid "This woman, who looked like a maid, seemed to know You, but You had no memory of her."
msgstr "This woman, who looked like a maid, seemed to know You, but You had no memory of her."

#: scenario:scenario_36D312AA_B1BC_4424_8368_EF3141CF64A0
#. Edit msgstr; keep msgctxt and msgid unchanged.
msgctxt "page:scenario_36D312AA_B1BC_4424_8368_EF3141CF64A0"
msgid ""
"What kind of herbal tea would you like to start your day with?{{gb:confirm:0}}{{gb:break:1}}I "
"have some wonderful chamomile leaves, if you would like."
msgstr ""
"What kind of herbal tea would you like to start your day with?{{gb:confirm:0}}{{gb:break:1}}I "
"have some wonderful chamomile leaves, if you would like."

#: scenario:scenario_5C228EBD_91E3_4C2B_BA41_C8A4AD2C4F7C
#. Edit msgstr; keep msgctxt and msgid unchanged.
msgctxt "page:scenario_5C228EBD_91E3_4C2B_BA41_C8A4AD2C4F7C"
msgid ""
"Or perhaps your tastes have changed since last we met.{{gb:confirm:0}}{{gb:break:1}}Tell me, "
"Master, what would you like?"
msgstr ""
"Or perhaps your tastes have changed since last we met.{{gb:confirm:0}}{{gb:break:1}}Tell me, "
"Master, what would you like?"

#: scenario:scenario_78C8F3C1_99A0_4B17_9E5A_851678DBBFE8
#. Edit msgstr; keep msgctxt and msgid unchanged.
msgctxt "page:scenario_78C8F3C1_99A0_4B17_9E5A_851678DBBFE8"
msgid ""
"Hehehe... {{gb:pauseunits:0}}I beg your pardon.{{gb:confirm:1}}{{gb:break:2}}I allowed myself to "
"get too excited."
msgstr ""
"Hehehe... {{gb:pauseunits:0}}I beg your pardon.{{gb:confirm:1}}{{gb:break:2}}I allowed myself to "
"get too excited."

#: scenario:scenario_0CD29F9F_029C_4DA5_8EC8_961F3523EB8D
#. Edit msgstr; keep msgctxt and msgid unchanged.
msgctxt "page:scenario_0CD29F9F_029C_4DA5_8EC8_961F3523EB8D"
msgid ""
"But I hope you will be sympathetic, Master.{{gb:confirm:0}}{{gb:break:1}}I am just utterly elated "
"that I could see you again."
msgstr ""
"But I hope you will be sympathetic, Master.{{gb:confirm:0}}{{gb:break:1}}I am just utterly elated "
"that I could see you again."

#: scenario:scenario_33BA479C_7F52_4A11_8119_1327DBA95E31
#. Edit msgstr; keep msgctxt and msgid unchanged.
msgctxt "page:scenario_33BA479C_7F52_4A11_8119_1327DBA95E31"
msgid ""
"The woman appeared to be genuinely delighted that You had awoken, but she seemed to lack the "
"energy typical of her age."
msgstr ""
"The woman appeared to be genuinely delighted that You had awoken, but she seemed to lack the "
"energy typical of her age."

#: scenario:scenario_B0CFA04E_4360_41E7_826F_7C7B97FCA936
#. Edit msgstr; keep msgctxt and msgid unchanged.
msgctxt "page:scenario_B0CFA04E_4360_41E7_826F_7C7B97FCA936"
msgid "Or perhaps “life” was a more appropriate word than “energy.”"
msgstr "Or perhaps “life” was a more appropriate word than “energy.”"

#: scenario:scenario_3691FA4F_585E_4124_A85A_08B5F77887A0
#. Edit msgstr; keep msgctxt and msgid unchanged.
msgctxt "page:scenario_3691FA4F_585E_4124_A85A_08B5F77887A0"
msgid ""
"But the gloom extended beyond the Maid—{{gb:pauseunits:0}}{{gb:pauseunits:1}}it seemed to "
"encompass the entire mansion."
msgstr ""
"But the gloom extended beyond the Maid—{{gb:pauseunits:0}}{{gb:pauseunits:1}}it seemed to "
"encompass the entire mansion."

#: scenario:scenario_C7CCFCFB_07DF_46B2_83BF_0E73E9FC1D27
#. Edit msgstr; keep msgctxt and msgid unchanged.
msgctxt "page:scenario_C7CCFCFB_07DF_46B2_83BF_0E73E9FC1D27"
msgid ""
"The plaster walls illuminated by the fireplace and the rose engravings in the ebony pillars felt "
"vaguely familiar."
msgstr ""
"The plaster walls illuminated by the fireplace and the rose engravings in the ebony pillars felt "
"vaguely familiar."

#: scenario:scenario_10F6AF30_947D_4862_8FA5_77E61F3514DB
#. Edit msgstr; keep msgctxt and msgid unchanged.
msgctxt "page:scenario_10F6AF30_947D_4862_8FA5_77E61F3514DB"
msgid "But a crushing sense of claustrophobia overpowered that familiarity."
msgstr "But a crushing sense of claustrophobia overpowered that familiarity."

#: scenario:scenario_7309026B_7B99_4803_B36B_1C58611FEC61
#. Edit msgstr; keep msgctxt and msgid unchanged.
msgctxt "page:scenario_7309026B_7B99_4803_B36B_1C58611FEC61"
msgid "It seemed as though the house wasn’t interested in accepting You just yet."
msgstr "It seemed as though the house wasn’t interested in accepting You just yet."

#: scenario:scenario_D0B5A739_A73A_4C42_B8E6_FD24D3722F26
#. Edit msgstr; keep msgctxt and msgid unchanged.
msgctxt "page:scenario_D0B5A739_A73A_4C42_B8E6_FD24D3722F26"
msgid "Oh my, you do not know who I am?"
msgstr "Oh my, you do not know who I am?"

#: scenario:scenario_D0B5A739_A73A_4C42_B8E6_FD24D3722F56
#. Edit msgstr; keep msgctxt and msgid unchanged.
msgctxt "page:scenario_D0B5A739_A73A_4C42_B8E6_FD24D3722F56"
msgid "Do you not know who you are, either?"
msgstr "Do you not know who you are, either?"

#: scenario:scenario_58D10758_5CA7_4E7E_9E6C_B3E29772B14D
#. Edit msgstr; keep msgctxt and msgid unchanged.
msgctxt "page:scenario_58D10758_5CA7_4E7E_9E6C_B3E29772B14D"
msgid "That is quite the predicament."
msgstr "That is quite the predicament."

#: scenario:scenario_B4FDE4A5_7FD3_47F4_98EA_3429B2DAF175
#. Edit msgstr; keep msgctxt and msgid unchanged.
msgctxt "page:scenario_B4FDE4A5_7FD3_47F4_98EA_3429B2DAF175"
msgid "If you cannot remember who you are,{{gb:break:0}}then who am I to serve?"
msgstr "If you cannot remember who you are,{{gb:break:0}}then who am I to serve?"

#: scenario:scenario_F2F6E58B_7ED3_4924_A9F7_9DD012B76DB8
#. Edit msgstr; keep msgctxt and msgid unchanged.
msgctxt "page:scenario_F2F6E58B_7ED3_4924_A9F7_9DD012B76DB8"
msgid "The woman’s face was pale, almost as though she..."
msgstr "The woman’s face was pale, almost as though she..."

#: scenario:scenario_B672483A_4C17_4AF7_8E26_BC553F3F471B
#. Edit msgstr; keep msgctxt and msgid unchanged.
msgctxt "page:scenario_B672483A_4C17_4AF7_8E26_BC553F3F471B"
msgid "A faint chill ran down Your spine."
msgstr "A faint chill ran down Your spine."

#: scenario:scenario_A1205768_128C_4733_ADA1_924A59D38568
#. Edit msgstr; keep msgctxt and msgid unchanged.
msgctxt "page:scenario_A1205768_128C_4733_ADA1_924A59D38568"
msgid ""
"You are the master of this house.{{gb:confirm:0}}{{gb:break:1}}Though it would seem you have no "
"memories of such.{{gb:confirm:2}}{{gb:break:3}}Quite the dilemma..."
msgstr ""
"You are the master of this house.{{gb:confirm:0}}{{gb:break:1}}Though it would seem you have no "
"memories of such.{{gb:confirm:2}}{{gb:break:3}}Quite the dilemma..."

#: scenario:scenario_9D29A830_27A4_4F10_A954_8424F4C087FF
#. Edit msgstr; keep msgctxt and msgid unchanged.
msgctxt "page:scenario_9D29A830_27A4_4F10_A954_8424F4C087FF"
msgid "If you know not who you are,"
msgstr "If you know not who you are,"

#: scenario:scenario_6E2CC821_CD27_4B3A_881C_25232FACED90
#. Edit msgstr; keep msgctxt and msgid unchanged.
msgctxt "page:scenario_6E2CC821_CD27_4B3A_881C_25232FACED90"
msgid "then you are no different than a stranger to me, no?"
msgstr "then you are no different than a stranger to me, no?"

#: scenario:scenario_E76A3A39_2321_4697_A845_B9D30C4E883A
#. Edit msgstr; keep msgctxt and msgid unchanged.
msgctxt "page:scenario_E76A3A39_2321_4697_A845_B9D30C4E883A"
msgid ""
"Indeed, you have returned.{{gb:confirm:0}}{{gb:break:1}}But from where? {{gb:confirm:2}}That, I "
"cannot say."
msgstr ""
"Indeed, you have returned.{{gb:confirm:0}}{{gb:break:1}}But from where? {{gb:confirm:2}}That, I "
"cannot say."

#: scenario:scenario_DFCE3B0E_5C56_4B8F_8FC5_3F6550B65ECF
#. Edit msgstr; keep msgctxt and msgid unchanged.
msgctxt "page:scenario_DFCE3B0E_5C56_4B8F_8FC5_3F6550B65ECF"
msgid "Then how about this?"
msgstr "Then how about this?"

#: scenario:scenario_E7C498E0_DBE2_4235_9DD0_94F92B255799
#. Edit msgstr; keep msgctxt and msgid unchanged.
msgctxt "page:scenario_E7C498E0_DBE2_4235_9DD0_94F92B255799"
msgid ""
"I am a servant of this mansion, and as such,{{gb:break:0}}I am familiar with the many incidents "
"that have taken place here.{{gb:confirm:1}}{{gb:break:2}}I shall show you the history of this "
"house, Master."
msgstr ""
"I am a servant of this mansion, and as such,{{gb:break:0}}I am familiar with the many incidents "
"that have taken place here.{{gb:confirm:1}}{{gb:break:2}}I shall show you the history of this "
"house, Master."

#: scenario:scenario_026CDFF8_D69A_4968_AA58_2A83D1DF2721
#. Edit msgstr; keep msgctxt and msgid unchanged.
msgctxt "page:scenario_026CDFF8_D69A_4968_AA58_2A83D1DF2721"
msgid "That will surely allow you to recall who you are."
msgstr "That will surely allow you to recall who you are."

#: scenario:scenario_9E69DD74_1FB2_43E0_84E4_F946145FAC24
#. Edit msgstr; keep msgctxt and msgid unchanged.
msgctxt "page:scenario_9E69DD74_1FB2_43E0_84E4_F946145FAC24"
msgid ""
"The freshly awakened gears in Your head began to turn as You mulled things over. {{gb:confirm:0}}"
"The Maid had called You the “master” of this house."
msgstr ""
"The freshly awakened gears in Your head began to turn as You mulled things over. {{gb:confirm:0}}"
"The Maid had called You the “master” of this house."

#: scenario:scenario_A8C1E217_42E2_4EAC_B9E8_0234433AB5F2
#. Edit msgstr; keep msgctxt and msgid unchanged.
msgctxt "page:scenario_A8C1E217_42E2_4EAC_B9E8_0234433AB5F2"
msgid ""
"But without a single mirror in the room,{{gb:break:0}}You had no way of seeing what You looked "
"like."
msgstr ""
"But without a single mirror in the room,{{gb:break:0}}You had no way of seeing what You looked "
"like."

#: scenario:scenario_6AF86C38_B6C1_4C91_8A22_569C72053F2A
#. Edit msgstr; keep msgctxt and msgid unchanged.
msgctxt "page:scenario_6AF86C38_B6C1_4C91_8A22_569C72053F2A"
msgid "Unable to decide, You reflexively nodded."
msgstr "Unable to decide, You reflexively nodded."

#: scenario:scenario_6D8729E1_6EED_4BA1_B343_A6B2C764A9C9
#. Edit msgstr; keep msgctxt and msgid unchanged.
msgctxt "page:scenario_6D8729E1_6EED_4BA1_B343_A6B2C764A9C9"
msgid ""
"Let us be off, then.{{gb:confirm:0}}{{gb:break:1}}And fear not—{{gb:pauseunits:2}}"
"{{gb:pauseunits:3}}I merely entreat you not to let go of my hand."
msgstr ""
"Let us be off, then.{{gb:confirm:0}}{{gb:break:1}}And fear not—{{gb:pauseunits:2}}"
"{{gb:pauseunits:3}}I merely entreat you not to let go of my hand."

#: scenario:scenario_B06F28F8_900F_4E60_A10B_DE6DCA8358E7
#. Edit msgstr; keep msgctxt and msgid unchanged.
msgctxt "page:scenario_B06F28F8_900F_4E60_A10B_DE6DCA8358E7"
msgid ""
"Should you hold it tightly, you need not worry about being washed away by the waves of history."
msgstr ""
"Should you hold it tightly, you need not worry about being washed away by the waves of history."

#: scenario:scenario_D2137210_5983_4B19_91CB_1A67E3C78170
#. Edit msgstr; keep msgctxt and msgid unchanged.
msgctxt "page:scenario_D2137210_5983_4B19_91CB_1A67E3C78170"
msgid "No matter what happens, you mustn’t let go of my hand."
msgstr "No matter what happens, you mustn’t let go of my hand."

#: scenario:scenario_765D0949_C52A_4EC4_8847_D1E554D77064
#. Edit msgstr; keep msgctxt and msgid unchanged.
msgctxt "page:scenario_765D0949_C52A_4EC4_8847_D1E554D77064"
msgid "Your hand in hers, You followed the Maid’s lead through the hall."
msgstr "Your hand in hers, You followed the Maid’s lead through the hall."

#: scenario:scenario_86F1AB8D_1838_4908_9CEC_1C64C1565762
#. Edit msgstr; keep msgctxt and msgid unchanged.
msgctxt "page:scenario_86F1AB8D_1838_4908_9CEC_1C64C1565762"
msgid ""
"The air within the mansion was oppressive, as though a black miasma hovered within. "
"{{gb:confirm:0}}The house was bleak and barren—{{gb:pauseunits:1}}{{gb:pauseunits:2}}hardly a "
"trace of color to be found."
msgstr ""
"The air within the mansion was oppressive, as though a black miasma hovered within. "
"{{gb:confirm:0}}The house was bleak and barren—{{gb:pauseunits:1}}{{gb:pauseunits:2}}hardly a "
"trace of color to be found."

#: scenario:scenario_49A05E12_9D9F_4315_8EB6_24A779ADE75D
#. Edit msgstr; keep msgctxt and msgid unchanged.
msgctxt "page:scenario_49A05E12_9D9F_4315_8EB6_24A779ADE75D"
msgid ""
"You came across an open window.{{gb:confirm:0}}{{gb:break:1}}Beyond it lay nothing but darkness—"
"{{gb:pauseunits:2}}{{gb:pauseunits:3}}neither sunlight nor moonlight could be seen."
msgstr ""
"You came across an open window.{{gb:confirm:0}}{{gb:break:1}}Beyond it lay nothing but darkness—"
"{{gb:pauseunits:2}}{{gb:pauseunits:3}}neither sunlight nor moonlight could be seen."

#: scenario:scenario_D312E403_5EC0_44E6_B383_24B73284D074
#. Edit msgstr; keep msgctxt and msgid unchanged.
msgctxt "page:scenario_D312E403_5EC0_44E6_B383_24B73284D074"
msgid ""
"There were no chirping birds, no rustling grass, no signs of life at all. {{gb:confirm:0}}"
"Everything that would normally give color to the world had vanished entirely."
msgstr ""
"There were no chirping birds, no rustling grass, no signs of life at all. {{gb:confirm:0}}"
"Everything that would normally give color to the world had vanished entirely."

#: scenario:scenario_8FC56747_E057_421C_85C6_9BECDB4D4EA9
#. Edit msgstr; keep msgctxt and msgid unchanged.
msgctxt "page:scenario_8FC56747_E057_421C_85C6_9BECDB4D4EA9"
msgid "The only other presence was that of the Maid."
msgstr "The only other presence was that of the Maid."

#: scenario:scenario_ADD011BC_424D_4F2C_BE07_EDF18B03538D
#. Edit msgstr; keep msgctxt and msgid unchanged.
msgctxt "page:scenario_ADD011BC_424D_4F2C_BE07_EDF18B03538D"
msgid "Following her lead, You proceeded through the mansion."
msgstr "Following her lead, You proceeded through the mansion."

#: scenario:scenario_7D48FC52_3F6B_4A90_8B57_9F91B3A8DA3B
#. Edit msgstr; keep msgctxt and msgid unchanged.
msgctxt "page:scenario_7D48FC52_3F6B_4A90_8B57_9F91B3A8DA3B"
msgid ""
"After some time, You arrived at a double door, the glass within shattered. {{gb:confirm:0}}The "
"door, once pure-white, had long since faded into a dull gray."
msgstr ""
"After some time, You arrived at a double door, the glass within shattered. {{gb:confirm:0}}The "
"door, once pure-white, had long since faded into a dull gray."

#: scenario:scenario_7256E9ED_9DCC_45D3_8158_521677342D8C
#. Edit msgstr; keep msgctxt and msgid unchanged.
msgctxt "page:scenario_7256E9ED_9DCC_45D3_8158_521677342D8C"
msgid "It appeared to lead to the back garden."
msgstr "It appeared to lead to the back garden."

#: scenario:scenario_7256E9ED_9DCC_45D3_8158_521677342D8A
#. Edit msgstr; keep msgctxt and msgid unchanged.
msgctxt "page:scenario_7256E9ED_9DCC_45D3_8158_521677342D8A"
msgid "You could hear children laughing on the other side."
msgstr "You could hear children laughing on the other side."

#: scenario:scenario_3C3E4AC9_FDC3_4C36_ADE6_AAB4249E0AA7
#. Edit msgstr; keep msgctxt and msgid unchanged.
msgctxt "page:scenario_3C3E4AC9_FDC3_4C36_ADE6_AAB4249E0AA7"
msgid ""
"Though it is in the state you now see it,{{gb:break:0}}a beautiful, beautiful garden once lay "
"beyond these doors."
msgstr ""
"Though it is in the state you now see it,{{gb:break:0}}a beautiful, beautiful garden once lay "
"beyond these doors."

#: scenario:scenario_049E11B1_65C8_4480_B0EC_D0A8640B7AF5
#. Edit msgstr; keep msgctxt and msgid unchanged.
msgctxt "page:scenario_049E11B1_65C8_4480_B0EC_D0A8640B7AF5"
msgid ""
"The owner of the time enjoyed gathering rare species of rose from all across the world. "
"{{gb:confirm:0}}At its grandest, it seemed every flower was in constant competition for the most "
"majestic bloom."
msgstr ""
"The owner of the time enjoyed gathering rare species of rose from all across the world. "
"{{gb:confirm:0}}At its grandest, it seemed every flower was in constant competition for the most "
"majestic bloom."

#: scenario:scenario_2E2DDB84_D1B6_48D6_8027_1684E4CB8E94
#. Edit msgstr; keep msgctxt and msgid unchanged.
msgctxt "page:scenario_2E2DDB84_D1B6_48D6_8027_1684E4CB8E94"
msgid "Would you like to see this wonderful era of splendor and prosperity?"
msgstr "Would you like to see this wonderful era of splendor and prosperity?"

#: scenario:scenario_C545E734_549F_4077_A263_65FE1D78E9D6
#. Edit msgstr; keep msgctxt and msgid unchanged.
msgctxt "page:scenario_C545E734_549F_4077_A263_65FE1D78E9D6"
msgid "Hehehe..."
msgstr "Hehehe..."

#: scenario:scenario_C5B0EAE6_8615_48E2_AA4B_2BCB65003008
#. Edit msgstr; keep msgctxt and msgid unchanged.
msgctxt "page:scenario_C5B0EAE6_8615_48E2_AA4B_2BCB65003008"
msgid "I very much hope it is to your liking, Master."
msgstr "I very much hope it is to your liking, Master."

#: scenario:scenario_98128577_2BE0_4F07_9A38_7DC294C8B08A
#. Edit msgstr; keep msgctxt and msgid unchanged.
msgctxt "page:scenario_98128577_2BE0_4F07_9A38_7DC294C8B08A"
msgid "The Maid opened the doors to the back garden."
msgstr "The Maid opened the doors to the back garden."

#: scenario:scenario_F9CF72D3_E1F9_4B13_9E18_55D77E02BA7F
#. Edit msgstr; keep msgctxt and msgid unchanged.
msgctxt "page:scenario_F9CF72D3_E1F9_4B13_9E18_55D77E02BA7F"
msgid ""
"A sudden gust of wind brushed across Your face, forcing You to close Your eyes as You followed "
"the Maid out the doors."
msgstr ""
"A sudden gust of wind brushed across Your face, forcing You to close Your eyes as You followed "
"the Maid out the doors."

#: scenario:scenario_E8F2E811_AC7F_4B2D_9E8C_3F2D4CF9973E
#. Edit msgstr; keep msgctxt and msgid unchanged.
msgctxt "page:scenario_E8F2E811_AC7F_4B2D_9E8C_3F2D4CF9973E"
msgid "When You next opened Your eyes, the world was no longer blanketed in shadows."
msgstr "When You next opened Your eyes, the world was no longer blanketed in shadows."
