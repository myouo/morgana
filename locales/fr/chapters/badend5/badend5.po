#: badend5:badend5_BBEF13A2_BB0F_4A79_B501_E9A68ED3ECA9
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: d9873e8de35ea0a9896e085f6651fb9f9a188c5dc5aeae2d13f57df9c5331d4b
#. default-sha256: ab19b02ef857517a25174a15385baec6075867585cb8d67387972c6e7c509fae
msgctxt "badend5:badend5_BBEF13A2_BB0F_4A79_B501_E9A68ED3ECA9"
msgid ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫⟪k:4⟫⟪k:5⟫⟪k:6⟫⟪k:7⟫⟪k:8⟫⟪k:9⟫⟪k:10⟫⟪k:11⟫⟪k:12⟫⟪k:13⟫⟪k:14⟫⟪k:15⟫⟪k:16⟫"
"You’ve made the right decision, Michel."
msgstr ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫⟪k:4⟫⟪k:5⟫⟪k:6⟫⟪k:7⟫⟪k:8⟫⟪k:9⟫⟪k:10⟫⟪k:11⟫⟪k:12⟫⟪k:13⟫⟪k:14⟫⟪k:15⟫⟪k:16⟫Tu as "
"fait le bon choix, Michel."

#: badend5:badend5_83564003_4394_490F_B68B_0F69DF183169
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: b24e4df199efcc78e4a64dfac2dec32aa9b97f3dc91d765fd1432106b3a56094
#. default-sha256: 3afb17944c5ecdde68e90c223558900ade0f84f72cb6e6d20f1db5c48c593a01
msgctxt "badend5:badend5_83564003_4394_490F_B68B_0F69DF183169"
msgid "⟪k:0⟫Your tragic tale has finally come to an end."
msgstr "⟪k:0⟫Ton histoire tragique est enfin arrivée à son terme."

#: badend5:badend5_B76F5D6E_10F3_4739_9D24_003030A012AB
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 8d94845487b06378985aa466b81393f6bd9c52e84b3387cb13ccefdccb5b84bb
#. default-sha256: adea8811eca79ccd71af96dadc426b27461e54bc2aac42517c2693c4ceb3f225
msgctxt "badend5:badend5_B76F5D6E_10F3_4739_9D24_003030A012AB"
msgid ""
"⟪k:0⟫You’re free from the grip of this cursed mansion—⟪k:1⟫⟪k:2⟫free to begin your life anew."
msgstr "⟪k:0⟫Tu es libéré de l’emprise de ce maudit manoir —⟪k:1⟫⟪k:2⟫libre de recommencer ta vie."

#: badend5:badend5_B5231881_9804_4A29_9A8D_C27497A519D2
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: a7d8f7644c908373cfcc54b4a5820ad8775e39d84045a6fae567d7d09efce38e
#. default-sha256: eb1f7464fc6e348463685415aa0d413a57d6af6fa65740b70f2aec458ab95fa5
msgctxt "badend5:badend5_B5231881_9804_4A29_9A8D_C27497A519D2"
msgid "⟪k:0⟫I wish you a wonderful life,"
msgstr "⟪k:0⟫Je te souhaite une vie merveilleuse,"

#: badend5:badend5_D76E6452_7102_4582_A162_5866DDAB8A55
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 8afd8bcc7e5870a1cf8d6c3c16eff3dea15f2ea5a55e2f4f8b6a2f9084a30ac5
#. default-sha256: 64c9f0a79e66c418d881f8fdb905556496eb41300c771628dea83041d07a6780
msgctxt "badend5:badend5_D76E6452_7102_4582_A162_5866DDAB8A55"
msgid "⟪k:0⟫richly fulfilling and abounding in light."
msgstr "⟪k:0⟫très enrichissante et remplie de lumière."

#: badend5:badend5_60370D30_8D56_42CF_B457_4881616FC1D7
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 5c0e4035ac6643468d9a0d0621202275386972713188da60e382559afe2fdd46
#. default-sha256: 8a6ddedf51ee0cde32e59fa11f92d935c6fc0d87a4880cf19866d519b65ca161
msgctxt "badend5:badend5_60370D30_8D56_42CF_B457_4881616FC1D7"
msgid ""
"⟪k:0⟫For you, my dear friend, I will not cast a curse,⟪k:1⟫⟪k:2⟫but give you my utmost blessing."
msgstr ""
"⟪k:0⟫Pour toi, mon cher ami, je ne jetterai aucun sort,⟪k:1⟫⟪k:2⟫au contraire je te donne ma plus "
"grande bénédiction."

