#: badend5:badend5_97113EAB_1C5C_404C_959A_3651C60A21A5
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 3799144ca0056d6a66fbd80cf4085f85e1de2e4e03e462d8ec02d81c3a78e490
#. default-sha256: 599ffb12c31914a732c10ff8b21759e8749cdc094f240bdf72dca98faebd533c
msgctxt "badend5:badend5_97113EAB_1C5C_404C_959A_3651C60A21A5"
msgid "⟪k:0⟫It was a day just like any other."
msgstr "⟪k:0⟫C’était un jour comme un autre."

#: badend5:badend5_16E70DB7_800A_4AB5_8915_E9E4B83CA6A1
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: b980878972fcf1b8b533fc65c2b5581475ce9c74076f8747a92247676a687791
#. default-sha256: 0343ceec035472b808b6fef1ae789e691c231cc772bcff6db7c4d88d10961113
msgctxt "badend5:badend5_16E70DB7_800A_4AB5_8915_E9E4B83CA6A1"
msgid ""
"⟪k:0⟫A layer of clouds drifted slowly across the sky.⟪k:1⟫⟪k:2⟫We sat across from one another at "
"a café’s outdoor table."
msgstr ""
"⟪k:0⟫Le ciel était couvert de nuages qui se déplaçaient lentement.⟪k:1⟫⟪k:2⟫On était assis l’un "
"en face de l’autre à la terrasse d’un café."

#: badend5:badend5_08D685DB_E611_4FA5_A9DF_2AF90B2BA5B8
