msgid "⟪k:0⟫What were... ⟪k:1⟫you saying, again?"
msgstr "⟪k:0⟫Qu’est-ce que... ⟪k:1⟫tu disais, déjà ?"

#: badend5:badend5_22A3A367_B50D_46BE_8D2A_00044CB8B667
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 52432774a69e7defcdab2fd6d259dd529bf8f68c902f061e873b64d61faea7f2
#. default-sha256: 31fd86b9842400f652c78e1d365d0473fd862046854bc8ed7903defbb744c8a0
msgctxt "badend5:badend5_22A3A367_B50D_46BE_8D2A_00044CB8B667"
msgid ""
"⟪k:0⟫Are you sure you’re okay?⟪k:1⟫⟪k:2⟫I was saying we need to settle on a destination for our "
"trip next month."
msgstr ""
"⟪k:0⟫T’es sûr que ça va ?⟪k:1⟫⟪k:2⟫J’étais en train de dire qu’il faut qu’on se décide où aller "
"pour notre voyage le mois prochain."

#: badend5:badend5_86396821_A704_466D_BDC8_B9DA192F8AC1
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 7bfebf5ded95398eee9b49fb3d6c087dcdc538ac0876343d74987492382ff653
#. default-sha256: 0c75b6a6caaa6eb57cbf5f52d7787b7fc51c58bdc6bf219d9a7ec66097b60b0c
msgctxt "badend5:badend5_86396821_A704_466D_BDC8_B9DA192F8AC1"
msgid "⟪k:0⟫Ahh... ⟪k:1⟫Anywhere you’d like is fine with me."
msgstr "⟪k:0⟫Ahh... ⟪k:1⟫Tout me va, tant que ça te plaît."

#: badend5:badend5_7B84C3A8_4D0F_4F9F_BAC2_E5C67DB83917
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: a092b93ca5fbef87048e634ea79a4e9944c8dbde46bcb79a59a6b629e2b9f4fc
#. default-sha256: 7dcf2b77c30d54a687a9349025df5a55b82ddcbec5d8770a9de1ff1361f90637
msgctxt "badend5:badend5_7B84C3A8_4D0F_4F9F_BAC2_E5C67DB83917"
msgid ""
"⟪k:0⟫Hehe... ⟪k:1⟫that’s always how it goes with you, isn’t it?⟪k:2⟫⟪k:3⟫You are allowed to have "
"an opinion of your own, you know."
msgstr ""
"⟪k:0⟫Hihi... ⟪k:1⟫c’est toujours la même chose avec toi, hein ?⟪k:2⟫⟪k:3⟫T’as le droit d’avoir "
"une opinion, tu sais."

#: badend5:badend5_8FAE56BF_1795_4ACC_B488_406EB3C79BEC
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 00d5925e51d4238b60f5f02d19097b6968f6ac1101a1e00c03559eb9ff0eb870
#. default-sha256: 5f500890750aaf7254db06467c3a4590c4cdbd3bec2527a33279861a3cf89009
msgctxt "badend5:badend5_8FAE56BF_1795_4ACC_B488_406EB3C79BEC"
msgid "⟪k:0⟫We’ll end up going to Prague again if you let me pick."
msgstr "⟪k:0⟫On va finir par retourner à Prague si tu me laisses choisir."

#: badend5:badend5_4F9A34C5_FB50_441D_A1C9_B99B9E40C585
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 6105fd1c11fdc46385b1d14ddd955ea2f2ea1e99d7e672c68d3a95d5d6c167a7
#. default-sha256: a20c0c563ce9c74f32f34539ead69e1320807df83bec0241e6f9e4041d6a9923
msgctxt "badend5:badend5_4F9A34C5_FB50_441D_A1C9_B99B9E40C585"
msgid ""
"⟪k:0⟫There’s nothing wrong with Prague.⟪k:1⟫⟪k:2⟫We can go see Mucha’s stained-glass window at "
"the St. Vitus Cathedral and visit the Petřín Gardens again."
msgstr ""
"⟪k:0⟫Il n’y a rien de mal à aller à Prague.⟪k:1⟫⟪k:2⟫On pourra aller voir les vitraux de Mucha à "
"la cathédrale Saint Guy et visiter à nouveau les jardins de Petřín."

#: badend5:badend5_DDC5A25E_7AAF_4FF8_957F_F3CCFF4C6A23
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: c1d1fee36250565eba7e8706dedecc3e72b7485dfd87126ebbc88533877ee167
#. default-sha256: efbeced1cc780697b3b549cfbfa41f59f86700c660b0ebddad14464023fcb9e9
msgctxt "badend5:badend5_DDC5A25E_7AAF_4FF8_957F_F3CCFF4C6A23"
msgid "⟪k:0⟫And maybe this time, we won’t be late for the Walk of the Apostles at the clock tower."
msgstr ""
"⟪k:0⟫Et peut-être que cette fois, on n’arrivera pas trop tard pour voir la marche des apôtres de "
"l’horloge astronomique."

#: badend5:badend5_235E0583_6691_45E7_BA54_F8BFDE73790C
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 0eddc50a05c70661140b5fec5e17fdb8a8b5330fe4c3dbb39f484efc3fbfe389
#. default-sha256: b3781aaa4680f6dce8c75b20b6f25718a93fb1db22c02b064f1a24d81aa0b689
msgctxt "badend5:badend5_235E0583_6691_45E7_BA54_F8BFDE73790C"
msgid "⟪k:0⟫All right, then we should start looking at hotels."
msgstr "⟪k:0⟫Très bien, alors on devrait commencer par chercher un hôtel."

#: badend5:badend5_BE7D8084_75C7_447A_AA86_79065F6C5CC7
