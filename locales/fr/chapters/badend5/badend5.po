#: badend5:badend5_5D7A5D26_0D02_4F27_98DD_7C5277A389E1
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 7dc1530b4b99161cc6d035abbb2e875fe81e9b06b9904439f4f0414ead1229f6
#. default-sha256: f43f74795dc79b056566996beba69cfaf17bf44b6a204e638167d29b4e632af2
msgctxt "badend5:badend5_5D7A5D26_0D02_4F27_98DD_7C5277A389E1"
msgid ""
"⟪k:0⟫Farewell, Michel.⟪k:1⟫⟪k:2⟫Until our souls cross paths once more⟪k:3⟫in the boundless sphere "
"of fate."
msgstr ""
"⟪k:0⟫Adieu, Michel.⟪k:1⟫⟪k:2⟫Au revoir, jusqu’à ce que nos âmes se croisent à nouveau⟪k:3⟫dans la "
"sphère infinie du destin."

