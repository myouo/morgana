#: badend5:badend5_F770B190_B8F6_499E_8CEC_B78F26A93231
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 7864fbeecdffdddc478c06ba0e00b6997d20ccf4d89c2edda1ff5a96fcd74846
#. default-sha256: eb8a6660afea17ac8268a96b564b21530eebf2e28b23deedcb4efbf937219c56
msgctxt "badend5:badend5_F770B190_B8F6_499E_8CEC_B78F26A93231"
msgid ""
"⟪k:0⟫I’ve been trying to get your attention for some time,⟪k:1⟫⟪k:2⟫but you were just staring off "
"into the distance."
msgstr ""
"⟪k:0⟫Ça fait un petit moment que j’essaie d’attirer ton attention,⟪k:1⟫⟪k:2⟫mais t’avais le "
"regard dans le vide."

