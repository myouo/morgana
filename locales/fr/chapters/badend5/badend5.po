msgctxt "badend5:badend5_121A7CDC_3548_4519_9C0D_1EACDCD8F100"
msgid "⟪k:0⟫Oh, ⟪k:1⟫um, ⟪k:2⟫sorry. I’m fine."
msgstr "⟪k:0⟫Ah, ⟪k:1⟫hum, ⟪k:2⟫désolé. Tout va bien."

#: badend5:badend5_14843988_FD1C_4853_853A_52A5802A150B
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: d6cbb94421a806f3291151fb7916e49a1a590810dde4282e3d8ba665ed68e831
