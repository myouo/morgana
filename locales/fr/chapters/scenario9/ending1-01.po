msgctxt "scenario9:scenario9_674CEFAD_690E_4D6F_8E66_67076AF5F197"
msgid "⟪k:0⟫............"
msgstr "⟪k:0⟫............"

#: scenario9:scenario9_E6E37D27_E7E9_4AD8_B0AA_20F76E48BEC2
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 9165265c76f419db2cb40a6730e5c2e9e75ff2f02c980bebd7d517d22d2519f4
#. default-sha256: 7bee75b703cb3d18234ca86ee4cd0605027e1b7b761b8893a76d37bcd82e1851
msgctxt "scenario9:scenario9_E6E37D27_E7E9_4AD8_B0AA_20F76E48BEC2"
msgid ""
"⟪k:0⟫Upon her death, Morgana’s soul was afflicted with great pain resulting from the hatred and "
"resentment she bore."
msgstr ""
"⟪k:0⟫⟪k:1⟫À⟪k:2⟫ sa mort, l’âme de Morgana a été affligée d’une grande douleur, résultant de la "
"haine et de la rancœur qui régnaient en elle."

#: scenario9:scenario9_61E105AB_CBC5_45F8_BB12_D4BBD464AF7B
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 2d648cbdd89e4ab15bd3fda027cb822c38f0d56938a1e311cebaed9f6fd2b7f0
#. default-sha256: 2ccb495eb13f4fe21bb2754284c67a0617bb032cca1b70fbdfe4efc80c160326
msgctxt "scenario9:scenario9_61E105AB_CBC5_45F8_BB12_D4BBD464AF7B"
msgid ""
"⟪k:0⟫A saint must put herself second to all others.⟪k:1⟫⟪k:2⟫She must be caring, generous, "
"forgiving.⟪k:3⟫⟪k:4⟫And she must not bear any ill will for anyone."
msgstr ""
"⟪k:0⟫Une sainte doit toujours placer le bien-être des autres avant le sien.⟪k:1⟫⟪k:2⟫Elle doit "
"être aimante, généreuse, indulgente.⟪k:3⟫⟪k:4⟫Et elle ne doit nourrir aucune animosité."

#: scenario9:scenario9_22806235_A709_4C41_AC81_AD9B75A68C5F
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: a6fcf153cc31fd25e9a4b4eddcd9c30ff4f0443c2f3ba89858bfa85ac4a5b4ad
#. default-sha256: d7079ef31718662267bb891a40595ae088a7566175f0a5bab7be78951d5053f4
msgctxt "scenario9:scenario9_22806235_A709_4C41_AC81_AD9B75A68C5F"
msgid "⟪k:0⟫So that’s why you always seemed so... ⟪k:1⟫abnormally pure-hearted..."
msgstr "⟪k:0⟫C’est donc pour ça que tu avais toujours l’air aussi étrangement... ⟪k:1⟫angélique..."

#: scenario9:scenario9_C7844E63_00A8_4A5C_9E40_77B244818EEF
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 8039e9ec9d626a957fc63c35223b1d140a4f9814a878812f47d3748f3615446e
#. default-sha256: d81b075a1fad9c519ca9ae0ce82a778f7d90d71c6e07fa8ca4f852ec274c4389
msgctxt "scenario9:scenario9_C7844E63_00A8_4A5C_9E40_77B244818EEF"
msgid "⟪k:0⟫I refuse to accept..."
msgstr "⟪k:0⟫Je refuse de croire..."

#: scenario9:scenario9_DB5FE44D_E8BF_4FE4_ADC3_359A9861FAAA
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 726b93ddeb5c511ba96cce7ebbfc32e312e35267b923a2382753f6901f2ff0c4
#. default-sha256: e291d94f0bc94d74aa74e957fff447e74465bf2a5d64e0836be15c27f2edf277
msgctxt "scenario9:scenario9_DB5FE44D_E8BF_4FE4_ADC3_359A9861FAAA"
msgid "⟪k:0⟫I was never meant to be a soul of my own."
msgstr "⟪k:0⟫Je n’aurais jamais dû être une âme à part entière."

#: scenario9:scenario9_ED3E19B4_F27A_4DBB_9407_E7BDA4CD3900
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 2a90d1a4535a143f31d7d195a12fa2d24a41d92488db31b33cc874255c43b0a2
#. default-sha256: f879bb2db2c37b6a74790d60997c94442f4977b5fa1fb5b07e71928ff87bb11f
msgctxt "scenario9:scenario9_ED3E19B4_F27A_4DBB_9407_E7BDA4CD3900"
msgid "⟪k:0⟫I wished to live,"
msgstr "⟪k:0⟫Je voulais vivre,"

#: scenario9:scenario9_9A5A72F1_0937_45A3_9907_771883651318
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 84abcaef47c5f6bd01fe25e9cb82b69311ad91f3658412751418929ff366a9b9
#. default-sha256: 5e8e7ef8d2d0b66e461668a4ea6e5275f49a72d31293960159703d642e61f8c6
msgctxt "scenario9:scenario9_9A5A72F1_0937_45A3_9907_771883651318"
msgid "⟪k:0⟫but your own wish?"
msgstr "⟪k:0⟫...mais ton propre vœu ?"

#: scenario9:scenario9_01EDA556_A383_47E5_9362_9F8E1A0E37F5
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 1f29a4012af1b0c8742bc80c69f4096cf588267e4a6369df3d87902745349a79
#. default-sha256: efa725156a855ab6ed6f84f662af972bde50ab0992203a205ef278de793aefc2
msgctxt "scenario9:scenario9_01EDA556_A383_47E5_9362_9F8E1A0E37F5"
msgid "⟪k:0⟫Which meant that my wish... ⟪k:1⟫had the consequence of granting Morgana’s with it."
msgstr ""
"⟪k:0⟫Ce qui veut dire que mon souhait... ⟪k:1⟫eut pour conséquence d’exaucer également celui de "
"Morgana."

#: scenario9:scenario9_EA770485_F763_4E16_90CA_B38FFE952A0A
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 9296d827f24d3f556de369fd5566711bedc350e665dc4ebf7204053434f77596
#. default-sha256: 80049e2ea8c8df40f9dda0db393923c54f85fa81dd7465c5d04b85f7c712df3a
msgctxt "scenario9:scenario9_EA770485_F763_4E16_90CA_B38FFE952A0A"
msgid ""
"⟪k:0⟫The house, having attained perpetuity, served as a place for those reconstructed by "
"Morgana’s curse to return to."
msgstr ""
"⟪k:0⟫Comme la maison était devenue éternelle, elle servait d’endroit pour accueillir le retour "
"des âmes qui avaient été maudites par Morgana."

#: scenario9:scenario9_BF2BAD37_233B_4AAF_BBA1_1D0845550B0B
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: ce2dba6b31dc4edbd52d6277edb086da20faf5f469c42f28225c2993582614ac
#. default-sha256: 7266d9ea0d40f041ad7b16c35ee34fff17eab45f70d678bdf692fddc299cee52
msgctxt "scenario9:scenario9_BF2BAD37_233B_4AAF_BBA1_1D0845550B0B"
msgid "⟪k:0⟫I was the one most affected by her wish."
msgstr "⟪k:0⟫j’étais celle qui était la plus affectée par son souhait."

#: scenario9:scenario9_D948BE88_0FDF_4E12_B157_FE9A21E42EC8
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 476b34c53dca2f97986a678e5c6d85967026fcb585187e8a53adb1b9a3c5ee2e
#. default-sha256: 19ae915268034708d783d0da9a79c6e48bfcb03899e92b01a59cc5693c85824c
msgctxt "scenario9:scenario9_D948BE88_0FDF_4E12_B157_FE9A21E42EC8"
msgid ""
"⟪k:0⟫As much as I may have wanted to do good, for them to be happy...⟪k:1⟫⟪k:2⟫my fate was "
"dictated by her wish."
msgstr ""
"⟪k:0⟫J’avais beau vouloir faire le bien autant que possible, vouloir leur bonheur...⟪k:1⟫ Mon "
"destin était gouverné par son souhait."

#: scenario9:scenario9_CBA0F624_DC0B_454E_927C_7F0A72F8CF0C
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: d8af5855e7b6f48b1ef7d35185a7d7833773e01e1bed1768d0a17ff995fbbfd2
#. default-sha256: b2fc0358c92f725cefed2d1d88a19ccce292904b2e8dbc000a68ec0b50909e1b
msgctxt "scenario9:scenario9_CBA0F624_DC0B_454E_927C_7F0A72F8CF0C"
msgid "⟪k:0⟫In that position, my merely showing affection for anyone was damnable."
msgstr ""
"⟪k:0⟫Dans ces circonstances, le fait même que je manifeste mon affection pour quelqu’un était "
"condamnable."

