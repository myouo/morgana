msgctxt "scenario9:scenario9_4CB04B8C_CE64_4467_A3FD_D683F1ABE772"
msgid ""
"⟪k:0⟫The explanation might be a bit lengthy...⟪k:1⟫⟪k:2⟫but I would like to share it with you "
"before I depart."
msgstr ""
"⟪k:0⟫Les explications risquent de traîner un peu en longueur...⟪k:1⟫⟪k:2⟫...mais j’aimerais les "
"partager avec toi avant mon départ."

#: scenario9:scenario9_674CEFAD_690E_4D6F_8E66_67076AF5F197
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 6f9ea9a11f52aac864c0c4dcde8247b50df9edc6ca55f284bcdb8dd80e7eb1a6
