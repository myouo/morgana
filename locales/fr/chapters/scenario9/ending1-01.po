msgid "⟪k:0⟫Extinguish your soul?"
msgstr "⟪k:0⟫Supprimer ton âme ?"

#: scenario9:scenario9_6985F51E_3B8F_48EA_99A3_29D4E19BEBA9
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 2612cf955d857ab737406c994690cae23b039b95f31ae2e4c981d9c633f6798c
#. default-sha256: e532c08f6f59a82085b9c3ddcf7e04ddf8fcfd2dda50a997e6d511a97b9411fe
msgctxt "scenario9:scenario9_6985F51E_3B8F_48EA_99A3_29D4E19BEBA9"
msgid ""
"⟪k:0⟫But I want it to be you... ⟪k:1⟫who sends me off.⟪k:2⟫⟪k:3⟫Could you grant this girl her "
"selfish request?"
msgstr ""
"⟪k:0⟫Mais je veux que ce soit toi... ⟪k:1⟫qui me fasses partir.⟪k:2⟫⟪k:3⟫Veux-tu bien accepter "
"cette égoïste prière ?"

#: scenario9:scenario9_7EB26B21_21B2_4DA7_8FA9_AFBC66F6EC26
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 071e349347ae070b1e3b32fa52888161e77bc0813bd0a271c7716b208fa9d8f0
#. default-sha256: ee18eec5167c49d0374cfc18156210b209f8f86fa011c54d14ca8c473aee75eb
msgctxt "scenario9:scenario9_7EB26B21_21B2_4DA7_8FA9_AFBC66F6EC26"
msgid "⟪k:0⟫but because I wanted to set everyone free from the mansion’s cursed bonds..."
msgstr "⟪k:0⟫Si je l’ai fait, c’était pour libérer tout le monde des liens maudits de ce manoir..."

#: scenario9:scenario9_872F9179_4F76_4DBE_A8EF_7C2AF30880EF
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 3a18a9f6f78efc90d48f4bf1b8b678d35b9c971c94fb0d5242256c190ff49bd3
#. default-sha256: ff2e588c571c4c87652c52a3e8ee90bff5b75ee6f74ecc23571df327a3be5285
msgctxt "scenario9:scenario9_872F9179_4F76_4DBE_A8EF_7C2AF30880EF"
msgid "⟪k:0⟫And you’re asking me... ⟪k:1⟫to eradicate your soul?"
msgstr "⟪k:0⟫Et voilà que tu me demandes... ⟪k:1⟫de t’éliminer ?"

#: scenario9:scenario9_6DE8A0BC_1CED_4C30_AF0B_8F2705D2ECF1
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 6aaa995b50d71f0e2a306484eb90db1d9077e603fbd758a9cd75fc5acff3dbc7
#. default-sha256: 6c5f96032de4c2b6f4beee95d6a4128fe3b973a82134fa1390689863073cf730
msgctxt "scenario9:scenario9_6DE8A0BC_1CED_4C30_AF0B_8F2705D2ECF1"
msgid "⟪k:0⟫I ⟪k:1⟫must⟪k:2⟫ be destroyed."
msgstr "⟪k:0⟫Il ⟪k:1⟫faut⟪k:2⟫ que je sois détruite."

#: scenario9:scenario9_FFE289E9_5988_48FC_A478_DDF26D5199E5
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 90642b924140054d6d0102953bc9a54129d933f548f3c11020e696bd3b66fbd0
#. default-sha256: 96603742a9eed33dda24a89937d149c2af2dc732948204a7134639bf266389f2
msgctxt "scenario9:scenario9_FFE289E9_5988_48FC_A478_DDF26D5199E5"
msgid ""
"⟪k:0⟫While it’s true Morgana wished for misfortune to befall them... ⟪k:1⟫if I hadn’t been there, "
"none of their tragedies would have taken place."
msgstr ""
"⟪k:0⟫C’est vrai, Morgana souhaitait les voir succomber au malheur... ⟪k:1⟫mais si je n’avais pas "
"été là, aucune de leurs tragédies n’aurait eu lieu."

#: scenario9:scenario9_80BD455B_7180_4F27_9EFC_691B744EA819
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 6207aac3c4467c2c984f415b4f517b237f8f4621a6c155ad685249afd013d9a7
#. default-sha256: d80d7df99c6b2c5d821ec719a46a211fcecb1db6c78275c56131f9402ecd5786
msgctxt "scenario9:scenario9_80BD455B_7180_4F27_9EFC_691B744EA819"
msgid "⟪k:0⟫⟪k:1⟫Culpable?⟪k:2⟫"
msgstr "⟪k:0⟫⟪k:1⟫Responsable ?⟪k:2⟫"

#: scenario9:scenario9_E4B3A56C_AE7E_4159_A51A_05132BF3EF3F
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 4c6d7a67c1e6670aaaafa039ce2619815d61a56cbd608cfa53f29b10c73e19d6
#. default-sha256: 04df86f21fec7d5a65178d9dbe237faf9fe8652e57a5186ceadea5eb245084e7
msgctxt "scenario9:scenario9_E4B3A56C_AE7E_4159_A51A_05132BF3EF3F"
msgid "⟪k:0⟫You didn’t intend for anything bad to befall anyone."
msgstr "⟪k:0⟫Tu n’as jamais voulu que le malheur s’abatte sur eux."

#: scenario9:scenario9_C50A9C00_7CD9_4231_9A74_84B933568663
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 400105062f60cd94c6b179a30c4b2aa995a49064c20149eb5081375d540b8959
