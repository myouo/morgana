msgctxt "scenario9:scenario9_6BA1FB6E_E41D_48FA_90FD_50C8BA4E5933"
msgid "⟪k:0⟫take this blade, and with it, extinguish my soul."
msgstr "⟪k:0⟫prends cette épée et avec elle, supprime mon âme."

#: scenario9:scenario9_46C9FD96_4824_4A8E_B09A_005FD2D06FB3
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: d985c5da5f39bf48faff807efc9eaecf2f011846b8a5d41a831a6cba81134ce7
#. default-sha256: 5be4d93ed4c2afa892a02a2bdb505cef30bce9c0f7edef1391aa512fbc0b2f83
msgctxt "scenario9:scenario9_46C9FD96_4824_4A8E_B09A_005FD2D06FB3"
msgid "⟪k:0⟫Because I wanted to save every last person caught in this tragic quagmire."
msgstr "⟪k:0⟫Pour sauver absolument toutes les personnes empêtrées dans ce tragique bourbier."

#: scenario9:scenario9_EB0AB613_6210_4CB4_B8ED_D5CAAEC5535D
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 5662524d0b4254a556fe1f13787325e98fc90181aa56ecc1edfe87e519888a52
#. default-sha256: d1e6c80d3b5787a4dc44997aefa71d8bed3ec73522bc302c4d8759b947f634c6
msgctxt "scenario9:scenario9_EB0AB613_6210_4CB4_B8ED_D5CAAEC5535D"
msgid ""
"⟪k:0⟫You can’t tell me that after everything you’ve seen...⟪k:1⟫⟪k:2⟫you haven’t realized that I "
"have no place in their lives."
msgstr ""
"⟪k:0⟫Après tout ce que tu as vu, tu le sais très bien, au fond de toi...⟪k:1⟫⟪k:2⟫Tu as compris "
"que je n’ai rien à faire dans leur vie."

#: scenario9:scenario9_B62E9CEB_A857_4BDC_8BC4_DE2D0B129191
