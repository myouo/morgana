#: scenario9:scenario9_1E9F04AC_24CD_462E_9AC3_D4184EABDCD7
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 446cee7984e7917ed67a12bb7b11b2d9380e875eec0441c4dc334e15058db3e2
#. default-sha256: 3391cb11ba036e3d67d8e5db460cf2d2b673482825029bbbf4e1d9caf4986826
msgctxt "scenario9:scenario9_1E9F04AC_24CD_462E_9AC3_D4184EABDCD7"
msgid "⟪k:0⟫And why... ⟪k:1⟫can I not speak?"
msgstr "⟪k:0⟫Et pourquoi... ⟪k:1⟫est-ce que je ne peux pas parler ?"

#: scenario9:scenario9_FDA1CBD3_AAFE_4D07_AB73_5CB3BF3EE90A
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 6c9814ddfab2e828f62ccb1548029ec80b1ce888ad6549d04f043b964e3dbb4a
#. default-sha256: 75b921e965eca1f940c2d2760cab7a5e0e4dcc2ba4221a4c0a9bb2fa23289a06
msgctxt "scenario9:scenario9_FDA1CBD3_AAFE_4D07_AB73_5CB3BF3EE90A"
msgid "⟪k:0⟫I was able to return to this gathering place of souls thanks to your efforts."
msgstr "⟪k:0⟫C’est grâce à tes efforts que j’ai réussi à rejoindre ce rassemblement d’âmes."

#: scenario9:scenario9_D024F237_3183_4E5B_BE81_82AD558E0E75
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 277e9ba5999f98a0bda0f9c46bce240f04bf3c91a849232a8c58cdd8dc592e00
#. default-sha256: 4b17b0f5fce9ba6d831dfb2927fb01f71aed443056c1d0a804f976ad2c45c795
msgctxt "scenario9:scenario9_D024F237_3183_4E5B_BE81_82AD558E0E75"
msgid "⟪k:0⟫But my heart told me I had to do this now."
msgstr "⟪k:0⟫Mais mon cœur me disait qu’il fallait que je le fasse maintenant."

#: scenario9:scenario9_74D6CBEA_B305_4027_B19E_4D301A77EACC
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 5155a141b6782ac72b1899792205403032a8194596a093e8f8bbd057b062f403
#. default-sha256: a79c467d98b5b9e42cc967c8a56c878ec69bc960d05f197d83888b343ee884b1
msgctxt "scenario9:scenario9_74D6CBEA_B305_4027_B19E_4D301A77EACC"
msgid "⟪k:0⟫I have brought you here to ask for your assistance."
msgstr "⟪k:0⟫je t’ai amené ici pour te demander assistance."

#: scenario9:scenario9_6BA1FB6E_E41D_48FA_90FD_50C8BA4E5933
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 51d3af286f3b7396f62002f8add58b55ca5b34b37a2d3878bec42251a934b6a6
