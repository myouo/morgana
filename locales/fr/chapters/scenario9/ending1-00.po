msgctxt "scenario9:scenario9_A9956F34_AC58_4FD8_AAB2_17ADFA21C0EF"
msgid "⟪k:0⟫............"
msgstr "⟪k:0⟫............"

#: scenario9:scenario9_3D76D3F0_B785_4847_BC7D_4F8DC241C59C
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 8c5e15d69019a4bfa5c4a98fe0f0e3715fd7f5db9ea70eed1c3898d9d9951578
#. default-sha256: 1702dc30eece77d498bb2afc265ea8204417e27956d5fc5872964d699d4ce31f
msgctxt "scenario9:scenario9_3D76D3F0_B785_4847_BC7D_4F8DC241C59C"
msgid "⟪k:0⟫My very presence malevolent."
msgstr "⟪k:0⟫Ma simple présence était malveillante."

#: scenario9:scenario9_77583269_3E0D_416C_A4DD_9CEC53949443
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: db8bb37ef35342d22292ca1defacfa1725c121b60cc443476c7ba8ae9849a05b
#. default-sha256: e258636ab2d8227984318427ba718e6c226466fe3fc65acfa8a2efd32a0e2a74
msgctxt "scenario9:scenario9_77583269_3E0D_416C_A4DD_9CEC53949443"
msgid "⟪k:0⟫Please, stop..."
msgstr "⟪k:0⟫S’il te plaît, arrête..."

#: scenario9:scenario9_4FA002B7_F14F_45BB_A19E_6A99E0CF9FDA
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: bb381153d9dec8e8fa53bc7a4b96f1905cdcc46ea63634466f2570ffed2f8714
#. default-sha256: b51232e4e14b8af97900f9d4e94552a3929a02d3daec1729a4b0553331fe52c0
msgctxt "scenario9:scenario9_4FA002B7_F14F_45BB_A19E_6A99E0CF9FDA"
msgid "⟪k:0⟫The universe must be returned to its proper state, Michel."
msgstr "⟪k:0⟫L’univers doit revenir à son état d’origine, Michel."

#: scenario9:scenario9_4DECEAE2_970C_4CD6_BDDF_DE47457B4E9A
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 4c17a119664021dbf8520eeef971dced82d437ca3662617c50cdf2e93443c84f
#. default-sha256: 1d06dd93083fab879937f159ce0eff353203c6aa0e158b06b95e37b121777950
msgctxt "scenario9:scenario9_4DECEAE2_970C_4CD6_BDDF_DE47457B4E9A"
msgid "⟪k:0⟫Don’t talk about yourself like that..."
msgstr "⟪k:0⟫Tu ne sais pas ce que tu dis..."

#: scenario9:scenario9_A9F321DC_32EA_49D0_A6B0_F157BEECC80C
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 36e3250a79213ffa14f2b91b25f402dec9b659ea1e6708b4965790f8630cd47c
#. default-sha256: 24a1bb5aa92aa8de99292f014420613d20d36762d429cc54109a1a5f2c17c4a5
msgctxt "scenario9:scenario9_A9F321DC_32EA_49D0_A6B0_F157BEECC80C"
msgid ""
"⟪k:0⟫Perhaps she will be a butterfly resting upon the lip of a flower.⟪k:1⟫⟪k:2⟫Perhaps she will "
"be that flower.⟪k:3⟫⟪k:4⟫Perhaps she will be the breeze in which that flower sways."
msgstr ""
"⟪k:0⟫Elle sera peut-être un papillon qui se repose sur les pétales d’une fleur.⟪k:1⟫⟪k:2⟫Elle "
"sera peut-être cette fleur.⟪k:3⟫⟪k:4⟫Elle sera peut-être la brise qui caresse cette fleur."

