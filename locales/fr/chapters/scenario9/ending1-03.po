msgctxt "scenario9:scenario9_5F8FC082_08D1_41B5_AF9E_44E99A4CA02F"
msgid "⟪k:0⟫Splendid."
msgstr "⟪k:0⟫Merveilleux."

#: scenario9:scenario9_EF768DFA_9AB5_4F1E_9BAC_8B54FEC7F54E
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 8ab0f644ae085110cc03d86cd1bdc97fb3e694ecde8e3f4c3e4ca54f576c64bb
#. default-sha256: b9f0657abc7bda60f46c247c134791a10e33a28113f3eee64eb939923b2082e1
msgctxt "scenario9:scenario9_EF768DFA_9AB5_4F1E_9BAC_8B54FEC7F54E"
msgid "⟪k:0⟫Why is there a sword in your hands?"
msgstr "⟪k:0⟫Pourquoi as-tu une épée entre les mains ?"

#: scenario9:scenario9_68EEC317_9276_4E14_A303_77624A0F3FB5
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 067b7566d63ce374d0af80055b73ec854cd21b654dd7d1d0675ce9da65f65dd5
#. default-sha256: 9e4ab1d6b7a76ab08575f5e1e799fb9490f1291618a2782a001ddc16d9a6b84b
msgctxt "scenario9:scenario9_68EEC317_9276_4E14_A303_77624A0F3FB5"
msgid ""
"⟪k:0⟫I realize that it’s cruel for me to ask this of you,⟪k:1⟫⟪k:2⟫and for that, I deeply "
"apologize."
msgstr ""
"⟪k:0⟫Je me rends compte combien il est cruel de te faire une telle demande,⟪k:1⟫⟪k:2⟫et pour "
"cela, je te présente mes plus sincères excuses."

#: scenario9:scenario9_148F91BC_E4C1_467E_B6E2_A38C3FA5AEE7
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 3552f7fa2d423d837de227938f373ec699111af2bf659f9a64558de576021f36
#. default-sha256: 111b7a5f8dbc10b88b63ee8eb9b9048445053dadfc9b74d15d71219349f51c80
msgctxt "scenario9:scenario9_148F91BC_E4C1_467E_B6E2_A38C3FA5AEE7"
msgid ""
"⟪k:0⟫That’s not why I sought the truth...⟪k:1⟫⟪k:2⟫Not because I wanted to see anyone "
"“extinguished”..."
msgstr ""
"⟪k:0⟫Ce n’est pas pour cela que je me suis mis en quête de la vérité...⟪k:1⟫⟪k:2⟫Je n’avais pas "
"envie de voir qui que ce soit « supprimé »..."

#: scenario9:scenario9_04875D08_CAE1_4730_9063_7003DD5C6999
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 240781c2a38ec272836719dacc8517b8b13a915f127178ddf0ac0ac0279e0a94
#. default-sha256: 83f2c4b5432620fa8e112c1c97a44b59653a6ba75dc428e5b6c5fe6a7dd9733a
msgctxt "scenario9:scenario9_04875D08_CAE1_4730_9063_7003DD5C6999"
msgid "⟪k:0⟫Because I wanted to put an ⟪k:1⟫end⟪k:2⟫ to this cycle of pain and suffering..."
msgstr "⟪k:0⟫Pour mettre un terme à ce cycle de souffrance et de désolation..."

#: scenario9:scenario9_DE0645BD_A94B_49F2_97B1_549192018D30
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 835f5a251f477ea89e37819bc009f05bfd70fb49b8a58134be5743ca97c54edd
#. default-sha256: 1035bb117f5d285e6d3f680aab556d0e5549f314644c4c8d88c49f09b749b46c
msgctxt "scenario9:scenario9_DE0645BD_A94B_49F2_97B1_549192018D30"
msgid "⟪k:0⟫That includes you."
msgstr "⟪k:0⟫Dont toi."

#: scenario9:scenario9_47FB5147_8F88_4FBA_BD47_47D48530ED8A
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: f871c224e1bd9fce4017682da8f74d070d0eae9fc6de0886915e2b0de5e0317b
#. default-sha256: 152c868d7f951346dec031a767169641a9448ddca03742bc4f66b9b26b47e6c0
msgctxt "scenario9:scenario9_47FB5147_8F88_4FBA_BD47_47D48530ED8A"
msgid "⟪k:0⟫I was not a victim in the tragedies...⟪k:1⟫⟪k:2⟫I am culpable for them."
msgstr "⟪k:0⟫Je ne suis pas une victime, dans leurs tragédies...⟪k:1⟫⟪k:2⟫J’en suis responsable."

#: scenario9:scenario9_830104B4_BEF4_412F_BDDC_A90871F518EB
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 7ad9aea1a114d2505a00509882bc0a208c9e33d21c53ff82d29279e331f8cb68
