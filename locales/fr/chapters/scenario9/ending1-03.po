msgctxt "scenario9:scenario9_13865182_DB1B_4F73_B3AA_181FDF2483F0"
msgid "⟪k:0⟫Falling in love was an act of villainy."
msgstr "⟪k:0⟫Tomber amoureuse était un acte de vilenie."

#: scenario9:scenario9_D33E3A1B_B033_473B_9FC2_8153900A76B5
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
