msgstr "⟪k:0⟫............"

#: scenario9:scenario9_CDE192CC_D8E1_483D_ADDA_BF5B772FFBF8
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 57b7fcbc3d396f048bd39d2d1d160097241156a4a7c20bc4aef5f87f66b06586
#. default-sha256: d04860651216b560f952f8f5991d4ac3fe2b9ce9f87e74f1dffc2f3bc38afd19
msgctxt "scenario9:scenario9_CDE192CC_D8E1_483D_ADDA_BF5B772FFBF8"
msgid "⟪k:0⟫that there’s anything wrong with wanting to live."
msgstr "⟪k:0⟫...qu’il soit répréhensible de tenir à la vie."

#: scenario9:scenario9_427B61FA_F1B1_48B4_A6BF_CD32FDF16F18
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: db57ea0cb7ca97d878b81a711a9dced21eefb1b55728cade8f012f03a652a22f
#. default-sha256: ae6bfac8cc8765b97d9864e39a359e1258b885690941c8d7fbadef0f79314932
msgctxt "scenario9:scenario9_427B61FA_F1B1_48B4_A6BF_CD32FDF16F18"
msgid "⟪k:0⟫I was supposed to remain within Morgana, as a part of her."
msgstr "⟪k:0⟫J’étais censée rester à l’intérieur de Morgana, faire partie d’elle."

#: scenario9:scenario9_107F121F_562F_4D89_9F82_76A29429BD7B
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 52c848b57d897b75b9336c39bf9baf7426b038bb0386b7590f8f7bcdb177042c
#. default-sha256: 243852338dc68bf535d89beadb9d74484bc3e89c7cdf8e37e05b8b0a46fd2d14
msgctxt "scenario9:scenario9_107F121F_562F_4D89_9F82_76A29429BD7B"
msgid "⟪k:0⟫To become one... ⟪k:1⟫was to turn against the laws of the universe."
msgstr "⟪k:0⟫En agissant ainsi... ⟪k:1⟫je bafouais les lois de l’univers."

#: scenario9:scenario9_B3DA77E1_8EE0_4E8D_964B_3B154B0396F5
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: f355c2e74360e277a61105aba5b876c74b2973e3cdd7130120243359aab095b3
#. default-sha256: b12f0eadca8f685eb5dc1f36fa9c15ff8a0377b133aebb457d6eeda6801bdf35
msgctxt "scenario9:scenario9_B3DA77E1_8EE0_4E8D_964B_3B154B0396F5"
msgid "⟪k:0⟫Because that was where she lingered—⟪k:1⟫⟪k:2⟫the girl from which I was formed."
msgstr "⟪k:0⟫Parce que c’était là qu’elle gisait —⟪k:1⟫⟪k:2⟫ la fille d’où j’étais sortie."

#: scenario9:scenario9_13865182_DB1B_4F73_B3AA_181FDF2483F0
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 7ecbe0a9e7a6c9519066db9a21df2b580495ed451ab73252305ff2952ef7f032
