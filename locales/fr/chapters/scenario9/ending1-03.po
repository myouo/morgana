msgctxt "scenario9:scenario9_830104B4_BEF4_412F_BDDC_A90871F518EB"
msgid "⟪k:0⟫I saw everything, from start to finish."
msgstr "⟪k:0⟫J’ai tout vu, du début à la fin."

#: scenario9:scenario9_0AE6046F_3ED5_40C0_85EA_E230A5B45AA4
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: b8c5bfc6498ca0f3ce0454a8bbd6a082a0546b6ed42276e6d232cf918b370fd3
