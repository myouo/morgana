msgid "⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫⟪k:4⟫We meet at last..."
msgstr "⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫⟪k:4⟫Nous nous rencontrons, enfin..."

#: scenario9:scenario9_7F8EE5F7_11D1_4996_A0CA_9123B8E172A8
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 7a8ee7f996e003f947a9a043302f89161af3e35ac7d5b12cdb0ff24402d11402
#. default-sha256: f8cb21fb9618dd2b19675c43f807aa0ba9fefe10644c0519c5a0547fa9ca1928
msgctxt "scenario9:scenario9_7F8EE5F7_11D1_4996_A0CA_9123B8E172A8"
msgid "⟪k:0⟫Never mind that... ⟪k:1⟫Where ⟪k:2⟫am⟪k:3⟫ I?"
msgstr "⟪k:0⟫Et surtout... ⟪k:1⟫⟪k:2⟫Où⟪k:3⟫ suis-je ?"

#: scenario9:scenario9_7A53115B_CAC3_4A69_B7CF_15B5D7581784
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 17630f3036a88e0004ca87abea30b61af6ab5561823885726c840d06e34664a4
#. default-sha256: 3904935cee4d30e2f08851c842f02d48e62cb1a79b1808eff9469efba767419d
msgctxt "scenario9:scenario9_7A53115B_CAC3_4A69_B7CF_15B5D7581784"
msgid "⟪k:0⟫Of course I do...⟪k:1⟫⟪k:2⟫How could I ⟪k:3⟫not⟪k:4⟫ know who you are?"
msgstr "⟪k:0⟫Bien sûr que oui...⟪k:1⟫⟪k:2⟫Comment pourrais-je ne ⟪k:3⟫pas⟪k:4⟫ savoir qui tu es ?"

#: scenario9:scenario9_5F8FC082_08D1_41B5_AF9E_44E99A4CA02F
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 69456570399d5c71341bf011efc74e21714d45b86a75c3be0faf76ce104b38dc
