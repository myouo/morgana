msgid "⟪k:0⟫⟪k:1⟫...Actually, that’s a secret!"
msgstr "⟪k:0⟫⟪k:1⟫...En fait, c’est un secret !"

#: scenario5:scenario5_FC11DA36_F76D_48CB_AEEA_3F4C5D12D644
