msgid "⟪k:0⟫Ah... ⟪k:1⟫aaah..."
msgstr "⟪k:0⟫Ah... ⟪k:1⟫aaah..."

#: scenario5:scenario5_E22FD1CE_DC1F_4F16_898F_96EFD80B6207
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 0db35f4cf5208ec057a4e971f6fd6784157b322b7060f4b33759099e80d5f303
#. default-sha256: 82594995b140a16196093120e0272b5f6fe620ba82fa1987bf2152ee992acd9a
msgctxt "scenario5:scenario5_E22FD1CE_DC1F_4F16_898F_96EFD80B6207"
msgid "⟪k:0⟫I shall bring calamity upon you, as the witch of legend!"
msgstr "⟪k:0⟫Comme la sorcière de la légende, je ferai pleuvoir les calamités sur votre tête !"

#: scenario5:scenario5_B5DDA295_5464_46AA_A330_C83F64301F84
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 4b93f0bc80c46203c2a6211a79c495ed941069c239f1792d84698036fda29ff1
#. default-sha256: 9a2d04b5d054640ee3e3b6f3b8d4a33d48b57e7e12a287b334ffcfcdc073adb4
msgctxt "scenario5:scenario5_B5DDA295_5464_46AA_A330_C83F64301F84"
msgid "⟪k:0⟫Neverending famine! Plague! Catastrophe! Suffering for generations!"
msgstr ""
"⟪k:0⟫Une famine éternelle ! Des épidémies ! Des catastrophes ! Des souffrances sur des "
"générations !"

#: scenario5:scenario5_96E5ACB7_9EED_4B68_A0C2_A45F993F1E2D
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 80d94fb393c5f7ab57adc0f34f12de04efbd99ee429a685ca8c93f68f3d40550
#. default-sha256: 978d75fbe101b4a68f556bc246a3c7b4c32e4be9dd93004073a08ccdcbb334d9
