msgid "⟪k:0⟫A witch, a demon, a spirit impure!⟪k:1⟫⟪k:2⟫Call me whatever you wish!"
msgstr "⟪k:0⟫Une sorcière, un démon, un esprit impur !⟪k:1⟫⟪k:2⟫Appelez-moi comme vous voudrez !"

#: scenario5:scenario5_711B9A6F_4494_4E8B_ACFC_EC7EEB85D949
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 8c7bdd772ae89e4307b80c9ec8ce24e4f15cf443f198a027d770ecd2a90376fa
#. default-sha256: b1f0ef3d690ef5156aad8eeb5052228b9847c8b25315114e4656de6b0e9d779c
msgctxt "scenario5:scenario5_711B9A6F_4494_4E8B_ACFC_EC7EEB85D949"
msgid "⟪k:0⟫For the truth shall not change!⟪k:1⟫⟪k:2⟫I carry within me an eternal curse!"
msgstr "⟪k:0⟫Cela ne changera pas la vérité !⟪k:1⟫⟪k:2⟫Je porte en moi une malédiction éternelle !"

#: scenario5:scenario5_711B9A6F_4494_4E8B_ACFC_EC7EEB95D949
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: e987ce66a1ae2597df0da0430ab281be94bfafa8e715f1d2fa245d50a3512a39
#. default-sha256: b7996a0254420a3e5904b4a59773bbaa172b2b387cb8731e3bc11c49b3b21c33
msgctxt "scenario5:scenario5_711B9A6F_4494_4E8B_ACFC_EC7EEB95D949"
msgid ""
"⟪k:0⟫Behold my flesh, pale as the moon!⟪k:1⟫⟪k:2⟫No red blood flows beneath this skin, as it does "
"yours!"
msgstr ""
"⟪k:0⟫Contemplez ma peau, pâle comme la lune !⟪k:1⟫⟪k:2⟫Nul sang rouge ne coule dans ces veines !"

#: scenario5:scenario5_711B9A6F_4494_4E8B_ACFC_EC7EEB85D959
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 9eecc05df2aaa3945fa9fc03771326f196f559750350381bff70d7983fc8f1be
#. default-sha256: b58c88611eb98e58850fd63140ae162ccb3c6031b233107151459aa2cd6795f3
msgctxt "scenario5:scenario5_711B9A6F_4494_4E8B_ACFC_EC7EEB85D959"
msgid ""
"⟪k:0⟫Behold my hair, utterly devoid of color,⟪k:1⟫⟪k:2⟫offered up to the Devil as part of our "
"pact!"
msgstr ""
"⟪k:0⟫Contemplez ma chevelure, entièrement dépourvue de toute couleur,⟪k:1⟫⟪k:2⟫offerte au Diable "
"lors de notre pacte !"

#: scenario5:scenario5_711B9A6F_4494_4E8B_ACFC_EC7EEB85D999
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 01fb1cafc47bef7791bd9084cd98b39622e57bea038e7e4a2ca551494654f62d
