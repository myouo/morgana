msgctxt "scenario5:scenario5_435A89A1_6490_46EC_B689_8B258E374994"
msgid "⟪k:0⟫A full year had passed since we had resumed living together,"
msgstr "⟪k:0⟫Une année entière s’était écoulée depuis que nous avions recommencé à vivre ensemble,"

#: scenario5:scenario5_4A897F4C_E0E2_415A_A9A0_1CCB1D2596EA
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: f261b650e4406f4aca6088117019bf42a0bc10f4041e0f1c7fd77431576bc45f
#. default-sha256: c89839ceb9d4ebf59e3516f9ba23bfdacbf1c219f39606f97484eafce4ba01ee
msgctxt "scenario5:scenario5_4A897F4C_E0E2_415A_A9A0_1CCB1D2596EA"
msgid "⟪k:0⟫and I don’t think it was my imagination that this year felt much warmer than last."
msgstr ""
"⟪k:0⟫et je ne crois pas que ce soit le fruit de mon imagination mais cette année me parut bien "
"plus chaude que la précédente."

#: scenario5:scenario5_CFE1213C_3933_9F57_3F36_8BD7E239BE3E
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 6e6047bc854f91898074dd90d2f52998b2dca1aff8f0af8a4d0c41b2dcb11ada
