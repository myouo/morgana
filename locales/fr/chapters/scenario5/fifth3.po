#: scenario5:scenario5_5B8E17F4_A3C4_419A_A00C_994A0502EBCA
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: ff82d04d9b3fcd9eed7a383c402256ee8d00c160e5a5c4bb8dcb1235ca9f43e2
#. default-sha256: 80993b3772f49c2ac4fa43c7fa4446519a81544f81066074c81d7f26d31dcdef
msgctxt "scenario5:scenario5_5B8E17F4_A3C4_419A_A00C_994A0502EBCA"
msgid "⟪k:0⟫Am I really that much of a nuisance?"
msgstr "⟪k:0⟫Suis-je vraiment un tel fardeau ?"

#: scenario5:scenario5_BA276AAF_86AF_4D04_9849_50FCA2D525C5
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: c50196773a7ee074aa0c264bd379559553f95516a4e6fdc6c7fcb8947791266a
#. default-sha256: d6bc1d3541f06931e0b81a691781030d86fdf0d4b0afa6f0c833993d016ad738
msgctxt "scenario5:scenario5_BA276AAF_86AF_4D04_9849_50FCA2D525C5"
msgid ""
"⟪k:0⟫I’m not doing anything inappropriate, am I?⟪k:1⟫⟪k:2⟫I’m being pleasant and sociable, aren’t "
"I?"
msgstr ""
"⟪k:0⟫Je n’ai rien fait d’inconvenant, si ?⟪k:1⟫⟪k:2⟫Je fais de mon mieux pour être agréable, "
"sociable, non ?"

#: scenario5:scenario5_DF3F6E2A_FF8E_4D95_805F_7A18C50830D4
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 6b8127b20fc9731ff0c5b9d61b31297305a424360853605fcf1dad74971d4628
#. default-sha256: cdd7e4d0c74faa4c04127f5cb5c7e48620d1fb997be4547033ef58cc7c2a75d1
msgctxt "scenario5:scenario5_DF3F6E2A_FF8E_4D95_805F_7A18C50830D4"
msgid "⟪k:0⟫I haven’t given him any reason to not like me, I think.⟪k:1⟫⟪k:2⟫I hope..."
msgstr ""
"⟪k:0⟫Je ne lui ai donné aucune raison de ne pas m’aimer, je crois.⟪k:1⟫⟪k:2⟫En tout cas, je "
"l’espère..."

#: scenario5:scenario5_C945864B_F126_41CF_AB15_A799D69A1064
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 0e6a8466a353a2cf4f181b7e5d04ad92727c9b4e08b9239a61cf7de8c3985989
#. default-sha256: 9eebc69c820bb08821cb728c8907f6a37e70de6617aa4cba65b4b794df2dc10d
msgctxt "scenario5:scenario5_C945864B_F126_41CF_AB15_A799D69A1064"
msgid "⟪k:0⟫He had never been very enthusiastic about my staying here,"
msgstr "⟪k:0⟫Il n’avait jamais été très enthousiaste à l’idée que je reste ici,"

#: scenario5:scenario5_BA31EB28_082D_47A3_BB1A_CF08485A11A3
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: ac70745001db62d4fde7b89031f299f7bd61ed1544b5fd33e976b96e668d2f50
#. default-sha256: d8854baf51cc47d6da3c50d03d37e93d6f98ddc1ef24cbcefc5853fb91ee091a
msgctxt "scenario5:scenario5_BA31EB28_082D_47A3_BB1A_CF08485A11A3"
msgid "⟪k:0⟫but I hadn’t been given a choice. ⟪k:1⟫I had been sent here by his family."
msgstr ""
"⟪k:0⟫mais on ne m’avait pas laissé le choix. ⟪k:1⟫C’était sa famille qui m’avait envoyée ici."

#: scenario5:scenario5_285A114B_CE40_48E8_A101_D05970835748
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 58df72e221c111ef99f696fa8ead7f9f8c16b1f1fe3d5a575763a185edf84c9c
