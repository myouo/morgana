#: scenario5:scenario5_7F9C6881_0D0B_448C_963B_E47E326BBE54
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 5f0c095b524cab35bc7b0e24a7106b6b4da9cfd116d453c2d7cc91bdefd951fb
#. default-sha256: e99ea6f5775993b9e71d4181e6bed4bac743f89ecfe40d485eb9414666fdbaf3
msgctxt "scenario5:scenario5_7F9C6881_0D0B_448C_963B_E47E326BBE54"
msgid ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫⟪k:4⟫⟪k:5⟫⟪k:6⟫⟪k:7⟫⟪k:8⟫⟪k:9⟫⟪k:10⟫⟪k:11⟫⟪k:12⟫It had been a little under "
"two weeks since I had moved in with Michel."
msgstr ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫⟪k:4⟫⟪k:5⟫⟪k:6⟫⟪k:7⟫⟪k:8⟫⟪k:9⟫⟪k:10⟫⟪k:11⟫⟪k:12⟫Cela faisait un peu moins de "
"deux semaines que j’habitais avec Michel."

#: scenario5:scenario5_A2B2C3A3_E67B_4632_A11A_A01A64AC1CB0
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: a733b0677aceee904cb6e1ab1bacee57a27a0f4d7ecdbf4791da2bf2bb6d5d9f
#. default-sha256: 99af8bb2aa32126b8b8707be83e98b3e4d5d78c4e6592f95de215ce7cb2463de
msgctxt "scenario5:scenario5_A2B2C3A3_E67B_4632_A11A_A01A64AC1CB0"
msgid "⟪k:0⟫Though we lived in the same house, we rarely saw each other."
msgstr "⟪k:0⟫Alors même que nous vivions dans la même maison, nous nous voyions rarement."

#: scenario5:scenario5_2A965A44_8F80_40BF_A5E1_D86B24CE088C
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: a5cad7a174de6930be6a1cfa27c3683374ea973eeb288716248cca4b97102c6e
#. default-sha256: 3e6d4f292e87a128b3daa9c91e2a7ebd36ed75b483f68467680559ed547c9a17
msgctxt "scenario5:scenario5_2A965A44_8F80_40BF_A5E1_D86B24CE088C"
msgid "⟪k:0⟫On unlucky days, I wouldn’t see him at all."
msgstr "⟪k:0⟫Certains jours, je ne le voyais même pas du tout."

#: scenario5:scenario5_85E8BFB9_F381_4DD1_BD7C_4527A9E775B1
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: cab2849fcf7cf7944501d9a577c5947243f0eb2768215b5b3374eb8f627b55e0
#. default-sha256: d993ff01771184ef544a753631e0554209435a4343d86d28ffe8b4190c1d5f2c
msgctxt "scenario5:scenario5_85E8BFB9_F381_4DD1_BD7C_4527A9E775B1"
msgid ""
"⟪k:0⟫I wasn’t sure if he ate in his room or our schedules were simply misaligned, but we never "
"had any meals together."
msgstr ""
"⟪k:0⟫Je ne savais pas trop s’il prenait ses repas dans sa chambre ou si c’étaient nos horaires "
"qui n’étaient pas alignés, mais on ne mangeait jamais ensemble."

#: scenario5:scenario5_A5BCFB35_20B8_4F12_9B50_57F5C20CAF1C
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 2418c0dddede299fa123549ad2d98fb4ebb165ecbdf632cd207010d8ad2d905f
#. default-sha256: bbe84371d8c858affc59b6ece7a9430e718309cef09e5f5488d644a8367dd229
msgctxt "scenario5:scenario5_A5BCFB35_20B8_4F12_9B50_57F5C20CAF1C"
msgid "⟪k:0⟫Perhaps he was deliberately avoiding me."
msgstr "⟪k:0⟫Il m’évitait peut-être délibérément."

#: scenario5:scenario5_CBF3FE2B_D765_47F6_BB1B_2ECF64E875C8
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: d56fcfe471912b032822b9175ce927b2ca1dc13cf1da5849d6038a427270001d
#. default-sha256: 6cd030ed79a12b057174b60293c5a9851923a952c84a9fe639d1ff4e4c469621
msgctxt "scenario5:scenario5_CBF3FE2B_D765_47F6_BB1B_2ECF64E875C8"
msgid "⟪k:0⟫That has to be it..."
msgstr "⟪k:0⟫Ça doit être cela..."

#: scenario5:scenario5_8C1E720E_D5B5_4FCD_86BC_ACBADC321ACB
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: a05f13eacca0a4cf9174d77a06f5ab5c51e784a73beab3b8f562f114b7600a9c
#. default-sha256: 2bce68320fe4b0c62d67ed2e70bf4ce42f4dfc191dba85c8103739f8fc1187da
msgctxt "scenario5:scenario5_8C1E720E_D5B5_4FCD_86BC_ACBADC321ACB"
msgid "⟪k:0⟫I know servant and master don’t usually eat at the same table,⟪k:1⟫but even so..."
msgstr ""
"⟪k:0⟫Je sais bien que les serviteurs et les maîtres ne mangent pas d’ordinaire à la même table, "
"mais quand même..."

#: scenario5:scenario5_6CBD4980_1912_4BFE_B443_1D7A16551157
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: e12b457a41f49c78e9f023af14c8a2b11579a56f3a1f52eeaa57e9d5ccfd47b0
