#: scenario5:scenario5_A1A925CB_1079_4097_9984_F74FFA5128D7
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 44eb0b8cdd3d8006141185a79730269b70a45398a9933eaae83fc86789c933c5
#. default-sha256: 1198f0aca9a47e2f8235c759384c18a8f4dc0b9093d76c5827de46773237d393
msgctxt "scenario5:scenario5_A1A925CB_1079_4097_9984_F74FFA5128D7"
msgid ""
"⟪k:0⟫For far longer than was comfortable, the only sound we heard was the gentle crackling of the "
"fire."
msgstr ""
"⟪k:0⟫Pendant un moment bien plus long que prévu, le seul son que l’on entendit fut le doux "
"crépitement du feu."

#: scenario5:scenario5_2FC207D4_5BB8_4F13_8ED3_B5CC837D3D60
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 5e683e1a8d50e93a21abf31de35376f5981739a54beee7580577298b538911ac
#. default-sha256: 1d2813eed140700632d89e06ce305be6b233a67dc279431143e5757c5b8e4c3a
msgctxt "scenario5:scenario5_2FC207D4_5BB8_4F13_8ED3_B5CC837D3D60"
msgid "⟪k:0⟫I had to say something.⟪k:1⟫⟪k:2⟫I knew that, but what I didn’t know was how to begin."
msgstr ""
"⟪k:0⟫Il fallait que je dise quelque chose.⟪k:1⟫⟪k:2⟫Je le savais, mais ce que je ne savais pas, "
"c’était par où commencer."

#: scenario5:scenario5_7636C76B_F264_44A8_B5FB_DAF40CA9AC9B
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 679f329052eee5a5dcec4f7bab65a536e431e25ec8d5810dee666f92e8ccb96c
#. default-sha256: 269356ca7f73a13e5c0c73f7b608097f5f57f93b7286a22a24fb58f79581689f
msgctxt "scenario5:scenario5_7636C76B_F264_44A8_B5FB_DAF40CA9AC9B"
msgid ""
"⟪k:0⟫I knew nothing about having an honest, face-to-face discussion with someone about the things "
"we were thinking and feeling."
msgstr ""
"⟪k:0⟫Avoir une discussion honnête en tête à tête avec quelqu’un et parler de ce qu’on pense et de "
"ce qu’on ressent : voilà qui m’était inconnu."

#: scenario5:scenario5_4CA04C0A_498A_4B14_8295_73157439C193
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 4d890d282a6890beaacc3d2e7047a955b4a5112151d0fc12ad82f65895cf53bd
#. default-sha256: f882948ab29f77bc09f9839bf7f4200a02c0896143c2bdf45b9bcd20cf9ea48e
msgctxt "scenario5:scenario5_4CA04C0A_498A_4B14_8295_73157439C193"
msgid "⟪k:0⟫But that didn’t change anything..."
msgstr "⟪k:0⟫Mais ça ne changeait rien..."

#: scenario5:scenario5_4CB3629A_C22C_48AF_B79D_4760DD361590
