msgctxt "scenario5:scenario5_0C4432C5_4125_4ADD_B0B3_F2A8BF3982BD"
msgid "⟪k:0⟫⟪k:1⟫And I very much doubt...⟪k:2⟫⟪k:3⟫you will find what I have to say agreeable."
msgstr "⟪k:0⟫⟪k:1⟫Et je doute fort...⟪k:2⟫⟪k:3⟫...que vous ne trouviez plaisant ce que j’ai à dire."

#: scenario5:scenario5_3A40C90A_CD29_4C3F_8EC8_3B58B76D783A
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: b5c2f2c366f5dcc21cc8c6367470f9ca551d4da92195bb1b295a2b3aead44b70
