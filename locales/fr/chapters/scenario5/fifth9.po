msgid "⟪k:0⟫I had to do it,"
msgstr "⟪k:0⟫Je devais le faire,"

#: scenario5:scenario5_D831D3C4_8153_499F_8E4E_3289F4DFA12D
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 082af7eb4e3d01c2f207f3396f23e32452ba00a492676c0e432ce1d4239921fc
