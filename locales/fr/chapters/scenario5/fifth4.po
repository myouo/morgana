#: scenario5:scenario5_49EC72D7_464F_45AE_83CA_75CC4C81372F
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 672f7f7c1b24c2a846926e9b022d3c42403650198add6fc566b85aceaa8ae5a4
#. default-sha256: c839a3a3f767a0be91566749d3fa98a54aadb6c84bfdb644a7bea4e4b69328d5
msgctxt "scenario5:scenario5_49EC72D7_464F_45AE_83CA_75CC4C81372F"
msgid ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫⟪k:4⟫⟪k:5⟫⟪k:6⟫⟪k:7⟫⟪k:8⟫⟪k:9⟫⟪k:10⟫⟪k:11⟫Several days had passed since the "
"package arrived; ⟪k:12⟫the end of my third week living in the mansion was drawing near."
msgstr ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫⟪k:4⟫⟪k:5⟫⟪k:6⟫⟪k:7⟫⟪k:8⟫⟪k:9⟫⟪k:10⟫⟪k:11⟫Plusieurs jours s’étaient écoulés "
"depuis la livraison ; ⟪k:12⟫on approchait de la fin de ma troisième semaine au manoir."

#: scenario5:scenario5_6150F9D5_5DDC_43DF_A513_607F62A542F3
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 7eac279e2569f3a3bb8a5e328a1e76cde56cf26368fcd4cdc6ce460a66ab65cd
#. default-sha256: 120cbce35432c39562c047d9c4e3a0ea17ccacdff40746c39447a66d8b8abba3
msgctxt "scenario5:scenario5_6150F9D5_5DDC_43DF_A513_607F62A542F3"
msgid ""
"⟪k:0⟫Michel wasn’t getting any friendlier, either. ⟪k:1⟫He continued to either snub or bluntly "
"dismiss me whenever we crossed paths."
msgstr ""
"⟪k:0⟫Michel ne se montrait pas plus amical. ⟪k:1⟫Il continuait soit à me snober soit à me "
"renvoyer carrément à chaque fois qu’on se croisait."

#: scenario5:scenario5_653649AD_016A_4720_AF8F_1972915C5AE5
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 39fb411d4120f4fd308f20c9f4d76c8f7bc75e1173eb01b9f21e6aa1b9abd275
#. default-sha256: eb2655391bd61df88c44de4efaf4bd140e4f63736c88150eb5709f6e1bcc9b5c
msgctxt "scenario5:scenario5_653649AD_016A_4720_AF8F_1972915C5AE5"
msgid "⟪k:0⟫I didn’t understand why he acted that way around me."
msgstr "⟪k:0⟫Je ne comprenais pas pourquoi il se comportait ainsi avec moi."

#: scenario5:scenario5_A8D1483C_9648_4012_B28C_2634220D8C98
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: fda462b12fe47051a3d68c40dec3c763bb22da0b8c0a4869ec433b141db2f91d
#. default-sha256: f7db2415c6011711e69500b83f2dd5f0e38f20f10de2db85963d31d3762266b7
msgctxt "scenario5:scenario5_A8D1483C_9648_4012_B28C_2634220D8C98"
msgid ""
"⟪k:0⟫But there was little point in asking when he seemed to think there was little point in "
"talking to me at all."
msgstr ""
"⟪k:0⟫Mais il ne servait à rien de lui demander puisqu’il semblait penser qu’il était inutile de "
"me parler."

#: scenario5:scenario5_F46A383E_C563_49CD_9477_40CF746506DB
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 10050e37bbfcb095c6796fe387bf9dabf4c06c18bcd9734c80c03d8c9c9e56a4
#. default-sha256: 4587a6fe5248757fe1fe0c832f07f07b9a8709a97b2b17ca6ac1d8de036cc1c6
msgctxt "scenario5:scenario5_F46A383E_C563_49CD_9477_40CF746506DB"
msgid "⟪k:0⟫Although at first I had been sure there was some way to get him to warm up to me,"
msgstr "⟪k:0⟫Autant, au début, j’étais sûre de pouvoir me rapprocher de lui,"

#: scenario5:scenario5_424348E1_F5B1_4CF9_B0EF_CE05648831F3
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: b8d97340bf1830e8be696ec848a7665e160db4a9b1c61974938eb1cd23bab901
#. default-sha256: dc9ae333a175b9b987acd9811940cab633b3b8ec353ac383a8607a5849688418
msgctxt "scenario5:scenario5_424348E1_F5B1_4CF9_B0EF_CE05648831F3"
msgid ""
"⟪k:0⟫the more time I spent in the mansion, the more my willpower began to feel like it was at its "
"breaking point."
msgstr "⟪k:0⟫autant, plus le temps passait, plus ma volonté s’épuisait."

#: scenario5:scenario5_75DBADEE_BB49_47B3_98C8_A69797C4FF12
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 4eaea9cbe1ff92d61af77514cec534aa09261b2a4c7e17315a509650ed9d4c76
#. default-sha256: 0b3ce43a1fa7ce4a6744271ca6be51c41b936f6f4557411a465cc49251161023
msgctxt "scenario5:scenario5_75DBADEE_BB49_47B3_98C8_A69797C4FF12"
msgid ""
"⟪k:0⟫I could tell myself to stay positive until I was blue in the face,⟪k:1⟫but it would only "
"work for so long."
msgstr ""
"⟪k:0⟫J’avais beau me dire de rester positive jusqu’à en perdre haleine,⟪k:1⟫ça ne marchait qu’un "
"temps."

#: scenario5:scenario5_B8A2906C_3079_44F8_ADFE_0610C9535338
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: cbfc9bbceb7c1ab91d59aabf0cd51ef505c65875c4c1b4d11427498a68cbe2a5
#. default-sha256: 83ea0126c158822ea943dcdfbc9ad8f0e45a6ed112ad72f21a0770a0cfe1f558
msgctxt "scenario5:scenario5_B8A2906C_3079_44F8_ADFE_0610C9535338"
msgid "⟪k:0⟫⟪k:1⟫(The one pretty place in the whole house...)"
msgstr "⟪k:0⟫⟪k:1⟫(Le seul bel endroit de toute la maison...)"

#: scenario5:scenario5_9DED7EEC_0722_4C45_9EF7_A984612FE73D
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: c464d4b4170c7e05ae6ac2f371b163433b8b988e20117568ea8fa75c27ecc0ae
#. default-sha256: 7a7f24b4eac4e2ea04d9c394e6740fe17897689e6e16d8ad17f70283a8bf2572
msgctxt "scenario5:scenario5_9DED7EEC_0722_4C45_9EF7_A984612FE73D"
msgid "⟪k:0⟫(I’m glad he hasn’t covered it back up.)"
msgstr "⟪k:0⟫(Je suis contente qu’il ne l’ait pas recouvert.)"

#: scenario5:scenario5_65804540_F115_420D_AE61_DAB5CE7E94E9
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: d61bd4eb19738ab4e3988b29e0ad43d3e14c7f858d6a1aaa3436ad884a16352d
#. default-sha256: 26066a6644b2a621da6abcb8d6fd18197dd4a2b937b7e89bab22aaec986982a2
msgctxt "scenario5:scenario5_65804540_F115_420D_AE61_DAB5CE7E94E9"
msgid ""
"⟪k:0⟫Blue moonlight shone quietly through the stained-glass window,⟪k:1⟫vainly illuminating some "
"of the room."
msgstr ""
"⟪k:0⟫La lumière bleutée de la lune illuminait doucement le vitrail,⟪k:1⟫éclairant en vain une "
"partie de la pièce."

#: scenario5:scenario5_B0B8F114_8698_4BC0_86F8_3007E9A895A9
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 116af027fde4ad79d20ee5ad2798e903d3331adf551d8de0139fbdde6c2625ed
#. default-sha256: eceaabb4a28ad9cc48c745628fd6d1ba3ec778df1e92eca25b8d101dc6a97109
msgctxt "scenario5:scenario5_B0B8F114_8698_4BC0_86F8_3007E9A895A9"
msgid ""
"⟪k:0⟫I hadn’t noticed until now, but the room with the stained-glass window appeared to be "
"modeled after a chapel."
msgstr ""
"⟪k:0⟫Je n’y avais pas prêté attention jusque-là mais la pièce au vitrail semblait suivre le plan "
"d’une chapelle."

#: scenario5:scenario5_A0C7AE40_F8C8_4EDA_820A_38D0F5F09337
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 6b3da283966b5ac7d18726b81fbe3a00f90b207da9ef9b066feb05f579c02913
#. default-sha256: 7f8045e5c75d53b89bcd8a0208d02b3a661457947872391e4f4300fd93265abe
msgctxt "scenario5:scenario5_A0C7AE40_F8C8_4EDA_820A_38D0F5F09337"
msgid "⟪k:0⟫Rows of pews faced the window, below which sat what used to be a pulpit."
msgstr ""
"⟪k:0⟫Des rangées de bancs faisaient face à la fenêtre, en-dessous de laquelle se trouvait ce qui "
"avait dû être une chaire."

#: scenario5:scenario5_8C9CA69D_1F12_443C_9D1B_FEB57319275B
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: cfc93c618af8d60f286889ce3e4bb6b9065729b5a4dbcc3632c11053fc8aef6f
#. default-sha256: 7152f4ddc395a256342aae5489b47dae5dc186d7fb042325b6da50c3910a80ca
msgctxt "scenario5:scenario5_8C9CA69D_1F12_443C_9D1B_FEB57319275B"
msgid ""
"⟪k:0⟫There was very little left of it, though, and an awkward length of silver was mounted to the "
"pulpit’s front face—"
msgstr ""
"⟪k:0⟫Il n’en restait pas grand-chose, cependant : un petit objet en argent avait été placé sur le "
"côté de la chaire—"

#: scenario5:scenario5_7264E601_7DDD_4CA2_9E95_82FC86D64C48
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 7f8eeddda74108fa33e911c7e5298fd5095d45cbbb284913ba97bb4324c572f4
#. default-sha256: 92f58e7c6541e92212ca3a17a2f9b5c369f69a0a868ecbf8a1230779aad516f7
msgctxt "scenario5:scenario5_7264E601_7DDD_4CA2_9E95_82FC86D64C48"
msgid "⟪k:0⟫what was, I assumed, formerly a cross."
msgstr "⟪k:0⟫ce devait être une croix."

#: scenario5:scenario5_CF7BE4A5_DE3F_454B_884D_538236B1ADDD
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 1c4fa8dc3fcceb258956a7a85e5d01300fc21a9aacefa451d98e3ca428cb7968
#. default-sha256: 6c6d5153244fcd083acd28aa3a79b7b9b95810275fdc95905eab3cfacd7830c8
msgctxt "scenario5:scenario5_CF7BE4A5_DE3F_454B_884D_538236B1ADDD"
msgid ""
"⟪k:0⟫Upon further reflection, rather than facing the window, the pews seemed to be pointed at the "
"pulpit—⟪k:1⟫⟪k:2⟫or perhaps the cross hanging on it."
msgstr ""
"⟪k:0⟫Après réflexion, je remarquai que les bancs n’étaient pas dirigés vers la fenêtre mais vers "
"la chaire—⟪k:1⟫⟪k:2⟫ ou peut-être vers la croix qui y était suspendue."

#: scenario5:scenario5_8806818E_A5AA_4012_BC56_0518E7F4D082
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 5a84e15622a3b6613b19795bb558dae3e50b3c3187efa32bb59c34ff1cb2ada7
#. default-sha256: e339b0213b2356e6d0d512ddb13b97611de9c3fc2de88c97b8e38f261b48c9d0
msgctxt "scenario5:scenario5_8806818E_A5AA_4012_BC56_0518E7F4D082"
msgid ""
"⟪k:0⟫I wasn’t sure why there would be a chapel in a mansion, but I had no one to ask about it."
msgstr ""
"⟪k:0⟫J’aurais voulu savoir pour quelle raison il y avait une chapelle dans un manoir, mais je "
"n’avais personne à qui demander."

#: scenario5:scenario5_79CFBF33_6D18_4F97_81E6_C68B8B04EAB1
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 2e97c9cbad105f7ca2b5aa5f574c183cb4581e6f29cb0e284306f6f728f5e5c4
#. default-sha256: 66b834f5b103fd7864b252cd11de0976268d749b61ddb38d574e79ac1f0bdbb8
msgctxt "scenario5:scenario5_79CFBF33_6D18_4F97_81E6_C68B8B04EAB1"
msgid ""
"⟪k:0⟫(For a house of this size, a statue of Christ or the Virgin Mary seems more appropriate.)"
msgstr ""
"⟪k:0⟫(Pour une maison de cette taille, une statue du Christ ou de la Vierge Marie semble plus "
"appropriée.)"

#: scenario5:scenario5_85244C87_58DA_4179_A1C6_C3252AEFA550
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: fc82712f63821206cb7567aaaa194ccb2412a6906e32997d2188e62cdb5212fb
#. default-sha256: 40526a6eeabb26b34fa2cd6df7162057afbdfa2055e90aa7ba39da45d42fb7c2
msgctxt "scenario5:scenario5_85244C87_58DA_4179_A1C6_C3252AEFA550"
msgid "⟪k:0⟫(It’s a very well made chapel, at any rate...)"
msgstr "⟪k:0⟫(C’est une très belle chapelle, en tout cas...)"

#: scenario5:scenario5_9103FB9B_FF59_407A_B1F5_4CDFE900CFFD
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 6efc705f3128cd902180e6e085e74e4b8cdc9ca807d80eac65ce49750964cc72
#. default-sha256: 48f41697b22461c825c2f67ac00db3078091b23a05c42741f58ec0ffc02c435d
msgctxt "scenario5:scenario5_9103FB9B_FF59_407A_B1F5_4CDFE900CFFD"
msgid "⟪k:0⟫............"
msgstr "⟪k:0⟫............"

#: scenario5:scenario5_D29F27E2_EC0C_4621_956D_C2A2CD962404
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 2f12ab081cfdad65a7eeac5ac482f8d288b90459c9e79f09e48b6eb8a605f270
#. default-sha256: 505dfc39e7bb2db05d5b13c42f13e7858e5c9b0c7dc87b833f98b85aa4eb7330
msgctxt "scenario5:scenario5_D29F27E2_EC0C_4621_956D_C2A2CD962404"
msgid ""
"⟪k:0⟫I doubted Michel had had it built for himself. ⟪k:1⟫There would be no reason for him to "
"cover the window if that were the case."
msgstr ""
"⟪k:0⟫Je doutai fort que Michel l’ait fait construire pour lui-même. ⟪k:1⟫Il n’aurait eu aucune "
"raison de voiler le vitrail si c’était le cas."

#: scenario5:scenario5_3A7A3407_AF3B_41E4_924C_5F34794B7486
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: dd337223d7836956e855567be95d85ce424c161f11c53eaab45479b2f30e9bbe
#. default-sha256: b8e49c9e1ce9cdb9a6a701a39dd7dcfcac5c7f28a802b3f031f4228f8f772129
msgctxt "scenario5:scenario5_3A7A3407_AF3B_41E4_924C_5F34794B7486"
msgid "⟪k:0⟫Nor had I ever seen him come to pray."
msgstr "⟪k:0⟫Et je ne l’avais jamais vu venir prier."

#: scenario5:scenario5_BF6E0F10_588D_4AFA_9436_A66EFD5A59CD
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 25294225b03755f7d384385ecd42725bb45f2b1670ec8d0217edb90df9183234
#. default-sha256: c42c587222928527ce45abd817592f86dc41fdee23c315ec99418d7197a6aa74
msgctxt "scenario5:scenario5_BF6E0F10_588D_4AFA_9436_A66EFD5A59CD"
msgid "⟪k:0⟫(He doesn’t seem like one to believe in God.)"
msgstr "⟪k:0⟫(Il ne m’a pas l’air très croyant.)"

#: scenario5:scenario5_0A56A746_2279_407F_84FC_A7A3CE7E50E5
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: dce7f6b67275ec3ff040bb5824451ad7391c7f4b527fb8d1f1a66641ffb22832
#. default-sha256: e73423e151e37047853ac680adfe13227e7f51a724929333b24fb61553b36ee1
msgctxt "scenario5:scenario5_0A56A746_2279_407F_84FC_A7A3CE7E50E5"
msgid "⟪k:0⟫(God...)"
msgstr "⟪k:0⟫(Dieu...)"

#: scenario5:scenario5_E5007458_122E_4125_9932_037BFC3EE5D4
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 018cfbadbfe6e0026838bde3bd543a7428a00a3bd35752219dc85312bf7967ca
#. default-sha256: 8fecce52e1538ee44703d33866359e924f20afe26c20f6494621b31ecae56d6e
msgctxt "scenario5:scenario5_E5007458_122E_4125_9932_037BFC3EE5D4"
msgid "⟪k:0⟫(I’m not even sure if I...)"
msgstr "⟪k:0⟫(Je ne suis même pas sûre de...)"

#: scenario5:scenario5_F9324163_17D1_4F00_8DBD_339C28934087
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 5628f9afa8a91863cdf03e43ccb6bc6877bd6bc87f9e75b5c29e26ca211c53e7
#. default-sha256: b36fd5925e3cb96280d5cb55138c5c7635b64499fd600e261e3dd04cbbbb8c6e
msgctxt "scenario5:scenario5_F9324163_17D1_4F00_8DBD_339C28934087"
msgid ""
"⟪k:0⟫If God ⟪k:1⟫really⟪k:2⟫ existed, then surely the world would be a much more pleasant, "
"peaceful place."
msgstr ""
"⟪k:0⟫Si Dieu existait ⟪k:1⟫vraiment⟪k:2⟫, alors, sûrement, le monde aurait été un endroit bien "
"plus agréable, bien plus paisible."

#: scenario5:scenario5_B5F3B961_B5CF_45E1_9686_D8F1AD89AF1C
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: cb2ffdff4f6aa94a8040c232c33fd790484a0cf1e80651d6ab7b567ab214277f
#. default-sha256: 818a8f1ca9b54b1e56e1b407483771d990ceb80c31ad0e1a737efad702fd4206
msgctxt "scenario5:scenario5_B5F3B961_B5CF_45E1_9686_D8F1AD89AF1C"
msgid ""
"⟪k:0⟫No unfair disparities in money or power. ⟪k:1⟫No senseless misfortune.⟪k:2⟫⟪k:3⟫I certainly "
"wouldn’t have found myself here, either..."
msgstr ""
"⟪k:0⟫Pas d’inégalités d’argent ou de pouvoir. ⟪k:1⟫Pas de malheur absurde.⟪k:2⟫⟪k:3⟫Je ne me "
"serais certainement pas retrouvée ici, non plus..."

#: scenario5:scenario5_41BF1485_75AA_4EEA_940F_4F8D64CB0688
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 044f5360590323ad4868c393272d557414ba386b3aa480811a198fd7e3230ee1
#. default-sha256: 281e4db977efe74bc288f1416afb3cd0c172988d55e4b39e15bdc4df482949e3
msgctxt "scenario5:scenario5_41BF1485_75AA_4EEA_940F_4F8D64CB0688"
msgid ""
"⟪k:0⟫But God was evidently quite fond of giving mankind “trials,” so He would probably tell me "
"with a straight face that this was one too."
msgstr ""
"⟪k:0⟫Mais Dieu aimait à l’évidence faire subir des « épreuves » à l’humanité, donc Il me dirait "
"probablement sans broncher que c’en était une aussi."

#: scenario5:scenario5_4D835E2E_5E7F_4F39_9C1A_1B4F94821963
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: d698eb8a6636ba6cac442baefd4980af300ab6354ba56e54d34d14727d224eb8
#. default-sha256: 3072725cdf350044996d834e71f9b2839220886ebf2c28e561c50d7eb25c58e8
msgctxt "scenario5:scenario5_4D835E2E_5E7F_4F39_9C1A_1B4F94821963"
msgid "⟪k:0⟫Or, perhaps,"
msgstr "⟪k:0⟫Ou peut-être..."

#: scenario5:scenario5_97002835_7390_4300_8DD3_6F0E0B5325A9
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
