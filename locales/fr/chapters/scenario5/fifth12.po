msgctxt "scenario5:scenario5_3248D2FD_049C_445F_88A2_65E1956C5FEA"
msgid "⟪k:0⟫I was incapable of assuaging her pain, wasn’t I?"
msgstr "⟪k:0⟫J’étais incapable d’alléger sa souffrance, non ?"

#: scenario5:scenario5_6A8E4156_6BDE_4791_8E65_71090127264B
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 9199ef6b03bb09ce5bbebad29163ca44285c155d64aa243e1b3e84db06f65e75
