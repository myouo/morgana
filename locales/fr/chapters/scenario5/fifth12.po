msgctxt "scenario5:scenario5_232D359C_1C5A_4F53_8E21_FC2C227271B1"
msgid ""
"⟪k:0⟫She cried like a little child. ⟪k:1⟫The usually strong-willed, cheerful, optimistic Giselle "
"wailed from the depths of her soul."
msgstr ""
"⟪k:0⟫Elle pleurait comme un petit enfant. ⟪k:1⟫Giselle, qui était d’ordinaire forte, joyeuse, "
"optimiste, se lamentait des tréfonds de son âme."

#: scenario5:scenario5_318922A9_1AD9_493F_9FB0_08C884701BD6
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 01fe6a0d65ab07b426ecb10366026b63f97a8fdb74bbc2a1c1f78b148d59481d
