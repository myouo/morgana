msgctxt "scenario5:scenario5_6A8E4156_6BDE_4791_8E65_71090127264B"
msgid "⟪k:0⟫I couldn’t do anything,"
msgstr "⟪k:0⟫Je ne pouvais rien faire,"

#: scenario5:scenario5_8BB3BF4C_732B_4C1D_953A_E9A1CEDC2122
