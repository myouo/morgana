msgid "⟪k:0⟫A... ⟪k:1⟫coward?"
msgstr "⟪k:0⟫Une... ⟪k:1⟫lâche ?"

#: scenario5:scenario5_B81AFD1E_DF1C_4CB4_9526_D9EF5B378135
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
