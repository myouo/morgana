msgctxt "scenario5:scenario5_48E48AA0_6569_4B21_A769_E3A46A9FC003"
msgid ""
"⟪k:0⟫It was too dark to see anything, but I could feel something ⟪k:1⟫different⟪k:2⟫ present in "
"this area than the rest of the house."
msgstr ""
"⟪k:0⟫Il faisait trop sombre pour voir quoi que ce soit mais je sentais que quelque chose était "
"⟪k:1⟫différent⟪k:2⟫ dans cette partie de la maison."

#: scenario5:scenario5_5C7D8D1A_F976_4877_91A1_2CB164E9C884
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: c162702494a5e123f5ecdc8347bf5d21786b14e9d9d64d0d0388bb1d8cdc26db
