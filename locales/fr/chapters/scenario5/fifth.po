msgid "⟪k:0⟫Darn... ⟪k:1⟫not a hint of light."
msgstr "⟪k:0⟫Mince... ⟪k:1⟫Je n’ai pas la moindre lumière."

#: scenario5:scenario5_0839D5A2_76A3_4479_9250_FA63C9F2229C
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 560640fbfb3860c16a9bfe6f7ebd4801958dbddb8c507bbeee4fd6af5ce16fb3
