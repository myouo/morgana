msgid "⟪k:0⟫That was about all I could say, anyway. ⟪k:1⟫Oh well."
msgstr "⟪k:0⟫Je ne pouvais rien dire de plus, de toute façon. ⟪k:1⟫Tant pis."

#: scenario5:scenario5_E6D58D3F_229A_41CD_97BE_845154F0A15F
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 78a098fe705f7d0d1cdc1d505597433da87bee051a45d1e3de1bed44255624d4
