msgid ""
"⟪k:0⟫⟪k:1⟫The carriage came to a stop, and the coachman climbed down, signaling with his chin for "
"me to get out."
msgstr ""
"⟪k:0⟫⟪k:1⟫La voiture s’arrêta et le cocher en descendit, m’intimant de sortir par un signe du "
"menton."

