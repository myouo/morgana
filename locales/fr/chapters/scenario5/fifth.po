msgid ""
"⟪k:0⟫As I pushed forward through the freezing air,⟪k:1⟫for a split second, I spotted a shimmer of "
"light."
msgstr ""
"⟪k:0⟫Je repris ma route dans l’air gelé,⟪k:1⟫et, l’espace d’une seconde, j’entr’aperçus une lueur."

#: scenario5:scenario5_0BC2FFE7_19E0_44DB_8429_50B92FACAC3E
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 09db5b51e85dd6cfe8d07f8a384ab31069184c8aad4ec923caf96c4e10f73685
