msgid "⟪k:0⟫If the door didn’t open... ⟪k:1⟫then I would die out here in the forest."
msgstr "⟪k:0⟫Si la porte ne s’ouvrait pas... ⟪k:1⟫alors je mourrais, là, dans la forêt."

#: scenario5:scenario5_96CB48EE_70D3_4E0F_A6A9_9A4F60AF547B
