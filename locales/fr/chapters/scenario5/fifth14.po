msgid ""
"⟪k:0⟫(It would be terrible if the coachman rolled the carriage because he couldn’t see where we "
"were going.)"
msgstr "⟪k:0⟫(Ce serait affreux que le cocher ait un accident parce qu’il ne voit pas où on va.)"

