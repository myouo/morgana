msgid "⟪k:0⟫(I’d rather if we left when it was clear.)"
msgstr "⟪k:0⟫(Je préfèrerais qu’on s’en aille une fois la brume dissipée.)"

#: scenario5:scenario5_F987E310_0542_4FA0_ADCA_98946A2FFDBB
