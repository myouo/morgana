msgid "⟪k:0⟫They moved up and down, slowly but rhythmically."
msgstr "⟪k:0⟫Ils bougeaient de haut en bas, doucement mais en rythme."

#: scenario5:scenario5_53E54130_E223_4221_ADC7_D0176A8A58B1
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 1ebb415fef342b59bb9fc12bb1daf610d0da6507c78b753c067823d63298883f
