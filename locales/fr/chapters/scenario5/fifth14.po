msgctxt "scenario5:scenario5_1C663933_CC3C_4A8C_8FA8_22FCC787163A"
msgid ""
"⟪k:0⟫I was finally able to return to the capital with Michel.⟪k:1⟫⟪k:2⟫To see my family again."
msgstr ""
"⟪k:0⟫J’allais enfin pouvoir revenir à la capitale avec Michel.⟪k:1⟫⟪k:2⟫Voir ma famille à nouveau."

#: scenario5:scenario5_1DCBDA29_6825_4BF2_A6BD_F46E4A4F6E40
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 35a5eab96543666d79e42468257494ae0c36aec4241e82d9a6e4b6e4e5cb31d8
