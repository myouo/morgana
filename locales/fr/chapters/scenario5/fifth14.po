msgid "⟪k:0⟫(Light?)"
msgstr "⟪k:0⟫(De la lumière ?)"

#: scenario5:scenario5_7D782723_D680_461C_B7EF_27C8E6DAD770
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: fa9907d1a6df0165843e287d5999337f64fa1d3b502b7ed08fab5db6a5a69ba1
