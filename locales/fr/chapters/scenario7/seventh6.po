msgid "⟪k:0⟫⟪k:1⟫............"
msgstr "⟪k:0⟫⟪k:1⟫............"

#: scenario7:scenario7_A9D99D4E_35D3_4074_9B0A_7E5A3AC6A97B
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: eb2d793ffd5c1443f479708d02c0e034e74db9d437dda58ee8d2749c65e56938
#. default-sha256: e802a93df26ee97c8dc6a6ce1b76b874c0d84372237a8a9be90c14637c45cec6
msgctxt "scenario7:scenario7_A9D99D4E_35D3_4074_9B0A_7E5A3AC6A97B"
msgid ""
"⟪k:0⟫⟪k:1⟫I will send a package with any supplies you need once a month.⟪k:2⟫⟪k:3⟫Food, "
"clothing... ⟪k:4⟫and, ⟪k:5⟫hmm, ⟪k:6⟫something to pass the time..."
msgstr ""
"⟪k:0⟫⟪k:1⟫J’enverrai un paquet avec toutes les fournitures dont tu auras besoin une fois par mois."
"⟪k:2⟫ De la nourriture, des vêtements... ⟪k:3⟫et, ⟪k:4⟫hmm, ⟪k:5⟫quelque chose pour passer le "
"temps..."

#: scenario7:scenario7_EB5FBF65_86D4_4B41_92C9_567FADCDC9CC
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 349a8ffff6d644aaf6240df58ef13afe7681e7df31381ee41fc97faa4b8f885f
