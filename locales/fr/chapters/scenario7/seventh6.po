msgid "⟪k:0⟫⟪k:1⟫⟪k:2⟫............"
msgstr "⟪k:0⟫⟪k:1⟫⟪k:2⟫............"

#: scenario7:scenario7_DCE13B0D_57E6_4B52_AB7E_7C8D7DD09A97
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 054b1193cc6c42f2fbb30b01561951e51ff0db00a5aa85d10eb60a6943b91389
#. default-sha256: ebac3e2528322106358aed5e24a6087746b6b7d09aa5faab6f7f4c72f6530422
msgctxt "scenario7:scenario7_DCE13B0D_57E6_4B52_AB7E_7C8D7DD09A97"
msgid ""
"⟪k:0⟫Looking at them, I couldn’t help but remember the old days.⟪k:1⟫⟪k:2⟫Playing chess with "
"Didier. Learning to draw from Georges."
msgstr ""
"⟪k:0⟫En les regardant, je ne pouvais m’empêcher de me rappeler les jours anciens.⟪k:1⟫ ⟪k:2⟫"
"À⟪k:3⟫ jouer aux échecs avec Didier. ⟪k:4⟫À⟪k:5⟫ apprendre le dessin avec Georges."

#: scenario7:scenario7_8D7B438A_C041_426F_B20E_4A9733C9449D
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: edbcda11c856451af504538aa9a45ce6ee30f5a4ae85586992088de67b86c4d4
#. default-sha256: 5456e571135eb580bc26adf7ce297738e40227d83b69d01fce9bba6c13d85171
msgctxt "scenario7:scenario7_8D7B438A_C041_426F_B20E_4A9733C9449D"
msgid "⟪k:0⟫Our sibling outings."
msgstr "⟪k:0⟫Nos excursions tous les trois."

#: scenario7:scenario7_D803BB77_22AB_475F_8509_A45EEB5F5B91
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 9fb6528c1b9f110d983029ac1a85238c372f04c0ae4eede8b4af1f933c4cd0b1
#. default-sha256: 8692641e9e33ba109b671e129b9c4a784d2e2aa571c176f12a1ba1062b6c5938
msgctxt "scenario7:scenario7_D803BB77_22AB_475F_8509_A45EEB5F5B91"
msgid ""
"⟪k:0⟫However, the ominous sound of thunder crashing in the distance drowned out those memories."
msgstr "⟪k:0⟫Mais le bruit menaçant du tonnerre qui tombait au loin recouvrait ces souvenirs."

#: scenario7:scenario7_FCE8D84B_D01C_402F_B4D3_4CC436757271
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: a4e8751551e4e237b487403b263c746b6b437859efcff26d3c0bf3a9d54bf3a0
#. default-sha256: 66f00d9021d9fa2fba5e352789bbaf46ffb9b40f676268cf97fd27ea5db8424e
msgctxt "scenario7:scenario7_FCE8D84B_D01C_402F_B4D3_4CC436757271"
msgid ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫The mansion is several days’ travel from here.⟪k:3⟫⟪k:4⟫Hopefully the carriage "
"isn’t too uncomfortable."
msgstr ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫Le manoir est à quelques jours de voyage d’ici.⟪k:3⟫⟪k:4⟫Avec un peu de chance, la "
"voiture ne sera pas trop inconfortable."

#: scenario7:scenario7_89F3AA26_DF35_434A_8F40_DF2869E9AD99
