msgid ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫⟪k:4⟫⟪k:5⟫⟪k:6⟫⟪k:7⟫Michelle! Ohh Mich⟪k:8⟫eeee⟪k:9⟫eeeelle! Are you in there?"
msgstr "⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫⟪k:4⟫⟪k:5⟫⟪k:6⟫⟪k:7⟫Michelle ! Ohh Micheeeeeeeelle ! Tu es là ?"

#: scenario7:scenario7_FB32878E_3B65_40D1_962A_0B9F5ADBCA69
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 54cf8980bcb46338204c182ca5219b7fc5440dd9ded212b3445ea20b2ddf0e54
#. default-sha256: fe2d222eab69376fb2254cce22e0854a49dad6c1293ac701365665fd0cc9df40
msgctxt "scenario7:scenario7_FB32878E_3B65_40D1_962A_0B9F5ADBCA69"
msgid "⟪k:0⟫⟪k:1⟫⟪k:2⟫Did you need something, Georges?"
msgstr "⟪k:0⟫⟪k:1⟫⟪k:2⟫Qu’est-ce que tu veux, Georges ?"

#: scenario7:scenario7_A55F8FEF_1AB7_4FE2_986A_3FBBE54321B0
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: bbef6d3c0bcdf580610a7b3a87c114e59f7c457a73ea316f433371cf1d965b38
#. default-sha256: f0972a6ba7be27701e5373c0c67429d7e71cfdd6195d823148bae223ca66ae73
msgctxt "scenario7:scenario7_A55F8FEF_1AB7_4FE2_986A_3FBBE54321B0"
msgid ""
"⟪k:0⟫⟪k:1⟫Oh, c’mon, don’t be like that.⟪k:2⟫⟪k:3⟫Do I have to “need something” to talk to you?"
msgstr ""
"⟪k:0⟫⟪k:1⟫Oh, allez, fais pas la tête.⟪k:2⟫⟪k:3⟫Est-ce que j’ai besoin d’avoir une idée derrière "
"la tête pour te parler ?"

#: scenario7:scenario7_3ED6DA89_DABD_4E8E_A636_8C03D240695F
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: af1ed778c13b2f2222fa370d385a01d8d305ecad358055b221bdc58d6ab625db
#. default-sha256: deb28ef872edf3243a51ef1f5e06efed941199d6b92612f9632c13e12c1bdf08
msgctxt "scenario7:scenario7_3ED6DA89_DABD_4E8E_A636_8C03D240695F"
msgid ""
"⟪k:0⟫⟪k:1⟫N-⟪k:2⟫No, but you looked like you were in an unusually good mood,⟪k:3⟫so I thought..."
msgstr ""
"⟪k:0⟫⟪k:1⟫N-⟪k:2⟫Non, mais tu semblais exceptionnellement de bonne humeur,⟪k:3⟫alors j’ai pensé..."

#: scenario7:scenario7_CF12D587_2FF9_4EE4_991C_31AAEB65C73E
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 4b542de66b3c052582d0c71ef1cff30d86cf0643088b6d06d8b8fb9773363a73
#. default-sha256: dacc67d1e67ca112cd0fd84dc3f297d26feec32f19473d91f060a9ecd857f37f
msgctxt "scenario7:scenario7_CF12D587_2FF9_4EE4_991C_31AAEB65C73E"
msgid "⟪k:0⟫⟪k:1⟫Well, why wouldn’t I be?⟪k:2⟫⟪k:3⟫It’s a wonderfully gloomy day out!"
msgstr ""
"⟪k:0⟫⟪k:1⟫Eh bien oui, pourquoi pas ?⟪k:2⟫⟪k:3⟫Il fait un temps merveilleusement sinistre dehors !"

#: scenario7:scenario7_B074DBC1_FA01_4CC8_954A_6C085E79F2EC
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 4785cd71f46f2a4ec42499bd735a5bc68c796d3f55d9a742e59062312594e542
