msgid "⟪k:0⟫⟪k:1⟫............"
msgstr "⟪k:0⟫⟪k:1⟫............"

#: scenario7:scenario7_2F81EBB3_F8A2_41F0_93EE_05BA4326A48B
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: af26430faa646af62559bcfcb346005a9fe4806da5a6037de149762d9e4ed23f
#. default-sha256: 9e70b3d0c18de795802cdf1e9fc1495c801b1eb5e0e6ac1a4faef1d7fe23b0ff
msgctxt "scenario7:scenario7_2F81EBB3_F8A2_41F0_93EE_05BA4326A48B"
msgid ""
"⟪k:0⟫⟪k:1⟫I would understand if it were clear out...⟪k:2⟫⟪k:3⟫but can you really say it’s "
"“wonderfully” gloomy?"
msgstr ""
"⟪k:0⟫⟪k:1⟫J’aurais compris s’il faisait beau...⟪k:2⟫⟪k:3⟫...mais est-ce qu’on peut vraiment dire "
"« merveilleusement » sinistre ?"

#: scenario7:scenario7_DFA0EF82_350D_475B_8014_D38E3E4E9C6F
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 4160e8c7e523e85146363f48666269fa835889e3d6f2c3c595dbd946eeba0f8d
#. default-sha256: a0e898402c3b2f4b4879ceb3f904f0c0787f31b9d70dd83f37092ab67bf89e66
msgctxt "scenario7:scenario7_DFA0EF82_350D_475B_8014_D38E3E4E9C6F"
msgid ""
"⟪k:0⟫⟪k:1⟫Well, you can’t be outside for very long when it’s not cloudy, so in our case, this is "
"perfect weather."
msgstr ""
"⟪k:0⟫⟪k:1⟫Eh bien, comme tu ne peux pas rester dehors trop longtemps quand c’est dégagé, dans "
"notre cas c’est le temps parfait."

#: scenario7:scenario7_E1821575_CA6E_403F_8D30_4330B21534A6
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: d6d63f8d5b95b010c20eab257e0113dee6788fb95cfef7ca24af3fbb990b2cb3
#. default-sha256: c9de2df8c36868adafc2eb1b0ab01e94d2f7404dacab36d2465d743f6c505ba6
msgctxt "scenario7:scenario7_E1821575_CA6E_403F_8D30_4330B21534A6"
msgid "⟪k:0⟫⟪k:1⟫Ah..."
msgstr "⟪k:0⟫⟪k:1⟫Ah..."

#: scenario7:scenario7_C01E4773_3075_4DCE_B133_8C7266956346
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 870a06ba812f1f03e1b97e0bebf4fd116e7f1d01cde921066e5092e9cb9a9802
#. default-sha256: e0e80b7562e70926d0a78447d325adf5e2bc38a7e901a5a211d03b0c4c8ea32a
msgctxt "scenario7:scenario7_C01E4773_3075_4DCE_B133_8C7266956346"
msgid ""
"⟪k:0⟫⟪k:1⟫What do you say we go for a little stroll, while we can?⟪k:2⟫⟪k:3⟫Dee’s around today "
"too, so we can see if he’s up for it.⟪k:4⟫⟪k:5⟫It’ll be like old times."
msgstr ""
"⟪k:0⟫⟪k:1⟫Autant en profiter pour faire une petite promenade tant qu’on peut, qu’en penses-tu ?"
"⟪k:2⟫⟪k:3⟫Di est aussi dans le coin aujourd’hui, alors on peut voir si ça le tente.⟪k:4⟫⟪k:5⟫Ce "
"sera comme avant."

#: scenario7:scenario7_9406F46A_7FED_421F_A304_80D3F5789C3F
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 7cbcff40d92e28f9b3e49aa7ac928908625dee44d8f07cbd9ac28151195cff5c
#. default-sha256: da0b1b8c7aee210b10e0f75e7dad58043b3a22dc5c9e27c541b66e452f6c7ee9
msgctxt "scenario7:scenario7_9406F46A_7FED_421F_A304_80D3F5789C3F"
msgid ""
"⟪k:0⟫⟪k:1⟫We’ve been running around like headless chickens lately,⟪k:2⟫so we haven’t had much of "
"a chance for a sibling outing.⟪k:3⟫⟪k:4⟫We’ll have Mom make us a lunch, and then—"
msgstr ""
"⟪k:0⟫⟪k:1⟫On court partout comme des dératés dernièrement,⟪k:2⟫alors on n’a pas eu beaucoup de "
"temps pour se voir tous les trois.⟪k:3⟫⟪k:4⟫On demandera à Mère de nous préparer un repas et puis—"

#: scenario7:scenario7_2086E62F_87B2_47C7_B186_8D57CAE02078
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: da3c3f2b3a0c62f89a20dcc0ba637f3dc2cb0f9cd0716425149304589e5abd7f
#. default-sha256: d190b3471998e2e222b17cf39cda2ccc39042e76739cb72c23c86e430269e7fc
msgctxt "scenario7:scenario7_2086E62F_87B2_47C7_B186_8D57CAE02078"
msgid "⟪k:0⟫⟪k:1⟫Ooh, we’ll take a couple horses up to the forest’s edge!"
msgstr "⟪k:0⟫⟪k:1⟫Ouh, on pourrait aller jusqu’à l’orée de la forêt à cheval !"

#: scenario7:scenario7_AB202D56_42D8_44B8_855B_BA820064EA7D
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: cc4b4612b2e4420fe2b7bb4f298a8baefedca9bf775154b862d420395cd474fa
#. default-sha256: 565ce004416e0b10d934ba54db6d49e060cec10bb279fa21337b7fbabc4298ad
msgctxt "scenario7:scenario7_AB202D56_42D8_44B8_855B_BA820064EA7D"
msgid "⟪k:0⟫⟪k:1⟫I-⟪k:2⟫I’m fine with that if you are."
msgstr "⟪k:0⟫⟪k:1⟫Je-⟪k:2⟫Je suis d’accord si ça te va aussi."

#: scenario7:scenario7_1CC04FBE_D7D3_499E_8D23_9241BEE32370
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: c709a2d3548a2f1d8196accb8ca43ec4e433daee627f6ba9acaf73d54434e15e
#. default-sha256: 3d0e6529d47a6e374822c2b712972dafbf79f03a6536d3c77a94268f39e913d3
msgctxt "scenario7:scenario7_1CC04FBE_D7D3_499E_8D23_9241BEE32370"
msgid "⟪k:0⟫⟪k:1⟫You bet your bum I am. I asked, after all!⟪k:2⟫⟪k:3⟫Now c’mon, let’s go!"
msgstr ""
"⟪k:0⟫⟪k:1⟫Et pas qu’un peu, qu’ça me va ! C’est moi qui ai proposé, après tout !⟪k:2⟫⟪k:3⟫Allez "
"viens, on y va !"

#: scenario7:scenario7_34D266ED_1135_4E45_9C31_EA6D46852228
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 32b95ce54a515a2f7517addec6fc0aee84e6caaa36190bf48c3e49adfb5aa81a
#. default-sha256: ce2be91204fd1250f73308f5e5754d7790438d8c91e8cb6b28aff0cd2515f7a6
msgctxt "scenario7:scenario7_34D266ED_1135_4E45_9C31_EA6D46852228"
msgid "⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫⟪k:4⟫⟪k:5⟫⟪k:6⟫⟪k:7⟫An outing, you say?"
msgstr "⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫⟪k:4⟫⟪k:5⟫⟪k:6⟫⟪k:7⟫Une excursion, tu dis ?"

#: scenario7:scenario7_54C4A907_7278_42D2_914B_8485A57F286B
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: f80938cae4cc62728d591313f7134619252e66fea788aa71e582b22a0c4c912b
#. default-sha256: 556ad5ac399dea33fb8681956785b3604f38d938177a81c06bd623e3828ec757
msgctxt "scenario7:scenario7_54C4A907_7278_42D2_914B_8485A57F286B"
msgid ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫Yepyep. Hop on a couple horses and head for the forest.⟪k:3⟫⟪k:4⟫We haven’t done "
"this in a while, so I figured why not."
msgstr ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫Dans le mille ! On saute sur des chevaux et on fonce vers la forêt.⟪k:3⟫⟪k:4⟫Ça "
"fait un moment qu’on n’a plus fait ça, alors je me suis dit pourquoi pas."

#: scenario7:scenario7_C7FE1404_21B8_4AFB_ACBC_CE0D1EBB2D6E
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: ff396ee6591b2378ccd0c618a9030d3170864d9344b29366cc1f4bec8936550e
#. default-sha256: e337ff9a76863c9c99a83b1dae039ee5596b0f30ec14ba4675436f50513f8811
msgctxt "scenario7:scenario7_C7FE1404_21B8_4AFB_ACBC_CE0D1EBB2D6E"
msgid ""
"⟪k:0⟫⟪k:1⟫I see. Well, if Michelle is coming, I see no reason to say no.⟪k:2⟫⟪k:3⟫Let’s set off "
"right away."
msgstr ""
"⟪k:0⟫⟪k:1⟫Je vois. Très bien, si Michelle vient, je ne vois aucune raison de refuser.⟪k:2⟫⟪k:3⟫"
"Mettons-nous en route immédiatement."

#: scenario7:scenario7_0439C8F3_C6DE_422D_BA4F_F3A310E5967F
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 8f69eec703e1f929f2333b7e5e15bedafab9e0209cd6101c606ac86174fff069
#. default-sha256: c1d9df59e1eb96e78ac5bb696d161cbbcab53fe4e8730a285f2cb9bce588dc90
msgctxt "scenario7:scenario7_0439C8F3_C6DE_422D_BA4F_F3A310E5967F"
msgid ""
"⟪k:0⟫⟪k:1⟫Whoa, whoa, slow down there.⟪k:2⟫⟪k:3⟫Are you saying you wouldn’t go if it was just me?"
"⟪k:4⟫⟪k:5⟫It’s Michelle or nothing?"
msgstr ""
"⟪k:0⟫⟪k:1⟫Ho, ho, attends un peu.⟪k:2⟫⟪k:3⟫T’es en train de me dire que tu viendrais pas si y "
"avait que moi ?⟪k:4⟫⟪k:5⟫C’est Michelle ou rien ?"

#: scenario7:scenario7_8DF16205_0566_4025_B2D9_528D1AA14340
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 08f8be3ced52735666bfdde8e264dd51821b0a4d26884a63448e6d34687ac6eb
#. default-sha256: 55fa6bbdc5b4646b6c0447537ee55d4d715f5b302fd026d4a13648557b603b62
msgctxt "scenario7:scenario7_8DF16205_0566_4025_B2D9_528D1AA14340"
msgid ""
"⟪k:0⟫⟪k:1⟫Of course. Why on earth would I want to go horse-riding alone with you? ⟪k:2⟫I would "
"rather drown myself."
msgstr ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫É⟪k:3⟫videmment. Pourquoi diable irais-je chevaucher tout seul avec toi ? ⟪k:4⟫"
"Autant me noyer."

#: scenario7:scenario7_D6BBF839_251E_423D_AD38_1E3477201973
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 5d58695081113a560f270f87d0e76c834892eea376d6332b5edf03cd41638753
#. default-sha256: a36bbd68b2b3bd4cafcd13a97869684cfd62695a0e4b93b12819bd6d252bcf5f
msgctxt "scenario7:scenario7_D6BBF839_251E_423D_AD38_1E3477201973"
msgid "⟪k:0⟫⟪k:1⟫⟪k:2⟫LE GAAAAAAAAAAAAAAAASP!"
msgstr "⟪k:0⟫⟪k:1⟫⟪k:2⟫MAIIIIIIISS EUUUUUUUUUUUUUUUUHH !"

#: scenario7:scenario7_F4B2BA61_62B5_4150_BFC7_104328D10817
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 8d420cb2365fe6dc7a644868419a4d49a9560b104116cff636dc26951a79ed2e
#. default-sha256: 309f810c22098c6524620c532cb4a3d274e70b77394e22074330fb49134f11ca
msgctxt "scenario7:scenario7_F4B2BA61_62B5_4150_BFC7_104328D10817"
msgid "⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫Um, Didier... ⟪k:4⟫could I, perhaps, make a small request?"
msgstr ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫Hum, Didier... ⟪k:4⟫est-ce que, par hasard, je peux te demander un petit "
"quelque chose ?"

#: scenario7:scenario7_D5201F50_0026_463D_ACA6_0B41AE96A802
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 9ad6d93c0948bab29b58328972138f30f865e757e49ea5c2a7a1ed0644f9f263
#. default-sha256: a4fe38ea324cfbe7011d98cf720e69c280f90b0b9d0a0edf6f8b1273527f4a59
msgctxt "scenario7:scenario7_D5201F50_0026_463D_ACA6_0B41AE96A802"
msgid "⟪k:0⟫⟪k:1⟫Go on, let’s hear it."
msgstr "⟪k:0⟫⟪k:1⟫Vas-y, je t’écoute."

#: scenario7:scenario7_50A8EFA1_E5B5_46CF_BAFF_2E5A5D2666AC
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: f043b09a2fe50ad3a0d8d18e148043fceb5774f4f4d0a91304ba132af304f5a6
#. default-sha256: 23aff4df41c9bd6aba9e4048c626a105c0227b57836e48127c7f7910caa56f11
msgctxt "scenario7:scenario7_50A8EFA1_E5B5_46CF_BAFF_2E5A5D2666AC"
msgid "⟪k:0⟫⟪k:1⟫Do you mind if I... ⟪k:2⟫hold the horse’s reins?"
msgstr "⟪k:0⟫⟪k:1⟫Ça te dérange si je... ⟪k:2⟫tiens les rênes du cheval ?"

#: scenario7:scenario7_CD4C7EE4_B103_480B_8DB0_1A19F8854021
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 8ce2ac216e6810d9a7846c17a469f0f0fb112a5d5c043191858509a8be68dfbf
#. default-sha256: a10d73f8504542ae0fe84a2f4ee4091fe7f1639562ab1187bf9fd9cf1beb3168
msgctxt "scenario7:scenario7_CD4C7EE4_B103_480B_8DB0_1A19F8854021"
msgid ""
"⟪k:0⟫⟪k:1⟫Oh, that’s all? By all means.⟪k:2⟫⟪k:3⟫I’ll be there behind you to make sure nothing "
"happens, so have at it."
msgstr ""
"⟪k:0⟫⟪k:1⟫Oh, c’est tout ? Je t’en prie.⟪k:2⟫⟪k:3⟫⟪k:4⟫À⟪k:5⟫ toi l’honneur, je serai juste "
"derrière toi pour m’assurer qu’il ne t’arrive rien."

#: scenario7:scenario7_FE8E2917_B186_4CDB_AABC_5C3944D5B965
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: dd133ed23464a674a501244d1ecd0de1acfc665f88e7be61ed13238e67cde5ce
#. default-sha256: 075585e1aba4ff1cb36a4a15a87d08217701474cbacb9255e1a0e1c382e59304
msgctxt "scenario7:scenario7_FE8E2917_B186_4CDB_AABC_5C3944D5B965"
msgid ""
