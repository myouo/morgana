msgid "⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫⟪k:4⟫As if you’re any better!"
msgstr "⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫⟪k:4⟫Comme si t’étais meilleur !"

#: scenario7:scenario7_B0D34DBE_24A5_4A5D_8467_F8709C64AE01
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 076fa10cb59c27de326d3d245ba641f0e33f9c27f4ac0207a17a5ff5fc4ee882
