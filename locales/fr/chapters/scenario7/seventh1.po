msgstr "⟪k:0⟫Non. Ce n’était pas pour ça."

#: scenario7:scenario7_3B2189D6_0FF1_4071_8148_E8C36D0D64A9
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 52694aab9dedc703dd9fba02ace655c2d833aa8edc8863fe45ecf2009cbc7db3
#. default-sha256: 2f5ce52164005c3ef11d9209b27a984a8a91f0e569f8071729db4305315f5281
msgctxt "scenario7:scenario7_3B2189D6_0FF1_4071_8148_E8C36D0D64A9"
msgid ""
"⟪k:0⟫Her gentle voice. The sweet scent of her perfume.⟪k:1⟫⟪k:2⟫The way she constantly told me "
"how much she loved me,⟪k:3⟫and her diatribes about how wonderful it was to be a girl."
msgstr ""
"⟪k:0⟫Sa voix posée. Son doux parfum. ⟪k:1⟫⟪k:2⟫La manière qu’elle avait de me dire constamment "
"combien elle m’aimait, et ses longs discours sur le bonheur d’être une fille."

#: scenario7:scenario7_3F59DDA7_CF9A_4DF9_BE02_B92DA1FF2467
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 70bfb4e48ccea49d521cb93cbf973f159b8bf118d3015dcb93815ad2d147667f
#. default-sha256: b9a5f23e899f5c8057384e647cbb97322b4d08cab02c07b5fb699beddfbfced0
msgctxt "scenario7:scenario7_3F59DDA7_CF9A_4DF9_BE02_B92DA1FF2467"
msgid "⟪k:0⟫Everything she did put so much pressure on me."
msgstr "⟪k:0⟫Tout en elle me mettait une pression terrible."

#: scenario7:scenario7_CE2E1D09_66F6_435B_A47D_178C1499ECE6
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: a3b8a1cae372e6765819fffc4b5bde4cdf58605531da51f4aec9e6e536856ecc
