msgctxt "scenario7:scenario7_CE2E1D09_66F6_435B_A47D_178C1499ECE6"
msgid "⟪k:0⟫But above all, she loved to say,"
msgstr "⟪k:0⟫Mais par-dessus tout, elle adorait répéter :"

#: scenario7:scenario7_40CC3113_166E_4F46_AB19_9B65026E3104
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: c5ad094b65cc7cf69e8a640c0bd60f4283b5a185e684be803576fe5d9c161c28
