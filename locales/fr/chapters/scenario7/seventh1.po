msgctxt "scenario7:scenario7_15D2AB99_1918_4402_BEEB_E53A12C46FDF"
msgid "⟪k:0⟫Out in the garden, my two brothers traded swings bare-chested."
msgstr "⟪k:0⟫Dehors, dans le jardin, mes deux frères, torses nus, échangeaient des passes d’armes."

#: scenario7:scenario7_AADA5C9C_F2E7_417E_830E_20644F5D2D60
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 80d42261cefb8f97df8031a79a5fe508a17c69ddcae96137ec1e908c1fed30f9
#. default-sha256: 15c439a3c065d8ad01fb844b43094940a07cb58461f5bcd25a68fc77a6b33905
msgctxt "scenario7:scenario7_AADA5C9C_F2E7_417E_830E_20644F5D2D60"
msgid "⟪k:0⟫All I could do, though, was observe from afar."
msgstr "⟪k:0⟫Mais moi, je pouvais seulement les observer de loin."

#: scenario7:scenario7_EA651833_C1E3_404A_BC2A_9A5E412B6C25
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: c4166b80b6716d4c34ab274a06bbe18f738504012fdeb093cfd9a58733e41687
