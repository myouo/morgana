msgctxt "scenario7:scenario7_4D6C3525_8C8E_4717_9B51_FB0174D081E3"
msgid ""
"⟪k:0⟫The sensation of the hilt beneath my fingers.⟪k:1⟫⟪k:2⟫Swinging it gallantly—⟪k:3⟫⟪k:4⟫like "
"my brother."
msgstr ""
"⟪k:0⟫Toucher la garde sous mes doigts.⟪k:1⟫⟪k:2⟫La faire tournoyer élégamment —⟪k:3⟫⟪k:4⟫ comme "
"mon frère."

#: scenario7:scenario7_1ECAFF1A_C8D6_47F4_8762_4CB80EC38154
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: a0988946301957aea993432b49b92921f9b4dc320378189f7c7848a5f8e05cce
