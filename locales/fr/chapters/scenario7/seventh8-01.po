#: scenario7:scenario7_88E91C20_1FAC_4F1B_8BB7_CAF9D0FF2818
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 93f8f1df55977370af5a1fba1bd7f2fb4c7496e95414ff2f93f330663a590020
#. default-sha256: 86b6e9ef00c9ad868ffd414857e79116de713497d5d59ff5bc9a4dd74b3ca665
msgctxt "scenario7:scenario7_88E91C20_1FAC_4F1B_8BB7_CAF9D0FF2818"
msgid ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫⟪k:4⟫⟪k:5⟫⟪k:6⟫⟪k:7⟫⟪k:8⟫⟪k:9⟫For so long, I have been waiting.⟪k:10⟫⟪k:11⟫"
"Waiting for the day I would be rid of this darkness."
msgstr ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫⟪k:4⟫⟪k:5⟫⟪k:6⟫⟪k:7⟫⟪k:8⟫⟪k:9⟫Pendant tout ce temps, j’ai attendu.⟪k:10⟫⟪k:11⟫"
"Attendu le jour où je serais débarrassée de cette noirceur."

