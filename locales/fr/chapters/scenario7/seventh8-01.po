msgctxt "scenario7:scenario7_771B2BBE_68D4_4842_B6F4_FAF4FD301BC8"
msgid "⟪k:0⟫Morgana..."
msgstr "⟪k:0⟫Morgana..."

#: scenario7:scenario7_745E07C6_2877_4A93_BE88_6009A8257722
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 0b6ddeceff005cb3f93e7a3ef85ff9bb9b63842f6464dc20948592e462d23644
#. default-sha256: b0216eb7a9eda6cf3c151862615b9fc4b52522413a35b059bb532d26df0a60fe
msgctxt "scenario7:scenario7_745E07C6_2877_4A93_BE88_6009A8257722"
msgid ""
"⟪k:0⟫I could place a curse on someone you have a grudge against.⟪k:1⟫⟪k:2⟫Drag them down into the "
"dark abyss."
msgstr ""
"⟪k:0⟫Je pourrais jeter un sort à la personne de ton choix.⟪k:1⟫⟪k:2⟫La traîner dans l’abîme le "
"plus profond."

#: scenario7:scenario7_5591326A_723D_440F_BD0C_467CDB8381D6
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 1eba0abfd73ae4e65420993aa0568dadada92bbccc0e7ec40548604cf11334b7
#. default-sha256: 3e0d95cf2fa14f4eea109a22520474cbb8b932947292233f705ccc70ec13b034
msgctxt "scenario7:scenario7_5591326A_723D_440F_BD0C_467CDB8381D6"
msgid "⟪k:0⟫And for that, I will grant you your wish."
msgstr "⟪k:0⟫Et pour cela, je veux t’accorder un vœu."

#: scenario7:scenario7_4965D32C_A833_4DA2_A2B2_72ED7724F309
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: fefec8236c7d8384ab22740819b4affcbb9b63923be3710f04a69aca933d5208
