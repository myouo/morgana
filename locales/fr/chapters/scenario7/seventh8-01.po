msgctxt "scenario7:scenario7_9FA6C8F3_2B7D_4816_A931_950BCA707563"
msgid "⟪k:0⟫and I shall do the same for you."
msgstr "⟪k:0⟫...et j’en ferai de même pour toi."

#: scenario7:scenario7_ED94CB92_5964_46E6_9B5A_7065208EF56B
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: b881c38d3d374614d84f4a185aa6ecad62fe362e1f82d30e071a516857bb3832
#. default-sha256: 423c61283daa41f072a919087b3811ca76fe071be93239c47e42a910cf2003e4
msgctxt "scenario7:scenario7_ED94CB92_5964_46E6_9B5A_7065208EF56B"
msgid "⟪k:0⟫You can give me life again. You can resurrect me."
msgstr "⟪k:0⟫Tu peux me redonner vie. Tu peux me ressusciter."

#: scenario7:scenario7_7F088681_CBC3_406F_B370_45C16AA79EFD
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: a958f3e1c37398d43fd628ded797e12d89bcc6859603dee528d98be074f63c68
#. default-sha256: 76f61cddc8d392221be8aa298dcb59dc66c05cc429edce6a453df7380e025d21
msgctxt "scenario7:scenario7_7F088681_CBC3_406F_B370_45C16AA79EFD"
msgid ""
"⟪k:0⟫It felt like I was no longer in control of my own body.⟪k:1⟫⟪k:2⟫Her voice was tender in a "
"way unlike either Mother’s or Aimee’s."
msgstr ""
"⟪k:0⟫C’était comme si j’avais perdu le contrôle de mon propre corps.⟪k:1⟫⟪k:2⟫Sa voix était "
"tendre mais d’une manière différente de celle de Mère ou d’Aimée."

#: scenario7:scenario7_E693A7E3_F555_4086_BBE8_BDB52E3857CF
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 1162dcdc7311ad3625c95cc68ecc1f95b0d093d6fce5b153954713ccd3524054
#. default-sha256: dfb2c215c1f5985a1bfec9c9401cb34e1da5b207c5a0a4afed78ed9529fffbb0
msgctxt "scenario7:scenario7_E693A7E3_F555_4086_BBE8_BDB52E3857CF"
msgid "⟪k:0⟫It was empty."
msgstr "⟪k:0⟫L’endroit était vide."

#: scenario7:scenario7_D33AF05A_D351_474B_AC22_EB755E2EBFAD
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 2df10630fb473e15a9f56b1107d8ac5ca58f6a92a7e226a28f65cc7ef2bdedd7
#. default-sha256: ce93a4636671552d7d3c5168a582f267996ebd1ab8151827fc59a07eeaf21e61
msgctxt "scenario7:scenario7_D33AF05A_D351_474B_AC22_EB755E2EBFAD"
msgid "⟪k:0⟫only her voice whispering in my ear."
msgstr "⟪k:0⟫il n’y avait que sa voix, qui me chuchotait à l’oreille."

#: scenario7:scenario7_1F16E57D_9149_4683_A6EF_EE377EEF2BDD
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 6cfdfb705da635c56f5596ad548bb91e809dc6f4464708d0cffd58ea07364ab5
