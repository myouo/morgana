#: scenario7:scenario7_F26DF4E0_B5F5_4A9A_AADA_023B06F5F5DA
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 5e7ff376378ff4c9fce50b1619272bfe55511bd5c8e26b2d3b0eee3c979e5a88
#. default-sha256: 528481a3b4842288120d0e9e4b916d18c611f2bf18993de9339c3ff226ee51db
msgctxt "scenario7:scenario7_F26DF4E0_B5F5_4A9A_AADA_023B06F5F5DA"
msgid "⟪k:0⟫Tell me who you wish to curse...⟪k:1⟫⟪k:2⟫and I can lead them here."
msgstr "⟪k:0⟫Dis-moi qui tu souhaites maudire...⟪k:1⟫⟪k:2⟫...et je les guiderai jusqu’ici."

#: scenario7:scenario7_5455BC8D_74CC_4A29_9CA7_A75AD3ED4949
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 9052b1b7f50b78a4163a752247bc59ab33f82b63fffd056c62565d789c49ae08
#. default-sha256: 5d46c3d5c7dc3f6ff767f8eb6f287ddaa0d2cd1768b9a06bbe2ce5e63ea8edd1
msgctxt "scenario7:scenario7_5455BC8D_74CC_4A29_9CA7_A75AD3ED4949"
msgid "⟪k:0⟫I can force the cross you were made to bear onto them."
msgstr "⟪k:0⟫Je peux leur infliger la même croix qu’on te fait porter."

#: scenario7:scenario7_DCB2D6AB_E33F_4477_9CBE_4AB12A0CCD9A
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 12d904b726d7c950c24c80a9c012d12cdb6e91a6f0014ca9210660a109315776
