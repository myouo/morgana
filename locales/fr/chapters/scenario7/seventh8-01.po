msgid "⟪k:0⟫Constant, everlasting despair..."
msgstr "⟪k:0⟫Un désespoir constant, sans fin..."

#: scenario7:scenario7_2FA8154B_757D_40E8_B98D_4630AF243643
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: dbef6db2858b7b4713963c28fa2bfa2af55e312e26874e00e0aa62a0dab34042
#. default-sha256: dbdf4a380e2f4a8cad7bbae38fd64254bb50ec687c4014a70109de7aea48d4d4
msgctxt "scenario7:scenario7_2FA8154B_757D_40E8_B98D_4630AF243643"
msgid "⟪k:0⟫Their flesh may turn to dust..."
msgstr "⟪k:0⟫Leur corps peut bien devenir poussière..."

#: scenario7:scenario7_D4E5927C_C209_48BF_A235_21727A0C5234
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 9f02782dfd52eb8141b8649ca08dc98745a7667817e838d6898dafe2dbeeb134
#. default-sha256: f3411eeb5d1f08cc55b3a68ac1bb646169fd7598efb9035699881fd740ec44ff
msgctxt "scenario7:scenario7_D4E5927C_C209_48BF_A235_21727A0C5234"
msgid "⟪k:0⟫but so long as their souls live on, their torture will know no end..."
msgstr "⟪k:0⟫...tant que leur âme vivra, leur torture n’aura pas de fin..."

#: scenario7:scenario7_D449F5C1_B1B1_4276_B37A_ADD7D10D46BE
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: e0d29ab354aad0bf8aa76f156670c336b9cffa53b0287fc66ef0c8c68c0a9bad
#. default-sha256: a6a7224567d190a699878a0e52e9d0f0ef3c795b17ea4fa71a04766b27c20d24
msgctxt "scenario7:scenario7_D449F5C1_B1B1_4276_B37A_ADD7D10D46BE"
msgid ""
"⟪k:0⟫The tenderness in her voice crumbled away, leaving only raw loathing behind. ⟪k:1⟫She then "
"let out a half-muffled cackle."
msgstr ""
"⟪k:0⟫Sa voix perdit toute tendresse pour ne laisser que la haine, une haine à l’état pur. ⟪k:1⟫"
"Puis elle émit un ricanement à demi étouffé."

#: scenario7:scenario7_9BCB69A7_9EEB_4A04_BAB8_2B40788CF6C1
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 4140adbdd2e7aebffa0abf87c146dd705ef317d0035d9e197a833e46bbebf851
#. default-sha256: b4f67e271ed47e128a2c37f192d6ee11572693aeeded8948e4632268fa3ce697
msgctxt "scenario7:scenario7_9BCB69A7_9EEB_4A04_BAB8_2B40788CF6C1"
msgid "⟪k:0⟫Who ⟪k:1⟫are⟪k:2⟫ you?"
msgstr "⟪k:0⟫Mais qui êtes-vous ?"

#: scenario7:scenario7_E2088DD3_5F4E_4D55_B5A4_21971D01EB82
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 792fcbb00edef7d52bd216e04f8765c1b20658d53002d4514661cb7a8941f46d
#. default-sha256: d268670ba74ff05fe85830660b57f3bf3688d873f8fdc7e4cc44e1cc318b771c
msgctxt "scenario7:scenario7_E2088DD3_5F4E_4D55_B5A4_21971D01EB82"
msgid ""
"⟪k:0⟫That I am.⟪k:1⟫⟪k:2⟫I am the cursed witch, who loathes this puny, wretched world—⟪k:3⟫⟪k:4⟫"
"⟪k:5⟫curses it."
msgstr ""
"⟪k:0⟫Si.⟪k:1⟫⟪k:2⟫Je suis la sorcière maudite, qui hait ce monde misérable, dérisoire—⟪k:3⟫⟪k:4⟫"
"⟪k:5⟫qui le maudit."

#: scenario7:scenario7_B635749A_FC83_4FFC_A662_B0FD9832BB0B
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 5ab3428a9ec2a90abb143ed6d4d8cc2d0e244943ac8513965ea4473587cb3b37
