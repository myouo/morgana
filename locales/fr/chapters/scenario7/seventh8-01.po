msgctxt "scenario7:scenario7_DCB2D6AB_E33F_4477_9CBE_4AB12A0CCD9A"
msgid "⟪k:0⟫Georges..."
msgstr "⟪k:0⟫Georges..."

#: scenario7:scenario7_CD0DCF14_1A13_4F5B_8915_D36D67C12D3C
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 6adabd0f988c982a26a6848e29fc3648a54f336c5b364d77136617ca22575a1d
#. default-sha256: b49f94c2aad50b38023667cbfef8a1e42232f64cccc319bda89a14ad883f3872
msgctxt "scenario7:scenario7_CD0DCF14_1A13_4F5B_8915_D36D67C12D3C"
msgid "⟪k:0⟫Shall we kill him?"
msgstr "⟪k:0⟫Allons-nous le tuer ?"

#: scenario7:scenario7_0A5F76DF_0B8B_46B1_A2CA_DA1DDCF29E00
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: d76e50e4b4d69d95c83d6ea975783a02f02118f4b24e6b6222547fafb4ae31c4
#. default-sha256: cc148b9ad25eca0e7d7197451b983638b1732e783b69fb632355a3d0dfffdee1
msgctxt "scenario7:scenario7_0A5F76DF_0B8B_46B1_A2CA_DA1DDCF29E00"
msgid "⟪k:0⟫He deserves at ⟪k:1⟫least⟪k:2⟫ that.⟪k:3⟫⟪k:4⟫He brought you more than enough pain."
msgstr "⟪k:0⟫C’est ⟪k:1⟫tout⟪k:2⟫ ce qu’il mérite.⟪k:3⟫⟪k:4⟫Il t’a causé bien assez de souffrances."

#: scenario7:scenario7_8906939C_E484_4AD9_B410_5DD0F4EABDB9
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: d377e07b52df43aedc50aff1975e335a585fd13e25a529ab55ba332241855e54
#. default-sha256: fdda4c3f0edc9dc4619e0b88f4427b0a2a02b39021b6577baf2ae015adf589ef
msgctxt "scenario7:scenario7_8906939C_E484_4AD9_B410_5DD0F4EABDB9"
msgid ""
"⟪k:0⟫But if you would rather... ⟪k:1⟫you could curse your mother instead.⟪k:2⟫⟪k:3⟫Or the woman "
"who set you on this path..."
msgstr ""
"⟪k:0⟫Mais si tu préfères... ⟪k:1⟫on peut maudire ta mère, plutôt.⟪k:2⟫⟪k:3⟫Ou bien la femme qui "
"t’a mené là où tu es..."

