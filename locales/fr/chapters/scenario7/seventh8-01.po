msgctxt "scenario7:scenario7_D858E240_F039_447C_B1C0_07C43C90FB4C"
msgid "⟪k:0⟫I know your pain."
msgstr "⟪k:0⟫Je sais ta douleur."

#: scenario7:scenario7_A1F30229_A70F_4449_B9EA_47D4032BAEA2
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: c6cd4f872c12a93832a35d0067ded665f24bbafa089b6c53c8262b10ddb6e0a4
