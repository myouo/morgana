msgctxt "scenario7:scenario7_1F16E57D_9149_4683_A6EF_EE377EEF2BDD"
msgid "⟪k:0⟫You made this possible..."
msgstr "⟪k:0⟫Grâce à toi..."

#: scenario7:scenario7_38463CB7_E401_467F_9703_51F921B5D5D9
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 7b0a2ce755d79816d137273fa702e2bc0e3cf07491fe99472ca479c1c1d014bc
