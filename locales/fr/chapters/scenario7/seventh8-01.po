#: scenario7:scenario7_4192695C_CD64_45F6_B7B2_D9385A7FEC77
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 58acc69f39bf6c67f4b92cdeba4a2b9c7569cda64e295200c2c7d808917f716d
#. default-sha256: 8328fdb2207321bcf5877ba5dee42657da6f811801a87da02570e75012bd9448
msgctxt "scenario7:scenario7_4192695C_CD64_45F6_B7B2_D9385A7FEC77"
msgid "⟪k:0⟫When you arrived at this house... ⟪k:1⟫I felt the hands of fate at work."
msgstr "⟪k:0⟫Quand tu es arrivé dans cette maison... ⟪k:1⟫j’ai senti les mains du destin à l’œuvre."

#: scenario7:scenario7_81463A50_FEBD_4A7A_9C7A_E2EC0C6BCF0C
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 0e5ed511bfb9a3062d3ad610ba2afe9ad5e35a37194c9a1f51fda5f67236900f
#. default-sha256: 8dc10a02528245697ebe468d1334bb222618c65e27890d719b108cbc1c35fec5
msgctxt "scenario7:scenario7_81463A50_FEBD_4A7A_9C7A_E2EC0C6BCF0C"
msgid "⟪k:0⟫You’ve been through so much to get here..."
msgstr "⟪k:0⟫Tu as tellement souffert avant ton arrivée..."

#: scenario7:scenario7_D858E240_F039_447C_B1C0_07C43C90FB4C
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 1d91c84b7311a415dd1b9c8981326c91dcf03bb9f37546e07dd86b60d9bf3396
