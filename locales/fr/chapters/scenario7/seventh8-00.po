msgid "⟪k:0⟫⟪k:1⟫⟪k:2⟫Now, open the door, ⟪k:3⟫Michel."
msgstr "⟪k:0⟫⟪k:1⟫⟪k:2⟫Maintenant, ouvre la porte, ⟪k:3⟫Michel."

#: scenario7:scenario7_8A86B1D0_BF72_47AB_BA59_0FE2F2EFE272
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: ada308cc24588b7699ab5698eba4ee23388eff25008e7c2c8c6525956632928f
