#: scenario7:scenario7_3905A0DF_5399_40E6_89EA_481CCE30AF81
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 7812d3a0494f4580c6f62ba0c6d35d736621a09d7f3a363d5c8cf4d7808ccd74
#. default-sha256: 415f1b7ce300d381f631359db822da534338c164c2091fdaaa379c7573c63784
msgctxt "scenario7:scenario7_3905A0DF_5399_40E6_89EA_481CCE30AF81"
msgid "⟪k:0⟫Thank you... ⟪k:1⟫for opening the door."
msgstr "⟪k:0⟫Merci... ⟪k:1⟫d’avoir ouvert la porte."

#: scenario7:scenario7_D7BF15E8_BDB8_49BE_9389_3050755E9FC2
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: be8a16b484cf1b968b75a5cb8704846825fbc7ea8a9ba2d32ade01af2947933d
#. default-sha256: 1c2e83d82fcef73a8b654bc1bdbeb759eeb5dd07e60cc58d559eb6462cbb49ad
msgctxt "scenario7:scenario7_D7BF15E8_BDB8_49BE_9389_3050755E9FC2"
msgid ""
"⟪k:0⟫The skeleton, which had been sitting there as long as I had been at this house, had vanished "
"without a trace."
msgstr ""
"⟪k:0⟫Le squelette qui avait toujours été là depuis mon arrivée avait disparu sans laisser aucune "
"trace."

#: scenario7:scenario7_C1990B51_6F38_4EE4_9AB4_3AA0E740A217
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 186c643d71bdb34cd12828ed191651474c0deaea09b2053c0a0725376e92da07
#. default-sha256: bd8b2eabb4b04379d03f85b00300efa34584717dc2f3b019ed84529626cbda72
msgctxt "scenario7:scenario7_C1990B51_6F38_4EE4_9AB4_3AA0E740A217"
msgid ""
"⟪k:0⟫I spun around, my gaze darting back and forth across the chamber,⟪k:1⟫but there was no one "
"there—"
msgstr ""
"⟪k:0⟫Je me tournai de tous les côtés, parcourant du regard le moindre recoin de la pièce, mais il "
"n’y avait personne—"

#: scenario7:scenario7_3717CEB8_6B08_4EF7_A689_0AE58EACA40A
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: c27f580ebfc715bb8fb6cf2720f8889c7dfe922937a7b36ff4f03cd98fd80d1b
#. default-sha256: 6febdb39bcb4321dc10ed5366d2091c1579f6f63680e974c38c3a2c0f1d344f4
msgctxt "scenario7:scenario7_3717CEB8_6B08_4EF7_A689_0AE58EACA40A"
msgid "⟪k:0⟫⟪k:1⟫You gave me the chance to have my revenge."
msgstr "⟪k:0⟫⟪k:1⟫...je vais pouvoir me venger."

#: scenario7:scenario7_5C785F31_06F7_4173_9DE7_2858777CFD91
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: a75402b7dd70a2a55c72943f699c62beb0caf1da1645b5a6284fa6a46442a899
#. default-sha256: f9089abdc94f4613a7409e8755b408f7a895d6917e0ce5935ff64116a61a6e0b
msgctxt "scenario7:scenario7_5C785F31_06F7_4173_9DE7_2858777CFD91"
msgid "⟪k:0⟫Revenge...?"
msgstr "⟪k:0⟫Venger... ?"

#: scenario7:scenario7_17FE593C_D11B_4B3A_9B4A_FF51BD304787
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 297c28682c4f557ea752bf5a9d035168f9e2241b9377be98ef824ad6e6e9408c
#. default-sha256: ab34b5d45cc588faa3fd811b47a085d4c56f2fa99caf1575c274d253c5136145
msgctxt "scenario7:scenario7_17FE593C_D11B_4B3A_9B4A_FF51BD304787"
msgid "⟪k:0⟫Now, I can make those men suffer a hell even worse than the one they put me through..."
msgstr ""
"⟪k:0⟫⟪k:1⟫À⟪k:2⟫ présent, je vais pouvoir faire vivre l’enfer à ces hommes, un enfer bien plus "
"terrible que ce qu’ils m’ont fait subir..."

#: scenario7:scenario7_7C059B14_A129_4954_80FC_3C436FFA9B93
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 997f4bfb28331b3c48a9773e0e64a21d5f7320ddb2ace610c19f24bdb49ea346
#. default-sha256: 387be6845f3223b6060ce3b781e56d34b772d357766e6a8b69e83c2960c5317b
msgctxt "scenario7:scenario7_7C059B14_A129_4954_80FC_3C436FFA9B93"
msgid "⟪k:0⟫Hah... ⟪k:1⟫haha... ⟪k:2⟫hahaha..."
msgstr "⟪k:0⟫Hah... ⟪k:1⟫haha... ⟪k:2⟫hahaha..."

#: scenario7:scenario7_A4FDA90C_FB78_4D12_9A5B_61011E6CB9DD
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 26f0d3ca72131cc489f8e0cdfeefd95d7098d7f94ba431fb544e3859976515a6
#. default-sha256: ce7008295803b865174bb033a5107295d70e83408d9d6ce598d24c2245992696
msgctxt "scenario7:scenario7_A4FDA90C_FB78_4D12_9A5B_61011E6CB9DD"
msgid "⟪k:0⟫Ahahahahahaha..."
msgstr "⟪k:0⟫Ahahahahahaha..."

#: scenario7:scenario7_E057D1CB_B59B_439E_AE89_1CA6201F6CE0
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 1a3a0de18f291e98aab8eb2bc40c2530f7d594434926540029618b997ce40abb
#. default-sha256: 0ff26ed4a887f3765f21b8f6bbace6ff82fcae5335e9394cd1ad5761efb9f8e8
msgctxt "scenario7:scenario7_E057D1CB_B59B_439E_AE89_1CA6201F6CE0"
msgid "⟪k:0⟫Oh, you poor dear. They locked you up here without telling you whose house it was?"
msgstr ""
"⟪k:0⟫Oh, mon pauvre enfant. Ils t’ont enfermé ici sans te dire qui vivait dans cette maison ?"

#: scenario7:scenario7_D110955E_8C94_4B5F_8B3B_023D2D661687
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: fa7986e66746b88ad83b4737d809a96b9020a5a83d0c26a7492980252aa2cfe5
#. default-sha256: a91f10d339dea36702ecffd49dfac343c4d110b183104e7ee2c5a964eaa03050
msgctxt "scenario7:scenario7_D110955E_8C94_4B5F_8B3B_023D2D661687"
msgid "⟪k:0⟫You sad, pathetic thing...⟪k:1⟫⟪k:2⟫Though that’s exactly the kind of person I needed."
msgstr ""
"⟪k:0⟫Comme c’est triste, tu me fais pitié...⟪k:1⟫⟪k:2⟫Mais tu es exactement le genre de personne "
"dont j’avais besoin."

#: scenario7:scenario7_021FDB46_4407_4465_A38D_7CB739227033
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 7e7ff00532b7f1f7bf65ca05de271742cd28f0d9b6a09da9c4ca44e29b8a034a
#. default-sha256: 1b741bd2e5675a99e0cc5b499d1aea57e40571781da83b10c5234881698c4f5c
msgctxt "scenario7:scenario7_021FDB46_4407_4465_A38D_7CB739227033"
msgid "⟪k:0⟫You’re... ⟪k:1⟫You’re not the witch, are you...?"
msgstr "⟪k:0⟫Vous... ⟪k:1⟫Vous n’êtes tout de même pas la sorcière, si... ?"

#: scenario7:scenario7_628FA3F9_73B9_45FC_9FBF_59CF1C8441D7
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 9f734b323f4e6aeb94e1785169b54ca17ceb40523a792f298f6fa44dfdd1c867
#. default-sha256: d0b127246982145c9de33e456dd1cd42d931716f4881a8410d1f600259a548b6
msgctxt "scenario7:scenario7_628FA3F9_73B9_45FC_9FBF_59CF1C8441D7"
msgid "⟪k:0⟫I assumed... ⟪k:1⟫the witch was nothing but a legend. A tale..."
msgstr "⟪k:0⟫Je pensais... ⟪k:1⟫que la sorcière n’était qu’une légende. Un conte..."

#: scenario7:scenario7_AD899BFA_FFBD_4B11_9952_AADF7BCE7E87
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: d683b772c859d85a374bce0a64fbc9e49722b3c53cf171342bf4391ba7cc86e7
#. default-sha256: 988928cffff2d69302593351b0393d984676937f2785dd3376b1861ba6a72589
msgctxt "scenario7:scenario7_AD899BFA_FFBD_4B11_9952_AADF7BCE7E87"
msgid "⟪k:0⟫If you don’t believe me, I would be happy to show you.⟪k:1⟫⟪k:2⟫Let’s see..."
msgstr ""
"⟪k:0⟫Si tu ne me crois pas, je serais ravie de te faire une démonstration.⟪k:1⟫⟪k:2⟫Voyons voir..."

