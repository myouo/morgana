msgid "⟪k:0⟫............"
msgstr "⟪k:0⟫............"

#: scenario7:scenario7_A85997A7_0A43_4642_A58B_D0231ACAB0AB
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 0a1536921598ab8cd503de3f30fd578b12ee1d7d27d820bd3dcb866a3f42ca81
