msgctxt "scenario7:scenario7_A61028F2_141A_4513_ADDB_0512E02AD2E5"
msgid ""
"⟪k:0⟫⟪k:1⟫The coachman left my luggage outside the door, gave me an empty farewell, and then went "
"on his way."
msgstr ""
"⟪k:0⟫⟪k:1⟫Le cocher posa mes bagages devant la porte d’entrée, me gratifia d’un au revoir convenu "
"et repartit."

#: scenario7:scenario7_3DC55A11_A712_4E8A_8838_C3E23C0B0603
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: f89bfa8a857554f9101ec11e304b00013188b8f0857c0f6d3513ab3c933ff203
