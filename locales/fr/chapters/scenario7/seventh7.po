msgid "⟪k:0⟫A putrid mire."
msgstr "⟪k:0⟫Un bourbier putride."

#: scenario7:scenario7_247A0B2C_BE61_4FB7_A7B7_DA6828C9A887
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
