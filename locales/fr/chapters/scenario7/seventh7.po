msgid "⟪k:0⟫Quite the joke..."
msgstr "⟪k:0⟫Quelle blague..."

#: scenario7:scenario7_C10A023F_4B0A_4751_8C7D_7C56438A7F74
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 3e6de2f3f16735d528ffd667b1865f6de3a2b5d693ee2e24d95f9691fe982e7c
