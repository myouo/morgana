msgctxt "scenario7:scenario7_211FFB6A_7150_4C87_A8C7_A56CC109025D"
msgid "⟪k:0⟫Water pushed out all the air, swallowing me up, suffocating me."
msgstr "⟪k:0⟫L’eau repoussait l’air, m’avalait, me faisait suffoquer."

#: scenario7:scenario7_732FDE14_8134_4626_BF16_D0C5AB7444E9
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
