msgctxt "scenario7:scenario7_C7F4B452_3CA5_46CA_949D_B73906C73C27"
msgid "⟪k:0⟫And I alone shall take comfort in your presence..."
msgstr "⟪k:0⟫Moi seul tirerai réconfort de ta présence..."

#: scenario7:scenario7_96B56A77_61D9_4AA0_BFE4_6796DF8CC00E
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: b60e5009cc3e93081cc0c064648991afdcd4246449311bf216aecc26b23a187a
