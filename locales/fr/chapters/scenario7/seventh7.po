msgctxt "scenario7:scenario7_3DC55A11_A712_4E8A_8838_C3E23C0B0603"
msgid "⟪k:0⟫I was... ⟪k:1⟫entirely alone."
msgstr "⟪k:0⟫J’étais... ⟪k:1⟫totalement seul."

#: scenario7:scenario7_482E3049_2539_49D9_B7CA_842612330E9C
