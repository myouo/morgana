msgid "⟪k:0⟫My delusional mother, for refusing to acknowledge who I was."
msgstr "⟪k:0⟫Ma mère, dans le déni, qui refusait de reconnaître qui j’étais."

#: scenario7:scenario7_968605A6_8CAD_4167_BE1D_2D7FB9BF88DC
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: b569eb7a2f109e40895b4d8972c8d965cac2537cdc2d989512f0192cc888aa01
