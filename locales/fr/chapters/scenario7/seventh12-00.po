#: scenario7:scenario7_19C8A4BC_99C1_487D_8145_8D0EA7C19F58
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 0bf2a2a4a8ec86ff0c706fcad518a69931c71965e5e3b61c4371c1c6beb9deb9
#. default-sha256: 8d6c72cdecf2c2b08b7ced5aab06103a9751a0b218d9fb41ef299264b15d537c
msgctxt "scenario7:scenario7_19C8A4BC_99C1_487D_8145_8D0EA7C19F58"
msgid ""
"⟪k:0⟫After being pierced by Didier’s blade,⟪k:1⟫⟪k:2⟫I found myself looking down upon my own "
"corpse."
msgstr ""
"⟪k:0⟫Après avoir été transpercé par la lame de Didier,⟪k:1⟫⟪k:2⟫je me retrouvai à contempler mon "
"propre corps."

#: scenario7:scenario7_80A15A9D_1B5F_42D0_A41D_B1D1F2177CA8
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: efef895e6d9c7650e40c07d959411b019f0a6a8d98f4a8e3b37e2558d03b8080
#. default-sha256: cb34a528935a4de0e9a61f8056a2725f623ae643d9b5d991ae82c20b1927dba1
msgctxt "scenario7:scenario7_80A15A9D_1B5F_42D0_A41D_B1D1F2177CA8"
msgid "⟪k:0⟫I watched as my eldest brother dragged me to the place of my crucifixion."
msgstr "⟪k:0⟫Je vis mon frère aîné me traîner jusqu’au lieu de ma crucifixion."

#: scenario7:scenario7_6BA73D07_65B7_4AFD_884C_81E2F012DF25
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 165d5c0ee602ef1bafaf140353288e56b32389b304d9b310189bade81308bac2
#. default-sha256: 92d9c49f3c425712b022d12776e342b57bacdd42fd1fb1f1accbd9c7af0f83d7
msgctxt "scenario7:scenario7_6BA73D07_65B7_4AFD_884C_81E2F012DF25"
msgid "⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫⟪k:4⟫The knights!"
msgstr "⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫⟪k:4⟫Les chevaliers !"

#: scenario7:scenario7_8B7324EA_75E9_434E_B1E0_E73B255130B5
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 6f5d39ecf6498e8e3fe4212284451c60642b5399fc45486ba37c07f5cfa8ab41
#. default-sha256: 68930b61311e1ac1eec9d16f644cd0f59d8c7e3bba4f8de103ee96889d1dafd5
msgctxt "scenario7:scenario7_8B7324EA_75E9_434E_B1E0_E73B255130B5"
msgid ""
"⟪k:0⟫The men who had come to ransack the mansion were standing there, staring at my body in awe."
msgstr ""
"⟪k:0⟫Les hommes qui étaient venus piller le manoir se trouvaient parmi eux et contemplaient, "
"emplis de crainte, mon corps."

#: scenario7:scenario7_ED90C3D4_9453_4321_A580_7F1D34EEEF7D
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: d1cf68fbf223ad52fede0429767c8f2a774769890f4f3aa1e8f5003eb3971850
#. default-sha256: a6537677d7c28c5d46e0e361f0a63345d31992dbab4d5efedda0e18fd3805120
msgctxt "scenario7:scenario7_ED90C3D4_9453_4321_A580_7F1D34EEEF7D"
msgid ""
"⟪k:0⟫Ahh, the Lord’s judgment has been delivered unto the witch of the cursed mansion by His holy "
"servants."
msgstr ""
"⟪k:0⟫Ahh, le Seigneur a jugé la sorcière du manoir maudit par l’intermédiaire de Ses saints "
"serviteurs."

#: scenario7:scenario7_9A1A1486_1AC2_4F6B_93BF_65F63A063C83
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 75a46aaf5d0bb39d39c7b5372cc03b96f74a4ce6fcabde66d3825865abbdd202
#. default-sha256: 3e959e2f78d4d241f93e30d537e4a3ee5086afa63c0a860398dedc3f7989bee2
msgctxt "scenario7:scenario7_9A1A1486_1AC2_4F6B_93BF_65F63A063C83"
msgid ""
"⟪k:0⟫We have assembled all the tools you need to execute your divine mission. ⟪k:1⟫A cross, "
"befitting of such a heinous sinner!"
msgstr ""
"⟪k:0⟫Nous avons rassemblé tous les outils nécessaires pour l’exécution de votre divine mission. "
"⟪k:1⟫Une croix, pour une pécheresse aussi odieuse !"

#: scenario7:scenario7_71CEAC7F_E583_49D1_AD46_B531CE5EA92D
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 4b2ff3ca0cd537f6108c7ab4233f9591f7d3be0e88ef4727c7de4b69747487ce
#. default-sha256: cef13407b9fbf9496e294f25c8f64c0f3e653f8b3563e7229b0625cc2367d0c7
msgctxt "scenario7:scenario7_71CEAC7F_E583_49D1_AD46_B531CE5EA92D"
msgid "⟪k:0⟫That witch threatened to curse us!⟪k:1⟫⟪k:2⟫Sullied our pure ears with its blasphemy!"
msgstr ""
"⟪k:0⟫Cette sorcière a menacé de nous maudire !⟪k:1⟫⟪k:2⟫Elle a souillé nos oreilles vertueuses de "
"son blasphème !"

#: scenario7:scenario7_C92DCB1B_C140_4C09_A9F4_4E152AD3CBD0
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 030d484cad387f82dd7b6e4a509604a64ec8fa47c7952bec30b49811fa7bd6e5
#. default-sha256: 8ac2085de992c031db83668ca33cb2511354a234ecefc342b5e244e2cde929a6
msgctxt "scenario7:scenario7_C92DCB1B_C140_4C09_A9F4_4E152AD3CBD0"
msgid ""
"⟪k:0⟫I had done no such thing...⟪k:1⟫⟪k:2⟫I hadn’t cursed anyone.⟪k:3⟫⟪k:4⟫I had merely been "
"defending myself..."
msgstr ""
"⟪k:0⟫Je n’avais rien fait de tel...⟪k:1⟫⟪k:2⟫Je n’avais maudit personne.⟪k:3⟫⟪k:4⟫Je n’avais fait "
"que me défendre..."

#: scenario7:scenario7_01CDD73C_7009_4BF2_A713_A9D75E21BF1C
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 17365ab716270c5eb2e16f51cd3b3ffd519ca74f5637cf4d5f8912c3898a266d
#. default-sha256: 62ac0434c2c36fc5a297a0a6eb8379edccdf59c6d267f4295be71b22e1305a96
msgctxt "scenario7:scenario7_01CDD73C_7009_4BF2_A713_A9D75E21BF1C"
msgid ""
"⟪k:0⟫They had been armed and outnumbered me...⟪k:1⟫⟪k:2⟫so I had said what was necessary to chase "
"them off."
msgstr ""
"⟪k:0⟫Ils étaient venus armés, bien supérieurs en nombre...⟪k:1⟫⟪k:2⟫...donc j’avais dit ce qu’il "
"fallait pour les repousser."

#: scenario7:scenario7_9F09D42E_C560_4E6C_85CC_E1446F093B6E
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: eb7dc55818dc4fb67c615d92e567580017b34a9ae623f84652532ca1b8a0e1ec
#. default-sha256: d4ff336c95f41f51b4014907a96ec0208343086fff4526a82dc8bd42b1bef33d
msgctxt "scenario7:scenario7_9F09D42E_C560_4E6C_85CC_E1446F093B6E"
msgid ""
"⟪k:0⟫Our poor harvest and our suffering at the hands of the greedy lord were all the work of the "
"witch!"
msgstr ""
"⟪k:0⟫Notre maigre récolte et nos souffrances causées par un seigneur cupide ont été toutes deux "
"ourdies par la sorcière !"

#: scenario7:scenario7_95CFA38E_6A0D_45D8_AC57_B18FBA96D197
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 3bb0e48f980b17007243fb8893603a2f7822eded6b8f057bc3305d6e1d9073a2
#. default-sha256: 492f047bfdce014ac5d6bea49dbd4e9517b134078a0bec3894fcb71325c84cfd
msgctxt "scenario7:scenario7_95CFA38E_6A0D_45D8_AC57_B18FBA96D197"
msgid "⟪k:0⟫So I prayed. ⟪k:1⟫I asked God to grant me the smallest of miracles."
msgstr ""
"⟪k:0⟫Je priai donc. ⟪k:1⟫Je priai Dieu de m’accorder ne serait-ce que le plus infime des miracles."

#: scenario7:scenario7_033A2315_AC2C_41C2_8315_A7996EA3E827
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: fb8f70c4b93d9983947b768c9646a71632b895d3a0d4285e82c6b46158f64801
#. default-sha256: c9d8e9d36a4cd3df34c17ad2c405f6d1c7592e561bd72983cc4a63f03393753a
msgctxt "scenario7:scenario7_033A2315_AC2C_41C2_8315_A7996EA3E827"
msgid "⟪k:0⟫To let my voice reach my brother, who carried my body."
msgstr "⟪k:0⟫De faire en sorte que ma voix atteigne mon frère, qui portait mon corps."

#: scenario7:scenario7_3862AE0C_464A_4525_8ECB_6E3291ABEB35
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: b6fe9319a81ef672a8d6d448847035afc63618a19c8f066313f0ba4b0864b976
#. default-sha256: 21cf35ccd647e4e7feb4f58c038b964beefeaef7f854c2b691521c6cd6a68428
msgctxt "scenario7:scenario7_3862AE0C_464A_4525_8ECB_6E3291ABEB35"
msgid "⟪k:0⟫You know me better than that...⟪k:1⟫⟪k:2⟫You know I’ve done nothing wrong..."
msgstr "⟪k:0⟫Tu me connais mieux que ça...⟪k:1⟫⟪k:2⟫Tu sais que je n’ai rien fait de mal..."

#: scenario7:scenario7_D009FECC_2960_47A6_8DA6_F92E9871462F
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 90754f9b9c017845db8a15c8473418720faf933d9916ee319833952d1be37657
#. default-sha256: 0843fe1967d0dae8f3a6a53d7ce50bc1e1d0594fb6a22870dbefba30fc8c655b
msgctxt "scenario7:scenario7_D009FECC_2960_47A6_8DA6_F92E9871462F"
msgid ""
"⟪k:0⟫Those men smirking at the sight of my body...⟪k:1⟫⟪k:2⟫they’re the ones putting the blame "
"for their sins on me..."
msgstr ""
"⟪k:0⟫Ces hommes qui ricanent à la vue de mon corps...⟪k:1⟫⟪k:2⟫...ce sont eux qui rejettent leurs "
"propres péchés sur moi..."

#: scenario7:scenario7_00B923A4_C9C9_4378_986A_F8838E238D0B
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 1a5b815c951269a2ca887869578e28289d6120d0ec60cb584ba17b8a8e307009
#. default-sha256: ca213caa4b487825c6cf793cbcdf72c1e3fb610a0e733ecd1f99a58cf19fa384
msgctxt "scenario7:scenario7_00B923A4_C9C9_4378_986A_F8838E238D0B"
msgid "⟪k:0⟫then surely ⟪k:1⟫you⟪k:2⟫ can give me a respectable burial..."
msgstr "⟪k:0⟫alors tu peux bien, ⟪k:1⟫toi⟪k:2⟫, me donner une sépulture décente..."

#: scenario7:scenario7_B29EA92E_1B87_454B_8F71_08A903F801C9
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: eb43237bf6a6024ee8c8ecb1adc81f4184af1187ef0b79db00a3ad6fc2018aa9
