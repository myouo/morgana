msgid "⟪k:0⟫............"
msgstr "⟪k:0⟫............"

#: scenario7:scenario7_811B82B8_CEB2_4DEE_AEBD_1FA47DD3DB02
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 05f791d2aa3b3841d2f5284fc2508ad6d4292fee1891d4321ed0895b46e573f5
#. default-sha256: e8341c0da68b11ac086ca8bff3e9d0f9dd2cc700389e59f2ef647262510a50d6
msgctxt "scenario7:scenario7_811B82B8_CEB2_4DEE_AEBD_1FA47DD3DB02"
msgid "⟪k:0⟫Why do you say nothing?"
msgstr "⟪k:0⟫Pourquoi tu ne dis rien ?"

#: scenario7:scenario7_EA47D360_0BC7_473A_B649_CFC04349B927
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 976cb4ad27f076e81c60aaa0be2915d3dff3697a71734b13ad0beb05f7a476ef
#. default-sha256: f9f1ae0d20c92b7de2009a39e2ca409b8b33a8573661c9e6c10afc43bf2fc139
msgctxt "scenario7:scenario7_EA47D360_0BC7_473A_B649_CFC04349B927"
msgid "⟪k:0⟫Why do you accept the tools this man presents you—"
msgstr "⟪k:0⟫Pourquoi tu acceptes les outils que l’homme te tend—"

#: scenario7:scenario7_E6DB3BE6_2FD3_48F8_9DB3_67C9E599D0B8
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: d305ee7856b7fdd19e1ad848a26cc98ad449c1d3566412a7acbb2a90f2c8d759
#. default-sha256: 566538c24ccc436145eaaff494d7a63c78904c2edad3c7fe921ece3d95e2f3a2
msgctxt "scenario7:scenario7_E6DB3BE6_2FD3_48F8_9DB3_67C9E599D0B8"
msgid "⟪k:0⟫tools meant to punish me?"
msgstr "⟪k:0⟫les outils servant à me punir ?"

#: scenario7:scenario7_5B464F04_9A92_4579_8C51_EC91CD240255
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 52b8599cdfd94442e1f3aea351ab28b593beb56a81e0804fc04eb964f5f894a5
#. default-sha256: ef01a9b70879fb83226895440eec7b76555804154da063a4bf036f6650b73fc2
msgctxt "scenario7:scenario7_5B464F04_9A92_4579_8C51_EC91CD240255"
msgid "⟪k:0⟫Tell me, Didier..."
msgstr "⟪k:0⟫Dis-moi, Didier..."

#: scenario7:scenario7_12D6FB59_6A51_4848_942F_F4928D9277D5
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: e559017002a917b789b387372fe56f3c1e7255a2a6f52015ef690ae447fb7111
#. default-sha256: 670e92e2c00494ec2c78e5f6f4951115a458da9f423c35350be03ebb014d9958
msgctxt "scenario7:scenario7_12D6FB59_6A51_4848_942F_F4928D9277D5"
msgid "⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫Crucify the witch!"
msgstr "⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫Crucifiez la sorcière !"

#: scenario7:scenario7_06E89998_6C35_4344_BE0B_EE8EF13FA4D4
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: eb073b10644dbc3d0d8cf8466009630bd8a27e5500e1a15f7662fc8f2dae53b9
#. default-sha256: 8be84a62bb4d8375fc101ff84d4d81651ed9ad85dcf7215b6347fb923b8e9202
msgctxt "scenario7:scenario7_06E89998_6C35_4344_BE0B_EE8EF13FA4D4"
msgid ""
"⟪k:0⟫Please, anything but that... ⟪k:1⟫I’m begging you...⟪k:2⟫⟪k:3⟫don’t expose me to these "
"people..."
msgstr ""
"⟪k:0⟫Je t’en prie, tout sauf ça... ⟪k:1⟫Je t’en supplie...⟪k:2⟫⟪k:3⟫Ne m’expose pas devant tous "
"ces gens..."

#: scenario7:scenario7_1281D409_8BEB_4CAE_888D_48DFD6D3CBC6
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: a8c5355aac175fbf04637a715a2c3655610b995977725841a3d7cc0f708e8eb5
#. default-sha256: 2f3e6d19bd7d3c200947376c2bba1d1799f208e1ceacea8ae25bbe02f25b1d76
msgctxt "scenario7:scenario7_1281D409_8BEB_4CAE_888D_48DFD6D3CBC6"
msgid "⟪k:0⟫Don’t expose my body, Didier!"
msgstr "⟪k:0⟫N’expose pas mon corps, Didier !"

#: scenario7:scenario7_CF06DD32_7A5D_48DC_AA4A_7BDD93E968AC
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 32e4d86457913b10e84e94349e9ad6f331ec4b53a4261c106e7430691dadcb95
#. default-sha256: f5605140a9daa7961ba3dfa3b496eac02825afa37ec1b1a44adca18edc7557e9
msgctxt "scenario7:scenario7_CF06DD32_7A5D_48DC_AA4A_7BDD93E968AC"
msgid "⟪k:0⟫I’m begging you—"
msgstr "⟪k:0⟫Je t’en supplie—"

#: scenario7:scenario7_D05EA808_47E5_4593_A6B0_973EFD32CE3F
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: c7af523be474a778d5fbbd9ea43b632297cf823fc3c879cc704e278079c08a2a
#. default-sha256: b51f5ad6b33a38caedd5dbe8f5dfad500ffbff6fac2e394959701d0e16c7529c
msgctxt "scenario7:scenario7_D05EA808_47E5_4593_A6B0_973EFD32CE3F"
msgid ""
"⟪k:0⟫But of course, my voice had no way of reaching him,⟪k:1⟫⟪k:2⟫and he proceeded to remove my "
"clothing, piece by piece,"
msgstr ""
"⟪k:0⟫Mais, bien entendu, ma voix ne pouvait pas l’atteindre,⟪k:1⟫⟪k:2⟫et il continua à m’ôter mes "
"habits, l’un après l’autre,"

#: scenario7:scenario7_1DCF0803_C04F_40B6_958E_B00ADB3E0CED
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 8ffb2c74ef8bc9d23be4401082e562ea4a57980d2256cbb5cba1f162268f7851
#. default-sha256: 0509eb1b1b79ab9752ae39cfb35dfaf7136fae95de69eb7489b8f9ca2be1b0a2
msgctxt "scenario7:scenario7_1DCF0803_C04F_40B6_958E_B00ADB3E0CED"
msgid "⟪k:0⟫until I was left fully nude."
msgstr "⟪k:0⟫jusqu’à ce que je sois entièrement nu."

#: scenario7:scenario7_8239D993_E4CC_494D_AE65_0BC3127CD6EC
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: f3ea0bec25eefa3ad4d2b9920a262720b8e6f943604dc1fb911e10c1d44f8dbc
#. default-sha256: ebaf5ae808a6af062d41db06afe8391346cd81bd2baf8db2d88c8326a00e78d8
msgctxt "scenario7:scenario7_8239D993_E4CC_494D_AE65_0BC3127CD6EC"
msgid "⟪k:0⟫And then, with a mocking laugh, one man spoke,"
msgstr "⟪k:0⟫Puis, un homme partit d’un rire moqueur et s’exclama :"

#: scenario7:scenario7_90C9BCAA_38F4_4491_BFFE_F74F8614A885
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 577193a4acc3c29114c89a7a39a9f207ea0ac3a2ddc9431d52a6378b23170c04
#. default-sha256: 1f092b646451f439b3fc81d3bea3d9dff9eba2549b2c5d069df77fb6bc58f64a
msgctxt "scenario7:scenario7_90C9BCAA_38F4_4491_BFFE_F74F8614A885"
msgid "⟪k:0⟫Ahh, so there it is... ⟪k:1⟫the devilish creature."
msgstr "⟪k:0⟫Ahh, la voilà donc... ⟪k:1⟫la créature diabolique."

#: scenario7:scenario7_25AEB98A_D52B_4761_915D_8DA07D7F283F
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: e98fd639b976abc32eeeffcb52399d06ee6f80726b5a064a221c610af0ddac17
