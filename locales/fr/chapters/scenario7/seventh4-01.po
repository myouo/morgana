#: scenario7:scenario7_2917C442_2C2F_4A42_8209_D81D50F57791
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: a16a6d7b1d79bc8eabd828b24d755c8607eff8113fa8e2ec3cdc5597ee10eeb0
#. default-sha256: 29c5308a70601551d19a3a6805f2f1973e1a3ae249fbbe727300ade51c891a82
msgctxt "scenario7:scenario7_2917C442_2C2F_4A42_8209_D81D50F57791"
msgid ""
"⟪k:0⟫The only time the routine changed was when, on occasion, a servant would arrive bearing a "
"letter."
msgstr ""
"⟪k:0⟫Parfois, un serviteur venait m’apporter une lettre : c’était le seul événement qui pouvait "
"interrompre ma routine."

#: scenario7:scenario7_A27261B4_309E_4583_92FE_6917A44D1D9F
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: bdb7858529af3ae5c28b5dae23c8151688486edf4d7859679e90dc8f300801c7
#. default-sha256: c2de6f953cd025fc9fa64aede8ab3bd7481c18480fb3e3b217c32df6acf49c1a
msgctxt "scenario7:scenario7_A27261B4_309E_4583_92FE_6917A44D1D9F"
msgid "⟪k:0⟫She demanded I speak like a girl, and I didn’t have the strength to defy her."
msgstr ""
"⟪k:0⟫Elle exigeait que je parle comme une fille et je ne me sentais pas la force de lui tenir "
"tête."

