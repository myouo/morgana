#: scenario7:scenario7_090A51F1_861C_4F72_B0D5_474947B3F7E3
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 7b60fa3887d838947de80b556b2c1eefa3a34f1d93a2bca236cf16d1fc6f43f3
#. default-sha256: deecaea93228172f747504f6189915e00d3fefbf003dba4f4f2a936e65c6a770
msgctxt "scenario7:scenario7_090A51F1_861C_4F72_B0D5_474947B3F7E3"
msgid ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫⟪k:4⟫⟪k:5⟫⟪k:6⟫⟪k:7⟫⟪k:8⟫⟪k:9⟫⟪k:10⟫⟪k:11⟫⟪k:12⟫⟪k:13⟫⟪k:14⟫⟪k:15⟫⟪k:16⟫⟪k:17⟫"
"⟪k:18⟫⟪k:19⟫⟪k:20⟫⟪k:21⟫⟪k:22⟫...And so, my life came to an end."
msgstr ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫⟪k:4⟫⟪k:5⟫⟪k:6⟫⟪k:7⟫⟪k:8⟫⟪k:9⟫⟪k:10⟫⟪k:11⟫⟪k:12⟫⟪k:13⟫⟪k:14⟫⟪k:15⟫⟪k:16⟫⟪k:17⟫"
"⟪k:18⟫⟪k:19⟫⟪k:20⟫⟪k:21⟫⟪k:22⟫...C’est ainsi que ma vie arriva à son terme."

#: scenario7:scenario7_5D8C55D5_BF96_41AE_A46B_B7820CB71569
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 457cd51f58831a5eaaa2304c5c987c230521a868e41312187366710e4453f38c
#. default-sha256: 46b7666e5a404e26a580b4c473cd272e65aa911ea279a0c75adf956fbd325699
msgctxt "scenario7:scenario7_5D8C55D5_BF96_41AE_A46B_B7820CB71569"
msgid "⟪k:0⟫But that wasn’t the end of the story."
msgstr "⟪k:0⟫Mais ce n’est pas la fin de l’histoire."

#: scenario7:scenario7_C51746E0_7E56_4329_86EF_EDB666693DA2
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: f078b5fa4696348879990adf5be306d99614038533e5ed0985962f6ad897e695
#. default-sha256: 4e68965c32de2ef4bc340fde259d9b3cafe15225dcf3fe8bbf8d433019b381e0
msgctxt "scenario7:scenario7_C51746E0_7E56_4329_86EF_EDB666693DA2"
msgid ""
"⟪k:0⟫I don’t know if what comes next could be called “my” story,⟪k:1⟫⟪k:2⟫but memories of these "
"events linger in my soul."
msgstr ""
"⟪k:0⟫Je ne sais pas si on peut appeler ce qui suit « mon » histoire,⟪k:1⟫⟪k:2⟫mais les souvenirs "
"de ces événements persistent dans mon âme."

#: scenario7:scenario7_3DE6F1A1_7E45_4823_BB18_DFE93D6A6332
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: b2f2a66ee9388472cc5dfe50fdcb53b1ab52b75558ea6ad90a4a5bba66dcb46e
#. default-sha256: 1803d7eff824d0af95c203f48f905da6f3c35f2033bc8e93ca703a780e1aa1e9
msgctxt "scenario7:scenario7_3DE6F1A1_7E45_4823_BB18_DFE93D6A6332"
msgid ""
"⟪k:0⟫How could I have ever imagined...⟪k:1⟫⟪k:2⟫that I would be made to witness my own misery "
"even in death?"
msgstr ""
"⟪k:0⟫Comment aurais-je pu un jour imaginer...⟪k:1⟫⟪k:2⟫...que je serais le témoin de ma propre "
"misère jusque dans la mort ?"

#: scenario7:scenario7_8C20439B_C5B4_4D4A_AFAB_5CCD52C9ED90
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 4682c7a0e19bd25c9acbff6bfa9bd3fcb7700de0b32e27c14598f003c029812a
#. default-sha256: 39b8a5cedb53e51344206b6cbeeeabc8ea64732917d226e5f540a390c46826f8
msgctxt "scenario7:scenario7_8C20439B_C5B4_4D4A_AFAB_5CCD52C9ED90"
msgid "⟪k:0⟫And my soul—⟪k:1⟫⟪k:2⟫evidently still bound to my flesh—"
msgstr "⟪k:0⟫Et mon âme —⟪k:1⟫⟪k:2⟫ de toute évidence toujours reliée à mon corps —"

#: scenario7:scenario7_A3D92C5D_C2DD_4CE0_8512_FCF7FE870B04
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 19f183276a790f31e62b4281a125a0813eb29f4595f0b09c4b9b82bdb4d3be7b
#. default-sha256: 44b636ee435b27c3ac7e0742a149c564a4185532d99281960e11ab28108d9251
msgctxt "scenario7:scenario7_A3D92C5D_C2DD_4CE0_8512_FCF7FE870B04"
msgid "⟪k:0⟫was dragged along with it, against my will, down to the nearby village."
msgstr "⟪k:0⟫fut traînée de même, contre mon gré, jusqu’au village en contrebas."

#: scenario7:scenario7_E61D0C8B_E817_4C49_8BCD_986BDDA99580
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: f61e204042bd68409529abde8eb4fa3b8e5663bd1dd910b95f0aca1b4add0bb2
#. default-sha256: 150a14fdc45a63cde3a6d8d6ca25244bee53b1241cff40b7c7b14c6f26b3bbdf
msgctxt "scenario7:scenario7_E61D0C8B_E817_4C49_8BCD_986BDDA99580"
msgid "⟪k:0⟫⟪k:1⟫The knights have returned from their holy quest!"
msgstr "⟪k:0⟫⟪k:1⟫Les chevaliers sont revenus de leur quête sacrée !"

#: scenario7:scenario7_4BC5D94C_29C0_4512_8464_CFCAC63C2BC4
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 7658a10b09d9fe27b0d8a664f84725bd6421cd4b7bf80b0d6cad0c124a395887
#. default-sha256: 95fb0cc00cd94d55d11545546cec9252765369b2559224a22d04443ab2bed22f
msgctxt "scenario7:scenario7_4BC5D94C_29C0_4512_8464_CFCAC63C2BC4"
msgid "⟪k:0⟫⟪k:1⟫Oh, how we’ve awaited your arrival!"
msgstr "⟪k:0⟫⟪k:1⟫Oh, comme nous attendions votre retour !"

#: scenario7:scenario7_CB3ED887_927B_45F4_AD8F_4F1D0214AA0F
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: efd6b3bb06daa0215a2444a0a6891570b38a355618b366b640110bda1e80701c
#. default-sha256: d2d0d6097a6890c41a2a104ac464faa5556d35e3253dc90231580c1a8eca55e8
msgctxt "scenario7:scenario7_CB3ED887_927B_45F4_AD8F_4F1D0214AA0F"
msgid "⟪k:0⟫⟪k:1⟫How glorious it is to see you!"
msgstr "⟪k:0⟫⟪k:1⟫Quelle joie de vous voir !"

#: scenario7:scenario7_1E29A1D1_0BEE_452D_97A6_C04B078CD2D4
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 543ae882e821846d25190ade50eb8a84dac20c1216b5c33a22f28a47354564b1
#. default-sha256: a7e8259010c13a79cc7f1bd0847ea8470e3b02f9d625549a6e53132fcab8e676
msgctxt "scenario7:scenario7_1E29A1D1_0BEE_452D_97A6_C04B078CD2D4"
msgid ""
"⟪k:0⟫Waiting for us there was a cluster of villagers.⟪k:1⟫⟪k:2⟫A large cross lay on the ground in "
"the center of the square."
msgstr ""
"⟪k:0⟫Là nous attendait un petit groupe de villageois.⟪k:1⟫⟪k:2⟫Une grande croix gisait au sol au "
"centre de la place."

#: scenario7:scenario7_A1924AEC_E6D6_462F_BDE5_51024E31F01B
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 271d9d3a902bb1af83b21c53e837f1338c94e06c1a9a025058051f48f3b2bc50
#. default-sha256: 4c9c09065e49c013aad8c058c333aa7e3d55e5c4028fdbc298dd7e62a0c8c2da
msgctxt "scenario7:scenario7_A1924AEC_E6D6_462F_BDE5_51024E31F01B"
msgid ""
"⟪k:0⟫Holding torches, they formed a crowd around the knights, several of them familiar faces."
msgstr "⟪k:0⟫Torches en main, ils entourèrent les chevaliers ; j’en reconnus quelques-uns."

#: scenario7:scenario7_F52A9436_A594_40DB_8213_25E1D487198D
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: e0054a583de290e41db91da184d2ee63cd0ae13171529a30017a1aaf38ee7e99
#. default-sha256: f58f74b3b7fb004ae6cf73f6c839e74f37432fcc9d4a695178c08132280017be
msgctxt "scenario7:scenario7_F52A9436_A594_40DB_8213_25E1D487198D"
msgid ""
"⟪k:0⟫No longer shall we live in fear of the curse befalling us!⟪k:1⟫⟪k:2⟫Eternal peace is assured!"
msgstr ""
"⟪k:0⟫Nous ne vivrons plus dans la peur qu’une malédiction ne s’abatte sur nous !⟪k:1⟫ La paix "
"éternelle est assurée !"

#: scenario7:scenario7_16B2FCE2_C477_4BD9_8C7D_E88D8A4AF579
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 76f31b22a3794719541c01fbf86eeb5a90e7697725d4715093757caa90a8d178
#. default-sha256: 62b5a3eb7b1199211beba64bd440508c747d5024b60224ea10b3d45ea35c406e
msgctxt "scenario7:scenario7_16B2FCE2_C477_4BD9_8C7D_E88D8A4AF579"
msgid "⟪k:0⟫Why, then... ⟪k:1⟫were they acting like I was at fault?"
msgstr "⟪k:0⟫Alors, pourquoi... ⟪k:1⟫est-ce qu’ils se comportaient comme si c’était de ma faute ?"

#: scenario7:scenario7_4CEDA84C_E7DE_4F7A_8E6C_4075FF9ED2EC
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 9dd474e682bbe271d649c592fedabe4e58f214d5a682619d26dbcab90295b411
#. default-sha256: 1a3cc4a10b0bd48a9198d845cae13dda34085cc7ddb0cd0d09da9c66972ee38a
msgctxt "scenario7:scenario7_4CEDA84C_E7DE_4F7A_8E6C_4075FF9ED2EC"
msgid "⟪k:0⟫Why was I the sinner, and why did I need to be judged?"
msgstr "⟪k:0⟫Pourquoi étais-je le pécheur, et pourquoi avais-je besoin d’être jugé ?"

#: scenario7:scenario7_2A266E31_4BB9_464A_9B6B_7551BF55087C
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: c59d7d2cdfbb7213ca455a704233b422b1887a0e958d6cb023f51a0e7b79b73f
#. default-sha256: 436c1d316ecea5c6dfb1d0befb0a7c03ea859c5a3078091075b01262381fbdbb
msgctxt "scenario7:scenario7_2A266E31_4BB9_464A_9B6B_7551BF55087C"
msgid ""
"⟪k:0⟫My soul trembled at the overwhelming fervor consuming the crowd, ⟪k:1⟫their zealous desire "
"to see judgment cast."
msgstr ""
"⟪k:0⟫Mon âme tremblait en constatant la ferveur grandissante qui s’emparait de la foule, ⟪k:1⟫"
"leur désir exalté d’assister au châtiment."

#: scenario7:scenario7_4055B4D2_8A2F_48DF_801C_6AA7C0D5ADC8
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 19a9a55e1aea6ddc37aa3dc2389a66680549bd7f4e6da6627caa2c8deb2ba693
#. default-sha256: 916d58b4964a0aa83399ace09555ce05e1f624b3341e4ee2be5f980a20b9cb7b
msgctxt "scenario7:scenario7_4055B4D2_8A2F_48DF_801C_6AA7C0D5ADC8"
msgid "⟪k:0⟫Please don’t do this, Didier...⟪k:1⟫⟪k:2⟫Please, hear my voice..."
msgstr "⟪k:0⟫S’il te plaît ne fais pas ça, Didier...⟪k:1⟫⟪k:2⟫S’il te plaît, entends ma voix..."

#: scenario7:scenario7_90CACC1B_FB5C_4F6A_A11B_C62ACBF86CA5
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 8061063210992b1ef0b1763b8c59f5636d171a0ad8c5ffc66bb85fe6dea48e54
#. default-sha256: 957f446f716204aa3bda2d5e8b043e3603c259c7ac76e6d6d18e26d2d657b243
msgctxt "scenario7:scenario7_90CACC1B_FB5C_4F6A_A11B_C62ACBF86CA5"
msgid "⟪k:0⟫Please, tell me ⟪k:1⟫you⟪k:2⟫, at least, don’t think I did those things..."
msgstr ""
"⟪k:0⟫Je t’en prie, dis-moi que ⟪k:1⟫toi⟪k:2⟫, au moins, tu ne penses pas que j’aie fait ça..."

#: scenario7:scenario7_1809491C_BCB6_4470_BD73_A9E1B6453A66
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 36e751cd4c7809914e70afbbd23732b39e3d0d04ee7359438cd5e9ab4812cff4
#. default-sha256: e738834e2064c00d31b7c8805d6229c114f6857919c09025427351d9f3d2dd8c
msgctxt "scenario7:scenario7_1809491C_BCB6_4470_BD73_A9E1B6453A66"
msgid "⟪k:0⟫Don’t put me on that cross...⟪k:1⟫⟪k:2⟫If it was Mother who sold me out to the Church,"
msgstr ""
"⟪k:0⟫Ne me mets pas sur la croix...⟪k:1⟫⟪k:2⟫Si c’est Mère qui m’a vendu à l’⟪k:3⟫É⟪k:4⟫glise,"

#: scenario7:scenario7_748FDB2D_891F_4063_B06B_CA7A27FC96BC
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 98d451effa2df32ce93785b14498c55d542483d262485d041fe5617a885f8870
#. default-sha256: 67ce7a9f0108c9ea6f12ff2a16eabf9586a7b143f42969440007b5bbe2f20351
msgctxt "scenario7:scenario7_748FDB2D_891F_4063_B06B_CA7A27FC96BC"
msgid ""
"⟪k:0⟫The nails and rope for the crucifixion are here.⟪k:1⟫⟪k:2⟫We would have you, O knight, "
"deliver the Lord’s judgment unto this vile witch!"
msgstr ""
"⟪k:0⟫Voici les clous et la corde pour la crucifixion.⟪k:1⟫⟪k:2⟫⟪k:3⟫À⟪k:4⟫ vous, ô chevalier, "
"d’administrer le châtiment du Seigneur à cette vile sorcière !"

#: scenario7:scenario7_FE7C6CF8_459E_46AF_AA1C_47F64264FA6A
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: e761ec92b58307cb53f49c6def1221e9b298f3525f40d5c2cb6351e2054a79f2
#. default-sha256: a6fc38a7f31336ab0dfe274f49400ee31590f8ecd73f8fcd2d478a03b056f55c
msgctxt "scenario7:scenario7_FE7C6CF8_459E_46AF_AA1C_47F64264FA6A"
msgid "⟪k:0⟫Didier..."
msgstr "⟪k:0⟫Didier..."

#: scenario7:scenario7_83319B1E_A3C6_4451_9E94_294CD95D46DE
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 9236cfa7b95666219144a0ca15f6daf7f1970441e73f8f6fe3dff8d84592ec8a
#. default-sha256: 67455896f74b4e9a88819ffa59f647dee0c53296510eeb755c14ec7a30e297e3
msgctxt "scenario7:scenario7_83319B1E_A3C6_4451_9E94_294CD95D46DE"
msgid "⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫Crucifixion!"
msgstr "⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫Crucifixion !"

#: scenario7:scenario7_4307D535_FE8B_4BE6_BCDC_93F1F1C3CF34
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: baf1a6695d27630d0cf7085fea57b9905df10fc2d08fd91cb1b521a5a08aafe5
#. default-sha256: cd1248349b39a9662cb583d382128bbf7185c3889b2fc61ae2c7c50f724e6f8f
msgctxt "scenario7:scenario7_4307D535_FE8B_4BE6_BCDC_93F1F1C3CF34"
msgid "⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫Crucify it!"
msgstr "⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫Crucifiez-la !"

#: scenario7:scenario7_BE5EED1B_42A0_45A3_A6C7_15DD67C76C1B
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 8364dec72652dfe672bd1ecf9afb0c2ccc57f2bcae007a7ad6175700265f2181
#. default-sha256: 52c926ace6bf5a38db144692418ff3b6baabc212584a2deea92b35616feba00a
msgctxt "scenario7:scenario7_BE5EED1B_42A0_45A3_A6C7_15DD67C76C1B"
msgid ""
"⟪k:0⟫My brother lowered my corpse to the ground and began removing my clothing, ⟪k:1⟫and in that "
"very moment, I realized the purpose of hanging someone from a cross."
msgstr ""
"⟪k:0⟫Mon frère posa mon corps à terre et commença à retirer mes vêtements. ⟪k:1⟫C’est à ce moment "
"précis que je compris le vrai but de l’exposition d’un corps sur une croix."

#: scenario7:scenario7_B88FDF38_E3ED_4B5C_B13B_53B336DCF166
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: e31f94407401d6821e05d80aac4c29b566d0965723a7a12a534b71e03630fc67
#. default-sha256: 48cc2d5f62ef95b7f22ddd190bd9180f776cd5892ecc31ae7868f2fbde4aaabd
msgctxt "scenario7:scenario7_B88FDF38_E3ED_4B5C_B13B_53B336DCF166"
msgid "⟪k:0⟫Overwhelmed by hopelessness, tears streamed down my face."
msgstr "⟪k:0⟫Submergé par le désespoir, je sentis des larmes couler le long de mes joues."

#: scenario7:scenario7_F330EC48_B442_43BB_867C_F9A5674ECE91
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 993201a5068bec30914c5440f167a566eed9c379692210b2916a469e5f5212bb
#. default-sha256: 11bc6ebbc65646a76d97e55b38d3be52fa64433cb52e54e78d58074f24a1ea89
msgctxt "scenario7:scenario7_F330EC48_B442_43BB_867C_F9A5674ECE91"
msgid "⟪k:0⟫don’t do it!"
msgstr "⟪k:0⟫ne le fais pas !"

#: scenario7:scenario7_BFF95DC4_C5B9_4167_A118_3B8955B2FC84
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: cfdb7a552ba5c8ce01a4fce6cda4312d4d0502d9f499d5c65f224c2691bfdbb1
#. default-sha256: 0c8a377376753384641cf0d9433cbcb74c2f5e6dc8ed8651a1485753a9e5d841
msgctxt "scenario7:scenario7_BFF95DC4_C5B9_4167_A118_3B8955B2FC84"
msgid ""
"⟪k:0⟫For a brief moment, an unpleasant silence spread through the crowd. ⟪k:1⟫The erratic "
"crackling of their torches was the only sound that could be heard in the square."
msgstr ""
"⟪k:0⟫Pendant un bref instant, un silence désagréable parcourut la foule. ⟪k:1⟫On n’entendait plus "
"sur la place que le bruit intermittent des torches qui crépitaient."

#: scenario7:scenario7_00E0D90C_518C_432E_A046_E7253A8B1690
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: b022d7ed062335ca97c637f0f6691984f74bb384f95c6f521b1f524cc0ced8c4
