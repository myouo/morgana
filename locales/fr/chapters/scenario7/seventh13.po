msgid "⟪k:0⟫⟪k:1⟫...Your point being?"
msgstr "⟪k:0⟫⟪k:1⟫...Où veux-tu en venir ?"

#: scenario7:scenario7_65F55687_47CA_44BB_9241_F618C7BEA063
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 644a151a8a9babc22178da9cf8e6afcbe858b1ba415b3c35d8df7edb509cb9aa
