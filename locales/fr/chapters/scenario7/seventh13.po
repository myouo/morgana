msgctxt "scenario7:scenario7_B0E88E04_7456_4076_8BFF_6E0903327CD8"
msgid "⟪k:0⟫⟪k:1⟫Well, I can’t say I blame you.⟪k:2⟫⟪k:3⟫Who would believe the word of a witch?"
msgstr ""
"⟪k:0⟫⟪k:1⟫Eh bien, je ne peux pas te jeter la pierre.⟪k:2⟫⟪k:3⟫Qui irait croire les paroles d’une "
"sorcière ?"

#: scenario7:scenario7_2BB206BC_7DCE_4FD5_8EBA_918311D467A4
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 93f72c781ca40ea00587425ec212e367fecd0d5c632152381d0854be2bf1ccbf
