#: scenario7:scenario7_CDE966D8_424B_449D_BDB0_A302D8A9E8BE
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 22867730dfa6b4d22773f77ea8ebdaa8413ff922f33e5e962deab9975efb6f72
#. default-sha256: 304eb9b9c26a6b3f30fe417f69de159a8c66a016a126ada0e788adcaa4f0a411
msgctxt "scenario7:scenario7_CDE966D8_424B_449D_BDB0_A302D8A9E8BE"
msgid ""
"⟪k:0⟫I’m looking at neither the endless, eroding darkness, nor the visions of my past, ⟪k:1⟫but "
"the sea of blood spreading in all directions."
msgstr ""
"⟪k:0⟫Ce ne sont plus les ténèbres éternelles, que je vois, ni les visions de mon passé, ⟪k:1⟫mais "
"une mer de sang qui s’étend dans toutes les directions."

#: scenario7:scenario7_0B7E335C_F700_46DA_B344_D99D126704A6
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: c0f6034dd4378ee97546ad64049fb639e7c64ca61b892164a4798128ee62109f
