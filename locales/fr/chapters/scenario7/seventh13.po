msgid "⟪k:0⟫Well, good for you, my dear."
msgstr "⟪k:0⟫Eh bien, tant mieux pour toi, très cher."

#: scenario7:scenario7_D3387E17_242B_4891_9DEB_F2FA0A2444A8
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: b61800084d41f5efaccf096c5df7fd1ebebd440609f6fc0a13e47c2b43add1c9
#. default-sha256: a004ea204e9708fa9af84a1b068486485525aa7788237bf6cffb26c3d5b3b16d
msgctxt "scenario7:scenario7_D3387E17_242B_4891_9DEB_F2FA0A2444A8"
msgid ""
"⟪k:0⟫A little confidence boost doesn’t erase the fact that you were on the ground, crawling "
"through the filth like a worm, tears streaming down your face as you tried to ignore what lay "
"before you."
msgstr ""
"⟪k:0⟫Un petit regain de confiance n’efface pas le fait que tu étais au sol, à ramper dans la boue "
"comme un ver de terre, les larmes ruisselant sur ton visage, tout en essayant d’ignorer ce qui "
"t’attendait."

#: scenario7:scenario7_4B954D95_FE33_4549_8EDC_D4C6B255F7BB
