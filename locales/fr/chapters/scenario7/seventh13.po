msgid "⟪k:0⟫⟪k:1⟫...So you’re saying I’m lying?"
msgstr "⟪k:0⟫⟪k:1⟫...Tu insinues donc que je mens ?"

#: scenario7:scenario7_B0E88E04_7456_4076_8BFF_6E0903327CD8
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: ae7ca993871be22a709798aafdb55f64150c4c52d0fc9b9360aa4b72d44742ac
