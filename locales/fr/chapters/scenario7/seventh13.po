msgctxt "scenario7:scenario7_0B7E335C_F700_46DA_B344_D99D126704A6"
msgid ""
"⟪k:0⟫I’m standing at the top of the observation tower, outside the door.⟪k:1⟫⟪k:2⟫I’ve returned."
msgstr ""
"⟪k:0⟫Je me trouve en haut de la tour d’observation, sur le pas de la porte.⟪k:1⟫⟪k:2⟫Me voici de "
"retour."

#: scenario7:scenario7_B13FC8E8_7690_47F3_BF80_04E6CEA3F9A9
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: cfc5ed1d4c15c36a35364180cf2a53e1f3c1cdd6a00ec8f991ae3b5f27df03ee
