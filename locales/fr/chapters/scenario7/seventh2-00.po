msgctxt "scenario7:scenario7_698A0752_EF9B_41D6_9EE7_5F5A9FC921B1"
msgid "⟪k:0⟫............"
msgstr "⟪k:0⟫............"

#: scenario7:scenario7_87EC99C0_B5CC_4789_AC25_1ED76DE8EE20
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 1e20c41d67f03e1e30f18fd347d4c5240d6d59255dcc4c6b65aab6e128129d19
#. default-sha256: aa639226c6bb4c316d9e982b62386e9cea603e7efdf3a596634fa892ee6b2302
msgctxt "scenario7:scenario7_87EC99C0_B5CC_4789_AC25_1ED76DE8EE20"
msgid "⟪k:0⟫...Was I angry that he had been disrespectful?"
msgstr "⟪k:0⟫...⟪k:1⟫É⟪k:2⟫tais-je en colère parce qu’il m’avait manqué de respect ?"

#: scenario7:scenario7_13D0B143_FC01_4D28_9257_7C5A908C7677
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 089a98b7bc57dcb4709b89a745e1811438f4a0829706964e0e967f9660847d32
#. default-sha256: f0f04c711f011a8a9874adb15a2c6bd6b568ea1a0eb6f41a83310b961977028e
msgctxt "scenario7:scenario7_13D0B143_FC01_4D28_9257_7C5A908C7677"
msgid "⟪k:0⟫—!"
msgstr "⟪k:0⟫—!"

#: scenario7:scenario7_31BF33E2_D49F_45A8_A17E_7D56B1A59EDC
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 5a4bf639a9e16e5cfb6dac0bc84b75bb535fc0ea329c75d7333abad2cbc3587b
#. default-sha256: 2dc90b32514cd4720ff7f3ada87924e24b528df5e18bdb358673197ae44b9fdb
msgctxt "scenario7:scenario7_31BF33E2_D49F_45A8_A17E_7D56B1A59EDC"
msgid "⟪k:0⟫At the sound of his voice, I—⟪k:1⟫⟪k:2⟫couldn’t turn back."
msgstr "⟪k:0⟫Au son de sa voix, je—⟪k:1⟫⟪k:2⟫je me figeai, sans pouvoir me retourner."

#: scenario7:scenario7_FBCB4019_C1E7_48D3_9B6E_78CE22099E33
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: f641ea10c0a9a9205ce8432c642620343862671c34b3f20a0ddf070b551c0c32
#. default-sha256: 50b0dafc6ec918b884b60bf0f703aafc9d5cc8915f466a4d4c3dbaba2347c913
msgctxt "scenario7:scenario7_FBCB4019_C1E7_48D3_9B6E_78CE22099E33"
msgid "⟪k:0⟫What the hell are you doing?!"
msgstr "⟪k:0⟫Mais ça va pas, qu’est-ce qui vous prend ?!"

#: scenario7:scenario7_995A4CD0_08D4_48CE_9960_87C12920C761
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 5161865402167fe8d03433648e92164bb618cc19b211065cce3905f24bedd6bb
#. default-sha256: 371aaa0ac236f2469a7c71f89f0e77c226b3c0c68e00e68d86a237ed81acc353
msgctxt "scenario7:scenario7_995A4CD0_08D4_48CE_9960_87C12920C761"
msgid "⟪k:0⟫I tried a second time to get away from him, and that was when reality sunk in."
msgstr "⟪k:0⟫J’essayai à nouveau de lui échapper, et c’est là que je compris."

#: scenario7:scenario7_6DEC0842_64FA_4D3B_B79D_8B67D9518F68
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 30fe7b15c5047a10ba6e7323f3c6ff58e245c35dd9e866ad17ee7709cf512053
#. default-sha256: 592813cca675f682bf907caab493b108a74c56ee4be3fce696d3b893398b77f3
msgctxt "scenario7:scenario7_6DEC0842_64FA_4D3B_B79D_8B67D9518F68"
msgid ""
"⟪k:0⟫You’ve got a tongue like a boy, milady.⟪k:1⟫⟪k:2⟫But I know some people’re fond o’ that "
"these days.⟪k:3⟫⟪k:4⟫Can’t say I mind, m’self."
msgstr ""
"⟪k:0⟫C’est qu’tu n’as pas la langue dans ta poche, ma p’tite demoiselle... Tu parles comme un "
"homme...⟪k:1⟫⟪k:2⟫Mais j’sais bien qu’y en a qui aiment ça de nos jours.⟪k:3⟫⟪k:4⟫J’peux pas dire "
"qu’ça m’dérange, moi."

#: scenario7:scenario7_E87CAB54_D147_4DD3_B847_9EE7FF0445A8
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 24cef625152dfddf37004fbe6e1e24d573abf7b9c92219806ee49ea249bb09ad
#. default-sha256: d7aab7b351cee144b5c85d1fb1f59604d50b1b0c730b95f09cdcb126c52a8fe7
msgctxt "scenario7:scenario7_E87CAB54_D147_4DD3_B847_9EE7FF0445A8"
msgid "⟪k:0⟫Why did I have to get stuck with this body?"
msgstr "⟪k:0⟫Pourquoi étais-je coincée dans ce corps ?"

#: scenario7:scenario7_BB334368_EA29_49F2_BBE4_C5C688AFB3B0
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: a8adeb8ddc0c441e5f2666477653d97de7e3db02d118e1afff7fc413c2193ce9
#. default-sha256: 839f1785e4f6418a1b575dc81da358f1c74da09c334a647ec63d230a166ea876
msgctxt "scenario7:scenario7_BB334368_EA29_49F2_BBE4_C5C688AFB3B0"
msgid ""
"⟪k:0⟫Now, just so we’re clear, I’m not going to hurt you.⟪k:1⟫⟪k:2⟫I’m no monster—⟪k:3⟫⟪k:4⟫I "
"promise you that."
msgstr ""
"⟪k:0⟫Allons, allons, juste pour qu’ce soit clair, j’vais pas t’faire de mal.⟪k:1⟫⟪k:2⟫J’suis pas "
"un monstre —⟪k:3⟫⟪k:4⟫ promis."

#: scenario7:scenario7_29DFBE46_F500_4AC9_810B_EB3F12314404
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 66c34581ca68ba598d7e984de781302859323626a4811fcab37c61c03398d742
#. default-sha256: 561a1f73f364ffec26fc5df19558526fcaeab68124226ec4b79ecb0e930456c8
msgctxt "scenario7:scenario7_29DFBE46_F500_4AC9_810B_EB3F12314404"
msgid "⟪k:0⟫Then why are you holding me against the wall?!"
msgstr "⟪k:0⟫Alors pourquoi me maintenez-vous contre le mur ?!"

#: scenario7:scenario7_272A67D3_F4A5_4706_89C4_A55D0E0C478E
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 3cb0a7816d59b874c91ce794a0e36c29ada8f00e378068a86325d86cf4b115cf
#. default-sha256: fdbb1973338bcf5f52f4994858c4ab81f245a553263aaf16c401b162b6860b68
msgctxt "scenario7:scenario7_272A67D3_F4A5_4706_89C4_A55D0E0C478E"
msgid ""
"⟪k:0⟫But if I do that, you’ll run away.⟪k:1⟫⟪k:2⟫And it’s my personal rule to never let go of "
"anything I like."
msgstr ""
"⟪k:0⟫Mais si je l’fais, tu vas t’enfuir.⟪k:1⟫⟪k:2⟫Et j’ai une règle bien à moi : je ne laisse "
"jamais partir c’que j’aime."

#: scenario7:scenario7_1B719745_4C01_42EC_881F_865A27C78D0F
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: daca27dfb3c3e3885a0308e0671506e3735bd2bef3ba90ec5c1c7c01017b7b62
#. default-sha256: 92ea5286f886156fbab7d34746a773da4af59494e468c7fa693aef65ac01f00e
msgctxt "scenario7:scenario7_1B719745_4C01_42EC_881F_865A27C78D0F"
msgid ""
"⟪k:0⟫Your brother says you can’t go outside, so if I set you loose now,⟪k:1⟫I might never get a "
"chance to catch you again."
msgstr ""
"⟪k:0⟫Ton frère dit que tu n’peux pas sortir, donc si j’te libère maintenant,⟪k:1⟫j’aurai peut-"
"être jamais d’autre occasion."

#: scenario7:scenario7_B1EBFCD3_AEE4_47BA_A33C_20B008897DA8
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 4c8858ffe7e01aa92e8e47a7ff3a46706ec4ea2cd06670b0fe9282f376f08f00
#. default-sha256: 9c174a828482032a602a9541b7271b4ea2a2554244578e8a57db3b2bb1ffbac1
msgctxt "scenario7:scenario7_B1EBFCD3_AEE4_47BA_A33C_20B008897DA8"
msgid ""
"⟪k:0⟫Besides, I’m a minstrel.⟪k:1⟫⟪k:2⟫Spend some time with me, and I’ll write you all the songs "
"you could possibly want."
msgstr ""
"⟪k:0⟫En plus, je suis ménestrel.⟪k:1⟫⟪k:2⟫Si tu passes du temps avec moi, je t’écrirai toutes les "
"chansons que tu voudras."

#: scenario7:scenario7_D247F410_D567_41F1_90BE_AC300EED08FF
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: adb7d0b11f44f5b04a56f7e5937a79229e7d25254544803e4f10a6cda27965ae
#. default-sha256: 4a40794714f72b7afbaa03e60c8eceb94c53393a54e1c9b685905e060639c6b2
msgctxt "scenario7:scenario7_D247F410_D567_41F1_90BE_AC300EED08FF"
msgid "⟪k:0⟫With a muse like that, I could write the most incredible songs you’ve ever heard."
msgstr ""
"⟪k:0⟫Avec une muse comme toi, j’pourrais écrire des chansons fantastiques, comme tu n’en as "
"jamais entendu."

#: scenario7:scenario7_48CDC704_7A4F_428A_B1BC_99C9404AF688
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: bec9a7d2f87f6d21708643aa974c9a623e061f24d667fa34933c9bdd83bb03e3
#. default-sha256: 9a7f750d4faddefabb4d6fcfd6965f4d1a329c597df5ce35f5071c71e4cfb356
msgctxt "scenario7:scenario7_48CDC704_7A4F_428A_B1BC_99C9404AF688"
msgid "⟪k:0⟫Huh... ⟪k:1⟫That’s odd.⟪k:2⟫⟪k:3⟫That one’s never failed me."
msgstr "⟪k:0⟫Tiens... ⟪k:1⟫C’est bizarre.⟪k:2⟫⟪k:3⟫Cette réplique m’a toujours réussi."

#: scenario7:scenario7_5165BADF_6DF9_4E4E_9596_C0098CB4B5AD
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 68586e321cc2c9f5a218e14f2e39a08b2fe9c8047bed94477ed1d5e4a3401299
#. default-sha256: 56cd5be8a58a26d604086807542757104aead0c539578b5ada5e621d9650787d
msgctxt "scenario7:scenario7_5165BADF_6DF9_4E4E_9596_C0098CB4B5AD"
msgid ""
"⟪k:0⟫The man brought his face in just inches from mine and peered into my eyes. ⟪k:1⟫I could feel "
"his hot, wine-stenched breath against my cheeks."
msgstr ""
"⟪k:0⟫L’homme approcha son visage à quelques pouces du mien et plongea son regard dans le mien. "
"⟪k:1⟫Je sentais son haleine chaude, empestant le vin, contre mes joues."

#: scenario7:scenario7_42D9CCE6_AF58_4433_9E36_AD707DB80A34
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 8a726f73beb5139e4c15a6b692bd89f9a0ca246abcae3202df5d225aa461c28a
