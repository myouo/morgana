msgid ""
"⟪k:0⟫As wanton as his social interactions may have been, he still had a reputation to maintain. "
"⟪k:1⟫And I understood that."
msgstr ""
"⟪k:0⟫Aussi dévergondées que soient ses interactions sociales, il avait tout de même une "
"réputation à maintenir. ⟪k:1⟫Et je le comprenais."

#: scenario7:scenario7_127E0631_FCA3_44F5_B106_726E300E8989
