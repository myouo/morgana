msgid "⟪k:0⟫⟪k:1⟫⟪k:2⟫...?"
msgstr "⟪k:0⟫⟪k:1⟫⟪k:2⟫...?"

#: scenario7:scenario7_43E1C2D0_3F06_485B_BCC9_00626FFF67B2
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 73ddb5cfb7064a2615d5e3753827481d0e9ffedf31f621e4f8ba164c2290c880
#. default-sha256: c6744603ffc097664fb7de266dd5fbe2667d44c102b4c040cc017ff0de959015
msgctxt "scenario7:scenario7_43E1C2D0_3F06_485B_BCC9_00626FFF67B2"
msgid "⟪k:0⟫A warm breeze blew past, sending up a swirl of flower petals."
msgstr "⟪k:0⟫Une brise tiède s’éleva, faisant tourbillonner des pétales de fleurs."

#: scenario7:scenario7_FE166405_06E9_48C9_B91E_7D545B24CDC6
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 92a7dfab05c9aa8581c4b65be40bc68afc0507126e32e136716bd6909b7ba9f0
#. default-sha256: e1716c854b23560b2227a8bb366748b38eec32cb7a50152ad718f7fad2576f93
msgctxt "scenario7:scenario7_FE166405_06E9_48C9_B91E_7D545B24CDC6"
msgid "⟪k:0⟫The girl’s dress hung lightly over her frame, tracing her gentle curves."
msgstr ""
"⟪k:0⟫La robe de la fille se plaqua légèrement contre son corps, soulignant ses courbes délicates."

#: scenario7:scenario7_CFB6B5B7_B005_45AD_AEAE_EF9562430783
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: d7a850598639c5843bcbc1185d6e3658f04ee656d715b6742539b81e091ae5ef
#. default-sha256: dec242b07de76498acd5849e1269eeb37883c12e30155608f83c0c9c3a446f58
msgctxt "scenario7:scenario7_CFB6B5B7_B005_45AD_AEAE_EF9562430783"
msgid "⟪k:0⟫⟪k:1⟫And you are?"
msgstr "⟪k:0⟫⟪k:1⟫Et vous êtes... ?"

#: scenario7:scenario7_E59D31B4_85C2_4732_A368_4E4D1F67B857
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: e97bcdb8715f2dae07a19840f896df60e93b03f8c14ff7c2a6843f0737ca7e50
#. default-sha256: e373582f915ce0991bdc422e47cff501acc32936f8195c71fb2c6e7c8447243c
msgctxt "scenario7:scenario7_E59D31B4_85C2_4732_A368_4E4D1F67B857"
msgid "⟪k:0⟫⟪k:1⟫My name is Aimee.⟪k:2⟫⟪k:3⟫It’s a pleasure to finally meet you."
msgstr "⟪k:0⟫⟪k:1⟫Je m’appelle Aimée.⟪k:2⟫⟪k:3⟫Enchantée de vous rencontrer enfin."

#: scenario7:scenario7_F9079209_E85A_47FC_B2FA_F9843BD38D98
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 2fc8bfe7697d8532c40049e39dd0a54a2dc23d355d96232537e61f4c968cb13e
#. default-sha256: 354c8ac4e95a3876497de50148081136e0e2a18bccf306ad41ab69306da3b967
msgctxt "scenario7:scenario7_F9079209_E85A_47FC_B2FA_F9843BD38D98"
msgid "⟪k:0⟫she stepped toward me, kissing me softly on the cheek."
msgstr "⟪k:0⟫elle s’avança vers moi et me déposa un petit baiser sur la joue."

#: scenario7:scenario7_BDFDDAED_DC39_40E0_BAAC_48879F664DE0
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 72aa1cd1769302b96d5edb7de462ce9c66a94531dd11e985e3afa1a029fe9a53
#. default-sha256: 920fb43aa3f4d18f3e733429a9a162dab865e1d70fffe3ffa92eb23257bcb1a7
msgctxt "scenario7:scenario7_BDFDDAED_DC39_40E0_BAAC_48879F664DE0"
msgid "⟪k:0⟫Electrifyingly sweet."
msgstr "⟪k:0⟫Douce à en donner des frissons."

#: scenario7:scenario7_09505D2C_BFC5_4070_A5DF_6C8CB3F33C4C
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 3503b625660ab07aad43e125efd27f464ba789f187517c46b937fb3a95ddfd42
#. default-sha256: 8e35148d8b92ca82ed10bf35c2fe6cee977531ed17b524d52bbe526479717a5c
msgctxt "scenario7:scenario7_09505D2C_BFC5_4070_A5DF_6C8CB3F33C4C"
msgid "⟪k:0⟫⟪k:1⟫I’m Georges’s fiancée."
msgstr "⟪k:0⟫⟪k:1⟫Je suis la fiancée de Georges."

#: scenario7:scenario7_0CC24CFF_DFBA_42EC_A670_E87AED53CB32
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 87a5dfd330e2ce34ec9cb0f31850b4895097af95867766bf009edbabc33af678
