msgid "⟪k:0⟫I wanted to vomit."
msgstr "⟪k:0⟫J’avais envie de vomir."

#: scenario7:scenario7_8665B515_625B_487D_B15B_7579834A3333
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: e34e0c6a944cba4cafe7e430786448cd3e1b99c420abd86abef7aac742c1cd31
#. default-sha256: 82f857aadc6d826cfee171070de498abc28e5ac9ad3a2f0111c4234cdbb974c4
msgctxt "scenario7:scenario7_8665B515_625B_487D_B15B_7579834A3333"
msgid "⟪k:0⟫Apparently taking my silence for approval, the man perked up and kept going."
msgstr ""
"⟪k:0⟫Méprenant visiblement mon silence pour de l’approbation, l’homme se sentit encouragé et "
"continua."

#: scenario7:scenario7_477BE831_2C3F_4DA7_A87D_ED9E91533BDF
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 93772161d75731c950679c1df50e111ea0c47fc3f226f56fd06ff4794db5f004
#. default-sha256: 472e428772064a1c678a7f0c9121cd1333a1d9411a2a437686b5aed25063b4f4
msgctxt "scenario7:scenario7_477BE831_2C3F_4DA7_A87D_ED9E91533BDF"
msgid ""
"⟪k:0⟫If you’re not accustomed to being around men,⟪k:1⟫then why not use this as an opportunity to "
"get familiar?⟪k:2⟫⟪k:3⟫Not a half-bad idea, if I do say so myself.⟪k:4⟫⟪k:5⟫And I think we’d get "
"along quite well."
msgstr ""
"⟪k:0⟫Si tu n’es pas habituée à être avec des hommes,⟪k:1⟫pourquoi ne pas voir ce moment comme une "
"opportunité de te rapprocher ?⟪k:2⟫ C’est pas une mauvaise idée, si j’puis dire.⟪k:3⟫⟪k:4⟫Et je "
"pense qu’on s’entendrait bien tous les deux."

#: scenario7:scenario7_C7AB2E98_11A2_4AE4_A5DC_31D99787F41C
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 04903066f0a8af39bc5ae3797c1bef9bf11994baabce69c55526cbc9e0b6135d
#. default-sha256: 6b4734b73fd24cd009954bef8e8908e2037ffc7a5f22d0fafdbaa571e7014c01
