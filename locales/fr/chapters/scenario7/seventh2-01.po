msgctxt "scenario7:scenario7_505D9FA8_9319_446A_9840_6285F0E571F9"
msgid "⟪k:0⟫The bitter scent of wine wafted from above."
msgstr "⟪k:0⟫Une odeur aigre de vin flotta au-dessus de moi."

#: scenario7:scenario7_D140738E_BA9B_4F3D_8411_8E98B35C97B6
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 56f3d53a5dba2d5c2a1047594919fbf5596321fe062c7c375f98fa8def058923
#. default-sha256: f9f35bea3439b30eb61fa8636b125891c866868d820e1010e723083decdbb6da
msgctxt "scenario7:scenario7_D140738E_BA9B_4F3D_8411_8E98B35C97B6"
msgid ""
"⟪k:0⟫I couldn’t do it. ⟪k:1⟫All the strength I could muster wasn’t enough to make the man’s hand "
"budge. ⟪k:2⟫My arms were locked in place."
msgstr ""
"⟪k:0⟫J’en étais incapable. ⟪k:1⟫Toute la force que je pouvais rassembler n’était pas suffisante "
"pour faire bouger la main de l’homme. ⟪k:2⟫Mes bras étaient cloués sur place."

#: scenario7:scenario7_B1709379_FCD0_44C9_8B31_332A230F7D21
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: c6efe6b1858ef38807bff820e1e75467b11d9683b15e5145c563f8ea560e9d26
#. default-sha256: 9f910e2c95de96e58d4c4626afe79c6c750912f87fd738c5b416d5f1514bacad
msgctxt "scenario7:scenario7_B1709379_FCD0_44C9_8B31_332A230F7D21"
msgid "⟪k:0⟫I didn’t think he was especially strong, either. ⟪k:1⟫He was hardly built like Didier."
msgstr ""
"⟪k:0⟫Et je savais qu’il n’était pas spécialement fort, en plus. ⟪k:1⟫Il n’était pas bâti comme "
"Didier."

#: scenario7:scenario7_D07D61E7_BE90_4A13_A224_5D00CA7DE1D2
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 9dc8a9c447f549267e49279c4a43d50d675d299aa966c6bbb9abd39d6d81b1a8
