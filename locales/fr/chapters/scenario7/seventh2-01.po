msgid "⟪k:0⟫I’ll be taking that!"
msgstr "⟪k:0⟫Attendez, je vais le prendre !"

#: scenario7:scenario7_423131A6_FDB2_4843_A2D2_366A47EDE7AB
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: bc678c0fe85c8a5e8024fac34aef8213ca97eeef34d9e8679a17909acdcaf81f
