msgctxt "search2:search2_09F798CD_19DD_43E8_B229_4FF82C14F5C9"
msgid ""
"⟪k:0⟫It was the first time I had found the courage to face my mother...⟪k:1⟫⟪k:2⟫to open up to "
"her."
msgstr ""
"⟪k:0⟫C’était la première fois que je trouvai le courage d’affronter ma mère...⟪k:1⟫⟪k:2⟫...de "
"m’ouvrir à elle."

#: search2:search2_C22AB7C5_BC01_4088_B00A_EC5515169C4A
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 58e5482fdbca83a8f741c52434a77ec4e4c5d6147b1cee6bc6240d2f3ee346d6
