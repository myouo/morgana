msgctxt "search2:search2_89C4334A_B7A2_49BE_AD29_6C93E6F4427E"
msgid "⟪k:0⟫⟪k:1⟫“It’s the blood of the witch!”"
msgstr "⟪k:0⟫⟪k:1⟫« C’est le sang de la sorcière ! »"

#: search2:search2_20B7F719_A77B_4C98_AE25_384AFDFEB29B
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: c026f33f331b4478191fa9271ad296ef099dfd90c8afba06b2fcf47e07d30e01
