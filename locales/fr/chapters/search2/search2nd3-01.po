msgid "⟪k:0⟫⟪k:1⟫⟪k:2⟫“The witch killed her...”"
msgstr "⟪k:0⟫⟪k:1⟫⟪k:2⟫« C’est la sorcière qui l’a tuée...»"

#: search2:search2_CF282D4A_F922_453D_9611_E9E33BC11C03
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 17ec7f91e57ede160c28a80aac6d321fe6232d37f9f981525e6c4e40f5ca5b2b
