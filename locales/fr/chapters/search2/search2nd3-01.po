msgid "⟪k:0⟫⟪k:1⟫“It’s—”"
msgstr "⟪k:0⟫⟪k:1⟫« C’est— »"

#: search2:search2_89C4334A_B7A2_49BE_AD29_6C93E6F4427E
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 5d2e0f35e8b64b03f2737559dcead19f0412ec6dd48821615d4614868e1d75db
