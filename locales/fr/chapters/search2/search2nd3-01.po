msgid "⟪k:0⟫⟪k:1⟫⟪k:2⟫“So don’t take it personally, witch.”"
msgstr "⟪k:0⟫⟪k:1⟫⟪k:2⟫« Alors, ne le prends pas mal, sorcière. »"

#: search2:search2_6B3EE901_C92B_4091_B63E_750AE2051278
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 456ca3c658926d3b790c222301dc825ec619340a6fa8378cd087d27c5f42bb47
