msgid "⟪k:0⟫⟪k:1⟫“The blood of the witch killed my sister!”"
msgstr "⟪k:0⟫⟪k:1⟫« Le sang de la sorcière a tué ma sœur ! »"

#: search2:search2_B452B934_50B9_47F3_9906_BE86228BD71C
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 2462bcf0f15ca6da2a72ba8f5957bf08cb6d6579b54a3fcbf0ab5658fd0735bf
