msgctxt "search2:search2_6C1E3712_DB41_4FC0_9741_04C66D419C6C"
msgid ""
"⟪k:0⟫Everything comes back to me all at once.⟪k:1⟫⟪k:2⟫That’s right... ⟪k:3⟫I watched Morgana "
"kidnap her."
msgstr "⟪k:0⟫Tout me revient brutalement.⟪k:1⟫⟪k:2⟫Ah oui... ⟪k:3⟫j’ai vu Morgana l’enlever."

#: search2:search2_317EB5A2_A2E1_46B1_839A_92BC9F210064
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 09a404012c0414559d8815db61a3aed18efe2594026b3fe6a189179b26d2e3e0
