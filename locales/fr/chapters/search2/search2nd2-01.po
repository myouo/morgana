msgctxt "search2:search2_EC22BA4B_7D57_4ACF_A0BB_BEC27F9ADBDA"
msgid "⟪k:0⟫I don’t know how I got here, but I’m sitting in a rocking chair, hunched forward."
msgstr ""
"⟪k:0⟫Je ne sais pas comment je suis arrivé là, mais je suis assis dans un fauteuil à bascule, "
"penché en avant."

#: search2:search2_51653318_D752_A6F7_2D6E_F7A3A6DA7744
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: e0a87a335581f03009979c73524b18c1c52f80c7422277f001e1f95bb519e4e2
#. default-sha256: 6fa4670721ce909f50630e69ad82f5790a2881b8a3064dbaa5b6363c64a412bd
msgctxt "search2:search2_51653318_D752_A6F7_2D6E_F7A3A6DA7744"
msgid ""
"⟪k:0⟫My head feels like someone filled it with rocks,⟪k:1⟫and I’m having difficulty focusing."
msgstr ""
"⟪k:0⟫Ma tête est lourde comme si elle était remplie de cailloux,⟪k:1⟫et j’ai du mal à me "
"concentrer."

#: search2:search2_7BF9D9B0_0E96_41DE_91C3_9EE1CDFECB95
