msgctxt "search2:search2_317EB5A2_A2E1_46B1_839A_92BC9F210064"
msgid "⟪k:0⟫I watched the witch drag her into the darkness...⟪k:1⟫⟪k:2⟫unable to reach her hand."
msgstr ""
"⟪k:0⟫J’ai vu la sorcière la traîner dans les ténèbres...⟪k:1⟫⟪k:2⟫...sans que je puisse la "
"retenir par la main."

#: search2:search2_51530F60_E669_44C1_B5EB_FED125E8E7AF
