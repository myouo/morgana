#: search2:search2_92927362_E2C1_4E68_9DEE_63E8053449DB
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 6d3a383c84f0f0b40dfc0191c532c590d342f949070ea933bf6440277f40c408
#. default-sha256: 5ddd26c67e84a747ddc9e863b9da4b39fc8fa117c5ce4e58de46e0c7739c48f2
msgctxt "search2:search2_92927362_E2C1_4E68_9DEE_63E8053449DB"
msgid ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫⟪k:4⟫⟪k:5⟫⟪k:6⟫⟪k:7⟫⟪k:8⟫⟪k:9⟫⟪k:10⟫⟪k:11⟫⟪k:12⟫⟪k:13⟫⟪k:14⟫⟪k:15⟫⟪k:16⟫⟪k:17⟫"
"⟪k:18⟫⟪k:19⟫“I carry within me the child of God!”"
msgstr ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫⟪k:4⟫⟪k:5⟫⟪k:6⟫⟪k:7⟫⟪k:8⟫⟪k:9⟫⟪k:10⟫⟪k:11⟫⟪k:12⟫⟪k:13⟫⟪k:14⟫⟪k:15⟫⟪k:16⟫⟪k:17⟫"
"⟪k:18⟫⟪k:19⟫« Je porte en moi l’enfant de Dieu ! »"

#: search2:search2_A84944D9_4058_413F_9EE5_317AF8A5127D
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 1b51c6e6150d23504f19e68d61feea218ce785bfeed914f8adb36f667f8f57fd
