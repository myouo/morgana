#. native-sha256: 736189d20fcf0d591fdcd62b8ad9ce2c08937dd449d8674b2c5cda17f8985a47
#. default-sha256: b9d13447aa611eb6af35446db98dff2a52115d8012b9ca6589e870152651e652
msgctxt "search2:search2_AA0BC909_A9E4_47BD_B36F_5B9D3F51D0B4"
msgid "⟪k:0⟫⟪k:1⟫⟪k:2⟫The lord gave my corpse a casual glance,⟪k:3⟫⟪k:4⟫and said stonefaced,"
msgstr ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫Le seigneur jeta à mon cadavre un coup d’œil désinvolte,⟪k:3⟫⟪k:4⟫et dit, "
"impassible :"

#: search2:search2_5AC72E41_4150_4A5B_B5AC_447276CF9678
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 017441e7b3e33a543f7ee634403c2f887d21e9d732a88d20fbc523a976bf0632
