#: badend3:badend3_C70F299F_DA84_4B00_9E9E_EDA04274BA9A
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: d3a8c4dbf9b3f72ca7c12b78aa4b0ffcb52349fef1e78133be9b6ba4f795a9cd
#. default-sha256: 1fdc8a1e99b03dd948d72269096a75bb82ee5840bfb7d5f85212a53b76b6dc16
msgctxt "badend3:badend3_C70F299F_DA84_4B00_9E9E_EDA04274BA9A"
msgid ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫⟪k:4⟫⟪k:5⟫⟪k:6⟫⟪k:7⟫⟪k:8⟫⟪k:9⟫⟪k:10⟫⟪k:11⟫⟪k:12⟫⟪k:13⟫⟪k:14⟫⟪k:15⟫⟪k:16⟫I "
"can’t force her to do something she doesn’t want to."
msgstr ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫⟪k:4⟫⟪k:5⟫⟪k:6⟫⟪k:7⟫⟪k:8⟫⟪k:9⟫⟪k:10⟫⟪k:11⟫⟪k:12⟫⟪k:13⟫⟪k:14⟫⟪k:15⟫⟪k:16⟫Je ne "
"peux pas l’obliger à faire quelque chose qu’elle ne veut pas."

#: badend3:badend3_74F825C4_270A_4F90_9221_8B5CA412E57C
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 71d46cb000af74e5b83bf47d527acc9ed501a3b421eb9fb64a2ffc09ec84056c
#. default-sha256: ba96d085b658145ca6be84fb24a273204ec3b231d0f94867a36b3531b2a7b64e
msgctxt "badend3:badend3_74F825C4_270A_4F90_9221_8B5CA412E57C"
msgid ""
"⟪k:0⟫If she doesn’t reclaim herself on her own... ⟪k:1⟫I’ll never get to hear her say my name "
"again..."
msgstr ""
"⟪k:0⟫Si elle ne retrouve pas d’elle-même son identité... ⟪k:1⟫je ne pourrai jamais l’entendre à "
"nouveau dire mon nom un jour..."

#: badend3:badend3_547360EE_32D4_4534_8ED5_5D740F96586D
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: be9cfd1625146861f74764a131a356d42ca5216bc294235cd074ee5b2df07cf6
#. default-sha256: d3de1e1256a881683610a737821476c7bf8fa9234ccf6bb533efb8e016bb375b
msgctxt "badend3:badend3_547360EE_32D4_4534_8ED5_5D740F96586D"
msgid ""
"⟪k:0⟫But if she wants to leave all that behind her... ⟪k:1⟫then it’s not my place to interfere."
msgstr ""
"⟪k:0⟫Mais si elle veut laisser tout cela derrière elle... ⟪k:1⟫ce n’est pas à moi de m’y opposer, "
"dans ce cas."

#: badend3:badend3_547360EE_32D4_4534_8ED5_5D740F96686D
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: deaf50eabc96ab4d3ce5f5e926cb140b53f71b5ee410735ca6ad1c0d96eebeaa
#. default-sha256: 7d1d4a7bcd525634ac06b1f24831a5cfb108c65bed33af67334590f63f1efea6
msgctxt "badend3:badend3_547360EE_32D4_4534_8ED5_5D740F96686D"
msgid ""
"⟪k:0⟫I’ve done things that would warrant her wanting to rewrite her past, erasing me entirely."
msgstr ""
"⟪k:0⟫J’ai fait des choses qui justifieraient qu’elle veuille récrire son passé en m’en effaçant "
"complètement."

#: badend3:badend3_14501C98_A043_4232_9EFD_BCFC5DCC400A
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: ed9c2689442d310f397d876476e56aef80307116c2ec21cd1e00a0180a7d2e5d
#. default-sha256: 2d040d24510678665ef4adbbe86bbb396651bae3a210212bbaae2415a8244823
msgctxt "badend3:badend3_14501C98_A043_4232_9EFD_BCFC5DCC400A"
msgid "⟪k:0⟫But I think, more than anything..."
msgstr "⟪k:0⟫Mais je crois que, plus que tout..."

#: badend3:badend3_71304866_D2C8_406C_A8AF_B269483EF474
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 066451c979996150ba8a637a6b0dd4bc39674d9e39670e2f6edda38958116b9f
#. default-sha256: bf8cc147ad1a6dd3e05941824bca60d482c9c99a9c92a02a3838a84f932bc00e
msgctxt "badend3:badend3_71304866_D2C8_406C_A8AF_B269483EF474"
msgid "⟪k:0⟫I’m afraid of hurting her, of breaking her any more than she already is."
msgstr "⟪k:0⟫...j’ai peur de la blesser, de la briser encore davantage."

#: badend3:badend3_202FBE8C_5025_42D3_AB14_844F51FDD442
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 39c0e93329f60a83b73e46ee3edd9cee836203fc6af66970bef729a512d7ea0c
#. default-sha256: 1c812955ab9bac78e3a90e06d812791e1961c834f796f1436b7f9a497f0f3238
msgctxt "badend3:badend3_202FBE8C_5025_42D3_AB14_844F51FDD442"
msgid "⟪k:0⟫⟪k:1⟫⟪k:2⟫............"
msgstr "⟪k:0⟫⟪k:1⟫⟪k:2⟫............"

#: badend3:badend3_63F96811_C8E8_4907_87B9_416FA37B0D60
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: a94f956280dd317fd8ea02419bd80721c9d93566a0b981a031ab8b7aa77512f9
#. default-sha256: 16a6944041d9593f746f3f80aa60e796eaf068b9261447e5fab3d69949169a87
msgctxt "badend3:badend3_63F96811_C8E8_4907_87B9_416FA37B0D60"
msgid ""
"⟪k:0⟫No, mine is a more cowardly fear.⟪k:1⟫⟪k:2⟫I’m just afraid she’ll no longer take my hand."
msgstr ""
"⟪k:0⟫Non, ma peur est celle d’un lâche.⟪k:1⟫⟪k:2⟫J’ai simplement peur qu’elle ne me prenne plus "
"jamais la main."

#: badend3:badend3_9B32C9AE_4431_40EB_8BDD_4E5E2BDCC447
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: d3a746849c3c690bc88b0d08c2daee5a3fcc2dc2c554ea092d8cd3ca1a48f7de
#. default-sha256: e34c72efc00fbdc0ec7c30e1d28e5e047d239aa4435d8f569a64535ced75f0ab
msgctxt "badend3:badend3_9B32C9AE_4431_40EB_8BDD_4E5E2BDCC447"
msgid "⟪k:0⟫⟪k:1⟫All right... ⟪k:2⟫then..."
msgstr "⟪k:0⟫⟪k:1⟫Très bien... ⟪k:2⟫dans ce cas..."

#: badend3:badend3_F984F247_AA15_40B3_9095_233FAF5E052E
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 60058df0948fb340c8c845280ce5acfa40d8fce083e170ee52ba8805e3e97482
#. default-sha256: bfdf285edadb1c737cd063fcd675f46ffb7464d1ecff6cbd9a40d38219801858
msgctxt "badend3:badend3_F984F247_AA15_40B3_9095_233FAF5E052E"
msgid "⟪k:0⟫What should have been behind the door... ⟪k:1⟫was our life together."
msgstr "⟪k:0⟫Ce qui aurait dû être derrière cette porte... ⟪k:1⟫c’était notre vie ensemble."

#: badend3:badend3_F35D6B1C_3494_447D_A012_22EF8C656B19
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 8eeec0982ac331a18b5e9cec4498a69b31b8de12d77bc43f711d0e615e17e35c
#. default-sha256: 00f20db599a8a2439f3c18e77dce532eca3ac1957aaf0c003b1b9cb63746426b
msgctxt "badend3:badend3_F35D6B1C_3494_447D_A012_22EF8C656B19"
msgid ""
"⟪k:0⟫But for her, there’s nothing but misery there anymore.⟪k:1⟫⟪k:2⟫In our time together, and in "
"me."
msgstr "⟪k:0⟫Mais pour elle, seul le malheur l’y attend.⟪k:1⟫⟪k:2⟫Notre temps passé ensemble. Moi."

#: badend3:badend3_B135271A_95CE_45F0_A7ED_3B803136CB56
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 076ca7cf4b6b66ed9555e5e4ac511b190fd0dfef931bbd950df1ed031e74e413
#. default-sha256: 198471e809280cadfad1b7e325734d55e5627547914100456b735c6edc6f831f
msgctxt "badend3:badend3_B135271A_95CE_45F0_A7ED_3B803136CB56"
msgid ""
"⟪k:0⟫Forget everything I’ve said.⟪k:1⟫⟪k:2⟫The tale within the fourth door was the whole truth."
msgstr ""
"⟪k:0⟫Oubliez tout ce que j’ai dit.⟪k:1⟫⟪k:2⟫Le conte de la quatrième porte était la stricte "
"vérité."

#: badend3:badend3_A6302219_4360_40D0_9A8C_5619F188455C
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 4a3f56b4862568444d9996fe3e4713cb8983ef4fd78ff4d0faaa211b114c14fe
#. default-sha256: c05fa573910cd9ca9df3385432ee191c3518847ef378c6a14efb8a927c527101
msgctxt "badend3:badend3_A6302219_4360_40D0_9A8C_5619F188455C"
msgid "⟪k:0⟫I can live with that."
msgstr "⟪k:0⟫Je peux vivre avec cela."

#: badend3:badend3_FAF57415_6FEA_4EBA_83E5_5340DBE4ADA7
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 57db94a85badfb5b1f2df7e2478eb679be6ca44aef2976c59239381936ab4729
#. default-sha256: 6eba272befa0746d5e17298f73b93018dff10f0bac17d1ec97be3828a1c9c62d
msgctxt "badend3:badend3_FAF57415_6FEA_4EBA_83E5_5340DBE4ADA7"
msgid "⟪k:0⟫⟪k:1⟫....................."
msgstr "⟪k:0⟫⟪k:1⟫....................."

#: badend3:badend3_F205E639_DF0B_4F13_BC4F_A7D8A77FE9A0
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: f409dc1464ae64817e735cdf0d1a99df8d439e7e3b6bd9948c5ef21936d443e3
#. default-sha256: 95978f1bcf1d06e6b3dcfd1d2c60c92526edc3c9e7128e600e93b0a0c947f054
msgctxt "badend3:badend3_F205E639_DF0B_4F13_BC4F_A7D8A77FE9A0"
msgid ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫I would just ask you to allow me one thing...⟪k:3⟫⟪k:4⟫To remain by your side."
msgstr ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫Je vous demanderai juste de me permettre une chose...⟪k:3⟫⟪k:4⟫De rester à vos "
"côtés."

#: badend3:badend3_1CBBB369_2794_43B9_9D76_29CBF71151CD
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 5dc343efbe8d2b44761ca26f2c7564e42315da258978ed1e7b09def2249f2c5b
#. default-sha256: ac1cb7b8881ed3dad9a3a84234249a33cf3ed5dabdfbc33d0c909099440ff846
msgctxt "badend3:badend3_1CBBB369_2794_43B9_9D76_29CBF71151CD"
msgid "⟪k:0⟫⟪k:1⟫I..."
msgstr "⟪k:0⟫⟪k:1⟫Je..."

#: badend3:badend3_7617E012_B4C3_4E0E_9BDF_9A7BF2BC9F7F
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 87e9083205bcbb61f6e756a9bcc067d26de6354b952e754ff04b19a092899dec
#. default-sha256: fd979b3f6e4f346cb269b2b3e704545015fc562a426ea7222760778eecb13c36
msgctxt "badend3:badend3_7617E012_B4C3_4E0E_9BDF_9A7BF2BC9F7F"
msgid "⟪k:0⟫⟪k:1⟫Of course you may."
msgstr "⟪k:0⟫⟪k:1⟫Bien sûr que oui."

#: badend3:badend3_B66E0276_AEE5_48AA_84C5_BBE775A309AE
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 4a692dceaae43e2dc607d55fb3812daefde1e2f7abfe2f14ef7621dff21bf89f
#. default-sha256: c278d771e395db7cfaf8625425a1f894472182fc5c0179ab59abdc4adbb22b62
msgctxt "badend3:badend3_B66E0276_AEE5_48AA_84C5_BBE775A309AE"
msgid ""
"⟪k:0⟫⟪k:1⟫I was the one who asked you...⟪k:2⟫⟪k:3⟫to forget about everything and live in eternal "
"darkness with me."
msgstr ""
"⟪k:0⟫⟪k:1⟫C’est moi qui vous ai demandé...⟪k:2⟫⟪k:3⟫...de tout oublier et de vivre avec moi dans "
"les ténèbres éternelles."

#: badend3:badend3_889CF03A_8988_4A6B_9154_05B232166190
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 56d66a3d44b82761e64fb281d79fe72a2644ffda44a124ad332fcf01a04fda44
#. default-sha256: 7778967e8a5f24db4eb365207620caf31ed60e0c0712ca1371df706324f1418f
msgctxt "badend3:badend3_889CF03A_8988_4A6B_9154_05B232166190"
msgid "⟪k:0⟫⟪k:1⟫Hehe... ⟪k:2⟫what a silly question.⟪k:3⟫⟪k:4⟫Did you think I would ever say no?"
msgstr ""
"⟪k:0⟫⟪k:1⟫Héhé... ⟪k:2⟫quelle question idiote.⟪k:3⟫⟪k:4⟫Vous pensiez vraiment que j’allais dire "
"non ?"

#: badend3:badend3_CD69DE7F_D1E0_4D28_A5A9_DD42EFFE124E
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 39c0e93329f60a83b73e46ee3edd9cee836203fc6af66970bef729a512d7ea0c
#. default-sha256: 1c812955ab9bac78e3a90e06d812791e1961c834f796f1436b7f9a497f0f3238
msgctxt "badend3:badend3_CD69DE7F_D1E0_4D28_A5A9_DD42EFFE124E"
msgid "⟪k:0⟫⟪k:1⟫⟪k:2⟫............"
msgstr "⟪k:0⟫⟪k:1⟫⟪k:2⟫............"

#: badend3:badend3_58A47977_610A_406A_A124_07F807C0BEC9
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: b11ddce7390df75738e2601c533d6a6b1c2f5d8c40fee3334e7b1140600f43e8
#. default-sha256: 0263de7dcd4f1faf4867c71a59b77888847d748a01d536e1ba28f11ffaee59c7
msgctxt "badend3:badend3_58A47977_610A_406A_A124_07F807C0BEC9"
msgid "⟪k:0⟫Right...⟪k:1⟫⟪k:2⟫You did, didn’t you?"
msgstr "⟪k:0⟫C’est vrai...⟪k:1⟫⟪k:2⟫Vous me l’avez demandé."

#: badend3:badend3_BCB801E7_1364_4128_8DD0_6657F4D6B165
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: eb07bdfcd5e5a12f4efc470a56db5ffe5424743e281a9415aeb3a5444d22c827
#. default-sha256: 7a9cb189212bf385679147d7f41983662533b4a4d4ac7323fc0f041a87327d01
msgctxt "badend3:badend3_BCB801E7_1364_4128_8DD0_6657F4D6B165"
msgid ""
"⟪k:0⟫⟪k:1⟫Yes, I did. ⟪k:2⟫Worry not, I will banish the memory.⟪k:3⟫⟪k:4⟫I am sure you were "
"simply disoriented at having learned who you are."
msgstr ""
"⟪k:0⟫⟪k:1⟫Eh oui. ⟪k:2⟫Soyez sans crainte, je vais bannir ce souvenir.⟪k:3⟫⟪k:4⟫Je suis sûre que "
"vous étiez simplement perturbée d’apprendre qui vous êtes."

#: badend3:badend3_A1187E10_34D3_4C5E_8103_EA7C68FA9C4A
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 05b230140e2f67262bb064df4c2b6e7a497cd45e83be55e6c4a3798c03cc057e
#. default-sha256: a1a14fbf7444cc2565f2154d0518500661a88654a85bb8d5e7cb5f7438b7b554
msgctxt "badend3:badend3_A1187E10_34D3_4C5E_8103_EA7C68FA9C4A"
msgid "⟪k:0⟫⟪k:1⟫There is nothing to fear.⟪k:2⟫⟪k:3⟫Only happiness awaits you."
msgstr "⟪k:0⟫⟪k:1⟫Il n’y a rien à craindre.⟪k:2⟫⟪k:3⟫Seul le bonheur vous attend."

#: badend3:badend3_3F28DBBC_B943_4C4C_B38C_3B9F909A66AC
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 39c0e93329f60a83b73e46ee3edd9cee836203fc6af66970bef729a512d7ea0c
#. default-sha256: 1c812955ab9bac78e3a90e06d812791e1961c834f796f1436b7f9a497f0f3238
msgctxt "badend3:badend3_3F28DBBC_B943_4C4C_B38C_3B9F909A66AC"
msgid "⟪k:0⟫⟪k:1⟫⟪k:2⟫............"
msgstr "⟪k:0⟫⟪k:1⟫⟪k:2⟫............"

#: badend3:badend3_5E64EA09_117B_4525_A7F3_166A536C201C
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 0dddb645a2c7f8061d789a88fa34e3054c0a85e830ae052ce05c8fa0a5143556
#. default-sha256: 1b0f8e5ec6f76828b40b58b7d61789c104e830874df7bf6f52fb118f421a74a8
msgctxt "badend3:badend3_5E64EA09_117B_4525_A7F3_166A536C201C"
msgid "⟪k:0⟫⟪k:1⟫Hehehe. I am getting excited now.⟪k:2⟫⟪k:3⟫What should we do first?"
msgstr ""
"⟪k:0⟫⟪k:1⟫Héhéhé. Me voilà tout excitée maintenant.⟪k:2⟫⟪k:3⟫Par quoi devrions-nous commencer ?"

#: badend3:badend3_432A5F2E_31DA_49C2_A4E2_ABE599E5AE13
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: b512b6f1ef1357d1c474466fbc09fd461917768dbe090945719c19a4402d6af9
#. default-sha256: 63191de936f05f2c776683cce0553db1733cce6186a5ee64a15c53c35163dc9b
msgctxt "badend3:badend3_432A5F2E_31DA_49C2_A4E2_ABE599E5AE13"
msgid ""
"⟪k:0⟫⟪k:1⟫Oh, I know. We should throw a party in commemoration of your decision to remain here "
"with me."
msgstr ""
"⟪k:0⟫⟪k:1⟫Oh, je sais. On devrait faire une fête pour commémorer votre décision de rester ici "
"avec moi."

#: badend3:badend3_BF9EC4E9_3B95_4859_AFAD_0E0CCD71D182
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 71ca5c121aef1331dd4770f7c1e69bdd62f64da9ac86d7c0fdb9e0c00a05aeb9
#. default-sha256: 6d2a8c0da5e4985d855ee21281b01384ed354ad5bef319ed6eca729411bb6ae2
msgctxt "badend3:badend3_BF9EC4E9_3B95_4859_AFAD_0E0CCD71D182"
msgid "⟪k:0⟫I shall prepare the most wonderful feast, my sweet girl."
msgstr "⟪k:0⟫Je vais préparer la fête la plus splendide qui soit, ma douce."

