msgctxt "badend3:badend3_04CA0963_58FC_4FFE_AD57_D1DD77712DF6"
msgid "⟪k:0⟫But she won’t say my name."
msgstr "⟪k:0⟫Mais elle ne veut pas dire mon nom."

#: badend3:badend3_99892610_1DF8_4619_982C_10B67EF1C9FE
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: c37ebc357e2a8a8d7c2f3b120d9b23a20ea9857a5d4b60315f5f0d5d9c9f80be
