#: badend3:badend3_76C25893_D9E0_4442_8A32_70B6F7F55630
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 5bc82b56aff247ec2e38a81fe1a92c158f71c43560c763630165015f21ddb20a
#. default-sha256: 078521c5b6af9a1427e66c14efc8f14591f7421ba0334ab064771fec7b6db530
msgctxt "badend3:badend3_76C25893_D9E0_4442_8A32_70B6F7F55630"
msgid ""
"⟪k:0⟫She thinks I’m the White-Haired Girl, yet she calls me “Master,”⟪k:1⟫completely oblivious to "
"how absurd that sounds."
msgstr ""
"⟪k:0⟫Elle croit que je suis la Fille aux Cheveux Blancs et pourtant, elle m’appelle « Maître », "
"sans faire le moins du monde attention à l’absurdité de la chose."

#: badend3:badend3_04CA0963_58FC_4FFE_AD57_D1DD77712DF6
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 5ff691cbf326dc4b54807149966cb0a06332bddc0c1871b936443d555b59d80b
