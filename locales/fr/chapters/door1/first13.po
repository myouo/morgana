msgctxt "scenario:scenario_71606EEB_9DAB_4875_B9AD_52E5AFA70C4E"
msgid "⟪k:0⟫G-⟪k:1⟫Get off me!"
msgstr "⟪k:0⟫D-⟪k:1⟫Dégage !"

#: scenario:scenario_F3473CBE_D848_48B2_B063_CD14C0C95CF2
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 5c1a115e0b20f4596d1a92697bde4df27b82559ce604d97613e3c718e6c5996f
#. default-sha256: a6a5b3fcfce2ed692be7ba1e6cf70fb336c9ae01fb67728d1cd11f7e6670751c
msgctxt "scenario:scenario_F3473CBE_D848_48B2_B063_CD14C0C95CF2"
msgid "⟪k:0⟫⟪k:1⟫⟪k:2⟫He reflexively shoved the girl straddling him aside."
msgstr "⟪k:0⟫⟪k:1⟫⟪k:2⟫Par réflexe, il poussa de côté la fille qui était à califourchon sur lui."

#: scenario:scenario_1A37FEE3_0439_4DDF_B367_E6B25F979DAF
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 63aa7555c8e954ef75225c1939a3ca9ee96336cccf1767d13dc3264cda0765f6
#. default-sha256: de47f4170a4a8c777c898db18f5f54c300fecc31144248d29222d45f1c41a966
msgctxt "scenario:scenario_1A37FEE3_0439_4DDF_B367_E6B25F979DAF"
msgid ""
"⟪k:0⟫She rolled off the bed, landing on the cold floor, ⟪k:1⟫but slowly, gradually, she crawled "
"her way back toward him."
msgstr ""
"⟪k:0⟫Elle roula au bas du lit et atterrit sur le sol froid, ⟪k:1⟫mais lentement, peu à peu, elle "
"revint en rampant vers lui."

#: scenario:scenario_19CA1D14_E2F2_4A56_B339_D8285223D006
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 611bc1ec14acd65a33238c91fbd024a7dc1d793e615b4e015755b12c44e03092
