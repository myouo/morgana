#: scenario:scenario_D0C97E4B_BC63_43D6_8DF6_E6C0054A7994
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 0d69dccb97d5f6cc0cf62c76b6230f14c553f78a6b75daddac1f457db6f5fb48
#. default-sha256: 87ba58c9853fcaf35128531555caf64f9f853e64004d5555fd0849016b0279e5
msgctxt "scenario:scenario_D0C97E4B_BC63_43D6_8DF6_E6C0054A7994"
msgid ""
"⟪k:0⟫It never made sense to me!⟪k:1⟫⟪k:2⟫Why would she hire a maid she knew nothing about,⟪k:3⟫"
"someone who just showed up at the door one day?"
msgstr ""
"⟪k:0⟫Ça ne me paraissait pas logique !⟪k:1⟫⟪k:2⟫Pourquoi engagerait-elle une servante qu’elle ne "
"connaît absolument pas, quelqu’un qui s’est pointé à notre porte sans crier gare ?"

#: scenario:scenario_4A87CCE5_12D4_4F9D_90D0_8A64ABFFAC2B
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 7ab6b040ec2ca6d30bfeb32905a600a93544fb8d574fef0df06b3a43a23f1d81
