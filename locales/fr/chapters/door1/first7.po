msgid "⟪k:0⟫Indeed."
msgstr "⟪k:0⟫En effet."

#: scenario:scenario_CF942B2A_8573_4AC4_8405_038F9ECDAAF3
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 3253bfa118012c910c873ea796a8b17edab73992c091a52b2bfee77908ec80f5
