msgid "⟪k:0⟫And then— ⟪k:1⟫⟪k:2⟫Um, ⟪k:3⟫am I doing a good job?"
msgstr "⟪k:0⟫Et puis— ⟪k:1⟫⟪k:2⟫euh, ⟪k:3⟫est-ce que je m’en sors bien ?"

#: scenario:scenario_422A6650_3D5B_48B1_88A6_1234A389EB1A
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
