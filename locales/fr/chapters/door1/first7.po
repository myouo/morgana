msgctxt "scenario:scenario_E1D084C7_359D_451B_BB8F_83B19A632203"
msgid "⟪k:0⟫And eventually, the man..."
msgstr "⟪k:0⟫Et un jour, l’homme..."

#: scenario:scenario_75974E12_E17D_44D9_BEB4_06B56661AFD3
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: cc8aeb9fba16f8f7371543a90bc1ac996683d1bd5dbf6067a2fde6047b44d906
