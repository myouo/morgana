#: scenario:scenario_22DA36E8_B82A_485F_B079_E626A6377134
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 5577320dd4f24cc620491bd7ee68e882573b8d10fa0e013f7393ef5b9c51c8e3
#. default-sha256: 8d7a7a4e2a28ad87d55cf6062eb16e7c8e14e608c96ae901d17df2290b4ad412
msgctxt "scenario:scenario_22DA36E8_B82A_485F_B079_E626A6377134"
msgid ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫⟪k:4⟫⟪k:5⟫⟪k:6⟫⟪k:7⟫⟪k:8⟫Ahaha!⟪k:9⟫Sorry, sorry.⟪k:10⟫I didn’t mean to scare "
"you."
msgstr ""
