msgctxt "scenario:scenario_0BDEAF15_C627_4CAD_B87A_AAEA6E7F867C"
msgid "⟪k:0⟫What could be happening out there?"
msgstr "⟪k:0⟫Que pouvait-il bien se passer, dehors ?"

#: scenario:scenario_9A21B5F7_B0D2_4077_979B_BAA779AA217A
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 1ebf0f479d9a080faaa9b5e9c2a9765e11cf2252df7f1c43421042e5a5314a9e
