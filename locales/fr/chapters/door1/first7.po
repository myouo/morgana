msgctxt "scenario:scenario_5DD066D5_F911_4923_8D23_5AFFFF403A43"
msgid "⟪k:0⟫And then, the girl grew up."
msgstr "⟪k:0⟫Et puis, la fille grandit."

#: scenario:scenario_3ABF5463_D001_4F4A_A6C9_1C2026CFA592
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 01d92db0255ca090bcd5f126379530991f295f71124233733f2b9611e89fe3c5
