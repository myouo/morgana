msgctxt "scenario:scenario_F39C6EB2_6A99_4340_8145_03CBE6A4C640"
msgid "⟪k:0⟫She was afraid if she did, he would cease to send her letters."
msgstr "⟪k:0⟫Elle avait peur qu’il ne cesse de lui envoyer des lettres si elle le faisait."

#: scenario:scenario_EAADD9F5_3290_45CC_A62C_B6CE975B63F5
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: bfada89a6f091059e7f8f2dd0aa3d5ffd775700c989f68cfee53efa5ee663574
