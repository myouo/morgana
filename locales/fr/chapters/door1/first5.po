msgctxt "scenario:scenario_6BAFAE6E_9CFA_4034_B9CA_09A43E98FE76"
msgid "⟪k:0⟫Pardon me..."
msgstr "⟪k:0⟫Excusez-moi..."

#: scenario:scenario_47C5578B_0D2C_474E_B7F7_8B251BC9A834
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 7970dce832af1f2f84252d3982ee7a947e487f8e5818ca81fe041861203b58b6
#. default-sha256: 4678533355b61fbce987ea23524141ca41d547c0464a8e8f6739a24dbef425a1
msgctxt "scenario:scenario_47C5578B_0D2C_474E_B7F7_8B251BC9A834"
msgid ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫Hearing his footsteps, the young woman raised her head. ⟪k:3⟫She caught Mell’s "
"gaze and for a brief moment merely blinked at him in silence."
msgstr ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫La jeune femme leva la tête en entendant des pas approcher. ⟪k:3⟫Elle croisa le "
"regard de Mell et pendant un bref instant se contenta de cligner des yeux en silence."

