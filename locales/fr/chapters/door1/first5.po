msgctxt "scenario:scenario_B916317D_74AC_4EA2_8E2E_B2F35638D759"
msgid "⟪k:0⟫She appeared to be cleaning the hallway."
msgstr "⟪k:0⟫Elle nettoyait le couloir."

#: scenario:scenario_FA0A544E_4C83_42E0_BFF9_76604B25257C
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 3c7e1da8f0a176bf681a240a9c41623567d1b9982713921e9e3bfd21e93400a2
#. default-sha256: 8b0fd6ee383dc7e91aae5c691ba36873b94c2f19a7885522a3f6ecfa655f46ec
msgctxt "scenario:scenario_FA0A544E_4C83_42E0_BFF9_76604B25257C"
msgid ""
"⟪k:0⟫She traced along the wooden carvings lining the walls, making certain not to miss even a "
"speck of dust."
msgstr ""
"⟪k:0⟫Elle suivait le contour du bois le long des murs en s’assurant de ne manquer aucune tache de "
"poussière."

#: scenario:scenario_F4AA069C_9C81_4A60_BBB7_CD74309760F3
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 44425112825247cd1deb370c100de30a26a186b420c0d145715504565241d965
