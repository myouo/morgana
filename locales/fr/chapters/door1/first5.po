msgctxt "scenario:scenario_FA6A950A_915A_4A16_9051_F376D8BE7F22"
msgid "⟪k:0⟫And the White-Haired Girl Mell saw the night before was one such maid."
msgstr "⟪k:0⟫Et la Fille aux Cheveux Blancs que Mell avait vue la nuit d’avant en faisait partie."

#: scenario:scenario_4C756A1D_7E40_4A70_A30D_C7B42458823E
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 27cb95d250f69d254c8b68c38265cb8083e4ddeaf5d3364372ff4fce2af013b4
