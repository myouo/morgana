msgid "⟪k:0⟫⟪k:1⟫⟪k:2⟫N-⟪k:3⟫Nnh... ⟪k:4⟫nnnnh..."
msgstr "⟪k:0⟫⟪k:1⟫⟪k:2⟫Gn-⟪k:3⟫Gnnh... ⟪k:4⟫Gnnnh..."

#: scenario:scenario_F8AB5E67_7037_4224_AB7C_700B0CAAA4CC
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 92529605bc6b5ce4ba5b410d0fbb7888602429fee1811ddad044cb81df9e9696
#. default-sha256: b0e0661dcf2a5b0b862f5bb4c12f3b54ec2aaf7e2a676a19a1e4ca49c2bf7000
msgctxt "scenario:scenario_F8AB5E67_7037_4224_AB7C_700B0CAAA4CC"
msgid ""
"⟪k:0⟫⟪k:1⟫When she escaped back home, Nellie went straight to her room, locked the door, and "
"began sobbing."
msgstr ""
"⟪k:0⟫⟪k:1⟫De retour chez elle, Nellie se réfugia directement dans sa chambre, s’y enferma à "
"double tour et commença à sangloter."

#: scenario:scenario_D0C668EF_842A_47D6_BE44_D88B4989EA41
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: a14b0e789a247b057bd3fcc9bbfa0c8c8300209adf9879d18deebcca06285226
#. default-sha256: 1fc309feaa8b45ca2f30402e9f75e517add90d3d61db1ef398dd026b62fbbd51
msgctxt "scenario:scenario_D0C668EF_842A_47D6_BE44_D88B4989EA41"
msgid "⟪k:0⟫The waves of her sorrow came crashing effortlessly over the levees."
msgstr "⟪k:0⟫Les vagues de son chagrin venaient s’écraser sans effort sur leurs digues."

#: scenario:scenario_C53DB2DA_FA3D_46A2_B1F5_2C04ACCAB047
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 40885befd879702db365dd0d05bf83d685ac5f62899aa6c92c5e1d978064e887
#. default-sha256: c24ada43f3aea57ae737a1b77785a88353d7409f67644838bb6f996daf48aec5
msgctxt "scenario:scenario_C53DB2DA_FA3D_46A2_B1F5_2C04ACCAB047"
msgid "⟪k:0⟫Tears streamed through the cracked walls of the dams blocking her tear ducts."
msgstr ""
"⟪k:0⟫Les larmes ruisselaient à travers les fentes craquelées des barrages qui les bloquaient."

#: scenario:scenario_D1156FF3_8A4D_4CA6_B1E9_1CC2AA1D5D8D
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: b2f0308694ae0b2822ff1ba80e7ec53da61ac33b85dc8093293005f3d5b9fe9a
#. default-sha256: 9d236927a90884279f06ae3a02a6c840c0b020f4e53319ffdfeb9734e18585dc
msgctxt "scenario:scenario_D1156FF3_8A4D_4CA6_B1E9_1CC2AA1D5D8D"
msgid "⟪k:0⟫⟪k:1⟫⟪k:2⟫Mnh, ⟪k:3⟫w-⟪k:4⟫waaaah...⟪k:5⟫⟪k:6⟫Why... ⟪k:7⟫whyyyy?!"
msgstr "⟪k:0⟫⟪k:1⟫⟪k:2⟫Mnh, ⟪k:3⟫o-⟪k:4⟫ouaaaah...⟪k:5⟫⟪k:6⟫Pourquoi... ⟪k:7⟫Pourquooooiii ?!"

#: scenario:scenario_4FD5280C_D2E4_41C6_84F8_3EFF0F211A3B
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 04186611ad7446db8a3673bc909cc76426fed3e33bf91dfcdb8c7475002e908a
#. default-sha256: da02e43fa96d38016350324a0b09d92345750cb84df964fd1bd1262d8c4f3e27
msgctxt "scenario:scenario_4FD5280C_D2E4_41C6_84F8_3EFF0F211A3B"
msgid "⟪k:0⟫Why won’t you help me, Mell...?⟪k:1⟫⟪k:2⟫Why won’t you take my side...?"
msgstr ""
"⟪k:0⟫Pourquoi ne veux-tu pas m’aider, Mell... ?⟪k:1⟫⟪k:2⟫Pourquoi n’es-tu pas de mon côté... ?"

#: scenario:scenario_CD837617_0249_467E_B012_5B7224AF6386
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: fdd55b6a60384cbe58490db4f793276b9099d91dbf1441fedd5230a5eabd977c
#. default-sha256: aebe66440933c521c8272fec2ea1c1cda00cdada92fa1c871c9f5edf0bb40988
msgctxt "scenario:scenario_CD837617_0249_467E_B012_5B7224AF6386"
msgid ""
"⟪k:0⟫The decor in her room appeared blurry through her damp eyes. ⟪k:1⟫Memories of the day she "
"had it redecorated played back in her mind with crystal clarity."
msgstr ""
"⟪k:0⟫Le décor de sa chambre lui apparaissait flou à travers ses yeux humides. ⟪k:1⟫Des souvenirs "
"du jour où elle l’avait redécorée lui revinrent à l’esprit avec une pureté cristalline."

#: scenario:scenario_431871F8_0EF3_4EB2_AC86_087BD5C0D022
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: cc6e38ed981ee04e5b40560badc6df6d2d0e10edf580f0b99aaf17be56ad65d2
#. default-sha256: d193a38553707f1d5bbbf651bf16e35d3aae709cbcd35626c5a21aa7dfb3c03c
msgctxt "scenario:scenario_431871F8_0EF3_4EB2_AC86_087BD5C0D022"
msgid "⟪k:0⟫⟪k:1⟫She told me... ⟪k:2⟫she had no feelings for you!"
msgstr "⟪k:0⟫⟪k:1⟫Elle m’a dit... ⟪k:2⟫qu’elle ne ressentait rien pour toi !"

#: scenario:scenario_7881CD7C_0E4C_4F4B_95F8_62EC1FBEBEE8
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 151106bd5f98fd3f8c67c4544f1fd21584a7f7854a8a30e7e42067dfaf91dbce
#. default-sha256: 5035dfef5d925bee4664ff1ce58ffd1c32ed3ac4d2450939b0217986a0b0bb76
msgctxt "scenario:scenario_7881CD7C_0E4C_4F4B_95F8_62EC1FBEBEE8"
msgid "⟪k:0⟫⟪k:1⟫That liar!⟪k:2⟫⟪k:3⟫⟪k:4⟫That liar!⟪k:5⟫⟪k:6⟫"
msgstr "⟪k:0⟫⟪k:1⟫Menteuse !⟪k:2⟫⟪k:3⟫⟪k:4⟫Menteuse !⟪k:5⟫⟪k:6⟫"

#: scenario:scenario_BE9D3E3A_EC16_4BC5_8528_3DAA68428BC5
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 283007f525b93e0773da984b00df978eba4404a83b966feee4332a881be3d232
#. default-sha256: 9b7f585efea4040f50119e128694dca2d6f7dcac75224688dda0e81676190a2e
msgctxt "scenario:scenario_BE9D3E3A_EC16_4BC5_8528_3DAA68428BC5"
msgid ""
"⟪k:0⟫She let her emotions run wild, breaking glass craftworks, silver plates designed by famous "
"foreign artisans, flower vases, all sorts of things."
msgstr ""
"⟪k:0⟫Elle laissa ses émotions prendre le dessus et se mit à briser des œuvres en verre, des "
"assiettes en argent confectionnées par des artisans étrangers de renom, des vases et toutes "
"sortes d’autres choses."

#: scenario:scenario_179DAB7F_3499_4FDB_B483_45B8EC775B27
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 80c1cf8aa7a0ed994dcbe28b326e7c86fa895b1155776437aaef53b6439e265d
#. default-sha256: 43f283db58512ec93a50496b8f904430c5c5c659aca2ee9768b98021c0f0c8d8
msgctxt "scenario:scenario_179DAB7F_3499_4FDB_B483_45B8EC775B27"
msgid "⟪k:0⟫It was as though a beast had been set loose in her bedchamber."
msgstr "⟪k:0⟫C’était comme si une bête avait été libérée dans la chambre à coucher."

#: scenario:scenario_B812073A_9A8A_4DBD_8F0D_DE0CA1D9310D
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: b99684b24f7f362f25a3ff5353d22c9fd6c2db95518458cc363513e3231342b9
#. default-sha256: d5dfbea8168a7504cc13d5e1eeaab0fb9589f2f804a901c0daf5d521c94522b4
msgctxt "scenario:scenario_B812073A_9A8A_4DBD_8F0D_DE0CA1D9310D"
msgid "⟪k:0⟫⟪k:1⟫—!⟪k:2⟫"
msgstr "⟪k:0⟫⟪k:1⟫—!⟪k:2⟫"

#: scenario:scenario_30ECB1CF_30F8_4DF3_B4AB_9E1A23286DDF
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 135cb21304ecc73f03adcbb9241ddc1d92b691776ecc2f1e349c0e47a6623129
#. default-sha256: 82ee93a6eb916443a3bff35eee5738520199c7c506c919c5867a884a636182ad
msgctxt "scenario:scenario_30ECB1CF_30F8_4DF3_B4AB_9E1A23286DDF"
msgid ""
"⟪k:0⟫The vase she tossed shattered against a painting hanging on the wall, spraying water, "
"porcelain, and roses in every direction."
msgstr ""
"⟪k:0⟫Le vase qu’elle avait lancé se brisa contre un tableau accroché au mur, projetant de l’eau, "
"de la porcelaine et des roses dans toutes les directions."

#: scenario:scenario_84F082A5_A3E5_4E7E_8AC5_6484D5DC1230
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 310883ae453b8e9424e80bda5f1c00fce653b9f5761529a708993ed5e87b15c1
#. default-sha256: 83efba1688e0f5e0fd1091167dff98465cf8f29b519ecb230ac03dae30f4c377
msgctxt "scenario:scenario_84F082A5_A3E5_4E7E_8AC5_6484D5DC1230"
msgid "⟪k:0⟫It was the portrait she adored so dearly—⟪k:1⟫⟪k:2⟫of her and her brother."
msgstr "⟪k:0⟫C’était le portrait qu’elle aimait tant—⟪k:1⟫⟪k:2⟫ celui de son frère et d’elle."

#: scenario:scenario_3DABB154_376C_4289_A9E0_041E20822ACB
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 9dd8762dfc83a91b704bb690326c26f815f03ee7d5fb31e7377d8458fd288fa7
