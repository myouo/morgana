msgid ""
"⟪k:0⟫They lived in a country where the weather was nothing if not unpredictable. Rain was a "
"frequent occurrence there."
msgstr ""
"⟪k:0⟫Ils vivaient dans un pays où le temps était tout sauf prévisible. Il y pleuvait fréquemment."

#: scenario:scenario_9ABF9CB4_570D_4FD5_AD53_F5B891C609DA
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: b3f634b311d2dbc10fc4d3699a6e75199b63e269fd37b09eca4f283d28338d9a
