msgid "⟪k:0⟫⟪k:1⟫Huh? ⟪k:2⟫Why?!"
msgstr "⟪k:0⟫⟪k:1⟫Hein ? ⟪k:2⟫Pourquoi ?!"

#: scenario:scenario_DCB893DC_6670_47A0_BD44_6606BE247DA5
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: f50af4116f88b91411ca16f6da6a767cdc15df83df30f1703edb7e359d71145a
#. default-sha256: 4573ae02172987266631e48baad505376e077f73043d980f99014399e3bc08e3
msgctxt "scenario:scenario_DCB893DC_6670_47A0_BD44_6606BE247DA5"
msgid "⟪k:0⟫⟪k:1⟫Well, you know.⟪k:2⟫⟪k:3⟫You’re... ⟪k:4⟫about that age, Nellie."
msgstr "⟪k:0⟫⟪k:1⟫Tu sais bien.⟪k:2⟫⟪k:3⟫Tu vas... ⟪k:4⟫être en âge, Nellie."

#: scenario:scenario_58E28F15_FFFB_40BB_8FD0_F0A7225EED44
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 9946969cb07ff4761e810353676b999dadec80a4bd514e73ec767be98732b137
