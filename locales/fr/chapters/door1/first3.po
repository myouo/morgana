msgid "⟪k:0⟫⟪k:1⟫Oh, jeez, how did I get myself into this?"
msgstr "⟪k:0⟫⟪k:1⟫Oh ce n’est pas vrai, comment diable me suis-je retrouvé dans cette galère ?"

#: scenario:scenario_CF203C0A_1FA5_403E_A224_1159518A90E4
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 9b175af047f0969c77c52cae3271b9e45da96bae0da91eb47321b4192a6dc5ca
