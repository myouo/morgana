msgctxt "scenario:scenario_7676B9E7_B6A6_4D27_9D66_080D85ADA4E2"
msgid ""
"⟪k:0⟫No... ⟪k:1⟫No... ⟪k:2⟫None of it’s true...⟪k:3⟫⟪k:4⟫So I... ⟪k:5⟫I haven’t done anything "
"wrong..."
msgstr ""
"⟪k:0⟫Non... ⟪k:1⟫Non... ⟪k:2⟫Rien n’est vrai...⟪k:3⟫⟪k:4⟫Donc, je... ⟪k:5⟫je n’ai rien fait de "
"mal..."

#: scenario:scenario_7679B9E7_B6A6_4D27_9D66_080D85ADA4E2
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: a01065423822a94ba43d6c7faf94f6e4a4881016be24668d16358cc28657fdf7
