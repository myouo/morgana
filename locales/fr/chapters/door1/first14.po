#: scenario:scenario_7C893E1F_346E_4C9F_B42E_D76879C2965A
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: ddde836485ea3a2f7e69ed0c5c59aacae5436291b0dfe1dbd300c47e7b838a26
#. default-sha256: b879908db429253f8b532ae8544d14150a47e3dd909a392548810fc64ab135a6
msgctxt "scenario:scenario_7C893E1F_346E_4C9F_B42E_D76879C2965A"
msgid "⟪k:0⟫But despite that, he continued to run, knowing not where he was to head."
msgstr "⟪k:0⟫Malgré cela, il continuait de courir, sans savoir où il allait."

#: scenario:scenario_7007E2B4_607A_4FF5_8C31_8FF521D1D873
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 782e6895f622ec52196b1a904641edecb1c318987a16e33668588ca4551ecd8f
