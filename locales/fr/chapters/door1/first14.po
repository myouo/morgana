msgstr "⟪k:0⟫Pourquoi..."

#: scenario:scenario_6ED4B62B_E12E_4D5B_8D73_7EE2BC667616
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 3adc69f6f1c36ad964e2472a3ca28781ccf7d873c0ab33e5228044bad197f92b
#. default-sha256: 75c0d71d9e044f6d832b5639ba82a89770da291e077a1a543e0eb9db9b40725d
msgctxt "scenario:scenario_6ED4B62B_E12E_4D5B_8D73_7EE2BC667616"
msgid ""
"⟪k:0⟫Why won’t anyone tell me the truth?⟪k:1⟫⟪k:2⟫All I want... ⟪k:3⟫All I want is for someone to "
"tell me it’s not true!"
msgstr ""
"⟪k:0⟫Pourquoi personne ne veut me dire la vérité ?⟪k:1⟫⟪k:2⟫Tout ce que je veux... ⟪k:3⟫Tout ce "
"que je veux, c’est qu’on me dise que ce n’est pas vrai !"

#: scenario:scenario_C00DCF2D_6774_43CE_9214_83D0559ACD6E
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: bb0cc73a679b3d8db1e36b2de6b0a35231adc94c6900b52536966a8ccb892afb
#. default-sha256: c331168128549ec2a50979c740911de23497085956d7498d1edf9ed3596aaf02
msgctxt "scenario:scenario_C00DCF2D_6774_43CE_9214_83D0559ACD6E"
msgid "⟪k:0⟫Have I sinned?!⟪k:1⟫⟪k:2⟫No, I didn’t know anything!⟪k:3⟫⟪k:4⟫I didn’t know—"
msgstr ""
"⟪k:0⟫Ai-je péché ?!⟪k:1⟫⟪k:2⟫Non, je n’étais au courant de rien !⟪k:3⟫⟪k:4⟫Je ne savais pas—"

#: scenario:scenario_7676B9E7_B6A6_4D27_9D66_080D85ADA4E2
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: e3fbd6c7e3f95b062b79b80c57dcddf78849a6cf2dc0690086c23ecfffbd102e
