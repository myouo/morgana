#: scenario:scenario_A9C0F767_79A2_4DB6_92EC_132010EF2A30
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: ae93ec4987172c5472e489e72d65f2ebb7adc3a07b309a75db30a489ee9536f4
#. default-sha256: a275715cf595398db1f35a0f60e14b9503734decf63ee2c943f9eda36c0b89d4
msgctxt "scenario:scenario_A9C0F767_79A2_4DB6_92EC_132010EF2A30"
msgid ""
"⟪k:0⟫His head drooped feebly. ⟪k:1⟫He looked like a helpless little calf who had wandered, alone, "
"onto a dark, precarious mountain path with no end in sight."
msgstr ""
"⟪k:0⟫Sa tête s’affaissa légèrement. ⟪k:1⟫On aurait dit un petit veau sans défense qui se serait "
"aventuré, seul, sur un chemin de montagne escarpé et qui n’en verrait pas le bout."

#: scenario:scenario_8EAD7373_0AA2_4954_ACE6_8051992CE92A
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: bfb68d101b934cd41782649ad9bbaaf51d06495810fb645035cf8a0cce4d1e05
