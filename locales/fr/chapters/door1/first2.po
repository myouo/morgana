msgctxt "scenario:scenario_9C06200F_FA02_4610_AD3C_72E1EDC8970C"
msgid "⟪k:0⟫⟪k:1⟫Dearest, dearest Mell!⟪k:2⟫What took you so long?!⟪k:3⟫Where ever have you been?!"
