msgctxt "scenario:scenario_59C35A13_5718_45F5_A799_DCB0C19302C5"
msgid "⟪k:0⟫My apologies. I got a little sentimental there."
msgstr "⟪k:0⟫Mes excuses. Je me suis un peu laissé emporter par mes sentiments."

#: scenario:scenario_C3F7B179_289A_48F6_9B2D_F443D54B96B5
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
