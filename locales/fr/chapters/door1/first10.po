msgid ""
"⟪k:0⟫He held me in his arms and ran his fingers through my hair,⟪k:1⟫an apologetic look on his "
"face."
msgstr ""
"⟪k:0⟫Il me prenait dans ses bras, passait ses doigts dans mes cheveux⟪k:1⟫et me lançait des "
"regards comme pour s’excuser."

#: scenario:scenario_725EE1AB_2004_4A1B_89CD_9CF2B86B71A4
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
