msgctxt "scenario:scenario_5E3FFC92_40C2_4D6A_B331_110CB044A00F"
msgid ""
"⟪k:0⟫Having failed the Rhodes family, no one else would become his patron.⟪k:1⟫⟪k:2⟫Just as a "
"good reputation spreads, so too does a bad one."
msgstr ""
"⟪k:0⟫Comme il avait déçu les Rhodes, personne ne voulait plus de lui.⟪k:1⟫⟪k:2⟫Et une mauvaise "
"réputation se répand aussi vite qu’une bonne."

#: scenario:scenario_257ABE1B_D6AA_4061_8DE2_36D66AAF79EB
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 4dd4facf3f3c4fa52f8b2428278a4f6f497a1271e359729e9bcad2bedb447e90
