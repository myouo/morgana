msgctxt "scenario:scenario_1E2E1D6E_06C6_45D2_80D4_D0C1D86C8458"
msgid "⟪k:0⟫So please, tell me the reason.⟪k:1⟫⟪k:2⟫I’ll see to it that you’re taken care of..."
msgstr ""
"⟪k:0⟫Alors, je vous en prie, dites-moi pourquoi vous faites cela.⟪k:1⟫⟪k:2⟫Je ferai en sorte "
"qu’on s’occupe bien de vous..."

#: scenario:scenario_BCFAD436_5083_44A7_84B9_227F0CE440BC
