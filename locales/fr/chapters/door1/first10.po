msgid "⟪k:0⟫Does that not unnerve you?!"
msgstr "⟪k:0⟫Cela ne vous fait donc rien ?!"

#: scenario:scenario_4FAAD39A_106E_4511_82B7_E3B1C7C00DB0
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 1507382d70b499c6960d299da1a89934c8a7e4106736d8bfe1ac4be696615b10
