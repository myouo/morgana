msgctxt "scenario:scenario_A06ABDFD_7866_46D3_9E53_D3FFA5ABA2EC"
msgid "⟪k:0⟫Up until his last breath, he was only ever concerned about me..."
msgstr "⟪k:0⟫Jusqu’à son dernier souffle, il avait pour seule inquiétude mon bien-être..."

#: scenario:scenario_CD6E291F_755C_4BE7_B15C_D83003B2EADE
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 6cf5ac8a3040d8fffb70de25ff0fd88b00436f369d89fb5c2ba00f38ec7cf28e
