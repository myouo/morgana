msgctxt "scenario:scenario_571CF3A2_CEFA_4E6C_B91D_1E24807F6603"
msgid "⟪k:0⟫That was all he could do to earn a living."
msgstr "⟪k:0⟫C’était tout ce qu’il savait faire pour gagner sa vie."

#: scenario:scenario_31E38DAE_533E_41D5_88DF_D96EA452F213
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: d60c3b98c424c9f655530da588ac07a13196b2d536524d101c1474886ec7d152
