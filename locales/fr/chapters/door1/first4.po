msgctxt "scenario:scenario_7ECAFE70_D1A3_42A5_96B6_6E8AE01D54AA"
msgid "⟪k:0⟫She was, even at a glance, clearly not a lady of means."
msgstr ""
"⟪k:0⟫Il suffisait d’un coup d’œil pour constater qu’elle n’était clairement pas une dame de la "
"haute société."

#: scenario:scenario_9BAFB6E6_3C22_4B3A_A52F_DD247C3FEBEE
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: be433c37166e5bd2b5c1dec4861549243cfefc8fa9086724eece1a300eb09f22
