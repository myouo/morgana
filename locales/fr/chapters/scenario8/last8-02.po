msgid "⟪k:0⟫............"
msgstr "⟪k:0⟫............"

#: scenario8:scenario8_7DBA9456_045C_4B81_80D9_855C84B146AD
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 12768f5c15da2569edd0fc2eabcda190a9be875cb46059ec9276148fa5ca155a
#. default-sha256: 6abbee96673a09858f0cf2a96234a73e303040ebf4922b579872902ab8b46ee9
msgctxt "scenario8:scenario8_7DBA9456_045C_4B81_80D9_855C84B146AD"
msgid "⟪k:0⟫What... ⟪k:1⟫Why are you laughing?!⟪k:2⟫⟪k:3⟫Please spare me!"
msgstr ""
"⟪k:0⟫Quoi... ⟪k:1⟫Pourquoi est-ce que vous riez ?!⟪k:2⟫⟪k:3⟫Je vous en supplie, épargnez-moi !"

#: scenario8:scenario8_356BBD69_CC39_40EF_B716_3DC3E83C717F
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 5adedd1fba1d0940ab61fe5007bf3eaac5527fa29c124d37d894979f06619287
#. default-sha256: 8141026f514de4e7006e28b1a768eb71ba453edaadcecfe93b12641955e76157
msgctxt "scenario8:scenario8_356BBD69_CC39_40EF_B716_3DC3E83C717F"
msgid ""
"⟪k:0⟫And why—⟪k:1⟫⟪k:2⟫⟪k:3⟫⟪k:4⟫⟪k:5⟫⟪k:6⟫                                             ⟪k:7⟫"
"should I care?"
msgstr ""
"⟪k:0⟫Et qu’est-ce—⟪k:1⟫⟪k:2⟫⟪k:3⟫⟪k:4⟫⟪k:5⟫⟪k:6⟫                                             ⟪k:7⟫"
"que j’en ai à faire ?"

#: scenario8:scenario8_47E25499_1CB1_4FCD_812C_5E2E7E83CFEF
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 82ba920478fd0fa5d47a0f085cb5080e34676ff7a53deafe39d8a7a43281e157
#. default-sha256: a27ac58faf151d34ff17788c8648a031d8f381e0bf3bfd156fc39e8c48b99e2a
msgctxt "scenario8:scenario8_47E25499_1CB1_4FCD_812C_5E2E7E83CFEF"
msgid "⟪k:0⟫Look at this..."
msgstr "⟪k:0⟫Regardez-moi ça..."

#: scenario8:scenario8_7A46B2FE_18AB_4BAF_89BD_43662D335722
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: bd714718455379b8c4e97a803ce4bc083dc2627904041716ca7579270cf44e25
#. default-sha256: f324ef7a9ce0273ec346431f01958aec2f3ec6b0a684ca45fac9fd9ea14d2278
msgctxt "scenario8:scenario8_7A46B2FE_18AB_4BAF_89BD_43662D335722"
msgid "⟪k:0⟫They stood no chance against my strength!"
msgstr "⟪k:0⟫Ils n’ont aucune chance contre ma force !"

#: scenario8:scenario8_B7204B16_FEB5_4ED8_9B3C_52F11A5F5D88
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 344dfdd543961ea2434db5204239689092aa4b062ee4d41600dd7a68ed1ed087
#. default-sha256: 0512a5e70797249d452b671c29b251de6951687e1a9aac3138773589ae90a996
msgctxt "scenario8:scenario8_B7204B16_FEB5_4ED8_9B3C_52F11A5F5D88"
msgid ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫After taking the keys off one of the slave traders, I returned to the carriage, "
"doing my best to act calm and suppress the bubbling exhilaration."
msgstr ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫Après avoir pris les clefs des marchands d’esclaves, je retournai au chariot en "
"faisant de mon mieux pour agir calmement et pour maîtriser mon hilarité grandissante."

#: scenario8:scenario8_22D704DB_3077_46C5_B94C_2FE52D04285E
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: d88554a87dc59187e80b744863ce94a9ed24b9b40358f7a85508db7f75cc59c4
#. default-sha256: aa9dcbfc08d54dbb27effaa6a5064be61d781cab41f56450644166f8393fe89e
msgctxt "scenario8:scenario8_22D704DB_3077_46C5_B94C_2FE52D04285E"
msgid "⟪k:0⟫⟪k:1⟫You.⟪k:2⟫"
msgstr "⟪k:0⟫⟪k:1⟫Oh, toi.⟪k:2⟫"

