#: scenario8:scenario8_9BDA91B8_539C_4F5D_847A_7DA133F4322E
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 6c9b2bfdcf675ddd4254c5cf556a5eae7bc7008e7d7961ee0acff5c7e4839dce
#. default-sha256: 7296e9f9b04f37d80cc5287c15020d07e18b3a4d20b8cd3a2d9234f31c791fbb
msgctxt "scenario8:scenario8_9BDA91B8_539C_4F5D_847A_7DA133F4322E"
msgid "⟪k:0⟫Her response perplexed me to no end."
msgstr "⟪k:0⟫Sa réponse me laissa perplexe au plus haut point."

#: scenario8:scenario8_EC49C8BB_5FDB_4AE8_9EBB_AA9063A1CF4E
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 3770b43023cbbc4c61c034d2d459b3a8ed2d498a593fc8916c37cd4d4a36b91e
#. default-sha256: da4f88751e0ba337362ef83923bf2dd3e451a2dd395ea724f509f9722e6f3ab8
msgctxt "scenario8:scenario8_EC49C8BB_5FDB_4AE8_9EBB_AA9063A1CF4E"
msgid ""
"⟪k:0⟫Why was she concerned about showing gratitude?⟪k:1⟫⟪k:2⟫Why was she not despairing of her "
"own circumstances?"
msgstr ""
"⟪k:0⟫Pourquoi se souciait-elle de témoigner sa gratitude ?⟪k:1⟫⟪k:2⟫Pourquoi n’était-elle pas "
"désespérée par sa propre situation ?"

#: scenario8:scenario8_588F204E_BD55_492F_AE46_FEE88E4B0992
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 45cb981fa8f5752f7206abf3f43d585cd83f15e822e9c62e7b97756610122b46
#. default-sha256: bec6951cfc3d70b482ed51cc942735602316d01e13a2533babca787437f86104
msgctxt "scenario8:scenario8_588F204E_BD55_492F_AE46_FEE88E4B0992"
msgid ""
"⟪k:0⟫Why was ⟪k:1⟫that⟪k:2⟫ the emotion that gripped her in that moment,⟪k:3⟫not hatred for the "
"slave trader or sorrow for herself?"
msgstr ""
"⟪k:0⟫Pourquoi est-ce qu’elle était en proie à cette émotion-là maintenant,⟪k:1⟫et non à de la "
"haine envers le marchand d’esclaves ou du chagrin pour elle-même ?"

#: scenario8:scenario8_E741F2EC_7327_47BE_A7F8_6829F55F4BD7
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 44d7349c12e51a2a52e42b07f8f6f42713a27a7b5a7dfbafb74069a909598860
#. default-sha256: 6cec33d4ba982f64f5d6abf498b75e4e1f16251ff0c238425d1e26c844d557de
msgctxt "scenario8:scenario8_E741F2EC_7327_47BE_A7F8_6829F55F4BD7"
msgid "⟪k:0⟫But that wasn’t the only thing I found curious—"
msgstr "⟪k:0⟫Mais ce ne fut pas la seule chose que je trouvai curieuse—"

#: scenario8:scenario8_5208504F_1AAE_4F72_B6CB_E7190415914C
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 40e794945bb9f6c809a3db2273214610b25cacd36eed1035402e6fded60c5e7b
#. default-sha256: e2f0e5f355caee1dbd673312dea56b08f0ff6bf89c631c13868310093faa09e4
msgctxt "scenario8:scenario8_5208504F_1AAE_4F72_B6CB_E7190415914C"
msgid "⟪k:0⟫untainted by its surroundings, gently undulating."
msgstr "⟪k:0⟫intacte, pure, non contaminée par ce qui l’entoure, ondulant gentiment."

#: scenario8:scenario8_E504084A_9C20_45F3_912C_A7D0B10F5E4A
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 797cd5c8bbee8a13a54d7a094b2d54593d07436fedb4dd286c2b3ae208557d99
#. default-sha256: fc5bd7d2ddfe0c36cdd4bcae265a987adb2f74ba779f9943e7ef0fe154de89dd
msgctxt "scenario8:scenario8_E504084A_9C20_45F3_912C_A7D0B10F5E4A"
msgid ""
"⟪k:0⟫One sentence was all she said, but there was something unbelievably calming about the sound "
"of it."
msgstr ""
"⟪k:0⟫Elle n’avait dit qu’une seule phrase, mais il y avait quelque chose d’incroyablement "
"apaisant dans la façon dont elle l’avait dite."

#: scenario8:scenario8_B8A4CC39_B636_4246_8280_80E8593A0BC9
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 633b91c1d9e1f61d84eca5acbab131e02b2dac108e1a8f5eb957ffa6bb7e1342
#. default-sha256: f775d367c0c955993b9495307d5715ef53c50a7212ff81176b85bfcdef91607c
msgctxt "scenario8:scenario8_B8A4CC39_B636_4246_8280_80E8593A0BC9"
msgid ""
"⟪k:0⟫I wanted to get her out of that filthy carriage,⟪k:1⟫⟪k:2⟫to undo the shackles threatening "
"to taint her."
msgstr ""
"⟪k:0⟫mais je voulus la libérer de ce chariot crasseux,⟪k:1⟫⟪k:2⟫lui enlever ces chaînes qui "
"menaçaient de la souiller."

#: scenario8:scenario8_A6C67B8C_AC73_47DE_B7BA_2A35F735CC4D
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 1bba2b3d64baef8b0e89f12af43f80b65e572c1c14eb1662a89fb8d43a523c6f
#. default-sha256: 3c9e834923489724d43d9bdd7d713f87ac538e8ebcaf35cbd4bdce70840d30a9
msgctxt "scenario8:scenario8_A6C67B8C_AC73_47DE_B7BA_2A35F735CC4D"
msgid "⟪k:0⟫Please! Y-⟪k:1⟫You can have all my money!⟪k:2⟫You can go free, if that’s what you want!"
msgstr ""
"⟪k:0⟫Je vous en prie ! V-⟪k:1⟫Vous pouvez avoir tout mon argent !⟪k:2⟫Vous pouvez être un homme "
"libre, si c’est ce que vous voulez !"

#: scenario8:scenario8_E9304167_6DA8_4048_B3A9_C40F51B84193
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
