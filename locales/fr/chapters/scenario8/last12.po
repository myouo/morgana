msgid "⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫Yes?"
msgstr "⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫Oui ?"

#: scenario8:scenario8_0357EF2B_3EF5_4C3A_BAC0_D828E0C3AB1A
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: ef526585aae8394e0c24af1cf7aa5017051b53d8e8d9457119ff2869aea8faec
