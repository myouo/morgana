msgid "⟪k:0⟫⟪k:1⟫I wasn’t able to prevent Morgana’s death,"
msgstr "⟪k:0⟫⟪k:1⟫Je n’ai pas pu empêcher la mort de Morgana,"

#: scenario8:scenario8_5936BA73_B67E_4639_9327_7606198B04B6
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: efe7675a679293b4e928dff8dd5e6dafa445f9ab7d9a35c4014130fd79a26ec4
