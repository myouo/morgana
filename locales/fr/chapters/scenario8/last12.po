#: scenario8:scenario8_AED42863_A424_4B04_8542_1D46FD5715DA
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: f9ee4b27b831f098ac3d85c143e2e0fd179ade76f423ca733eb17e19fd6ca7a8
#. default-sha256: 2ef527f23bf7fdf54db50cfd40fe0735ae71555e7a38e27162796994cbe39d74
msgctxt "scenario8:scenario8_AED42863_A424_4B04_8542_1D46FD5715DA"
msgid "⟪k:0⟫⟪k:1⟫He opens the door, heading the four-man procession out of the tower, as he had in."
msgstr ""
"⟪k:0⟫⟪k:1⟫Il ouvre la porte, prenant la tête de la procession des quatre hommes hors de la tour, "
"comme il l’avait fait à l’aller."

#: scenario8:scenario8_C1DB5E46_FA01_4DD6_8F5E_004447434A7E
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 2c1761ece378f5b11158773c0d60429372fcb4b09077b9ba062ce4e7896976ba
#. default-sha256: f529c8d59b1afb08d012a30c29458d558c95c8969cc86b508df38256e804bc8f
msgctxt "scenario8:scenario8_C1DB5E46_FA01_4DD6_8F5E_004447434A7E"
msgid "⟪k:0⟫I walk at the back of the line."
msgstr "⟪k:0⟫Je marche à l’arrière de la file."

#: scenario8:scenario8_B95A895B_0AE5_4A8E_B7B5_384C42CA534F
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 2b70b7a57373958943db4cfca149011349d52ef5a967136efcc29a8f967a3549
#. default-sha256: f5d8be56a54e943bac777345743740e6757ecfe9bf73e716d7bffd098598e9d5
msgctxt "scenario8:scenario8_B95A895B_0AE5_4A8E_B7B5_384C42CA534F"
msgid ""
"⟪k:0⟫Each step they take down the spiral staircase is slow and ponderous,⟪k:1⟫⟪k:2⟫as if weighted "
"down by the knowledge of their sins."
msgstr ""
"⟪k:0⟫Chacun de leurs pas franchis en descendant l’escalier en spirale est lent, grave, réfléchi,"
"⟪k:1⟫ comme s’ils étaient tous alourdis par la culpabilité de leurs péchés."

#: scenario8:scenario8_BEE19C25_4387_4098_BC3E_91D6906BBC5A
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 2f0f0e94af597ba0487bf0f963655c5ae5e95002e2ed427d86c8790c1ee14c55
#. default-sha256: 84e3eca505a8ab04728869785ea872cabd9dcd17a280981d3029276bc42cf1ec
msgctxt "scenario8:scenario8_BEE19C25_4387_4098_BC3E_91D6906BBC5A"
msgid "⟪k:0⟫That they must make their way..."
msgstr "⟪k:0⟫Ils ont conscience qu’ils doivent se diriger..."

#: scenario8:scenario8_C4712DCB_C162_4710_879A_2EEF4DA9452E
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 36a4cc19401a034072be40ec0ca2a369809ea21a73503fdec5927bb285c6be88
#. default-sha256: 47e3aed644fb8b9aa75d0ae79f3e5e801c8df7c93a860990de47922a1d009a04
msgctxt "scenario8:scenario8_C4712DCB_C162_4710_879A_2EEF4DA9452E"
msgid "⟪k:0⟫to the place they will make their atonement."
msgstr "⟪k:0⟫...vers le lieu de leur expiation."

#: scenario8:scenario8_C16EBD60_51C9_4BC5_8094_E87636C13BEB
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: e31ca7d582026456aa17bc58c142d5daf989cc79df0ef9efbb1dc84ae9e0751c
