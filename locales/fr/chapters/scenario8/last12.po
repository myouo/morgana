msgctxt "scenario8:scenario8_5936BA73_B67E_4639_9327_7606198B04B6"
msgid "⟪k:0⟫but I ⟪k:1⟫was⟪k:2⟫ able to uncover the truth."
msgstr "⟪k:0⟫mais j’ai quand même réussi à découvrir la vérité."

#: scenario8:scenario8_423170AA_9BC6_400F_8FD8_60750E032EA6
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 8f3ef255cceea862c05c8ae326c6661c6a59d70df715f488b1150a63ab710514
