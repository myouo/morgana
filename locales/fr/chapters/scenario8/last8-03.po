#: scenario8:scenario8_4AF3C7D2_339F_448B_B256_1268AAE11D3D
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 8bd0c8d7298f6694abf468d6061408d41c7de05522ebceb0fc89bc1f9f26b2b0
#. default-sha256: eb59fa2884e28cb215e2d13c7a939367f1e108b88162e6c2544361d347a1efb1
msgctxt "scenario8:scenario8_4AF3C7D2_339F_448B_B256_1268AAE11D3D"
msgid ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫⟪k:4⟫⟪k:5⟫⟪k:6⟫⟪k:7⟫⟪k:8⟫⟪k:9⟫⟪k:10⟫⟪k:11⟫⟪k:12⟫⟪k:13⟫⟪k:14⟫⟪k:15⟫As you "
"know, I am not from this land."
msgstr ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫⟪k:4⟫⟪k:5⟫⟪k:6⟫⟪k:7⟫⟪k:8⟫⟪k:9⟫⟪k:10⟫⟪k:11⟫⟪k:12⟫⟪k:13⟫⟪k:14⟫⟪k:15⟫Comme vous "
"le savez, je ne viens pas de ce pays."

#: scenario8:scenario8_F654B6ED_85D3_4495_9C45_7DB4B48E14FC
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: a1680d23c38238e894c50a41f433c8841ad36b947bd6faed659efd05a433600d
#. default-sha256: 9648da854db56c583c35edfb3082ee02960acafd23f2e862794b95c5dc6b50f7
msgctxt "scenario8:scenario8_F654B6ED_85D3_4495_9C45_7DB4B48E14FC"
msgid "⟪k:0⟫⟪k:1⟫The issue is,"
msgstr "⟪k:0⟫⟪k:1⟫Le problème,"

#: scenario8:scenario8_7CA8498D_9531_4EE3_B774_EF2F2164929C
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 473416c9e7153465d095adc9bb37c2ae4ed58ff9bd88b43b6a9f2f2fdfc34179
#. default-sha256: fb74697bbf87394c7ceca05558cde1cd2f40ff8f20c389e99a80e148f79c346e
msgctxt "scenario8:scenario8_7CA8498D_9531_4EE3_B774_EF2F2164929C"
msgid "⟪k:0⟫⟪k:1⟫I don’t know any more about where I came from than you."
msgstr "⟪k:0⟫⟪k:1⟫c’est que je ne sais pas pour autant d’où je viens, comme vous."

#: scenario8:scenario8_62E45312_CA49_40BA_A281_F36395ADB333
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: d445f8f1100e272799bcced26e4203ba7c4cb827f8ae543e6dc708b5764b72e0
#. default-sha256: 5c081bd16addcf2a0763118de3f1e5a9648bf90d6d68850ac6a972cc3bc575cb
msgctxt "scenario8:scenario8_62E45312_CA49_40BA_A281_F36395ADB333"
msgid "⟪k:0⟫⟪k:1⟫most of my memories are gone."
msgstr "⟪k:0⟫⟪k:1⟫j’ai perdu la plupart de mes souvenirs."

#: scenario8:scenario8_46ABE5C8_45D1_4BD6_B048_61D189617F6A
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 3e7083c4073d843e201a614f219223e0c44b4afd0525441c4420cc0499031717
#. default-sha256: d92c34b3b7ed3dfaad5909cc2ea7882e8a346b5bf43b42b5a74c8024eab41afa
msgctxt "scenario8:scenario8_46ABE5C8_45D1_4BD6_B048_61D189617F6A"
msgid "⟪k:0⟫or perhaps a messenger."
msgstr "⟪k:0⟫ou j’étais peut-être un messager."

#: scenario8:scenario8_EB475B59_2055_49A4_8FC2_25857E677057
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 3656d182e2714903f31d244ee538acffb9aa05696efc6fcd835308a63ffa0d37
#. default-sha256: f2b7a49453ae32b281356aa070cf8de48b2a89961d3eea52839c7e48a4e2c417
msgctxt "scenario8:scenario8_EB475B59_2055_49A4_8FC2_25857E677057"
msgid ""
"⟪k:0⟫I vaguely remember being waylaid.⟪k:1⟫⟪k:2⟫We were vastly outnumbered, massacred with little "
"resistance.⟪k:3⟫⟪k:4⟫Or at least, I assume that’s what happened."
msgstr ""
"⟪k:0⟫Je me souviens vaguement d’une embuscade.⟪k:1⟫⟪k:2⟫On était largement dépassé par le nombre "
"d’assaillants, qui nous massacrèrent sans aucune résistance ou presque.⟪k:3⟫⟪k:4⟫Ou du moins, je "
"pense que ça s’est passé ainsi."

#: scenario8:scenario8_91A0BF4C_661D_4FD5_92CC_7791798CE7F3
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: d40d209be1a86f972fa019f0e69cec17beebce77eecebb1086168fb475e0800d
#. default-sha256: 404c5f58ab615d54bad39536f0948b93c4b2311789dd0db7a45b3608952d4ea6
msgctxt "scenario8:scenario8_91A0BF4C_661D_4FD5_92CC_7791798CE7F3"
msgid ""
"⟪k:0⟫I was a slave for one grueling, torturous year.⟪k:1⟫⟪k:2⟫No one treated me like a human "
"being.⟪k:3⟫⟪k:4⟫There was no one from the same part of the world as me."
msgstr ""
"⟪k:0⟫Je suis resté leur esclave pendant une année. Un an de sévices, de tortures en tout genre."
"⟪k:1⟫⟪k:2⟫Aucun d’entre eux ne me traitait comme un être humain.⟪k:3⟫⟪k:4⟫J’étais le seul à venir "
"d’une autre partie du monde."

#: scenario8:scenario8_D0CD0533_F04D_43F6_BA35_FF5B6565F2CC
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 079e343fd21e4eecce85f869abd05d51e454c1f8f645a4771ca7fbb403656693
#. default-sha256: 4400dd89d82d3186d341896b3bdf9f9ade0a52b51fe4f433469a92612256762f
msgctxt "scenario8:scenario8_D0CD0533_F04D_43F6_BA35_FF5B6565F2CC"
msgid "⟪k:0⟫And there was no one to come to my aid."
msgstr "⟪k:0⟫Et il n’y avait personne pour me venir en aide."

#: scenario8:scenario8_B49E446F_A5CA_4682_9308_20113A8DA388
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: e88502fae47e638d392dd30cdba93dec1c88ce68121739fd4196c1a8be0bb6e7
#. default-sha256: 96c7a5a197b1f08d061e4cc683f5ed25ec2597f35d6ef1f3e74714e9cfa31083
msgctxt "scenario8:scenario8_B49E446F_A5CA_4682_9308_20113A8DA388"
msgid ""
"⟪k:0⟫But to be honest, I think I was happier ⟪k:1⟫not⟪k:2⟫ understanding what people were saying "
"about me."
msgstr ""
"⟪k:0⟫Pour être honnête, je crois que j’étais bien mieux loti quand je ne comprenais ⟪k:1⟫pas⟪k:2⟫ "
"ce qu’ils disaient de moi."

#: scenario8:scenario8_5C79E8CC_1756_4827_82A1_033BDCF716E7
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 7b8e742014a1db84b8b24d38e0e0b25bbba0688fb68889bd019fed8f8a733d1f
#. default-sha256: dbeb016d2f14333c5ec413f6f4c5d9729d7eb88c265c918f24e52edccbbf4f06
msgctxt "scenario8:scenario8_5C79E8CC_1756_4827_82A1_033BDCF716E7"
msgid ""
"⟪k:0⟫And the longer I was treated as something less than human,⟪k:1⟫the more I began to question "
"whether I really ⟪k:2⟫was⟪k:3⟫ one."
msgstr ""
"⟪k:0⟫Et moins j’étais traité en être humain,⟪k:1⟫plus je commençais à me demander si j’en étais "
"vraiment un."

#: scenario8:scenario8_5D4E2E70_2BA6_4308_8F92_A45288D8602A
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 993d9d6223ee0629c660d9865d51c5781f53c00b310fe0da254b57635b7c8a3b
#. default-sha256: 4587cdba74c8cbf6a560fb6fbb0b8813d60e34fd34faf2f8c5aecba4732ac2f6
msgctxt "scenario8:scenario8_5D4E2E70_2BA6_4308_8F92_A45288D8602A"
msgid ""
"⟪k:0⟫It was packed front to back with slaves—⟪k:1⟫⟪k:2⟫⟪k:3⟫or soon-to-be slaves, I suppose I "
"should say."
msgstr ""
"⟪k:0⟫Il était rempli à craquer d’esclaves—⟪k:1⟫⟪k:2⟫⟪k:3⟫ou plutôt, de futurs esclaves, devrais-"
"je dire."

#: scenario8:scenario8_5598B724_4321_4338_A2FA_062604A78166
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 1219fb3c2e18789f9eb2f61374f3548773189d5506cd621ece039aa5402c2788
#. default-sha256: 3cf5404d78a3eca3ff00e271277d7c0b23f2bbfdcaa348198a70dc7dd6f22664
msgctxt "scenario8:scenario8_5598B724_4321_4338_A2FA_062604A78166"
msgid ""
"⟪k:0⟫But beyond that, I didn’t think much of it.⟪k:1⟫⟪k:2⟫I didn’t find it disturbing or "
"unpleasant..."
msgstr ""
"⟪k:0⟫Mais à part ça, je n’y prêtai pas plus attention que ça.⟪k:1⟫⟪k:2⟫Je ne trouvais pas ça "
"déplaisant ou dérangeant..."

#: scenario8:scenario8_B22846FD_AE3C_4CE5_B1E7_CBF181370F41
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: bf7632d2fc154b7b94aace407b58e2b24e5e1303545460cff713a091be0726d9
#. default-sha256: 00c017cc6c208152d067910468c1a534248eaf1edb97851ca553483db8353ee7
msgctxt "scenario8:scenario8_B22846FD_AE3C_4CE5_B1E7_CBF181370F41"
msgid ""
"⟪k:0⟫At my question, the girl turned her head up to look at me.⟪k:1⟫⟪k:2⟫Surprise crossed her "
"face for a few brief seconds,⟪k:3⟫but that was her only reaction to my appearance."
msgstr ""
"⟪k:0⟫⟪k:1⟫À⟪k:2⟫ ma question, la fille leva la tête pour me regarder.⟪k:3⟫⟪k:4⟫La surprise "
"traversa son visage un bref instant,⟪k:5⟫mais ce fut la seule réaction à mon apparence."

#: scenario8:scenario8_90FE4610_3F11_4A96_8E4F_A3D7F00D11B6
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 6f07a8258e0d1f475716971ebd573ede11b6eda528d9ca19bbbcc1fcdee89c01
#. default-sha256: 00b08eb7b3f12bc1012b4844e7c3244b2285f5b1519d50be6c848e1c0636a55c
msgctxt "scenario8:scenario8_90FE4610_3F11_4A96_8E4F_A3D7F00D11B6"
msgid ""
"⟪k:0⟫I assume her thought process was roughly the same as mine, so she felt no need to fear me."
msgstr ""
"⟪k:0⟫Elle devait penser à peu près la même chose que moi, donc elle ne ressentait pas le besoin "
"de me craindre."

#: scenario8:scenario8_85A2FDBC_1AFC_48DF_AC4C_7707E3DE1EB4
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: b1149d15f8f86e8f15eec54e5a8a6f7b528d4408a5b03ac60c878f637c115042
#. default-sha256: e89a09765086aa4bf4c549cdce2907b82e4d8ae6f139637576a1072fcd5f3eb1
msgctxt "scenario8:scenario8_85A2FDBC_1AFC_48DF_AC4C_7707E3DE1EB4"
msgid "⟪k:0⟫I’m sad because I didn’t get the chance to show my gratitude to people very dear to me."
msgstr ""
"⟪k:0⟫Je suis triste parce que je n’ai pas eu la chance de témoigner ma gratitude envers ceux que "
"j’aime."

#: scenario8:scenario8_587E1576_703A_451D_82BC_2C5A4C09DD62
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: cad73f46aac78dce8a81580d390a7bb101f0ac0ad9b708f6a3f9c82094c0fdbb
#. default-sha256: 477e41d2ea67085caf4fadf73a8fb2085628dfe40fcb3f85256ba5c02c227dc2
msgctxt "scenario8:scenario8_587E1576_703A_451D_82BC_2C5A4C09DD62"
msgid "⟪k:0⟫her voice, despite being soft, cut through the crying and wailing of the other slaves."
msgstr "⟪k:0⟫sa voix, tout en étant douce, dominait les cris et les plaintes des autres esclaves."

#: scenario8:scenario8_A555FD47_344D_49EA_8C98_1E6339700658
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 45d7d8763807ddcc5d35f7224d8fa507d3d0c7cf85dc317ca135cdd32f59ea8b
#. default-sha256: 337c08c438305ed188fea9a15c037aa7842166043e10c59c8014245d82ce3dd6
msgctxt "scenario8:scenario8_A555FD47_344D_49EA_8C98_1E6339700658"
msgid "⟪k:0⟫I pictured it like... ⟪k:1⟫a single patch of clear water in the middle of a swamp,"
msgstr ""
"⟪k:0⟫Je me la représentais comme... ⟪k:1⟫un unique havre d’eau claire au milieu d’un marécage,"

#: scenario8:scenario8_1523D91D_0AAD_47FB_85DC_F5D0923DFD5B
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: b8d1f27f61b5a7f73d3939d5685ef6e9423d603428d3e8cb59b249af2897b92a
#. default-sha256: eb7722e7179a686a483995f98cde5f5d1d0bd85ebc844d0ec032f4541ae73556
msgctxt "scenario8:scenario8_1523D91D_0AAD_47FB_85DC_F5D0923DFD5B"
msgid "⟪k:0⟫I’ll apologize... ⟪k:1⟫anything!"
msgstr "⟪k:0⟫Je vous présenterai mes excuses... ⟪k:1⟫tout ce que vous voudrez !"

#: scenario8:scenario8_D8E48D86_DFF4_4599_8060_1E6E498FA011
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 1811f75d3f4e2e81c3afd5e1515602c13ac3341aa9d80353b155fb66b99948b1
#. default-sha256: 48f41697b22461c825c2f67ac00db3078091b23a05c42741f58ec0ffc02c435d
msgctxt "scenario8:scenario8_D8E48D86_DFF4_4599_8060_1E6E498FA011"
msgid "⟪k:0⟫............"
msgstr "⟪k:0⟫............"

#: scenario8:scenario8_089B583B_F350_4F78_9032_45D919E1EB2B
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: b978f62b9e383ecb4d9c842265ff6d01d71ac6e0da639577ac7651c71008d457
#. default-sha256: ad48a237b0005d7ee5ca3dd4a5113f0a10c053f849f3d638bf2c40f2b6431587
msgctxt "scenario8:scenario8_089B583B_F350_4F78_9032_45D919E1EB2B"
msgid "⟪k:0⟫Ahahahahahahaha!"
msgstr "⟪k:0⟫Ahahahahahahaha !"

#: scenario8:scenario8_4383889C_5F68_4126_A404_75D6368BC473
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: f9b33415ea3bcc6eb56385308220624eb12512476a630716a66b339904cef51a
#. default-sha256: fade97ed19d1349d323009d03542e8574991b2f67d962e16243c822d17a16464
msgctxt "scenario8:scenario8_4383889C_5F68_4126_A404_75D6368BC473"
msgid ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫⟪k:4⟫⟪k:5⟫Holding a sword in my hand felt amazingly... ⟪k:6⟫⟪k:7⟫right⟪k:8⟫."
"⟪k:9⟫⟪k:10⟫Whatever work I once did must have required me to use a blade."
msgstr ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫⟪k:4⟫⟪k:5⟫La sensation de tenir une épée en main était incroyable... ⟪k:6⟫je "
"me sentais tellement ⟪k:7⟫bien⟪k:8⟫.⟪k:9⟫⟪k:10⟫Je devais certainement avoir déjà manié des lames "
"dans un de mes précédents travaux."

#: scenario8:scenario8_89902CC0_AFC6_42A0_A5A4_BBC64B3B4FC1
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 406502000112f3d469980ce6ae0fa19868dd8e372531798cdebd2f8695d578b8
#. default-sha256: 86c4568c039b2a694867d01e92e30e9d1c86012147cc1913babe24dbc21c3573
msgctxt "scenario8:scenario8_89902CC0_AFC6_42A0_A5A4_BBC64B3B4FC1"
msgid ""
"⟪k:0⟫Dead bodies sprawled out around me.⟪k:1⟫⟪k:2⟫Corpses I had made. Lives I had snuffed out."
msgstr ""
"⟪k:0⟫Des morts jonchaient le sol qui m’entourait.⟪k:1⟫⟪k:2⟫J’en avais fait des cadavres. J’avais "
"éteint ces vies."

#: scenario8:scenario8_0A0C1F49_22F0_451C_B592_62052AAB7555
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 87b718912e01d06adbd6c5d977fd4e3e1104b6fcd59f032054f5d82232522fad
#. default-sha256: 587f572c4df987ec14f9d3fecbe1969fb8d0c5b10b7810adf3fc653a3e62749a
msgctxt "scenario8:scenario8_0A0C1F49_22F0_451C_B592_62052AAB7555"
msgid ""
"⟪k:0⟫I don’t have the words to describe the high it gave me killing those men, the power I felt "
"over them."
msgstr ""
"⟪k:0⟫Je n’ai pas les mots pour décrire l’ivresse que je ressentais à tuer ces hommes, le pouvoir "
"qui m’enivrait."

#: scenario8:scenario8_ECE749DB_420F_4DC2_AB04_C067F0CDB9CE
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 7e5c78ce5f40688290e00294d1f75f70394174f67ddc1228e73eb917c2a93923
#. default-sha256: 784291bbec4200ea6eca4abc46d47a585fb6d470d53d409ba0191df46ee1414e
msgctxt "scenario8:scenario8_ECE749DB_420F_4DC2_AB04_C067F0CDB9CE"
msgid ""
"⟪k:0⟫I was driven mad by the stench of blood filling the air.⟪k:1⟫⟪k:2⟫No, it just drew out what "
"was always there."
msgstr ""
"⟪k:0⟫J’étais rendu fou par l’odeur du sang qui emplissait l’air.⟪k:1⟫⟪k:2⟫Non, en réalité elle ne "
"faisait qu’attiser ce qui était déjà là."

#: scenario8:scenario8_965466F8_4A8D_4E15_8294_3DB6C0042AF9
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 1aaad8c2cc33498a61da4207fecf177009b5c95e949d6326e629ee7473801230
#. default-sha256: c4fe93e7680267d1fbcb0e0a2a7e296db0ba2a082cf415baf4b4c81064693de2
msgctxt "scenario8:scenario8_965466F8_4A8D_4E15_8294_3DB6C0042AF9"
msgid "⟪k:0⟫If I weren’t already deranged,"
msgstr "⟪k:0⟫Si je n’avais pas déjà été dérangé,"

#: scenario8:scenario8_E30A0CCB_D763_4642_86A5_DE4025B02443
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 61d9bc1419107e492f6bb414253eb0eda70d9bba4cbfe8014b3536a8af673dc2
#. default-sha256: 2a4086a1c8e4664819eee70b7b7146370aa33ac8d443e46aec53ec83300f80d9
msgctxt "scenario8:scenario8_E30A0CCB_D763_4642_86A5_DE4025B02443"
msgid "⟪k:0⟫Hey. You. Unlock my shackles for me."
msgstr "⟪k:0⟫Hé. Toi. Enlève-moi ces chaînes."

#: scenario8:scenario8_976A8293_FA85_4068_9959_A0747028E43D
