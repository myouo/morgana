msgctxt "scenario8:scenario8_2EE19FE6_7ADE_479C_9BAB_353F658EB950"
msgid ""
"⟪k:0⟫I was still occasionally struck with bouts of insatiable thirst. ⟪k:1⟫Overwhelming desire to "
"mutilate anyone who came into my line of sight."
msgstr ""
"⟪k:0⟫J’étais de temps en temps frappé, malgré tout, par des accès où ma soif, insatiable, se "
"réveillait. ⟪k:1⟫Où j’étais emporté par un désir impérieux de mutiler quiconque se trouvait sur "
"mon chemin."

#: scenario8:scenario8_D0BC7670_3351_47C4_80C1_15FF4E61B353
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
