msgid ""
"⟪k:0⟫When I was with her, I was in the role of her lover.⟪k:1⟫⟪k:2⟫She never questioned my love "
"for her,"
msgstr ""
"⟪k:0⟫Quand j’étais avec elle, je jouais le rôle de son amant.⟪k:1⟫⟪k:2⟫Elle ne remit jamais mon "
"amour en doute,"

#: scenario8:scenario8_4E14A007_20AC_4A61_97F4_1B3027DA0750
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: fe1bb2382b9260cc9d939bad815ae027fbdb7ccbf62c4466fcdee2d91b7f5941
