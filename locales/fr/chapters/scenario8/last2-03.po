#: scenario8:scenario8_30BA81B2_E88F_4371_B721_F454315186DB
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: ca25dd7f7d3ea79d0620025cd62a9c64aeba150604972c9e10420b9f1603ccce
#. default-sha256: 3a98939e60faded847da02fe968ae34a527924cc7c536a49577754b203f8e452
msgctxt "scenario8:scenario8_30BA81B2_E88F_4371_B721_F454315186DB"
msgid ""
"⟪k:0⟫⟪k:1⟫(I was always the one with nothing to offer,⟪k:2⟫powerless to be of anyone’s help...)"
msgstr ""
"⟪k:0⟫⟪k:1⟫(J’ai toujours été celui qui n’avait rien à offrir,⟪k:2⟫incapable de venir en aide aux "
"autres...)"

#: scenario8:scenario8_E5CF6BA9_138D_49E3_9CB8_FC80B4880C15
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 461a8a639b6dde64f8a27c704f8141c7cffb00a39b81a472ea253198e2023f08
#. default-sha256: a1187b134d38d28444d004bf56cfe4343c9bd3013fa9c83715efd944e72ef41d
msgctxt "scenario8:scenario8_E5CF6BA9_138D_49E3_9CB8_FC80B4880C15"
msgid "⟪k:0⟫(So if anything’s motivating me,⟪k:1⟫it’s not concern for the boy,)"
msgstr "⟪k:0⟫(Alors, si je suis motivé,⟪k:1⟫ce n’est pas parce que je me soucie du garçon,)"

#: scenario8:scenario8_BD7747DE_86D3_46FC_AFE1_6BF62A19A690
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 57ea26309fdcd21ccbd95b2c589f9c582ccf6179a3ba832f344e32f749cc998e
#. default-sha256: cac4033a6833a4bbbf6001887ffc9288e3036053140e489a6776786b5a571c9c
msgctxt "scenario8:scenario8_BD7747DE_86D3_46FC_AFE1_6BF62A19A690"
msgid ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫It didn’t take much arm-twisting to get him to give us a room, so who knows, maybe "
"he’ll come over to our side easier than either of us expect."
msgstr ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫On n’a pas eu besoin de trop insister pour qu’il nous donne une chambre, alors qui "
"sait ? Peut-être qu’il se rangera de notre côté plus aisément qu’on ne le pensait."

#: scenario8:scenario8_5E712CB4_EEA8_4836_804D_C91839E58BA1
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: c47578c026d15a73d5d63af5d8739a1b9cc3c73f010b95fa2853e3d16d842752
#. default-sha256: d128f5f2bb8a03bbbbae9993e783b58d1a51788aa2ebc3367ec75a406df89e40
msgctxt "scenario8:scenario8_5E712CB4_EEA8_4836_804D_C91839E58BA1"
msgid ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫He doesn’t trust me, but he also doesn’t know enough about me to decide what to do "
"yet. ⟪k:3⟫He needs time, and doing this gives him that time."
msgstr ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫Il ne me fait pas confiance, mais il ne me connaît pas assez non plus pour décider "
"quoi faire à mon sujet. ⟪k:3⟫Il a besoin de temps, qu’il se ménage en agissant ainsi."

#: scenario8:scenario8_773302FC_AD94_4149_BACB_EAB20C88C142
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 0d0bfa9cf6aab8fb5c6e03eca722ba39a0bbf86a8154cd125ce6fee56beded7b
#. default-sha256: b2a0289bc0d8dfc01de8161627fabaac8642511f07b68ec71bb5f5eb2a6f2c9a
msgctxt "scenario8:scenario8_773302FC_AD94_4149_BACB_EAB20C88C142"
msgid ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫If he decides keeping me around is not to his advantage, he will act accordingly."
msgstr ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫S’il décide qu’il n’est pas dans son avantage de me garder près de lui, il agira "
"en conséquence."

#: scenario8:scenario8_7EB3B130_8F81_43CA_9175_9451787DAAF2
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 481b9297e2b1406800030cc411449786697eb3075ac9286e08109842967fcf27
#. default-sha256: fc7217abbb734bf8c2b9350978c77a6756e9f229cfb06b259c19443eb64c1b86
