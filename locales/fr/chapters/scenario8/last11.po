#: scenario8:scenario8_78C4A1AD_06F0_404A_A911_289C2D1A8545
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 1f06dda1db29bc3131fff745cc8f29fb10d027f53d126faca8aa5df123f025b8
#. default-sha256: f65e4416fe8259cdb053a75165bba52afcf1ea8af8f577bb7dca5a7a05f47f34
msgctxt "scenario8:scenario8_78C4A1AD_06F0_404A_A911_289C2D1A8545"
msgid "⟪k:0⟫the lock disengaging and the door giving a deep groan as it swings open."
msgstr "⟪k:0⟫le verrou s’ouvre et la porte émet un son grave en s’ouvrant."

#: scenario8:scenario8_23F4E655_115E_47D8_81D4_32424412E816
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: c7dd69b9c1b74ce35ec498a13932fbf64aff2c3867c2b7afe23731eddc47b4c0
#. default-sha256: 1db39c6df78c3ef650b11a92309164f3d166143b0e8eb805762effa2c98d80e6
msgctxt "scenario8:scenario8_23F4E655_115E_47D8_81D4_32424412E816"
msgid "⟪k:0⟫⟪k:1⟫⟪k:2⟫Beyond it, a spiral staircase extends high into the sky."
msgstr "⟪k:0⟫⟪k:1⟫⟪k:2⟫De l’autre côté s’étend un escalier en spirale à perte de vue."

#: scenario8:scenario8_039FE425_1400_4CF4_91E9_3587DDD3BA30
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: f7067ccf67371eca07c9afbf5aa54cc7efa1f793c085fd6de0cebadea761a14f
#. default-sha256: 356f89b3ec72684228089c05292ccf766ec58c36af2d5057407e4d5f5404fd5a
msgctxt "scenario8:scenario8_039FE425_1400_4CF4_91E9_3587DDD3BA30"
msgid ""
"⟪k:0⟫Every time I’ve climbed these stairs, it’s always been a solemn affair—⟪k:1⟫and now is no "
"different."
msgstr ""
"⟪k:0⟫⟪k:1⟫À⟪k:2⟫ chaque fois que j’ai monté ces marches, ça a toujours été un moment solennel —"
"⟪k:3⟫ ce n’est pas différent aujourd’hui."

#: scenario8:scenario8_2940BC09_DF88_414F_83CD_7E63A3C23521
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 5e67c5244f573c4b640044452b4ed2e4adbe051ae8ec2131dd70d715ed7e4ba1
#. default-sha256: 481651df2209a19a5dff745f3c195adf713cbf485ec2955d47951946eacb1e41
msgctxt "scenario8:scenario8_2940BC09_DF88_414F_83CD_7E63A3C23521"
msgid ""
"⟪k:0⟫I’ve succeeded, though. I’ve got them all here,⟪k:1⟫ready to set her free before she’s "
"supposed to die."
msgstr ""
"⟪k:0⟫Mais là, j’ai réussi. Je les ai tous réunis,⟪k:1⟫prêts à la libérer avant l’heure où elle "
"est censée mourir."

#: scenario8:scenario8_1A5A083C_156A_46D0_A0BC_EED6903904BE
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: ad510cc39c0ce5c0bfc53600cd4402cd66aa70d054b3c3afe20c792b473cc436
