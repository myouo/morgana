msgid "⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫The courtyard?"
msgstr "⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫La cour ?"

#: scenario8:scenario8_B64CB175_0E23_4863_BC09_19D1FF388D0C
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: bd806146040ec7257def0471100980cad764f61e49b4c2c451d19abd497a4d94
#. default-sha256: f6983c578582e211c8684881120510ada030c0a4e02f9401eca340e0e9f0c1f7
msgctxt "scenario8:scenario8_B64CB175_0E23_4863_BC09_19D1FF388D0C"
msgid "⟪k:0⟫but the other two are bound to find out if either of us do anything too conspicuous."
msgstr ""
"⟪k:0⟫mais les deux autres risquent de s’en apercevoir si l’un de nous fait quelque chose de trop "
"suspect."

#: scenario8:scenario8_682B4051_76FA_4FCA_8928_FBB0B107C8EC
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: cd3cadd1448ffe99746aa19185a35f7b942d37b1a77dca648afcb21932d45fbe
#. default-sha256: 4a8bc036a4e505336271b56fee1eae956135329739ba40c459e71f6053b2767a
