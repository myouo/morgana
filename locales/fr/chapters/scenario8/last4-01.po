#: scenario8:scenario8_F7A52E00_EF02_4FB0_BE20_DDA30BC28DD2
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: cda3c2808b49d86880785fcdddc021dface15d579ecf819c0fbc5f7f58ea542a
#. default-sha256: 6d1250aec042f3cf7979df4d7abe9b0d53ba09ce037c965baaf0adfc9f275187
msgctxt "scenario8:scenario8_F7A52E00_EF02_4FB0_BE20_DDA30BC28DD2"
msgid ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫⟪k:4⟫Oh, thank goodness!⟪k:5⟫⟪k:6⟫You were out so good I was scared you might "
"be dead for a minute!"
msgstr ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫⟪k:4⟫Oh, Dieu merci !⟪k:5⟫⟪k:6⟫Vous étiez endormi si profondément que j’ai "
"cru que vous étiez mort !"

#: scenario8:scenario8_77876211_4445_42BD_AB95_32AD2A489D48
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: f0e88fec2517a88c8f8064d2f296e8ac1e60e7935fd443640ab1d42e6a70b6b4
#. default-sha256: 971dc47eaa7083bb0e1b2c62973f0bb5f46e5c5adb4abaf97dc261612f45aa38
msgctxt "scenario8:scenario8_77876211_4445_42BD_AB95_32AD2A489D48"
msgid "⟪k:0⟫⟪k:1⟫⟪k:2⟫Good morning.⟪k:3⟫How are you feeling?"
msgstr "⟪k:0⟫⟪k:1⟫⟪k:2⟫Bonjour.⟪k:3⟫Comment allez-vous ?"

#: scenario8:scenario8_389ACB9F_C2DB_4348_B201_718B1D928DE7
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 06ec363dd5bcde5b15cc6d2e5cb6e8da03479768d4167581c531790a4c97d6d8
#. default-sha256: 069652b42e4ec535b6c53cfb0d90946ef9dc5db75f71f69451463249e87473dc
msgctxt "scenario8:scenario8_389ACB9F_C2DB_4348_B201_718B1D928DE7"
msgid ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫(It’s incredible how much more pleasant it is to be woken up by a woman than "
"a boy...)"
msgstr ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫(C’est fou comme c’est tellement plus agréable d’être réveillé par une femme "
"que par un homme...)"

#: scenario8:scenario8_D4A207D5_34C3_4503_8EFC_84D4E1870A11
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: ce921efe695f80f1650a32cbfdea8c7df7880705fac5fce151c1f7c4b2dea84a
