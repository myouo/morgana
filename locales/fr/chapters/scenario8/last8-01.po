msgid "⟪k:0⟫⟪k:1⟫⟪k:2⟫N-⟪k:3⟫No... ⟪k:4⟫no, don’t kill me!"
msgstr "⟪k:0⟫⟪k:1⟫⟪k:2⟫N-⟪k:3⟫Non... ⟪k:4⟫non, ne me tuez pas !"

