msgid "⟪k:0⟫and the next thing I knew, her cottage was covered in blood."
msgstr "⟪k:0⟫et en un clin d’œil sa chaumière était couverte de sang."

#: scenario8:scenario8_F2611A1F_8850_49E2_8000_001EAC2496C2
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 10cb6aa1d3c17e6f4c22dd3a82deb782d308dc6f5eaa04e33bd757526496559e
