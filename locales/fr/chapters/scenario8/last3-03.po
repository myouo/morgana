msgid "⟪k:0⟫Nobody else did, though."
msgstr "⟪k:0⟫Mais j’étais le seul à le penser."

#: scenario8:scenario8_3FAC48C1_DFA9_4B0E_979A_DBA10D2BF36D
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 31adea1f1b0451c83bbe11f9f3c2175de7cdc4e520f58d5a5d30dddf899858ee
