msgid "⟪k:0⟫⟪k:1⟫I genuinely wanted it to be."
msgstr "⟪k:0⟫⟪k:1⟫Je voulais sincèrement que ce soit le cas."

#: scenario8:scenario8_B97BE98D_2583_4169_BB9B_190473D8D892
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: b6a6d3231d765f51ebd25f167a0703dc75e6180dab398ec13ffb49e3e893e431
#. default-sha256: 8c23799c2b7e0e665ad0c3c3a2bdb1dee5fab6001da8a675defddaa9cdd050a0
msgctxt "scenario8:scenario8_B97BE98D_2583_4169_BB9B_190473D8D892"
msgid "⟪k:0⟫As the oldest son, normally it would fall on me to take his place."
msgstr "⟪k:0⟫Comme j’étais le fils aîné, il me revenait de prendre sa place à la tête de la maison."

#: scenario8:scenario8_576823A8_8A8A_492F_B882_CA3E4A5943E8
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
