#: scenario8:scenario8_D1B494DA_31AD_409F_91EE_C3F61A2683A9
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: d3a998701ba8f0092324877810dcbb410ed86af46518d1fb1614907f77b78fc9
#. default-sha256: 2ea47b3b7a1a8e966e9d36245759948ddfcc1247e9fc2d9533c7413e06abe513
msgctxt "scenario8:scenario8_D1B494DA_31AD_409F_91EE_C3F61A2683A9"
msgid ""
"⟪k:0⟫⟪k:1⟫On days when it was nice out,⟪k:2⟫⟪k:3⟫I would take walks around the house’s grounds,"
msgstr "⟪k:0⟫⟪k:1⟫Les jours où il faisait beau,⟪k:2⟫⟪k:3⟫je me promenais autour de la maison,"

#: scenario8:scenario8_A9BABB81_749F_4964_9AD1_E69F58DEE34D
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 67a0ec8fa87b9d0cf56135eb5723b74626862a435d6e0d57a2e341e9d6e78834
#. default-sha256: 2f476b164736b494bc58159998856730512ef6e1e056e1e39880026cf035990f
msgctxt "scenario8:scenario8_A9BABB81_749F_4964_9AD1_E69F58DEE34D"
msgid "⟪k:0⟫⟪k:1⟫sometimes napping beneath a tree."
msgstr "⟪k:0⟫⟪k:1⟫je faisais parfois la sieste sous un arbre."

#: scenario8:scenario8_4BED022D_815C_4FFF_B1B1_70419C5FC109
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: bb820fec115b58909a82ea9703f81b3ee25a37114d0f3f58ea3efbcfc9099c21
#. default-sha256: 6f18e3c686e4b2bafe347c6d5f8a5b4c27f6cd70d5fa44950e0dc74f99675d41
msgctxt "scenario8:scenario8_4BED022D_815C_4FFF_B1B1_70419C5FC109"
msgid "⟪k:0⟫⟪k:1⟫whereas mine is flat and dull."
msgstr "⟪k:0⟫⟪k:1⟫tandis que les miens sont plats et ternes."

#: scenario8:scenario8_E3166BAA_BA5A_4E7B_9D32_689B25DD9633
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 2786b274706d3de9ac47e98fd721022f7adeb1c3dc98af0247e31d9ca148cd3a
#. default-sha256: 08dd89ca280b055fc2ac1fa046a4b183c2a7cad048cb18de990c395c47bfabd5
msgctxt "scenario8:scenario8_E3166BAA_BA5A_4E7B_9D32_689B25DD9633"
msgid "⟪k:0⟫⟪k:1⟫You shone like a tiny little dancing sun."
msgstr "⟪k:0⟫⟪k:1⟫Tu brillais comme un tout petit soleil dansant."

#: scenario8:scenario8_0114CDC6_DD89_463C_AF9E_DD612D17C3A0
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 95687dc42cd8d678238449f34d7668993dab3f0cd4741cd2c8c887128a1b1b8f
#. default-sha256: 2bc44f16d86cddf6b2f76fe1728e0dc0a50321e09183a87e8a405c32d2028ced
msgctxt "scenario8:scenario8_0114CDC6_DD89_463C_AF9E_DD612D17C3A0"
msgid "⟪k:0⟫⟪k:1⟫At the time, I assumed that was how life would always be."
msgstr "⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫À⟪k:4⟫ l’époque, je pensais que la vie serait toujours ainsi.⟪k:5⟫"

#: scenario8:scenario8_026D5E20_738D_4C2B_A483_A709FFB94996
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 0c5dcb8051f1e389e9e8521eddd6c48b41a2e0da8202a515270e1dc9cf4cb878
#. default-sha256: 33ff8872bd4879e28d0c097122595569e74d139da08490fbd02b0433fbbde2f9
msgctxt "scenario8:scenario8_026D5E20_738D_4C2B_A483_A709FFB94996"
msgid ""
"⟪k:0⟫Part of me wanted to know why nobody bothered talking to me,⟪k:1⟫and part of me was "
"relieved. ⟪k:2⟫Somewhere inside, I knew I didn’t have what it took."
msgstr ""
"⟪k:0⟫D’un côté, je voulais comprendre pourquoi personne ne prenait la peine de me parler, et de "
"l’autre côté, j’étais soulagé. ⟪k:1⟫Au fond de moi, je savais que je n’avais pas ce qu’il fallait."

#: scenario8:scenario8_0C1CDE28_7606_473D_B23B_F7FB5A3A1B49
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 99224b42732a9a1af467a29cb37f088c420138ba7f6712c29709dd4d918bc973
#. default-sha256: 5a927dd2c8bc6e94a8384d562c3f08e12d02d9bddafbb3735dfeb37ff1d89dcd
msgctxt "scenario8:scenario8_0C1CDE28_7606_473D_B23B_F7FB5A3A1B49"
msgid "⟪k:0⟫and in response, he formally disowned me."
msgstr "⟪k:0⟫et en retour, il me déshérita formellement."

#: scenario8:scenario8_70CAA6B3_33FB_4FAC_ACFC_5AAD1525E679
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 536f9ab4cc145f341481f0a61717a0bfc47d7ee7389506d7088712d33f88c7a6
#. default-sha256: ddab3aded504207b27878c86251dd7fcedfca47c30af744f2091d78b97e83ae9
msgctxt "scenario8:scenario8_70CAA6B3_33FB_4FAC_ACFC_5AAD1525E679"
msgid ""
"⟪k:0⟫You’re not the only one who still had some growing up to do, Nellie...⟪k:1⟫⟪k:2⟫I wasn’t "
"quite the adult I’d thought I was either."
msgstr ""
"⟪k:0⟫Tu n’es pas la seule qui ait encore besoin de grandir, Nellie...⟪k:1⟫⟪k:2⟫Je n’étais pas "
"tout à fait l’adulte que je pensais être."

#: scenario8:scenario8_FA7D6747_967F_4BD1_8158_BB4648567C75
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 75008383988aa16214ad2163ef86d647f72b33715cf31c4938672f39dca2ca16
#. default-sha256: d97f40068dd962c0f3e204c22d5c6d1caeaea9636ae542283b492bb8e14f44a3
msgctxt "scenario8:scenario8_FA7D6747_967F_4BD1_8158_BB4648567C75"
msgid ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫Fortunately—⟪k:3⟫⟪k:4⟫if you want to call it fortune—⟪k:5⟫⟪k:6⟫I was given enough "
"money to live on for a decent length of time, as well as a place to stay."
msgstr ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫Par chance —⟪k:3⟫⟪k:4⟫ si on peut appeler ça de la chance —⟪k:5⟫⟪k:6⟫ on m’avait "
"donné un endroit où séjourner et assez d’argent pour vivre décemment pendant un bon bout de temps."

#: scenario8:scenario8_82CD33D1_0CF8_440F_B31F_CA3D47AD9315
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 855c751b38c326a98b5fe993e7afcc6279cbeed23460a41594af7077cb536d1a
#. default-sha256: 691c36ea3830e9a36b1bd52d870bc828e8e3a7f84f9e7f83d4386729603414d7
msgctxt "scenario8:scenario8_82CD33D1_0CF8_440F_B31F_CA3D47AD9315"
msgid "⟪k:0⟫⟪k:1⟫⟪k:2⟫...Oh?"
msgstr "⟪k:0⟫⟪k:1⟫⟪k:2⟫...Oh ?"

#: scenario8:scenario8_F0F66272_1A70_4843_A7E7_E74FE97787A7
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 723c64e30b0babf5e7496ef34952ab2c474fadc9417d6d995a66809aa9b6e8b6
#. default-sha256: 60a5e2170d525a6b77f74bd2e100ca78d64d2838668b858f660845d9980ad27e
msgctxt "scenario8:scenario8_F0F66272_1A70_4843_A7E7_E74FE97787A7"
msgid ""
"⟪k:0⟫⟪k:1⟫I don’t need composers to come and write me songs for my birthday. ⟪k:2⟫As long as I "
"have the one thing that matters most to me, I can do without anything else."
msgstr ""
"⟪k:0⟫⟪k:1⟫Je n’ai pas besoin que des compositeurs viennent m’écrire des chansons pour mon "
"anniversaire. ⟪k:2⟫Tant que j’ai la seule chose qui compte pour moi, je peux faire sans le reste."

#: scenario8:scenario8_4CAD8A9E_DEF1_4D17_9955_4D40055BA4EB
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 7300ff3d9d52ac1a6f6f19cddddbef8e98778a6e91505fbefacf0cf34df528df
#. default-sha256: 7938235647014e590e8185b1bca8a299d87b0ba0807118e63d0d563f308647df
msgctxt "scenario8:scenario8_4CAD8A9E_DEF1_4D17_9955_4D40055BA4EB"
msgid ""
"⟪k:0⟫We may not have a huge yard, but the sun shines everywhere.⟪k:1⟫⟪k:2⟫Flowers can grow even "
"without a gardener tending to them."
msgstr ""
"⟪k:0⟫On n’a peut-être pas un grand jardin mais le soleil brille partout.⟪k:1⟫⟪k:2⟫Les fleurs "
"peuvent pousser même sans jardinier qui s’occupe d’elles."

#: scenario8:scenario8_0781453F_274D_4AFD_AE30_1C99F1552F2F
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: d5ec9f90f4be6b503e0519954d9d2f136e9092cbbf6edaac916630ee54f32a6a
#. default-sha256: 1ae118fa1efcf6d0aca0e0f4602a85cf6fa3eb8b808a39d39d478eba2072775e
msgctxt "scenario8:scenario8_0781453F_274D_4AFD_AE30_1C99F1552F2F"
msgid "⟪k:0⟫What else sounds good? ⟪k:1⟫Hmm... ⟪k:2⟫I’m craving cookies!"
msgstr "⟪k:0⟫Quoi d’autre, sinon ? ⟪k:1⟫Hmm... ⟪k:2⟫J’ai envie de petits gâteaux !"

#: scenario8:scenario8_16735FB1_6A43_4AAC_A996_D588EFCC1B56
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 6eabb9b1485f9c21c64575ac74a8cd42d72c4d444d499b99e86af4ad7b632c6f
#. default-sha256: ed2b83eb434822ff9956384cdd7fe20c5c152199665948a63cdd8a76cc69350c
msgctxt "scenario8:scenario8_16735FB1_6A43_4AAC_A996_D588EFCC1B56"
msgid "⟪k:0⟫⟪k:1⟫That’s the first smile I’ve seen since we got here."
msgstr "⟪k:0⟫⟪k:1⟫C’est la première fois que tu souris depuis notre arrivée."

#: scenario8:scenario8_7A6088F2_2857_4496_9125_BCEA0EA68271
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 5be6047be0fc4fdefc188ba335f95042aec742c9cf7f27fd888a32f5fc58ec33
#. default-sha256: 302293240d1476b689b4f586c61c6280f9e273a447fdc85052318d7b257a7c2c
msgctxt "scenario8:scenario8_7A6088F2_2857_4496_9125_BCEA0EA68271"
msgid ""
"⟪k:0⟫⟪k:1⟫Who cares that we’re not rich anymore?⟪k:2⟫⟪k:3⟫We’ll figure things out in no time."
msgstr ""
"⟪k:0⟫⟪k:1⟫On n’est plus riche, et alors ?⟪k:2⟫⟪k:3⟫On trouvera une solution en un rien de temps."

#: scenario8:scenario8_65533E70_3D7C_4305_92E2_C898165BAD9F
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 47150258c517d9cbdcf088e928c8c91e357289116b1cc6e4e5d14fb27afdf487
#. default-sha256: 625fa327c05c0cb832ef92ef30b97c650d510bd25db0aa55dc7607b657cebd77
msgctxt "scenario8:scenario8_65533E70_3D7C_4305_92E2_C898165BAD9F"
msgid "⟪k:0⟫And then we’ll have even more fun than we did back there!"
msgstr "⟪k:0⟫Et après, on s’amusera même encore plus qu’avant !"

#: scenario8:scenario8_89CC1705_38AE_40B2_BCEF_1A28D235D33D
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 526b71b658849d4b10019af781b7d0ef4b2a7c5626d1e0196590ef417bbc1ce9
#. default-sha256: 98ca4eb5baee638084e338c72761976387372723c2bebd7ca67d7e510d2d3338
msgctxt "scenario8:scenario8_89CC1705_38AE_40B2_BCEF_1A28D235D33D"
msgid ""
"⟪k:0⟫⟪k:1⟫You’ve got yourself an adorable little princess!⟪k:2⟫⟪k:3⟫What more could you possibly "
"need?"
msgstr ""
"⟪k:0⟫⟪k:1⟫Tu as la chance d’avoir une adorable petite princesse !⟪k:2⟫⟪k:3⟫Que demander de plus ?"

#: scenario8:scenario8_8871344A_3F24_4690_8C8C_8A34F4D9E84D
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 2704f052f35717ed08f97bb3295b7611ee7fef264265b52422e60aa0d9d57cc7
#. default-sha256: fb4e02c0927c9c3ef12430cf934bd33082786404af56eb33cacd103d772f8698
msgctxt "scenario8:scenario8_8871344A_3F24_4690_8C8C_8A34F4D9E84D"
msgid "⟪k:0⟫⟪k:1⟫Cheer up!"
msgstr "⟪k:0⟫⟪k:1⟫Remets-toi !"

#: scenario8:scenario8_3E139956_A055_4D47_B55D_3FAAA6856A23
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 38dae4c2ab6f7ccde6c92de7f59a7ecdb9bc413facf2f6de943462170e311739
#. default-sha256: 2ec2f45daf383a6a7976fb58e67b1a51908a46bd3cc7c94a0e30f5743be7c287
msgctxt "scenario8:scenario8_3E139956_A055_4D47_B55D_3FAAA6856A23"
msgid ""
"⟪k:0⟫⟪k:1⟫Ohoho. Did you think for a second I wouldn’t?⟪k:2⟫⟪k:3⟫I’m your princess, dearest Mell!"
msgstr ""
"⟪k:0⟫⟪k:1⟫Ohoho. Parce que tu as cru un moment que je ne le ferais pas ?⟪k:2⟫⟪k:3⟫Je suis ta "
"princesse, mon très cher Mell !"

#: scenario8:scenario8_3ED2A53C_3AFD_4A2F_89B6_974A96B940D5
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 72ca0e97e56c80a86a4e9e773db22a437694f2543f85efb77b7c2b6a249200a8
#. default-sha256: a49420f259157e34b683f1143ece7bd8befb7866d6692834dc586934d725dd71
msgctxt "scenario8:scenario8_3ED2A53C_3AFD_4A2F_89B6_974A96B940D5"
msgid "⟪k:0⟫⟪k:1⟫And princesses belong with their princes."
msgstr "⟪k:0⟫⟪k:1⟫Et les princesses doivent être avec leur prince."

#: scenario8:scenario8_76276090_6E2F_4AF5_81BB_20FBB6F318B9
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: d61b267d5e082aebcb4d85da9ec27a0ca0f0fdc83871e8cda4e21c362b4140bf
#. default-sha256: 34bacb3d2bf8b83ae49f23be92d61bd321bd69398062a7e9156cf20934f15da1
msgctxt "scenario8:scenario8_76276090_6E2F_4AF5_81BB_20FBB6F318B9"
msgid "⟪k:0⟫but Nellie calling me her prince gave me the illusion of being worth something."
msgstr ""
"⟪k:0⟫mais comme Nellie m’appelait son prince, ça me donnait l’illusion de valoir quelque chose."

#: scenario8:scenario8_3F2F6511_96BF_4686_99A5_2288F805FB64
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 27c869e7c7bec1141c5aba4683bfdd019a3956e8a738e02b413ebd8ea68890f4
#. default-sha256: 5fad1dd3c2e4115825bb70bdfdea6ed8b62889aac850d578e32b44564bc66820
msgctxt "scenario8:scenario8_3F2F6511_96BF_4686_99A5_2288F805FB64"
msgid ""
"⟪k:0⟫It made me feel like I could keep on being that richly blessed young man, even this far away "
"from home."
msgstr ""
"⟪k:0⟫J’avais l’impression que je pouvais continuer d’être ce jeune homme riche et comblé, même en "
"étant aussi loin de la maison."

#: scenario8:scenario8_CC8CE97C_57A4_4844_94E7_B1E25F7B1C5E
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: f6e9f7fe9a047cf99a32841611c6e3d9eb868ecdd80abb3f3d8c8208825bebd2
#. default-sha256: 125eabde4fd34b8438d879be3b2c744a526ecb5f3a98f3de5bda4aa5e76e0b3c
msgctxt "scenario8:scenario8_CC8CE97C_57A4_4844_94E7_B1E25F7B1C5E"
msgid "⟪k:0⟫but to be quite honest, I couldn’t gather the motivation to do much of anything."
msgstr ""
"⟪k:0⟫mais pour être honnête, je n’arrivais pas à rassembler la motivation nécessaire pour faire "
"quoi que ce soit."

#: scenario8:scenario8_63C6DAC9_1B4B_48E4_B46D_DCEA67D4D6F3
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 77d1414e9aba749df560b77a612978bf49656a1c9a370e0026387ac0fe1cc99a
#. default-sha256: 24acb1e5e28490603f6e71b43e9b84954d9a92c495bf07353fb17021cfb58758
msgctxt "scenario8:scenario8_63C6DAC9_1B4B_48E4_B46D_DCEA67D4D6F3"
msgid "⟪k:0⟫It had knocked me on my backside,⟪k:1⟫and I didn’t have the strength to get back up."
msgstr "⟪k:0⟫J’étais abattu et je n’avais pas la force de me relever."

#: scenario8:scenario8_ADDC0075_5107_434C_B85B_C7D0503F1A53
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: aa78c9312986637b3ffe9eeb9158c0d5ffbac938b7ec669f2375bf0604cf22f2
#. default-sha256: 1ce6d4c0cf29c211f1f100e999c5c292e912432ce2546595a6e1fca938c57b98
msgctxt "scenario8:scenario8_ADDC0075_5107_434C_B85B_C7D0503F1A53"
msgid "⟪k:0⟫I couldn’t tell Nellie that, of course, so this is what I said instead:"
msgstr "⟪k:0⟫Je ne pouvais pas dire ça à Nellie, bien sûr, alors voici ce que je lui dis :"

#: scenario8:scenario8_C7BB2910_3DBF_482D_A538_4565683DF042
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: cf76f6b312d73cc3c8682211d6f2f38357fb31daf135807a7013504c6c6d234c
#. default-sha256: a7fc385867b02d2360a6a9c7099b15eebc99d7d247d9edf823976b223955db57
msgctxt "scenario8:scenario8_C7BB2910_3DBF_482D_A538_4565683DF042"
msgid "⟪k:0⟫And she happily took me at my word."
msgstr "⟪k:0⟫Et elle me crut sur parole, toute joyeuse."

#: scenario8:scenario8_0B99D07D_BF8B_4995_8F5F_912A75899300
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 67854103bad28615859fc7727ab446139635fbe6533c095d50c5f21ceac8a3c2
#. default-sha256: a7e2a449d262fce72ec8c458864d895a18bcff82d547b848e70e985e7254a605
msgctxt "scenario8:scenario8_0B99D07D_BF8B_4995_8F5F_912A75899300"
msgid "⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫I got a, ⟪k:4⟫uh... ⟪k:5⟫a chicken..."
msgstr "⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫J’ai pris, ⟪k:4⟫euh... ⟪k:5⟫un poulet..."

#: scenario8:scenario8_53B51C9D_A0DC_4863_B9CD_DAC5AAFCC9A8
