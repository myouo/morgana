msgid "⟪k:0⟫⟪k:1⟫⟪k:2⟫That’s... ⟪k:3⟫a lot more people than I was expecting."
msgstr "⟪k:0⟫⟪k:1⟫⟪k:2⟫Il y a... ⟪k:3⟫beaucoup plus de gens que je ne pensais."

#: scenario8:scenario8_9009B8D8_4D54_46F9_846E_CF8623E0DCBC
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 7e7d7c53588f1ba2c3efc84e45661e31a29e2c668c2ed4e6b7a1b043efd43a5f
