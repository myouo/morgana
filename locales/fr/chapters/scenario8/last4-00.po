msgstr "⟪k:0⟫⟪k:1⟫⟪k:2⟫Allons-y."

#: scenario8:scenario8_E068E5DB_83F5_4BD0_A410_4BEE5091C262
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 089e1a7f373b59c5cfddc967015b7bb1d466b910727d5c72ce18adc70840b421
#. default-sha256: 22528683b9bc7a19551aea1082372bdba4b332ce0e5d86a9d349faf412679e46
msgctxt "scenario8:scenario8_E068E5DB_83F5_4BD0_A410_4BEE5091C262"
msgid ""
"⟪k:0⟫This being a church, no one is speaking especially loudly, but there’s still an indistinct "
"buzz hanging in the air as dozens of people whisper back and forth."
msgstr ""
"⟪k:0⟫Comme c’est une église, personne ne parle très fort, mais il y a quand même un léger "
"brouhaha qui plane dans l’air, créé par les chuchotements de dizaines de personnes qui discutent."

#: scenario8:scenario8_56ED0DA4_15A6_4F6C_A947_54E7E9B6AF83
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 43f24be2d0c357eb0ab3b1c7fadcf78de0a00f962ccc5edfd8f019945db1b030
