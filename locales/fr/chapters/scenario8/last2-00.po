msgid ""
"⟪k:0⟫⟪k:1⟫I stopped thinking, stopped trying to make sense of the things inhabiting the house."
msgstr ""
"⟪k:0⟫⟪k:1⟫J’ai arrêté de penser, arrêté d’essayer de trouver du sens aux choses qui peuplaient la "
"maison."

#: scenario8:scenario8_D9031696_32C5_4F5B_AAC5_B715F70B4857
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 3ff8cd5f3de7943355fa00464573752c49fd5beb845deedd144168f9c95f5b2c
