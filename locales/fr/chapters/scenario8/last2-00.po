#: scenario8:scenario8_7AD4545B_43E2_48BB_83DC_EA12AA8AC13D
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 59828bb6a8ab362b97d24edf0d125301bb91d83cbfcf8ec8cad5b6e60a95d06e
#. default-sha256: 17f605dedf1b102f46ef4caf7a4d69faecb05db801cc92013933ee7789e84e3d
msgctxt "scenario8:scenario8_7AD4545B_43E2_48BB_83DC_EA12AA8AC13D"
msgid ""
"⟪k:0⟫⟪k:1⟫We just met today, but it feels like reuniting with an old friend. ⟪k:2⟫He’s the same "
"old Mell."
msgstr ""
"⟪k:0⟫⟪k:1⟫On vient juste de se rencontrer, aujourd’hui, mais j’ai l’impression qu’on a retrouvé "
"un vieil ami. ⟪k:2⟫C’est le même bon vieux Mell."

#: scenario8:scenario8_D8E5023B_70F9_4F9E_851F_072696EB7F5E
