msgid "⟪k:0⟫⟪k:1⟫⟪k:2⟫Neither of you... ⟪k:3⟫saw any of that?"
msgstr "⟪k:0⟫⟪k:1⟫⟪k:2⟫Vous n’avez... ⟪k:3⟫rien vu ?"

#: scenario8:scenario8_C696CB66_9886_4AEB_92D8_CEDD527A2B97
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: acc87f717b5d4644da21a05205394adcb39bdfa2791bee787e94ab74c8c920c0
#. default-sha256: eb817eafb99943efe0596c93938cd9d7e1ac9d265ae6524f9a73361e4546c058
msgctxt "scenario8:scenario8_C696CB66_9886_4AEB_92D8_CEDD527A2B97"
