#. default-sha256: 48f41697b22461c825c2f67ac00db3078091b23a05c42741f58ec0ffc02c435d
msgctxt "scenario8:scenario8_D377934A_089F_403D_A7CE_0876CD37C5EE"
msgid "⟪k:0⟫............"
msgstr "⟪k:0⟫............"

#: scenario8:scenario8_C75B6762_6766_41AE_BA3B_52BF6A5BD0F5
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 0a67a89009662a2f772dd889a0f92609eacac38da2d2ad139de4e967826d1587
#. default-sha256: 038ac2806d114a05e3dc9e02c1c907ae4fac3ceae832fd352a4deacea7f81878
msgctxt "scenario8:scenario8_C75B6762_6766_41AE_BA3B_52BF6A5BD0F5"
msgid "⟪k:0⟫I’m begging you!"
msgstr "⟪k:0⟫Je vous en supplie !"

#: scenario8:scenario8_1774CFC9_2512_4570_AE5C_B1ACDF30C87C
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: c138aa4dff345f98307355c77af7cc695987701f7823fb6a82de95e00828b8da
#. default-sha256: ce59c7a431f6a055d4a8f444c5c32a490dcaf8f170cbfe15ff199e504d5c4a5a
msgctxt "scenario8:scenario8_1774CFC9_2512_4570_AE5C_B1ACDF30C87C"
msgid ""
"⟪k:0⟫They let their guard down because we were restrained.⟪k:1⟫⟪k:2⟫The thought of anyone "
"resisting never once crossed their minds."
msgstr ""
"⟪k:0⟫Ils avaient baissé leur vigilance parce que nous étions attachés.⟪k:1⟫⟪k:2⟫La pensée que "
"l’un de nous résiste ne leur avait pas une seule fois traversé l’esprit."

#: scenario8:scenario8_A91022C2_DDC8_404F_9E06_8CCEBACC812E
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 7093f82e26c717b9311d4e1b389b30e39da4076027dabcf471fad7535bef8262
#. default-sha256: f20609ae9c8007a8eb434fa6d3a548bfd8ce359c8e63837df2abf90d6b1b6089
msgctxt "scenario8:scenario8_A91022C2_DDC8_404F_9E06_8CCEBACC812E"
msgid "⟪k:0⟫Haha... ⟪k:1⟫hahahaha... ⟪k:2⟫heehee!"
msgstr "⟪k:0⟫Haha... ⟪k:1⟫hahahaha... ⟪k:2⟫hiihii !"

#: scenario8:scenario8_63E11C4C_470B_45C4_BDF5_9D1910BA3315
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 4104486cbaa650417abaa74e9f6d30d7307880d018da031699117aee0dc68efe
#. default-sha256: b1243428e95110c1b472d17f0019f355ac3e714c7f645f5a6873662bc16ea297
msgctxt "scenario8:scenario8_63E11C4C_470B_45C4_BDF5_9D1910BA3315"
msgid "⟪k:0⟫More... ⟪k:1⟫I need more...⟪k:2⟫⟪k:3⟫I need moooooooooooore!"
msgstr "⟪k:0⟫Encore... ⟪k:1⟫J’en veux encore...⟪k:2⟫⟪k:3⟫J’en veux encoooooooooooore !"

#: scenario8:scenario8_38158AE4_64C6_491B_98D3_B0BE5DA55015
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: c982413d39c77f7a09f207ae9c532342aded2ee4749694f8edb619f378696eae
#. default-sha256: c32e7a80629f49badb40c7e685965f439afd3f347673d95e23ff668b357c5a2d
msgctxt "scenario8:scenario8_38158AE4_64C6_491B_98D3_B0BE5DA55015"
msgid "⟪k:0⟫But she said nothing, simply removing my shackles as commanded."
msgstr ""
"⟪k:0⟫Mais elle ne dit rien, elle se contenta de m’ôter mes chaînes comme je le lui en avais donné "
"l’ordre."

#: scenario8:scenario8_707AA80E_C68A_4C08_8E5F_B7EA77E984E7
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 4997cb608470b66bc8186bb70a29a6fd7e92b89ca1ed33662200e4e7136e63f1
#. default-sha256: 02e108122aec2a664b74ed83a6ec6b375c5eda1ee09947460e32536ec082fa13
msgctxt "scenario8:scenario8_707AA80E_C68A_4C08_8E5F_B7EA77E984E7"
msgid "⟪k:0⟫⟪k:1⟫We can have our lives back!"
msgstr "⟪k:0⟫⟪k:1⟫Nous pouvons retourner à notre vie !"

#: scenario8:scenario8_D2F5D64A_E594_4284_9082_612E7FE2398A
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 47287d541c899bf53c0814711c194cb77056550a42aabd88fef5c548f20c7f78
#. default-sha256: 8d0e7d7f173515aca2bf284af2803bf8eb6d45755113770fc1f42995ed44e5a3
msgctxt "scenario8:scenario8_D2F5D64A_E594_4284_9082_612E7FE2398A"
msgid "⟪k:0⟫Undo our shackles, please!"
msgstr "⟪k:0⟫Enlevez-nous ces chaînes, s’il vous plaît !"

#: scenario8:scenario8_64824487_E115_4F4F_BFD9_18DCE692F95E
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: a55cb3fc822f82ea08557396e53997e8d35bdcf1b2ab6453b1dd32be4e0d75cc
#. default-sha256: 8ccc70b0bd36954489451c98933f26f12676e417523fae4487670051a4bbe7d4
msgctxt "scenario8:scenario8_64824487_E115_4F4F_BFD9_18DCE692F95E"
msgid "⟪k:0⟫...What?"
msgstr "⟪k:0⟫...Quoi ?"

#: scenario8:scenario8_E0FF7BD7_1173_4629_BCC6_D320C1A7BDDB
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: c92b59ef0b1014282073f523be12260fc2e5acb57f667f1634c092acf1b3f573
#. default-sha256: cd7f6559d40bf859ee515dcd59bdc53de2401daa4d0e95fe093ba75a1aba609c
msgctxt "scenario8:scenario8_E0FF7BD7_1173_4629_BCC6_D320C1A7BDDB"
msgid "⟪k:0⟫More... ⟪k:1⟫I need... ⟪k:2⟫I need more..."
msgstr "⟪k:0⟫Plus... ⟪k:1⟫J’en veux... ⟪k:2⟫J’en veux plus..."

#: scenario8:scenario8_73ED03DA_8312_4CD3_8143_2A66A23CB002
