#: scenario8:scenario8_6859F8BA_2B60_443D_A146_6359F9BCC8F3
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: f034131445941e584843d9967cbfd349f8073547976e683f9c2f8f783a3ff19b
#. default-sha256: 848d2c4d13571f31a7b9d7208b283f90b30f82826d0bd844ffa03c78abbbacb8
msgctxt "scenario8:scenario8_6859F8BA_2B60_443D_A146_6359F9BCC8F3"
msgid "⟪k:0⟫⟪k:1⟫That endless expanse of red earth"
msgstr "⟪k:0⟫⟪k:1⟫Cette immense étendue de terre rouge"

#: scenario8:scenario8_A4A3F35D_D62F_4F2A_B280_64EB88F05101
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 9d06babfb84fc0efa40911e8ba1d8ff29c1ced62d8247178f61607e3bbc44ec7
#. default-sha256: 9bd804610297f8e699a1490f552992e105ae28e1c71ff3c490ce271a1d4efa15
msgctxt "scenario8:scenario8_A4A3F35D_D62F_4F2A_B280_64EB88F05101"
msgid "⟪k:0⟫⟪k:1⟫remains branded into the very fabric of my mind."
msgstr "⟪k:0⟫⟪k:1⟫restera toujours gravée dans mon esprit."

#: scenario8:scenario8_86014BCE_50E9_48BD_9AD2_C18A9B08E47F
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 37c994ea9331f423a3743d1fbd83dc8e3503a99a784641770468498e86daa7e5
#. default-sha256: e32c60b7c3e41278c7d741c5117023045b92eab60382f22ea57b91a3620b9003
msgctxt "scenario8:scenario8_86014BCE_50E9_48BD_9AD2_C18A9B08E47F"
msgid "⟪k:0⟫That’s where it was decided someone built like I am would be the most use, I suppose."
msgstr ""
"⟪k:0⟫On avait dû décider qu’avec ma carrure, c’était là que je serais le plus utile, j’imagine."

#: scenario8:scenario8_EFE14CCC_A8CF_4BAA_BE17_57EA45F3D07C
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 2f2552b3cb3879e26a7f383eb2abe80e224966b78827d57b259257d04832a0c4
#. default-sha256: c4675f4915b06208d5be0eb012ec0a94839c7e8dc93129e60e27aca2378cd93d
msgctxt "scenario8:scenario8_EFE14CCC_A8CF_4BAA_BE17_57EA45F3D07C"
msgid ""
"⟪k:0⟫But I could tell from their tone of voice and expressions that the things they were saying "
"were not friendly. ⟪k:1⟫They seemed to be mocking me, laughing at me."
msgstr ""
"⟪k:0⟫Mais j’arrivais à deviner, d’après le ton de leurs voix, les expressions de leurs visages, "
"que leurs paroles n’avaient rien d’amical. ⟪k:1⟫Ils avaient l’air de se moquer de moi, de rire de "
"moi."

#: scenario8:scenario8_CDC5F7AC_8330_457D_B164_F088B8DEC181
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: f1b28b769d124d030c39d765469aedbebb6bdcb2fc05b8f11833f7ae31119a19
#. default-sha256: 914f70c3d57809e117cfa599bd2499cfddd909e7e07301c3795a1c9ec7366719
msgctxt "scenario8:scenario8_CDC5F7AC_8330_457D_B164_F088B8DEC181"
msgid ""
"⟪k:0⟫As you might expect, I attempted to protest,⟪k:1⟫but evidently, I had been beaten quite "
"badly while I was unconscious."
msgstr ""
"⟪k:0⟫Comme vous vous y attendez, j’essayai de protester,⟪k:1⟫mais à l’évidence, ils m’avaient "
"sévèrement battu pendant que j’étais inconscient."

#: scenario8:scenario8_189711F9_D6CC_485D_95C3_728672FF3E07
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 1a9fdd82be9bf97d0c66ed0f35116d90e1f5d7a70b591c23cae744f325d15c69
#. default-sha256: 239f64d760a4f14a83cc4481f8639b049dc1edfb9cb3e16a397eadd47e1128ad
msgctxt "scenario8:scenario8_189711F9_D6CC_485D_95C3_728672FF3E07"
msgid ""
"⟪k:0⟫My joints were stiff and swollen, on top of my dehydration,⟪k:1⟫so I could barely move, let "
"alone put up a fight."
msgstr ""
"⟪k:0⟫Mes membres étaient rigides et gonflés, et j’étais déshydraté ;⟪k:1⟫je pouvais à peine "
"bouger, alors me battre..."

#: scenario8:scenario8_64D83DD8_B6FF_487B_AA17_AC0B63B424CF
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 10526f48f190cfbab913fd01f4eead0e768eb2dc772d788bfa1ce2ec10bbd7b5
#. default-sha256: 2d5ed93fbb7c9962e20c35c868fec9cc720c0611f5d0fd71795f5dd12def3846
msgctxt "scenario8:scenario8_64D83DD8_B6FF_487B_AA17_AC0B63B424CF"
msgid ""
"⟪k:0⟫As strong as I might have been at full health, I was in no condition to do anything then."
msgstr ""
"⟪k:0⟫Quand j’étais en pleine possession de mes moyens, j’étais fort, c’est sûr, mais là je "
"n’étais pas en état de faire quoi que ce soit."

#: scenario8:scenario8_475C661B_0BE8_4B09_A455_E9CE8A5CCB88
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: f1b989ff3edb3727d0b2c4ad999684efffb7fdac8c8207d3bbac4a3a8d353d11
#. default-sha256: c6a08f83593b69188d3a75bcecdca4a09bf175556edc7d3c1f4898d5ed4753b3
msgctxt "scenario8:scenario8_475C661B_0BE8_4B09_A455_E9CE8A5CCB88"
msgid ""
"⟪k:0⟫They had many words to describe me, none of them flattering.⟪k:1⟫⟪k:2⟫Some of them would "
"even call me “beast.”"
msgstr ""
"⟪k:0⟫Ils avaient de nombreux mots pour me décrire, et aucun n’était flatteur.⟪k:1⟫ Certains me "
"donnaient même le nom de « bête »."

#: scenario8:scenario8_5244F813_E939_4660_BDB7_59797A6E7A7D
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 51b5b6ae83140030b5d61c5fadf54e6d76eb3368e612ee31add4b87032d62bf5
#. default-sha256: b998a9ee4834204873ca56f3593bc07d0263426d7bb9ded24a7dcb6b620e0f0a
msgctxt "scenario8:scenario8_5244F813_E939_4660_BDB7_59797A6E7A7D"
msgid ""
"⟪k:0⟫The slave trader’s guards were armed, of course.⟪k:1⟫⟪k:2⟫Swords hanging from their hips, "
"ready to cut down anyone who showed any sign of resistance."
msgstr ""
"⟪k:0⟫Les gardes du marchand d’esclaves étaient armés, bien entendu.⟪k:1⟫⟪k:2⟫Ils avaient des "
"épées suspendues à leur taille, prêtes à s’abattre sur quiconque montrerait des signes de "
"résistance."

#: scenario8:scenario8_95934EAA_5C56_448B_B646_04C8D400B5E6
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 0a9e797447bec612a628300e10af10a30577fadf554152c99737406124032853
#. default-sha256: 007694561411e4533960397c166f8174952be8c6220d79b38fa9bfcb2cdd1eeb
msgctxt "scenario8:scenario8_95934EAA_5C56_448B_B646_04C8D400B5E6"
msgid "⟪k:0⟫So they sat there, lamenting their fate."
msgstr "⟪k:0⟫Alors, ils s’étaient assis là et se lamentaient sur leur sort."

#: scenario8:scenario8_54ADD76B_A412_4AFA_BA50_2C9D1C49BD83
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 4875dcd149eebeb6340db55e0e593313fdac792f1ecaa06dd9553bb43da59849
#. default-sha256: 897914731af7915b2df99c7c99e558e924e74f37088417cf2b06b3bbc7b89c05
msgctxt "scenario8:scenario8_54ADD76B_A412_4AFA_BA50_2C9D1C49BD83"
msgid ""
"⟪k:0⟫Glancing over at her, I caught a glimpse of her face—⟪k:1⟫⟪k:2⟫⟪k:3⟫large chunks of skin "
"seemed to have fallen off it."
msgstr ""
"⟪k:0⟫En lui jetant un regard, j’aperçus son visage —⟪k:1⟫⟪k:2⟫⟪k:3⟫de larges lambeaux de chair "
"semblaient s’en être détachés."

#: scenario8:scenario8_3C09BB0D_D06D_4694_AFEE_33B7DB1722FE
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: e0b84c369b9d94caaff79382bb12940e7a10d559f7dcf2e2442451d3b3a9c5f9
#. default-sha256: a4d43fd96d799c99ed46570d048873b19cc704bd71136709ba15eb9892616a33
msgctxt "scenario8:scenario8_3C09BB0D_D06D_4694_AFEE_33B7DB1722FE"
msgid "⟪k:0⟫It was, suffice it to say, an unusual sight."
msgstr "⟪k:0⟫Inutile de préciser que c’était une vision pour le moins inhabituelle."

#: scenario8:scenario8_EA4C890F_1548_4752_A156_2A7C16C62C10
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 06945ce021bfeef55bb283b6ec92a15175ee72747f634e5ca8bb735ff6300a4d
#. default-sha256: 7ca16767630bad59124bea488106167122489b9c8900de8500bb8593375ab71c
msgctxt "scenario8:scenario8_EA4C890F_1548_4752_A156_2A7C16C62C10"
msgid ""
"⟪k:0⟫I’m not sure how to describe it... ⟪k:1⟫but it seemed different somehow from everyone else "
"crying in the carriage. It was almost like..."
msgstr ""
"⟪k:0⟫Je ne saurais pas trop comment le décrire... ⟪k:1⟫mais on aurait dit que c’était différent "
"de toutes les autres personnes qui pleuraient dans le convoi. C’était presque comme si..."

#: scenario8:scenario8_F2B7BADB_C3EA_40B1_AEE7_6D49DE1D5C3D
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: b3a2c295eeadfa9c79f85be73d015e99b12bfec87409e4beb2729e9a49c8aeab
#. default-sha256: a2be7ed36f816a38188b73f1351c23144ad34526d919f0ce0e7b5ab4310cb263
msgctxt "scenario8:scenario8_F2B7BADB_C3EA_40B1_AEE7_6D49DE1D5C3D"
msgid "⟪k:0⟫her tears were not for herself."
msgstr "⟪k:0⟫...elle ne pleurait pas pour elle-même."

#: scenario8:scenario8_4121FD91_F6D5_45F3_9CE9_623725AE1CC9
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 157385727a8b64257489bee91eb8dd91e03af6ed68f42296786aa84cbd524abd
#. default-sha256: 403538103c760619c513ccf16858470edb1578794cfe4de09b69874daa7f9ebf
msgctxt "scenario8:scenario8_4121FD91_F6D5_45F3_9CE9_623725AE1CC9"
msgid "⟪k:0⟫Why are you crying?"
msgstr "⟪k:0⟫Pourquoi pleures-tu ?"

#: scenario8:scenario8_D6308C27_83A4_4537_B693_124430D2D1DC
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: ad26cbb700e72bdf7d952972d03cb6ff3194680bfa87ad7aecf01d191decd9ad
#. default-sha256: 8640643e1b6d04eff95715234a174a64fd1e465a206e96317a2b0af8fcbe7a73
msgctxt "scenario8:scenario8_D6308C27_83A4_4537_B693_124430D2D1DC"
msgid "⟪k:0⟫After a moment’s hesitation, she said,"
msgstr "⟪k:0⟫Après un moment d’hésitation, elle dit :"

#: scenario8:scenario8_8D93A337_D2B1_4263_88A0_79A5D2C433CA
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: bced8b51df7f581e716d2668b8470fa0af6d60ff57c0a7330bad1ac847a2c7ad
#. default-sha256: 2650089d046779162abbbb102ee8328f2a1981d8ccaa34ecf2f3fd052349ec06
msgctxt "scenario8:scenario8_8D93A337_D2B1_4263_88A0_79A5D2C433CA"
msgid "⟪k:0⟫For a moment, I was filled with a sense of tranquility,"
msgstr "⟪k:0⟫Pendant un instant, je fus rempli d’un sentiment de tranquillité,"

#: scenario8:scenario8_DD5FAAB1_FB91_428F_A8DF_2C1B7B49DC0C
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 3a5caa690c60c5c493bb7dec53b0e006bcf68ce7f854c8cc371312deebde4cb7
#. default-sha256: a1e13696bcb111c3f76373877c2d35b1e03d8263e449e43250c5e91352c0003b
msgctxt "scenario8:scenario8_DD5FAAB1_FB91_428F_A8DF_2C1B7B49DC0C"
msgid "⟪k:0⟫and though you may not believe it,"
msgstr "⟪k:0⟫et vous ne me croirez peut-être pas,"

#: scenario8:scenario8_6C1999A0_BBCE_491A_9F11_3AA8BB65B59D
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 9cbea80444d4422d999af0de12fec1a7dc6489e46b1501799e610d1d11695d5e
#. default-sha256: 2583035978e11a1768476c0badbf1917d3cd341cc525983e352c1623061552d4
msgctxt "scenario8:scenario8_6C1999A0_BBCE_491A_9F11_3AA8BB65B59D"
msgid "⟪k:0⟫This is no lie, I promise."
msgstr "⟪k:0⟫Ce n’est pas un mensonge, je vous le promets."

#: scenario8:scenario8_D377934A_089F_403D_A7CE_0876CD37C5EE
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
