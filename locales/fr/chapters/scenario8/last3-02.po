msgid "⟪k:0⟫...Yeah. Yeah, you will...⟪k:1⟫⟪k:2⟫You’ll be just fine."
msgstr "⟪k:0⟫...Oui. Oui, tu iras mieux...⟪k:1⟫⟪k:2⟫Tout ira bien."

#: scenario8:scenario8_7656D0B4_D829_4428_A94D_D0D75FFC0FC6
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: d5d4263faf43424ae013c340e601cc25b5758b08dbd1541898002aa08dadd1f3
