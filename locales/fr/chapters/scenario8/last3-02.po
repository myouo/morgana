msgctxt "scenario8:scenario8_6956578F_0EA8_47FA_BEAD_3D9CE72F54C6"
msgid "⟪k:0⟫I was really doing it for myself..."
msgstr "⟪k:0⟫...c’est que je le faisais en fait pour moi..."

#: scenario8:scenario8_2BF65C28_D0EF_4D1A_8512_2F5231A14D79
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 6ce2a01710ac44ca4721d8d8f8dd8e9768271c8c280e8c2830bd517ac3053074
