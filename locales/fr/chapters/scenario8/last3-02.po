#: scenario8:scenario8_E40F536E_2011_4E5B_8A02_79D40DFD0443
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 3c5967c9604fe3e450a153d720f1bd884e0e9a6c51d02aa54f5d0c705a517648
#. default-sha256: 1bd53c5b2476fb63c179692502cead3c4d20b950c0f8c9a1bf02bc3a694f7e66
msgctxt "scenario8:scenario8_E40F536E_2011_4E5B_8A02_79D40DFD0443"
msgid "⟪k:0⟫⟪k:1⟫And you were always there with me."
msgstr "⟪k:0⟫⟪k:1⟫Et tu étais toujours à mes côtés."

#: scenario8:scenario8_6D4A6043_416B_46F2_A818_09047036F42A
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 1434ba35ce8fa0eede6b70a75cf226e0e208b4917e636d4c03b2e8b6e9970748
#. default-sha256: f3afef934aa088514f0729c416abaa8ba068537a15d15886d7e9f33b476000a5
msgctxt "scenario8:scenario8_6D4A6043_416B_46F2_A818_09047036F42A"
msgid "⟪k:0⟫⟪k:1⟫Following my seventeenth birthday, though, I was met with a deluge of changes."
msgstr ""
"⟪k:0⟫⟪k:1⟫Mais peu après mon dix-septième anniversaire, je dus faire face à une tempête de "
"changements."

#: scenario8:scenario8_883F4211_6033_496C_BE63_ED1944B379B3
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 23773d4a6ea8eb645df0dcbea64ef8aaba42fca682b8e1c5cabd75c7f69ac717
#. default-sha256: 2f5fd84fed301095daba78dd0ac5c3dbe6b3e8974e586fedc296397bdfb1e46e
msgctxt "scenario8:scenario8_883F4211_6033_496C_BE63_ED1944B379B3"
msgid ""
"⟪k:0⟫First, Father fell ill... ⟪k:1⟫and passed away shortly thereafter...⟪k:2⟫⟪k:3⟫With his death "
"came the question of who would be the next head."
msgstr ""
"⟪k:0⟫D’abord, Père tomba malade... ⟪k:1⟫et nous quitta peu après...⟪k:2⟫⟪k:3⟫⟪k:4⟫À⟪k:5⟫ sa mort "
"survint la question de l’héritage."

#: scenario8:scenario8_E8664530_9C0B_4427_A024_B001D2D828C6
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: c10d66079ec569999b9a6e544888800bc863c9fbae57e95d3c3a869b1cf1c566
#. default-sha256: 08f68c2151c3f5e944e2a2cb43b92fe2ff895bd7adb66bf0de38ea2a29e24a52
msgctxt "scenario8:scenario8_E8664530_9C0B_4427_A024_B001D2D828C6"
msgid ""
"⟪k:0⟫I was seventeen, by all means enough of an adult to handle things myself. ⟪k:1⟫Or, well, "
"that’s what I thought, anyway."
msgstr ""
"⟪k:0⟫J’avais dix-sept ans, j’étais donc assez adulte pour gérer les choses moi-même. ⟪k:1⟫Enfin, "
"c’est ce que je pensais, en tout cas."

#: scenario8:scenario8_D2D6EA55_93D4_4349_B408_461C0E607BBD
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 9f9cb8aee9582e4650b3959cc4b2882649f1f575992bcc37cce23465894390e9
#. default-sha256: e8c74dc1cb5bef6b801dd11043c9c7efdb9ab579e73bcbd8b3972f9700173a88
msgctxt "scenario8:scenario8_D2D6EA55_93D4_4349_B408_461C0E607BBD"
msgid ""
"⟪k:0⟫It was a small house, far from home—⟪k:1⟫⟪k:2⟫his way of making it hard for me to come back. "
"⟪k:3⟫Not that I had any intention of returning."
msgstr ""
"⟪k:0⟫C’était une petite maison, loin de chez moi —⟪k:1⟫⟪k:2⟫ c’était ainsi plus difficile de "
"revenir. ⟪k:3⟫Pas que j’aie eu l’intention de rentrer."

#: scenario8:scenario8_9ED9BC65_C2CF_4A8C_B5AD_A023DD82E8A8
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 45410d488bd0663c0284be6d6d27589c68caa4558d02bf8aedc5e6c980debfad
#. default-sha256: 436d188746ab60c431f878182423f465681fcc8de0b5122b602065e535b37a2b
msgctxt "scenario8:scenario8_9ED9BC65_C2CF_4A8C_B5AD_A023DD82E8A8"
msgid "⟪k:0⟫was you coming with me, Nellie."
msgstr "⟪k:0⟫...c’est que tu sois venue avec moi, Nellie."

#: scenario8:scenario8_0A707CFE_FA03_44E0_A1D5_9FF34BAF6EC9
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 5afc17cff181f623c9fab5583fa5dde422092416f6f74d7cb960d245759aecc7
