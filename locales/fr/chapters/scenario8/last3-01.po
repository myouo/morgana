#: scenario8:scenario8_7271CF53_2F9D_4C71_BB5A_EFD55E3FD8B8
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 75f86bd33f83a020bfffc38903dd5c8347bc0f99cace5e30ff36128e581d8fca
#. default-sha256: b2e7c35e3877d90bfd29ddfc15919d0e0d9ec8ef5c6e2310cf5d62d9d62304ad
msgctxt "scenario8:scenario8_7271CF53_2F9D_4C71_BB5A_EFD55E3FD8B8"
msgid ""
"⟪k:0⟫After discussions I had no part in, it was decided that my uncle would be the next head. "
"⟪k:1⟫That they weren’t confident I had the spine to do the job properly."
msgstr ""
"⟪k:0⟫Après des discussions où je n’eus aucune part, il fut décidé que mon oncle deviendrait le "
"nouveau chef. ⟪k:1⟫Ils n’étaient pas sûrs que j’avais les épaules pour remplir le poste "
"correctement."

#: scenario8:scenario8_14AA6030_BFFC_4D54_8F5F_CD1BA4D4AA3D
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 4a515c7420a74faca0809107db63512e0ad96e92da5ded1a517e18678bb83081
#. default-sha256: 001a3f84409d92b359bd8a756b3ddf8fbd8cc26270e3c4f8108dcd158faef558
msgctxt "scenario8:scenario8_14AA6030_BFFC_4D54_8F5F_CD1BA4D4AA3D"
msgid "⟪k:0⟫I wasn’t sure what to think."
msgstr "⟪k:0⟫Je ne savais pas trop quoi en penser."

#: scenario8:scenario8_826116EA_6045_40AC_A4A1_DE73A200E194
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: a344384058c5e9ba57823b0c6aca74e08fc65f42499b14ae6df75cd333b096fc
#. default-sha256: 906449aa2eb67c8a36483d2ec64f2ab1b8f42715bcf439fb3ed274fb26e2d8e5
msgctxt "scenario8:scenario8_826116EA_6045_40AC_A4A1_DE73A200E194"
msgid "⟪k:0⟫If it meant I could go on with my quiet life,⟪k:1⟫I didn’t care who they picked."
msgstr ""
"⟪k:0⟫Si ça voulait dire que je pouvais continuer à vivre tranquillement,⟪k:1⟫je me moquais bien "
"de la personne qu’ils choisiraient."

#: scenario8:scenario8_3A7480C5_2579_4E5D_BD3A_355A5A2BB7BC
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: cf5407847ceea7bf508c47cf3144d0e8f0d8cc744792f9f1590ec09174406bc3
#. default-sha256: cd86fb99bd3ff10b3dfa04d311d09bb5a081eee28cf55cf5a98fba9cbc7c5b0f
msgctxt "scenario8:scenario8_3A7480C5_2579_4E5D_BD3A_355A5A2BB7BC"
msgid ""
"⟪k:0⟫My uncle, though, seemed to have caught on to my apathy,⟪k:1⟫which he did not take kindly to,"
msgstr ""
"⟪k:0⟫Mais mon oncle, visiblement, s’était rendu compte de ma mollesse,⟪k:1⟫ce qu’il n’accepta pas "
"de bonne grâce,"

#: scenario8:scenario8_0F9B4C2F_8D4B_457A_9E21_31B09E682CB3
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: b815f0465cc227611fdb27c905de1f971b9ec132e6728c93a927e8f90362fc2c
#. default-sha256: 2b05de771c1edc3beb63a7d196f0ed701c664ecda414cd5f08837ef68fbee186
msgctxt "scenario8:scenario8_0F9B4C2F_8D4B_457A_9E21_31B09E682CB3"
msgid "⟪k:0⟫⟪k:1⟫So this is our new home, dearest Mell!"
msgstr "⟪k:0⟫⟪k:1⟫Voilà donc notre nouvelle maison, mon très cher Mell !"

#: scenario8:scenario8_C46DB12A_F1A6_4AEF_80D6_1C916DF0125C
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: de87350df6fb3abddeb111bd96ac4a446ae1eca871d24732099f30a6549e2e04
