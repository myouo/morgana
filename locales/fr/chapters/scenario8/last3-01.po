msgid "⟪k:0⟫⟪k:1⟫⟪k:2⟫............"
msgstr "⟪k:0⟫⟪k:1⟫⟪k:2⟫............"

#: scenario8:scenario8_BA103644_E5BA_4A61_A657_15137CCE2AB1
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: b527ef46a1fa67aa688f7b5d68ece31bff561c07c90aa21b0c76f1e50982028d
#. default-sha256: 04a1d77c306799d55f830e2b6db5948af75e4b9fc8a600da3dd56102298b6ef7
msgctxt "scenario8:scenario8_BA103644_E5BA_4A61_A657_15137CCE2AB1"
msgid ""
"⟪k:0⟫You’re not going to go and say you want to return home in a couple months when you realize "
"life isn’t as luxurious here as it was back there, are you?"
msgstr ""
"⟪k:0⟫Tu es sûre que tu ne vas pas changer d’avis et vouloir rentrer dans quelque mois quand tu te "
"seras rendu compte que la vie ici n’est pas aussi luxueuse qu’avant ?"

#: scenario8:scenario8_D53E37F5_E62E_43EB_85DE_F5F5852B0380
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 521d0de69b0a6de030fa4772c7e3c87ef241c06a01115c9a5cebdc62ebdf3253
#. default-sha256: 50126234d21d46b2de4f828a8eb35dea432e3780dd95187146fcc3bc48ed8e33
msgctxt "scenario8:scenario8_D53E37F5_E62E_43EB_85DE_F5F5852B0380"
msgid "⟪k:0⟫⟪k:1⟫There’s only one thing in the whole wide world I really need."
msgstr "⟪k:0⟫⟪k:1⟫Il n’y a qu’une seule chose dans tout le monde entier dont j’ai besoin."

#: scenario8:scenario8_E9C7B0D6_955F_47A6_A1B6_B3B638AA981D
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: d2ac7522bec1d86867fe05794c8416684e776f58d64400fcc186d68af253802d
#. default-sha256: 6576fe281fdac9bda65a03c834adf3565fe4c0c94cc3f9555396e0bc6eb650fc
msgctxt "scenario8:scenario8_E9C7B0D6_955F_47A6_A1B6_B3B638AA981D"
msgid ""
"⟪k:0⟫⟪k:1⟫Hehe. I’m as happy as I’ve ever been.⟪k:2⟫⟪k:3⟫I don’t need all that fancy, expensive "
"stuff."
msgstr ""
"⟪k:0⟫⟪k:1⟫Hihi. Je suis tout aussi heureuse.⟪k:2⟫⟪k:3⟫Tout ce luxe, tout ce clinquant, je n’en ai "
"pas besoin."

#: scenario8:scenario8_D08E366E_EA6D_46C9_9B0F_8668427BDBE3
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
