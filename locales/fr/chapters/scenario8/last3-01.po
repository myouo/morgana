#: scenario8:scenario8_B77B9324_C68A_4471_972E_2BC1BEA37683
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: d65a4a3c106a42fd34cdc81498053072ad892c5b244dfe2f60f286292659793e
#. default-sha256: 222be30122dd7088342337ef0c36cd895ba1c62c7cf1cef35dc5991d6933835f
msgctxt "scenario8:scenario8_B77B9324_C68A_4471_972E_2BC1BEA37683"
msgid ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫Wha— ⟪k:3⟫⟪k:4⟫Th-⟪k:5⟫That can’t be right...⟪k:6⟫⟪k:7⟫I’m sure I’ve been smiling."
msgstr ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫Qu— ⟪k:3⟫⟪k:4⟫C-⟪k:5⟫C’est pas possible...⟪k:6⟫⟪k:7⟫J’ai souri avant, j’en "
"mettrais ma main à couper."

#: scenario8:scenario8_71D278E8_A4E6_4699_99AB_D18D8754EC03
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: a70b2023a664725fbbe8b1dd375d8b2846d489422ead2d4a97e9b6839af9b140
#. default-sha256: bdb2249ebfaae851a6d71f916982e94fdca219f01533376cc0520e68df13864b
msgctxt "scenario8:scenario8_71D278E8_A4E6_4699_99AB_D18D8754EC03"
msgid "⟪k:0⟫I’m really glad you decided to come with me."
msgstr "⟪k:0⟫Je suis vraiment content que tu aies décidé de m’accompagner."

#: scenario8:scenario8_CD72C044_BFA1_41D0_8B39_3193E6CED39F
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: e374e9883c5db32d01d4f981a999865ab7a31239b54f6b591a17e71b5bcb0039
#. default-sha256: 528f637efc4ca083a87210a09ecf7a2166571aad9e79bef973ef55c4f7071194
msgctxt "scenario8:scenario8_CD72C044_BFA1_41D0_8B39_3193E6CED39F"
msgid ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫Until that day, I had never known how good it felt to have someone who wanted me "
"in their life—"
msgstr ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫Jusqu’à ce jour, je ne m’étais jamais rendu compte à quel point ça faisait du bien "
"d’avoir quelqu’un qui me voulait dans sa vie—"

#: scenario8:scenario8_DCB637E0_5BB5_4D40_BF49_0311E5C87F0E
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 02dc6e66bb68b0abacb998a926a9ea87a344d2b5cb7d1dcb0f5035367a855f64
#. default-sha256: 187704eabb0d21f13a39369fd381f7b792c5c7b15e569ebd463a9d033c803c48
msgctxt "scenario8:scenario8_DCB637E0_5BB5_4D40_BF49_0311E5C87F0E"
msgid "⟪k:0⟫who saw me for me."
msgstr "⟪k:0⟫qui me voyait pour ce que j’étais."

#: scenario8:scenario8_78516612_89A0_4842_AE37_8A5A650138DF
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 00dd0fb8e2bc788d46ae7777656cf50fe641a5fdaefca79e1348b51c4b6e3240
#. default-sha256: 704fddbbf381684aadc3e88d046043da9694a69d3de8a5d5ebbcedcae8a9bab8
msgctxt "scenario8:scenario8_78516612_89A0_4842_AE37_8A5A650138DF"
msgid ""
"⟪k:0⟫I was hardly prince material—⟪k:1⟫⟪k:2⟫I wasn’t strong or handsome or regal enough for that—"
msgstr ""
"⟪k:0⟫Je n’étais pas fait pour être un prince —⟪k:1⟫⟪k:2⟫ je n’étais pas fort, beau, rien de royal "
"dans ce genre —"

#: scenario8:scenario8_75447CBB_525D_40EE_A675_182108C12D34
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 48733d949c13ac9997bd9987d669e192f56f664207c148524fe2734e902f9e38
#. default-sha256: 27714081f4536e10594cd221b2522a763711018eae72c1e995df08835e625581
msgctxt "scenario8:scenario8_75447CBB_525D_40EE_A675_182108C12D34"
msgid "⟪k:0⟫“I’m staying home because I want to be with you as much as possible.”"
msgstr "⟪k:0⟫« Je reste à la maison parce que je veux être avec toi le plus possible »."

#: scenario8:scenario8_8D5AB42A_967E_45D3_B838_B7700592D49C
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: cc252c281000f0a7b342861a7a9fcd08fc9d327a4c29b1b54f81a22d102e2a5b
#. default-sha256: 8302a12e4a57af48fa184720e8a867170d1c2dda93163a2920f6740533e5bd27
msgctxt "scenario8:scenario8_8D5AB42A_967E_45D3_B838_B7700592D49C"
msgid "⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫Welcome home, dearest Mell! What did you buy today?"
msgstr ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫T’es de retour à la maison, mon très cher Mell ! Qu’est-ce que t’as acheté "
"aujourd’hui ?"

#: scenario8:scenario8_D8D84C66_4B84_4F88_B226_A876B8F45AD9
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 3b659e39198b7899f21da5b25d1449e41eb7b670514c00a4a91f12ef48b05b96
#. default-sha256: ace73ff062496cdb641cc26b89fea47e304081fd0ebf734bbb9e5b7d9e78313f
msgctxt "scenario8:scenario8_D8D84C66_4B84_4F88_B226_A876B8F45AD9"
msgid ""
"⟪k:0⟫⟪k:1⟫Wow! I’ve never seen one so up close before!⟪k:2⟫⟪k:3⟫Are we going to keep it as a pet?"
msgstr ""
"⟪k:0⟫⟪k:1⟫Ouah ! J’en ai jamais vu un d’aussi près !⟪k:2⟫⟪k:3⟫On va le garder comme animal de "
"compagnie ?"

#: scenario8:scenario8_B6DAF2C0_14E5_41D0_9248_6F5891F8439C
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
