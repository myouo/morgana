msgid "⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫............"
msgstr "⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫............"

#: prologue:prologue_9C5985A3_A450_4279_89AD_E4C9055CB369
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: c2999ccd4b7fdd01cf06cca8be1b95d0269bfb7805222c809696f6eb3c083b30
#. default-sha256: f37b2ec2a8589b4ac7e301f491ddb123443932feb98654bca11bfbd181dfa88b
msgctxt "prologue:prologue_9C5985A3_A450_4279_89AD_E4C9055CB369"
msgid "⟪k:0⟫What’s the occasion? You never come to wake me up."
msgstr "⟪k:0⟫Que se passe-t-il ? C'est bien la première fois que tu me réveilles."

#: prologue:prologue_68962FD1_5789_4814_BF46_B3586D07440A
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 013e04f14502199c617ea09d5ac775e4f4c9dc6bd52d703ada40fde1ddc86429
#. default-sha256: 9d992592999b1b56f407b025941ec33ca2f6854a0015498edb46c42e10cacc7e
msgctxt "prologue:prologue_68962FD1_5789_4814_BF46_B3586D07440A"
msgid ""
"⟪k:0⟫⟪k:1⟫I was merely concerned for your health.⟪k:2⟫⟪k:3⟫You really should be sleeping in a "
"proper bed."
msgstr ""
"⟪k:0⟫⟪k:1⟫Je me faisais simplement du souci pour votre santé.⟪k:2⟫⟪k:3⟫Vous devriez vraiment "
"dormir dans un vrai lit."

#: prologue:prologue_CF9E89B3_32AE_40C3_9AFC_47CEAC6DA8C3
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 44d12af8f12b6213557abedf950f2897dd5d34c0180d6df9203beedb5ccd8902
#. default-sha256: b7be2c920e932df5fc83463e6335cb599e9d20e99a7c9333626d2166c7370b76
msgctxt "prologue:prologue_CF9E89B3_32AE_40C3_9AFC_47CEAC6DA8C3"
msgid ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫You were ⟪k:3⟫concerned⟪k:4⟫? About ⟪k:5⟫me⟪k:6⟫?⟪k:7⟫⟪k:8⟫You do realize the "
"concept of “health” bears little meaning for either of us, don’t you?"
msgstr ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫Tu te faisais du ⟪k:3⟫souci⟪k:4⟫ ? Pour ⟪k:5⟫moi⟪k:6⟫ ?⟪k:7⟫⟪k:8⟫Tu te rends "
"compte, j'espère, que le concept de « santé » n'a aucun sens lorsqu'il s'agit de nous ?"

#: prologue:prologue_42F500E6_AADF_4523_B5D0_46846E73867B
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 2bb367864c62c5e09fac47cc4cc386918bb34c06d817363c7c300c140ab774c0
#. default-sha256: 7f6a7a9820e5f4c1aaa5035b8996db2105d980431eb36c74ca724b78bf149f1c
msgctxt "prologue:prologue_42F500E6_AADF_4523_B5D0_46846E73867B"
msgid ""
"⟪k:0⟫⟪k:1⟫Why would I not be concerned? ⟪k:2⟫You ⟪k:3⟫are⟪k:4⟫ me.⟪k:5⟫⟪k:6⟫If something were to "
"cause you to depart this world,⟪k:7⟫the same would happen to me."
msgstr ""
"⟪k:0⟫⟪k:1⟫Et pourquoi est-ce que je n'ai pas le droit de m'inquiéter ? ⟪k:2⟫Vous ⟪k:3⟫êtes⟪k:4⟫ "
"moi.⟪k:5⟫⟪k:6⟫Si quelque chose vous poussait à quitter ce monde,⟪k:7⟫il m'arriverait la même "
"chose."

#: prologue:prologue_B351EC4B_885F_482C_B4CB_BCEFFF7E34F7
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 341710b3d9ef61b53a620317dee381a5e2781ea922603ce7fddc75568ae447b9
#. default-sha256: 897273cf4aaa8fb568ae9f99f7592d32f2cc389c0fe6c976441f350fd6a612cc
msgctxt "prologue:prologue_B351EC4B_885F_482C_B4CB_BCEFFF7E34F7"
msgid "⟪k:0⟫⟪k:1⟫⟪k:2⟫Ahh... ⟪k:3⟫right.⟪k:4⟫⟪k:5⟫That’s true."
msgstr "⟪k:0⟫⟪k:1⟫⟪k:2⟫Ahh... ⟪k:3⟫oui.⟪k:4⟫⟪k:5⟫C'est vrai."

#: prologue:prologue_219F44A4_AECD_4C4F_AFBA_6559324490AB
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: e07262f1e3f11ad6db5c66fe69476d3eed5f315c2c35230e10c6387dc515a9f4
#. default-sha256: 452a5bbc50fc79f1690dec4ecd51a486e36b8bb4a8f7681c5be5e32a9b8dd9f8
msgctxt "prologue:prologue_219F44A4_AECD_4C4F_AFBA_6559324490AB"
msgid ""
"⟪k:0⟫(It was so long ago, I almost forgot I told her she was me.⟪k:1⟫⟪k:2⟫And it would seem she "
"still believes that to be the case.)"
msgstr ""
"⟪k:0⟫(Depuis le temps, j'avais presque oublié que je lui avais dit qu'elle était moi.⟪k:1⟫⟪k:2⟫Et "
"il semblerait qu'elle le croie toujours.)"

#: prologue:prologue_3BF7FF21_91E5_45AA_8A70_93A97AE211F1
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: af097d1c708597dda9f8bd108ec2dafc575e8b14cab0234b0db6d853c3187b74
#. default-sha256: 59a8dcaf8c649b9048d14c995a362632dd3685b107fea906a1d2ea8f55e3c5c5
msgctxt "prologue:prologue_3BF7FF21_91E5_45AA_8A70_93A97AE211F1"
msgid "⟪k:0⟫(Foolish woman.)"
msgstr "⟪k:0⟫(Quelle idiote.)"

#: prologue:prologue_2494829B_6EF8_4259_8A89_724BF8C2E9BE
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 7e37d0237cbd5441a556b0984458e110a878aba9e54e13d4844743e9ef07fa70
#. default-sha256: 19cfe83058df3633546bde412297755489b2a1cb57afec14a4c33f59cc348976
msgctxt "prologue:prologue_2494829B_6EF8_4259_8A89_724BF8C2E9BE"
msgid ""
"⟪k:0⟫⟪k:1⟫Hehe... ⟪k:2⟫What kind of herbal tea would you like to start your day with?⟪k:3⟫⟪k:4⟫I "
"have some lovely mint leaves, if you would like.⟪k:5⟫⟪k:6⟫They are wonderful for improving one’s "
"mood."
msgstr ""
"⟪k:0⟫⟪k:1⟫Héhé... ⟪k:2⟫Quelle tisane aimeriez-vous pour commencer la journée ?⟪k:3⟫⟪k:4⟫J'ai de "
"délicieuses feuilles de menthe, si vous voulez.⟪k:5⟫⟪k:6⟫Elles sont très efficaces pour avoir le "
"moral."

#: prologue:prologue_A3379ACC_2922_40DF_B93A_42D0249E6756
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: cf132fd016c134562c5de44b295e70024d3cca781766e041e01e61660be806da
#. default-sha256: b2e03676f538c2859e31b44200eb8c819be3adc68b976ea43422537f590c4701
msgctxt "prologue:prologue_A3379ACC_2922_40DF_B93A_42D0249E6756"
msgid "⟪k:0⟫⟪k:1⟫⟪k:2⟫I have no interest in—⟪k:3⟫⟪k:4⟫or need for—⟪k:5⟫⟪k:6⟫tea."
msgstr "⟪k:0⟫⟪k:1⟫⟪k:2⟫Je n'ai pas envie —⟪k:3⟫⟪k:4⟫ ni besoin —⟪k:5⟫⟪k:6⟫ de thé."

#: prologue:prologue_2A7416EA_6EC3_4EC3_B482_0837EB84EE2E
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 75a59ee93a81d59dd1f922118803b1f0634dc6ee1da70c5a27106b147785e19c
#. default-sha256: f79e55bca779d4b15fb4bb9f8f3fd66660aab69fab798f4143291627c1c581d6
msgctxt "prologue:prologue_2A7416EA_6EC3_4EC3_B482_0837EB84EE2E"
msgid "⟪k:0⟫⟪k:1⟫That is most unfortunate."
msgstr "⟪k:0⟫⟪k:1⟫Quel dommage."

#: prologue:prologue_8FC837AF_E40A_4C1D_94F4_77A8DB4EDBD0
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 0481d54c309baf4e53abcbf9deb6221e1cbb5be05835ee6dbdcabb0fc0bc77c7
#. default-sha256: a65ffeac54067d6f0c3f1c6eff5b7afb2095b4468ff8f1162ee3ffb590f5b548
msgctxt "prologue:prologue_8FC837AF_E40A_4C1D_94F4_77A8DB4EDBD0"
msgid "⟪k:0⟫⟪k:1⟫In that case, perhaps you could tell me a story?"
msgstr "⟪k:0⟫⟪k:1⟫Dans ce cas, vous pourriez peut-être me raconter une histoire ?"

#: prologue:prologue_403866E0_6E4F_493B_A27C_2C7EAFE6329E
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 10158a0952129d34bf08b88c48515c9913df1f6a2e3ef0c9a83dbc76ca3b9f79
#. default-sha256: df6243319b6cc759298fda8efec71560724bdce501f03f76e7138ef9658a9600
msgctxt "prologue:prologue_403866E0_6E4F_493B_A27C_2C7EAFE6329E"
msgid "⟪k:0⟫⟪k:1⟫⟪k:2⟫A story?⟪k:3⟫⟪k:4⟫You mean the one about Michel and Giselle again?"
msgstr ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫Une histoire ?⟪k:3⟫⟪k:4⟫Tu veux entendre celle de Michel et de Giselle, une fois "
"de plus ?"

#: prologue:prologue_0B05D229_DD6F_426C_BBE6_F3909259CA5D
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 20c8d5873ee73f3447f9fee718826de40d86a8b9f3976387f4a3f83d461b3980
#. default-sha256: f59f4577e0ac0733eeb1b1011f22fd02b9604f07241a497c0204272df66ab596
msgctxt "prologue:prologue_0B05D229_DD6F_426C_BBE6_F3909259CA5D"
msgid "⟪k:0⟫⟪k:1⟫Yes, that one.⟪k:2⟫⟪k:3⟫I do love that story oh so very much."
msgstr "⟪k:0⟫⟪k:1⟫Oui.⟪k:2⟫⟪k:3⟫J'adore cette histoire, je l'aime tellement."

#: prologue:prologue_4604B25A_659B_44D1_9FFC_0469BC280F95
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 2e9fb674628b5692c22aff55aa72498bf2c560f0101923577f74baa4da26dd96
#. default-sha256: d289d156768468feb11fb23271bc4062c51fc0c8bf95dbba570a8fa64f7c231c
msgctxt "prologue:prologue_4604B25A_659B_44D1_9FFC_0469BC280F95"
msgid ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫I, for one, am growing rather tired of it.⟪k:3⟫⟪k:4⟫I’ve told it to you dozens of "
"times now."
msgstr ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫En ce qui me concerne, je commence à m'en lasser.⟪k:3⟫⟪k:4⟫Je te l'ai déjà "
"racontée des dizaines de fois."

#: prologue:prologue_DB2E9551_BD10_4F5E_B19B_02E32600B333
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 20d8b377fa446b94c1df865d09784b0c5b021c1443c5324de13472552886ec33
#. default-sha256: d36f9a7732b12a998d50274013be77ad70a87f0d35f6219135faae77591ace67
msgctxt "prologue:prologue_DB2E9551_BD10_4F5E_B19B_02E32600B333"
msgid ""
"⟪k:0⟫⟪k:1⟫Now, don’t be like that.⟪k:2⟫⟪k:3⟫The best stories never stop being moving,⟪k:4⟫no "
"matter how many times you hear them."
msgstr ""
"⟪k:0⟫⟪k:1⟫Allez, s'il vous plaît.⟪k:2⟫⟪k:3⟫Les meilleures histoires ne cessent de nous émouvoir,"
"⟪k:4⟫quel que soit le nombre de fois où on les entend."

#: prologue:prologue_FE9551A9_E7B3_4525_AC83_90F29E5824B3
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: f4f1622edddd3e040954b34b52301fd1a6cb67a958a4f5c7fcbe54f15f498f63
#. default-sha256: dfb9f941b53f11e8bd67d4e58edef94bb7f8a6bf31827ec55fea6298276ace4f
msgctxt "prologue:prologue_FE9551A9_E7B3_4525_AC83_90F29E5824B3"
msgid "⟪k:0⟫⟪k:1⟫⟪k:2⟫(It’s like I’m talking to a child...)"
msgstr "⟪k:0⟫⟪k:1⟫⟪k:2⟫(J'ai l'impression de parler à une enfant...)"

#: prologue:prologue_9A642A70_8B15_47C9_BD7B_BEB6E479AED8
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 9c927bc433628b704bd7316ee6a6b8fb9621b2ffe94110839bb662f1fc1b5f9c
#. default-sha256: 9c653e11e57dc7c9cb57aaeaf452efddcd65385bd2af267e6db46fbd88146c22
msgctxt "prologue:prologue_9A642A70_8B15_47C9_BD7B_BEB6E479AED8"
msgid ""
"⟪k:0⟫All right, then, how about this? ⟪k:1⟫I’m going to ask you a question,⟪k:2⟫and if you give "
"me an answer I like, I’ll tell you the story again."
msgstr ""
"⟪k:0⟫Bon, très bien, alors voici ce que je te propose : ⟪k:1⟫je vais te poser une question, et si "
"tu me donnes une réponse qui me plaît, je te raconterai l'histoire à nouveau."

#: prologue:prologue_37041A75_7016_4F96_B9C5_AD3F59AEC5F5
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 8c402c15b960809f0533e621dc191c87bc56a39e88398c1b86a550f2ed846458
#. default-sha256: dfa9fada2d8ca9ff404cdb97d42b2fb4921aa62ae07986208a5a6cbc12804af4
msgctxt "prologue:prologue_37041A75_7016_4F96_B9C5_AD3F59AEC5F5"
msgid "⟪k:0⟫⟪k:1⟫Oh? What kind of question?"
msgstr "⟪k:0⟫⟪k:1⟫Oh ? Quel genre de question ?"

#: prologue:prologue_DDEDFAD1_E397_4B12_B05A_473A3CDE182C
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 670eae1d4cb7ae4a7c1b1bbbf5f3f8107e304f6d14e027b9dc497900502761de
#. default-sha256: 0a247aed86545c3aec3482527be427c757a0966044d9a243827330c2f6fc74fc
msgctxt "prologue:prologue_DDEDFAD1_E397_4B12_B05A_473A3CDE182C"
msgid ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫Hehe... ⟪k:3⟫Nothing difficult, I promise.⟪k:4⟫⟪k:5⟫I want to hear your opinion on "
"something."
msgstr ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫Hihi... ⟪k:3⟫Rien de difficile, je te le promets.⟪k:4⟫⟪k:5⟫Je veux entendre ce que "
"tu as à dire sur un sujet."

#: prologue:prologue_30C3C1BA_1D3D_4D6D_A3C5_556EB160ED24
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: db908dc0b8a73b66331f594d17dc44cc77ccfd4b9f91ea465c0e0483ada58930
