msgctxt "prologue:prologue_1EB62C36_88AE_4696_8FA0_CF1CB598490F"
msgid "⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫⟪k:4⟫Hehehe... ⟪k:5⟫Good morning."
msgstr "⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫⟪k:4⟫Héhéhé... ⟪k:5⟫Bonjour."

