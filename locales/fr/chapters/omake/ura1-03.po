#: omake:omake_FC88912E_2931_41A4_92DD_9E4111F94673
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 6edc1e29ce22ed39b16d719ea0613addd623600f02930eef232503d6a0b8d476
#. default-sha256: 9f6196c0d2ac4e7fcb22fa2546a6b58fa3ebd12740e8c69bd7803d0be399ca7c
msgctxt "omake:omake_FC88912E_2931_41A4_92DD_9E4111F94673"
msgid "⟪k:0⟫⟪k:1⟫⟪k:2⟫Well, never mind that for now."
msgstr "⟪k:0⟫⟪k:1⟫⟪k:2⟫Bon, ce n’est pas grave."

#: omake:omake_842EAA67_89AC_4204_B51D_994B16A9A5B6
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: e361a29a8dae16622ce1dacde51dad60866c50b85adf84fd29c56e464662d616
#. default-sha256: 52a9b247e9ecfc74746bbb194b6b39516b54e9889c039e9e0ebd49a50f87e04b
msgctxt "omake:omake_842EAA67_89AC_4204_B51D_994B16A9A5B6"
msgid ""
"⟪k:0⟫I would ask you what you thought of it,⟪k:1⟫but unfortunately, that is beyond even my powers."
msgstr ""
"⟪k:0⟫Je vous demanderais bien ce que vous en avez pensé,⟪k:1⟫mais malheureusement, c’est en-"
"dehors de mes compétences, même pour moi."

#: omake:omake_F9A09CB9_71D9_41BD_8D28_DFAE4B4D5048
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 1dddfa3af6735dec48e577e16519a52f4a888c5f5226283cb5ab0074581ec727
#. default-sha256: db412188bbec51e59eb429d72586dc294b2eee9ef116e63fc6db482922d208bd
msgctxt "omake:omake_F9A09CB9_71D9_41BD_8D28_DFAE4B4D5048"
msgid "⟪k:0⟫⟪k:1⟫⟪k:2⟫...You’ve got a strong stomach, at least."
msgstr "⟪k:0⟫⟪k:1⟫⟪k:2⟫...Vous avez l’estomac bien accroché, au moins."

#: omake:omake_3D14B59C_669A_473A_81E7_82B165B4E507
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 7d9465fa4e3ca27e92b28ced62fe12e4e09b613ca7bfc1978ba13df274909227
#. default-sha256: 4783cc6178f5f97027d3bc7a8ada7c71ed61aa92ea0665bf441e3c8e02bd2142
msgctxt "omake:omake_3D14B59C_669A_473A_81E7_82B165B4E507"
msgid ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫Before we begin our little trek, I would like to emphasize that this is,⟪k:3⟫as "
"the title implies, a look behind the curtains of ⟪k:4⟫The House in Fata Morgana⟪k:5⟫."
msgstr ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫Avant de commencer notre petite promenade, j’aimerais préciser,⟪k:3⟫comme son "
"titre l’indique, que nous allons derrière les rideaux du jeu ⟪k:4⟫The House in Fata Morgana⟪k:5⟫."

#: omake:omake_8C0E56DE_602A_2D29_9429_071DD0D4C50A
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 0df73789a07924430b2e09a9c8d267e3de5e6b5be82729e70187889b0d1dce17
#. default-sha256: e93446f82703bd229e0332f52399f4c5e40b14c9eec2301ae5d3b0dc439cdc2f
msgctxt "omake:omake_8C0E56DE_602A_2D29_9429_071DD0D4C50A"
msgid ""
"⟪k:0⟫⟪k:1⟫But should you choose to continue, I encourage you to do so knowing that what you’re "
"about to read does not in any way respect the tone of the game proper."
msgstr ""
"⟪k:0⟫⟪k:1⟫Mais si vous choisissez de continuer, je vous encourage à le faire en sachant que ce "
"que vous vous apprêtez à lire ne respecte en aucun cas le ton du jeu lui-même."

#: omake:omake_5973E007_064C_48B3_A4D6_641D2CD416FC
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 1d19b94feae32e97e91e2db6345785579e07133ef6878d089e659c8677165fb5
#. default-sha256: a0ff136a33770447bf813749e8be7662610927a9b715b111adb7986812e1e4ba
msgctxt "omake:omake_5973E007_064C_48B3_A4D6_641D2CD416FC"
msgid ""
"⟪k:0⟫You’ll be making your way into the heads of the staff themselves,⟪k:1⟫and I promise you—⟪k:2⟫"
"⟪k:3⟫it’s not a pretty sight."
msgstr ""
"⟪k:0⟫Vous allez entrer dans la tête des créateurs eux-mêmes,⟪k:1⟫et, je peux vous l’assurer—⟪k:2⟫"
"⟪k:3⟫ ce n’est pas joli joli."

#: omake:omake_8A3E8667_5714_4479_945B_89A82141E83A
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 041a8f2abd4bf3f43fbc7032aca08b137957d7fd54db814464e7ea1a2bcb571a
#. default-sha256: 5f38245478369273bbab7e019f32a76c24ef40cf93daafb4bf582e47fd7aff0e
msgctxt "omake:omake_8A3E8667_5714_4479_945B_89A82141E83A"
msgid "⟪k:0⟫Let us be off, then."
msgstr "⟪k:0⟫C’est parti, allons-y."

#: omake:omake_0D388061_5E2E_478A_ACF1_CABD30013371
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 9faf7c7cd9f514817c77aa46e9e70b7807e6b6bff8d0f5dd30b2bacbbde64664
#. default-sha256: 72d52e247a187b7b29b1e28db757491560dd8077cf4898176376c7e88702f23d
msgctxt "omake:omake_0D388061_5E2E_478A_ACF1_CABD30013371"
msgid ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫⟪k:4⟫⟪k:5⟫⟪k:6⟫Ah! I found another split end!⟪k:7⟫⟪k:8⟫Look, this one’s split "
"into three!"
msgstr ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫⟪k:4⟫⟪k:5⟫⟪k:6⟫Ah ! J’ai trouvé une autre pointe fourchue !⟪k:7⟫⟪k:8⟫Regarde, "
"celle-là s’est même séparée en trois !"

#: omake:omake_C02C6675_80EB_49E5_9A4B_007813BB63CA
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 3e3c1da6c9625d6ff77bcb9ea7069a263a0b56d14867c6ff4dd82e0dfcfff014
#. default-sha256: 8b380104ce5a1dee147a2a2546740c780bcbc5e8f8ac786be60fb28440908a78
msgctxt "omake:omake_C02C6675_80EB_49E5_9A4B_007813BB63CA"
msgid ""
"⟪k:0⟫I-⟪k:1⟫I— ⟪k:2⟫⟪k:3⟫I didn’t actually mean that!⟪k:4⟫⟪k:5⟫I was just, ⟪k:6⟫you know, ⟪k:7⟫a "
"little overwhelmed at the time!⟪k:8⟫About how unexpectedly handsome you were!⟪k:9⟫But I couldn’t "
"bring myself to say it!"
msgstr ""
"⟪k:0⟫Je-⟪k:1⟫Je— ⟪k:2⟫⟪k:3⟫Je le pensais pas vraiment !⟪k:4⟫⟪k:5⟫C’est juste que, ⟪k:6⟫tu sais "
"bien, ⟪k:7⟫j’étais dans tous mes états, à l’époque !⟪k:8⟫Ça m’a prise par surprise, je pensais "
"pas que t’étais aussi beau !⟪k:9⟫Mais j’étais incapable de te le dire !"

#: omake:omake_DE51EA4A_A870_40CF_91A4_9D835B779A79
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 815d12b37670340a99e6d0a50a03944580bee9433e8caf6469ceffe0af7c882f
#. default-sha256: 30d006504fe4d27417bceb8d2e919d66da09d3edea719bfc9d430effa4035f73
msgctxt "omake:omake_DE51EA4A_A870_40CF_91A4_9D835B779A79"
msgid "⟪k:0⟫I hope you two sickening lovebirds spontaneously combust..."
msgstr "⟪k:0⟫Ces deux amoureux me donnent la nausée, j’espère que vous serez foudroyés..."

#: omake:omake_7F2F89CD_77AE_4D18_96BE_501ABA446818
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: dd2953dbe8b352110ee5a3d846f4a4bda61013ad092a51e6cf794509b291d6a5
#. default-sha256: 500f2ebb0cea775a1b769d2e9ff03d5f1ab642fbb07b317923779794d4ee1ac5
msgctxt "omake:omake_7F2F89CD_77AE_4D18_96BE_501ABA446818"
msgid ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫As the true master of this house, I am everywhere at all times.⟪k:3⟫⟪k:4⟫Even in "
"the bathrooms."
msgstr ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫Je suis la maîtresse de la maison, je suis donc partout à la fois.⟪k:3⟫⟪k:4⟫Même "
"dans les toilettes."

#: omake:omake_05A8DDD2_7450_494D_9A7A_1B323EC72C6E
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: f7e7f30e5da6089c3930e51a439db5687dde50605bcd30534bb29ff1ed1db203
#. default-sha256: 55c6fd476ab67ecdcd93bbb1c2e03eee3598828cd2ee02d2a91b2a9c32f62c50
msgctxt "omake:omake_05A8DDD2_7450_494D_9A7A_1B323EC72C6E"
msgid ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫I think that’s enough toilet humor for the time being.⟪k:3⟫⟪k:4⟫Especially in "
"front of our guest."
msgstr ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫Je crois qu’on a assez parlé toilettes pour aujourd’hui.⟪k:3⟫⟪k:4⟫Surtout devant "
"notre invité."

#: omake:omake_FD6983FC_6500_4BC7_BE9D_0AC6E8F24B4A
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 9c6600d649db2e74dcc8b1938dea14f799c570e04b025e8c997f3b81ee054fa8
#. default-sha256: 450c288d1ced6fb9291fd68c41a1614bdc302448d2633b170baf590521ccb2c8
msgctxt "omake:omake_FD6983FC_6500_4BC7_BE9D_0AC6E8F24B4A"
msgid "⟪k:0⟫⟪k:1⟫It just... ⟪k:2⟫never really seemed that way to me..."
msgstr "⟪k:0⟫⟪k:1⟫Non... ⟪k:2⟫j’ai jamais vu les choses sous cet angle, c’est tout..."

#: omake:omake_8BA87D65_BDE0_4565_B0AE_E16CA2BF4C6D
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 6a44646acace9f389fa50ea433d04d89a832e41fb5e1a17b530761498b8abbcd
#. default-sha256: 8c7546cc9820b032681ef93596a5e441caad862b58e406d9512533ebae897d15
msgctxt "omake:omake_8BA87D65_BDE0_4565_B0AE_E16CA2BF4C6D"
msgid ""
"⟪k:0⟫⟪k:1⟫But once you reclaimed yourself, you were most definitely playing the protagonist. ⟪k:2⟫"
"Especially the final chapter! You had me swooning by the end!"
msgstr ""
"⟪k:0⟫⟪k:1⟫Mais une fois que tu as retrouvé ton identité, tu as définitivement joué le rôle du "
"protagoniste. ⟪k:2⟫Surtout au chapitre final ! Haut les cœurs pour Michel !"

#: omake:omake_48AEFCD0_9BAB_438B_A1E5_5BD013A1151B
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: f70b53f5c305c0c11128e3b6cc3608e6392d4dea4ea56b4b37c35ec20f37f6a8
#. default-sha256: 7398a312de5a80e08c7a3c073d4d2da22b60b26e2da4c994e16b542d948b3c37
msgctxt "omake:omake_48AEFCD0_9BAB_438B_A1E5_5BD013A1151B"
msgid ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫What do you think, my dear? ⟪k:3⟫What any respectable behind-the-scenes extra "
"would do, of course—"
msgstr ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫À⟪k:4⟫ ton avis, très cher ? ⟪k:5⟫Ce que tout making-of qui se respecte "
"ferait, bien entendu—"

#: omake:omake_2A7F3CA3_1134_4621_BF76_8BE0B1176ACB
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: d3db251f99fc10f8e0b594fc61464160be2a0fa5cdd3e13eacf5e9e092c109f7
#. default-sha256: 6e86b2d7a0306fbddafe0fea60d2218b8f166f384fe2f2a6b7314416b18675a4
msgctxt "omake:omake_2A7F3CA3_1134_4621_BF76_8BE0B1176ACB"
msgid "⟪k:0⟫we’re going visit each room in the mansion and faff about like a bunch of fools."
msgstr "⟪k:0⟫nous allons visiter chaque pièce du manoir et glander comme une bande d’idiots."

#: omake:omake_060CE94C_E0AE_47B9_9D2B_6BC0BB35989D
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 2810cd08f8e5de7944d8a72d3ba52810e6f37e0f01cdd310e33cdb3fb539e06a
#. default-sha256: b10d82a68a4d62c3150b0936b91ec0a6453ec8e4e51fd231ecb20cc3c4dfeb9e
msgctxt "omake:omake_060CE94C_E0AE_47B9_9D2B_6BC0BB35989D"
msgid "⟪k:0⟫⟪k:1⟫............"
msgstr "⟪k:0⟫⟪k:1⟫............"

#: omake:omake_DD46117D_9ECB_4B85_BC2C_B5C1D59040E9
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: a95c35132ab1f8dcee3171e6415b3e78a56a5bbb4bea10ec8c26e862e5fe7c8c
#. default-sha256: fa8a1d668a67598c9f7ae9e6879e5f0b6441448ae51713aee3c4f092db4666fc
msgctxt "omake:omake_DD46117D_9ECB_4B85_BC2C_B5C1D59040E9"
msgid ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫You can’t deny a lot of readers probably didn’t expect the creepy white-haired "
"recluse to turn out to be the main character."
msgstr ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫Tu ne peux pas nier que de nombreux lecteurs ont dû probablement être étonnés de "
"voir le reclus aux cheveux blancs un peu glauque devenir le personnage principal."

#: omake:omake_AB7DE4F2_5BDB_46C5_B426_851B3684F16C
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 6b629dbd7138ed5833960308f61271940358742447b16a24550921e4c9fd4de0
#. default-sha256: 78527fae6f6777d3770da811fff5c2a2d6dbcfc0d7e168af4496c8616f464e69
msgctxt "omake:omake_AB7DE4F2_5BDB_46C5_B426_851B3684F16C"
msgid ""
"⟪k:0⟫Though perhaps there are some people whose interpretations did not change throughout the "
"course of the tales."
msgstr ""
"⟪k:0⟫Mais peut-être que certaines personnes n’ont pas changé d’interprétation en lisant le conte."

#: omake:omake_409E38F1_AD87_424A_9225_01F6D09C8F9D
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 7cb849de3465d51d827005b21bd07718ee3fefc8e95bb6c2b7cbb10232474ef1
#. default-sha256: 101e5947f274879456f55107eaf0db62087385041a3d239e045fd0b0a91a281e
msgctxt "omake:omake_409E38F1_AD87_424A_9225_01F6D09C8F9D"
msgid "⟪k:0⟫⟪k:1⟫No, that’s not how you pronounce his name.⟪k:2⟫⟪k:3⟫As I recall, it’s Eucalyptus—"
msgstr ""
"⟪k:0⟫⟪k:1⟫Non, ce n’est pas comme ça que ça se prononce.⟪k:2⟫⟪k:3⟫Si je m’en souviens bien, c’est "
"Eucalyptus—"

#: omake:omake_0563CC2F_1F91_4F15_AA9C_CA7CEC8E9CA9
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 02f20f44806fb9fb99188964f18bf1e4bb9281be87d223141a47a10c9bf38ac7
#. default-sha256: 8b5c0d34447b972946f6c30e828710ff35a77ff218f004d33872b83bf5c1e5bf
msgctxt "omake:omake_0563CC2F_1F91_4F15_AA9C_CA7CEC8E9CA9"
msgid ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫You already made that joke. Let it go, please.⟪k:3⟫⟪k:4⟫That creature doesn’t need "
"a name. Just call him “the beast.”"
msgstr ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫Vous avez déjà fait cette blague. Laissez tomber, je vous en prie.⟪k:3⟫⟪k:4⟫Cette "
"créature n’a pas besoin de nom. Appelez-la simplement « la bête »."

#: omake:omake_E6ED0CF4_EA96_43F7_8609_288EDFB5E6DA
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 5d0f23244d4fc838de95f0df6e5920c879c9af044290662d24dd7d67066754d2
#. default-sha256: ec767cb133b47c12749233ea82f621909964b28e7bcb122d1d02774cf908e4f5
msgctxt "omake:omake_E6ED0CF4_EA96_43F7_8609_288EDFB5E6DA"
msgid ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫At the end of that chapter, you learn what kind of man he really was, which then "
"ties into the revelations in the final chapter."
msgstr ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫À⟪k:4⟫ la fin de ce chapitre, on apprend quel genre d’homme il est vraiment, "
"ce qui rejoindra les révélations du chapitre final."

#: omake:omake_C5A798EB_B811_4ED8_AFAC_A061A9511D1D
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: c74eec995e795ecc94e0c754a16c21d094c15d962b5e5505047668d20ea50db2
#. default-sha256: 801635a9c4b0c19349b03dced24cd5e56d12b606c0f3b9af33c5d46e0bc6fe1a
msgctxt "omake:omake_C5A798EB_B811_4ED8_AFAC_A061A9511D1D"
msgid "⟪k:0⟫⟪k:1⟫.................."
msgstr "⟪k:0⟫⟪k:1⟫.................."

#: omake:omake_50B816BD_A179_493D_9A53_C8C56CE248FA
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: af2a853c2289534dfcd26976bffcecaf90f304ac2fba7c466047ec896f034e2a
#. default-sha256: c7149e437bf7201ef8f5e215cd294bba598a5bc12c76ae5f7c566c506eb9f150
msgctxt "omake:omake_50B816BD_A179_493D_9A53_C8C56CE248FA"
msgid "⟪k:0⟫I don’t hold it against you, though."
msgstr "⟪k:0⟫Mais je ne t’en veux pas."

#: omake:omake_6F5B9841_CFC1_491F_A9B2_FBB2DF203B6D
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: ba449d91ae6bf686705116dbf98862ff47fdcf933043902885edf45e9775a7aa
#. default-sha256: b10d82a68a4d62c3150b0936b91ec0a6453ec8e4e51fd231ecb20cc3c4dfeb9e
msgctxt "omake:omake_6F5B9841_CFC1_491F_A9B2_FBB2DF203B6D"
msgid "⟪k:0⟫⟪k:1⟫............"
msgstr "⟪k:0⟫⟪k:1⟫............"

#: omake:omake_0A72F11A_330D_41F5_9178_3472164D57AD
