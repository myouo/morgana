msgid "⟪k:0⟫⟪k:1⟫Since you’re here, though, how would you like to take a little tour of the house?"
msgstr "⟪k:0⟫⟪k:1⟫Mais puisque vous êtes là, pourquoi ne pas faire un petit tour de la maison ?"

#: omake:omake_2574838F_36C7_4107_9AF5_2F7E11A0C43F
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 0841cdb7c290110518545a9639bcf4c1b3734b5fb9da4ea0cf7838bbcaeefbee
#. default-sha256: 71153cb014dcf64ec8528db392c6b76f7deff617f80f09c037386b80e643c0c0
msgctxt "omake:omake_2574838F_36C7_4107_9AF5_2F7E11A0C43F"
msgid ""
"⟪k:0⟫I don’t know why you’re so excited about split ends...⟪k:1⟫⟪k:2⟫If my hair’s such a mess, "
"maybe I should just cut it all off."
msgstr ""
"⟪k:0⟫Je ne sais pas ce que tu as avec les pointes fourchues...⟪k:1⟫⟪k:2⟫Si mes cheveux sont dans "
"un tel désordre, je ferais peut-être mieux de tout couper."

#: omake:omake_0C0EE1DB_3843_4E39_AA33_F255BD48212B
