#: omake:omake_FA818BD6_BB3B_4F25_9C0C_5DBC194FFB00
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 39c5bf6bd5972f7f9eafdb3ad4f3e9712e20c4875c9a1d1c3c68f166c24f5370
#. default-sha256: 91f9d4f88a9e702a3530b4562b52f87363b9fd8a438c03ad7bd2bad78544f8a8
msgctxt "omake:omake_FA818BD6_BB3B_4F25_9C0C_5DBC194FFB00"
msgid "⟪k:0⟫Nor do I really think of myself that way.⟪k:1⟫⟪k:2⟫I’m hardly a paragon of virtue..."
msgstr ""
"⟪k:0⟫Et je ne me vois pas vraiment comme ça.⟪k:1⟫⟪k:2⟫Je suis loin d’être un parangon de vertu..."

#: omake:omake_144794EF_6F90_4486_983B_6646972FE572
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 3cfc4c3bcf4381482eb6c41894cf3fb2a70c4f979a462777d27117b3644d2aa1
#. default-sha256: e0065588577ee9f1ca36f012c5c735014d37d32f6e5aefc56956e9be87e79774
msgctxt "omake:omake_144794EF_6F90_4486_983B_6646972FE572"
msgid ""
"⟪k:0⟫Your circumstances in life forced you to repress yourself, and once you were free from those "
"restrictions in the final chapter, you were able to act as the man you truly are. Or something to "
"that effect."
msgstr ""
"⟪k:0⟫Les aléas de ta vie t’ont forcé à te réprimer, et une fois que tu en as été libéré dans le "
"dernier chapitre, tu étais en mesure d’agir comme l’homme que tu es véritablement. Ou quelque "
"chose dans le genre."

#: omake:omake_EA304DC3_4096_42AB_8FD6_4ADFDF7BCA8C
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
