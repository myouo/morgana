msgid "⟪k:0⟫⟪k:1⟫(Don’t forget about yourself, Morgana...)"
msgstr "⟪k:0⟫⟪k:1⟫(Et toi aussi, Morgana...)"

#: omake:omake_C735FC1D_0557_4962_A5BB_14F11B1C53E0
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 1710c19b1335beb536d5ec6ef468010568f13eb7ad00250b304f011b78e3f269
