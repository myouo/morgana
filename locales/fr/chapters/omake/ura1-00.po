#: omake:omake_8F3B5A95_060E_4BAC_972A_F08911B67416
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: a5e4630096d5925ce1979bd1d1f03a2d136ae1fe4f3f9a41aa0549b5fde3b283
#. default-sha256: d02be4716da50246bdabffda333cc887af0ab455d54c5fe9834860d86c722d2e
msgctxt "omake:omake_8F3B5A95_060E_4BAC_972A_F08911B67416"
msgid "⟪k:0⟫⟪k:1⟫The fact that you’re here means you’ve uncovered all the mansion’s mysteries, yes?"
msgstr ""
"⟪k:0⟫⟪k:1⟫Si vous êtes ici, ça veut dire que vous avez découvert tous les secrets du manoir, "
"c’est cela ?"

#: omake:omake_33DB8421_3078_4DDB_BCC8_CC85C82A31C9
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: ed1f489cf71e09656291bbeba15f6a49f467f6cbdfed7d66795db9c7ec5a9bee
#. default-sha256: ae0c7857e05965bf37d6ecbe041884b8b8e26652ef9cf995dbf5a61ce2e99602
msgctxt "omake:omake_33DB8421_3078_4DDB_BCC8_CC85C82A31C9"
msgid ""
"⟪k:0⟫⟪k:1⟫Hehe... ⟪k:2⟫My congratulations for having the fortitude to endure such a... ⟪k:3⟫grim "
"tale."
msgstr ""
"⟪k:0⟫⟪k:1⟫Hihi... ⟪k:2⟫Toutes mes félicitations pour avoir eu le courage de supporter un conte "
"aussi... ⟪k:3⟫sinistre."

#: omake:omake_D63F2895_E50C_46E2_9865_90EE7DAEF191
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 55c8f0941715281c0eee6914509b5ca058bc1cdd684f003d66be51940658b671
#. default-sha256: f8df57cabdbda144d9652f180dc7c4590b00412e8b80b965e1b6e38af56a1559
msgctxt "omake:omake_D63F2895_E50C_46E2_9865_90EE7DAEF191"
msgid "⟪k:0⟫⟪k:1⟫⟪k:2⟫That is, if you’re willing to take this hand."
msgstr "⟪k:0⟫⟪k:1⟫⟪k:2⟫Enfin, si vous êtes prêt à tenir ma main."

#: omake:omake_A617AD89_AEC1_4805_99EF_AA6B38AE5A1E
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: f316a457b5b83599aaccbe2989e3577c4c87bffa764709639a3372c5b5045435
#. default-sha256: 1d27e51df7ed25d99bee234a5214a4097989c793c809169215fba51f2848a18c
msgctxt "omake:omake_A617AD89_AEC1_4805_99EF_AA6B38AE5A1E"
msgid ""
"⟪k:0⟫⟪k:1⟫That said, I would prefer not to have to guide you around the house all by myself. ⟪k:2⟫"
"Not because I have anything in particular against you, of course."
msgstr ""
"⟪k:0⟫⟪k:1⟫Cela dit, je préfèrerais ne pas avoir à vous guider par moi-même dans toute la maison. "
"⟪k:2⟫Je n’ai rien contre vous, bien entendu."

#: omake:omake_DA265B35_DB52_473A_9DE9_B33FBA039094
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: dbca641e14da541771ce6f6d57c127a8beedf04e723b0d7085a00fb3f6af0b56
#. default-sha256: c8dd4bfee4f8669381aaae80b4dfafa2d2fce1fee7be3788752654ed38772945
msgctxt "omake:omake_DA265B35_DB52_473A_9DE9_B33FBA039094"
msgid ""
"⟪k:0⟫⟪k:1⟫I simply think it would be inappropriate for him not to accompany us—⟪k:2⟫yes, him. "
"This story’s protagonist."
msgstr ""
"⟪k:0⟫⟪k:1⟫Je crois simplement qu’il serait inconvenant qu’il ne nous accompagne pas—⟪k:2⟫oui, je "
"parle bien de lui. Le protagoniste de cette histoire."

#: omake:omake_0794DE9D_FE35_4A86_8F75_5AD32CE22656
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 1853e74aba841ff5b86dfd48cc592f47e2c1ad145118a4a675d19dbdefd2a40f
#. default-sha256: bf7dce3f0e4f890195bc1989b08cade1aae56c36add56be620a5dbba285c55cc
msgctxt "omake:omake_0794DE9D_FE35_4A86_8F75_5AD32CE22656"
msgid ""
"⟪k:0⟫⟪k:1⟫D-⟪k:2⟫Don’t worry! When I was in her position, I closed my eyes and plugged my ears "
"when you were doing your business!"
msgstr ""
"⟪k:0⟫⟪k:1⟫N-⟪k:2⟫Ne t’inquiète pas ! Quand j’étais à sa place, je fermais les yeux et je me "
"bouchais les oreilles quand tu y allais !"

#: omake:omake_C86A283F_EF5F_4910_9E27_FEEE835E9822
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 2ea4726801d95ca9edc59e454556ed3caba972424fe1cbddaf56d45ab69a7d0a
#. default-sha256: bf4c9d44c0240cd00db6ff4a1f02cfea9d14e8aeb374f5171437f3d40c07c24a
msgctxt "omake:omake_C86A283F_EF5F_4910_9E27_FEEE835E9822"
msgid "⟪k:0⟫⟪k:1⟫⟪k:2⟫In some ways, you could call the first four chapters an extended prologue."
msgstr ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫D’une certaine manière, on pourrait dire que les quatre premiers chapitres "
"constituent un long prologue."

#: omake:omake_04EFEC16_E072_4AAB_8F7F_27F92146FDB2
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: d7e776c2e6d44a92d2ea80518aa667eedb7af0dde9e015fe7af28a3c70d1cdf6
#. default-sha256: 0c1632b9db0850aab7465f7fb9a53d0f530bb8c9a96e1032749bc197529109f0
msgctxt "omake:omake_04EFEC16_E072_4AAB_8F7F_27F92146FDB2"
msgid "⟪k:0⟫⟪k:1⟫Aww! What about me?!"
msgstr "⟪k:0⟫⟪k:1⟫Ooh ! Et moi ?!"

#: omake:omake_FAE92C38_A7AE_47BC_988B_8D0A204B48A5
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 2af92a54ac389a1d5ad89862900f1286c73818c9676741f1f94a31eceef9aa67
#. default-sha256: c652ba81391eef7e86f430254b9f0e65d2efc84a7efc9b9f2a3ed4e7d9f9d6ab
msgctxt "omake:omake_FAE92C38_A7AE_47BC_988B_8D0A204B48A5"
msgid ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫Because with you around, he turns into a lovesick, airheaded dope. ⟪k:3⟫He’s about "
"as useful to me as a wet paper sack full of potatoes."
msgstr ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫Avec toi, il se transforme en un amoureux transi, la tête dans les nuages. ⟪k:3⟫Il "
"me sera aussi utile qu’un journal mouillé rempli de pommes de terre."

#: omake:omake_01DFD587_996F_4535_AD66_8069416148E1
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: bcda5eb7a28aaae45aaf5ad7c42475edb9aa8534c5acbc1457f0b363d86ef2c2
#. default-sha256: 28e36adfc5bb16c7ffb07ead1b14057ebaa787a137458e505e239780153cc9ba
msgctxt "omake:omake_01DFD587_996F_4535_AD66_8069416148E1"
msgid "⟪k:0⟫⟪k:1⟫⟪k:2⟫Absolutely not.⟪k:3⟫⟪k:4⟫You spoil him—⟪k:5⟫⟪k:6⟫in more ways than one."
msgstr "⟪k:0⟫⟪k:1⟫⟪k:2⟫Absolument certaine.⟪k:3⟫⟪k:4⟫Tu le gâtes beaucoup trop."

#: omake:omake_00458DC6_24DD_49A1_9A44_7913F792FA41
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 0c67095a664035eeb7add5a0fb18784ba05f461da9ddf1066592fc94655172f3
#. default-sha256: ca4d734d8e5536f4fba88b7811316fc799a3d0f9b4f420673f68f10b6bb524a9
msgctxt "omake:omake_00458DC6_24DD_49A1_9A44_7913F792FA41"
msgid "⟪k:0⟫⟪k:1⟫What are we going to do, though?"
msgstr "⟪k:0⟫⟪k:1⟫Qu’est-ce qu’on va faire ?"

#: omake:omake_0A87396A_6CA3_4EBB_A1DC_2E718908DE9B
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 9238ac2c1fb37bcba3c19fc9102626f71047cfea582fd3c8b636430d78cc84a9
#. default-sha256: 13d227b53178b7035b4a8851505a5988eb7780eeba6544c70d36006172c5b9b6
msgctxt "omake:omake_0A87396A_6CA3_4EBB_A1DC_2E718908DE9B"
msgid ""
"⟪k:0⟫⟪k:1⟫I seem to recall plenty of faffing about in the main game anyway;⟪k:2⟫⟪k:3⟫⟪k:4⟫why "
"don’t we do something we ⟪k:5⟫couldn’t⟪k:6⟫ do there?"
msgstr ""
"⟪k:0⟫⟪k:1⟫Je crois me rappeler qu’on a déjà suffisamment passé notre temps à glander dans le jeu, "
"en plus ;⟪k:2⟫⟪k:3⟫⟪k:4⟫et si on faisait quelque chose qu’on ne pouvait ⟪k:5⟫pas⟪k:6⟫ faire "
"avant ?"

#: omake:omake_3270FD07_2CA5_4EB1_A3EC_A58FAF8F9135
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: ed7c5f2f395efbb9319d895ccd940c836d4f560311a60432e9ae4479236fadf9
#. default-sha256: d855f6e1b16dd40b44fa55478b55a9b54307f3abdb8a3852b0af40f98f6cc808
msgctxt "omake:omake_3270FD07_2CA5_4EB1_A3EC_A58FAF8F9135"
msgid ""
"⟪k:0⟫⟪k:1⟫They’ve got profiles and other miscellaneous notes from the creators about each of the "
"characters. ⟪k:2⟫I thought they might come in handy."
msgstr ""
"⟪k:0⟫⟪k:1⟫Elles contiennent chacune le profil des personnages et d’autres notes diverses que les "
"créateurs ont utilisées pour le jeu. ⟪k:2⟫Je me suis dit qu’elles seraient utiles."

#: omake:omake_D9720B49_BE4B_4233_AD85_F5EE3AB8852A
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: c4cacf2d1956fa2fd826881cd03573b5c66cfe28bdd553c777be001f5b72e2ab
#. default-sha256: 440467e4e13c2bdb158e1d75bacdfb467f8d709277afcdb337ec4a5b32048285
msgctxt "omake:omake_D9720B49_BE4B_4233_AD85_F5EE3AB8852A"
msgid ""
"⟪k:0⟫⟪k:1⟫I can see them being useful, yes...⟪k:2⟫⟪k:3⟫but why exactly do you ⟪k:4⟫have⟪k:5⟫ "
"those?"
msgstr ""
"⟪k:0⟫⟪k:1⟫Je comprends leur utilité, en effet...⟪k:2⟫⟪k:3⟫mais comment se fait-il que tu les "
"aies ?"

#: omake:omake_B908C0B0_A59E_4A40_A466_5B4855F5E803
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 9b44e8e9d1dad4abf1e4fbd2c93ffdc06ae7e5a47cec22b9cff0dd29af108f16
#. default-sha256: 2d6673958c6d8fb24dc9a947dbeef37b058341cc39bce8c922b9e28def27d7d8
msgctxt "omake:omake_B908C0B0_A59E_4A40_A466_5B4855F5E803"
msgid "⟪k:0⟫⟪k:1⟫(I’d rather pretend those miniaturized ⟪k:2⟫things⟪k:3⟫ were not actually us...)"
msgstr "⟪k:0⟫⟪k:1⟫(Je préfère passer sous silence ces ⟪k:2⟫choses⟪k:3⟫ miniaturisées...)"

#: omake:omake_0410FEE1_869D_46D3_9374_1966D808C9F3
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 82702e14a0ccc7018ebb9c0d07852cdde5676a274c23156610fc031e1f55f451
#. default-sha256: 0a95a805b1f3a1095ff8a620f404b57c882ab4b8777242836a5c679ca727c30d
msgctxt "omake:omake_0410FEE1_869D_46D3_9374_1966D808C9F3"
msgid "⟪k:0⟫⟪k:1⟫⟪k:2⟫Hand over the cue cards."
msgstr "⟪k:0⟫⟪k:1⟫⟪k:2⟫Passe-moi les fiches."

#: omake:omake_523CA8EE_C152_D46E_6915_5E57E7AB78F5
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: fba912d29c2d4f1430ef1a00b101bfccdf526a3a39347eb5ad379b81d9856dd9
#. default-sha256: 9c189b2e19bcffb11b0ec06b53a66d1fd194c861cbe98b3aa6883ea70ae18187
msgctxt "omake:omake_523CA8EE_C152_D46E_6915_5E57E7AB78F5"
msgid ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫According to this, two of the creators’ goals for this game were to subvert "
"readers’ expectations and cast new light on old information the farther you progressed through "
"the story."
msgstr ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫Selon cette fiche, deux des créateurs ont pour but avec ce jeu de déjouer les "
"attentes des lecteurs et d’apporter de nouvelles informations qui venaient éclairer les anciennes "
"au fur et à mesure qu’on progressait dans l’histoire."

#: omake:omake_7B6F174A_D4E5_B493_7D56_89C3D06E0122
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 18f2ae7fe4d1bdd9940aed45c2ed008fb2369a4446abcc12c9dab996ca6973e9
#. default-sha256: 52139226fefcb4b746d2258670041e8a580bf830ef750ddecdfdddecfe9aa2aa
msgctxt "omake:omake_7B6F174A_D4E5_B493_7D56_89C3D06E0122"
msgid ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫Even before the focal point of the game—⟪k:3⟫⟪k:4⟫my story—⟪k:5⟫⟪k:6⟫was revealed, "
"there were examples of lines or events taking on new meaning as each of the first three chapters "
"developed."
msgstr ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫Même avant l’apogée du jeu —⟪k:3⟫⟪k:4⟫mon histoire—⟪k:5⟫⟪k:6⟫, on voit des "
"exemples de répliques ou d’événements qui prennent un sens nouveau au fur et à mesure qu’on "
"avance dans les trois chapitres."

#: omake:omake_4043095C_4868_46C9_9D44_88A2E7235295
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 1c7b06caed5259afc6891d4d8d037daa435a2892d3741638aab71b852c8bbfea
#. default-sha256: 4dd1c3974b96ebe4e8d127a4985ba9917431b11748b8d5ab2ab140297266e07b
msgctxt "omake:omake_4043095C_4868_46C9_9D44_88A2E7235295"
msgid ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫The second chapter was pretty crazy too!⟪k:3⟫⟪k:4⟫When we found out about, ⟪k:5⟫"
"uh, ⟪k:6⟫Ukulele, that was it!"
msgstr ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫Le deuxième chapitre était assez dingue, aussi !⟪k:3⟫⟪k:4⟫Quand on a su la vérité "
"au sujet de, ⟪k:5⟫euh, ⟪k:6⟫Ukulélé, voilà !"

#: omake:omake_FB1C8C58_BDE7_4C25_A96D_8C079BBFE140
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 342c58b28e380aa60df9537a8bb5525e885fa1f90615927d04c1087a611077bf
#. default-sha256: 72dbc64ce50c8cf09f8d1cbf367879f899e69787fac5a9c26a915bda4259c0fc
msgctxt "omake:omake_FB1C8C58_BDE7_4C25_A96D_8C079BBFE140"
msgid ""
"⟪k:0⟫A-⟪k:1⟫Ahaha.⟪k:2⟫⟪k:3⟫Chapter three was something else too.⟪k:4⟫⟪k:5⟫My impression of "
"Jacopo and Maria had completely turned around by the end."
msgstr ""
"⟪k:0⟫A-⟪k:1⟫Ahaha.⟪k:2⟫⟪k:3⟫Le chapitre trois aussi était marquant.⟪k:4⟫⟪k:5⟫Mon avis sur Jacopo "
"et Maria s’était complètement inversé à la fin."

#: omake:omake_54FAF5B0_AB1F_4D4B_8DD6_4EB27BAB9EC3
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 507c76081166259018bf1a7aa924bad601b73899bb09502668b4719ca82699e4
#. default-sha256: 558bbcca08ffc4e78f7246fef52886c479590c5285f85da5fd67b428062cfa8b
msgctxt "omake:omake_54FAF5B0_AB1F_4D4B_8DD6_4EB27BAB9EC3"
msgid "⟪k:0⟫Piles of human garbage, the three of them."
msgstr "⟪k:0⟫De vraies ordures, ces trois-là."

#: omake:omake_4A3B06DA_3318_4B85_897A_EFAC99CB3699
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 4d0405c4627618d43bdcdb05ff946655b6966d24e6d11f65ec573192ef966f66
#. default-sha256: ef2e6e464caf46f0298c7b6c5ada72f4f1c1964f1df0f6c4826f96a1eb746081
msgctxt "omake:omake_4A3B06DA_3318_4B85_897A_EFAC99CB3699"
msgid "⟪k:0⟫⟪k:1⟫..................⟪k:2⟫⟪k:3⟫Wha?"
msgstr "⟪k:0⟫⟪k:1⟫..................⟪k:2⟫⟪k:3⟫Quoi ?"

#: omake:omake_AF459C50_7428_4E06_B52B_E61DDFA1FC42
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: a697162476792967f39c8cbddfc1e6970da57579a48754a789ca07f11c41f8be
#. default-sha256: b03d7f3c2a6afc822b11dbc7b1e4a8ba408148fe7cbb488841bb30a167d419a2
msgctxt "omake:omake_AF459C50_7428_4E06_B52B_E61DDFA1FC42"
msgid ""
"⟪k:0⟫⟪k:1⟫I, ⟪k:2⟫um... ⟪k:3⟫wasn’t expecting something so...⟪k:4⟫⟪k:5⟫flattering to come out of "
"your mouth..."
msgstr ""
"⟪k:0⟫⟪k:1⟫Je, ⟪k:2⟫hum... ⟪k:3⟫ne m’attendais pas à quelque chose d’aussi...⟪k:4⟫⟪k:5⟫flatteur, "
"venant de toi..."

#: omake:omake_015D16D7_B9C9_4D89_A4A6_0559A858ADB1
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: a48fda54d375735b431b054b563c2d575669843ee477753f6c23e9ef48e22455
#. default-sha256: 27b572c13ea623aaaabceeb346c6bf4f04c8b0f9938f1622b9b5e660d12df6d2
msgctxt "omake:omake_015D16D7_B9C9_4D89_A4A6_0559A858ADB1"
msgid "⟪k:0⟫⟪k:1⟫⟪k:2⟫That’s true.⟪k:3⟫⟪k:4⟫Putting a knife to a woman’s neck isn’t very righteous."
msgstr ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫C’est vrai.⟪k:3⟫⟪k:4⟫Mettre un couteau sous la gorge d’une femme n’est pas très "
"vertueux."

#: omake:omake_C5E64966_43BC_4099_8D0D_6DA0BD579942
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
