#: badend2:badend2_3A6FE51F_0E31_4710_817A_7E3EDCC8F603
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 41dbd06f5da148a3c8982ea6eb5f30ed11ba61535409a83cb508bb359cd8ec2a
#. default-sha256: cd7212550a22c170da8c588f4b2845ecd22d040b2c986cc2f6cca536d166e5e4
msgctxt "badend2:badend2_3A6FE51F_0E31_4710_817A_7E3EDCC8F603"
msgid ""
"⟪k:0⟫But the next moment, her voice seized ⟪k:1⟫You⟪k:2⟫him⟪k:3⟫ from behind.⟪k:4⟫⟪k:5⟫⟪k:6⟫"
"You⟪k:7⟫The Departed⟪k:8⟫ turned back, and there stood the Maid,⟪k:9⟫wearing the same smile."
msgstr ""
"⟪k:0⟫Mais l’instant d’après, sa voix ⟪k:1⟫vous arrête⟪k:2⟫l’arrête⟪k:3⟫.⟪k:4⟫⟪k:5⟫⟪k:6⟫Vous vous "
"retournez⟪k:7⟫La Défunte se retourne⟪k:8⟫ et là, ⟪k:9⟫vous voyez⟪k:10⟫elle voit⟪k:11⟫ la Servante "
"juste derrière ⟪k:12⟫vous⟪k:13⟫elle⟪k:14⟫,⟪k:15⟫avec le même sourire figé."

#: badend2:badend2_0D38A2CE_82CE_43BC_B3C8_0FC474C863BD
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 96ccdce09ab7d58f96c7a5d416a22396f94b9d4517fc84ace0771908385dd2ba
