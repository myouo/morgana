msgctxt "badend2:badend2_5AAFDCC9_D8B2_A4C8_7B06_CF901FBEDD88"
msgid "⟪k:0⟫The sweet tone of her voice.⟪k:1⟫⟪k:2⟫Her cold fingers.⟪k:3⟫⟪k:4⟫Her icy smile."
msgstr "⟪k:0⟫Le ton sucré de sa voix.⟪k:1⟫⟪k:2⟫Ses doigts froids.⟪k:3⟫⟪k:4⟫Son sourire polaire."

#: badend2:badend2_60B37471_CF71_4582_AC06_A3A0CD0EBC0D
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: f1d381c7fe2f2781f70ad721b2de2bbce51b698edc182fb90ae02a462a642ae7
