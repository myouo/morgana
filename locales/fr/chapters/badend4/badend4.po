msgctxt "badend4:badend4_DEDD2D2D_E3D0_4446_8DB8_75FE39F1FEEE"
msgid "⟪k:0⟫⟪k:1⟫⟪k:2⟫She slides her slender fingers down my neck, then gently shoves me back."
msgstr "⟪k:0⟫⟪k:1⟫⟪k:2⟫Elle enroule ses doigts fins autour de mon cou et me repousse doucement."

#: badend4:badend4_AEC8519C_D043_4752_AF22_B69A6199D5D6
