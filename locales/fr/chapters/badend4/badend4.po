#: badend4:badend4_D864E876_6908_4DFD_8C59_9960C551FBD0
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 348fbb1b08101c430bdafcbaaeeb8b6403834f942e412c2a302db0c213447e2b
#. default-sha256: 3738561b82f154c8c87d64afa5d1517c9a2f251c6112096f401b5c4fa8f569d5
msgctxt "badend4:badend4_D864E876_6908_4DFD_8C59_9960C551FBD0"
msgid ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫⟪k:4⟫⟪k:5⟫⟪k:6⟫⟪k:7⟫⟪k:8⟫⟪k:9⟫⟪k:10⟫⟪k:11⟫⟪k:12⟫⟪k:13⟫⟪k:14⟫I ⟪k:15⟫"
"wanted⟪k:16⟫ to deny it."
msgstr ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫⟪k:4⟫⟪k:5⟫⟪k:6⟫⟪k:7⟫⟪k:8⟫⟪k:9⟫⟪k:10⟫⟪k:11⟫⟪k:12⟫⟪k:13⟫⟪k:14⟫Je ⟪k:15⟫"
"voulais⟪k:16⟫ le nier."

#: badend4:badend4_43C57723_0AE5_4E6A_91A1_50A7736B839E
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 4f4083656ea56cff5beb62b5322e3d25fe7201ffece8c28d8307529a0a73e533
#. default-sha256: 0eb7f3b8280753173238deb0c1f1a9af9036c9a6b137b5cfe84256ddfcea5692
msgctxt "badend4:badend4_43C57723_0AE5_4E6A_91A1_50A7736B839E"
msgid ""
"⟪k:0⟫She may have forgotten me, but what she felt still remains,⟪k:1⟫as evidenced by her "
"attraction to the White-Haired Girl—⟪k:2⟫⟪k:3⟫⟪k:4⟫who had many physical similarities to me."
msgstr ""
"⟪k:0⟫Elle m’a peut-être oublié, mais ce qu’elle a ressenti est toujours là,⟪k:1⟫comme le montre "
"son attirance pour la Fille aux Cheveux Blancs—⟪k:2⟫⟪k:3⟫⟪k:4⟫qui partage de nombreux traits "
"physiques avec moi."

#: badend4:badend4_9C2EAC76_A8D9_419D_81C0_982690FB038E
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 34c6f139cb261c3fc4cff0370e32509f39ce53de66073d297cda4afeb00b7381
#. default-sha256: d166717d3b26f5a62efabd95ff15f55c35dc09808a90f9fa24d561ca3929290b
msgctxt "badend4:badend4_9C2EAC76_A8D9_419D_81C0_982690FB038E"
msgid "⟪k:0⟫Her feelings are still there. ⟪k:1⟫I sincerely believe that."
msgstr "⟪k:0⟫Ses sentiments sont toujours là. ⟪k:1⟫J’y crois sincèrement."

#: badend4:badend4_851B3478_1274_403C_8DEA_5A643985E0D4
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 3192ff7052653d232e32edcd051408d1029d92cc6b13997e836103ef5193d4f2
#. default-sha256: c7f709192179833b56b0ee64b68444f32957ebf727edb344b65ff135db9d8c4c
msgctxt "badend4:badend4_851B3478_1274_403C_8DEA_5A643985E0D4"
msgid ""
"⟪k:0⟫But her arctic gaze caused me to waver for the briefest moment. ⟪k:1⟫Perhaps I only wanted "
"to deny it for my own selfish reasons."
msgstr ""
"⟪k:0⟫Mais son regard polaire m’a fait vaciller l’espace d’un instant. ⟪k:1⟫Peut-être voulais-je "
"seulement le nier pour mes propres raisons égoïstes."

#: badend4:badend4_2D2BD374_E3CE_430E_A7A5_A76BBE55101A
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: a73df1fba6b9b6a23e6e28cc238cdcfb769941a18e824572d08d5aab88cd8474
#. default-sha256: 21094348b0c8c8818a5ecec30cea916fef07f3d4f1709a4fd1a7e2f3f9b9d500
msgctxt "badend4:badend4_2D2BD374_E3CE_430E_A7A5_A76BBE55101A"
msgid "⟪k:0⟫It was only a few, short seconds,"
msgstr "⟪k:0⟫Cela n’a duré que quelques secondes, brèves,"

#: badend4:badend4_455C04DF_3FC9_44B9_A371_3FCBD45D2299
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 57ea88e0230b1e94c30afccf3967491fe80fcde85810782cb0d71c642412877c
#. default-sha256: f653c896ef00adba77c6d9c56a42907078608f81df80856035cff98d58514fb4
msgctxt "badend4:badend4_455C04DF_3FC9_44B9_A371_3FCBD45D2299"
msgid "⟪k:0⟫but those seconds decided it all."
msgstr "⟪k:0⟫mais ces secondes ont tout décidé."

#: badend4:badend4_E0D52035_C1FD_40D0_9118_D14ECC478C99
