msgid "⟪k:0⟫Down and down..."
msgstr "⟪k:0⟫Je tombe plus bas, toujours plus bas..."

#: badend4:badend4_3BDCA0F2_76D9_4C27_AC71_1CBFDEAF3F22
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: c5c89c6bc55e9b511a4342d08a884f93cb095c98b3ea7097758874b30164ec53
