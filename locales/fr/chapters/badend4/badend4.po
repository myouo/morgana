#: badend4:badend4_016BD7A2_04E1_497B_A66B_E34C427F0DAB
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: ebb9c3f6b31654a18a60d2fba7a1505d90de4855e88b9cc1492fc4da256fdc1c
#. default-sha256: 2b151419825fe329146e5f106838365fc2e097e1fece08c83a4b5a51ac328254
msgctxt "badend4:badend4_016BD7A2_04E1_497B_A66B_E34C427F0DAB"
msgid ""
"⟪k:0⟫Darkness consumes everything.⟪k:1⟫⟪k:2⟫My voice. My hands. My very being.⟪k:3⟫⟪k:4⟫And her "
"gaze."
msgstr ""
"⟪k:0⟫La noirceur dévore tout.⟪k:1⟫⟪k:2⟫Ma voix. Mes mains. Mon être tout entier.⟪k:3⟫⟪k:4⟫Et son "
"regard."

#: badend4:badend4_3EC6C99D_EE3D_43B7_857D_F76FCB16D6F3
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 45206677340eabb3a004c65b2ffedde27288958d90372cdaaad00402127e6f07
