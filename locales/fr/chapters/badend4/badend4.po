msgctxt "badend4:badend4_B165DF92_E53D_47AA_BECF_198964743FFF"
msgid "⟪k:0⟫Sinking into my own darkness."
msgstr "⟪k:0⟫Je plonge dans mes propres ténèbres."

#: badend4:badend4_9E3B30D7_BD5E_48D5_89AA_0E599A990788
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 0c0bd77b95555eb595cf6cf75a032b48e08409e59a20cc462337971c8ffba652
#. default-sha256: da196aff15548ada0b4e41f6c6b65fb592137317d5f4767d76e3570fd24443fd
msgctxt "badend4:badend4_9E3B30D7_BD5E_48D5_89AA_0E599A990788"
msgid ""
"⟪k:0⟫I reach my hand out, but I cannot grasp anything.⟪k:1⟫⟪k:2⟫Her hand—⟪k:3⟫⟪k:4⟫the hand I "
"held for all this time—⟪k:5⟫⟪k:6⟫is so far away."
msgstr ""
"⟪k:0⟫Je tends la main mais n’arrive à rien agripper.⟪k:1⟫⟪k:2⟫Sa main —⟪k:3⟫⟪k:4⟫ la main que "
"j’ai tenue tout ce temps —⟪k:5⟫⟪k:6⟫ est si loin."

#: badend4:badend4_ED24E8C2_97DA_4BC6_A2E8_6FD2942EF79E
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: be6a0d2722163ab8f05fa0328e6c2f31bc41ca85906c4e0c32911d537352cb07
#. default-sha256: 05fd6039273d7063bd9b5d33dacc58c4149e378b431f153e793d0bdb69c99c05
msgctxt "badend4:badend4_ED24E8C2_97DA_4BC6_A2E8_6FD2942EF79E"
msgid ""
"⟪k:0⟫I try to shout, but nothing comes out.⟪k:1⟫⟪k:2⟫I can neither answer her original question..."
msgstr "⟪k:0⟫J’essaie de crier mais rien ne sort.⟪k:1⟫⟪k:2⟫Je ne peux ni répondre à sa question..."

#: badend4:badend4_E4AC1FC8_4D3A_4AC0_A5B4_BCB978B1B26F
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 1898661ec92cd42b2d66f8a7fa132e9a2763ed0c18a431494e20bb1162da4fa6
