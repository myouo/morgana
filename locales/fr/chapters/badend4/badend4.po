msgid "⟪k:0⟫⟪k:1⟫⟪k:2⟫Farewell, Michel."
msgstr "⟪k:0⟫⟪k:1⟫⟪k:2⟫Adieu, Michel."

#: badend4:badend4_DEDD2D2D_E3D0_4446_8DB8_75FE39F1FEEE
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 4a333ff5b1b7997a54559ebd7cb09a59e6208d4f2615cb8b8b69e07eade635ee
