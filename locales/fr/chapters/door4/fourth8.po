#: scenario4:scenario4_9B4D4193_13FE_49FC_892E_D05717C95ED5
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 7ee304289617d321899f6ecdb6782c8f991c96625f0a92f1b32402ee255f2d38
#. default-sha256: e4e232780705e8214e1f26a715acea55fcda02c41079799ccd7773f070d53b42
msgctxt "scenario4:scenario4_9B4D4193_13FE_49FC_892E_D05717C95ED5"
msgid ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫⟪k:4⟫⟪k:5⟫⟪k:6⟫⟪k:7⟫⟪k:8⟫⟪k:9⟫⟪k:10⟫⟪k:11⟫⟪k:12⟫⟪k:13⟫⟪k:14⟫⟪k:15⟫⟪k:16⟫⟪k:17⟫"
"⟪k:18⟫⟪k:19⟫⟪k:20⟫⟪k:21⟫⟪k:22⟫⟪k:23⟫⟪k:24⟫⟪k:25⟫But an unfathomable amount of time has passed,"
"⟪k:26⟫and the two have still yet to reunite."
msgstr ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫⟪k:4⟫⟪k:5⟫⟪k:6⟫⟪k:7⟫⟪k:8⟫⟪k:9⟫⟪k:10⟫⟪k:11⟫⟪k:12⟫⟪k:13⟫⟪k:14⟫⟪k:15⟫⟪k:16⟫⟪k:17⟫"
"⟪k:18⟫⟪k:19⟫⟪k:20⟫⟪k:21⟫⟪k:22⟫⟪k:23⟫⟪k:24⟫⟪k:25⟫Mais une période de temps inconcevable a passé "
"depuis,⟪k:26⟫et les deux ont encore à se réunir."

#: scenario4:scenario4_94BC561E_5672_48E3_9852_2DF7363FDBD5
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: c582295db9c23bce475cf899cbd82147e36574b787a5e0a92b186a487731360f
