#: scenario4:scenario4_7E77A93C_97B6_46DB_90A6_D4C6E3A505A6
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 441026cc2e2c46f998d367bc1a313b28419a2dd3aa678a28f6cbda9bc7a27289
#. default-sha256: 37196ead7b785fbff5f71bcbb0b459c5d66449caaede5fe99a93960ccf0d3403
msgctxt "scenario4:scenario4_7E77A93C_97B6_46DB_90A6_D4C6E3A505A6"
msgid "⟪k:0⟫⟪k:1⟫⟪k:2⟫Hmm?⟪k:3⟫⟪k:4⟫Is someone at the door?"
msgstr "⟪k:0⟫⟪k:1⟫⟪k:2⟫Humm ?⟪k:3⟫⟪k:4⟫Il y a quelqu’un à la porte ?"

#: scenario4:scenario4_C11C86C8_E501_4EDE_B209_83D989A12E52
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 14c087795ed66938d38a6b4d6790318af7a9dfbfae400cbc08bbdf86d6a17071
#. default-sha256: 9babe6e38f78e6c565c97cf1c611734e4d3d90a6216b263b7a1825ef4760f76c
msgctxt "scenario4:scenario4_C11C86C8_E501_4EDE_B209_83D989A12E52"
msgid ""
"⟪k:0⟫The flow of time was hazy within the mansion’s walls. ⟪k:1⟫They had little way of telling "
"whether it was night or day, preventing them from knowing exactly how much time had passed."
msgstr ""
"⟪k:0⟫La notion de temps était floue entre les murs du manoir. ⟪k:1⟫Ils n’avaient quasiment aucun "
"moyen de savoir si c’était le jour ou la nuit, donc cela les empêchait de savoir exactement "
"combien de temps s’était écoulé."

#: scenario4:scenario4_39EB3EAB_7C0F_4D68_B10C_55ED104EAC75
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 67af0e1b72aa7d1aa7efd85a9bce9375375523b4c38471f2afd5721303939c20
#. default-sha256: 0b9599151bc1e4424c1788344a0a84fc86ce44fc857b9772e43e1466d5f752e5
msgctxt "scenario4:scenario4_39EB3EAB_7C0F_4D68_B10C_55ED104EAC75"
msgid ""
"⟪k:0⟫The White-Haired Girl had made a habit of climbing the observation tower every so often to "
"see whether the sun was up, which allowed her to approximate the time of day."
msgstr ""
"⟪k:0⟫La Fille aux Cheveux Blancs avait pris l’habitude de se rendre à la tour d’observation de "
"temps en temps pour voir si le soleil était levé, ce qui lui permettait de connaître "
"approximativement le moment de la journée."

#: scenario4:scenario4_F87761B9_B58B_4448_8629_4751E9B8488E
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 2b340e94a1b61dfcb4e9b8012870aa3cf3ebfbd4295377faf090e1e86440e51e
#. default-sha256: 970b135c1d6f4d4b190d5ff90f8a49b7cf1e662de2a82ee2ff438e7075d8c61a
msgctxt "scenario4:scenario4_F87761B9_B58B_4448_8629_4751E9B8488E"
msgid ""
"⟪k:0⟫Consequently, when she heard the knock on the door, she was not aware just how deep the "
"night was outside—⟪k:1⟫⟪k:2⟫that forest and beast alike lay quietly at rest."
msgstr ""
"⟪k:0⟫Par conséquent, quand elle entendit frapper à la porte, elle ne savait pas que la nuit était "
"bien avancée au-dehors—⟪k:1⟫⟪k:2⟫ que la forêt et les animaux reposaient tous deux paisiblement."

#: scenario4:scenario4_6C9B35A5_F117_40B3_A387_462780EB00E3
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 6950be23ebdb8aed72c5bfb0a79bb733bd0816ea99d05d9fb45737f92684fbdc
#. default-sha256: 5f17322f51dc6df7d8bd2b90c1624d38292a4859143d6bcc243e8c1fb0675c5b
msgctxt "scenario4:scenario4_6C9B35A5_F117_40B3_A387_462780EB00E3"
msgid "⟪k:0⟫(Oh, right, the stores in the cellar ⟪k:1⟫are⟪k:2⟫ almost exhausted...)"
msgstr "⟪k:0⟫(Oh, c’est vrai, les vivres de la cave sont presque épuisés...)"

#: scenario4:scenario4_F662AC6A_109C_4237_B301_A595D078DCE2
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 6e3cd074241894b2610ff05d6352c6689d12e85d839841edec73cd6d0d67adf3
#. default-sha256: d20d9b6f6aa6aa2be4d525c2e3d149b1b5537337a06fa1d3fd1a9ebd7fc3d6e3
msgctxt "scenario4:scenario4_F662AC6A_109C_4237_B301_A595D078DCE2"
msgid "⟪k:0⟫(It must be this month’s delivery.)"
msgstr "⟪k:0⟫(Ce doit être la livraison du mois.)"

#: scenario4:scenario4_2FDFD391_D01D_430A_8FB5_8AD19682A08A
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 9d705870b8c17b2f38a2d5c8e3161ce5ba7686cab88f09fb775ba2c35327b192
#. default-sha256: 42a4ed5ef56c366b6723ab4947b2fc3e6ba7e7b679bc41055c7058282dac7468
msgctxt "scenario4:scenario4_2FDFD391_D01D_430A_8FB5_8AD19682A08A"
msgid ""
"⟪k:0⟫Not thinking it was worth bothering Michel over, she made her way out of her chambers and "
"headed for the entrance."
msgstr ""
"⟪k:0⟫Pensant qu’il n’était pas nécessaire de déranger Michel avec cela, elle sortit de sa chambre "
"et se dirigea vers l’entrée."

#: scenario4:scenario4_A66F8C4E_786F_457E_8E11_6433A05D1710
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 61f28dfb037b19f7d157c3820a4fa6bca32fcc546aeb18eeff792ddc356f43fa
#. default-sha256: 13af1771abfbf3c5ffbbd2895dcb3c95541750cdbef4016a73faa11e6a8b3f93
msgctxt "scenario4:scenario4_A66F8C4E_786F_457E_8E11_6433A05D1710"
msgid "⟪k:0⟫There had only been a single knock,"
msgstr "⟪k:0⟫On n’avait toqué qu’une seule fois,"

#: scenario4:scenario4_BBB7D78A_4C7B_4265_83A7_52CF48469070
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: bfbf6553f1521ba33024023a8702a9eb8c4231eb96dc35e6e438db50f89f1ff5
#. default-sha256: a3b49c2eafb12993e3e9d8800d02c213d8ff029707808cc882d8469ad14d5d16
msgctxt "scenario4:scenario4_BBB7D78A_4C7B_4265_83A7_52CF48469070"
msgid ""
"⟪k:0⟫leading her to conclude that, as before, the servant had simply left the box outside the "
"door."
msgstr ""
"⟪k:0⟫ce qui l’amena à supposer que, comme précédemment, le serviteur avait simplement laissé la "
"boîte devant la porte."

#: scenario4:scenario4_B01D0B15_E1EE_49B9_BD57_10B0CA1C1B60
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: b565743fbed1001ebb2d0f0e78091128d13865b8cff73ae2d3fbd7b9bbcc9de0
#. default-sha256: 83f04c1186eefd688f832750915510c8b00193e01d4eb68ab9f98ec8f8d857f2
msgctxt "scenario4:scenario4_B01D0B15_E1EE_49B9_BD57_10B0CA1C1B60"
msgid "⟪k:0⟫⟪k:1⟫So without a second thought, she opened the door—"
msgstr "⟪k:0⟫⟪k:1⟫Donc, sans y penser plus avant, elle ouvrit la porte—"

#: scenario4:scenario4_FC468F18_DCC6_46B6_AD08_05BC3BCEDF6C
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: f25482fbccd5ff4e39ccb4c0d31106bcb9e1701dc5a5a45867cc29294b5f4514
#. default-sha256: bcba3ae9a48ecbe8e76278c4d795269c7065f262e611503816070f512fc2b6ec
msgctxt "scenario4:scenario4_FC468F18_DCC6_46B6_AD08_05BC3BCEDF6C"
msgid ""
"⟪k:0⟫and there she saw a strange, vagrant man standing in the moonlight. ⟪k:1⟫His clothes were "
"tattered, his bearded face bony and emaciated."
msgstr ""
"⟪k:0⟫et là, elle vit un homme étrange, un vagabond éclairé par la lune. ⟪k:1⟫Ses habits étaient "
"de vraies loques, son visage barbu était osseux et émacié."

#: scenario4:scenario4_8A71D3D9_E307_411B_ABF6_BB00BFBB53DD
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: fcf4381b14bf43fcadf7f2554144f661ea4283b12537cae7f36986d916302db2
#. default-sha256: f0f04c711f011a8a9874adb15a2c6bd6b568ea1a0eb6f41a83310b961977028e
msgctxt "scenario4:scenario4_8A71D3D9_E307_411B_ABF6_BB00BFBB53DD"
msgid "⟪k:0⟫—!"
msgstr "⟪k:0⟫—!"

#: scenario4:scenario4_3595D187_60FD_4829_86D6_7B456706EDD3
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: b7bf8eef98c2f85e7e449837e46599dd46f46f9bccfa4f271d980508a86939b4
#. default-sha256: 49c15a5fce238d88c0d4f71d227f6fc41950d63b468c66dbffefda4d588ea06c
msgctxt "scenario4:scenario4_3595D187_60FD_4829_86D6_7B456706EDD3"
msgid ""
"⟪k:0⟫She gasped, shrinking back several paces. ⟪k:1⟫The heavy door began to swing shut, but the "
"man forced it open,"
msgstr ""
"⟪k:0⟫Elle poussa un cri d’effroi et recula de quelques pas. ⟪k:1⟫La lourde porte commençait à se "
"refermer mais l’homme en força l’ouverture,"

#: scenario4:scenario4_DCDC200C_5930_4228_A84C_5A1555F94B21
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 26466702cc97657efb62e6caccd0259561ff34182850b717b6a25753c58b7c5e
#. default-sha256: 94c30f33afa72f71661153c2adda6fd38d6e07c538e17a0b6da4f9465fac0979
msgctxt "scenario4:scenario4_DCDC200C_5930_4228_A84C_5A1555F94B21"
msgid "⟪k:0⟫glaring down at her with unfocused eyes and mumbling,"
msgstr "⟪k:0⟫la foudroyant du regard de ses yeux vitreux et murmurant :"

#: scenario4:scenario4_0E7B69CA_31B2_4FCD_9779_175E3F94FB67
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 9e362693a56c108447c69913e5593eae3a4e437e16eb661ca0e535b67905f608
#. default-sha256: cfdc0db53c79c8e17923395b1d18c2ced9fd01e1ed053b3e667da5429450000d
msgctxt "scenario4:scenario4_0E7B69CA_31B2_4FCD_9779_175E3F94FB67"
msgid "⟪k:0⟫Are ye the witch that’ll grant people’s wishes?"
msgstr "⟪k:0⟫C’est vous la sorcière qui exauce les souhaits des gens ?"

#: scenario4:scenario4_A34CF1FA_E92C_44D3_B497_C6503B98EBB9
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: c2df5629d249d620ce33f4a95e9a88b44c14849111a8a3ac50a63c5cfa4e0208
#. default-sha256: 92d91675be41c0e970212a844117799c74e13fd75219749b0f078e5928303a04
msgctxt "scenario4:scenario4_A34CF1FA_E92C_44D3_B497_C6503B98EBB9"
msgid ""
"⟪k:0⟫It was in that moment that the White-Haired Girl realized she had been careless. ⟪k:1⟫The "
"man had sought out the mansion because he believed the legend of the witch."
msgstr ""
"⟪k:0⟫⟪k:1⟫À⟪k:2⟫ ce moment-là, la Fille aux Cheveux Blancs se rendit compte qu’elle avait été "
"imprudente. ⟪k:3⟫L’homme était venu au manoir parce qu’il croyait à la légende de la sorcière."

#: scenario4:scenario4_3EA1F26B_E711_4316_A68E_172EC1760EB6
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: ea5620c9d6a08b573e1174891f2c45500be35afa266f9384d1e170f6918c7d3b
#. default-sha256: db27b4c7134b1961485c2cd850cd09b2e623242d73ba5aa55846ecb1ded56917
msgctxt "scenario4:scenario4_3EA1F26B_E711_4316_A68E_172EC1760EB6"
msgid ""
"⟪k:0⟫And he did not seem particularly right of mind, either—⟪k:1⟫⟪k:2⟫perhaps a result of "
"wandering through the forest for several days. Or perhaps it was ⟪k:3⟫because⟪k:4⟫ he was so "
"beaten down that he thought to ask for a witch’s help."
msgstr ""
"⟪k:0⟫Et il ne semblait pas particulièrement sain d’esprit, en plus—⟪k:1⟫⟪k:2⟫ peut-être parce "
"qu’il avait passé des jours à errer dans la forêt. Ou peut-être que c’était justement ⟪k:3⟫parce "
"qu’⟪k:4⟫il était dans cet état qu’il avait pensé à quérir l’aide de la sorcière."

#: scenario4:scenario4_C7257A84_1D3E_4823_A936_F17F36BE0932
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: f4beca4e9afb4adc33d501bd2173725f4b49b97e9ca1de29a0067065da6c6632
#. default-sha256: f6b0ccb7fe9c2325f76e4dbab938598addc7a4645dc7602ce7118bc67172c90b
msgctxt "scenario4:scenario4_C7257A84_1D3E_4823_A936_F17F36BE0932"
msgid "⟪k:0⟫In a word, he seemed mad."
msgstr "⟪k:0⟫En un mot, il avait l’air d’un fou."

#: scenario4:scenario4_88F28DEE_9E99_46D5_872F_3095AA05A27B
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 3a3af15c1b7850d530202c9f849d17a40f24e38a80e11ab2f1c8ab8aa5c44064
#. default-sha256: 87d3c585d3b4b9eeb119cef62c67cea3baa47d3df9259e51a525270d476a0887
msgctxt "scenario4:scenario4_88F28DEE_9E99_46D5_872F_3095AA05A27B"
msgid "⟪k:0⟫N-⟪k:1⟫No...⟪k:2⟫⟪k:3⟫There is no witch here..."
msgstr "⟪k:0⟫N-⟪k:1⟫Non...⟪k:2⟫⟪k:3⟫Il n’y a aucune sorcière ici..."

#: scenario4:scenario4_1BE00853_0238_48B0_BA1C_28E0370C7C4D
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 71c66858630a4e8e60afafd70fc5ce1f22d6e682098f0856e8bbfdeb16c44551
#. default-sha256: bdf51c329d7fa770c48aa08c631584b735dd72ef112eb132eef211a587e2f662
msgctxt "scenario4:scenario4_1BE00853_0238_48B0_BA1C_28E0370C7C4D"
msgid "⟪k:0⟫Sure there is. Don’t ye lie to me...⟪k:1⟫⟪k:2⟫I can ’ear the witch’s voice..."
msgstr "⟪k:0⟫Bien sûr que si. Ne m’mentez pas...⟪k:1⟫⟪k:2⟫J’l’entends, la voix d’la sorcière..."

#: scenario4:scenario4_880EC7AC_1F2B_4DD7_B643_47239262DAF2
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 4196eaa97007d416086a58a20c5302e927ee53d8178dfb9cbf66a445208c5901
#. default-sha256: ac59501b7d414ebf0545c2a87f8e128327ae2a19892173ec272a0c6a6d98a467
msgctxt "scenario4:scenario4_880EC7AC_1F2B_4DD7_B643_47239262DAF2"
msgid "⟪k:0⟫She led me to this ’ouse!"
msgstr "⟪k:0⟫C’est elle qui m’a guidé jusqu’ici !"

#: scenario4:scenario4_75400493_59A8_4243_BB66_2EE779585351
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 6f94688244b4bd0dc191d790379d08ca9ccb41470715700c08ceb13abccc7d2d
#. default-sha256: 8e2a5f23bcf4a684558ffb9b4b48abe2883e173eb7fa28c940fa8c365ff63ceb
msgctxt "scenario4:scenario4_75400493_59A8_4243_BB66_2EE779585351"
msgid "⟪k:0⟫Ngh... ⟪k:1⟫I-⟪k:2⟫I promise you, there isn’t!⟪k:3⟫⟪k:4⟫Now please, be on your way!"
msgstr ""
"⟪k:0⟫Ngh... ⟪k:1⟫Je-⟪k:2⟫Je vous assure, il n’y en a pas !⟪k:3⟫⟪k:4⟫Maintenant, je vous en prie, "
"partez !"

#: scenario4:scenario4_0237B531_A3CD_4C65_886E_E37919AB5260
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 346e306db3f1ea27318663002706c455cfd0f19cc6459e98629e7add98a75d88
#. default-sha256: 0ff624f62b3aa9a1e5520161dabf60bc93825d518a2d1732fcdf3ccc3e64008c
msgctxt "scenario4:scenario4_0237B531_A3CD_4C65_886E_E37919AB5260"
msgid ""
"⟪k:0⟫’Ave ye any idea ’ow long it took to find this place?!⟪k:1⟫⟪k:2⟫’Ow many days I’ve gone "
"without food or water?!⟪k:3⟫⟪k:4⟫And ye’re tellin’ me to get lost?!"
msgstr ""
"⟪k:0⟫V’z’avez la moindre idée du temps qu’y m’a fallu pour trouver c’t’endroit ?!⟪k:1⟫ Du nombre "
"d’jours qu’j’ai passés sans nourriture ni eau ?!⟪k:2⟫ Et vous m’dites qu’j’ai qu’à r’partir ?!"

#: scenario4:scenario4_099B4492_1369_4746_AD8C_8DC846C0252B
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 8faf296066ee9f07f99d261d3064f79cfc92008706f9c3897c992d9841ef745c
#. default-sha256: 638eb06b9b0bf708a0de8f4aa1ae7c6cd9bafa094a63f19014254fb74dabe54c
msgctxt "scenario4:scenario4_099B4492_1369_4746_AD8C_8DC846C0252B"
msgid ""
"⟪k:0⟫I-⟪k:1⟫I don’t know what you want from me...⟪k:2⟫⟪k:3⟫I’m happy to give you a little food, "
"so please!"
msgstr ""
"⟪k:0⟫Je-⟪k:1⟫Je ne sais pas ce que vous voulez de plus...⟪k:2⟫⟪k:3⟫Je peux vous donner un peu de "
"nourriture, si vous voulez !"

#: scenario4:scenario4_1A36B37C_383A_4DC1_8071_2124A926CB5C
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: e5c548c7e518a75ad06baa947a3cf54f15a2037494914428f0a094922c4efd99
#. default-sha256: 48f41697b22461c825c2f67ac00db3078091b23a05c42741f58ec0ffc02c435d
msgctxt "scenario4:scenario4_1A36B37C_383A_4DC1_8071_2124A926CB5C"
msgid "⟪k:0⟫............"
msgstr "⟪k:0⟫............"

#: scenario4:scenario4_243F0BF8_9390_4410_8605_330C9EF078E7
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 07a94c47af619bcbcf3e591ec15f2eca1765299a12e18494e5d3198decc8a807
#. default-sha256: 3343c17cbc4031b948669b084eefc693d47fc25ab52ed5dd7010c89d80dd3106
msgctxt "scenario4:scenario4_243F0BF8_9390_4410_8605_330C9EF078E7"
msgid "⟪k:0⟫Is there really no witch?"
msgstr "⟪k:0⟫C’est vrai, ça, y a pas de sorcière ?"

#: scenario4:scenario4_1C6FABC2_2B88_4E56_9069_06BE40D16A79
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 04cc49a3f061e5e3914a2abc832c18d59a77b3f2f32c1d3b754d1b1ce9736592
#. default-sha256: 95ed7431d0153fd678924d91c96f4a1ea1069e3645db4a19abb0ed7ed365a6b3
msgctxt "scenario4:scenario4_1C6FABC2_2B88_4E56_9069_06BE40D16A79"
msgid ""
"⟪k:0⟫There’s no witch here!⟪k:1⟫⟪k:2⟫It’s nothing but a legend.⟪k:3⟫⟪k:4⟫If she does exist, she "
"doesn’t live here."
msgstr ""
