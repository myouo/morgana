msgctxt "scenario4:scenario4_E1152686_7214_4F5E_82C2_746A5CD16163"
msgid ""
"⟪k:0⟫The crate was fairly hefty; ⟪k:1⟫the slightly built girl had considerable difficulty "
"bringing it into the house."
msgstr ""
"⟪k:0⟫La caisse était assez lourde ; ⟪k:1⟫la jeune fille frêle eut beaucoup de mal à la rapporter "
"dans la demeure."

#: scenario4:scenario4_B209F362_E56D_4702_B665_2D9FEC5833CE
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 0f51762ff18a55ec20496ba6981f4f67e742fce36f5e06709f96866ccaaf0d0a
