msgid "⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫(So bright...)"
msgstr "⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫(C’est lumineux...)"

#: scenario4:scenario4_BBCC5ABA_4508_42BE_9184_261D959B28C3
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: c29f8a0342cec153847bb7ebfad33d2aeae4edcf554ea8d50ccdc6f8178fe395
