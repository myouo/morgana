msgid "⟪k:0⟫What a sweet girl she was.⟪k:1⟫"
msgstr "⟪k:0⟫Comme elle était adorable.⟪k:1⟫"

#: scenario4:scenario4_49AB0168_0BFF_4FA2_8EE8_7FD96A89692B
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 73950c47479c24152db13bbf8826881505a2806b1da5faa12da1eb571ff99af8
