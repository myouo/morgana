#: scenario4:scenario4_D8C730E6_D220_4BD2_B4DB_B03613FE9E14
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 444c87e1ab14740f0ca3c6ff32164e4e72546a987a7e2c2a315f7848220e67c8
#. default-sha256: bcbb30e43dfa1783da11fba27abdf7c6bebc3dc7adb92a3e166a1cb27ce77074
msgctxt "scenario4:scenario4_D8C730E6_D220_4BD2_B4DB_B03613FE9E14"
msgid ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫⟪k:4⟫⟪k:5⟫⟪k:6⟫⟪k:7⟫⟪k:8⟫⟪k:9⟫⟪k:10⟫⟪k:11⟫⟪k:12⟫⟪k:13⟫⟪k:14⟫⟪k:15⟫⟪k:16⟫⟪k:17⟫"
"⟪k:18⟫⟪k:19⟫⟪k:20⟫⟪k:21⟫⟪k:22⟫And that marked the true beginning of their quiet days together in "
"the dark mansion."
msgstr ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫⟪k:4⟫⟪k:5⟫⟪k:6⟫⟪k:7⟫⟪k:8⟫⟪k:9⟫⟪k:10⟫⟪k:11⟫⟪k:12⟫⟪k:13⟫⟪k:14⟫⟪k:15⟫⟪k:16⟫⟪k:17⟫"
"⟪k:18⟫⟪k:19⟫⟪k:20⟫⟪k:21⟫⟪k:22⟫Et ainsi commencèrent leurs jours paisibles, ensemble, dans le "
"sombre manoir."

#: scenario4:scenario4_F085551F_4068_4559_A67F_4A1C65501FE9
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: f15d8176f1785acd29a3ddeced547673c902150d960225774c862c89385a3033
#. default-sha256: c16e716efb96803e09e841a17248b9e655c3aafcb989f1b642478b5aa70ef491
msgctxt "scenario4:scenario4_F085551F_4068_4559_A67F_4A1C65501FE9"
msgid ""
"⟪k:0⟫They acknowledged and accepted each other’s presence, no longer isolating themselves, but "
"actively, regularly conversing."
msgstr ""
"⟪k:0⟫Ils reconnaissaient et acceptaient la présence de l’autre, sans plus s’isoler ; au "
"contraire, ils conversaient activement et régulièrement."

#: scenario4:scenario4_934438FF_AB82_4D4C_96E2_98AD5581A9ED
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 39c7795c7fa9ff64804337b8eb7b3920cb98b96084b49cc52c5e869f5e1782ff
#. default-sha256: bf8900df1f3b6e144673e31e680c7ebd30e93d1e535d0bd7c65d8b27feba3971
msgctxt "scenario4:scenario4_934438FF_AB82_4D4C_96E2_98AD5581A9ED"
msgid ""
"⟪k:0⟫As mundane as it might seem, it was something they had been unable to attain until then."
msgstr ""
"⟪k:0⟫Aussi banal que cela puisse paraître, c’était quelque chose qu’ils avaient été incapables de "
"faire jusqu’à présent."

#: scenario4:scenario4_F1DB41FD_7525_49AD_9B08_BE017AF4B59C
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: c9d5a9a5718db5dfdcf86a860029090e090ab21c7348d78753bca03bd2101738
#. default-sha256: 7bd4012323ba25d29f1e40e05e4c79af1216244d3b9c069c8b0dc09e17cbb5a5
msgctxt "scenario4:scenario4_F1DB41FD_7525_49AD_9B08_BE017AF4B59C"
msgid ""
"⟪k:0⟫Nevertheless, they were still somewhat fumbling around in the dark with one another, drawing "
"closer and pushing away again."
msgstr ""
"⟪k:0⟫Néanmoins, ils continuaient à se chercher dans le noir l’un l’autre, se rapprochant et se "
"repoussant selon les moments."

#: scenario4:scenario4_8FEAAD6E_DEF7_4BF9_983B_A2DB5D1404F0
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: dd328609f6ef7d75216ceac6f7ab1aa522be1cfb3617ca0e08e6d76a807dd0ba
#. default-sha256: a2563927d0f468001e19611f1886203e3409c30bd613927e923aa4bee8b38e56
msgctxt "scenario4:scenario4_8FEAAD6E_DEF7_4BF9_983B_A2DB5D1404F0"
msgid ""
"⟪k:0⟫Michel, in his own ungraceful way, was beginning to open himself up to the things she said,"
msgstr ""
"⟪k:0⟫Michel, malgré son indélicatesse, commençait à s’ouvrir et à être réceptif à ce qu’elle "
"disait,"

#: scenario4:scenario4_26C4B32C_F056_4E69_A1BF_1C2B822B551A
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: fae8099ecb4891e61e4f18f9809785d9b06aed29dd747bfcc725bcd353267f18
#. default-sha256: 8f5b18c4f62bf98c3efda1a01d7c0a9d931449a7be3a7d262e99297ac5310f24
msgctxt "scenario4:scenario4_26C4B32C_F056_4E69_A1BF_1C2B822B551A"
msgid "⟪k:0⟫and the White-Haired Girl was beginning to smile with greater frequency."
msgstr "⟪k:0⟫et la Fille aux Cheveux Blancs souriait plus souvent."

#: scenario4:scenario4_0E8068CF_1E52_4198_89D8_E1C794B849A0
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 2883572183048006caec37f980da1d1301ba628eb2a4179f1bb09716a2ad7be0
#. default-sha256: 2f07cb5c981c630d40374dffe4566151d51d858f40e9d3e9287eccfd44291987
msgctxt "scenario4:scenario4_0E8068CF_1E52_4198_89D8_E1C794B849A0"
msgid "⟪k:0⟫They had taken to dining together, and her wish of learning to read was being granted."
msgstr "⟪k:0⟫Ils dînaient ensemble, et son souhait d’apprendre à lire fut exaucé."

#: scenario4:scenario4_54D32434_00B1_47B9_BD97_C3623016EE94
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 1e55c1e3d6515235e3adc6fdb10f3662f8b390bad674ca2172a385df3349b610
#. default-sha256: 99418d2f15f87606e761feb8dc2c2aa6bbd464c4ab48afd70d4dd6d7b13c7e31
msgctxt "scenario4:scenario4_54D32434_00B1_47B9_BD97_C3623016EE94"
msgid ""
"⟪k:0⟫He taught her in the feeble light of a candle placed upon the table, the two sitting across "
"from one another."
msgstr ""
"⟪k:0⟫Il lui apprit à lire à la faible lueur d’une chandelle placée sur la table, assis face à "
"face."

#: scenario4:scenario4_FD793E1F_F6F9_441C_B905_B179018226C5
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: caec40d440ed42ea18d1433cbb78e27ac53edec89d1997af2165f1a81e4d2265
#. default-sha256: 8b55db9188fc05df4945c713694d435f9e7e02bd9d0c123882efc6b4503baa35
msgctxt "scenario4:scenario4_FD793E1F_F6F9_441C_B905_B179018226C5"
msgid ""
"⟪k:0⟫Though Michel seemed to be well educated, he had not been instructed in the art of teaching, "
"so he found the process quite grueling."
msgstr ""
"⟪k:0⟫Michel avait beau être instruit, on ne lui avait jamais appris à enseigner et le processus "
"lui parut éreintant."

#: scenario4:scenario4_397AB7EF_2D6D_4E70_AFC4_AA1C02627DB5
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: e2313d05457b195aa17a7583bbd85f38b03c4578359e110e8801c49d2ed3c597
#. default-sha256: e0deaa247649340fda3ea8ccfda636f1d5f8b6c91fdc066acbab2185dd4e489c
msgctxt "scenario4:scenario4_397AB7EF_2D6D_4E70_AFC4_AA1C02627DB5"
msgid ""
"⟪k:0⟫But to the White-Haired Girl, the longer it took the better;⟪k:1⟫⟪k:2⟫her primary objective "
"was, after all, to spend time with him."
msgstr ""
"⟪k:0⟫Mais la Fille aux Cheveux Blancs préférait les séances qui s’étiraient en longueur ; ⟪k:1⟫"
"son premier objectif, après tout, était de passer du temps avec lui."

#: scenario4:scenario4_169BCDD3_EA39_4040_91FA_8DEA88A1E072
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: ad4b13971dd1e937ff5518d015e4876e3ca8a8e9163f3b2adc02076eb6c68480
#. default-sha256: 15b726a0867d969898a365cd7dbde7b48944bf1824ed527e77ebd0cfeb70cd74
msgctxt "scenario4:scenario4_169BCDD3_EA39_4040_91FA_8DEA88A1E072"
msgid "⟪k:0⟫The days passed,"
msgstr "⟪k:0⟫Les jours s’écoulèrent,"

#: scenario4:scenario4_864C6DC9_F3F0_4202_9C3D_51E1AA4616BD
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: d9fb36f38427aad573e9155ed42aa32bdbac3f05ec3293d3f15ead753f8795bd
#. default-sha256: 3c2ded71844d306f867847cb22b55175cc97b4b810dd637e482b582dde80c4ae
msgctxt "scenario4:scenario4_864C6DC9_F3F0_4202_9C3D_51E1AA4616BD"
msgid ""
"⟪k:0⟫and eventually, she reached the point where her comprehension was adequate enough without "
"assistance. ⟪k:1⟫Her next request, then, was for them to read through a book together."
msgstr ""
"⟪k:0⟫et, au bout d’un moment, elle finit par réussir à comprendre seule, sans plus avoir besoin "
"d’aide extérieure. ⟪k:1⟫Son souhait suivant fut alors de lire un livre à deux."

#: scenario4:scenario4_BA67D6B6_3E00_47E2_B154_E49365D0681C
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: c630b5320e458e47a2236545b152cc387ac34f6d58904542b740f42a1939a9ed
#. default-sha256: 941d50f3c867ec43fc04cf32e1f6a82c7eec6f8f06fb0299b89137c79dbfb21e
msgctxt "scenario4:scenario4_BA67D6B6_3E00_47E2_B154_E49365D0681C"
msgid "⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫⟪k:4⟫Have you read every book in the library?"
msgstr "⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫⟪k:4⟫Avez-vous lu tous les livres de la bibliothèque ?"

#: scenario4:scenario4_7DAB50FB_8948_45A9_923F_F1699154B38F
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 99630c7de2a207ef550c5373b0b2ef88c51321843ebd4b0262af6a4dc821a6e4
#. default-sha256: 8ebc9edea4250e784eacd442405f1b6df8d429a439d8f21699a21ecfb73171bf
msgctxt "scenario4:scenario4_7DAB50FB_8948_45A9_923F_F1699154B38F"
msgid "⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫⟪k:4⟫No... ⟪k:5⟫I stopped looking at them after a while."
msgstr "⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫⟪k:4⟫Non... ⟪k:5⟫j’ai arrêté de les lire au bout d’un moment."

#: scenario4:scenario4_07BD7C42_2024_42BF_A7AC_3D6680ADB294
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 6e7b8c6054fbbc42e267002d88a9d86ba4d4b9cff67255664fd1b4c112cb6f06
#. default-sha256: 73dc52f20071d626db53da6b304614feb40be1337078ce494b5f12d4cc596629
msgctxt "scenario4:scenario4_07BD7C42_2024_42BF_A7AC_3D6680ADB294"
msgid ""
"⟪k:0⟫⟪k:1⟫Most everything I’m sent is dull, uninformative dreck.⟪k:2⟫⟪k:3⟫The diary of a lord... "
"⟪k:4⟫Foolish make-believe tales..."
msgstr ""
"⟪k:0⟫⟪k:1⟫Presque tout ce qu’on m’envoie, ce ne sont en réalité que des banalités sans aucun "
"intérêt et d’un ennui...⟪k:2⟫ Le journal d’un seigneur... ⟪k:3⟫Des contes fantaisistes stupides..."

#: scenario4:scenario4_8D35450D_B142_480E_A9F5_804E8D21EB2F
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 394624e2a4a4acb90da554fef5c10802c5842bcdf003b1b47e7a28085252d10a
#. default-sha256: 3cc288be25683783e0024b644e9c4568fd4fe1537b730c06041c297d79123500
msgctxt "scenario4:scenario4_8D35450D_B142_480E_A9F5_804E8D21EB2F"
msgid "⟪k:0⟫You’re not fond of fiction, I take it?"
msgstr "⟪k:0⟫Vous n’appréciez pas trop la fiction, si je comprends bien ?"

#: scenario4:scenario4_AE1BC5CF_BE0C_42C0_8420_E000E3D78D5F
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: efb8841dbd85666012849133beb56a5061889e19aefc042701417de7a51c5678
#. default-sha256: adc95da23c8e9f7fbc22f26da6762e8aafa98eb6497d36e6e2d2ce0a4248e8f1
msgctxt "scenario4:scenario4_AE1BC5CF_BE0C_42C0_8420_E000E3D78D5F"
msgid "⟪k:0⟫What value is there in the lies and fantasies of another?"
msgstr "⟪k:0⟫Quel intérêt y a-t-il à lire les mensonges et les affabulations des autres ?"

#: scenario4:scenario4_5D9DCB1D_9C9E_4905_8D6B_3C0E3265D28F
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: abcf616af04c3e3908d7a67bd92714feb76f9075538bb65747c72b68bd63f9fd
#. default-sha256: 5b436c21e774427f6e52d2ee3c8f65986c463770de2fe53a4bb0eb7b3077baef
msgctxt "scenario4:scenario4_5D9DCB1D_9C9E_4905_8D6B_3C0E3265D28F"
msgid ""
"⟪k:0⟫Stories... ⟪k:1⟫can be invigorating.⟪k:2⟫⟪k:3⟫Tales of adventure can take you places you "
"could never go."
msgstr ""
"⟪k:0⟫Les histoires... ⟪k:1⟫peuvent être revigorantes.⟪k:2⟫⟪k:3⟫Des romans d’aventure peuvent nous "
"emmener à des endroits où on ne pourrait jamais aller."

#: scenario4:scenario4_79A4C059_3588_4A67_84DB_1DAE20CFEF5B
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: c40f31843324e5e31560682ab6e1ba36f806631251492d2bdc5c1f0c4bdb05f7
#. default-sha256: 82b18610be422b00e3088be32b656bf9c9bc355d01fef54d0a129b2bd41447a1
msgctxt "scenario4:scenario4_79A4C059_3588_4A67_84DB_1DAE20CFEF5B"
msgid ""
"⟪k:0⟫Legends of heroes, folklore, stories of otherworldly phenomena.⟪k:1⟫⟪k:2⟫They can be "
"terrifying, and they can be exhilarating."
msgstr ""
"⟪k:0⟫Les légendes de héros, le folklore, les histoires de phénomènes surnaturels.⟪k:1⟫ C’est "
"parfois terrifiant, parfois excitant."

#: scenario4:scenario4_E64A5DAE_C4BE_41D7_96DE_D6DB8B7054E0
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: fba414e526511298856efad6cb75028e9fc06c11e3f0e3dade4fbc6a3860c321
#. default-sha256: ea1fed8516a7af15219ed9c64d7e9ed79b38f53cfb3ac69bde63fc5de97e8506
msgctxt "scenario4:scenario4_E64A5DAE_C4BE_41D7_96DE_D6DB8B7054E0"
msgid ""
"⟪k:0⟫They may not be real, but they give you a little glimpse into the author’s heart—⟪k:1⟫⟪k:2⟫"
"let you feel like you’re seeing the same thing they saw."
msgstr ""
"⟪k:0⟫Ces histoires ne sont peut-être pas vraies mais elles nous donnent un petit aperçu de ce qui "
"se terre dans le cœur de l’auteur—⟪k:1⟫⟪k:2⟫ elles nous font ressentir les mêmes choses que lui."

#: scenario4:scenario4_0558A8F4_B267_478E_88CC_3059E51F9061
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 4fe84367e8606dab7f858a05868ffbdadd26bf1e24e0fabed963077174ff7f4f
#. default-sha256: 27ec22e961247d2a0530f818c10d128558aa7f806a4daf93494396591f187704
msgctxt "scenario4:scenario4_0558A8F4_B267_478E_88CC_3059E51F9061"
msgid "⟪k:0⟫...You are a very empathetic girl.⟪k:1⟫⟪k:2⟫Fiction inspires nothing of the sort in me."
msgstr ""
"⟪k:0⟫...Vous êtes une jeune fille pleine d’empathie.⟪k:1⟫⟪k:2⟫La fiction ne m’inspire rien de tel."

#: scenario4:scenario4_8F0A27F9_A8FB_4812_A0BB_03F19731376B
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 20b57b4b8d28375e7f1a0fc5f71eb53cbe2c97de42c635ac603ee9f7bacb2596
#. default-sha256: 6c164bf3f9c613023d173af5be2f86f1134a9e8a5f01cae13cac4a9a7106653b
msgctxt "scenario4:scenario4_8F0A27F9_A8FB_4812_A0BB_03F19731376B"
msgid "⟪k:0⟫However..."
msgstr "⟪k:0⟫Pourtant..."

#: scenario4:scenario4_1EB8D266_8768_4E89_94AE_0D39579A75FE
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 5690e73b8c8b448b702b13ac928ed48a1881bdf78f40e765ef9cc497e889cd61
#. default-sha256: 246d574dc691bc84929b488fd05f4439f40e261ff1da52ce090908fe9d2df18c
msgctxt "scenario4:scenario4_1EB8D266_8768_4E89_94AE_0D39579A75FE"
msgid "⟪k:0⟫...?"
msgstr "⟪k:0⟫...?"

#: scenario4:scenario4_F934972B_8D87_4A6F_9D42_88AA60C16AD6
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 2991676dd7bb495d02553801ea1f7e946d3ec6c0acf294f3810196e767b96b83
#. default-sha256: 8c07e87c1f9db8b6471760d9a852a0dedcd8758b77c3c1675b1c1d596676e3ff
msgctxt "scenario4:scenario4_F934972B_8D87_4A6F_9D42_88AA60C16AD6"
msgid ""
"⟪k:0⟫Perhaps long ago... ⟪k:1⟫it may have been able to,⟪k:2⟫though I can no longer remember what "
"it feels like."
msgstr ""
"⟪k:0⟫Il y a longtemps, peut-être... ⟪k:1⟫cela a pu être le cas,⟪k:2⟫mais je ne me souviens plus "
"de ce que l’on ressent."

#: scenario4:scenario4_B35B874F_18F8_4245_9D80_D44806C2377C
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: cdbf51e5862c449aad43b8eaf0c3c767f911f06e10ecc8c015f85c3608681b49
#. default-sha256: 6ece362386021929ffd48ac36a44f9f46ef19806dc244036a55aed63cd145e25
msgctxt "scenario4:scenario4_B35B874F_18F8_4245_9D80_D44806C2377C"
msgid "⟪k:0⟫I’m sure it’ll come back to you."
msgstr "⟪k:0⟫Je suis sûre que ça vous reviendra."

#: scenario4:scenario4_E37506A1_9251_4FE8_8FB8_A62B9DC8A983
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: c09e98d77050485dff0370b08ef00f646c11675e93a6f2a43a36208fe741fb8d
#. default-sha256: f0003d8f318e3e2e756c29d4eac004fd3e7ceddee03fbca122b02915ec21a3f6
msgctxt "scenario4:scenario4_E37506A1_9251_4FE8_8FB8_A62B9DC8A983"
msgid "⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫You’re not an empty man."
msgstr "⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫Vous n’êtes pas un homme vain et vide."

#: scenario4:scenario4_747C91DA_C801_4642_8DDE_EC008C3BCB03
