msgctxt "scenario4:scenario4_49F2455F_56FD_480D_9FBD_536B2CAB6D6E"
msgid "⟪k:0⟫revealing a small room with no windows or doors in sight."
msgstr "⟪k:0⟫révélant une petite pièce sans fenêtre ni porte en vue."

#: scenario4:scenario4_2450C494_16D3_472C_ABAC_4FB3A8B26FAA
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: ec8de5b6150c24fc29c5c0a8de1846a58c6748e3560164c9c0b077cb061fc7f1
