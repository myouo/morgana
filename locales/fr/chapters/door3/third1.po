msgid "⟪k:0⟫⟪k:1⟫...!"
msgstr "⟪k:0⟫⟪k:1⟫...!"

#: scenario3:scenario3_86CA45F2_2704_43C8_BF1E_6CE4A596C4EC
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: c77646b21ab66e2b5e673092c258815a37cbe0dd117ee43543026cf2419327b7
#. default-sha256: b7bfc586ab528751e407f10fef41c5d2ff14d68d511382bca862073657033b27
