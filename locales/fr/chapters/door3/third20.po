msgid ""
"⟪k:0⟫And at some point, he found himself in a position where he was no longer able to speak his "
"mind."
msgstr ""
"⟪k:0⟫Et à un moment donné, il se retrouva dans la position de celui qui n’arrive plus à dire ce "
"qu’il pense."

#: scenario3:scenario3_E2C62720_EB95_4F1A_815E_0940A0F0BF4F
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 1613bec8bae7184fce534f9786d0a0504a6fa14511935f217b1abccd7ac96f4c
