msgid ""
"⟪k:0⟫He was chained down by his place in society,⟪k:1⟫his pride, his relationships, and his own "
"heart."
msgstr ""
"⟪k:0⟫Il était enchaîné par sa place dans la société,⟪k:1⟫sa fierté, ses relations, et son propre "
"cœur."

#: scenario3:scenario3_644F5D01_B83A_4ACF_A18A_A9CC372A078B
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 0a51634572847907961476580e55ef20e38cc9f3e039518e0456455ff709ebe1
