msgctxt "scenario3:scenario3_013A8F6E_378F_4BE7_B040_467ED783B8B4"
msgid "⟪k:0⟫Or perhaps someone like him simply would not,⟪k:1⟫even if they knew how."
msgstr ""
"⟪k:0⟫Ou peut-être que quelqu’un comme lui ne l’était tout simplement pas,⟪k:1⟫même en sachant "
"comment faire."

#: scenario3:scenario3_8827CF43_922A_4FB4_BA34_A1243995CC33
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 61f0edd20e2e58fcc712ab72ac06a2dada7577313cd2e032cb5aad6aaf5bae24
