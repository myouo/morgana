msgstr "⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫............"

#: scenario3:scenario3_B9D9C0F1_53A4_45D8_ADF1_A00DF53E7815
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 15eb6f099fa8d5feb36a8fd127888014e22a96ba49c2599a7ade6b40f75b75a3
#. default-sha256: 7c6e3458c3dc76233bd2127784eb57c2b884167010b8a965cfdd691b74032344
msgctxt "scenario3:scenario3_B9D9C0F1_53A4_45D8_ADF1_A00DF53E7815"
msgid "⟪k:0⟫J-⟪k:1⟫Jacopo?"
msgstr "⟪k:0⟫J-⟪k:1⟫Jacopo ?"

#: scenario3:scenario3_458D4615_C573_4AFB_8C6F_895C44935729
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 01fe06e8ad7d28f3e702de07668c275ed8989650c7302b9d82c3e265a7fa3c8b
#. default-sha256: 5c0750b8cd02cce7a90868ae0db4f6538f639f462e7e00df6f98cd1ac134460a
msgctxt "scenario3:scenario3_458D4615_C573_4AFB_8C6F_895C44935729"
msgid ""
"⟪k:0⟫What’s the matter?⟪k:1⟫If you wanted to visit,⟪k:2⟫you could have said something,⟪k:3⟫rather "
"than coming in without knocking..."
msgstr ""
"⟪k:0⟫Qu’y a-t-il ?⟪k:1⟫Si vous vouliez me voir,⟪k:2⟫vous auriez pu me le dire,⟪k:3⟫plutôt que "
"d’entrer sans toquer..."

#: scenario3:scenario3_2CB44302_C7F4_4FBF_8044_6F8447035E76
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 7997ed360b7b34ffdb091dc93916407985713ec44438dc283256b3df80799abe
