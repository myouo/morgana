msgctxt "scenario3:scenario3_2CB44302_C7F4_4FBF_8044_6F8447035E76"
msgid "⟪k:0⟫Is that... ⟪k:1⟫really necessary?"
msgstr "⟪k:0⟫Est-ce... ⟪k:1⟫vraiment nécessaire ?"

#: scenario3:scenario3_5D7311C3_EBB9_4D79_9679_B329368EC393
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 85b137f730dc5a1ead77187eef26268b4e6e0c955ae58bca03b6e38c53f8f96b
