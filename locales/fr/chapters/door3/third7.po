msgctxt "scenario3:scenario3_CDAC70DC_BEF6_456F_97B2_F46E91647DC6"
msgid "⟪k:0⟫⟪k:1⟫Get back inside, now. You too, Maria."
msgstr "⟪k:0⟫⟪k:1⟫Rentrez à l’intérieur, maintenant. Toi aussi, Maria."

