msgstr "⟪k:0⟫⟪k:1⟫⟪k:2⟫Jacopo !⟪k:3⟫"

#: scenario3:scenario3_DB940F70_0A41_4EC9_82D3_2303EA61584C
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: fd27a8dc4baa2865948dc1f527e6d5379c18fc2ab5a4dfd764af46333216119a
#. default-sha256: d3dba806a4c121ed67075df19c091d20e0e6630d381d07786fef36522dd13e96
msgctxt "scenario3:scenario3_DB940F70_0A41_4EC9_82D3_2303EA61584C"
msgid "⟪k:0⟫You’ve gone too far. This isn’t right..."
msgstr "⟪k:0⟫Tu es allé trop loin. Ce n’est pas juste..."

#: scenario3:scenario3_25787A4E_DAFA_4523_8E06_C4EC856FE3DD
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 23f6983dc4651f226bc34252af666b6d583c8b49d7391b699f6f5befd144c4e7
