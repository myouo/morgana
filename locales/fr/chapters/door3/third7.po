msgid "⟪k:0⟫To you, this rose garden was nothing but—"
msgstr "⟪k:0⟫Pour vous, ce jardin de roses n’était rien d’autre que—"

#: scenario3:scenario3_64914167_22B4_43EA_BF92_D7F19BC0D2AA
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: c8c965fde1c993a64b90195898f32c5356655e6922833c9a4abb7145dbab36b7
