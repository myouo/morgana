msgid "⟪k:0⟫⟪k:1⟫............"
msgstr "⟪k:0⟫⟪k:1⟫............"

#: scenario3:scenario3_1546908A_4815_49FB_8144_C6A5F7BDE298
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 78182281afc6dc926a4b5f0049b73ce22bcb99bc5d35fe2cb988348a7fc27548
#. default-sha256: 17dacb13d6a1298725f6e860b19788386e002cd79f1278f7a2c0699aba9828ec
msgctxt "scenario3:scenario3_1546908A_4815_49FB_8144_C6A5F7BDE298"
msgid ""
"⟪k:0⟫⟪k:1⟫Jacopo doesn’t trust you in the ⟪k:2⟫slightest⟪k:3⟫.⟪k:4⟫⟪k:5⟫He goes around calling "
"you a witch.⟪k:6⟫⟪k:7⟫A man-eating devil-woman."
msgstr ""
"⟪k:0⟫⟪k:1⟫Jacopo ne vous fait ⟪k:2⟫absolument pas⟪k:3⟫ confiance.⟪k:4⟫⟪k:5⟫Il dit à tout le monde "
"que vous êtes une sorcière.⟪k:6⟫⟪k:7⟫Une diablesse dévoreuse d’hommes."

#: scenario3:scenario3_3B0F9553_40AB_4C08_9C9A_29FEF480ED2C
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 91667552e09f223e72c2eeebfb8bb56bf3447c75c2dbb6d8679d1995c4c1c4f6
#. default-sha256: 91848ada68072d444f689801d0696bc1b7b2e0d51c5b30740ef3acd5fcbfb7ed
msgctxt "scenario3:scenario3_3B0F9553_40AB_4C08_9C9A_29FEF480ED2C"
msgid "⟪k:0⟫⟪k:1⟫It’s awful.⟪k:2⟫⟪k:3⟫There’s no one as pure and as beautiful as you."
msgstr "⟪k:0⟫⟪k:1⟫C’est affreux.⟪k:2⟫⟪k:3⟫Personne n’est aussi pure et belle que vous."

#: scenario3:scenario3_31FA80D5_12A8_4254_B2D4_55D8CD3D7FC9
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: cab55fe3ae18dcea483ff032408efb3c8237dd0e5cf6012c4cf607ad5119fa2f
#. default-sha256: 1d9d9f86b448ee5fa5a468c9ff19a92d1c1125461f7ac148731b6ba316faaa1a
msgctxt "scenario3:scenario3_31FA80D5_12A8_4254_B2D4_55D8CD3D7FC9"
msgid "⟪k:0⟫⟪k:1⟫He says... ⟪k:2⟫I am a witch?"
msgstr "⟪k:0⟫⟪k:1⟫Il dit... ⟪k:2⟫que je suis une sorcière ?"

#: scenario3:scenario3_2938A9B9_A728_4CA9_8E74_A87E86F07571
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: bad01c9720ae27e7d1f39335fd0c0a3b7aaef7d2779ec5adc95878ac39fc3408
#. default-sha256: ab6f8ab0dfe36d4f9c20d97b752fb5ebe12de8eb1a2a31da282f05b8074d99c6
msgctxt "scenario3:scenario3_2938A9B9_A728_4CA9_8E74_A87E86F07571"
msgid "⟪k:0⟫⟪k:1⟫Listen to me, Madam.⟪k:2⟫⟪k:3⟫He never for a second ⟪k:4⟫actually⟪k:5⟫ loved you."
msgstr ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫É⟪k:3⟫coutez-moi, madame.⟪k:4⟫⟪k:5⟫Il ne vous a jamais, ne serait-ce qu’un "
"instant, ⟪k:6⟫aimée⟪k:7⟫."

#: scenario3:scenario3_7E310359_F5BE_44B4_AE3C_7F377E807B21
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 6a4ffd9bb7f27457514a3129278c27b21ed90e302eeb5ab54504b3c496c0acc7
#. default-sha256: 8472615eed94a5967541cb8621239c58e1a3a6fc3c9bfb6e131b2836035cec56
msgctxt "scenario3:scenario3_7E310359_F5BE_44B4_AE3C_7F377E807B21"
msgid ""
"⟪k:0⟫He just wanted the influence attached to your name.⟪k:1⟫⟪k:2⟫Wanted to mingle with the upper "
"class."
msgstr ""
"⟪k:0⟫Il voulait juste l’influence que lui rapporterait votre nom.⟪k:1⟫⟪k:2⟫Il voulait frayer avec "
"le beau monde."

#: scenario3:scenario3_5997B74F_8DC7_4A29_B3D7_CE1F29A03E03
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 1116bb937a52d0144597f37572870579c3106ef8958be06c2f73c177badc6a63
#. default-sha256: 52a8d7b355e8f2f9a2fee12ad9ecb7a05dcaf01dfbd385b1f7c5519a48f5c9f8
