msgid "⟪k:0⟫He ⟪k:1⟫used⟪k:2⟫ you."
msgstr "⟪k:0⟫Il vous a ⟪k:1⟫utilisée⟪k:2⟫."

#: scenario3:scenario3_4FE46BE7_958C_4C8C_B141_10A50D9C9847
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 24b7e211519d4c8a05c1a062273c62ad35fad106efc3e0b3f4f03e09af6bdc44
#. default-sha256: a11b88312d03e1cca7ad2859f241ed79d83164d4de781798fd1d7b132b91db70
msgctxt "scenario3:scenario3_4FE46BE7_958C_4C8C_B141_10A50D9C9847"
msgid "⟪k:0⟫⟪k:1⟫But last year... ⟪k:2⟫when we went out together..."
msgstr "⟪k:0⟫⟪k:1⟫Mais l’an dernier... ⟪k:2⟫quand on est sorti ensemble..."

#: scenario3:scenario3_3AFE7A7E_D651_4FF5_B9AC_78B8BC3B1DFC
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 483690137be72391c9551d74e823b9c7388119d240d5fe4dd8a81376c8d2aceb
#. default-sha256: dc747ad75b80153dcb53f63b564aee51e9fb85a3077c37c15ffeaad1166d3d4c
msgctxt "scenario3:scenario3_3AFE7A7E_D651_4FF5_B9AC_78B8BC3B1DFC"
msgid ""
"⟪k:0⟫he gave me the phenakis wheel at the photography shop...⟪k:1⟫⟪k:2⟫He had the owner make it "
"especially for me..."
msgstr ""
