msgid "⟪k:0⟫⟪k:1⟫No... ⟪k:2⟫No..."
msgstr "⟪k:0⟫⟪k:1⟫Non... ⟪k:2⟫Non..."

#: scenario3:scenario3_A174DBE2_8F2C_464A_9A01_1E9AEBCE5D74
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 5aadafa6e2b2022cecaf5eecba0a66ad7eaefa709f313b88aa2e43aeb3f88ffe
#. default-sha256: 45135c87f7bccc25d14b1a7bcf8b0cd526d0c1d7bc899fadcd14fec038fb8fc3
msgctxt "scenario3:scenario3_A174DBE2_8F2C_464A_9A01_1E9AEBCE5D74"
msgid ""
"⟪k:0⟫I will get through to him...⟪k:1⟫⟪k:2⟫Everything will go back to normal...⟪k:3⟫⟪k:4⟫I have "
"faith."
msgstr ""
"⟪k:0⟫Je réussirai à l’atteindre...⟪k:1⟫⟪k:2⟫Tout redeviendra comme avant...⟪k:3⟫⟪k:4⟫J’y crois."

#: scenario3:scenario3_434D9104_934D_4D9E_876C_33E647912E0F
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: f9e8d39bf88e15c3fa376fc40455bbeaee3d9322065d143c3d14ae547ee7d128
#. default-sha256: 590721ec70507c567ae7a3b392f148e8467a512422f0a7654e6476980ea82bfa
msgctxt "scenario3:scenario3_434D9104_934D_4D9E_876C_33E647912E0F"
msgid "⟪k:0⟫All my letters may go up in flames...⟪k:1⟫⟪k:2⟫but my faith will not be lost with them."
msgstr ""
"⟪k:0⟫Toutes mes lettres vont peut-être au feu...⟪k:1⟫⟪k:2⟫mais ma foi, elle, ne sera pas perdue."

#: scenario3:scenario3_B91FF130_107B_4C5D_91A5_56B2E0FC1501
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 53b750f19e24262bfe16399116afe16c7ec5946ed1a6e4dec12a6d402eefdf94
