msgctxt "scenario3:scenario3_B689A9F5_9980_449B_8F17_4B428117F228"
msgid "⟪k:0⟫⟪k:1⟫Is ⟪k:2⟫thaaaat soooo⟪k:3⟫?⟪k:4⟫⟪k:5⟫You sure you’re not just scared?"
msgstr ""
"⟪k:0⟫⟪k:1⟫Ah oui, ⟪k:2⟫vraiiimeeeeent⟪k:3⟫ ?⟪k:4⟫⟪k:5⟫T’es sûr qu’c’est pas simplement de la "
"peur ?"

#: scenario3:scenario3_B13A4431_B46E_40D3_86AC_EB74589A6A1D
