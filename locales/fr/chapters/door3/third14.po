msgid "⟪k:0⟫Has she not taken enough already?!⟪k:1⟫What else could she possibly want from me?!"
msgstr "⟪k:0⟫Elle n’en a pas déjà eu assez ?!⟪k:1⟫Que peut-elle bien vouloir d’autre ?!"

#: scenario3:scenario3_97EBAC32_A89C_4B29_B468_333EE3FE3BB8
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: d5f910db099aef472c3bcc11c2e141f707d911875e39157a0e22155827cd19fd
