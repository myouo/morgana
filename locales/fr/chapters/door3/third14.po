msgid "⟪k:0⟫⟪k:1⟫Jacopo..."
msgstr "⟪k:0⟫⟪k:1⟫Jacopo..."

#: scenario3:scenario3_6EC9BC0C_6BBB_4442_9FEB_25A76E9167B2
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: c536e228f9a5453020e8f1240774163a8814c052da5fe504a72d3700589c9015
