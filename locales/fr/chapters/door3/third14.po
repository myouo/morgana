msgid "⟪k:0⟫And yet still... ⟪k:1⟫she finds other men—!"
msgstr "⟪k:0⟫Et pourtant... ⟪k:1⟫elle continue à voir d’autres hommes —!"

#: scenario3:scenario3_4C875E8F_EAB6_42A4_96A3_49E3618C9C8C
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 097bb54e0fb5432cbc9265a19aa505d11fa6fa86f9f924824df1e309f97d8d9a
