msgid ""
"⟪k:0⟫⟪k:1⟫Out of my way, Maria! I have to talk to her!⟪k:2⟫Ask her what this letter’s about! Who "
"this man is!"
msgstr ""
"⟪k:0⟫⟪k:1⟫Pousse-toi, Maria ! Je dois aller lui parler !⟪k:2⟫Lui demander de quoi parle cette "
"lettre ! Qui est cet homme !"

#: scenario3:scenario3_6B96DA7E_07C1_4CF3_A411_58AB52CF3395
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 62c189d7efd5551eafe3a4d9dcf1de256c9c9de7007bab0e5609178a34531cbf
