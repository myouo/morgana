msgctxt "scenario3:scenario3_97EBAC32_A89C_4B29_B468_333EE3FE3BB8"
msgid "⟪k:0⟫I told her to stay away from my gatherings!⟪k:1⟫I had the rose garden torn down!"
msgstr ""
"⟪k:0⟫Je lui ai dit de ne pas venir à mes réunions !⟪k:1⟫J’ai fait détruire le jardin de roses !"

#: scenario3:scenario3_94B079D8_7624_490E_8E12_1AA61EC4CD7E
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 533bfb39607e3a311a32c054c4a475a3dc32ac14b65df3e093d531a13dd8abed
#. default-sha256: b4de9c116a238a34df547bb892fccaddc0bd9872d3268e45ffb98c0bcf4fde1c
