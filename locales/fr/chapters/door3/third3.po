msgid "⟪k:0⟫⟪k:1⟫Will it really change so drastically?"
msgstr "⟪k:0⟫⟪k:1⟫Cela va vraiment changer aussi drastiquement ?"

#: scenario3:scenario3_4136B471_10CD_4893_A969_986808AAED08
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 56554dd161e648803a75ea3a38c6ef36742ee29e72356f035f4efd0498dfcc96
