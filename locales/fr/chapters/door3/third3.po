msgid "⟪k:0⟫Not drawings, but photographs?"
msgstr "⟪k:0⟫Pas des dessins, mais des photographies ?"

#: scenario3:scenario3_0C761822_45C3_4A2E_8B67_DB0ABEAC218D
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: e7370ea49bd7b0d63ca53a257a0406d0e6e9b91276ff8955712355fcab040924
#. default-sha256: 7be3786c037de6bbc2a46ada6a9e6e0a7b75e137b54a09178de1f79738154106
msgctxt "scenario3:scenario3_0C761822_45C3_4A2E_8B67_DB0ABEAC218D"
msgid ""
"⟪k:0⟫Yes, photos. ⟪k:1⟫By taking hundreds, or perhaps thousands of photographs, it would be "
"possible to reproduce the world as we see it—⟪k:2⟫⟪k:3⟫this room, people walking down the streets."
msgstr ""
"⟪k:0⟫Oui, des photos. ⟪k:1⟫Si on prend cent, ou même mille photographies, il sera peut-être "
"possible de reproduire le monde tel que nous le voyons—⟪k:2⟫⟪k:3⟫ cette pièce, les gens qui "
"marchent dans la rue."

#: scenario3:scenario3_61F941F3_DC33_407C_90A1_157D608FF5BC
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: f611fdd5947a3f110045c6031fe67503064895fda72722e438336823c331c96b
