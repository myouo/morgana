msgstr "⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫⟪k:4⟫⟪k:5⟫⟪k:6⟫⟪k:7⟫............"

#: scenario3:scenario3_A4D825DA_EBE9_49C2_91AB_B085D9CB8EA5
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: bbe5c2ca8e084e141ffb928fed2eab598d8e12a3260282e9d85cb2827ff621ff
#. default-sha256: fa225df799e7b51a083c59554cb06d5016f0d479e5e7931806782f1e16958e17
msgctxt "scenario3:scenario3_A4D825DA_EBE9_49C2_91AB_B085D9CB8EA5"
msgid ""
"⟪k:0⟫Looking down dejectedly at the undrunken tea, the White-Haired Girl walked alone down the "
"corridor."
msgstr ""
"⟪k:0⟫En contemplant d’un air abattu le thé resté intact, la Fille aux Cheveux Blancs marchait "
"seule dans le couloir."

#: scenario3:scenario3_F7BCD182_8814_4357_9D96_A99E95E4FC85
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: afc612efafebbff745b8600631c2a1f750c3b2dfc0b75c9049ebccff7c474e09
#. default-sha256: 20ac5a48ef371ee3708d7d0ae15edfc77fbdfd636c738bc918318434e456ac2e
msgctxt "scenario3:scenario3_F7BCD182_8814_4357_9D96_A99E95E4FC85"
msgid ""
"⟪k:0⟫Though its calming scent filled the air, there was nobody around to have their heart warmed "
"by it."
msgstr ""
"⟪k:0⟫L’odeur apaisante du thé emplissait l’air, mais il n’y avait personne pour en profiter et en "
"être réconforté."

#: scenario3:scenario3_8B9C3D09_7F27_4EB1_A73D_A37B088B6E26
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 601f829710105121fa22542dc2b7c5f2c39cbac4f3b98c80886a2207cb11df8a
#. default-sha256: decf611a30bcb9e1f7d743b1decde4f85474d8ca624c0636515f13245ff6d619
msgctxt "scenario3:scenario3_8B9C3D09_7F27_4EB1_A73D_A37B088B6E26"
msgid "⟪k:0⟫Nor was there anyone to alleviate her loneliness."
msgstr "⟪k:0⟫Et il n’y avait personne non plus pour atténuer sa solitude."

#: scenario3:scenario3_773BF3F5_3E27_413D_B02F_76AAC10204C2
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 6ca33eb79909be69e9614453d039f6905e75f17b5af0908d9c81d28bee140793
#. default-sha256: aea51c00d60cbb69b6fde541ad11affa52008c93ab999010e3c8e3f80cb993cf
msgctxt "scenario3:scenario3_773BF3F5_3E27_413D_B02F_76AAC10204C2"
msgid ""
"⟪k:0⟫Despite being the master’s wife, the maids who crossed her path in the halls said nary a "
"word to her."
msgstr ""
"⟪k:0⟫Elle avait beau être l’épouse du maître de maison, les serviteurs qui la croisaient dans le "
"couloir ne lui adressaient même pas la parole."

#: scenario3:scenario3_B9F11270_C774_4CE1_82C9_98BFE4C943F9
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: a276dd232ac2a42f577922d5aec3fdb827b2884698374b8553ad6b59044cca3d
#. default-sha256: 48f41697b22461c825c2f67ac00db3078091b23a05c42741f58ec0ffc02c435d
msgctxt "scenario3:scenario3_B9F11270_C774_4CE1_82C9_98BFE4C943F9"
msgid "⟪k:0⟫............"
msgstr "⟪k:0⟫............"

#: scenario3:scenario3_D1CC945B_1426_486D_A007_7D0E685D60C7
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 9b312cf9b094348831dd902e22cd6fe9fb07e0ab3a860f29d25299b902da92fa
#. default-sha256: e4ed42b03fe2556fb4a98944d4d4e5711e87dfc8ed1d993c1d7b8307323e5b9e
msgctxt "scenario3:scenario3_D1CC945B_1426_486D_A007_7D0E685D60C7"
msgid "⟪k:0⟫As a matter of fact—"
msgstr "⟪k:0⟫En fait—"

#: scenario3:scenario3_2648BE34_8454_4A6E_A4B9_1544D81DC629
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 8141c365a355afb4b2e67272cd231057f9d1bafda459049d7624cdf1f302ac0a
#. default-sha256: f4136ab13cde43942f4e3b4e470503895bb585d99b0f46a0e4897941e4a12f88
msgctxt "scenario3:scenario3_2648BE34_8454_4A6E_A4B9_1544D81DC629"
msgid "⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫...!"
msgstr "⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫...!"

#: scenario3:scenario3_3FDDECF2_46DB_4622_9B83_A8AD0DCF0D84
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 5b9389e5eb7e4c7fd9d7933d4f4ea5cb9453add69ea58bbcd2812f6c3b26334f
#. default-sha256: 94c1aa62f38d6130422cf8dba77adeb326da58765ff449578fd1c2f20bb06c8f
msgctxt "scenario3:scenario3_3FDDECF2_46DB_4622_9B83_A8AD0DCF0D84"
msgid "⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫⟪k:4⟫⟪k:5⟫⟪k:6⟫⟪k:7⟫Oh dear.⟪k:8⟫I beg your pardon, Madam."
msgstr "⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫⟪k:4⟫⟪k:5⟫⟪k:6⟫⟪k:7⟫Oh ciel.⟪k:8⟫Je vous demande pardon, madame."

#: scenario3:scenario3_B4165425_8A41_45A9_87B1_4540C8B167C8
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 3dfb72fb9a5ea32f588d24bd0d029ddf954e173d1f2019bfc63f0d17c35fb503
#. default-sha256: 3cca9f2979fff0611e012498fd4962db8648ee8e17f64d5f4d2731e51badd6dc
msgctxt "scenario3:scenario3_B4165425_8A41_45A9_87B1_4540C8B167C8"
msgid "⟪k:0⟫Ah... ⟪k:1⟫it’s fine..."
msgstr "⟪k:0⟫Ah... ⟪k:1⟫ce n’est rien..."

#: scenario3:scenario3_9747367B_ECC6_47EA_B0E3_2CB573183AC4
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: b14b9cafac6091fffd090e31c0e2135c68d5b91ba2585e363c6b0f5f342f71b7
#. default-sha256: feaa075a872ea9c261d70f5ba651956e1809987fb1aa65a467f0fb4cc6bb7ff6
msgctxt "scenario3:scenario3_9747367B_ECC6_47EA_B0E3_2CB573183AC4"
msgid "⟪k:0⟫—one even bumped into her, stifling a laugh as she trotted off."
msgstr "⟪k:0⟫—l’une d’entre elles lui fonça même dedans puis s’éloigna en étouffant un rire."

#: scenario3:scenario3_CD736832_7BEC_4174_A5C4_33B2132F2C71
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: f92669a4e2b4d010aaae4ec5ae2f35478a88dad7218a1f36631f64ce3344e829
#. default-sha256: 54fee370f7ce660b738149cebf818f3fdf4d95deda14ebbd469ee9f5291445c3
msgctxt "scenario3:scenario3_CD736832_7BEC_4174_A5C4_33B2132F2C71"
msgid ""
"⟪k:0⟫In all likelihood, she had done it intentionally. ⟪k:1⟫The poor White-Haired Girl, who had "
"fallen to the floor, stared helplessly at the broken cups."
msgstr ""
"⟪k:0⟫Selon toute vraisemblance, elle l’avait fait exprès. ⟪k:1⟫La pauvre Fille aux Cheveux Blancs "
"était tombée par terre et fixait, impuissante, les tasses cassées."

#: scenario3:scenario3_755AD335_1E15_49D6_A108_2117706A1AC7
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 68e0b4b21d48d3942be96d9814134586be750ce034a8beb99a1fa33adf471a15
#. default-sha256: 9c17a121001dca3f2d341422fa8f02b8295049bb73cda1f7999f946e2aa265bf
msgctxt "scenario3:scenario3_755AD335_1E15_49D6_A108_2117706A1AC7"
msgid "⟪k:0⟫The tea she had made for her husband was forming a stain in the carpet."
msgstr "⟪k:0⟫Le thé qu’elle avait fait pour son mari formait une tache sur le tapis."

#: scenario3:scenario3_D9217328_537E_44AE_A7D1_F2142D1419F2
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: dd75601d048782cec41b1b62d6cbc47b88681c5610ea9a3a4ad52f27b3667954
#. default-sha256: 692c09223b33320c385acd62f74cf7027c298a1d5d7db81e433b6f2ee35df689
msgctxt "scenario3:scenario3_D9217328_537E_44AE_A7D1_F2142D1419F2"
msgid "⟪k:0⟫The maids’ behavior toward the mistress of the house was absolutely unacceptable."
msgstr ""
"⟪k:0⟫Le comportement de cette domestique envers la maîtresse de maison était absolument "
"inacceptable."

#: scenario3:scenario3_FCE0642B_DBE2_4935_A25D_FAE1492D1023
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: f6b76247e268b1f85e5b36d66637382d1bd0e9cef388c3ab55d4cc9d7fc77d68
#. default-sha256: 6248027a0e8b7cbdf884508b6d05152188ab40666e1f953cef9a88f090746386
msgctxt "scenario3:scenario3_FCE0642B_DBE2_4935_A25D_FAE1492D1023"
msgid ""
"⟪k:0⟫Nonetheless, it was commonplace—⟪k:1⟫⟪k:2⟫⟪k:3⟫all because of the way Jacopo treated her."
msgstr ""
"⟪k:0⟫Et pourtant, ça arrivait souvent—⟪k:1⟫⟪k:2⟫⟪k:3⟫tout cela à cause de la manière dont Jacopo "
"la traitait."

#: scenario3:scenario3_D68D42FA_CF32_457E_9CB5_30FBC93EEFC8
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 2a4b58e98e1dd38d4bf83a679a92453d165be3fd1dcc1bb4ab195212b489d575
#. default-sha256: b5861e451a4a4be6ea1654e1db685ca13ff2aea5116ec9b2873e7a51598129d7
msgctxt "scenario3:scenario3_D68D42FA_CF32_457E_9CB5_30FBC93EEFC8"
msgid ""
"⟪k:0⟫The more the man of the house acted cruel to her,⟪k:1⟫the less weight her position as his "
"wife held to the servants."
msgstr ""
"⟪k:0⟫Plus l’homme de la maison la malmenait,⟪k:1⟫plus elle perdait son statut de maîtresse de "
"maison aux yeux des serviteurs."

#: scenario3:scenario3_1855FFDE_01E4_46FF_B383_E9128B81C961
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: c0380bdfb6f931bcce4ecd62e77546950c50aee36a4af217a28d3e233d33e53c
#. default-sha256: 1f72290a85cb1e5606285dd8c6674b38e5129a0f144eb5dfb4c708ffa7ae1f74
msgctxt "scenario3:scenario3_1855FFDE_01E4_46FF_B383_E9128B81C961"
msgid ""
"⟪k:0⟫Day in and day out, the maids worked busily—⟪k:1⟫⟪k:2⟫offered little opportunity for leisure—"
"⟪k:3⟫⟪k:4⟫so they would naturally have accumulated quite a bit of stress."
msgstr ""
"⟪k:0⟫Jour après jour, les servantes étaient très occupées —⟪k:1⟫⟪k:2⟫ on ne leur laissait pas le "
"temps de flâner —⟪k:3⟫⟪k:4⟫ donc elles accumulaient naturellement pas mal de stress."

#: scenario3:scenario3_93CD596B_710F_4B6D_A9BE_C45CAFB41920
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 926c8491a619c9eff4d7415bb5ea0e0b185b6355d1a08960a6ba22900809909d
#. default-sha256: 1a04155876c15279b621110a2b3ba0667e4bbe6858a6ff1e085cf5ff4ca23756
msgctxt "scenario3:scenario3_93CD596B_710F_4B6D_A9BE_C45CAFB41920"
msgid "⟪k:0⟫And she became the target for them to let off this steam."
msgstr "⟪k:0⟫Et elle devint une cible pour ceux et celles qui voulaient se défouler."

#: scenario3:scenario3_A6A74DB4_B6EB_4691_8E51_D0B71446E496
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 4667a0d7aeffefd1cbe270995acbda92c15f9ccaac87085bdee82599d4169de9
#. default-sha256: 1cb88f48551653f4e60695868287979f3488fbb929b34d2fbd745e388dd8d5d5
msgctxt "scenario3:scenario3_A6A74DB4_B6EB_4691_8E51_D0B71446E496"
msgid "⟪k:0⟫Not directly, but through a more subdued kind of harassment from the shadows."
msgstr "⟪k:0⟫Ce harcèlement n’était pas direct, mais plus sournois ; il venait de l’ombre."

#: scenario3:scenario3_C90492EF_7D04_424F_9879_017BF694F1CA
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: b737140d297604a3736578eb1e2ad1b6592e500fe8b19f95af750af73128b398
#. default-sha256: d79163d3d4577927afd5512116b444141bbb6bf2797961ee795c71fc488ca0f6
msgctxt "scenario3:scenario3_C90492EF_7D04_424F_9879_017BF694F1CA"
msgid ""
"⟪k:0⟫She must have felt quite miserable. ⟪k:1⟫I imagine she would have been better off as one of "
"the maids."
msgstr ""
"⟪k:0⟫Elle devait se sentir vraiment misérable. ⟪k:1⟫Je pense qu’elle aurait été plus heureuse si "
"elle avait elle-même fait partie des serviteurs."

#: scenario3:scenario3_FB205E25_E6F8_4865_B3E7_3319368D8FCC
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 48ebac8b54dc8dff953849b0924c3c90e4e440db9f4981a01af396e2b3c45ec9
#. default-sha256: 7526aca4d2e14f022546d3cb97987c11169e0ccc7443da256f5b2ce8f3d83274
msgctxt "scenario3:scenario3_FB205E25_E6F8_4865_B3E7_3319368D8FCC"
msgid ""
"⟪k:0⟫On the surface, and in front of others, they showed respect for her as Jacopo’s bride. But "
"behind closed doors, they acted very much the opposite."
msgstr ""
"⟪k:0⟫En apparence, et devant les autres, ils lui témoignaient du respect en tant que femme de "
"Jacopo. Mais dans son dos, ils se comportaient tout autrement."

#: scenario3:scenario3_E95184CC_AC3F_4BCB_A653_912ADADA02DF
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 832fee15ea5c7f1fbb4abc9df4ae8fbf45f19a55074a0d3ed68b612120c4216e
#. default-sha256: 99b1a86423698bda05ff5725112ef945bed1230db4caeecb57f7f487a7d41eb0
msgctxt "scenario3:scenario3_E95184CC_AC3F_4BCB_A653_912ADADA02DF"
msgid ""
"⟪k:0⟫The disparity between the treatment she received around others—⟪k:1⟫⟪k:2⟫the treatment she "
"was ⟪k:3⟫supposed⟪k:4⟫ to receive at all times—⟪k:5⟫⟪k:6⟫and the way she was actually treated "
"made the abuse that much worse."
msgstr ""
"⟪k:0⟫La différence de traitement qu’elle recevait lorsqu’il y avait des gens autour —⟪k:1⟫⟪k:2⟫ "
"ce qu’elle était ⟪k:3⟫censée⟪k:4⟫ recevoir tout le temps —⟪k:5⟫⟪k:6⟫ et la façon dont elle était "
"vraiment traitée lorsqu’elle était seule aggravait la situation."

#: scenario3:scenario3_267EE02A_941F_4448_8B47_CA74E017EE6D
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: f0d62aa387805f77782c80a936013f20df0fafca847ef51cf7f188edc0300c8b
#. default-sha256: 0f398f3b2d292d5251af6fab6777508c92f9feced80a5f53714dc71a899e6ed5
msgctxt "scenario3:scenario3_267EE02A_941F_4448_8B47_CA74E017EE6D"
msgid ""
"⟪k:0⟫And furthermore, as you have seen through the other doors, Master, she was a very reserved "
"young woman."
msgstr ""
"⟪k:0⟫Et en plus, comme vous l’avez vu dans les autres portes, Maître, c’était une jeune femme "
"très réservée."

#: scenario3:scenario3_9BDAD077_9CE6_4C39_8E22_6ABFFEE3ECF1
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 7ea67fddd028680b292b5d8358109cd962d621fa8c8dbe352cf197ea7bf917ea
#. default-sha256: 980c4a6faccf24f97ec34d6155aa6ceab7ca34fb90137e85bb15b67b9bf48aa4
msgctxt "scenario3:scenario3_9BDAD077_9CE6_4C39_8E22_6ABFFEE3ECF1"
msgid "⟪k:0⟫She could neither raise her voice in reprimand nor raise her hand in retaliation."
msgstr "⟪k:0⟫Elle n’arrivait ni à élever la voix en réprimande ni lever la main pour se venger."

#: scenario3:scenario3_2D2FF13F_3EAF_4424_8601_4E4DA6F69371
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 8cf9c2e1b25430fa2cb3e699a1915223bccfd0dae26fa229e8a4c3c03f73396f
#. default-sha256: 983264e5de234eef4fdb76224971b21660231d1bd9dbda81350006ab88e2f2b3
msgctxt "scenario3:scenario3_2D2FF13F_3EAF_4424_8601_4E4DA6F69371"
msgid "⟪k:0⟫I have to get this cleaned up..."
msgstr "⟪k:0⟫Je dois nettoyer cela..."

#: scenario3:scenario3_01A7312C_4E02_430F_B6A7_45F2AA7F94C5
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 38095f87d0c87d17515851576138eb039aa5a61ad61d6b8883726b013ba42eb1
#. default-sha256: 8457ce273f7940e3b4aabd313a217488d4fbc7b111d7633a0aa2021c854eed6a
msgctxt "scenario3:scenario3_01A7312C_4E02_430F_B6A7_45F2AA7F94C5"
msgid "⟪k:0⟫She extended her spindly fingers toward the shards of shattered porcelain."
msgstr "⟪k:0⟫Elle tendit sa frêle main vers les éclats de porcelaine brisée."

#: scenario3:scenario3_6C35B0D2_1AEF_4680_A1A4_3B4661C2E547
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: a268e6038c42c56ef54929c49ec5796cd0df369e70f379e80ceb8da825dc3f05
#. default-sha256: d98b5abbbb0b7d2affda7e8c07b85d3833f3a891790f0897e837ba4c87740319
msgctxt "scenario3:scenario3_6C35B0D2_1AEF_4680_A1A4_3B4661C2E547"
msgid "⟪k:0⟫Ah..."
msgstr "⟪k:0⟫Ah..."

#: scenario3:scenario3_A2E96FCC_0E75_4993_989B_921AAAECD7EF
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 87f03d73dd895139d3033647081b261375529c25246f0c33a6cdb4e43e018cbc
#. default-sha256: dcde7a60ade13ef7243c1ff0dea1a174aad447313854467abcadcba72600b9e1
msgctxt "scenario3:scenario3_A2E96FCC_0E75_4993_989B_921AAAECD7EF"
msgid ""
"⟪k:0⟫But even the broken cup seemed to have no concern to spare for her. Its shattered edge cut "
"her fingertip when she made to pick it up."
msgstr ""
"⟪k:0⟫Mais même la tasse cassée semblait ne pas vouloir l’épargner. Ses bords brisés lui coupèrent "
