#: scenario3:scenario3_07C975E2_D356_4E7B_844A_489E8DC63ADD
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 31f814f2aa4f11fb137bc1f4b3e390b959d3380555419994b152a2517abfbc18
#. default-sha256: cd2cf7c7809a3f299e229c67cfffe3225249435f08591817f290eb5373a5e0ae
msgctxt "scenario3:scenario3_07C975E2_D356_4E7B_844A_489E8DC63ADD"
msgid "⟪k:0⟫Where’s your dad?⟪k:1⟫⟪k:2⟫Or are you here alone?"
msgstr "⟪k:0⟫Où est ton père ?⟪k:1⟫⟪k:2⟫T’es venu tout seul ?"

#: scenario3:scenario3_FB79E208_7D31_47CF_A0DA_ABBDAFA22C4F
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 8c52f2d3a893dccd61c331fd78cd307d8dd2e5a194f7dd4447abfd7ee21d8f4d
#. default-sha256: c0c4222dd97b0f143dcde0ae54a52cdbe5550ad5b130cf24cc20710183667307
msgctxt "scenario3:scenario3_FB79E208_7D31_47CF_A0DA_ABBDAFA22C4F"
msgid "⟪k:0⟫He... ⟪k:1⟫didn’t even tell me..."
msgstr "⟪k:0⟫Il... ⟪k:1⟫ne m’a même pas mis au courant..."

#: scenario3:scenario3_6FE290DD_7AD9_4B2C_A50A_31C5965984F5
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: e9bab3b58774d244690e05cdfdb828a25dc5b812bbb9f38057cb1e7b564fc542
