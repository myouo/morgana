msgid "⟪k:0⟫Well, well, I’ve turned into quite the cynic, huh."
msgstr "⟪k:0⟫Eh bien, voilà que je parle comme une vraie cynique."

#: scenario3:scenario3_A893CCD9_E92A_46B7_8928_A019DE169A8D
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 3a8cc5305a161136729a57dd342d3e2d3d8180e97ae3d7c3727f318f2b600467
