msgid "⟪k:0⟫⟪k:1⟫............"
msgstr "⟪k:0⟫⟪k:1⟫............"

#: scenario3:scenario3_69824517_24CF_4B8E_B072_5694C0E5E948
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 8daf59c89e3030433d6b43670635a5dae171ea64de5de372161dae73f162771a
#. default-sha256: 46cbfd356b0e3dea0aa84312e2d466ab3b4b7a8683b919ed71a937179a79280d
msgctxt "scenario3:scenario3_69824517_24CF_4B8E_B072_5694C0E5E948"
msgid ""
"⟪k:0⟫⟪k:1⟫So a couple days back, I didn’t get enough sleep the previous night, right? ⟪k:2⟫I’m "
"helping out in the kitchen, half-awake, plating up some food,"
msgstr ""
"⟪k:0⟫⟪k:1⟫Donc, y a quelques jours, j’avais pas assez dormi la veille, d’accord ? ⟪k:2⟫J’aidais "
"dans la cuisine, à moitié réveillée, j’ai disposé le repas sur un plateau,"

#: scenario3:scenario3_9E019DB4_7BCC_4D2A_862D_33920693D3EF
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: b229cc7b52f9d972536a5e2bde22b797144175e53fc712ed2e83824d1068d48f
#. default-sha256: 38172379b30710be3e2b10d24f8961fa7c93a9a701fb836681e324de0be4776c
msgctxt "scenario3:scenario3_9E019DB4_7BCC_4D2A_862D_33920693D3EF"
msgid ""
"⟪k:0⟫and when I go to bring it out to the guest, my heart about leaps out of my mouth. Guess why."
msgstr ""
"⟪k:0⟫et quand je suis montée l’amener à l’invité, mon cœur n’a fait qu’un bond. Devinez pourquoi."

#: scenario3:scenario3_46EBE330_AB6F_4F2A_9199_BB4397AA1818
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 660523334630fb77cb50ffb166cb948c67181cedb20ad3efacecef1cb564cbc8
#. default-sha256: 6a595b15e7a0ee2304f4d6302f3cf0112aee50a5d2f0faee22d052ed343b27a0
