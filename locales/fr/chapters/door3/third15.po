msgctxt "scenario3:scenario3_575730D3_EF40_4CB9_A37C_1A2484F91D0B"
msgid ""
"⟪k:0⟫I feel as though I have now, at long last,⟪k:1⟫come to understand just what kind of man "
"Jacopo was."
msgstr ""
"⟪k:0⟫J’ai l’impression qu’à présent, après tout ce temps,⟪k:1⟫j’arrive enfin à comprendre quel "
"genre d’homme était Jacopo."

#: scenario3:scenario3_92DD5E58_656C_41CC_B352_6418C5733715
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 606560e470197ef035efeb7294da13712be79682b1f5dc182a2eb1446217a694
