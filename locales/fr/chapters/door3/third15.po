msgctxt "scenario3:scenario3_BDBF994F_ED58_4460_9E56_8E6B499A8686"
msgid "⟪k:0⟫If we don’t turn our attention outwards, we will wither away and die."
msgstr ""
"⟪k:0⟫Si nous ne dirigeons pas notre attention vers l’extérieur, nous allons dépérir et mourir."

#: scenario3:scenario3_E15B489D_0B69_461A_B199_9684A706F593
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 4b293aca055169908b0c747d9aeaa927fb5ce449dfbc36cc3f95692ace7bd2c9
