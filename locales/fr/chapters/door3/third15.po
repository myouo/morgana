msgctxt "scenario3:scenario3_2BC07195_7C3E_449C_915B_F852039EB9AC"
msgid "⟪k:0⟫But I’m not like that, and neither are you."
msgstr "⟪k:0⟫Mais je ne suis pas comme ça, et toi non plus."

#: scenario3:scenario3_FEEF46E6_EE48_4E2E_983C_56E1D75D3CF3
