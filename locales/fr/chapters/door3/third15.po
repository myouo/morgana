msgctxt "scenario3:scenario3_C89FD3BD_16F4_480C_B61C_4C3EDAFE79EA"
msgid ""
"⟪k:0⟫We need the Bearzatti name climbing the social ladder in short order or we’re going to have "
"everything ripped out from under us."
msgstr ""
"⟪k:0⟫Il faut que le nom des Bearzatti grimpe l’échelle sociale et vite fait ou alors tout va se "
"dérober sous nos pieds."

#: scenario3:scenario3_826F0D3F_4803_453B_ACD8_C19823B199D7
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: ddcd02a68486d18f799487a98976091aa036bd7bbfa6482b145667c03a162168
