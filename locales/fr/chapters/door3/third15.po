msgctxt "scenario3:scenario3_B8D9A232_A82E_4FCB_9E99_4DEDD49A4E39"
msgid "⟪k:0⟫(I could just stop reading them.)"
msgstr "⟪k:0⟫(Je pourrais simplement arrêter de les lire.)"

#: scenario3:scenario3_004E5DF0_9EA6_4EB6_858D_55E1C7416E27
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: cc51c539da526e2abf30487a1bb1b49a20f15078ee82e9263eb5ca864bb92a82
