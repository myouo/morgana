msgid "⟪k:0⟫You must not let ⟪k:1⟫anyone⟪k:2⟫ look down on you."
msgstr "⟪k:0⟫Tu ne dois laisser ⟪k:1⟫personne⟪k:2⟫ te manquer de respect."

#: scenario3:scenario3_505C34D6_32C5_4383_B646_8B5C652DE41C
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 5f39d6fcd4ed6ff21b481a134d38f6379396c7fc7dc24ebb44fe6386f141b5ca
