msgctxt "scenario3:scenario3_1D2BA10E_EF7F_4518_A2BF_1E9D90D2C4FF"
msgid "⟪k:0⟫Not as long as I’m intercepting them..."
msgstr "⟪k:0⟫Pas tant que je les intercepte..."

#: scenario3:scenario3_B1DEBC2E_B042_4EE4_AE87_E0F97F180334
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: d90defd26fb84e1003a696a94feae318a10a504eaca201a10ddba38fe54009b2
#. default-sha256: 50e74c9567ced5e48b47f5db4997f77368bfee526f2d5bddef8396eb3c36f348
msgctxt "scenario3:scenario3_B1DEBC2E_B042_4EE4_AE87_E0F97F180334"
msgid "⟪k:0⟫There’s no way I’m allowing these... ⟪k:1⟫or your love to get to him..."
msgstr "⟪k:0⟫Je n’autoriserai jamais ces lettres... ⟪k:1⟫ou votre amour, à lui parvenir..."

#: scenario3:scenario3_B8D9A232_A82E_4FCB_9E99_4DEDD49A4E39
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: b3a1b12e54598fc739843a32dae489f0e2984106d0419ebea747dc3b61cd15b7
