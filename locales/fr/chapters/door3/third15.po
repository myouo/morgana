msgctxt "scenario3:scenario3_004E5DF0_9EA6_4EB6_858D_55E1C7416E27"
msgid "⟪k:0⟫(It would certainly make things easier.)"
msgstr "⟪k:0⟫(Ça rendrait certainement les choses plus faciles.)"

#: scenario3:scenario3_D910474C_FDD5_41ED_8017_DB92FBDDF606
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: cebc42562038cd373b222ec7a459b569fcad341aafafe2216c0609f80313fb43
#. default-sha256: 0008b06254b21f240094efd6da878b9b3f1b1364c47bae1a20b271eb5725fdb3
msgctxt "scenario3:scenario3_D910474C_FDD5_41ED_8017_DB92FBDDF606"
msgid "⟪k:0⟫(But if I don’t... ⟪k:1⟫my imagination will run wild.)"
msgstr "⟪k:0⟫(Mais si je ne le fais pas... ⟪k:1⟫je vais m’imaginer plein de choses.)"

#: scenario3:scenario3_7243785E_1298_4CA5_9477_3763B0721D9D
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 85ef5742004a3fcb54c93a603c992930d51196098816d4c415db95d971a74555
#. default-sha256: 9f12e44e62605601823f04b78edaa4342bd886d2016051a7a5adda91868d2dac
msgctxt "scenario3:scenario3_7243785E_1298_4CA5_9477_3763B0721D9D"
msgid ""
"⟪k:0⟫(Fantasizing about her writing to this other man... ⟪k:1⟫and what she might be putting in "
"her correspondence...)"
msgstr ""
"⟪k:0⟫(Fantasmer sur ce qu’elle écrirait à l’autre homme... ⟪k:1⟫sur ce qu’elle ajouterait de plus "
"dans leur correspondance...)"

#: scenario3:scenario3_C66B43D4_373A_4993_9436_ABBE96833A62
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: a3f28171b8196d8222c40f945b9d4ac7efc1dfe31867978c228f8921d74c9911
#. default-sha256: b851c3292145cc4e44ddc105fb71299316fa210f3d964efb72c56e5f092bad2a
msgctxt "scenario3:scenario3_C66B43D4_373A_4993_9436_ABBE96833A62"
msgid "⟪k:0⟫(I’d be better off knowing the truth than torturing myself with fantasy.)"
msgstr "⟪k:0⟫(Mieux vaut savoir la vérité que de me torturer avec des chimères.)"

#: scenario3:scenario3_D2D61E49_B00D_4D43_9F8B_12009474F606
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: d950d88ba129c1d0a9e5174c9330897690fb765794754f9e2850cd20fda8190f
#. default-sha256: ec25ea9486134bc2295bcaa5c4f1c16c15100daaa48ec258fd9e143ec9739a9b
msgctxt "scenario3:scenario3_D2D61E49_B00D_4D43_9F8B_12009474F606"
msgid "⟪k:0⟫(It’s... ⟪k:1⟫the better option...)"
msgstr "⟪k:0⟫(C’est... ⟪k:1⟫la meilleure solution...)"

#: scenario3:scenario3_6ACE457C_CCD2_4718_B71F_4C6FAFE59680
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: c4d605490a04083e8d657770f12b5cffa077840d2243a46427718958fc16c7d7
#. default-sha256: 9fe037cb0f3fea173d4ec9cd64a0be77ede63f9c15906555344412268f53f6a0
msgctxt "scenario3:scenario3_6ACE457C_CCD2_4718_B71F_4C6FAFE59680"
msgid "⟪k:0⟫Jacopo accepted every letter Maria delivered, without fail."
msgstr "⟪k:0⟫Jacopo acceptait chaque lettre que Maria lui livrait, sans exception."

#: scenario3:scenario3_7828B9FF_F8E6_4F8F_A06F_0E3CB4F58FF5
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 0f8fa7c682429f98246a2b3dfae84d64fa5d215da2ba2428775943c0e67cc332
#. default-sha256: c1200c15b53c7b00849dfbe33af52d3b77202a6018583c248923eb7ae79fd218
msgctxt "scenario3:scenario3_7828B9FF_F8E6_4F8F_A06F_0E3CB4F58FF5"
msgid ""
"⟪k:0⟫He would merely nod as he accepted it, his face contorted in discomfort, and then pore over "
"the text when he was alone."
msgstr ""
"⟪k:0⟫Il hochait simplement de la tête en les recevant, son visage se contorsionnait dans une "
"grimace de gêne et puis il se plongeait dans le texte quand il était seul."

#: scenario3:scenario3_19CFD068_422C_4A7F_9260_1CE39BFEEB4D
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: eb7a69ccfd1e6df397324a50e98bb10fc631915eeeb8016ff7da55120c683fc5
#. default-sha256: 68c15e6a9dc3c67d62b43ee5bf9a574bc44a84bc6f0921581181aead46e7bb2f
msgctxt "scenario3:scenario3_19CFD068_422C_4A7F_9260_1CE39BFEEB4D"
msgid "⟪k:0⟫I assume he did not want her to see his heart sinking into darkness."
msgstr "⟪k:0⟫Je pense qu’il ne voulait pas qu’elle le voie sombrer dans le désespoir."

#: scenario3:scenario3_D1D1587E_189A_45F6_8DFE_8BD627FBD823
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: f9e0c4238fa247d3d14d59d8445e6658708214cda1c8a2595d290cfa0f33f17f
#. default-sha256: 63ecec62540aa6b4c112cd382db714535510a25fce77709fc97606b349a2478f
msgctxt "scenario3:scenario3_D1D1587E_189A_45F6_8DFE_8BD627FBD823"
msgid "⟪k:0⟫Had he put his trust in his wife rather than Maria..."
msgstr "⟪k:0⟫S’il avait fait confiance à sa femme plutôt qu’à Maria..."

#: scenario3:scenario3_86406C83_4B36_4C3F_8CC6_F48CAD8E8C13
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 4cb15ad51b091b143919c41ac5167c5b5e46428e91b7ec774dc5953ad5faf495
#. default-sha256: b75128332cdac346fcca210134868446195179b5f0976f8c3ff46869afc3aff4
msgctxt "scenario3:scenario3_86406C83_4B36_4C3F_8CC6_F48CAD8E8C13"
msgid ""
"⟪k:0⟫he would have almost certainly been able to realize the letters were directed at him, "
"despite the altered recipient name."
msgstr ""
"⟪k:0⟫...il aurait très certainement pu se rendre compte que les lettres lui étaient adressées, "
"malgré le changement du nom du destinataire."

#: scenario3:scenario3_43B42520_6217_4709_AF6F_354D10551C5A
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 326e256596104cf5671ecfe349465cc080854577276a7bc113a0d7cef267900e
#. default-sha256: 69705b32633a65c8cce93bb167f7efa8b23ff07575e61028b351f0a8fb28c818
msgctxt "scenario3:scenario3_43B42520_6217_4709_AF6F_354D10551C5A"
msgid "⟪k:0⟫Everything she wrote about concerned him, after all."
msgstr "⟪k:0⟫Tout ce qu’elle écrivait le concernait, après tout."

#: scenario3:scenario3_8F118727_77C2_4DE7_80CE_8D1A5127EBD4
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 5f212a1cd39989af08c9e701ee41184e260c91bc6345d2ebc8f82149897e8e76
#. default-sha256: 241c6bf5329b5b0b559ae0dfbf78e4bba4512f4ac3137e59e720c117bf4b4ca2
msgctxt "scenario3:scenario3_8F118727_77C2_4DE7_80CE_8D1A5127EBD4"
msgid ""
"⟪k:0⟫How could someone who had lived as isolated a life as her have so many identical experiences "
"with two distinct men?"
msgstr ""
"⟪k:0⟫Comment quelqu’un qui avait vécu de manière aussi isolée pouvait avoir autant d’expériences "
"identiques avec deux hommes différents ?"

#: scenario3:scenario3_110FC6C1_9CAB_4787_A205_619E20331F8D
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: ee127526374a62bd1554bbba309409302cb4a88a10274a16df8d82d61e0a82d6
#. default-sha256: b49ac2d392b6dd5ddc1fb685e9aa62130e9c192c0a9114700441e24861a65fdf
msgctxt "scenario3:scenario3_110FC6C1_9CAB_4787_A205_619E20331F8D"
msgid ""
"⟪k:0⟫Why could he not find it in himself to trust her?⟪k:1⟫⟪k:2⟫Perhaps doubting her was simply "
"easier."
msgstr ""
"⟪k:0⟫Pourquoi n’arrivait-il pas à lui faire confiance ?⟪k:1⟫⟪k:2⟫Peut-être qu’il était plus "
"simple de douter d’elle."

#: scenario3:scenario3_02F83CA3_4101_40CE_890F_DDC2792CE5D2
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 6c2fd6ccc7e0305ed920f74c78b3086f3629d9d9e73847f07a81a3808870232a
#. default-sha256: ad92679850cf236ea64f155f278c4241371e6b4628e5c93480feafbae02557cb
msgctxt "scenario3:scenario3_02F83CA3_4101_40CE_890F_DDC2792CE5D2"
msgid "⟪k:0⟫If you were in his position... ⟪k:1⟫would you trust her?"
msgstr "⟪k:0⟫Si vous étiez à sa place... ⟪k:1⟫lui feriez-vous confiance ?"

#: scenario3:scenario3_35F58E7B_DAE2_401E_B9CA_4E67094F114F
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: a39880dc9c425131f4458f6262781b6d5ee613a9987186d3f9b1d076197a9561
#. default-sha256: 52fec6a674984bd6778b05a398c37ce70097be8ee376bfcd106a25b796ae495d
msgctxt "scenario3:scenario3_35F58E7B_DAE2_401E_B9CA_4E67094F114F"
msgid ""
"⟪k:0⟫Would you maintain faith in her—⟪k:1⟫⟪k:2⟫the woman who had waited so long?⟪k:3⟫Would you "
"believe the feelings she professed for you were genuine?"
msgstr ""
"⟪k:0⟫Auriez-vous foi en elle—⟪k:1⟫⟪k:2⟫ la femme qui a si longtemps attendu ?⟪k:3⟫Croiriez-vous à "
"la sincérité des sentiments qu’elle professe pour vous ?"

#: scenario3:scenario3_B258CCD9_53ED_4E32_B7B4_41798DF92CF2
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 6cfbba89def238bfbf16bbfe2f678d47ae5768f138cae6cdc5417ac4436a7b03
#. default-sha256: 433933c2a4a74841a731dc724dd6d9a687f97c08a198f3e3aadf4dc350c2f426
msgctxt "scenario3:scenario3_B258CCD9_53ED_4E32_B7B4_41798DF92CF2"
msgid ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫⟪k:4⟫She continued writing letters—⟪k:5⟫⟪k:6⟫day after day, week after week—"
"⟪k:7⟫⟪k:8⟫without hiatus. ⟪k:9⟫She had, by and large, run out of things to say, but that did not "
"put an end to her letter-writing; she simply repeated what she had written before."
msgstr ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫⟪k:4⟫Elle continua à écrire des lettres —⟪k:5⟫⟪k:6⟫ jour après jour, semaine "
"après semaine —⟪k:7⟫⟪k:8⟫ sans s’arrêter. ⟪k:9⟫Elle avait dans l’ensemble épuisé tout ce qu’elle "
"avait à dire, mais cela ne mit pas fin à ses lettres ; elle répétait simplement ce qu’elle avait "
"déjà écrit."

#: scenario3:scenario3_78EE2711_CC0B_4F2D_B567_91BEEAE53482
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 7fa19ae0de81629ee34b823d776a38ccff71170a537d66c0c61617588ee42020
#. default-sha256: aea36b5777bf6b03197a4612d0bd3d4b375ce6e4b440fd391cdf836a796ee7d9
msgctxt "scenario3:scenario3_78EE2711_CC0B_4F2D_B567_91BEEAE53482"
msgid ""
"⟪k:0⟫Nevertheless, they did not see one another in person.⟪k:1⟫⟪k:2⟫The White-Haired Girl, "
"forbidden from leaving her shed,⟪k:3⟫could only wait for her husband to pay her a visit."
msgstr ""
"⟪k:0⟫Malgré tout, ils ne se voyaient pas en personne.⟪k:1⟫⟪k:2⟫La Fille aux Cheveux Blancs avait "
"interdiction de quitter la remise⟪k:3⟫et ne pouvait donc qu’attendre que son mari lui rende "
"visite."

#: scenario3:scenario3_8408EBA5_2745_4E66_9797_E6E12DEE1579
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: cc249bd3a0122858f2ffb0343d8191f223e4017dd6f8cadf450a5ee11f677bad
#. default-sha256: 36d1bb469ef902f7d0652d4b4d435af01e35eb510e01e85ae2952ece505a0105
msgctxt "scenario3:scenario3_8408EBA5_2745_4E66_9797_E6E12DEE1579"
msgid ""
"⟪k:0⟫⟪k:1⟫My beloved,⟪k:2⟫⟪k:3⟫There is a little bit of fog out today.⟪k:4⟫⟪k:5⟫Weather like this "
"reminds me of my home country.⟪k:6⟫"
msgstr ""
"⟪k:0⟫⟪k:1⟫Mon bien-aimé,⟪k:2⟫⟪k:3⟫Il y a un peu de brouillard aujourd’hui.⟪k:4⟫⟪k:5⟫Quand il fait "
"ce temps, cela me rappelle mon pays natal.⟪k:6⟫"

#: scenario3:scenario3_EE588D42_1756_4033_BA03_96194D2307FD
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 3523ae091538fa2f1c1e493d4284aa977746106ad7900c473b5782df6e23e172
#. default-sha256: 2c1d8a9b52b4d31559dd216dd60eabce21539b69c97355f5242327ecfbe148c7
msgctxt "scenario3:scenario3_EE588D42_1756_4033_BA03_96194D2307FD"
msgid ""
"⟪k:0⟫⟪k:1⟫I was born on an island perpetually covered in a thick fog.⟪k:2⟫⟪k:3⟫I’m not saying I "
"would like to return, but thinking about it does make me feel rather homesick. ⟪k:4⟫Does that "
"happen to you?⟪k:5⟫"
msgstr ""
"⟪k:0⟫⟪k:1⟫Je suis née sur une île perpétuellement couverte d’un brouillard épais.⟪k:2⟫⟪k:3⟫Je ne "
"dis pas que je voudrais y retourner, mais le simple fait d’y penser me donne le mal du pays. ⟪k:4⟫"
"Est-ce que cela vous arrive aussi, de temps à autre ?⟪k:5⟫"

#: scenario3:scenario3_D927D0C4_01DE_4490_ADDF_462274F505D8
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: c3c3556f23d6e534af752ce6d23dc76e88cffcf858beeb8cd0a8d7ab012430c6
#. default-sha256: 34bbf3114f25c0482a71fcd03068f9b2c461720d105d9f1cad59075ff62edd32
msgctxt "scenario3:scenario3_D927D0C4_01DE_4490_ADDF_462274F505D8"
msgid ""
"⟪k:0⟫⟪k:1⟫That reminds me—⟪k:2⟫⟪k:3⟫aside from that one time, you have not told me much of your "
"homeland. ⟪k:4⟫It would be nice if we could pay it a visit together sometime.⟪k:5⟫"
msgstr ""
"⟪k:0⟫⟪k:1⟫Cela me fait penser—⟪k:2⟫⟪k:3⟫ hormis une seule fois, vous ne m’avez jamais beaucoup "
"parlé de votre pays d’origine. ⟪k:4⟫Ce serait bien si on pouvait y aller un jour ensemble.⟪k:5⟫"

#: scenario3:scenario3_9A418DE7_22D7_4FF4_B384_F3B33B5554EE
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 96f9f7a78ca3b230562a3fd7efcf22755d463fb8d8e9544a461105246f68ecb5
#. default-sha256: 54ac96d3931164a142ddeae030e0f10cfc28ef200cc27086b4f7a6cd5d6a12f0
msgctxt "scenario3:scenario3_9A418DE7_22D7_4FF4_B384_F3B33B5554EE"
msgid "⟪k:0⟫⟪k:1⟫Speaking of which, before I left, an exhibition of some sort was held there.⟪k:2⟫"
msgstr ""
"⟪k:0⟫⟪k:1⟫En parlant de cela, avant de partir de chez moi, une exposition avait été organisée."
"⟪k:2⟫"

#: scenario3:scenario3_DE47C3A5_A349_4019_A735_6CE1C9FCA621
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 4c0c5a309a2f3f64ee599e41c546870fbd9e4761d03cf93eae7ff7454a4ccdb6
#. default-sha256: 18662c26b0d1d32a2bb411c6748d17e754689f121483d90601200e008d975b38
msgctxt "scenario3:scenario3_DE47C3A5_A349_4019_A735_6CE1C9FCA621"
msgid ""
"⟪k:0⟫⟪k:1⟫I was unable to attend... ⟪k:2⟫but perhaps you had the chance when it was near you?⟪k:3⟫"
msgstr ""
"⟪k:0⟫⟪k:1⟫Je ne pouvais y assister... ⟪k:2⟫mais peut-être avez-vous eu la chance d’être dans le "
"coin ?⟪k:3⟫"

#: scenario3:scenario3_1E215EC3_0314_4F72_BF79_25A39094A182
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: a44723806d642511759b760a486831741edbba5b4a191f90aaf9f2e2a612bf84
#. default-sha256: 849fe00746a6c9cc68692cbf624b159454d6fed1d9496eb6c954e84dba9bf07b
msgctxt "scenario3:scenario3_1E215EC3_0314_4F72_BF79_25A39094A182"
msgid ""
"⟪k:0⟫⟪k:1⟫I imagine you would have, with your interest in new technology.⟪k:2⟫⟪k:3⟫Next time you "
"have a chance, I would enjoy hearing what they had on display.⟪k:4⟫"
msgstr ""
"⟪k:0⟫⟪k:1⟫Je pense que vous avez dû la voir, vu votre intérêt pour les nouvelles technologies."
"⟪k:2⟫ La prochaine fois que vous en avez l’occasion, j’aimerais beaucoup savoir ce qui y était "
"exposé.⟪k:3⟫"

#: scenario3:scenario3_F8F3D491_104A_4468_AEFE_334A97CAECF8
