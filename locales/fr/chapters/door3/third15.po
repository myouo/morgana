msgctxt "scenario3:scenario3_9990F753_29BB_42C7_B5B6_30DF42842E92"
msgid "⟪k:0⟫The thought of it paralyzed him."
msgstr "⟪k:0⟫Cette pensée le paralysait."

#: scenario3:scenario3_AF3D5FD7_689B_4584_97BD_E11E0CA4850E
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: d531b10373b11d9561ceaaa145bbf697f1f94173feb02a769b5e9f3fdfe84b49
