#: scenario2:scenario2_E22FE049_A88F_43A9_8CD7_3982BE88FFB9
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: a4e0bd96cdedb4cc39fa15da6583188f511682dbb220aebbce0e0a438d0f78ee
#. default-sha256: cfb1af3dc5005d3d48dbb019624ebbb59b006959093583d5f85888168b3e29b9
msgctxt "scenario2:scenario2_E22FE049_A88F_43A9_8CD7_3982BE88FFB9"
msgid ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫Her once-porcelain skin was no longer even sickly pale; ⟪k:4⟫it was now the "
"bloodless color of dirt."
msgstr ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫Sa peau autrefois porcelaine n’était même plus maladivement pâle ; ⟪k:4⟫elle "
"avait maintenant la couleur de la boue."

#: scenario2:scenario2_A1EC3F07_1EE7_43DF_A689_6A4096078902
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: ba113d0863659f7c5f60286ee2c4be863f65e575252a2922c57cefbf1c2b324f
#. default-sha256: 7578b4966df6917abe6e5275ae948579f88070411bf7fd5cad51e23d70cdf3a3
msgctxt "scenario2:scenario2_A1EC3F07_1EE7_43DF_A689_6A4096078902"
msgid ""
"⟪k:0⟫She was sprawled haphazardly out on the cellar floor, dried blood stains around her half-"
"open mouth."
msgstr ""
"⟪k:0⟫Le corps de la fille s’étalait, désarticulé, sur le sol de la cave, des taches de sang séché "
"autour de sa bouche à moitié ouverte."

#: scenario2:scenario2_32C72CC7_B3DD_449E_92AE_11F7B5E9653C
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 9e36f702bf1333bffe81612b5e57f209b002ff475b97ef073e15e9cdcd9190de
#. default-sha256: d06533df3c2c595100d716e85ff9267d2714bb4452a16e55fbfb5f3bae14fcd4
msgctxt "scenario2:scenario2_32C72CC7_B3DD_449E_92AE_11F7B5E9653C"
msgid "⟪k:0⟫And those lips were, naturally, lacking their former rosen sheen."
msgstr "⟪k:0⟫Et ces lèvres, bien entendu, n’avaient plus leur éclat rosé d’antan."

#: scenario2:scenario2_80D20F98_39D0_487E_819C_2D75F6AF6F1E
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 06622124c5aff5478425049d09b441991e95bcbb5f625ed8ef2a313307143426
#. default-sha256: f637e9bb1a3b5c87e125f3daa9901fc74e84c26c88256370f6ce42f66ccaad9b
msgctxt "scenario2:scenario2_80D20F98_39D0_487E_819C_2D75F6AF6F1E"
msgid ""
"⟪k:0⟫Her body was covered with an array of wounds, but the most prominent was the man’s singular "
"sword standing tall in her chest."
msgstr ""
"⟪k:0⟫Son corps était couvert d’un tas de blessures mais la plus visible était l’épée de l’homme "
"plantée fièrement dans sa poitrine."

