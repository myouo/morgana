msgid "⟪k:0⟫⟪k:1⟫............"
msgstr "⟪k:0⟫⟪k:1⟫............"

#: scenario2:scenario2_001F0AE2_2F0B_404C_AA1A_D785C93AA9B9
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 89f0bf9cb9453bc68ed393717b8de72d880cacf7f9e03bead6870beae3d278e0
#. default-sha256: 576291561f9911719213e517da28103b4e27b4dbdc5d19924311e3f404d7fc01
msgctxt "scenario2:scenario2_001F0AE2_2F0B_404C_AA1A_D785C93AA9B9"
msgid "⟪k:0⟫⟪k:1⟫Is there anything you would like?"
msgstr "⟪k:0⟫⟪k:1⟫Puis-je faire quelque chose pour vous ?"

#: scenario2:scenario2_A0151887_D25E_4A14_BE0E_3B9B75139582
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 3cf621c40432c8a026db8f72bd7b7af3c8306d5b5a36b2c808b1ae202eb535cd
#. default-sha256: bae4bdf6da02e63e0dd3a2516631e9a8f8f90da4781f3a6b9bfb54f4f3e45ea9
msgctxt "scenario2:scenario2_A0151887_D25E_4A14_BE0E_3B9B75139582"
msgid "⟪k:0⟫⟪k:1⟫Anything... ⟪k:2⟫I would like...?"
msgstr "⟪k:0⟫⟪k:1⟫Quelque chose... ⟪k:2⟫pour moi... ?"

#: scenario2:scenario2_675D2378_B607_43CE_8DAB_78E22BDD345D
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 8bdeb226f9281b96fefce1c9d616b399b2d964bb860d188d06f04b64071f7aec
#. default-sha256: 16c177209b6c92a62077babc3c2cee2a1a66843c90f32004f5662ffeedcad2df
msgctxt "scenario2:scenario2_675D2378_B607_43CE_8DAB_78E22BDD345D"
msgid "⟪k:0⟫⟪k:1⟫I’m considering..."
msgstr "⟪k:0⟫⟪k:1⟫Je songe..."

#: scenario2:scenario2_4C48DE42_33E8_45EB_82F7_FCF9CFA52535
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: c25922057f171c897d1b5fc0520209dfe48b654c21bf746c825731ba59b587d4
#. default-sha256: b68bd01d9e43b986f0ed6cb81b690fde8bc6adb3189fa1ab1ca32f17c1616de8
msgctxt "scenario2:scenario2_4C48DE42_33E8_45EB_82F7_FCF9CFA52535"
msgid "⟪k:0⟫⟪k:1⟫visiting the village."
msgstr "⟪k:0⟫⟪k:1⟫...à me rendre au village."

#: scenario2:scenario2_5AA70BC1_FCF0_46EF_9164_F66F9D0A6DA0
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: faa4fbc203a0c05892b8ac1d5304cd262ab8ca4e0ec99bef330ba3b5934d7343
#. default-sha256: b3d2aa6edb72e7f0d1d19278a231a05cb931b7e6a3e712a0849346121daa09b2
msgctxt "scenario2:scenario2_5AA70BC1_FCF0_46EF_9164_F66F9D0A6DA0"
msgid "⟪k:0⟫⟪k:1⟫I see...⟪k:2⟫⟪k:3⟫You’re going to the village..."
msgstr "⟪k:0⟫⟪k:1⟫Je vois...⟪k:2⟫⟪k:3⟫Vous allez au village..."

#: scenario2:scenario2_0E72AAEA_BFA9_466B_AAC8_843C1EAB28C9
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 457cbfff1e5c58bc8c917a5ea6ce1b04339900f6f17afd07eb3be3593da534ca
#. default-sha256: 098728aca62a08cb38efbbba19464c7a894bf7758c4b6b2168fa1b19073a1c2d
msgctxt "scenario2:scenario2_0E72AAEA_BFA9_466B_AAC8_843C1EAB28C9"
msgid "⟪k:0⟫⟪k:1⟫I thought I might be able to get some medicine."
msgstr "⟪k:0⟫⟪k:1⟫Je pensais mettre la main sur des médicaments."

#: scenario2:scenario2_31BBE612_F46E_46E3_8340_8AC43F461A39
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 2f30b846660c08a04fef56b679717ea3984c15ab41599f1190d3734613a545cb
#. default-sha256: 2f2da1c11e64f3df8ecd4d83b4c6864eb268164f7f46d6ff1094356e12eeb977
msgctxt "scenario2:scenario2_31BBE612_F46E_46E3_8340_8AC43F461A39"
msgid ""
"⟪k:0⟫I would prefer to bring a doctor here...⟪k:1⟫⟪k:2⟫but no one would come if they learned you "
"were in this mansion."
msgstr ""
"⟪k:0⟫Je préférerais amener un médecin...⟪k:1⟫⟪k:2⟫...mais aucun ne voudra venir en apprenant que "
"vous êtes au manoir."

#: scenario2:scenario2_4837F3A8_618A_4A41_8BCA_9F65184841C2
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 3227fee532895b8bf44429520407f178d33a7d3f828f3da1c82c53ffd3f5fdc4
#. default-sha256: 8a9cc52ebf17ceee91e943264f589753682bd893c8a683cb52fe41244c29f008
msgctxt "scenario2:scenario2_4837F3A8_618A_4A41_8BCA_9F65184841C2"
msgid "⟪k:0⟫⟪k:1⟫So..."
msgstr "⟪k:0⟫⟪k:1⟫Donc..."

#: scenario2:scenario2_BF0A6369_E0B3_4637_8924_C2EC4BCA7C2F
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 8eec309626a39ef24c6fd5aef30812598a9ca5358c196833c9f689f0ab1644d7
#. default-sha256: ca8b2ecda7fb61b29ea08651966e641aa23a50f7eceb26d5d7b7d78ba75e95f6
msgctxt "scenario2:scenario2_BF0A6369_E0B3_4637_8924_C2EC4BCA7C2F"
msgid "⟪k:0⟫He was planning to put on a disguise—⟪k:1⟫⟪k:2⟫to enter the village as a person."
msgstr "⟪k:0⟫Il comptait se déguiser—⟪k:1⟫⟪k:2⟫ pour entrer au village en tant qu’humain."

#: scenario2:scenario2_7C2E41D3_243D_485A_BD38_AD1A0ADB69D8
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: da0f77ac88d1bd22bef92b1c9c67bb0d5e6507608dc33625da96d2e7c597a5f9
#. default-sha256: 8c67fa62333bf24a8e97f5f09061e6b8584555ec2faa83f31bba3f8cbfcc75a5
msgctxt "scenario2:scenario2_7C2E41D3_243D_485A_BD38_AD1A0ADB69D8"
msgid "⟪k:0⟫The White-Haired Girl smiled when she heard his idea."
msgstr "⟪k:0⟫La Fille aux Cheveux Blancs sourit en entendant cette idée."

#: scenario2:scenario2_C3594EDB_5862_465C_8F1E_DE54E325F513
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: f131c9c088578174786273331184d9582e17d11635d6206e1ff9ed15c2b08505
#. default-sha256: 6fbaf971a4bf9e80915dd1700a05fa3da394c3f7e0b23c9f9a6a1c63ab9f5034
msgctxt "scenario2:scenario2_C3594EDB_5862_465C_8F1E_DE54E325F513"
msgid "⟪k:0⟫She had, after all, always wanted him to think of himself as human."
msgstr "⟪k:0⟫Elle avait toujours voulu, après tout, qu’il se voie en être humain."

#: scenario2:scenario2_70401842_E177_492C_93E8_5FA5249EBE4C
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 2db10702dc9a34041846bee1eb56e40269cb8d40ec56f21e70ebdea46187cc33
#. default-sha256: a1f6f1cc1c9e5109e4ca3ce558d89725d97aae21386ce89bb447a90556e93ead
msgctxt "scenario2:scenario2_70401842_E177_492C_93E8_5FA5249EBE4C"
msgid "⟪k:0⟫However, because she was so pure-hearted, she did not comprehend..."
msgstr "⟪k:0⟫Cependant, comme son âme était pure, elle ne saisissait pas bien..."

#: scenario2:scenario2_46DD207F_F77B_462E_AE51_E870377CD651
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: b74e9a8db01c535ddbf28e72cf433e06ee803a9ff474df2db9d8296c6c5cc9a5
#. default-sha256: 48d241a48cc80a2816842bf9b19dfde2986c019cf946948ce58b4dbe1e8fe479
msgctxt "scenario2:scenario2_46DD207F_F77B_462E_AE51_E870377CD651"
msgid "⟪k:0⟫the full extent of the slaughter he had confessed to committing."
msgstr "⟪k:0⟫...l’étendue du massacre qu’il avait avoué commettre."

#: scenario2:scenario2_05DDE8BA_3870_4B45_BA3C_233D3FC7144F
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: bb1bb6cbadc3af3e3ec93d17a3e86176ae74c4caa1d26f51ac0654403915ab44
#. default-sha256: ca30c83c95dc9bd87495403a8a21284f4d3147643f7f4d4818f7dd4dd5d3162c
msgctxt "scenario2:scenario2_05DDE8BA_3870_4B45_BA3C_233D3FC7144F"
msgid ""
"⟪k:0⟫The revenge he had taken on those who had chased him around.⟪k:1⟫⟪k:2⟫How sinister his "
"cackling and furious his reaping."
msgstr ""
"⟪k:0⟫La vengeance qu’il avait exercée contre ceux qui l’avaient pourchassé.⟪k:1⟫⟪k:2⟫Comme son "
"rire était sinistre, comme sa récolte d’âmes était furieuse."

#: scenario2:scenario2_571DB84B_714D_4092_9951_39A38108CD82
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 7e94cc8089bb197c750b75a9af41af56b157855d44cba1f05a3702a69276e7af
#. default-sha256: 6519d340d5e543a5b69dc6b781b7e05dd113da464aa6f09b7e689fee95ebd33a
msgctxt "scenario2:scenario2_571DB84B_714D_4092_9951_39A38108CD82"
msgid "⟪k:0⟫She did not grasp just how serious it was."
msgstr "⟪k:0⟫Elle ne saisissait pas la gravité de ses actes."

#: scenario2:scenario2_82CF0A9B_B3E4_43E0_92C6_7F34EB21A356
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
