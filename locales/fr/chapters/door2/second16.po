#: scenario2:scenario2_D22FE458_8A7D_4673_90FE_7646580B8285
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 3fe98f25d16944a8a76010f342b1e8b2ed116d738ee9fdec75f0d26aa28413da
#. default-sha256: c27c399bbffe7f8751a227140400fcc76a908f10b195e2e337c8561078ecac58
msgctxt "scenario2:scenario2_D22FE458_8A7D_4673_90FE_7646580B8285"
msgid "⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫His psyche drifted erratically between human and beast."
msgstr ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫Son âme dérivait entre l’homme et la bête et passait de l’un à l’autre sans "
"crier gare."

#: scenario2:scenario2_613DC2C4_840E_4A8F_9D57_5CAB67B354D1
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: aa934e17782be0ef826d24f17143cb6e0410cac92a8387a6eb014659c6857108
#. default-sha256: 1047f8c0ae2a93b6b51dba0e9d21eb8fd765ab086aa91cacf269f5561c3b3104
msgctxt "scenario2:scenario2_613DC2C4_840E_4A8F_9D57_5CAB67B354D1"
msgid ""
"⟪k:0⟫If he accepted himself as human, it might cause memories better left buried to return to him."
msgstr ""
"⟪k:0⟫S’il se reconnaissait comme un être humain, des souvenirs qu’il valait mieux laisser enfouis "
"revenaient le hanter."

#: scenario2:scenario2_4E8DBE94_0F0F_455E_BD75_60909F199278
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: b8342eb264bdbf9b1b81406208568e25e9abd71edde7d9d1f4f99cec6a818c30
#. default-sha256: 11ec09a0bdabcaad52e4f40e007a318613318e336862d8c292736576baca111b
msgctxt "scenario2:scenario2_4E8DBE94_0F0F_455E_BD75_60909F199278"
msgid ""
"⟪k:0⟫If he accepted himself as a beast, in exchange for his memories,⟪k:1⟫he would no longer be "
"able to rejoin human society."
msgstr ""
"⟪k:0⟫S’il se reconnaissait comme une bête, il perdait ses souvenirs⟪k:1⟫mais ne pouvait plus "
"rejoindre la communauté des humains."

#: scenario2:scenario2_27E0A2EF_2853_4A32_A306_7FD78DEF8BD7
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: c15cadc4b347af7051bf6da9feb842c09e9e83289205e3c5bf4937a745c34010
#. default-sha256: 71f316d7127ba14f45725d3eac29b85db16ee2b063829ab867b27476955f3c7d
msgctxt "scenario2:scenario2_27E0A2EF_2853_4A32_A306_7FD78DEF8BD7"
msgid "⟪k:0⟫The White-Haired Girl fervently supported him in these precarious times."
msgstr "⟪k:0⟫La Fille aux Cheveux Blancs le soutenait avec ferveur dans ces moments difficiles."

#: scenario2:scenario2_85DB32B0_F282_4C4F_AADE_25DF44D1793A
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 3981f7d4257332b1a0f2ed17545449d6369ece463be39d869c62de35aae5cb7e
#. default-sha256: 26a4d542bbda3c973e899b7949558ebfe1d6a0c1391a6b71280e4b481f0941a4
msgctxt "scenario2:scenario2_85DB32B0_F282_4C4F_AADE_25DF44D1793A"
msgid "⟪k:0⟫I was quite amazed. ⟪k:1⟫I had never imagined she would grow to be such a strong woman."
msgstr ""
"⟪k:0⟫J’étais vraiment étonnée. ⟪k:1⟫Je n’aurais jamais imaginé qu’elle deviendrait une femme si "
"forte."

#: scenario2:scenario2_81BAC672_0240_4367_B8F1_AEEE5EF63437
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: a3fbab94d24cf7aed95e27745eda4752af190e8b355f4d9ef34217b1a919a7ef
#. default-sha256: 5dbf7422d9d054aa66a484ae18ed3f76222e4ba824f973773e2cc3f26ffdb8fe
msgctxt "scenario2:scenario2_81BAC672_0240_4367_B8F1_AEEE5EF63437"
msgid ""
"⟪k:0⟫Nevertheless, God is a cruel master. ⟪k:1⟫For what strength He gave her spiritually, He took "
"in equal part from her physically."
msgstr ""
"⟪k:0⟫Néanmoins, Dieu est un maître cruel. ⟪k:1⟫Car la force qu’il lui donnait spirituellement, il "
"la reprenait physiquement."

#: scenario2:scenario2_05F0A744_A738_48CE_AC4F_1752BD288946
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: a630d4c5a059e2747491ed58437486d54204ab40d2e428d3761fa723db4b9070
#. default-sha256: 01db98cdcaaaad12b04b258db9d39f3c675a06cc48c2b1b0d922b034b8ed7baa
msgctxt "scenario2:scenario2_05F0A744_A738_48CE_AC4F_1752BD288946"
msgid ""
"⟪k:0⟫Though she persisted, day in and day out, to stay by the man’s side, one day, she suddenly "
"fell ill."
msgstr ""
"⟪k:0⟫Elle avait beau se maintenir jour après jour à ses côtés, elle tomba un jour soudainement "
"malade."

#: scenario2:scenario2_634710E0_4271_494D_8734_B73C81AB4A91
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: efe3f84e257864f5cc19eaad01acba075d2c0264bcf81c1d3785b5d81f133dc2
#. default-sha256: a1d8bfd9befcee3ca210d995ee3fcc5e13ad2ee2fefc82c8e18b5c2ac7f256b3
msgctxt "scenario2:scenario2_634710E0_4271_494D_8734_B73C81AB4A91"
msgid ""
"⟪k:0⟫With her in the throes of a high fever and not knowing the cause, he fell into a perpetual "
"panic."
msgstr ""
"⟪k:0⟫Elle était en proie à une fièvre élevée et la cause en était inconnue, ce qui le plongea "
"dans une panique de tous les instants."

#: scenario2:scenario2_3AE81AF8_72E6_46B9_87D7_D2F4F26D2594
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 680e2778bdd990dde5a939254a9e9e52348c44e7976a71e28fec35acfba309a8
#. default-sha256: ef6c577c8abcca39536e05fe9ebd6e16d49e566d675cb884c89590f5e89f8d41
msgctxt "scenario2:scenario2_3AE81AF8_72E6_46B9_87D7_D2F4F26D2594"
msgid ""
"⟪k:0⟫There was no medicine in the mansion. ⟪k:1⟫They could hardly manage to put together "
"sufficiently nutritious meals."
msgstr ""
"⟪k:0⟫Il n’y avait aucun remède au manoir. ⟪k:1⟫Ils arrivaient à peine à rassembler suffisamment "
"pour se faire des repas nourrissants."

#: scenario2:scenario2_86C68658_873A_40A0_944A_3AFF8C8C15F3
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: c792e200d3e31355a653a33f0fcf0fc2daec23269913fbbe2213d43c3c04c077
#. default-sha256: 9542a221840a92049b76ea4ae490107936b68ee6d483e29cd14ecc29f4a9b840
msgctxt "scenario2:scenario2_86C68658_873A_40A0_944A_3AFF8C8C15F3"
msgid ""
"⟪k:0⟫Though there was no medicine, maybe there was something else that could make her feel better."
msgstr ""
"⟪k:0⟫Mais même s’il n’y avait pas de médicament, il se disait qu’il y aurait peut-être d’autres "
"choses qui pourraient l’aider à se sentir mieux."

#: scenario2:scenario2_781579D4_483E_40FE_AF37_18A0F7978D13
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: b3e17320da68840dfa9c1b09205478ad9cfc97b11b80f984d3520e25fe372edf
#. default-sha256: 2626f3ad4b1533a4d1fcff8182ad258680a507f9acb1fe88651ae5803db349e9
msgctxt "scenario2:scenario2_781579D4_483E_40FE_AF37_18A0F7978D13"
msgid "⟪k:0⟫However, everything he could think of required him to leave the house."
msgstr "⟪k:0⟫Cependant, tout ce qui lui venait à l’esprit nécessitait qu’il s’éloigne de la maison."

#: scenario2:scenario2_FF92B370_1B1F_450C_8CEE_E0A7058049B4
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: ad7b3251da5c14acdb95c3bb1150c08df41e91181ae390b9c9656c4eca52f7a6
#. default-sha256: a7b4989bc2697dec7be440e3bd803b85b1d860333c4b43ae74d073cd592ae3fe
msgctxt "scenario2:scenario2_FF92B370_1B1F_450C_8CEE_E0A7058049B4"
msgid "⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫⟪k:4⟫⟪k:5⟫⟪k:6⟫⟪k:7⟫⟪k:8⟫⟪k:9⟫Hey... ⟪k:10⟫Hey."
msgstr "⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫⟪k:4⟫⟪k:5⟫⟪k:6⟫⟪k:7⟫⟪k:8⟫⟪k:9⟫Hé... ⟪k:10⟫Hé."

#: scenario2:scenario2_3270703E_D7AD_4458_8C31_65257D00792F
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: e0b88e912b99919696e782c262cd523879c3ca14da09a74f256ff2d203b89ed8
