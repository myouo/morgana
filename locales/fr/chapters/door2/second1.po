#: scenario2:scenario2_AEB55A95_70E2_450A_BD31_2C12B010A75E
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 443541977eec5f1289150fa714bf6e707a59991e1754fa747e1dab755c4b14f9
#. default-sha256: c1728fdbaf0c24d69563063f2bc3d7c3eb06357813b36aced97f670b4e39f7b8
msgctxt "scenario2:scenario2_AEB55A95_70E2_450A_BD31_2C12B010A75E"
msgid "⟪k:0⟫⟪k:1⟫Oh dear, I was afraid you wouldn’t understand me.⟪k:2⟫⟪k:3⟫What am I to do?"
msgstr "⟪k:0⟫⟪k:1⟫Oh non, c’est ce que je craignais, vous ne me comprenez pas.⟪k:2⟫⟪k:3⟫Que faire ?"

#: scenario2:scenario2_47547A2F_83BE_4437_861A_9135AF6DFC45
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 37c097bd6967cea4ebbbbf8a983dce56020c18867a26cfdd6f8e74830ddcd49d
#. default-sha256: 3a665e7004feb83382e612b6a9767a93230fbb3bec6a2913337d2b9ba4a1bce3
msgctxt "scenario2:scenario2_47547A2F_83BE_4437_861A_9135AF6DFC45"
msgid "⟪k:0⟫I was in quite the predicament."
msgstr "⟪k:0⟫Voilà une situation bien fâcheuse."

#: scenario2:scenario2_9BDF0362_1EAE_4AA9_B4BF_FC6AADF9D3D7
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 1aec1c67d3074bfd28537db340a88bdbb3830b7a0fee036548027f584f57fcda
#. default-sha256: bce76320fb2cd876e77cfc8f5300373e7ea625703a009116a88ea29ce3e2f42f
msgctxt "scenario2:scenario2_9BDF0362_1EAE_4AA9_B4BF_FC6AADF9D3D7"
msgid ""
"⟪k:0⟫Nevertheless, it meant a great deal to me then that I had found someone who did not fear the "
"mansion—⟪k:1⟫⟪k:2⟫be they human or beast."
msgstr ""
"⟪k:0⟫Néanmoins, j’étais vraiment soulagée d’avoir trouvé quelqu’un qui ne redoutait pas le manoir—"
"⟪k:1⟫⟪k:2⟫ qu’il soit humain ou bête."

#: scenario2:scenario2_9DE01657_F670_4BDB_9C2B_AD22BF342A8E
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 7f93d24cf34217666ba4c8a1820757a7c3f10eb77b5fd160011b078dc651ce2d
#. default-sha256: 49e9772c566195fe857331d8ee062e83c2f677ad5ac3213402aec3e38d8e005a
msgctxt "scenario2:scenario2_9DE01657_F670_4BDB_9C2B_AD22BF342A8E"
msgid "⟪k:0⟫So I decided I should give him my assistance, while doing my best not to agitate him."
msgstr ""
"⟪k:0⟫C’est pourquoi je décidai de l’aider, tout en faisant de mon mieux pour ne pas l’énerver."

#: scenario2:scenario2_BB096FB2_47A4_4E8A_BB42_866D2BD0EEDD
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: e0c8e96dd4674959138650c726574532df83681b2a7c954046c351d527505bd6
#. default-sha256: 2d0bff98ebb6e738505922c21094019ab94a5ef884e17930084e329d0fc46f5b
msgctxt "scenario2:scenario2_BB096FB2_47A4_4E8A_BB42_866D2BD0EEDD"
msgid "⟪k:0⟫⟪k:1⟫Say... ⟪k:2⟫could you, perchance... ⟪k:3⟫be my new master?"
msgstr ""
"⟪k:0⟫⟪k:1⟫Dites-moi... ⟪k:2⟫se peut-il que vous soyez, à tout hasard... ⟪k:3⟫mon nouveau maître ?"
