#: scenario2:scenario2_E3B8080E_64F4_494C_8748_E633AB9B7B86
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: cf7c8e2f90d21c5dcfa5f4f6d4c28479385fa6da8cb23757e1fe05e698942c2c
#. default-sha256: 93953c6a1a603cf8134f1cb746dbf0c83c6b913b2d5ac42e46985d364440d71c
msgctxt "scenario2:scenario2_E3B8080E_64F4_494C_8748_E633AB9B7B86"
msgid "⟪k:0⟫I’ve lost my way.⟪k:1⟫⟪k:2⟫Would you please be so kind as to spare me a little food?"
msgstr ""
"⟪k:0⟫J’ai perdu mon chemin.⟪k:1⟫⟪k:2⟫Je vous en prie, auriez-vous la gentillesse de me mettre de "
"côté un peu de nourriture ?"

#: scenario2:scenario2_393C0C24_4D7B_48DD_9E86_86F245D56355
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: c888c4a83e5efa046db95e5aba868012ced069fd1fdaa348ebbd0141724f101e
#. default-sha256: 9770e01ab50bbf5be6248f868eb09017a5413ea12a50a9abb91a92dc749c3112
msgctxt "scenario2:scenario2_393C0C24_4D7B_48DD_9E86_86F245D56355"
msgid "⟪k:0⟫(Ahh, there. ⟪k:1⟫There it is.⟪k:2⟫⟪k:3⟫There comes the poor little offering.)"
msgstr "⟪k:0⟫(Ahh, voilà. ⟪k:1⟫La voilà.⟪k:2⟫⟪k:3⟫Voilà la pauvre petite offrande.)"

#: scenario2:scenario2_279D4872_C4C0_47DC_8CB3_5822826870D7
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 42d127aa0930a394cad1da6f71a4ba27ea5586b1d1de829c3f1899c798f0e779
#. default-sha256: 7f31061db3e17f20652d0202193f261519bceb8e0ca8cf0ad6158e8e91a1e4dc
msgctxt "scenario2:scenario2_279D4872_C4C0_47DC_8CB3_5822826870D7"
msgid ""
"⟪k:0⟫(They never learn.⟪k:1⟫⟪k:2⟫They just keep coming, again and again.⟪k:3⟫⟪k:4⟫The mansion "
"keeps granting my wish.)"
msgstr ""
"⟪k:0⟫(Ils n’apprennent jamais.⟪k:1⟫⟪k:2⟫Ils continuent à venir, encore et encore.⟪k:3⟫⟪k:4⟫Le "
"manoir continue d’exaucer mon souhait.)"

#: scenario2:scenario2_AAC6CF58_B448_4F28_812F_98CBE17BDAD9
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: dff51acf69612ea61c6730f6ca8672b9bbd33487809f5559c62274e243007858
