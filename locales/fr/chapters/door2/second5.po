msgctxt "scenario2:scenario2_C92FAF2A_FEB5_4F72_9017_4460FD097624"
msgid "⟪k:0⟫............"
msgstr "⟪k:0⟫............"

#: scenario2:scenario2_14B4EFA8_4CDC_4E77_9678_C64085275876
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 9703939f226f0fdd4ab5d5c1d95c38b45165ddd731a58b5813ddf58fca40b7d7
#. default-sha256: 14c1c66c24b1b18ddb729d84e8a084d2344f645516e3265f5f20c39832f67630
msgctxt "scenario2:scenario2_14B4EFA8_4CDC_4E77_9678_C64085275876"
msgid ""
"⟪k:0⟫Her words brought him faint pain, but the beast still felt, on some level, that he wanted to "
"keep her at his side. To see what would happen."
msgstr ""
"⟪k:0⟫Ses paroles ne le touchèrent guère mais la bête sentait quand même qu’il avait besoin de la "
"garder à ses côtés. Pour voir ce qui se passerait."

#: scenario2:scenario2_1DBC9231_F152_4E0A_9F32_4372EB81F449
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: b672cfb24d9d6f7de0b9c012f82b4b05506c3b32f4255cea908b5d14db806f5e
#. default-sha256: 324136723bfba0b8d5fc2ad15f199ef6043661cddf865762124718e0c2eeab74
msgctxt "scenario2:scenario2_1DBC9231_F152_4E0A_9F32_4372EB81F449"
msgid "⟪k:0⟫His next words were in large part impulsive."
msgstr "⟪k:0⟫Il prononça les mots suivants sans trop réfléchir :"

#: scenario2:scenario2_1DC255A9_C3A5_4CEE_A646_B2B4EE311868
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 8feacdbd0469982b495d58e0f0a95e038a9bf3c0834840f729720acce1500044
#. default-sha256: 32117cf6bc53ce5aa1b4f9de336448c5986f5c8a8126b03ae291af38b4411e43
msgctxt "scenario2:scenario2_1DC255A9_C3A5_4CEE_A646_B2B4EE311868"
msgid "⟪k:0⟫I-⟪k:1⟫I am grateful... ⟪k:2⟫that you cannot see."
msgstr "⟪k:0⟫J-⟪k:1⟫Je suis soulagé... ⟪k:2⟫que vous ne puissiez voir."
