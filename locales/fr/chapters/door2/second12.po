#: scenario2:scenario2_111F5064_ADFE_466A_A14C_A75FD5928ADF
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 66245dc602090b31eda6371468020d160a23c711ed267762f937c83035112161
#. default-sha256: 37e2ba56eacab55673d8d3fe2b427fd2ae8c51c09ddd6c1256dc7f0309cb149f
msgctxt "scenario2:scenario2_111F5064_ADFE_466A_A14C_A75FD5928ADF"
msgid "⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫⟪k:4⟫⟪k:5⟫⟪k:6⟫⟪k:7⟫⟪k:8⟫...Master. Master."
msgstr "⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫⟪k:4⟫⟪k:5⟫⟪k:6⟫⟪k:7⟫⟪k:8⟫...Maître. Maître."

#: scenario2:scenario2_11F56EE0_9C38_4F29_B74A_6FCC8A325BC3
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: f3a6dc46b5551e15bc6109a0dcc006316350474f1eb089062798844a6c65293d
#. default-sha256: 372f0bdcba4e4c88243daa99f97309436ef1e8fbad651c25e62acbb484fe6d04
msgctxt "scenario2:scenario2_11F56EE0_9C38_4F29_B74A_6FCC8A325BC3"
msgid "⟪k:0⟫Ahh... ⟪k:1⟫you have awakened. ⟪k:2⟫You gave me quite the startle."
msgstr "⟪k:0⟫Ahh... ⟪k:1⟫vous êtes réveillé. ⟪k:2⟫Vous m’avez fait sursauter."

#: scenario2:scenario2_89EE87C6_5B9A_4A0A_A1DF_5919B15040CC
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: de12ea1821abd98bc62b0a6cbdea8b2afa7cfc2749d526303eee2dd14f1db94b
#. default-sha256: 6fbd58575f9bd20f495fd5998676ce748db3052496e62ebee3939084d15984a7
msgctxt "scenario2:scenario2_89EE87C6_5B9A_4A0A_A1DF_5919B15040CC"
msgid ""
"⟪k:0⟫Do you not remember? ⟪k:1⟫You suddenly started staring off into the distance, and you would "
"not respond to anything I said."
msgstr ""
"⟪k:0⟫Vous ne vous souvenez pas ? ⟪k:1⟫Vous vous êtes soudain mis à fixer un point éloigné et vous "
"ne réagissiez plus du tout à ce que je disais."

#: scenario2:scenario2_1CC76CC7_F747_47C2_8887_23081832279C
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: d86c97d991a6853a17d013ef7a2d514e429bfea3085ecd46a3a0fa16327dd679
#. default-sha256: 41b726dfe2f876bcd980de9095676b51a0ff2437e8f766238c08ad73a365ddc0
msgctxt "scenario2:scenario2_1CC76CC7_F747_47C2_8887_23081832279C"
msgid "⟪k:0⟫Hehe. I thought you were playing a prank on me."
msgstr "⟪k:0⟫Héhé. Je pensais que vous me jouiez un tour."

#: scenario2:scenario2_1AD64425_BDF5_4EA6_9999_FD49546236A4
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: f7d0273f38857032196e2b55ad5f7c706df92aec6c1c8e826d58bc0d29d913d8
#. default-sha256: a75bb63e2c49212ec62182065c6ae0f4b7d513e99962086093c918c213b7b85f
msgctxt "scenario2:scenario2_1AD64425_BDF5_4EA6_9999_FD49546236A4"
msgid "⟪k:0⟫Your hand? ⟪k:1⟫Oh, yes, I did not let go of it."
msgstr "⟪k:0⟫Votre main ? ⟪k:1⟫Ah, non, je ne l’ai pas lâchée."

#: scenario2:scenario2_1A399BDF_5BE1_4A36_AB0A_D560CD523861
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 56e7447d73d4551d676da06c8bc67703759592af9f87c955d02c3343b54b86f2
#. default-sha256: 811cb3f52c2c157f1398fbe8b25958d90feb0cb4dcbac0b8bc1017bd050fb41e
msgctxt "scenario2:scenario2_1A399BDF_5BE1_4A36_AB0A_D560CD523861"
msgid "⟪k:0⟫For if I had, we would be in quite the predicament."
msgstr "⟪k:0⟫Si c’était le cas, nous serions dans une situation très fâcheuse."

#: scenario2:scenario2_F848F63F_7A17_4B90_B2F5_A318014EACD6
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: b5ab3aa79ce77f26ea5a389731ea61b41d2af78cc69c92e6161e48acbde29efd
#. default-sha256: f7cb6013d870025f91323c86f1835e7454d9e69a5dc5560303b2729260f56b98
msgctxt "scenario2:scenario2_F848F63F_7A17_4B90_B2F5_A318014EACD6"
msgid "⟪k:0⟫Someone approaching the mansion, you say? ⟪k:1⟫You saw them?"
msgstr "⟪k:0⟫Des gens s’approchent du manoir, vous dites ? ⟪k:1⟫Vous les avez vus ?"

#: scenario2:scenario2_A1598863_CBF6_41E4_BCFE_3F9793B411E7
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 88c5220f75bbc62a5946e4dbf65845ddb92f8b4d321e155f496ff4c2b5503b2b
#. default-sha256: a9431df28d766f36e17ea05c38a327d1b5880a22567693b4675b98d097d9c9a4
msgctxt "scenario2:scenario2_A1598863_CBF6_41E4_BCFE_3F9793B411E7"
msgid ""
"⟪k:0⟫Those images... ⟪k:1⟫were not shown to you by me. ⟪k:2⟫If you saw something, then it was by "
"your own powers."
msgstr ""
"⟪k:0⟫Ces images... ⟪k:1⟫je ne vous les ai pas montrées. ⟪k:2⟫Si vous avez vu quelque chose, c’est "
"par vos propres pouvoirs."

#: scenario2:scenario2_71F90BF4_07DD_4E07_A132_1B71D3313736
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: c4487a5b7e3efe1c3b10097eb5ea96dc0985e94144f7de7d8a7e61d703917045
#. default-sha256: 5de8f59de220978447d42c7efc85dc25e8e942eee44d7a5dc0e62f898e8d0341
msgctxt "scenario2:scenario2_71F90BF4_07DD_4E07_A132_1B71D3313736"
msgid "⟪k:0⟫But if you think about it, that is nothing unusual."
msgstr "⟪k:0⟫Mais si on y pense, cela n’a rien d’inhabituel."

#: scenario2:scenario2_2BC8B724_D335_4767_B5CD_FCB8966C49A9
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 8ddc13d8a24cfa9fe55b97a49db68dfcac2f06267c5a7f4cae2fa8eafe994d0c
#. default-sha256: e5dbe7e68868c0d71588523e5443a8496df5f7cf314fbc0fb6861de77f74818a
msgctxt "scenario2:scenario2_2BC8B724_D335_4767_B5CD_FCB8966C49A9"
msgid "⟪k:0⟫You are, after all, the master of this house."
msgstr "⟪k:0⟫Après tout, vous êtes le maître de cette maison."

#: scenario2:scenario2_1B8C40FB_85CC_4FE2_AC7E_E24F642F5E44
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 471179b66922f90b5e57bc54142619d28fd98dc289ccd392fb37cb1fb7e940a3
#. default-sha256: 59f846f109e2b8ace9f3657096e2cb71b4774bb97407a315834a5a45a036f005
msgctxt "scenario2:scenario2_1B8C40FB_85CC_4FE2_AC7E_E24F642F5E44"
msgid "⟪k:0⟫You should, in all actuality, be able to do anything I can do by yourself, Master."
msgstr "⟪k:0⟫En réalité, vous devriez être capable d’en faire tout autant que moi, Maître."

#: scenario2:scenario2_7E71B94D_DC7F_4E9D_A51F_AD26D219E9FC
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 6f2506f66bb379d6b738318a4207385e87ac1e3db2a295d017aadf53b7bf7b19
#. default-sha256: 54a2c64e7860a5772dc813fdb3b6d6ebbd4c5fe26700374523c84d2defbd6a83
msgctxt "scenario2:scenario2_7E71B94D_DC7F_4E9D_A51F_AD26D219E9FC"
msgid "⟪k:0⟫So it is very possible you could have knowledge that I do not."
msgstr "⟪k:0⟫Il est donc tout à fait possible que vous en sachiez plus que moi."

#: scenario2:scenario2_6E2FABCA_9F64_48A0_B7E6_6CD0ADBD4555
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: a317016db66e39dd846b9188e9cd498654585bfaf93278f3c25b982c8f13561c
#. default-sha256: 83460054f5e35318b40b1aa6afc3346e1e4ed2d25fb5c07b6b1651fe1a00a500
msgctxt "scenario2:scenario2_6E2FABCA_9F64_48A0_B7E6_6CD0ADBD4555"
msgid "⟪k:0⟫Now, let us return to the mansion’s tale."
msgstr "⟪k:0⟫Retournons à présent à notre conte."

#: scenario2:scenario2_0F1BEE93_B1C4_4A09_B39D_E7D9E7B6F528
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 52c65c3c0571b668d987bdf2659837c95849dd559688f41384dab4bd1a358bf8
#. default-sha256: e77b46cf8f0f955db3603486211962de045bed2ad8c8527b5e31d42350a5b727
msgctxt "scenario2:scenario2_0F1BEE93_B1C4_4A09_B39D_E7D9E7B6F528"
msgid "⟪k:0⟫After the second beast paid a visit, Bestia began to destabilize again."
msgstr "⟪k:0⟫L’arrivée de la seconde bête avait à nouveau déstabilisé Bestia."

#: scenario2:scenario2_9192764E_EBB3_456D_8944_942876725FB3
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: dba635769d0a56363c69f3c05d81ceec291677aab2f676d8ac4353e8c577ff65
#. default-sha256: 34ef091eefe609ea3d1b4be4ad8f2816922371aad37d1da02a375187904e6c84
msgctxt "scenario2:scenario2_9192764E_EBB3_456D_8944_942876725FB3"
msgid "⟪k:0⟫The White-Haired Girl would soothe his heart, but the calm was only ephemeral."
msgstr "⟪k:0⟫La Fille aux Cheveux Blancs apaisait son cœur mais le calme n’était que temporaire."

#: scenario2:scenario2_E9596033_9464_4E27_AE7A_5F6978E107B7
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 2b2c0427348363ba245512d7d3be7c6d9947c12844d6c7ab6e8ed2c2664d507b
#. default-sha256: 6f1d70db0f7388f50504b9b94edd54d351fc4efbce0bb5ccb35303428a8e4fdb
msgctxt "scenario2:scenario2_E9596033_9464_4E27_AE7A_5F6978E107B7"
msgid "⟪k:0⟫He was like a cracked glass ball."
msgstr "⟪k:0⟫Il ressemblait à une boule en verre qui se serait craquelée."

#: scenario2:scenario2_A0605F8E_692A_4C13_9EBC_6804BCFE93B3
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: ecf4bd7c16adc14bcb4b3dd1fbe8d13d663fccf89a0bcec74e8268272ec66a12
#. default-sha256: 1cb7ab42b60b115fad0dddd1bfe01e08c341ad4eec8fcd504497bc83f1ebac6a
msgctxt "scenario2:scenario2_A0605F8E_692A_4C13_9EBC_6804BCFE93B3"
msgid ""
"⟪k:0⟫If you dropped him, that would be the end. ⟪k:1⟫If you put too much force into handling him, "
"he would shatter. ⟪k:2⟫He was very difficult to care for."
msgstr ""
"⟪k:0⟫Qu’on la fasse tomber et ce serait la fin. ⟪k:1⟫Qu’on s’adresse à lui trop violemment et il "
"éclaterait en mille morceaux. ⟪k:2⟫Il devenait très difficile à gérer."

#: scenario2:scenario2_0B4F9443_56C3_456D_B951_B6010DA695FE
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 1a201b92ca2dc4eaab5191e60a9a027f95520e83d8d80486809a52ddde1a6162
#. default-sha256: 63f7eb0136bea58f47b3ce4880aab81e22ab277be9707b614f3ca118715698bd
msgctxt "scenario2:scenario2_0B4F9443_56C3_456D_B951_B6010DA695FE"
msgid ""
"⟪k:0⟫And cracks do not heal. ⟪k:1⟫The damage still remains, even if the two sides appear to be "
"held together firmly in place."
msgstr ""
"⟪k:0⟫Et les fissures ne disparaissent pas. ⟪k:1⟫On voit toujours la faille, même si on croit "
"avoir recollé les deux pans solidement."

#: scenario2:scenario2_5A7A7FC0_467A_41A0_9F25_8AB72A3349B6
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 403ee7a366d05e9166c14cf57cf9307202ef557164069233af9616eed0b2e35d
#. default-sha256: 0611bc1c5d3bf2aebf0f048a00b2aaa4f40b85c5d8418f37e64bcc76cef3beac
msgctxt "scenario2:scenario2_5A7A7FC0_467A_41A0_9F25_8AB72A3349B6"
msgid "⟪k:0⟫Furthermore, they slowly, gradually, and without intervention spread."
msgstr ""
"⟪k:0⟫De plus, elles se répandent doucement, progressivement, sans qu’on ne puisse rien y faire."

#: scenario2:scenario2_F3BEFB24_9F16_4AFE_BBF4_CCCC02D9858D
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: c641fa75642b073d86f425ab57cce71de916aaa42af3f2d546f76b5f431549c4
#. default-sha256: a1221b98ffa7c6aa062d10e33d582dbbe1830d00f675b5f0262adb4be3569cbe
msgctxt "scenario2:scenario2_F3BEFB24_9F16_4AFE_BBF4_CCCC02D9858D"
msgid "⟪k:0⟫The beast appeared to be afraid of someone’s voice."
msgstr "⟪k:0⟫Bestia semblait effrayé par la voix de quelqu’un."

#: scenario2:scenario2_3CCE8F83_81C4_47D8_99D2_C77A99D5C210
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 614a80a02f68307681fca88b282eeafc71d17fe1b4125ce81abbb1eda4d11a39
#. default-sha256: 62c15f0184d0c6311b48bc25b94021ae2a55a6ef7de22cdddfc1c35afbe077b6
msgctxt "scenario2:scenario2_3CCE8F83_81C4_47D8_99D2_C77A99D5C210"
msgid "⟪k:0⟫He would on occasion stare into empty space and shout, cover his ears, and groan."
msgstr ""
"⟪k:0⟫De temps en temps, il fixait l’espace et se mettait à crier et se bouchait les oreilles en "
"gémissant."

#: scenario2:scenario2_3602D6A7_C211_42BD_B283_E0DEACB10FD7
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: e06bbcc05f3a518364705a43f59ad9ea03e7f15c508cb4ea22fb1bab4b6e0af1
#. default-sha256: 2326aa4fe532352686ef3db858f339c0f2029b594ced64c3637ac05f1d9a9d65
msgctxt "scenario2:scenario2_3602D6A7_C211_42BD_B283_E0DEACB10FD7"
msgid ""
"⟪k:0⟫One day, he shattered all the windows in the mansion, crushed the silverware I had just "
"polished to a shine..."
msgstr ""
"⟪k:0⟫Un jour, il brisa toutes les fenêtres du manoir, écrasa toute l’argenterie que je venais de "
"polir à la perfection..."

#: scenario2:scenario2_E717A328_7A1E_4C98_AEC3_5BA798EE0BCD
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 79f4a73d399514ff9aaa5449a00ebd8048537a5bb959489159f2d12aaa7f74fd
#. default-sha256: 895da2f6e79def59633bef4858d0f7c75a4aaee01d9d29dc4a7d47ec4eb5acfd
msgctxt "scenario2:scenario2_E717A328_7A1E_4C98_AEC3_5BA798EE0BCD"
msgid "⟪k:0⟫and destroyed all the mirrors."
msgstr "⟪k:0⟫...et détruisit tous les miroirs."

#: scenario2:scenario2_3D6268C8_5E43_4895_85B3_41C34C8C23E7
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 98ef079ea8f55e7bc39c0a5ccbbc461c5936ebfbc72faa48e098dc8854f09c64
#. default-sha256: 8b5faa088e75414ae81c1ad9c6ad8d6bfa0374ff64901df5c7993ed690e77b1d
msgctxt "scenario2:scenario2_3D6268C8_5E43_4895_85B3_41C34C8C23E7"
msgid "⟪k:0⟫I assume he did not want to see his beastly self."
msgstr "⟪k:0⟫J’imagine qu’il ne voulait pas voir son apparence bestiale."

#: scenario2:scenario2_E6660BE9_C4A9_4F2A_900C_9387CC154EA2
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 8768981781e9c7e85fd889e6f2ca83ef39cd88cb48db61c88df88fbd8a5da1e9
#. default-sha256: a5a8a498281732c7c1b5884be7ede37163c3707f9e49611bf579583af96c081e
msgctxt "scenario2:scenario2_E6660BE9_C4A9_4F2A_900C_9387CC154EA2"
msgid ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫⟪k:4⟫⟪k:5⟫⟪k:6⟫⟪k:7⟫⟪k:8⟫⟪k:9⟫More... ⟪k:10⟫There’s more!⟪k:11⟫⟪k:12⟫There’s "
"still more that reflects my image!"
msgstr ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫⟪k:4⟫⟪k:5⟫⟪k:6⟫⟪k:7⟫⟪k:8⟫⟪k:9⟫Encore... ⟪k:10⟫Il y en a encore !⟪k:11⟫⟪k:12⟫"
"Il y en a encore qui reflètent mon image !"

#: scenario2:scenario2_0E8A774D_89D2_40BB_B08E_32EBA92EA1AD
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 2bb4ab2255d34f1c9815b93666e143eebb786adcf7f4972046c5b3834a088fd5
#. default-sha256: 2ce1db58f0a9500181c9fa34c83163a719703144b85dc4c958bbd2c7091fae81
msgctxt "scenario2:scenario2_0E8A774D_89D2_40BB_B08E_32EBA92EA1AD"
msgid "⟪k:0⟫Windows! Mirrors! Vases! Dishes!⟪k:1⟫They all show my reflection!"
msgstr "⟪k:0⟫Fenêtres ! Miroirs ! Vases ! Assiettes !⟪k:1⟫Ils me montrent tous mon reflet !"

#: scenario2:scenario2_30E1C98F_85D0_415D_9596_F850209C4998
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: a8ca608e082fc545c24c67115c38f49ad1f2f89f55c476dd1cf103e8853fcda0
#. default-sha256: 007eb816562a2fb6c567a6e09f31c142baa597db91978a1dac7ba3bafbe53cf5
msgctxt "scenario2:scenario2_30E1C98F_85D0_415D_9596_F850209C4998"
msgid "⟪k:0⟫⟪k:1⟫⟪k:2⟫Wh-⟪k:3⟫What are you doing?"
msgstr "⟪k:0⟫⟪k:1⟫⟪k:2⟫Qu-⟪k:3⟫Que faites-vous ?"

#: scenario2:scenario2_F54E30E6_55AA_42BA_AD2E_92886CDE897F
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 1713165f78fb73578fe547fe722f25292aa7da1b8f6a7fb7cb5c4b9499aafa34
#. default-sha256: 4c258f7a644c731a0b4b7ecfad82574bed42c5b2bce410ead1eac79ac8fae6c0
msgctxt "scenario2:scenario2_F54E30E6_55AA_42BA_AD2E_92886CDE897F"
msgid ""
"⟪k:0⟫⟪k:1⟫I have no need of anything that reflects me!⟪k:2⟫You can understand that, can’t you?!"
msgstr "⟪k:0⟫⟪k:1⟫Je n’ai pas besoin de reflets !⟪k:2⟫Vous le comprenez, non ?!"

#: scenario2:scenario2_C37A06CA_F7DA_4690_930A_171C363FC46F
