msgid "⟪k:0⟫⟪k:1⟫I remember that day clear as crystal."
msgstr "⟪k:0⟫⟪k:1⟫Je me souviens de ce jour comme si c’était hier."

#: scenario2:scenario2_E78553CD_4C95_4319_A3B1_62E2A964DE0C
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: b2eef231bb4fd9e85768cc90e8f0a165689b4b91210f377bdd7f6d53f650d9e6
#. default-sha256: 3e5c96b35ab0a4c707b6496942b2a90a5d0f9753a12525afe053a327f9d26f8b
msgctxt "scenario2:scenario2_E78553CD_4C95_4319_A3B1_62E2A964DE0C"
msgid ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫⟪k:4⟫⟪k:5⟫⟪k:6⟫⟪k:7⟫⟪k:8⟫⟪k:9⟫Ah, yes, I have to say, the food here is ⟪k:10⟫"
"spectacular⟪k:11⟫.⟪k:12⟫⟪k:13⟫And I love that they give you so much meat.⟪k:14⟫⟪k:15⟫Though I "
"thought my gut’d explode the first time I saw it, hahaha!"
msgstr ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫⟪k:4⟫⟪k:5⟫⟪k:6⟫⟪k:7⟫⟪k:8⟫⟪k:9⟫Ah, au fait, il faut que je te prévienne, la "
"nourriture ici est ⟪k:10⟫phénoménale⟪k:11⟫.⟪k:12⟫⟪k:13⟫Et j’aime qu’ils nous donnent autant de "
"viande.⟪k:14⟫⟪k:15⟫Même si je me suis dit que mon estomac allait exploser la première fois que je "
"suis venu, hahaha !"

#: scenario2:scenario2_525F4CC9_9163_4241_937D_1FD6C484547A
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 36d207dd46575267dc50738f12efd6de89c12f0d628cfc46be42332fc6a880d6
