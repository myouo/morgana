#: scenario2:scenario2_59EC1995_9F69_4928_B63F_A488984FD7D5
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 5a1794011fcda245215709c7635504b2a6cee02e275ee79f8368cbf9c6b00529
#. default-sha256: b18bbfea0b6728b6e6d4dfd62ad5cc14c9e6a74bf813a930ad59d1499d284f49
msgctxt "scenario2:scenario2_59EC1995_9F69_4928_B63F_A488984FD7D5"
msgid "⟪k:0⟫It’s hot."
msgstr "⟪k:0⟫Il fait chaud."

#: scenario2:scenario2_48688F6C_4A2D_4F6F_8035_0F50B05DBDCA
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: e1af244028a38fdfed185e01e64feebe158a14d8f0b5491a23bbceaa02841236
#. default-sha256: 66ecad7676f36d9cca6546c1c2501fc2eeaa359887c7210c3fce2223d7c219ce
msgctxt "scenario2:scenario2_48688F6C_4A2D_4F6F_8035_0F50B05DBDCA"
msgid ""
"⟪k:0⟫My parents’ relationship is on thin ice, but the air feels like it’s on fire. ⟪k:1⟫It’s much "
"too hot."
msgstr ""
"⟪k:0⟫La relation entre mes parents est d’un glacial... Mais l’air ambiant la transforme en vraie "
"fournaise. ⟪k:1⟫Il fait beaucoup trop chaud."

#: scenario2:scenario2_9E8AA447_803D_4FF2_867B_0D87BF0DBCA8
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 6e881da251ef3a001c7bcea05d4f9d156791e5bdee81ddec696299cb5eaf451b
#. default-sha256: 0f40380160d06ad0f9a4a511e20ecc1ccbafcfd62e09d090772b14a0182ca158
msgctxt "scenario2:scenario2_9E8AA447_803D_4FF2_867B_0D87BF0DBCA8"
msgid ""
"⟪k:0⟫My dad loves this seaside restaurant. ⟪k:1⟫It actually specializes in fish, but he always "
"asks for meat."
msgstr ""
"⟪k:0⟫Mon papa adore ce restaurant. ⟪k:1⟫En fait, ils ont pour spécialité le poisson mais il "
"demande toujours de la viande."

#: scenario2:scenario2_7568A884_1212_4814_AD60_5BB3B1D66CA4
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: cce3bd15f98eeb62ad601bb290a6d24a8ccc1e1834e439b98019c59efd7ffee0
#. default-sha256: 2db1dd733a9b1abd6b274cc2d764737bd9653697077e654a3cdb32d34cedc9a7
msgctxt "scenario2:scenario2_7568A884_1212_4814_AD60_5BB3B1D66CA4"
msgid ""
"⟪k:0⟫Though “always” isn’t very often. He’s out of the country most of the time, so we rarely eat "
"together as a family."
msgstr ""
"⟪k:0⟫Même si « toujours », ce n’est pas très souvent. Il est à l’étranger la plupart du temps, "
"donc on va rarement manger en famille."

#: scenario2:scenario2_4714BF7B_C21A_4DE6_A54C_A5E914690614
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: b9d4a45f5d1ac4a522dc9617c75d00b052fe8d5ea6e0d7c12eee0a391688cf4d
#. default-sha256: 664667e4a8891f59c613e99d8ab96e1985cd880ffbea12b92610cd18a559d3be
msgctxt "scenario2:scenario2_4714BF7B_C21A_4DE6_A54C_A5E914690614"
msgid "⟪k:0⟫For that reason, I can usually put up with a little heat for a family gathering..."
msgstr ""
"⟪k:0⟫C’est pour cette raison que d’ordinaire, j’arrive à supporter les discussions animées lors "
"de nos réunions de famille..."

