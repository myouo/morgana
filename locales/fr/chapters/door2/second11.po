msgctxt "scenario2:scenario2_5D22588D_23FA_4C4A_BEEA_9AA2867028FE"
msgid "⟪k:0⟫Is your heart made out of stone?"
msgstr "⟪k:0⟫Avez-vous un cœur de pierre ?"

#: scenario2:scenario2_9350C4B7_9DA2_40C4_BA44_66C0764FDCCA
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 88ff2046d174766f41db2bf4a70994aa0a7f9646c5934554631fc9fc98aa9b89
#. default-sha256: fe4b9c881459d071724c6ebf692cb6736a8c667a347cd170b2b719f33c5375e6
msgctxt "scenario2:scenario2_9350C4B7_9DA2_40C4_BA44_66C0764FDCCA"
msgid ""
"⟪k:0⟫What, would you prefer we discuss the mundane?⟪k:1⟫⟪k:2⟫Why don’t we talk about market "
"developments and our spices inventory?"
msgstr ""
"⟪k:0⟫Quoi, vous préférez que je dise des banalités ?⟪k:1⟫⟪k:2⟫Sinon, on n’a qu’à parler des "
"évolutions du marché et de l’inventaire de nos épices ?"

#: scenario2:scenario2_9270F5AA_73DF_4E06_B990_CAA0DAE3F39B
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
