#: scenario2:scenario2_AF534BF7_1E63_4858_9822_AE827236AD2A
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 58f81dd19dbe6a778ddba548fa8042ec80d1df40f0a7957205b98d1d2ce43f5d
#. default-sha256: 4c759c3fd22a33c49261c1e320504ea2dd554cdd5a166981c77a1905450ca446
msgctxt "scenario2:scenario2_AF534BF7_1E63_4858_9822_AE827236AD2A"
msgid ""
"⟪k:0⟫Despite all the effort he had put into learning to act like a human,⟪k:1⟫he now ripped the "
"velvet curtains off the wall, howling shrilly..."
msgstr ""
"⟪k:0⟫En dépit de tous les efforts qu’il avait fournis pour être plus humain,⟪k:1⟫il déchirait les "
"rideaux en velours des murs, il poussait des cris stridents..."

#: scenario2:scenario2_BA98E10A_4FFE_4B82_BC86_489544991836
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 2068c614a6e023e1b494f33e9ef949f75dffddbe2caeae4c506408ed3815c020
#. default-sha256: 96649eb670b820a07ab5e21ef61f0dc1c5bc0e84be976a348e9ed2fc3f07ee2e
msgctxt "scenario2:scenario2_BA98E10A_4FFE_4B82_BC86_489544991836"
msgid "⟪k:0⟫stomping back and forth through the hallways,⟪k:1⟫and ravaging the garden."
msgstr ""
"⟪k:0⟫...il faisait les cent pas dans les couloirs en piétinant tout ce qu’il trouvait sur son "
"passage et il détruisait le jardin."

#: scenario2:scenario2_6C475E70_A81C_4BFD_ABE3_D949B020BD8D
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: e62c67ec730fbad9be58940fd9bdc8affb5b61ad67480183955431d331bc5e1a
#. default-sha256: 0edfea5724976490e7578a6f1fcdc22e096cbb0456f27c620974e6247bab7a32
msgctxt "scenario2:scenario2_6C475E70_A81C_4BFD_ABE3_D949B020BD8D"
msgid "⟪k:0⟫I watched him intently, though from a distance."
msgstr "⟪k:0⟫Je l’observais attentivement, tout en prenant mes distances."

#: scenario2:scenario2_76DF26B7_C79C_43E6_ABEE_EA8D8BD55483
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: aed01288fbd46d3dad06e81402e97ab39686eb2102f85e34942c6884a307ba68
#. default-sha256: 9b5c8b1cb9eb549cb0fc8d07eeb866728c2442d1bbbf2acb4a022dac9b76e7ea
msgctxt "scenario2:scenario2_76DF26B7_C79C_43E6_ABEE_EA8D8BD55483"
msgid "⟪k:0⟫Bestia was not merely a beast,⟪k:1⟫but an out-of-control, bloodthirsty beast."
msgstr ""
"⟪k:0⟫Bestia n’était pas simplement une bête,⟪k:1⟫c’était une bête hors de tout contrôle et "
"assoiffée de sang."

#: scenario2:scenario2_BB3EA482_6936_4D0F_A580_E91CE2D177F0
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 53768298bf58cc38b7cb99d1e9c1e491ce8eada338ef09a19f4849dd8305b077
#. default-sha256: 6172b1b043142efe562ee5beba1d00945f8afa02f5c04f41049cd807814871f1
msgctxt "scenario2:scenario2_BB3EA482_6936_4D0F_A580_E91CE2D177F0"
msgid ""
"⟪k:0⟫Just a few days ago, we had been tending the garden together,⟪k:1⟫but that was no longer "
"possible."
msgstr ""
"⟪k:0⟫Quelques jours auparavant, on s’occupait encore du jardin ensemble,⟪k:1⟫mais ce n’était plus "
"possible."

#: scenario2:scenario2_F3463257_B8F0_4A65_9B30_63C2DAA67D32
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 0457f07c1ca4eb7b892fec795ba47427baae66108b502712e782c55422239ae9
#. default-sha256: 52b255aadf0a58284fff933061f2fcd3bfed66242abb445d2efcfd2f8c22fa37
msgctxt "scenario2:scenario2_F3463257_B8F0_4A65_9B30_63C2DAA67D32"
msgid "⟪k:0⟫I was quite disappointed."
msgstr "⟪k:0⟫J’étais vraiment déçue."

#: scenario2:scenario2_6827B29D_4F36_4432_9125_0FA63C1350E3
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 2c853f21f6cbfa43c4e39d5065d79cfe65cd746492b3b5f0fa16dcd5c7ec5519
