msgid "⟪k:0⟫⟪k:1⟫Don’t have enough, not enough,⟪k:2⟫⟪k:3⟫I need more, I need moooooooore!⟪k:4⟫"
msgstr "⟪k:0⟫⟪k:1⟫Pas assez, pas assez,⟪k:2⟫⟪k:3⟫je veux plus, pluuuuuuus !⟪k:4⟫"

#: scenario2:scenario2_44A70BCF_E7C4_4F48_922F_44612B539764
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: fc9c8781a9cc0114492cca2a01b9a8cfac5c9c35d9676259c42e7ac1d454541b
