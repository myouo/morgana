msgctxt "scenario2:scenario2_3DEB76D0_C400_41A6_86CB_AADC4D54BC79"
msgid "⟪k:0⟫Half of her blood was of the same race as his."
msgstr "⟪k:0⟫Son sang était pour moitié originaire de son pays."

#: scenario2:scenario2_0B269F7E_7BD0_4536_B157_071365C1498D
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 3cbaa57d79bfa41a03334e8ad499350e2e282f245671324c4c9af18e7d65afa5
