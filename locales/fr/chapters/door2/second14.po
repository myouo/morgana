msgctxt "scenario2:scenario2_77A688CC_59DB_4A8A_80D6_2805FD5F2A7B"
msgid "⟪k:0⟫And that, perhaps, would have been better for you..."
msgstr "⟪k:0⟫Et peut-être que cela aurait mieux valu pour vous..."

#: scenario2:scenario2_73EE22AD_3CAF_4942_824E_45B6B1CDBEE0
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 205d3e346cbcade374e160d98db9af9314e6b441b80d71b9d83a51c022e4dc27
