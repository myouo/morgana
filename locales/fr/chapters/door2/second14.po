msgid "⟪k:0⟫The poor young woman who called upon the mansion did, indeed, resemble Bestia."
msgstr "⟪k:0⟫La pauvre jeune femme qui s’était présentée au manoir ressemblait, en effet, à Bestia."

#: scenario2:scenario2_13DF9A7B_EC52_4D1F_8FD2_14F26ED935D1
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 621b454d7996e584e6464bbdad9c8e1c337b5f651b33f589fb13b37e2f44a329
