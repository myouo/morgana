msgctxt "scenario2:scenario2_5AA9AE97_F7A2_4AFA_A2FD_3B7BBDA70572"
msgid "⟪k:0⟫(I desperately desired to see blood—⟪k:1⟫⟪k:2⟫human blood...)"
msgstr "⟪k:0⟫(Je désirais désespérément voir le sang—⟪k:1⟫⟪k:2⟫ le sang humain...)"

#: scenario2:scenario2_D48F470C_5E20_4CC0_84F6_388845B1A72F
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 58fad7ee571d4fd6c1c58da398f100310c49e5543626a8e8db726591e89df286
