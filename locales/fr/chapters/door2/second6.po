msgctxt "scenario2:scenario2_215A2D46_B2AB_4C00_8D11_BCA5D5A8AF86"
msgid "⟪k:0⟫(But I relished in it...)"
msgstr "⟪k:0⟫(Je m’en suis pourtant délecté...)"

#: scenario2:scenario2_B81F4DF4_2CAE_4BFB_9662_057572CF1458
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 2e18c73de37e8e82c66ebbc53207a22a091919b0fa7b743490141a6f0f69196f
