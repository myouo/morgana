msgid "⟪k:0⟫⟪k:1⟫...What is the matter?"
msgstr "⟪k:0⟫⟪k:1⟫...Qu’est-ce qui ne va pas ?"

#: scenario2:scenario2_B5BD6D06_AAF2_49FD_BAD8_8B3BA4A5AD55
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 1cc96df67d0204b9833f66a3c739b6bc53680703d862f136ee26741b2c98b7ae
#. default-sha256: 324a32bd08093e97063fb94740abf2a597b4b4ff4095756333fbc2dbafdba6ee
msgctxt "scenario2:scenario2_B5BD6D06_AAF2_49FD_BAD8_8B3BA4A5AD55"
msgid "⟪k:0⟫⟪k:1⟫Do you honestly not fear me?"
msgstr "⟪k:0⟫⟪k:1⟫Ne me craignez-vous pas, honnêtement ?"

#: scenario2:scenario2_FB16E62F_6D73_4768_AC4F_888E6DAFFCCD
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: d7cced0f7b64995032de3b8202cda00aac2df33ff7e5cce08da9e43e5a1a675e
