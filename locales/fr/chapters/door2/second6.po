msgid "⟪k:0⟫⟪k:1⟫No... ⟪k:2⟫y-⟪k:3⟫you do not."
msgstr "⟪k:0⟫⟪k:1⟫Non... ⟪k:2⟫⟪k:3⟫on ne dirait pas."

#: scenario2:scenario2_FA13F74E_6111_4089_8272_900D124FD583
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: ad22fc6630495a83e18329820df8069bbfb56cfe9ee6cdaf72d408d870bb17a6
#. default-sha256: c288921d18177a260eefe51cfefccc6896c42c830b0881f99d3a9a2ee29f9740
msgctxt "scenario2:scenario2_FA13F74E_6111_4089_8272_900D124FD583"
msgid ""
"⟪k:0⟫(But you ⟪k:1⟫would⟪k:2⟫. ⟪k:3⟫If you could see me,⟪k:4⟫you would react the same as everyone "
"else.⟪k:5⟫⟪k:6⟫You would mock me; ⟪k:7⟫you would despise me;⟪k:8⟫you would want to kill me.)"
msgstr ""
"⟪k:0⟫(Mais vous ⟪k:1⟫devriez⟪k:2⟫. ⟪k:3⟫Si vous pouviez me voir, vous réagiriez comme tout le "
"monde.⟪k:4⟫⟪k:5⟫Vous vous moqueriez de moi ; ⟪k:6⟫vous me mépriseriez ; vous voudriez me tuer.)"

#: scenario2:scenario2_ADED7667_51B0_42A8_966B_728429B71DF1
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: d17c9deec8dd85caf409a6d8911679493dceccfb7b0570f9b9485f1e37bc9e20
#. default-sha256: 4f48721e9b0cc5bc44186be6701143b27fb93c2ac7aa69fce06efc0d2d99f7f6
msgctxt "scenario2:scenario2_ADED7667_51B0_42A8_966B_728429B71DF1"
msgid "⟪k:0⟫(You don’t know what I’ve done, because you can’t see.)"
msgstr "⟪k:0⟫(Vous ne savez pas ce que j’ai fait parce que vous ne pouvez le voir.)"

#: scenario2:scenario2_5FDA6BE2_1924_4963_BEDA_BF537EC984FF
