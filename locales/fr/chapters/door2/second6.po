msgid "⟪k:0⟫⟪k:1⟫Oh, shall I make some?⟪k:2⟫⟪k:3⟫Are you thirsty?"
msgstr "⟪k:0⟫⟪k:1⟫Ah, voulez-vous que j’en fasse ?⟪k:2⟫⟪k:3⟫Avez-vous soif ?"

#: scenario2:scenario2_0A5D7881_668B_43CC_85AE_41D744B01457
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
