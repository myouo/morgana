msgctxt "scenario2:scenario2_FF7D2F93_0EE1_4904_82BC_CFBF1E4C29EF"
msgid "⟪k:0⟫(all the horrible things I’ve done.)"
msgstr "⟪k:0⟫(...toutes les choses horribles que j’ai faites.)"

#: scenario2:scenario2_0A61BE1F_38C0_4EDA_BF3F_E5B5FACFAD54
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 8528fdd800752593ebad409badb18ea438866c19a82b524fe51038e980bf5d34
