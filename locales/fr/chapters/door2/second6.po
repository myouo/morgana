msgid "⟪k:0⟫(I basked in their terror.)"
msgstr "⟪k:0⟫(Je me suis réjoui de leur terreur.)"

#: scenario2:scenario2_CF810AEE_F1A6_4B2C_8B58_3FFE098C534E
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 4dcbb7b7a51ca274cac8257feaaf7c8f8f3342610d09c298bf64bc5848042b92
#. default-sha256: b9929d07310717e40ead07694e8ba6c0bb00dc1b28b944baa37bcf3560ba7159
msgctxt "scenario2:scenario2_CF810AEE_F1A6_4B2C_8B58_3FFE098C534E"
msgid "⟪k:0⟫(So why... ⟪k:1⟫Why do I not want you to find out?)"
msgstr "⟪k:0⟫(Alors pourquoi... ⟪k:1⟫Pourquoi est-ce que je ne veux pas que vous le sachiez ?)"

#: scenario2:scenario2_B9787E55_09F7_40B2_B99F_E1824044313A
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: cfcb561778dc40d0074f7b0e23fd5b59aa7440966944f2def5e9cdd577d1a407
#. default-sha256: 899f87d92ac95b47376f4b916842bbbf8223019c143102e253e07eb26b6ab5bd
msgctxt "scenario2:scenario2_B9787E55_09F7_40B2_B99F_E1824044313A"
msgid ""
"⟪k:0⟫(I don’t want you to know how many people I’ve tortured,⟪k:1⟫how many I’ve slaughtered, how "
"much blood I’ve imbibed...)"
msgstr ""
"⟪k:0⟫(Je ne veux pas que vous sachiez combien de personnes j’ai torturées,⟪k:1⟫combien j’en ai "
"massacré, combien de sang j’ai versé...)"

#: scenario2:scenario2_FF7D2F93_0EE1_4904_82BC_CFBF1E4C29EF
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 0a19e2b2e6b13de78e54b06ea6121eac1f0e205bffeb88372938d3c96afcfce2
