msgid "⟪k:0⟫(I ⟪k:1⟫enjoyed⟪k:2⟫ it.)"
msgstr "⟪k:0⟫(J’ai ⟪k:1⟫adoré⟪k:2⟫ le faire.)"

#: scenario2:scenario2_13329D0F_E001_4658_8979_1CED36B9A9DC
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 5c6db9d2edcc0fbcf980d45d2a84a3ec0de70683cd4eadf830d2ab2c924f8ccc
