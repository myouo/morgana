msgid "⟪k:0⟫⟪k:1⟫Do I appear to be afraid of you?"
msgstr "⟪k:0⟫⟪k:1⟫Ai-je peur, d’après vous ?"

#: scenario2:scenario2_819774A8_0F00_452F_8CA5_49691425E1DE
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: bb6af10abc8f9f97e018b11b528583b704f85e316acd12b73e12dd7b4445a7a8
