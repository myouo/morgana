msgctxt "scenario2:scenario2_B81F4DF4_2CAE_4BFB_9662_057572CF1458"
msgid "⟪k:0⟫(I wanted... ⟪k:1⟫for so long... ⟪k:2⟫to slaughter them...)"
msgstr "⟪k:0⟫(Je voulais... ⟪k:1⟫les massacrer... ⟪k:2⟫depuis si longtemps...)"

#: scenario2:scenario2_5AA9AE97_F7A2_4AFA_A2FD_3B7BBDA70572
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 73d2796fe8d12a054bb4a7509a890e46b2c8e8f8b23d20dd937d1540114b3056
