#: scenario2:scenario2_688A4793_C7AA_462A_9611_F83DFB13851F
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 5dab52683963e62201e3cfd0975cb8bd043470f10daa85cf22e66e83dd0a34b7
#. default-sha256: 9420d55b3cab32c31f1c2f884743d2e76f4b611ee098e07cd82da0b73b79a574
msgctxt "scenario2:scenario2_688A4793_C7AA_462A_9611_F83DFB13851F"
msgid "⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫⟪k:4⟫⟪k:5⟫⟪k:6⟫⟪k:7⟫⟪k:8⟫⟪k:9⟫⟪k:10⟫⟪k:11⟫⟪k:12⟫Several days passed by."
msgstr ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫⟪k:4⟫⟪k:5⟫⟪k:6⟫⟪k:7⟫⟪k:8⟫⟪k:9⟫⟪k:10⟫⟪k:11⟫⟪k:12⟫Plusieurs jours s’écoulèrent."

#: scenario2:scenario2_5A9D3DC6_28F0_486B_93BA_C817C90E1C9F
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 9d160cc70413258fd9c632145a5f8942e846bbadc0922535e9cc10a271edf244
#. default-sha256: f5afef2dc370ef29c9e915ca46e5df8bbcf0a61387253255e467da7e09efef1f
msgctxt "scenario2:scenario2_5A9D3DC6_28F0_486B_93BA_C817C90E1C9F"
msgid ""
"⟪k:0⟫As Bestia began to act more like a person, the mansion followed suit, slowly becoming more "
"habitable—⟪k:1⟫⟪k:2⟫though not yet back to its former glory."
msgstr ""
"⟪k:0⟫Plus Bestia se comportait comme une personne, plus le manoir reprenait vie et redevenait "
"progressivement habitable—⟪k:1⟫⟪k:2⟫ même s’il était loin de sa gloire d’antan."

#: scenario2:scenario2_ACFE5913_A744_4DEE_B2EA_51398CC5D283
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: cdfc57f3b66b7ff74e435af9d642ad2586aa44f41413e296c2f008076a336ef7
#. default-sha256: afa8b60851b6d013b684a394823b61e6047bc5bfdbcfae6e0889d12a36464679
msgctxt "scenario2:scenario2_ACFE5913_A744_4DEE_B2EA_51398CC5D283"
msgid "⟪k:0⟫No flowers grew in the garden, but neither were there weeds infesting it."
msgstr "⟪k:0⟫Aucune fleur ne poussait dans le jardin mais il n’y avait plus de mauvaise herbe."

#: scenario2:scenario2_B1167F3A_75E6_4D6A_9C89_AE907DFA03DA
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: b1ac4a5c2f9746ce74cbc6dad9d8f33ace0300ff01bbdd17f56cb87117c61c4c
#. default-sha256: 6b0bc1eb21c4e13becc924bd71fe95205864d8eb88e7dd507898bf1a0f41d4b8
msgctxt "scenario2:scenario2_B1167F3A_75E6_4D6A_9C89_AE907DFA03DA"
msgid ""
"⟪k:0⟫The dusty corridors, shattered windows, rust-covered kitchen gradually returned to their "
"proper states."
msgstr ""
"⟪k:0⟫Les couloirs poussiéreux, les fenêtres cassées, la cuisine couverte de rouille revinrent peu "
"à peu à leur état d’origine."

#: scenario2:scenario2_CF333379_324E_411C_8BA8_4A1292D3806C
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 06946cba09382016c94e6fe4799b85fed8a09a49b1e6ab05276306e68b3e82b8
#. default-sha256: b430b9fa3689c14ccabf0a98f8c3b2e54145d8f388a733ed28ef06dea3f1324e
msgctxt "scenario2:scenario2_CF333379_324E_411C_8BA8_4A1292D3806C"
msgid "⟪k:0⟫Bestia learned how to change his own clothes, and how to draw a bath."
msgstr "⟪k:0⟫Bestia apprit à changer de vêtement et à préparer un bain."

#: scenario2:scenario2_D5BA30A1_9184_4D30_8872_75DAB8B5F415
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 264007c664c75663138ad1b1be4d284d19247f65bb740ffd1f4358764db3afc6
#. default-sha256: 1587057fd8b7fe1834980ada8ef4f3c2aae462c340a104614b1458b2435ef72b
msgctxt "scenario2:scenario2_D5BA30A1_9184_4D30_8872_75DAB8B5F415"
msgid ""
"⟪k:0⟫No longer did I have to wait on him hand and foot; he could take care of a number of things "
"all by himself."
msgstr ""
"⟪k:0⟫Je n’avais plus besoin de tout lui servir sur un plateau d’argent ; il pouvait s’occuper de "
"plus en plus de choses seul."

#: scenario2:scenario2_D79B220E_57C9_4DED_A57C_2075A463BBEB
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: c9f16271a3411f2223b4f106caf9ed86ba8da0dc36f976f4d372ca2d1ab82c15
#. default-sha256: 3ff3a30177bbb1a1c2c971b338a7f946fd69b4e4d3cf96c3ffdc02186040e334
msgctxt "scenario2:scenario2_D79B220E_57C9_4DED_A57C_2075A463BBEB"
msgid "⟪k:0⟫What we lacked for food, he acquired from the forest."
msgstr "⟪k:0⟫Quand on manquait de nourriture, il en chassait en forêt."

#: scenario2:scenario2_7D2B203C_1FCD_46CD_A028_6F38D55124CA
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: c898d6d25581a71797c5bd71054a33f32c91f2084fe49141acd6007f4bf95d1c
#. default-sha256: e95c50d02d9bb1f118131de53a71cce55d3b45a786fa2eb946cce3f6736c32a3
msgctxt "scenario2:scenario2_7D2B203C_1FCD_46CD_A028_6F38D55124CA"
msgid ""
"⟪k:0⟫Never did he go to purchase supplies from the village; rather, he captured hares and "
"gathered herbs hidden in the overgrowth."
msgstr ""
"⟪k:0⟫Il n’allait jamais acheter de provisions au village ; il préférait capturer des lièvres et "
"récolter des herbes."

#: scenario2:scenario2_4A1DA3C5_BFC4_4B16_8A65_3C6D191A453C
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 3fd1959f52400e17ba33175fa4e8f061784f333a8ba508ec9cc7b6c713fe350d
#. default-sha256: af8209f792a67a915a909aec2ff7ff6475572d300bede7489cf34c896f292f10
msgctxt "scenario2:scenario2_4A1DA3C5_BFC4_4B16_8A65_3C6D191A453C"
msgid "⟪k:0⟫They were days without incident."
msgstr "⟪k:0⟫Les jours défilaient sans incident."

#: scenario2:scenario2_498053BB_5921_4AC8_8CEE_B4D7B6C92591
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: e83a3fa583a839ba3f52fd3794dae7e825ea59c6814719d2f62c2d6944c399de
#. default-sha256: 0779c35c51d3bbe6b6d2cb9a4cfa4bdf4d8165d773b2fe4e7396808096d36226
msgctxt "scenario2:scenario2_498053BB_5921_4AC8_8CEE_B4D7B6C92591"
msgid ""
"⟪k:0⟫And though such a life may be want for excitement,⟪k:1⟫peace is something that you mustn’t "
"take for granted."
msgstr ""
"⟪k:0⟫Et, bien qu’une telle vie puisse sembler terne,⟪k:1⟫la paix est quelque chose qu’on ne doit "
"jamais prendre pour acquis."

#: scenario2:scenario2_D3B91922_7A77_4BCF_8186_25A36F31B2A8
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 4faf8283de30bed32baa37b3bc7041417a12cd6786e83c51cabbe82be0f0fc17
#. default-sha256: a4100a20e25a17fd1711a1bf31a090c6a5408a504c0548e85cf74052822585fd
msgctxt "scenario2:scenario2_D3B91922_7A77_4BCF_8186_25A36F31B2A8"
msgid ""
"⟪k:0⟫Those who have it cast it aside, finding the leisurely flow of time dull.⟪k:1⟫⟪k:2⟫Only "
"those who have never experienced it truly know how precious it is."
msgstr ""
"⟪k:0⟫Quand on mène une vie paisible, on la rejette et on trouve assommant le lent écoulement du "
"temps.⟪k:1⟫⟪k:2⟫Seuls ceux qui ne l’ont jamais connue savent vraiment combien elle est précieuse."

#: scenario2:scenario2_182E1A71_E6E2_42FE_8B96_352D86C0011C
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: c04b9fcdb73ed69043dcb2f4f0161f4665c70947eef2e1d341a75558be0b150e
#. default-sha256: 7450607b3e65e5b17cc4f91a66d00940b13866a1fd651f6ad7aebdceddce8942
msgctxt "scenario2:scenario2_182E1A71_E6E2_42FE_8B96_352D86C0011C"
msgid "⟪k:0⟫Bestia appeared to be content.⟪k:1⟫⟪k:2⟫He wore an expression of solitary serenity."
msgstr ""
"⟪k:0⟫Bestia paraissait satisfait.⟪k:1⟫⟪k:2⟫Dans sa solitude, il arborait une expression de "
"sérénité."

#: scenario2:scenario2_ABF7C6D5_59BA_4D62_B4E5_B76C6FDAE414
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 63f672d24af08ff0b1fe5713ac57e2fb72f15f3fd0796c40260a179a672b324d
#. default-sha256: e639ed5d4caa7a4316ad5e91439488e9b3f67944f6c21f11e4ebe65dd635b52a
msgctxt "scenario2:scenario2_ABF7C6D5_59BA_4D62_B4E5_B76C6FDAE414"
msgid "⟪k:0⟫⟪k:1⟫Someone...⟪k:2⟫⟪k:3⟫Is anyone there?!"
msgstr "⟪k:0⟫⟪k:1⟫Quelqu’un...⟪k:2⟫⟪k:3⟫Est-ce qu’il y a quelqu’un ?!"

#: scenario2:scenario2_D8049308_610B_4CC1_946D_875B4B2BC5C1
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 2d36b816c17bae279bc2316fc8a8fd6c19d3a4979cbf25a969ccab6de6f55cb8
#. default-sha256: 3cb49c68d82b84466089a75d39267acac6189ec501922704b6ae1a8a6e5f8ecf
msgctxt "scenario2:scenario2_D8049308_610B_4CC1_946D_875B4B2BC5C1"
msgid "⟪k:0⟫And then one day, a crack formed in the uneventful tranquility."
msgstr "⟪k:0⟫Et puis un jour, une fissure se forma et vint craqueler cette tranquillité apparente."

#: scenario2:scenario2_BDA3B870_0269_45BA_B4DC_4E13089C6B6B
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 29e6cc151c2d2d19fe599722ca606dcbfc0679a578108dede233749be9faf6fc
#. default-sha256: 8dd8a4d5ef6d555e9a36cc093a8f441395f95334cbfa61967c7e3737bef47822
msgctxt "scenario2:scenario2_BDA3B870_0269_45BA_B4DC_4E13089C6B6B"
msgid ""
"⟪k:0⟫Is anyone... ⟪k:1⟫in there?⟪k:2⟫⟪k:3⟫Could you part with some food?⟪k:4⟫⟪k:5⟫I don’t need "
"much..."
msgstr ""
"⟪k:0⟫Est-ce qu’il y a... ⟪k:1⟫quelqu’un ?⟪k:2⟫⟪k:3⟫Est-ce que vous pouvez me donner à manger ?"
"⟪k:4⟫⟪k:5⟫Pas grand-chose..."

#: scenario2:scenario2_33F944EF_4505_43BF_B4AF_F877BE36926E
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 1ae1475a16da169ce4de8f779b20639aa772982c056b66933d9f25153aeba58f
#. default-sha256: 48f41697b22461c825c2f67ac00db3078091b23a05c42741f58ec0ffc02c435d
msgctxt "scenario2:scenario2_33F944EF_4505_43BF_B4AF_F877BE36926E"
msgid "⟪k:0⟫............"
msgstr "⟪k:0⟫............"

#: scenario2:scenario2_CAD05A95_0B56_410E_BC7C_F06F9807B5D7
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 7c9427c15ffb86006a9cc8c0856f81549f3c79a47bd6b11a898b807f0e8e8574
#. default-sha256: 0a034ea45d25b94c8109c811c51773c9eaa4bfdb2729ab56ba918a0149467cfc
msgctxt "scenario2:scenario2_CAD05A95_0B56_410E_BC7C_F06F9807B5D7"
msgid "⟪k:0⟫⟪k:1⟫Some food and water...⟪k:2⟫⟪k:3⟫Just a little... ⟪k:4⟫that’s all I need."
msgstr ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫À⟪k:3⟫ manger et à boire...⟪k:4⟫⟪k:5⟫Juste un peu... ⟪k:6⟫c’est tout ce que je "
"demande."

#: scenario2:scenario2_EE3A043A_8F3C_453F_98D4_DF29A893202B
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 881ace1fe44deef1e8041d0f4f50fdcbb93a0c4158ee6a58fc2744f6632f4e81
#. default-sha256: b1e6e556e5e200e695e6894fe5d7942ef2b48b51260c5bd8161fdace6a5e7b22
msgctxt "scenario2:scenario2_EE3A043A_8F3C_453F_98D4_DF29A893202B"
msgid "⟪k:0⟫Bestia looked over at me, as if seeking my aid."
msgstr "⟪k:0⟫Bestia se tourna vers moi comme pour me demander de l’aide."

#: scenario2:scenario2_E65CAEF0_5F18_4805_8B03_1F48719B3E39
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 3c7d6e5c095807b5c0cb69408b51058ae2a2ce417ae0ef41a69761621341cf3a
#. default-sha256: 753daad8bc6d364e1993035f8b44b52c7edd912c732f179af4853386c9ffdda3
msgctxt "scenario2:scenario2_E65CAEF0_5F18_4805_8B03_1F48719B3E39"
msgid "⟪k:0⟫Ironic, no? It was the visitor who was truly in need of aid."
msgstr "⟪k:0⟫Ironique, non ? Celui qui avait vraiment besoin d’aide, c’était le visiteur."

#: scenario2:scenario2_D5B67BE0_04FF_4A18_A5C4_57489152C1D5
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 22ba7a58cbe4d313c484cae53a34e4c8119ae6f54a25bc108705ed58823accf1
#. default-sha256: 2a8c901dc469e6b5f2f03528e4661cdc3321b634615600d7b7ab6336dd4e490c
msgctxt "scenario2:scenario2_D5B67BE0_04FF_4A18_A5C4_57489152C1D5"
msgid ""
"⟪k:0⟫I pondered it for a few moments, deciding that I could not simply turn away someone calling "
"upon the mansion."
msgstr ""
"⟪k:0⟫Je pesai le pour et le contre quelques instants et décidai que je ne pouvais tout simplement "
"pas tourner le dos à quelqu’un qui se présentait au manoir."

#: scenario2:scenario2_3568FBEE_CF43_4B9F_9C82_B064DA91EB44
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 9a6bb22f66c2b07ba095a1a49e2d0c9f4015a842840b17db130c5b02d8943dfb
#. default-sha256: 5fa64223458b2602c8948612ddf1a1d6633b2094393b6f286aa9c5b567c1c42b
msgctxt "scenario2:scenario2_3568FBEE_CF43_4B9F_9C82_B064DA91EB44"
msgid ""
"⟪k:0⟫Had Bestia ordered me to not let him in, I would have followed his instructions, but he said "
"nothing."
msgstr ""
"⟪k:0⟫Si Bestia m’avait ordonné de ne pas le faire entrer, j’aurais suivi ses ordres, mais il ne "
"disait rien."

#: scenario2:scenario2_904ED7C5_5FA3_4C11_A82D_51289CA1420B
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: b537a9197b19d2fe4e267835d2c6e2f06ddb7bdd5741079794e60b059bbb6c12
#. default-sha256: 2d3ff495f334eb263f36e075a72bc25c92021f18c23089c4d527f1a42fae132d
msgctxt "scenario2:scenario2_904ED7C5_5FA3_4C11_A82D_51289CA1420B"
msgid ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫⟪k:4⟫⟪k:5⟫⟪k:6⟫⟪k:7⟫⟪k:8⟫Oh, thank God... ⟪k:9⟫someone’s here.⟪k:10⟫⟪k:11⟫I "
"was afraid it was deserted..."
msgstr ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫⟪k:4⟫⟪k:5⟫⟪k:6⟫⟪k:7⟫⟪k:8⟫Ah, Dieu merci... ⟪k:9⟫il y a quelqu’un.⟪k:10⟫⟪k:11⟫"
"J’avais peur que ce ne soit à l’abandon..."

#: scenario2:scenario2_33C84E7E_AB3E_40AA_8E38_00C77DB2E306
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: bc6e928b9c01670f3f63c228c6b76c22c58dd285eeb08d64bbaf33ce85d5ba8a
#. default-sha256: 4c8e1a3dcfe37bd35ea68ab14f7136322245665442a1b18ba9448a1749378271
msgctxt "scenario2:scenario2_33C84E7E_AB3E_40AA_8E38_00C77DB2E306"
msgid "⟪k:0⟫............⟪k:1⟫⟪k:2⟫You said you were in need of sustenance?"
msgstr "⟪k:0⟫............⟪k:1⟫⟪k:2⟫Vous avez dit avoir besoin de vivres ?"

#: scenario2:scenario2_25162922_AE76_445C_BB3B_A26C45CE57B3
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 3d7afe767dcf5b392dbc8ca270fe7fcd30533d24aca3393923de8a36be2f523d
#. default-sha256: 9c9b603a90efb22e7eac79535f22440c4704e629e85a5f1b45ce61a293f30502
msgctxt "scenario2:scenario2_25162922_AE76_445C_BB3B_A26C45CE57B3"
msgid ""
"⟪k:0⟫Y-⟪k:1⟫Yes...⟪k:2⟫⟪k:3⟫It doesn’t have to be much.⟪k:4⟫⟪k:5⟫Anything to quench this thirst..."
msgstr "⟪k:0⟫O-⟪k:1⟫Oui...⟪k:2⟫⟪k:3⟫Pas beaucoup.⟪k:4⟫⟪k:5⟫De quoi apaiser ma soif..."

#: scenario2:scenario2_4147CBC7_826A_4542_ACEC_32037E2B24DE
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 7e2baf3d13eac9795a30421098e61d9434d068740f49913504af185f17af5cb3
#. default-sha256: 735f2ac74cf401f5ddb49bd1aee6886edd4953cda85c04ce8d926ffa94960769
msgctxt "scenario2:scenario2_4147CBC7_826A_4542_ACEC_32037E2B24DE"
msgid "⟪k:0⟫I got lost, and it’s been several days..."
msgstr "⟪k:0⟫Je me suis perdu, et ça fait plusieurs jours que..."

#: scenario2:scenario2_F9CF7669_9227_4694_914C_94455E2A07A0
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 2db8102a21ed63f6f9d21699c2d12e6d38dd01037a4c36bdb8eefea166fc7834
#. default-sha256: 3203756cfb44b2f7837c5f81b0cd2d4c9e741d5959a63669b01fdeb297fb1c0b
msgctxt "scenario2:scenario2_F9CF7669_9227_4694_914C_94455E2A07A0"
msgid "⟪k:0⟫Give me a few minutes, I will find—"
msgstr "⟪k:0⟫Attendez quelques instants— je vais voir"

#: scenario2:scenario2_AC9BD4EF_8269_46C5_995F_F13494636F77
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: d90a550431e5d41e91fd15a525d9265c06dab2d3116171199213d4dca774fe0d
