msgctxt "scenario6:scenario6_7F6217C6_D418_4F30_BA21_F95C9C9613D5"
msgid "⟪k:0⟫Make them enjoy their stay."
msgstr "⟪k:0⟫Fais en sorte qu’ils apprécient leur séjour."

#: scenario6:scenario6_70266F3D_E042_48CB_AB84_325DB04F15EF
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 17361bc855b04e95fb445b50bc11e8c2806682d9e65b9ce8f6c64051757dff78
