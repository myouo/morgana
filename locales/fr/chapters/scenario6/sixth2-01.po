msgid ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫As I am sure you have already guessed, this man was the Rhodes siblings’ "
"grandfather."
msgstr ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫Comme vous devez déjà vous en douter, cet homme était le grand-père des enfants "
"Rhodes."

#: scenario6:scenario6_A8FE49B6_A49E_4789_A3D0_472E211B2CDE
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 7f016be41f41fbb296ab853d4840ba672260d0ea1084825fafd41c0ead3ae187
