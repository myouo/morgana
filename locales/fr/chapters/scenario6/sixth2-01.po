msgid "⟪k:0⟫Work? What kind of work?"
msgstr "⟪k:0⟫Travail ? Quel genre de travail ?"

#: scenario6:scenario6_D477F6A9_07C6_4A3B_B245_F7D67FF2FA52
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 00810a9b092096ec18c38d0fff0cf31c1ee61b16361fb3c41f3ef9090f01ec24
