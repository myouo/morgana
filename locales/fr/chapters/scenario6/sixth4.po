msgid "⟪k:0⟫⟪k:1⟫⟪k:2⟫I am right here, sir.⟪k:3⟫⟪k:4⟫Is something the matter?"
msgstr "⟪k:0⟫⟪k:1⟫⟪k:2⟫Je suis juste là, monsieur.⟪k:3⟫⟪k:4⟫Que se passe-t-il ?"

#: scenario6:scenario6_03232306_DBE0_4747_B3FA_10B5730DBEB3
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 81df2b1cfb706abb7af8c20c383bf5bbf2997ea6269a7a59827d86b45e9dcd2d
