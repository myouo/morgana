msgid "⟪k:0⟫⟪k:1⟫⟪k:2⟫Hey! Hey, head maid!⟪k:3⟫⟪k:4⟫Get out here!"
msgstr "⟪k:0⟫⟪k:1⟫⟪k:2⟫Hé ! Hé, gouvernante !⟪k:3⟫⟪k:4⟫Venez par ici !"

#: scenario6:scenario6_B9FFC48D_8468_4417_89FD_3726CB41A310
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 54e03f075cee71a182ff60027190d34b11ab52e936251fdcd5d7881a82202899
