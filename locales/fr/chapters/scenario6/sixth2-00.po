#: scenario6:scenario6_14D5B97B_1F9B_4876_AF46_557077243F79
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 4118b05342561e60457c2d7889059b14fc24656429c9fda47f029eae91a330d4
#. default-sha256: 27ecdb534ed296192295273c5f0096228228e769eee20094c886b957168f0b2e
msgctxt "scenario6:scenario6_14D5B97B_1F9B_4876_AF46_557077243F79"
msgid "⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫⟪k:4⟫............"
msgstr "⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫⟪k:4⟫............"

#: scenario6:scenario6_C90C966B_0C56_4001_9E0A_B23960B14CFB
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 5bc20fdfa041681012230d82385daac9eb8a37604a405290178531db12bf3ceb
#. default-sha256: 61e126845e5b5af8cc4c1235bf5000873b5e2eb91149b042b5f36d9d3a16e188
msgctxt "scenario6:scenario6_C90C966B_0C56_4001_9E0A_B23960B14CFB"
msgid ""
"⟪k:0⟫I felt like I had stepped into Heaven on Earth.⟪k:1⟫⟪k:2⟫I know it sounds melodramatic, so "
"please don’t laugh."
msgstr ""
"⟪k:0⟫J’avais l’impression d’entrer au Paradis.⟪k:1⟫⟪k:2⟫Ça peut sembler mélodramatique, je le "
"sais, mais, s’il vous plaît, ne riez pas."

#: scenario6:scenario6_0DA68A78_8B28_414F_AC1B_6DC4D5DE8857
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 9b94415a32bb95a71cc105ac6da34bc5a9ca0ebb559d8971f3754089e50d1c20
#. default-sha256: e85aa751b13bfb010a39d4a7617cf8fb83bcd2c5a0549e9c4ddd063b3d740c84
msgctxt "scenario6:scenario6_0DA68A78_8B28_414F_AC1B_6DC4D5DE8857"
msgid "⟪k:0⟫⟪k:1⟫I wondered where I was, of course, but I neither shouted nor jumped in surprise."
msgstr ""
"⟪k:0⟫⟪k:1⟫Je me demandais où j’étais, bien entendu, mais je ne criai pas, je ne sursautai pas."

#: scenario6:scenario6_5AF7073A_DE35_4B5E_8F2F_E3EF7A7C5BEB
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 8a8ea63c09c949475d5e58dbc8f549eb5799abe8ac68ce53838c6d011bcb0f8f
#. default-sha256: f0a6b31dc85277d51b53ff390ae6ff030a24c6bc6ffe1df83a9305347cf2eda3
msgctxt "scenario6:scenario6_5AF7073A_DE35_4B5E_8F2F_E3EF7A7C5BEB"
msgid ""
"⟪k:0⟫Instead, I found myself accepting of my circumstances, as unnatural as they might have been."
msgstr ""
"⟪k:0⟫Non, aussi étrange que cela puisse paraître, j’embrassai ma nouvelle situation, comme si "
"c’était naturel."

#: scenario6:scenario6_84026324_DC24_4E9D_A5A1_ECEADDA41B4D
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 012265790dbead71e23adc78fd9c9ffdf25614325a1db111256cc194462fa696
#. default-sha256: 2d15fa1fceb7c6ee3f61aafa65c540dbeed9c20c57dadafcae84db2c4276501d
msgctxt "scenario6:scenario6_84026324_DC24_4E9D_A5A1_ECEADDA41B4D"
msgid ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫E⟪k:4⟫⟪k:5⟫⟪k:6⟫gad⟪k:7⟫... ⟪k:8⟫could this road be any bloody worse?⟪k:9⟫"
"⟪k:10⟫It’s in dire need of paving, on top of everything else..."
msgstr ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫Mon⟪k:4⟫⟪k:5⟫Dieu... ⟪k:6⟫Sapristi, cette route ne pourrait pas être pire !"
"⟪k:7⟫⟪k:8⟫Elle aurait désespérément besoin d’être pavée, par-dessus le marché..."

#: scenario6:scenario6_2AE98630_DED7_4A51_9FC8_3E63CEDD1BE2
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: d2b2242dd6dbf6e04e1d52e296ebcb9b22ed4815d0ec0b991319a2ef541ec7dc
#. default-sha256: 62cf99fbf0aea4e38b1fa4f78ba2a544a841a7df1280036c98d5955de5af1b96
msgctxt "scenario6:scenario6_2AE98630_DED7_4A51_9FC8_3E63CEDD1BE2"
msgid "⟪k:0⟫(He’s speaking a different language...)"
msgstr "⟪k:0⟫(Il ne parle pas la même langue...)"

#: scenario6:scenario6_AD7BDF71_DE74_4C0B_A019_0F4BC66C5C25
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: a29bf67150668c401d480135ab30c0c7c52ea4a02cedbaeb2edc944ec135cdfd
#. default-sha256: d288ba18f01cb16e706f87f0d5b2acc26dc90b40487eeb8bd26597633862cf03
msgctxt "scenario6:scenario6_AD7BDF71_DE74_4C0B_A019_0F4BC66C5C25"
msgid ""
"⟪k:0⟫The middle-aged man approached me.⟪k:1⟫⟪k:2⟫From his attire and the way he held himself,⟪k:3⟫"
"he appeared to be upper-class."
msgstr ""
"⟪k:0⟫L’homme d’âge moyen s’approcha de moi.⟪k:1⟫⟪k:2⟫D’après ses vêtements et sa façon de se "
"tenir,⟪k:3⟫il semblait appartenir à la haute société."

#: scenario6:scenario6_D8A6A93F_8C97_4C40_BE00_67411E6A59E5
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 8978572b629b1ee929bc5ea5ceb871522606b5f1b8b0467202451292693dd9ba
#. default-sha256: 99dccce7ba32217d99955315b52423c0c0dc5e031449559d080568ebf211df8b
msgctxt "scenario6:scenario6_D8A6A93F_8C97_4C40_BE00_67411E6A59E5"
msgid ""
"⟪k:0⟫However, the words coming out of his mouth were not in the language I had grown up speaking."
msgstr ""
"⟪k:0⟫Pourtant, les mots qui sortaient de sa bouche n’étaient pas les mêmes que ceux que j’avais "
"utilisés en grandissant."

#: scenario6:scenario6_84959456_0539_4B5D_AF25_55E7A84A63C5
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 5c9553ba84b3c09139dced30b34c54756be2c4bde0ed36c04634484f2cd5aa33
#. default-sha256: 8a3b53709e1aa66a2d40e1291defb5b5d9459656fb07cec02e3a6971b023fe88
msgctxt "scenario6:scenario6_84959456_0539_4B5D_AF25_55E7A84A63C5"
msgid ""
"⟪k:0⟫And the longer I stood there staring at him absentmindedly, the more incredulous he became."
msgstr "⟪k:0⟫Et plus je restais là à le regarder d’un air absent, plus sa perplexité augmentait."

#: scenario6:scenario6_8ADCDDB8_5600_41C6_A1AF_7B1F0729A20A
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 7cd533309fde0a8658cc6db37d0e18270b9450a6a5c05c6d90c819cc9dfc1e43
#. default-sha256: a03c173739631e3183df9deff36ab7ba83d57c958e5ec2f0c98672a6d3221ce2
msgctxt "scenario6:scenario6_8ADCDDB8_5600_41C6_A1AF_7B1F0729A20A"
msgid "⟪k:0⟫Fortunately, I suppose, I was able to understand bits and pieces of what he had said."
msgstr ""
"⟪k:0⟫Par chance, j’imagine, j’étais en mesure de comprendre çà et là des bribes de ce qu’il "
"disait."

#: scenario6:scenario6_C0FF212D_9A8A_4FD9_B75B_B36E08296C84
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: f747838d077885679d2841a8345aed7d503e972e2a4839e3e5bf1681d290bea8
#. default-sha256: 4a34aecc439c371d91462bc9141b11dde79bb5c6d348ffe68781c6e46d5057f4
msgctxt "scenario6:scenario6_C0FF212D_9A8A_4FD9_B75B_B36E08296C84"
msgid ""
"⟪k:0⟫As merchants in the capital, my family did business with people from other countries, and as "
"a result, I had learned a handful of words."
msgstr ""
"⟪k:0⟫Comme je venais d’une famille de marchands de la capitale, habitués à faire affaire avec des "
"étrangers, j’avais par conséquent appris quelques mots utiles."

#: scenario6:scenario6_AC59AA1D_9A37_43DA_B6EB_7C8511AFCA3E
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: ede44242aab61deff51531e6697be1e159f047e5b5a3fc883cf62a060363a53f
#. default-sha256: 2600e1a3b49f4bc3eb10b32c4bcfaa825127a21959d149cc5a5b437af535dec8
msgctxt "scenario6:scenario6_AC59AA1D_9A37_43DA_B6EB_7C8511AFCA3E"
msgid ""
"⟪k:0⟫The problem was... ⟪k:1⟫it had been so long ago, I had no confidence whatsoever in my "
"ability to hold a conversation."
msgstr ""
"⟪k:0⟫Mais le problème, c’est que... ⟪k:1⟫depuis le temps, je n’avais plus aucune confiance dans "
"ma capacité à tenir une conversation."

#: scenario6:scenario6_DE67DD51_9738_4809_AAEF_55F0D3BC8BCA
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 1051b5229d12df88e9e9ecbfecf097de8f1a52f5451fc7a7c180fa949b84c929
#. default-sha256: cd0912d3991b755388ff659b46f1c7fc71f80ea8dfa592bca46294309793d56a
msgctxt "scenario6:scenario6_DE67DD51_9738_4809_AAEF_55F0D3BC8BCA"
msgid "⟪k:0⟫I— ⟪k:1⟫⟪k:2⟫I am... ⟪k:3⟫I am a servant..."
msgstr "⟪k:0⟫Je—⟪k:1⟫⟪k:2⟫Je suis... ⟪k:3⟫Je suis une servante..."

#: scenario6:scenario6_8FC453C1_D9B9_4A17_85F8_0BED6E133217
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 0e929b5d17992ac20f777e7989756b0acfe1f8f2159a6d500edebc5f25c2b079
#. default-sha256: 87b5401a227b7bb8a87a9a81cb44d442954732eb6f8a8fed6a4441ddbc728834
msgctxt "scenario6:scenario6_8FC453C1_D9B9_4A17_85F8_0BED6E133217"
msgid ""
"⟪k:0⟫...You weren’t informed?⟪k:1⟫⟪k:2⟫Bloody hell. Off to a great start, I see.⟪k:3⟫⟪k:4⟫Well, "
"what can you do, I guess..."
msgstr ""
"⟪k:0⟫...On ne vous a rien dit ?⟪k:1⟫⟪k:2⟫Nom de nom. Je vois qu’on est bien parti.⟪k:3⟫⟪k:4⟫Bon, "
"vous y pouvez rien, hein..."

#: scenario6:scenario6_085A38AC_6F3D_4699_981C_C0B7E83EE3E8
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 6e5fcdb32904a0809e04a81b7e962698cc16c02508281c48f4f0dd6db9b1869d
#. default-sha256: 6eb96334bef7d20b74f8e97201a751faf42afbb1e8137c3b7f89240b0ffe46ae
msgctxt "scenario6:scenario6_085A38AC_6F3D_4699_981C_C0B7E83EE3E8"
msgid "⟪k:0⟫He was also the first person I served under as the Maid."
msgstr "⟪k:0⟫Ce fut aussi la première personne que je servis sous l’identité de la Servante."

#: scenario6:scenario6_7B5A3137_2B46_4EC5_8D88_DAFFE5D554E3
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 89ba7c63c75ddbf7a8910284681b89dd21038c7d684cc2c3dd5039e8b1501269
#. default-sha256: e9d8704a906baf6891594b6ef5e650ed0bf2b69afe4c8db55155d96aca8b1665
msgctxt "scenario6:scenario6_7B5A3137_2B46_4EC5_8D88_DAFFE5D554E3"
msgid ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫⟪k:4⟫⟪k:5⟫⟪k:6⟫⟪k:7⟫⟪k:8⟫For a member of an esteemed noble family, Hayden was "
"a bit on the eccentric side."
msgstr ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫⟪k:4⟫⟪k:5⟫⟪k:6⟫⟪k:7⟫⟪k:8⟫Hayden avait beau être le membre d’une famille noble "
"estimée, il était un brin excentrique."

