#: scenario6:scenario6_9A86FC9B_89CD_40AF_AC2D_F93A8A50470C
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: a5fc298debed5f88db172bf799f1e16ccbdaae5c47c8fa22203d553d3ce5f894
#. default-sha256: fc085b4235a86f557c29c49f31ca63de3af67461cd234a322458d764b0e63fe4
msgctxt "scenario6:scenario6_9A86FC9B_89CD_40AF_AC2D_F93A8A50470C"
msgid ""
"⟪k:0⟫But it didn’t matter if it was all an illusion; ⟪k:1⟫the gentle breeze blowing in through "
"the window felt wonderful."
msgstr ""
"⟪k:0⟫Mais même si tout n’était qu’illusion, cela n’avait pas d’importance ; ⟪k:1⟫la douce brise "
"qui soufflait par la fenêtre me faisait un bien fou."

#: scenario6:scenario6_2BB1070F_5121_4B4C_87C2_E5392817163A
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 27c3d768894004c9593b4459bf8736070927476728f065a19f13ce91d255892c
#. default-sha256: 1ec9e8a181e0dd45da6d1e7d13d77eefb8ecb32affc2f41ba8c446b09ae145c3
msgctxt "scenario6:scenario6_2BB1070F_5121_4B4C_87C2_E5392817163A"
msgid ""
"⟪k:0⟫The smell of grass, the chirping of birds, the glistening blue sky...⟪k:1⟫⟪k:2⟫it was like a "
"thousand memories rushing back all at once,⟪k:3⟫and it brought tears to my eyes."
msgstr ""
"⟪k:0⟫L’odeur de l’herbe, le gazouillis des oiseaux, le bleu du ciel qui scintille...⟪k:1⟫ un "
"millier de souvenirs revenaient précipitamment à la surface, tous en même temps, et j’en eus les "
"larmes aux yeux."

#: scenario6:scenario6_FEAE7690_F01A_4749_B284_1BBFF2039512
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: d5acb22c1c0b8598f5a1a3aac44e254a6ce8b947ebf403db9070d737edc7acbe
#. default-sha256: d2ee0cc01dd4139c12e1b325ad57dbe0c00f3e23e26489cd87d7352bea6ff242
msgctxt "scenario6:scenario6_FEAE7690_F01A_4749_B284_1BBFF2039512"
msgid ""
"⟪k:0⟫And as she always did, the witch’s voice crushed my elation,⟪k:1⟫dragging me back to reality."
msgstr ""
"⟪k:0⟫Et comme à son habitude, la voix de la sorcière vint gâcher mon allégresse et me ramena à la "
"réalité."

#: scenario6:scenario6_F4C5E076_10F9_423D_AE33_EDC7C998E390
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: c2cdd83ea8c3b412bc8406ba5bc543b91da1c774221b0e45d9dca7473d2ff60e
#. default-sha256: a772a8aa152550bc42bfcf55fa3a48f407cda6c243f777c8b7d10529c1b82e5a
msgctxt "scenario6:scenario6_F4C5E076_10F9_423D_AE33_EDC7C998E390"
msgid "⟪k:0⟫for it was that moment that began my true decline."
msgstr "⟪k:0⟫car c’est à ce moment-là que commença mon vrai déclin."

#: scenario6:scenario6_24048DAB_589E_445E_9473_514B697F5F20
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 07c28c052c3f482f675f9dd5856e7df6fbfc13b0382e67aa5b520c81e0712ab1
#. default-sha256: 40a8afd175a0caf3bd731baaa5ae08cc08cdaf7ceac561ea998f41160d0f42ef
msgctxt "scenario6:scenario6_24048DAB_589E_445E_9473_514B697F5F20"
msgid ""
"⟪k:0⟫Have you already forgotten?⟪k:1⟫Oh, good heavens... ⟪k:2⟫Do you have your head on straight, "
"my dear?"
msgstr ""
"⟪k:0⟫As-tu déjà oublié ?⟪k:1⟫Oh, mon Dieu... ⟪k:2⟫As-tu toujours la tête sur les épaules, ma "
"chère ?"

#: scenario6:scenario6_9D80C2BC_6E8A_4074_B8A5_966D67262FB5
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 35c5627c552402afbbbfae219dfdda44ca9a041209d1a24b63be2f89c74409b5
