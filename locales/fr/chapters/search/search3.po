msgctxt "search:search_3559D7AC_CF00_3609_7196_1CA18989ADC0"
msgid "⟪k:0⟫For centuries, as a matter of fact."
msgstr "⟪k:0⟫Depuis des siècles, en fait."

#: search:search_140202FB_9473_4BAF_BFD0_E32CA5DCC3E3
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: d126030f6cef75da800fa4aa6f768689e477933f3a1a40c7fd6be8e0bfbc7c6a
