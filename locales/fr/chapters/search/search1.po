msgctxt "search:search_70781000_740E_41B0_9E28_0F14D836233E"
msgid ""
"⟪k:0⟫⟪k:1⟫You look like you’ve just seen a ghost!⟪k:2⟫⟪k:3⟫Hey now! Come on, don’t turn away!"
msgstr ""
"⟪k:0⟫⟪k:1⟫On dirait qu’tu viens de voir un fantôme !⟪k:2⟫⟪k:3⟫Hé oh, c’est bon ! T’en va pas !"

