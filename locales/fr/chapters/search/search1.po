msgctxt "search:search_51712C12_CBA0_4DDD_A7DB_6DCDE8268617"
msgid "⟪k:0⟫⟪k:1⟫The painting sounded rather high-spirited."
msgstr "⟪k:0⟫⟪k:1⟫Le tableau semble plein d’entrain."

#: search:search_E8290194_3DEE_4D82_BDBC_11AEFAFF25F5
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
