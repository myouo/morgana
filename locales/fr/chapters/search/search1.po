msgctxt "search:search_F6A058C8_2CC7_42DB_83AB_176712F953A8"
msgid "⟪k:0⟫⟪k:1⟫Yep, you got it.⟪k:2⟫⟪k:3⟫I’m the one talkin’ to you."
msgstr "⟪k:0⟫⟪k:1⟫Ouais, t’as pigé.⟪k:2⟫⟪k:3⟫C’est moi qui t’parle."

#: search:search_0E103304_6ED7_4229_9C7D_927531562BB9
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 83588f3ab0a537d852244dd212466b4a2de5dc0bf8c14beb0d588018f5f1d2b7
#. default-sha256: 36f0c060b43f764478893e1d4d546ebeb6d50e85edc8d7303942b37861b4572d
msgctxt "search:search_0E103304_6ED7_4229_9C7D_927531562BB9"
msgid "⟪k:0⟫The voice was coming from within the painting."
msgstr "⟪k:0⟫La voix vient de l’intérieur du tableau."

#: search:search_D919F848_50E7_4423_9AA1_62B2AEE0FA02
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 12ae1ee5285b7971aa6476c69c1db68d17ad9d2e8c1b191d202d0b3d1f7466e2
#. default-sha256: b8ef6ec91d7b2a5d26ad4518f51c9b68b7ae9935f076f6388d66a538795e0917
msgctxt "search:search_D919F848_50E7_4423_9AA1_62B2AEE0FA02"
msgid ""
"⟪k:0⟫When ⟪k:1⟫You⟪k:2⟫the Departed⟪k:3⟫ had passed by this wall on ⟪k:4⟫Your⟪k:5⟫his⟪k:6⟫ way to "
"the third door,⟪k:7⟫⟪k:8⟫⟪k:9⟫ ⟪k:10⟫a magnificent landscape painting had been hanging there."
msgstr ""
"⟪k:0⟫Quand ⟪k:1⟫vous étiez passé⟪k:2⟫le Défunt était passé⟪k:3⟫ devant pour aller jusqu’à la "
"troisième porte, un magnifique paysage figurait sur le tableau."

#: search:search_C4E222F0_ECAB_4708_90BE_7BC639B4E253
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 646b0141d07a456ffca083d84add7fcfb6f2e6142aa043a31ab905baa6b9a9a6
#. default-sha256: a264d123ba6d7fe16f6377bb4ac2609031d10b19f3a174f5497e22137a01835f
msgctxt "search:search_C4E222F0_ECAB_4708_90BE_7BC639B4E253"
msgid ""
"⟪k:0⟫But now, the canvas was a deep shade of black, as if it had been dipped into a vat of ink."
msgstr ""
"⟪k:0⟫Mais maintenant, la toile est d’un noir profond, comme si on l’avait trempée dans une cuve "
"d’encre."

#: search:search_E274FD87_12D4_4405_8215_FA3F45F727AD
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 72c5fccf90959fc353ff47c3837930139ad2726dd40050b1789270126a9052cb
#. default-sha256: a10240caa12718b40392b86e5921443df2d5633f16352caf1327484998c3ee75
msgctxt "search:search_E274FD87_12D4_4405_8215_FA3F45F727AD"
msgid ""
"⟪k:0⟫Been a while since I’ve talked to anyone.⟪k:1⟫⟪k:2⟫So tell me, you can hear me all right, "
"can’tcha?"
msgstr ""
"⟪k:0⟫Ça fait un bail qu’j’ai pas parlé à quelqu’un.⟪k:1⟫⟪k:2⟫Alors, dis-moi, tu m’entends bien, "
"oui ou non ?"

#: search:search_3A7FA097_8099_4B4C_90DB_0DE1D276157B
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 6053711c1f12de3c61e03dba3cd6d72089ced93e71872854774dde3b3ec91169
#. default-sha256: b238be05ebafe4277742d27c7e20a0467d109e51a843b7bee58e002245e4308f
msgctxt "search:search_3A7FA097_8099_4B4C_90DB_0DE1D276157B"
msgid "⟪k:0⟫⟪k:1⟫I can hear you..."
msgstr "⟪k:0⟫⟪k:1⟫Je vous entends..."

#: search:search_53E12C05_26DB_47D1_9EB4_35E31462CE24
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 643a4bc70be2773967639e85e4288fcd40706d6b1626333f5977e300a84362f0
#. default-sha256: 08a2d6d5a3a8ca3b2b67c76ae22275f27b04f7ecf89d50765ea5dac8b8176ceb
msgctxt "search:search_53E12C05_26DB_47D1_9EB4_35E31462CE24"
msgid "⟪k:0⟫⟪k:1⟫Splendid."
msgstr "⟪k:0⟫⟪k:1⟫Splendide."

#: search:search_AA1E2BF7_D662_4D19_BFD8_D0B8B08D191A
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 8ee66edeec7740df1d3aa83cfac2bbd3eb2fe5a6dc62b825d8916be25a67da6b
#. default-sha256: 37e604e0b0f251b7ff88a0250d23aee5ca6d9a1ab1b0ce67b60bdbd478b6c64f
msgctxt "search:search_AA1E2BF7_D662_4D19_BFD8_D0B8B08D191A"
msgid ""
"⟪k:0⟫Been so long since I’ve had a conversation,⟪k:1⟫I was afraid I might’ve forgotten how to "
"talk.⟪k:2⟫⟪k:3⟫So tell me, who might you be?"
msgstr ""
"⟪k:0⟫Fait si longtemps qu’j’ai pas eu une vraie conversation,⟪k:1⟫j’avais les jetons d’pu savoir "
"comment faire pour parler.⟪k:2⟫⟪k:3⟫Bon, dis-moi, t’es qui, toi ?"

#: search:search_E1EF2AD4_F041_48C4_AB86_840D600A6EB6
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 4bb31500d7c93297191ddf7b9f50cf5693703f80d53c5b343a2706e2a34068f3
#. default-sha256: e690e7835ee69566c932fd551764731ceb5053da3877ef008fc28c6877e03b3d
msgctxt "search:search_E1EF2AD4_F041_48C4_AB86_840D600A6EB6"
msgid "⟪k:0⟫⟪k:1⟫I don’t know...⟪k:2⟫⟪k:3⟫I don’t know anything..."
msgstr "⟪k:0⟫⟪k:1⟫Je ne sais pas...⟪k:2⟫⟪k:3⟫Je ne sais rien..."

#: search:search_4D53616D_8E16_476F_8EAA_1318DB2A3890
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: be0ef3e7641b791937640320bdd8e0443d1ee6861cf60176f6b426c19833b07c
#. default-sha256: f76d9d5ff13a79784732794b4a34511ef63719cb623cd8d41d8029b5f311b500
msgctxt "search:search_4D53616D_8E16_476F_8EAA_1318DB2A3890"
msgid "⟪k:0⟫⟪k:1⟫You don’t know?⟪k:2⟫⟪k:3⟫Well, isn’t that quite the pickle."
msgstr "⟪k:0⟫⟪k:1⟫Tu sais pas ?⟪k:2⟫⟪k:3⟫Eh bien, t’es dans d’beaux draps."

#: search:search_8833BD8D_AEEA_4661_B533_6DE38CFDC60E
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 8b7449076d05bb7213b578e1c23dce629f1d3daed1b47c8081be8fe9f0ee629a
#. default-sha256: 85f3f2d42918ec95bde774f57e643fa70045a7b4a622f07136cb129773d98e4f
msgctxt "search:search_8833BD8D_AEEA_4661_B533_6DE38CFDC60E"
msgid ""
"⟪k:0⟫Then how ’bout we have a little chat, eh?⟪k:1⟫⟪k:2⟫You got yourself turned around and aren’t "
"sure where to go, yeah?"
msgstr ""
"⟪k:0⟫Dans ce cas... et si on s’tapait un peu la discut’ tous les deux, hein ?⟪k:1⟫⟪k:2⟫Tu t’es "
"paumé et tu sais pu trop où aller, j’me trompe ?"

#: search:search_55D06A8D_6D62_4964_B686_5578F59611EC
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: a64bb72d5f51de6669df12264aeb643aae09d704f50a398a0a9eb1d7c1de3887
#. default-sha256: 60796910b30a5a0790287fe36660c3653a6fb0d6835b7c93b5f314406c27b815
msgctxt "search:search_55D06A8D_6D62_4964_B686_5578F59611EC"
msgid "⟪k:0⟫Well, I’ll be happy to tell you anything I can, just ask away."
msgstr "⟪k:0⟫Ben, ça m’ferait plaisir de t’aider et d’te dire tout c’que j’sais, n’hésite pas."

#: search:search_243D2F9F_5D36_4FBC_BB7F_5ADAC95E10E1
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 1acba93de80223c80b17222a5bf5b0d71caf8a5df55ffb9ceef7193be25e30d7
