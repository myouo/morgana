msgid "⟪k:0⟫Name’s Hayden Rhodes.⟪k:1⟫⟪k:2⟫Just a retired old man."
msgstr "⟪k:0⟫Меня зовут Хейден Родс.⟪k:1⟫⟪k:2⟫Просто старик, отошедший от дел."

#: scenario6:scenario6_6B306684_03CA_4561_988F_3664EF244BC8
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 920b38e8a02d87a853958200f8feb6cb4722268329bfef8d2b053c9b0b646eef
