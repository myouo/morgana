msgctxt "scenario6:scenario6_D2037F95_74B5_451B_A296_F78BD0F5D9DC"
msgid "⟪k:0⟫And now, all of that had been turned on its head."
msgstr "⟪k:0⟫А теперь все кардинально переменилось."

#: scenario6:scenario6_48D2F6F0_DB1E_47E7_BCE8_38526208AA81
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 90efea73da359481c24236177036f630aaf808b7a13a82fe07fdd7f0ac026914
