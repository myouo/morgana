msgctxt "scenario6:scenario6_DB08BB38_A638_4FA0_A996_6B4CFF26E22A"
msgid ""
"⟪k:0⟫I don’t care if you spit bile at me for the rest of eternity—⟪k:1⟫⟪k:2⟫⟪k:3⟫I will not let "
"go of this hand!"
msgstr ""
"⟪k:0⟫Мне все равно, если даже ты будешь целую вечность чувствовать ко мне злобу—⟪k:1⟫⟪k:2⟫⟪k:3⟫я "
"не отпущу эту руку!"

#: scenario6:scenario6_E8E75C19_D848_4E53_B61D_E7859E3FAD2C
