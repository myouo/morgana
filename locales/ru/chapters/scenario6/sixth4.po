msgid "⟪k:0⟫⟪k:1⟫...?"
msgstr "⟪k:0⟫⟪k:1⟫...?"

#: scenario6:scenario6_16E316EF_B176_4919_8842_25639A4FFD25
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 0d4dbd17840c1ca9ba53ebcfc142139d2c050a0c48896d5c64e287d209147715
#. default-sha256: 733063687d8bed98288f19078c18a9510b3821056cf251583a3987201887b4a2
msgctxt "scenario6:scenario6_16E316EF_B176_4919_8842_25639A4FFD25"
msgid ""
"⟪k:0⟫⟪k:1⟫Hey, get out here!⟪k:2⟫⟪k:3⟫Christ, there’s not a goddamned confident bone in your "
"body, is there?"
msgstr ""
"⟪k:0⟫⟪k:1⟫Эй, иди сюда!⟪k:2⟫⟪k:3⟫Господи, в твоем тщедушном теле есть хотя бы капля уверенности?"

#: scenario6:scenario6_14684D65_8FA9_4010_953A_C2D2C8D024EC
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 005f0b2a83aa9945145ad56690534cbc2e7b97772b7610a9c9d8ca6bbd09c62e
#. default-sha256: 701688f22bd958af3b10987de4bb0b45f699b97615f7da4b631c835239371a8c
msgctxt "scenario6:scenario6_14684D65_8FA9_4010_953A_C2D2C8D024EC"
msgid "⟪k:0⟫⟪k:1⟫⟪k:2⟫Ah, ⟪k:3⟫I-⟪k:4⟫I’m sorry... ⟪k:5⟫I’ll be right out!"
msgstr "⟪k:0⟫⟪k:1⟫⟪k:2⟫Ах, ⟪k:3⟫П-⟪k:4⟫Прошу прощения... ⟪k:5⟫Я уже иду!"

#: scenario6:scenario6_E7BB3F86_5C78_42D9_A0E8_5D77D70DB695
