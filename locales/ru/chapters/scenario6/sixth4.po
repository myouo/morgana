msgctxt "scenario6:scenario6_8CE9F3FD_FF79_4F19_9C53_3646DD9D5407"
msgid "⟪k:0⟫The first thing she said when she saw me was,"
msgstr "⟪k:0⟫Первое, что она сказала, увидев меня,"

#: scenario6:scenario6_05C8C434_3889_4466_9C5F_9C967728EF84
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: f5133cf563865dc78508a528910a149de75db1d0b9d011decc3b3e5f754b5fa4
#. default-sha256: 30f29c48ccbb5161d99ed1bd3f7aec33af99c3c16bdca4ae9ce955e95b1d3ae6
