msgid "⟪k:0⟫⟪k:1⟫⟪k:2⟫“It’s a pleasure to meet you.”"
msgstr "⟪k:0⟫⟪k:1⟫⟪k:2⟫“Приятно с вами познакомиться”."

#: scenario6:scenario6_666D9EDB_836D_4578_AA5F_8AD6C8F27534
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 5624eba013a9a6e966be3cf2c99f14c1df13ca8ed050812454bb717d13b29fd7
#. default-sha256: ef9dc94d3365f472ed56f112dfb2dee947715da47be44a4b9e4952d11420e870
msgctxt "scenario6:scenario6_666D9EDB_836D_4578_AA5F_8AD6C8F27534"
msgid "⟪k:0⟫What had I spent all that time waiting for?"
msgstr "⟪k:0⟫Ради чего я ждала так долго?"

#: scenario6:scenario6_88DA40EB_7F6A_4485_BBEE_ACE5B0922BA6
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 20ee09b658da225bacd9b53bf9ce6f986a70760026d69a316f967811d29a7ada
