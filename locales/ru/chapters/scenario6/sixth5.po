msgctxt "scenario6:scenario6_163EC0D0_E2FF_4174_9059_D4A83D451B52"
msgid "⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫⟪k:4⟫⟪k:5⟫No matter what happens..."
msgstr "⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫⟪k:4⟫⟪k:5⟫Что бы ни случилось..."

#: scenario6:scenario6_4DF94911_E146_44DB_9E37_A31671194188
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 950341a53c241cf69de60ed09c97c845486c625a446336cd447a3bd9af0f6b07
#. default-sha256: 10a5b79b254ac4dcb1369f023edfe52faa07a9432304623dde783db5e6cd4829
msgctxt "scenario6:scenario6_4DF94911_E146_44DB_9E37_A31671194188"
msgid "⟪k:0⟫⟪k:1⟫no matter what you see..."
msgstr "⟪k:0⟫⟪k:1⟫что бы ты ни увидел..."

#: scenario6:scenario6_BF129CA0_712B_4687_BB76_D5CAAE6E3137
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 76314cbc4e7ffaa731cd097828c31967f4f0280c62a0da4d2b5cc06a25db51a3
#. default-sha256: 8dcb51978844f59390ff48c2ea604f20735ca5786b0a0acc87663e8a2bb5f4fb
msgctxt "scenario6:scenario6_BF129CA0_712B_4687_BB76_D5CAAE6E3137"
msgid "⟪k:0⟫⟪k:1⟫never again..."
msgstr "⟪k:0⟫⟪k:1⟫больше никогда..."

#: scenario6:scenario6_9CB7481D_46BE_4B1A_ACA9_2845B727CBC5
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 79bbf7cf4afa3f246bb66c566112f92622225b4fe94aeef890a5f5b03750020d
#. default-sha256: d9ba2533386f3c72b3100ca919839246e2659b20d530201884260a6dcc4dfec0
msgctxt "scenario6:scenario6_9CB7481D_46BE_4B1A_ACA9_2845B727CBC5"
msgid "⟪k:0⟫⟪k:1⟫let go of this hand..."
msgstr "⟪k:0⟫⟪k:1⟫не отпускай эту руку..."

#: scenario6:scenario6_18E2B9AF_AE3C_41CE_A368_93578918249C
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 33d9b698abc48826d41e236659a1d4d27bd6baf8aff007f97c23d4860eb4fe81
#. default-sha256: 95ef57080f7ac6f56b8488ee9dd4416468fb59f0eec97c0dc9d45bccffbf726a
msgctxt "scenario6:scenario6_18E2B9AF_AE3C_41CE_A368_93578918249C"
msgid "⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫⟪k:4⟫That... ⟪k:5⟫is everything."
msgstr "⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫⟪k:4⟫Это... ⟪k:5⟫все."

#: scenario6:scenario6_99153502_C32A_4E03_9DD6_822B712B48DF
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 62dd824ef383e39c5bb87330bb6494a06c6e416d64b507506bcad7eb7a832571
#. default-sha256: 188f365e7425f51354c132147a541f38c9c6c7e37665a932493076d2f153516c
msgctxt "scenario6:scenario6_99153502_C32A_4E03_9DD6_822B712B48DF"
msgid "⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫............"
msgstr "⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫............"

#: scenario6:scenario6_1266F294_ED32_406E_94D6_8CCA1AF6B90C
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: b265eab0d741de0a1f975ad93437d53b19615a84b8fb7a34899326239c752879
#. default-sha256: 0a26892d4b8bf2550bd7e53cd448a4fe4f82f214cadbeefabbf1d468e7a2c0db
msgctxt "scenario6:scenario6_1266F294_ED32_406E_94D6_8CCA1AF6B90C"
msgid "⟪k:0⟫I prepared a number of things to say when she was finished with her tale,"
msgstr "⟪k:0⟫Я готовился сказать ей столько всего, когда она закончит свой рассказ,"

#: scenario6:scenario6_0CF713FA_806D_4B6A_BAA0_BF374F4C56E0
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: f1c9ded6e60725ea1d4719e0980d204ae6dcb1890769e92215ae37b8c6462db5
#. default-sha256: 1ca0b49f5715d26172aa6bdbeec5479ccba0591e984de6a1b822396580418fe7
msgctxt "scenario6:scenario6_0CF713FA_806D_4B6A_BAA0_BF374F4C56E0"
msgid "⟪k:0⟫but I can’t manage to put any of them into words."
msgstr "⟪k:0⟫но не могу выразить словами ничего из задуманного."

#: scenario6:scenario6_1F1C88CC_6A6E_4ECC_868A_58408AC2ABA6
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 3b5b78a1759a2ca099e700b57f397e8c38141230ccae8a07c9d8224bc4154d4e
#. default-sha256: cec03c40c5fd0ab2291b19d1fcb3d724a23768c72046e1cf3bf45811efc010f8
msgctxt "scenario6:scenario6_1F1C88CC_6A6E_4ECC_868A_58408AC2ABA6"
msgid "⟪k:0⟫I almost hate myself for thinking it would be so easy."
msgstr "⟪k:0⟫Я практически ненавидел себя, за то, что думал, что это будет так легко."

#: scenario6:scenario6_E53F052F_E604_466B_A462_5229FDF0E856
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 2605a3df4dca42c92ad97dad178b4a89583985735cc896ab98f8bb1f36300a11
#. default-sha256: 1ba6cdda49f83d10858dacebdc4f55d9f9564f5981ae83847394ff93db32a8d9
msgctxt "scenario6:scenario6_E53F052F_E604_466B_A462_5229FDF0E856"
msgid ""
"⟪k:0⟫For letting myself hope I could simply pull her back to her old self,⟪k:1⟫accept whatever "
"had happened to her,"
msgstr ""
"⟪k:0⟫За то, что позволил себе надеяться, будто мне без труда удастся вернуть ее назад,⟪k:1⟫"
"принять все то, что с ней случилось,"

#: scenario6:scenario6_F3D5627E_7C28_445A_9C3F_932FF496F53E
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 01f6027cc220f8482e335101e5c84dd2e8b7618fd60b77f9aa0e3db398d73165
#. default-sha256: 7f48e8b820e404e4b621c50c2c8ceec8ba86638a8b9d5b06f81e3181b7d57907
msgctxt "scenario6:scenario6_F3D5627E_7C28_445A_9C3F_932FF496F53E"
msgid "⟪k:0⟫take her hand in mine, and that would solve everything."
msgstr "⟪k:0⟫взять ее за руку и это решит все проблемы."

#: scenario6:scenario6_218D7FBB_C459_4977_BB6A_96B43570A67F
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 1a3d9f8fd2f8857e87ec19e8c7bcfb9610244373c8fd127fc80fba7687387c96
#. default-sha256: 74366123b88fb4cd02bec761ae0121bcc7faf79fb590a739855722114ad0f4d7
msgctxt "scenario6:scenario6_218D7FBB_C459_4977_BB6A_96B43570A67F"
msgid "⟪k:0⟫The truth is so much worse than I imagined—⟪k:1⟫⟪k:2⟫so much more harrowing."
msgstr "⟪k:0⟫Правда оказалась гораздо хуже, чем я себе представлял — ⟪k:1⟫⟪k:2⟫намного мучительней."

#: scenario6:scenario6_16D0120E_43DD_41D0_A19C_830C0C139E1D
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: c7dc364629af9fb8119cd30867dcb70164b2638f5e208f081788da0d9018e6ad
#. default-sha256: 98ff4ecab4a01385897299bb69ee91fab89b794bca650bb7395066255d62cc4d
msgctxt "scenario6:scenario6_16D0120E_43DD_41D0_A19C_830C0C139E1D"
msgid "⟪k:0⟫She was subjected not only to her own terrible fate,"
msgstr "⟪k:0⟫Она столкнулась не только с собственной ужасной судьбой,"

#: scenario6:scenario6_581895C7_70CD_4803_BFC6_FB50FAB30442
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 6df371fe5ad098996954b90facc05b054c82f151f8859b9319bf912a0bed76bb
#. default-sha256: 9e6ad17c72fc8f302194b75eff0fb5d763c58985bb885885b62adad8ea15c08e
