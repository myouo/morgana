msgctxt "badend:badend_3EDA9B4B_D931_44BE_B22D_1D681440EFE9"
msgid "⟪k:0⟫⟪k:1⟫You⟪k:2⟫The Departed⟪k:3⟫ made the correct choice."
msgstr "⟪k:0⟫⟪k:1⟫Ты⟪k:2⟫Ты⟪k:3⟫ сделал верный выбор."

#: badend:badend_A8975700_5290_4EF8_8591_7B9B4986DDFA
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: f6dbbf66ac4c0b3faa26a046775ebe1ad7751e8aa43d280886da3f6731bcd4c2
#. default-sha256: 14ee79598daf350d803236d63b5a971ceaacd8f822c0c857fd53e284692d89e2
