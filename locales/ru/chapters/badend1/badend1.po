msgctxt "badend:badend_74649044_6D3B_42E9_91BB_EC8BBFACE885"
msgid "⟪k:0⟫Never again to look back upon the past ⟪k:1⟫You⟪k:2⟫he⟪k:3⟫ might have had,"
msgstr "⟪k:0⟫Никогда больше не оглядываться на прошлое, что ⟪k:1⟫Ты⟪k:2⟫Ты⟪k:3⟫ мог иметь,"

#: badend:badend_EAA90AAE_67A8_4496_8BA6_AE73C80B00D7
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 24e5036dbb12adb29fa0eb9b1374da573cb1ea50d953a1e69699b5b036d71c90
#. default-sha256: f6436d9de9008f9935467c6e94c55c6b7fee8b57708e5db52119535443a32bd2
msgctxt "badend:badend_EAA90AAE_67A8_4496_8BA6_AE73C80B00D7"
msgid "⟪k:0⟫the rare, treasured days of happiness,"
msgstr "⟪k:0⟫на те редкие, бесценные дни счастья,"

#: badend:badend_56C479A0_7DFD_4EE0_9FFF_322BDA18E0A2
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: d8d2c5d121ea6ba6d9831351219c7137cbd993f555cb859239f331557e692f9b
