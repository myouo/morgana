msgctxt "badend:badend_56C479A0_7DFD_4EE0_9FFF_322BDA18E0A2"
msgid "⟪k:0⟫or the bitter days filled with nothing but pain,"
msgstr "⟪k:0⟫или же горестные дни, наполненные одной лишь болью,"

#: badend:badend_0DC26A41_A3FA_4FCC_954D_84814ECB3595
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: cc30bda0bb14e8d21b5e8c2d7d8dbe676e651073066b7e2bb0c9e1c19d923f7d
#. default-sha256: 2b605ebc88cf9aad2ad54f93e271f618493ed643aa3c1de427d0af4656f96bc9
msgctxt "badend:badend_0DC26A41_A3FA_4FCC_954D_84814ECB3595"
