#: prologue:prologue_D4830CFA_A6EB_412D_B47C_96312B222C3B
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 70179e612e688558c4160dcec14dd8324b7ddc0ef23ee17a3d6c96ce1a4e38d3
#. default-sha256: 4dca729bc6d8b9bf4119c60cef0ab278b27a231fb4bfda544a483a0195d14568
msgctxt "prologue:prologue_D4830CFA_A6EB_412D_B47C_96312B222C3B"
msgid "⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫⟪k:4⟫⟪k:5⟫⟪k:6⟫⟪k:7⟫⟪k:8⟫⟪k:9⟫⟪k:10⟫⟪k:11⟫⟪k:12⟫⟪k:13⟫⟪k:14⟫Wake up..."
msgstr ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫⟪k:4⟫⟪k:5⟫⟪k:6⟫⟪k:7⟫⟪k:8⟫⟪k:9⟫⟪k:10⟫⟪k:11⟫⟪k:12⟫⟪k:13⟫⟪k:14⟫Просыпайся..."

#: prologue:prologue_D6CCEF6C_1929_497C_A250_574781E95CC3
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: ce04cb4c92c1bc6c21b5f6d7bf6956bafde028add5af22fbe893c5c3850ef370
#. default-sha256: 49315cf198c69818ee61b76fb2b90a0d7307faf20964956ed0e8488c29dc0124
msgctxt "prologue:prologue_D6CCEF6C_1929_497C_A250_574781E95CC3"
msgid "⟪k:0⟫⟪k:1⟫Please wake up..."
msgstr "⟪k:0⟫⟪k:1⟫Пожалуйста, просыпайся..."

#: prologue:prologue_7D0E1091_7FB9_4B93_A239_A3A383BA05E0
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: f61e4808b9541e1a87928f9b582d0bfaf7bd76e7d99e62a5097a9ea3294ab6c5
#. default-sha256: 6282aefec4596237dfd3cf8c2f37740886012340b8461246cc8b2a8b92fde1a3
msgctxt "prologue:prologue_7D0E1091_7FB9_4B93_A239_A3A383BA05E0"
msgid "⟪k:0⟫⟪k:1⟫Come on..."
msgstr "⟪k:0⟫⟪k:1⟫Ну же..."

#: prologue:prologue_1EB62C36_88AE_4696_8FA0_CF1CB598490F
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 4a904df937c0633e0ac742c90c25c3e0f56390c779b92f6908a137dacd0cf247
#. default-sha256: 2855fa7c4dbbb99c6c2a8d4bfb3d9b7f32231572c246d2f421ff4c0667af67cc
msgctxt "prologue:prologue_1EB62C36_88AE_4696_8FA0_CF1CB598490F"
msgid "⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫⟪k:4⟫Hehehe... ⟪k:5⟫Good morning."
msgstr "⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫⟪k:4⟫Хехехе... ⟪k:5⟫Доброе утро."

#: prologue:prologue_B69DEE9D_18C2_4F49_944C_D342A9737DE1
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 32d978b3a86547307ad72bcb43dc5ee639965aca4bb3be36062ecb1116c6218a
#. default-sha256: 188f365e7425f51354c132147a541f38c9c6c7e37665a932493076d2f153516c
msgctxt "prologue:prologue_B69DEE9D_18C2_4F49_944C_D342A9737DE1"
msgid "⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫............"
msgstr "⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫............"

#: prologue:prologue_9C5985A3_A450_4279_89AD_E4C9055CB369
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 03e611514102864a2c95fe0bc655e621544c01f2ee714dde097c8c3c2249ef4c
#. default-sha256: a65021911aeb67717a33c6c10a8de2acee88242ce8d0cb7ca4407895d2cec572
msgctxt "prologue:prologue_9C5985A3_A450_4279_89AD_E4C9055CB369"
msgid "⟪k:0⟫What’s the occasion? You never come to wake me up."
msgstr "⟪k:0⟫Что за повод? Ты никогда не приходила, чтобы разбудить меня."

#: prologue:prologue_68962FD1_5789_4814_BF46_B3586D07440A
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 97ecd099b15bc8e04dce1ff3ac659c7bebb776540286bd1c0a5662e0f018b914
#. default-sha256: 264c45b8c5dddb9f156e9bcea686a10068edd92ce976591e97ba95a1c6efe123
msgctxt "prologue:prologue_68962FD1_5789_4814_BF46_B3586D07440A"
msgid ""
"⟪k:0⟫⟪k:1⟫I was merely concerned for your health.⟪k:2⟫⟪k:3⟫You really should be sleeping in a "
"proper bed."
msgstr ""
"⟪k:0⟫⟪k:1⟫Я всего лишь беспокоилась о твоем здоровье.⟪k:2⟫⟪k:3⟫Тебе действительно лучше спать на "
"нормальной кровати."

#: prologue:prologue_CF9E89B3_32AE_40C3_9AFC_47CEAC6DA8C3
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: fbeeb93e8eb4f3e36df2707112cdad0557444e5d349169700e07b0e5f502d470
#. default-sha256: 2a690e5c2c1b03efaf743790de53922ae7518cdae8d7e478c76561d03f6e1c11
msgctxt "prologue:prologue_CF9E89B3_32AE_40C3_9AFC_47CEAC6DA8C3"
msgid ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫You were ⟪k:3⟫concerned⟪k:4⟫? About ⟪k:5⟫me⟪k:6⟫?⟪k:7⟫⟪k:8⟫You do realize the "
"concept of “health” bears little meaning for either of us, don’t you?"
msgstr ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫Ты ⟪k:3⟫беспокоилась⟪k:4⟫? Обо ⟪k:5⟫мне⟪k:6⟫?⟪k:7⟫⟪k:8⟫Ты понимаешь, что понятие "
"“здоровья” не особо применимо к нам, не так ли?"

#: prologue:prologue_42F500E6_AADF_4523_B5D0_46846E73867B
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 8ddbf3f8d651b0a111c9ece09fb69c1dd289348cf038ed68b19709892fb86044
#. default-sha256: 3661ffb71c7751cd3cc5fc76300671b33afd913ab809adae71c215111be818da
msgctxt "prologue:prologue_42F500E6_AADF_4523_B5D0_46846E73867B"
msgid ""
"⟪k:0⟫⟪k:1⟫Why would I not be concerned? ⟪k:2⟫You ⟪k:3⟫are⟪k:4⟫ me.⟪k:5⟫⟪k:6⟫If something were to "
"cause you to depart this world,⟪k:7⟫the same would happen to me."
msgstr ""
"⟪k:0⟫⟪k:1⟫А как мне не беспокоиться? ⟪k:2⟫Ты ⟪k:3⟫это⟪k:4⟫ я.⟪k:5⟫⟪k:6⟫Если что-то заставит тебя "
"покинуть этот мир,⟪k:7⟫То же самое случится и со мной."

#: prologue:prologue_B351EC4B_885F_482C_B4CB_BCEFFF7E34F7
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: ead8a897a89ed5200dc981edeb0529ebc90ecf21f0bb0f2dee5f4daf6fe36b8d
#. default-sha256: c0ea8343e78fb1ccf337e1fe24e2eee3693c8769f9cbaa3698b516f18456f9ee
msgctxt "prologue:prologue_B351EC4B_885F_482C_B4CB_BCEFFF7E34F7"
msgid "⟪k:0⟫⟪k:1⟫⟪k:2⟫Ahh... ⟪k:3⟫right.⟪k:4⟫⟪k:5⟫That’s true."
msgstr "⟪k:0⟫⟪k:1⟫⟪k:2⟫Ахх... ⟪k:3⟫верно.⟪k:4⟫⟪k:5⟫Это правда."

#: prologue:prologue_219F44A4_AECD_4C4F_AFBA_6559324490AB
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 9c066df3db5215f02ccb2c9e7e5dc375a16b32278cf37f4af754f69858578a15
#. default-sha256: c0e062b529031ca68de26ad36b8b66bde2a66cedace45f33ead798e4a61c3356
msgctxt "prologue:prologue_219F44A4_AECD_4C4F_AFBA_6559324490AB"
msgid ""
"⟪k:0⟫(It was so long ago, I almost forgot I told her she was me.⟪k:1⟫⟪k:2⟫And it would seem she "
"still believes that to be the case.)"
msgstr ""
"⟪k:0⟫(Это было так давно, что я практически забыла, как сказала ей, что она это я.⟪k:1⟫⟪k:2⟫И, по-"
"видимому, она до сих пор в это верит.)"

#: prologue:prologue_3BF7FF21_91E5_45AA_8A70_93A97AE211F1
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 55b49b5e72d9344a0b1381543f22187444a6a710787f1bcb1b73099b24d2a53e
#. default-sha256: 9cfc5a1964eb382a10728bd7945ff9b5a7b3dde1f8c708b9c24195335dbd4b25
msgctxt "prologue:prologue_3BF7FF21_91E5_45AA_8A70_93A97AE211F1"
msgid "⟪k:0⟫(Foolish woman.)"
msgstr "⟪k:0⟫(Глупая женщина.)"

#: prologue:prologue_2494829B_6EF8_4259_8A89_724BF8C2E9BE
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 0fbe1ded9b416ab1566ed28af7b73a04b3f35ceda3ecba5aac823517633d3fcc
#. default-sha256: 5c4fef75a267f3ab4cf6ded1c95043bc325dc40d7464ac6fbbeea0f88a0a8a1c
msgctxt "prologue:prologue_2494829B_6EF8_4259_8A89_724BF8C2E9BE"
msgid ""
"⟪k:0⟫⟪k:1⟫Hehe... ⟪k:2⟫What kind of herbal tea would you like to start your day with?⟪k:3⟫⟪k:4⟫I "
"have some lovely mint leaves, if you would like.⟪k:5⟫⟪k:6⟫They are wonderful for improving one’s "
"mood."
msgstr ""
"⟪k:0⟫⟪k:1⟫Хехе... ⟪k:2⟫С какого травяного чая ты бы хотела начать свой день?⟪k:3⟫⟪k:4⟫Если "
"желаешь, у меня есть чудесные лепестки мяты.⟪k:5⟫⟪k:6⟫Они вмиг поднимают настроение."

#: prologue:prologue_A3379ACC_2922_40DF_B93A_42D0249E6756
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 7c146f3727a83684ad539e7b0e17b8fc60bd536c468cfd100f6866d3be7e383d
#. default-sha256: 8d2f965da1c31500cad99e5e79b50590201a38c39a568fc68a41092061b2d8dc
msgctxt "prologue:prologue_A3379ACC_2922_40DF_B93A_42D0249E6756"
msgid "⟪k:0⟫⟪k:1⟫⟪k:2⟫I have no interest in—⟪k:3⟫⟪k:4⟫or need for—⟪k:5⟫⟪k:6⟫tea."
msgstr "⟪k:0⟫⟪k:1⟫⟪k:2⟫У меня нет интереса—⟪k:3⟫⟪k:4⟫или потребности—⟪k:5⟫⟪k:6⟫в чае."

#: prologue:prologue_2A7416EA_6EC3_4EC3_B482_0837EB84EE2E
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 50f33a0b5a018b9a1d354a565ca7800c2554f83813290ead2a755213148a3f92
#. default-sha256: 6586430a22b5b9cd1f04ce37c8a68b4af6911e12e28547ca8aed6b832e26bf20
msgctxt "prologue:prologue_2A7416EA_6EC3_4EC3_B482_0837EB84EE2E"
msgid "⟪k:0⟫⟪k:1⟫That is most unfortunate."
msgstr "⟪k:0⟫⟪k:1⟫Что ж, очень жаль."

#: prologue:prologue_8FC837AF_E40A_4C1D_94F4_77A8DB4EDBD0
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: e8e7d1a3be4c8ca611189f8e7bee8ff385fa668d95c5652da83d30f9358f468f
#. default-sha256: 3de7d297daa4b70e194c773f0dffaa37bb159451ca9c4532ed58a378e1795e91
msgctxt "prologue:prologue_8FC837AF_E40A_4C1D_94F4_77A8DB4EDBD0"
msgid "⟪k:0⟫⟪k:1⟫In that case, perhaps you could tell me a story?"
msgstr "⟪k:0⟫⟪k:1⟫В таком случае, может, ты расскажешь мне историю?"

#: prologue:prologue_403866E0_6E4F_493B_A27C_2C7EAFE6329E
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: acc4b5edc14c5d6a10c03658d35c62315ef5376ff2f23fd16e3b1942c79037a3
#. default-sha256: d59e4f49fec7b2c01c052ee15d5244220816af6e3da9c56e90b24fe0c9d4f20c
msgctxt "prologue:prologue_403866E0_6E4F_493B_A27C_2C7EAFE6329E"
msgid "⟪k:0⟫⟪k:1⟫⟪k:2⟫A story?⟪k:3⟫⟪k:4⟫You mean the one about Michel and Giselle again?"
msgstr "⟪k:0⟫⟪k:1⟫⟪k:2⟫Историю?⟪k:3⟫⟪k:4⟫Ты имеешь в виду, снова о Мишеле и Жизель?"

#: prologue:prologue_0B05D229_DD6F_426C_BBE6_F3909259CA5D
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: b632ea14b3d018a4f3a11fefd3e2c3704c763ae393f45c1ced7b6ea89303e018
#. default-sha256: 52bc7d7420a987ccf9bf72fe71815b8511aa23a828813138f9a8cdf602e84977
msgctxt "prologue:prologue_0B05D229_DD6F_426C_BBE6_F3909259CA5D"
msgid "⟪k:0⟫⟪k:1⟫Yes, that one.⟪k:2⟫⟪k:3⟫I do love that story oh so very much."
msgstr "⟪k:0⟫⟪k:1⟫Да, эту.⟪k:2⟫⟪k:3⟫Я просто обожаю эту историю."

#: prologue:prologue_4604B25A_659B_44D1_9FFC_0469BC280F95
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: e6d56bcd7f4129e850d3ffdfa9a5f5ab754b3bed2c6a4bb7e6b95358288815d1
#. default-sha256: 3f949546800f467a6794ef417d8c0d46fb8ce45d26adfc38b062992d65489abb
msgctxt "prologue:prologue_4604B25A_659B_44D1_9FFC_0469BC280F95"
msgid ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫I, for one, am growing rather tired of it.⟪k:3⟫⟪k:4⟫I’ve told it to you dozens of "
"times now."
msgstr ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫А вот я начинаю от нее уставать.⟪k:3⟫⟪k:4⟫Я рассказывала ее тебе уже множество раз."

#: prologue:prologue_DB2E9551_BD10_4F5E_B19B_02E32600B333
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 146833b05e594031825f5d2b72dc58bc0203ba499821078c02de5d32da744f13
#. default-sha256: 2c7653e0c1fdb95eca4ac905f858aec2d1c652dbc2fd2821b018e47beb1bdbe0
msgctxt "prologue:prologue_DB2E9551_BD10_4F5E_B19B_02E32600B333"
msgid ""
"⟪k:0⟫⟪k:1⟫Now, don’t be like that.⟪k:2⟫⟪k:3⟫The best stories never stop being moving,⟪k:4⟫no "
"matter how many times you hear them."
msgstr ""
"⟪k:0⟫⟪k:1⟫Ну же, не будь такой.⟪k:2⟫⟪k:3⟫Лучшие истории никогда не перестают вдохновлять,⟪k:4⟫"
"сколько бы раз их не услышал."

#: prologue:prologue_FE9551A9_E7B3_4525_AC83_90F29E5824B3
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 41fc1e08f673b3e8401038151f8a40809f9d48068d74cbb21ab336a356545aae
#. default-sha256: 61626a66a856fc58c9cc978f68f6c9449e076e3322876e058d7f4af4c1800418
msgctxt "prologue:prologue_FE9551A9_E7B3_4525_AC83_90F29E5824B3"
msgid "⟪k:0⟫⟪k:1⟫⟪k:2⟫(It’s like I’m talking to a child...)"
msgstr "⟪k:0⟫⟪k:1⟫⟪k:2⟫(Я будто разговариваю с ребенком...)"

#: prologue:prologue_9A642A70_8B15_47C9_BD7B_BEB6E479AED8
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 2e5b5515147f3d82caabdcec14a675602539bb58a5656488bc6c28696d19df8d
#. default-sha256: a644f420acb3a281fdf8205540769e43c277a8520feba04fedc6356931067d8d
msgctxt "prologue:prologue_9A642A70_8B15_47C9_BD7B_BEB6E479AED8"
msgid ""
"⟪k:0⟫All right, then, how about this? ⟪k:1⟫I’m going to ask you a question,⟪k:2⟫and if you give "
"me an answer I like, I’ll tell you the story again."
msgstr ""
"⟪k:0⟫Ну хорошо, тогда как насчет такого? ⟪k:1⟫Я задам тебе вопрос,⟪k:2⟫и если ты дашь на него "
"ответ, который меня устроит, я снова расскажу тебе эту историю."

#: prologue:prologue_37041A75_7016_4F96_B9C5_AD3F59AEC5F5
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 3b4a3311056f3de9ee18dfe51ff368a917ce06b6fcc658ddd060d3f81d461c6c
#. default-sha256: f63905106b3d3ab75382ed7f08f8b0f8e5692def8daf769aece128fdf7c1f7c3
msgctxt "prologue:prologue_37041A75_7016_4F96_B9C5_AD3F59AEC5F5"
msgid "⟪k:0⟫⟪k:1⟫Oh? What kind of question?"
msgstr "⟪k:0⟫⟪k:1⟫Ох? Что за вопрос?"

#: prologue:prologue_DDEDFAD1_E397_4B12_B05A_473A3CDE182C
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 643c6acef2571f8a8e3486e9d6d664c219c8dbb38d1b637fbe503e210889e58e
#. default-sha256: d184620f52a9b1c598cb4221405b4718d5e2acae42c0c7817a71308e49ed80c0
msgctxt "prologue:prologue_DDEDFAD1_E397_4B12_B05A_473A3CDE182C"
msgid ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫Hehe... ⟪k:3⟫Nothing difficult, I promise.⟪k:4⟫⟪k:5⟫I want to hear your opinion on "
"something."
msgstr ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫Хехе... ⟪k:3⟫Ничего сложного, обещаю.⟪k:4⟫⟪k:5⟫Я просто хочу услышать твое мнение "
"по поводу кое-чего."

#: prologue:prologue_30C3C1BA_1D3D_4D6D_A3C5_556EB160ED24
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
