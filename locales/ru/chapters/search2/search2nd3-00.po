msgctxt "search2:search2_508A1570_9B15_44CC_B46B_3B12B131CBDC"
msgid "⟪k:0⟫⟪k:1⟫⟪k:2⟫“She needs the money.”"
msgstr "⟪k:0⟫⟪k:1⟫⟪k:2⟫“Ей нужны деньги.”"

#: search2:search2_3C835617_FE2B_4BB6_A129_DC7164284E49
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 8b18d946ad4a18266d9c689d587048cc6e50be629e5c4d460e548048eba15fd1
