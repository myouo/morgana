msgctxt "search2:search2_1223175D_29EB_4B25_922C_3014024169C8"
msgid ""
"⟪k:0⟫⟪k:1⟫Those merry...⟪k:2⟫⟪k:3⟫peaceful...⟪k:4⟫⟪k:5⟫⟪k:6⟫⟪k:7⟫⟪k:8⟫cheerful...⟪k:9⟫⟪k:10⟫⟪k:11⟫"
"⟪k:12⟫⟪k:13⟫⟪k:14⟫spirited sinners’ voices...⟪k:15⟫⟪k:16⟫⟪k:17⟫resounded in my tower."
msgstr ""
"⟪k:0⟫⟪k:1⟫Эти веселые...⟪k:2⟫⟪k:3⟫Мирные...⟪k:4⟫⟪k:5⟫⟪k:6⟫⟪k:7⟫⟪k:8⟫Жизнерадостные...⟪k:9⟫⟪k:10⟫"
"⟪k:11⟫⟪k:12⟫⟪k:13⟫⟪k:14⟫Радушные голоса грешников...⟪k:15⟫⟪k:16⟫⟪k:17⟫гулким эхом отзывались в "
"моей башне."

