msgctxt "search2:search2_5AC72E41_4150_4A5B_B5AC_447276CF9678"
msgid ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫“How... can you be so calm?!⟪k:3⟫⟪k:4⟫⟪k:5⟫Do you understand what you’ve done?”"
msgstr ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫“Как... ты можешь быть таким спокойным?!⟪k:3⟫⟪k:4⟫⟪k:5⟫Разве ты не понимаешь, что "
"мы натворили?”"

#: search2:search2_AC49DB02_5520_4208_A28B_6BC3497DBF5F
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 623db4e7f3a08d7776a5808418e5129c261078426b27ac8b15260a819baa4e6c
