msgid "⟪k:0⟫⟪k:1⟫⟪k:2⟫The lord gave my corpse a casual glance,⟪k:3⟫⟪k:4⟫and said stonefaced,"
msgstr ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫Лорд небрежно взглянул на мой труп,⟪k:3⟫⟪k:4⟫а затем сказал с каменным лицом,"

#: search2:search2_5AC72E41_4150_4A5B_B5AC_447276CF9678
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 54617cce0047c5ec13e5b8b96f45985bc87f193d670c3d11ac33ce5c61b2273d
