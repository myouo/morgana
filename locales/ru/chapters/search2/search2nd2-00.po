msgctxt "search2:search2_2F7EBB04_999C_4CA2_89C7_2B23C3E7BE0C"
msgid "⟪k:0⟫What are you, Morgana?"
msgstr "⟪k:0⟫Что ты, Моргана?"

#: search2:search2_55C4A22E_2FED_45F3_932F_7639A7879320
