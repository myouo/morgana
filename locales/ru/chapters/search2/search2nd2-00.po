msgctxt "search2:search2_DEBBB9EF_7D0C_47CA_8685_E3FB38FADCCF"
msgid "⟪k:0⟫What I mean is, I’m an ordinary human."
msgstr "⟪k:0⟫Я имею в виду, что я простой человек."

#: search2:search2_E59B04B6_A25D_4345_8312_CCB42CE0BB00
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 5e93b37b80d498ae4a79dbb43d3480a222461f5b2390cb6c604bf2f02233419c
