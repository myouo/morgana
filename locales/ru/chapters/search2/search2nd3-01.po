msgctxt "search2:search2_033B1FE5_5664_4D32_B611_13F394AAC8AD"
msgid "⟪k:0⟫Ah... ⟪k:1⟫ngh... ⟪k:2⟫gh..."
msgstr "⟪k:0⟫Ах... ⟪k:1⟫нгх... ⟪k:2⟫гх..."

#: search2:search2_23A248DF_EBCD_4C84_8F02_1A771D173C27
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: a15aba0407146cd20613fafe68d5c2c4b8697724b98b48756f48687f930c4f8f
#. default-sha256: caaf7e1c54a9acedb9045a5d6f6770fcafb82acd2ed64cd9513e503eb5b4f627
msgctxt "search2:search2_23A248DF_EBCD_4C84_8F02_1A771D173C27"
msgid "⟪k:0⟫It’s so intense I can’t even eke out a scream."
msgstr "⟪k:0⟫Она настолько сильна, что я даже не могу издать крик."

#: search2:search2_52F5836F_F560_4624_9DFB_2123B19A4AD4
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: dca0699f93913b5803857d625415c2bf109cc95bbb87121083bd2da8e3c2718a
