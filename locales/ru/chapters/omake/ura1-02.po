#: omake:omake_7030094C_A4E0_4498_9378_3BA384A3D331
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: a9213862c93c645f3934c2f3a9e377f25e4d32c942d457f962ae36c9e614541d
#. default-sha256: e513e5f3a3352f3bc0ce3d5ab2eb230da2ad2e210491eb68a32c690b92d07b99
msgctxt "omake:omake_7030094C_A4E0_4498_9378_3BA384A3D331"
msgid "⟪k:0⟫⟪k:1⟫Since you’re here, though, how would you like to take a little tour of the house?"
msgstr "⟪k:0⟫⟪k:1⟫Тем не менее, раз уж ты здесь, не желаешь немного прогуляться по дому?"

#: omake:omake_2574838F_36C7_4107_9AF5_2F7E11A0C43F
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 39d28c49c76041d9aa0fb45707be908f84060820801d4998ac3fa2e4cd81512b
#. default-sha256: 767b8c08de03ca2878107b5bedc66a5ab943049c7a7c3a19431cc1a58bf3868f
msgctxt "omake:omake_2574838F_36C7_4107_9AF5_2F7E11A0C43F"
msgid ""
"⟪k:0⟫I don’t know why you’re so excited about split ends...⟪k:1⟫⟪k:2⟫If my hair’s such a mess, "
"maybe I should just cut it all off."
msgstr ""
"⟪k:0⟫Понять не могу, чем тебе так нравятся секущиеся кончики...⟪k:1⟫⟪k:2⟫Если мои волосы в таком "
"беспорядке, может мне их просто обрезать."

#: omake:omake_0C0EE1DB_3843_4E39_AA33_F255BD48212B
