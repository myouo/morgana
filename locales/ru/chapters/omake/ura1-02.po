msgid ""
"⟪k:0⟫⟪k:1⟫That sounds a lot like “spend a thousand lines talking trash about Michel” to me..."
msgstr "⟪k:0⟫⟪k:1⟫Для меня это звучит, как “потратить тысячу реплик, оскорбляя Мишеля”..."

#: omake:omake_06EAFF50_B5DF_4DB3_9276_6FAAB6BAE9C0
