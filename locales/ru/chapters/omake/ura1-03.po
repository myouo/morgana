#: omake:omake_FC88912E_2931_41A4_92DD_9E4111F94673
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 86cc9da8c64ff7a9e6ddd4d6516111c037dc474d13ed71b03ee90071c11352a7
#. default-sha256: 13942b71a86f1f81e12238344d547dab41579f021b5216acb4a2e309fa1f2271
msgctxt "omake:omake_FC88912E_2931_41A4_92DD_9E4111F94673"
msgid "⟪k:0⟫⟪k:1⟫⟪k:2⟫Well, never mind that for now."
msgstr "⟪k:0⟫⟪k:1⟫⟪k:2⟫Ну да ладно, пока это неважно."

#: omake:omake_842EAA67_89AC_4204_B51D_994B16A9A5B6
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 6578048b6ee9c7a1031f53b12385e0f91cf852dcf03c794310ad3c2baac126ea
#. default-sha256: 2d4789a3d647132a7f0e36a54b206a5edfeebbb156bf85273e4446b355289129
msgctxt "omake:omake_842EAA67_89AC_4204_B51D_994B16A9A5B6"
msgid ""
"⟪k:0⟫I would ask you what you thought of it,⟪k:1⟫but unfortunately, that is beyond even my powers."
msgstr "⟪k:0⟫Я бы спросила тебя, что ты о ней думаешь,⟪k:1⟫но, к сожалению, это не в моей власти."

#: omake:omake_F9A09CB9_71D9_41BD_8D28_DFAE4B4D5048
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 295e15bb240db422166f09b67cb1bd30c7905fa7a9e92fe91db2e14ffeadaf36
#. default-sha256: 6bfaf461e61a3ca0a82365e65ee39ac46eab336461beaca35ebeb87c7b0d9201
msgctxt "omake:omake_F9A09CB9_71D9_41BD_8D28_DFAE4B4D5048"
msgid "⟪k:0⟫⟪k:1⟫⟪k:2⟫...You’ve got a strong stomach, at least."
msgstr "⟪k:0⟫⟪k:1⟫⟪k:2⟫...Ну, по крайней мере, у тебя крепкий желудок."

#: omake:omake_3D14B59C_669A_473A_81E7_82B165B4E507
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 5eb40e1c8af33b79be77dab723c3a0ee9d6523423d30062afdbb4e8d1b579330
#. default-sha256: 2607b6248423d2dba9ac5a6e7945d0bc685d77bcc494277b02a6d4e9e3cab228
msgctxt "omake:omake_3D14B59C_669A_473A_81E7_82B165B4E507"
msgid ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫Before we begin our little trek, I would like to emphasize that this is,⟪k:3⟫as "
"the title implies, a look behind the curtains of ⟪k:4⟫The House in Fata Morgana⟪k:5⟫."
msgstr ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫Прежде чем мы начнем наш небольшой тур, я бы хотела подчеркнуть, что это,⟪k:3⟫как "
"ясно из названия, взгляд за кулисы ⟪k:4⟫The House in Fata Morgana⟪k:5⟫."

#: omake:omake_8C0E56DE_602A_2D29_9429_071DD0D4C50A
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 72e41b77fab745e62bb9adf1851f3f86065b38096819cda0bf8dc28f731d2625
#. default-sha256: 0a2c93c2419f3fc474a33803f2d6f56348150f4777fbf54dc56a58033741f000
msgctxt "omake:omake_8C0E56DE_602A_2D29_9429_071DD0D4C50A"
msgid ""
"⟪k:0⟫⟪k:1⟫But should you choose to continue, I encourage you to do so knowing that what you’re "
"about to read does not in any way respect the tone of the game proper."
msgstr ""
"⟪k:0⟫⟪k:1⟫Но если решишь продолжить, я настоятельно рекомендую понять, то, что тебе предстоит "
"прочитать, никоим образом не придерживается настроя основной игры."

#: omake:omake_5973E007_064C_48B3_A4D6_641D2CD416FC
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 532966412e70575503855930a8d2331eb13b405be2232e38323dc280f1138c65
#. default-sha256: 3c6f913eeba1d6accc779055bce516eda09b81bad4c459c56cbc16bc74bd1b2e
msgctxt "omake:omake_5973E007_064C_48B3_A4D6_641D2CD416FC"
msgid ""
"⟪k:0⟫You’ll be making your way into the heads of the staff themselves,⟪k:1⟫and I promise you—⟪k:2⟫"
"⟪k:3⟫it’s not a pretty sight."
msgstr ""
"⟪k:0⟫Ты заглянешь в головы самих создателей,⟪k:1⟫и уверяю тебя — ⟪k:2⟫⟪k:3⟫это не самое приятное "
"зрелище."

#: omake:omake_8A3E8667_5714_4479_945B_89A82141E83A
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: b353acfec49c5cb4f41950270a16aa9bac75598c282b293c7a64ff6e99e7b9df
#. default-sha256: ea7d92578d0863243f83e59f53429a6ba3e3f4513a47cec6973038c721159e90
msgctxt "omake:omake_8A3E8667_5714_4479_945B_89A82141E83A"
msgid "⟪k:0⟫Let us be off, then."
msgstr "⟪k:0⟫Что ж, идем."

#: omake:omake_0D388061_5E2E_478A_ACF1_CABD30013371
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: db5872fdcd1d0c467a052b919afbe910ccd37344403ba3a2be7264d1e9ff53a5
#. default-sha256: 7b39400c2a19fde93162cb5221df47c4d6cd8911a0d06cb50840a6dc93528a34
msgctxt "omake:omake_0D388061_5E2E_478A_ACF1_CABD30013371"
msgid ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫⟪k:4⟫⟪k:5⟫⟪k:6⟫Ah! I found another split end!⟪k:7⟫⟪k:8⟫Look, this one’s split "
"into three!"
msgstr ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫⟪k:4⟫⟪k:5⟫⟪k:6⟫Ах! Я нашла еще секущиеся кончики!⟪k:7⟫⟪k:8⟫Гляди-ка, этот "
"вообще натрое разделился!"

#: omake:omake_C02C6675_80EB_49E5_9A4B_007813BB63CA
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: bda3cf3cba7b5eed3ec610c0bbcf60000fa121110f43e077b7e02e8a5250a776
#. default-sha256: a5144a7eaf648e44d5d31586b8e60520748c0ae7e2de5523e2c0ed1c76db75b1
msgctxt "omake:omake_C02C6675_80EB_49E5_9A4B_007813BB63CA"
msgid ""
"⟪k:0⟫I-⟪k:1⟫I— ⟪k:2⟫⟪k:3⟫I didn’t actually mean that!⟪k:4⟫⟪k:5⟫I was just, ⟪k:6⟫you know, ⟪k:7⟫a "
"little overwhelmed at the time!⟪k:8⟫About how unexpectedly handsome you were!⟪k:9⟫But I couldn’t "
"bring myself to say it!"
msgstr ""
"⟪k:0⟫Я-⟪k:1⟫Я—⟪k:2⟫⟪k:3⟫Я не имела это в виду на самом деле!⟪k:4⟫⟪k:5⟫Я просто, ⟪k:6⟫ну знаешь, "
"⟪k:7⟫в то время была немного потрясена!⟪k:8⟫От того, насколько неожиданно красив ты оказался!⟪k:9⟫"
"Но я не могла сказать это вслух!"

#: omake:omake_DE51EA4A_A870_40CF_91A4_9D835B779A79
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 1b0e86fb0dbe1056b47d76e7b4df81ee81308d833377ab060d6f15723a55daa4
#. default-sha256: 7e528ae5cfc3032c42f6abf9a8f215085267818bc4f3e01ef84ea985221e8f3d
msgctxt "omake:omake_DE51EA4A_A870_40CF_91A4_9D835B779A79"
msgid "⟪k:0⟫I hope you two sickening lovebirds spontaneously combust..."
msgstr ""
"⟪k:0⟫Надеюсь, с вами случится самопроизвольное возгорание, тошнотворные влюбленные пташки..."

#: omake:omake_7F2F89CD_77AE_4D18_96BE_501ABA446818
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 6bcacd5b7ce7bf9954b578288b9662cc18ea4ae731f275ca1dfbbc711f73bebd
#. default-sha256: dcb615bbe41a287751240532a6658b2ad0f67ca82c3a5806493bc6a679c19d76
msgctxt "omake:omake_7F2F89CD_77AE_4D18_96BE_501ABA446818"
msgid ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫As the true master of this house, I am everywhere at all times.⟪k:3⟫⟪k:4⟫Even in "
"the bathrooms."
msgstr ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫Поскольку я истинная Хозяйка этого дома, я повсюду в любую секунду.⟪k:3⟫⟪k:4⟫Даже "
"в уборных."

#: omake:omake_05A8DDD2_7450_494D_9A7A_1B323EC72C6E
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 1effd758a8f07721ee77140bb384453e7545b3ed3394414056517ecdce831d41
#. default-sha256: 048d06fe3171ff14fafde6b946d87ae801062ce3cc188991146cac48c3251250
msgctxt "omake:omake_05A8DDD2_7450_494D_9A7A_1B323EC72C6E"
msgid ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫I think that’s enough toilet humor for the time being.⟪k:3⟫⟪k:4⟫Especially in "
"front of our guest."
msgstr ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫Пожалуй, для одного раза достаточно туалетного юмора.⟪k:3⟫⟪k:4⟫Особенно в "
"присутствии нашего гостя."

#: omake:omake_FD6983FC_6500_4BC7_BE9D_0AC6E8F24B4A
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 2e0d73c67b786496541e944431c176dc359971af260f221379bc00bc3c12fc8e
#. default-sha256: 91ae0fa712dfb9a3c7699ab7005fdaccb18a4d013bf549f8e744433be36af2f0
msgctxt "omake:omake_FD6983FC_6500_4BC7_BE9D_0AC6E8F24B4A"
msgid "⟪k:0⟫⟪k:1⟫It just... ⟪k:2⟫never really seemed that way to me..."
msgstr "⟪k:0⟫⟪k:1⟫Просто... ⟪k:2⟫я никогда себя так не воспринимал..."

#: omake:omake_8BA87D65_BDE0_4565_B0AE_E16CA2BF4C6D
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 0474c43b9c384a005cd3a5b59fc092a96294c4a28a8dbbaec59a615c73b2d258
#. default-sha256: 4a6ba76c0bce7cc0fe78ca84a636464d64fcef71f4c7cd242898eb6c32f30ef0
msgctxt "omake:omake_8BA87D65_BDE0_4565_B0AE_E16CA2BF4C6D"
msgid ""
"⟪k:0⟫⟪k:1⟫But once you reclaimed yourself, you were most definitely playing the protagonist. ⟪k:2⟫"
"Especially the final chapter! You had me swooning by the end!"
msgstr ""
"⟪k:0⟫⟪k:1⟫Но как только ты вспомнил себя, то определенно стал главным героем. ⟪k:2⟫Особенно в "
"последней главе! К финалу я была от тебя просто в восторге!"

#: omake:omake_48AEFCD0_9BAB_438B_A1E5_5BD013A1151B
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: c7282c010f6e62b1e8ae5f32c319eedd230c77fd78f53f79c8bbb615cb64c019
#. default-sha256: 459129e17144743b7a7bad2e87df121da7ccb594c10c32b72ccadc7701ddeafb
msgctxt "omake:omake_48AEFCD0_9BAB_438B_A1E5_5BD013A1151B"
msgid ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫What do you think, my dear? ⟪k:3⟫What any respectable behind-the-scenes extra "
"would do, of course—"
msgstr ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫А ты как думаешь, мой дорогой? ⟪k:3⟫Разумеется, то же, что обычно делают в любых "
"достойных закулисных дополнениях—"

#: omake:omake_2A7F3CA3_1134_4621_BF76_8BE0B1176ACB
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: d0a689e92a760e112936713f488ad3e06f58a4cd261b0e27d086d84dfeb0fa31
#. default-sha256: 0a44775060ef7e23ef733cee3d8a4961fbdd27637e2f9995a7cdcc0c0b468c3f
msgctxt "omake:omake_2A7F3CA3_1134_4621_BF76_8BE0B1176ACB"
msgid "⟪k:0⟫we’re going visit each room in the mansion and faff about like a bunch of fools."
msgstr "⟪k:0⟫мы посетим каждую комнату в особняке и будем насмехаться от души, как кучка идиотов."

#: omake:omake_060CE94C_E0AE_47B9_9D2B_6BC0BB35989D
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 2810cd08f8e5de7944d8a72d3ba52810e6f37e0f01cdd310e33cdb3fb539e06a
#. default-sha256: b10d82a68a4d62c3150b0936b91ec0a6453ec8e4e51fd231ecb20cc3c4dfeb9e
msgctxt "omake:omake_060CE94C_E0AE_47B9_9D2B_6BC0BB35989D"
msgid "⟪k:0⟫⟪k:1⟫............"
msgstr "⟪k:0⟫⟪k:1⟫............"

#: omake:omake_DD46117D_9ECB_4B85_BC2C_B5C1D59040E9
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: ca88e4a143f0de211d6fd9afaaac83041a8b7457fec184fb27a030d60c21c094
#. default-sha256: 3a01af045e1cb365706c15e1c89482462e33ed74732f428fa4c85644ec1d5adf
msgctxt "omake:omake_DD46117D_9ECB_4B85_BC2C_B5C1D59040E9"
msgid ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫You can’t deny a lot of readers probably didn’t expect the creepy white-haired "
"recluse to turn out to be the main character."
msgstr ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫Но ты же не можешь отрицать, что большинство читателей, скорее всего, не ожидали "
"увидеть в роли главного действующего лица жутковатого беловолосого затворника."

#: omake:omake_AB7DE4F2_5BDB_46C5_B426_851B3684F16C
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 888e0b16a1187d04e63a9f57d91de3f72e9a492132566ac60e6aeb414c9efcb9
#. default-sha256: 6b9820cb9cb24b290139498253ae2a0c604cb2d9f12cc7979eaf5e0e9b7e552d
msgctxt "omake:omake_AB7DE4F2_5BDB_46C5_B426_851B3684F16C"
msgid ""
"⟪k:0⟫Though perhaps there are some people whose interpretations did not change throughout the "
"course of the tales."
msgstr ""
"⟪k:0⟫Хотя, вероятно, есть люди, чьи интерпретации событий не изменились на протяжении всех "
"историй."

#: omake:omake_409E38F1_AD87_424A_9225_01F6D09C8F9D
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 4467e1fd0d5620ee59170453c519b36a465200ee55bf08fe532b7e3c8698b8d3
#. default-sha256: 93b6854889d27d879e114f4726ef06fc80176028e1f9284e8d70f879a47421b5
msgctxt "omake:omake_409E38F1_AD87_424A_9225_01F6D09C8F9D"
msgid "⟪k:0⟫⟪k:1⟫No, that’s not how you pronounce his name.⟪k:2⟫⟪k:3⟫As I recall, it’s Eucalyptus—"
msgstr "⟪k:0⟫⟪k:1⟫Нет, его имя звучит иначе.⟪k:2⟫⟪k:3⟫Насколько я помню, его звали, Эвкалиптус—"

#: omake:omake_0563CC2F_1F91_4F15_AA9C_CA7CEC8E9CA9
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: ccbfb2a062038cafc2b5c822d39dc6caff0120fa244a4d7c25a83c7e72ae5f08
#. default-sha256: 54fe7c395b0a7565252a2d7ccbc3ff45720b3a09578dbcdd3bb0ba1eaf6ea053
msgctxt "omake:omake_0563CC2F_1F91_4F15_AA9C_CA7CEC8E9CA9"
msgid ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫You already made that joke. Let it go, please.⟪k:3⟫⟪k:4⟫That creature doesn’t need "
"a name. Just call him “the beast.”"
msgstr ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫Ты уже использовал эту шутку.  Забудь о ней, пожалуйста.⟪k:3⟫⟪k:4⟫Этому существу "
"не нужно имя. Зови его просто “чудовищем”."

#: omake:omake_E6ED0CF4_EA96_43F7_8609_288EDFB5E6DA
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 54270a681818698da3e865cb7643d96f4515d2dfe0df5d3eab252232246c582a
#. default-sha256: 006837b86dcc6e1d82978b68352eebea0e4f91fe3f4f71ab9882842cb3d35a86
msgctxt "omake:omake_E6ED0CF4_EA96_43F7_8609_288EDFB5E6DA"
msgid ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫At the end of that chapter, you learn what kind of man he really was, which then "
"ties into the revelations in the final chapter."
msgstr ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫В конце той главы вы узнали, каким человеком он был на самом деле, что "
"впоследствии тесно переплетается с откровениями из финальной главы."

#: omake:omake_C5A798EB_B811_4ED8_AFAC_A061A9511D1D
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: c74eec995e795ecc94e0c754a16c21d094c15d962b5e5505047668d20ea50db2
#. default-sha256: 801635a9c4b0c19349b03dced24cd5e56d12b606c0f3b9af33c5d46e0bc6fe1a
msgctxt "omake:omake_C5A798EB_B811_4ED8_AFAC_A061A9511D1D"
msgid "⟪k:0⟫⟪k:1⟫.................."
msgstr "⟪k:0⟫⟪k:1⟫.................."

#: omake:omake_50B816BD_A179_493D_9A53_C8C56CE248FA
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 53d40a448a139a291b479eb13b409431d6d2fe253555cf8ddd942e194ba741f3
#. default-sha256: a06093724cad278fc6d97ef27a7df559abe253636a8c916d5379a2e84639de6a
msgctxt "omake:omake_50B816BD_A179_493D_9A53_C8C56CE248FA"
msgid "⟪k:0⟫I don’t hold it against you, though."
msgstr "⟪k:0⟫Хотя я не злюсь на тебя за это."

