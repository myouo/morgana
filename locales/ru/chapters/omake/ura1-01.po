msgid "⟪k:0⟫⟪k:1⟫............"
msgstr "⟪k:0⟫⟪k:1⟫............"

#: omake:omake_EB141178_93DE_4E33_BC7A_D412F671736F
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 77aec6ebc70c334000ab9afd425666010a8b1ea8d42a4adeb08795a5e9b86042
#. default-sha256: 060ee239cf083b879d5b848446dea66bc12f1518b622c0bf6414f500bad40ddd
msgctxt "omake:omake_EB141178_93DE_4E33_BC7A_D412F671736F"
msgid "⟪k:0⟫⟪k:1⟫Wait, what guest?"
msgstr "⟪k:0⟫⟪k:1⟫Постой, какого гостя?"

#: omake:omake_8ECB75DE_A59F_4C1D_BB6E_A69FF03B42DB
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 2f794b5eed0aa57f87d5aee8f556ee7b779dd07c7c45dd7e631d5422b9f1cef8
#. default-sha256: 5a25c2c17f5372e444312bab0f1885e09723d34da0dac7fd01b2044ea2477cda
msgctxt "omake:omake_8ECB75DE_A59F_4C1D_BB6E_A69FF03B42DB"
msgid "⟪k:0⟫⟪k:1⟫⟪k:2⟫Oh, so you can’t see the soul beside me?⟪k:3⟫⟪k:4⟫That’s quite a shame."
msgstr "⟪k:0⟫⟪k:1⟫⟪k:2⟫Ох, так вы не видите душу рядом со мной?⟪k:3⟫⟪k:4⟫Весьма прискорбно."

#: omake:omake_13AF1031_2797_48CE_9EED_67E0B79A030B
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 432daa30f7250032e7d6f235e25dd1c3a01b1546e98ae542a4d1d74519413ad3
#. default-sha256: 35d6d24bff1e1450294c50e946e7546758e312e9994d00c4ec41aef488f7e38e
msgctxt "omake:omake_13AF1031_2797_48CE_9EED_67E0B79A030B"
msgid ""
"⟪k:0⟫⟪k:1⟫Could they be who was watching over us?⟪k:2⟫⟪k:3⟫I had better give them my thanks, then."
msgstr ""
"⟪k:0⟫⟪k:1⟫Может, это они присматривали за нами?⟪k:2⟫⟪k:3⟫В таком случае мне следует их "
"поблагодарить."

#: omake:omake_E7370332_3116_4855_B56E_38B937D881A9
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 722111e6a9e81d98e61dd1a79a123c2e243728d49a00b7d9f1c20d0cce388b13
#. default-sha256: 7c179aa67f9c4b8c36a8e108fd4f125ef34ba1f97174f347024ce639fc7de965
msgctxt "omake:omake_E7370332_3116_4855_B56E_38B937D881A9"
msgid "⟪k:0⟫⟪k:1⟫Go on, Michel! You thank them too!"
msgstr "⟪k:0⟫⟪k:1⟫Ну же, Мишель! Ты тоже поблагодари!"

#: omake:omake_A43EC56E_9520_4C84_AD32_DAE2241E4ABC
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 4d984f6b5d95915d6497fbf1c0b2efb184863dc9a8b02686de0a58685b3ce330
#. default-sha256: 06788b28c101a1002a169c4c2b8aabc22285ad585a26aa6d1887acc0a7cbc6d0
msgctxt "omake:omake_A43EC56E_9520_4C84_AD32_DAE2241E4ABC"
msgid "⟪k:0⟫⟪k:1⟫...Could you really consider me the protagonist?"
msgstr "⟪k:0⟫⟪k:1⟫...Неужели ты, и в самом деле, можешь называть меня главным героем?"

#: omake:omake_0535F53B_0B78_4FF4_9665_CF91D0F6BE66
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 3cb2b06998479d98f865010c8b8dd6c45ef979b76d661c328f784f6bafc6ea91
#. default-sha256: 2563dc78f1b17a87967236d2db37b3fb5aa21db56e6e259c85ef43917de53ce8
msgctxt "omake:omake_0535F53B_0B78_4FF4_9665_CF91D0F6BE66"
msgid "⟪k:0⟫⟪k:1⟫⟪k:2⟫What, did you hit your head and lose your memory again?"
msgstr "⟪k:0⟫⟪k:1⟫⟪k:2⟫Ты что, ударился головой и тебе снова отшибло память?"

#: omake:omake_9843F3CD_5378_4F13_99A0_EB4DB9DFFDAB
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 59bccc36bcd95dde57d9cc114ca0eaa9c920e1b5a8630a94356d382c6572405b
#. default-sha256: 0b2caa55b98061200df729d58ee787da12e0117c3ef27a0c1a4b26c79f4b9f5b
msgctxt "omake:omake_9843F3CD_5378_4F13_99A0_EB4DB9DFFDAB"
msgid ""
"⟪k:0⟫⟪k:1⟫I can understand that. You didn’t become an active participant in the story until the "
"end of chapter four, Michel."
msgstr ""
"⟪k:0⟫⟪k:1⟫Я понимаю. Ты стал активным участником истории только по окончании четвертой главы, "
"Мишель."

#: omake:omake_EBB6EEB5_503B_4CCA_A351_CAA54BC41BEC
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 79ab7915d41d2c2dbc75fd11b9910105490315cb57b78994d0dbd0023d29ac3d
#. default-sha256: 8b327a85a9566b9f5eda8f16e87bb48c095c184c6772646edb9d55f77ea5cd2c
msgctxt "omake:omake_EBB6EEB5_503B_4CCA_A351_CAA54BC41BEC"
msgid "⟪k:0⟫⟪k:1⟫⟪k:2⟫I’m going to bring Michel with me—⟪k:3⟫⟪k:4⟫and only Michel."
msgstr "⟪k:0⟫⟪k:1⟫⟪k:2⟫Я намерена взять Мишеля с собой — ⟪k:3⟫⟪k:4⟫и только Мишеля."

#: omake:omake_FBF76F19_EE33_4711_BED9_9E49CBFF35BD
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 2810cd08f8e5de7944d8a72d3ba52810e6f37e0f01cdd310e33cdb3fb539e06a
