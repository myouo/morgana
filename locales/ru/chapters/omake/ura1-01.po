msgid "⟪k:0⟫⟪k:1⟫............"
msgstr "⟪k:0⟫⟪k:1⟫............"

#: omake:omake_0D782DCD_1F8E_4EDE_86D5_7FE93BA39787
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: de4ebcd5ac50c8f895ab023c5a21afe8a97dcfa9ac8ee0553f6b3239b1855b38
