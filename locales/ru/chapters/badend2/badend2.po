msgctxt "badend2:badend2_5AAFDCC9_D8B2_A4C8_7B06_CF901FBEDD88"
msgid "⟪k:0⟫The sweet tone of her voice.⟪k:1⟫⟪k:2⟫Her cold fingers.⟪k:3⟫⟪k:4⟫Her icy smile."
msgstr "⟪k:0⟫Нежный тон ее голоса.⟪k:1⟫⟪k:2⟫Ее холодные пальцы.⟪k:3⟫⟪k:4⟫Ее ледяная улыбка."

#: badend2:badend2_60B37471_CF71_4582_AC06_A3A0CD0EBC0D
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 5c796271f6ee2d2ff6ced4876ee6bf5309c9af84fe75f1686fff30d37e87f92a
