#: badend5:badend5_F770B190_B8F6_499E_8CEC_B78F26A93231
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: ee6132616572561ad0f15f3911b94b3abd70927738392e09cd77d07497f668f5
#. default-sha256: eaeed68f5b377d80dc2a895bf76d2d67084b363e935bed4ec82b2bb86d2ef6bb
msgctxt "badend5:badend5_F770B190_B8F6_499E_8CEC_B78F26A93231"
msgid ""
"⟪k:0⟫I’ve been trying to get your attention for some time,⟪k:1⟫⟪k:2⟫but you were just staring off "
"into the distance."
msgstr ""
"⟪k:0⟫Я уже некоторое время пытаюсь привлечь твое внимание,⟪k:1⟫⟪k:2⟫но ты лишь смотришь в одну "
"точку."

#: badend5:badend5_0011E79A_AD44_4DF5_AAC0_047855618F3F
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
