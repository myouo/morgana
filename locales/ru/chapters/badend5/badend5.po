msgid "⟪k:0⟫............"
msgstr "⟪k:0⟫............"

#: badend5:badend5_97113EAB_1C5C_404C_959A_3651C60A21A5
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 286290bbd607033008dcc5c38d80fa0048be37a0e7284b95f67ca7f42be7e29a
#. default-sha256: 2087b608622c3cd3ff78f7023c0bf5a1b8c4131346a5dc3bb44bcb927d4eaad9
msgctxt "badend5:badend5_97113EAB_1C5C_404C_959A_3651C60A21A5"
msgid "⟪k:0⟫It was a day just like any other."
msgstr "⟪k:0⟫Это был такой же день, как и все остальные."

#: badend5:badend5_16E70DB7_800A_4AB5_8915_E9E4B83CA6A1
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 615daebf43e01a28224f2123a65b597be87c20ac58d6bd76084914c69249fb92
#. default-sha256: c3d949413f871ee6317ce4f3e274e5f9797807480e610ef13106efe5cc975e4d
msgctxt "badend5:badend5_16E70DB7_800A_4AB5_8915_E9E4B83CA6A1"
msgid ""
"⟪k:0⟫A layer of clouds drifted slowly across the sky.⟪k:1⟫⟪k:2⟫We sat across from one another at "
"a café’s outdoor table."
