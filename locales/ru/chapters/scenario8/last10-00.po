msgctxt "scenario8:scenario8_7127F800_978D_415A_8267_11EC7B9C8592"
msgid "⟪k:0⟫⟪k:1⟫The time has come to start anew!"
msgstr "⟪k:0⟫⟪k:1⟫Пришло время все начать сначала!"

#: scenario8:scenario8_40D851D5_8FD4_4474_8B95_059DFDDEDC73
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 8e6006c3cc20e668383e78783183b97d9de55bbabc8565d3b8fe3ce0e0551114
