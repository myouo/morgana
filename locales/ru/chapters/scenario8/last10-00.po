msgid "⟪k:0⟫⟪k:1⟫Victims of this terrible tyrant!"
msgstr "⟪k:0⟫⟪k:1⟫Жертвы безжалостной тирании!"

#: scenario8:scenario8_7127F800_978D_415A_8267_11EC7B9C8592
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 5c21d3de28887fc0251776e40976353f135440568652b5d59b4250f4f31b143d
