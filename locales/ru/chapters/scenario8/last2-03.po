msgid "⟪k:0⟫(And today, you’re the fire to my oil.)"
msgstr "⟪k:0⟫(И сегодня ты подливаешь масла мне в огонь.)"

#: scenario8:scenario8_B4B729B5_977A_4A71_A8C6_371D901CA8C8
