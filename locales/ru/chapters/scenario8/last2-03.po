msgid "⟪k:0⟫⟪k:1⟫⟪k:2⟫No need to apologize for the truth."
msgstr "⟪k:0⟫⟪k:1⟫⟪k:2⟫Не нужно извиняться за правду."

#: scenario8:scenario8_F6ACCCD6_9C77_43C8_9909_208AA8649AA1
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: d03c5c5980bc73dac7961289968b2f1ab200fab9e27bca57b8c6b46a7c748d7c
