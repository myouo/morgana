msgctxt "scenario8:scenario8_837E4EB5_6197_46D7_B145_2F8C50D9FDE4"
msgid ""
"⟪k:0⟫(That was entirely unnecessary of me.⟪k:1⟫⟪k:2⟫Giselle did not need to be reminded of that.)"
msgstr ""
"⟪k:0⟫(Не было необходимости с моей стороны так поступать.⟪k:1⟫⟪k:2⟫Жизель не нужно об этом "
"напоминать.)"

#: scenario8:scenario8_40A770ED_D15B_4D83_B543_EDE6D1851647
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 49e725041789833028dfc3900632584084f494400fc61605a03a278299795d04
