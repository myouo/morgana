msgid "⟪k:0⟫⟪k:1⟫............"
msgstr "⟪k:0⟫⟪k:1⟫............"

#: scenario8:scenario8_2EB39580_FF7B_4387_B185_A520655DDDAA
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 5d1f3ed1f3f02f47316b4b940fdcf6f397c7ff4106995e1765ea8659aa90fe27
#. default-sha256: 1a6a8d6c4dc2ea759fe34cfeb984a3afc9a386a201a930c0ab2cf020e768ee3a
msgctxt "scenario8:scenario8_2EB39580_FF7B_4387_B185_A520655DDDAA"
msgid ""
"⟪k:0⟫⟪k:1⟫We’ll probably have more luck asking than just searching for her. ⟪k:2⟫If we can’t find "
"Mell, the nun might know."
msgstr ""
"⟪k:0⟫⟪k:1⟫Думаю, нам повезет больше, если мы спросим о ней, вместо того, чтобы искать наобум. "
"⟪k:2⟫Если мы не сможем найти Мелла, думаю, монахиня нам поможет."

#: scenario8:scenario8_49B91D93_C7F9_4BB2_B3FC_8873EEEDA737
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 20037e8c78f0829e8aba65384b27de285ea78ebd42787b8930a5bf5e23cff9e3
