msgid "⟪k:0⟫⟪k:1⟫But there ⟪k:2⟫is⟪k:3⟫ you and me!"
msgstr "⟪k:0⟫⟪k:1⟫Но ⟪k:2⟫есть⟪k:3⟫ ты и я!"

#: scenario8:scenario8_ED1A42F4_0083_47E0_B467_4E7A0F97768E
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 995a81e35de80e27b74e583515106bd83b1be4c9ad9d3530dee13b7421e11bba
#. default-sha256: 70c38d3817bad1a8b2164c4eea742a76412e3d7219150a211ad7a26b0d045cae
msgctxt "scenario8:scenario8_ED1A42F4_0083_47E0_B467_4E7A0F97768E"
msgid "⟪k:0⟫⟪k:1⟫Honestly, I can live without shiny shoes and pretty dresses like Mother wears."
msgstr ""
"⟪k:0⟫⟪k:1⟫Честное слово, я могу прожить без сверкающих туфель и красивых нарядов, вроде тех, что "
"носила Матушка."

#: scenario8:scenario8_295676A1_D635_4341_8FD6_1EA3D4F425A7
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: b81709301421a3fa82d49449210cbfa5b46a9e3333025e86f0fe5e2a92751b17
