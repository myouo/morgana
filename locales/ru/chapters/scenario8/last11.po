msgid "⟪k:0⟫⟪k:1⟫⟪k:2⟫...Is there someone else in there with her?"
msgstr "⟪k:0⟫⟪k:1⟫⟪k:2⟫...Там с ней есть кто-то еще?"

#: scenario8:scenario8_8FE029FB_D592_49EB_9D67_18DFF2710A8C
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 5984a26d4b956dac075f4bf304bef2753f7bb3dde8799652c4d8156f84f1d8db
#. default-sha256: 616189c6d00df3e35c3299fabd194356f542474a7e67848d4c014a19f3317738
msgctxt "scenario8:scenario8_8FE029FB_D592_49EB_9D67_18DFF2710A8C"
msgid "⟪k:0⟫⟪k:1⟫⟪k:2⟫There couldn’t be. It’s only Morgana."
msgstr "⟪k:0⟫⟪k:1⟫⟪k:2⟫Нет, никого не должно быть. Там только Моргана."

#: scenario8:scenario8_90CC1DC7_EBA9_415C_975A_E1CCEC9571C7
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 4a25c759f2ee0e72c8a2699028014d1e1d7b32adce389d9b63f4cace7cd4c347
#. default-sha256: d17e19dd3781992fa665ca593595857338597a1dc44657fc900c0f14d098088f
msgctxt "scenario8:scenario8_90CC1DC7_EBA9_415C_975A_E1CCEC9571C7"
