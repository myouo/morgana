msgid "⟪k:0⟫That is not my “opinion.”⟪k:1⟫⟪k:2⟫That is the way of the world, as God—"
msgstr "⟪k:0⟫Это не мое “мнение”.⟪k:1⟫⟪k:2⟫Такова суть мира, как глаголет Господь —"

#: scenario8:scenario8_BB0124A9_7920_4F1C_90C6_D2981125AC22
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 75236a4f5952ef176b8eff8e14aec03539338b199f171de06ead097f2c242a97
