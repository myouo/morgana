msgctxt "scenario8:scenario8_3737D91C_677F_4BC1_BCC4_B8F5346B51B4"
msgid "⟪k:0⟫God, I hope I don’t screw this up..."
msgstr "⟪k:0⟫Господи, надеюсь, я не оплошаю..."

#: scenario8:scenario8_74B5F612_B242_4764_BB39_CF8668431DB1
