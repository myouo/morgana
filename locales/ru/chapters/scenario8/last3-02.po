msgstr "⟪k:0⟫⟪k:1⟫⟪k:2⟫...Х-⟪k:3⟫Хорошо."

#: scenario8:scenario8_E3CEB4C4_51B4_4C52_A66E_756397078185
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: ab4a87e0b21df8f44ef2d74fb1cd19aa857640433835824d4a095dff182a88ad
#. default-sha256: ecf1562605a920efe27d0d0ae2fe9c88898cdc6e586a735e9102c7698a10440a
msgctxt "scenario8:scenario8_E3CEB4C4_51B4_4C52_A66E_756397078185"
msgid "⟪k:0⟫The chefs back home always took care of it."
msgstr "⟪k:0⟫Дома это была забота поваров."

#: scenario8:scenario8_3737D91C_677F_4BC1_BCC4_B8F5346B51B4
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: ec7320467b93cb4d31a24d1715bc1f1db7dc241bf68502e643a73bb6a00423ad
