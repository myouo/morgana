msgid "⟪k:0⟫............"
msgstr "⟪k:0⟫............"

#: scenario8:scenario8_79712892_9343_4B71_A0BB_50F73D1F310E
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: b81168a56bc23ca1a4381230bc5237e930c091a5529820c16efe90d84686c50d
#. default-sha256: 6a7387c01f1c3fb79913f6e969c6e3e591de258d696c6846ccb4c4d352bc6816
msgctxt "scenario8:scenario8_79712892_9343_4B71_A0BB_50F73D1F310E"
msgid ""
"⟪k:0⟫Through our conversations, I managed to learn her name, as well as the fact that she had "
"come here from a faraway country. ⟪k:1⟫We were both a long way from home."
msgstr ""
"⟪k:0⟫Благодаря нашим беседам, я узнал ее имя, а также то, что она прибыла сюда из далекой страны. "
"⟪k:1⟫Мы оба находились вдали от дома."

#: scenario8:scenario8_E2A036F1_5F1D_4E75_BFE8_F62D13021E14
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: d2798dea987cde6536b2178f77d361740e768492065c9e6193176b5912608ff7
#. default-sha256: 5890f4685ae6cf95054f77a6d106f6c0acd3bfd3a6361d4f5ab28ffec5476713
msgctxt "scenario8:scenario8_E2A036F1_5F1D_4E75_BFE8_F62D13021E14"
msgid "⟪k:0⟫...To my surprise, she accepted."
msgstr "⟪k:0⟫...К моему удивлению, она согласилась."

#: scenario8:scenario8_31622FA0_C332_4EC0_8D02_3F8EF5AECB7D
