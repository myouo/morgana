msgstr "⟪k:0⟫⟪k:1⟫............"

#: scenario8:scenario8_FBBFEFF1_619A_4F88_8375_DE6C26E53BA0
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 1fa8059517b56f117c5ba56f565044b44f281fe403ffd532642377f1430070c4
#. default-sha256: d73e0d86e03d0dd10e2420132bdcecf0a9c41c5c096bf93d75685f6f9e357b30
msgctxt "scenario8:scenario8_FBBFEFF1_619A_4F88_8375_DE6C26E53BA0"
msgid "⟪k:0⟫⟪k:1⟫I’m... ⟪k:2⟫in disbelief, to tell you the truth."
msgstr "⟪k:0⟫⟪k:1⟫Меня... ⟪k:2⟫обуревают сомнения, сказать, по правде."

#: scenario8:scenario8_D3734CB1_2063_47D3_8025_51EC94F9889E
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 232139464426f015116c379f48096d267595dc7fb80c8b04aeef1e370d5dc342
