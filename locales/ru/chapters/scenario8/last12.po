msgid "⟪k:0⟫I ⟪k:1⟫accomplished⟪k:2⟫ something."
msgstr "⟪k:0⟫Чего-то я все-таки ⟪k:1⟫достиг⟪k:2⟫."

#: scenario8:scenario8_9C6ECEBE_D077_4098_BD2B_1FA6B64D6C53
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 13b948fbce3e4d0c9ac6abe23dd705c5111b605402ac29b4b2960174fc067aee
#. default-sha256: 8d69535c25cd91356c382f209048c774d7d3995319423f32d7b5de69f6ed4999
