msgid "⟪k:0⟫⟪k:1⟫I wasn’t able to prevent Morgana’s death,"
msgstr "⟪k:0⟫⟪k:1⟫Я не смог предотвратить смерти Морганы,"

#: scenario8:scenario8_5936BA73_B67E_4639_9327_7606198B04B6
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 1dc75be601e77079b2b3c912cb66c1d01f0116e678d3321ddb48318ae74b0819
