msgid "⟪k:0⟫The sum of everything I did these three days..."
msgstr "⟪k:0⟫Того, что я сделал за три дня..."

#: scenario8:scenario8_CB3C7978_9C00_4437_A359_E6D28E83A517
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 64162555400e0e6d51d3a3e04b89fd0eeef3ddf2bdc8dfe49cd818ddc4738289
#. default-sha256: 52e0036e11d9fe1f435a9c6da3133b819b465c44e785a08865fce7c413afe543
