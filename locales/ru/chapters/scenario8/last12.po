#: scenario8:scenario8_AED42863_A424_4B04_8542_1D46FD5715DA
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: e2a16711961b4ed6860fa0b87798a469250a4ea111c1f3c6810f3dc09c2286d9
#. default-sha256: d0f27919b526f75f1bf0e77834e8d0f43b6adf783dff3bdd1e298e0d8732d1b5
msgctxt "scenario8:scenario8_AED42863_A424_4B04_8542_1D46FD5715DA"
msgid "⟪k:0⟫⟪k:1⟫He opens the door, heading the four-man procession out of the tower, as he had in."
msgstr "⟪k:0⟫⟪k:1⟫Он открыл дверь, возглавляя процессию из четырех мужчин выходящих из башни."

#: scenario8:scenario8_C1DB5E46_FA01_4DD6_8F5E_004447434A7E
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 5d7ded1cf6359a15acf293832f05bee322a6bc3977879195be8977793106da3d
#. default-sha256: aaba3c253870fe4aa7eaebc87cc153a6a66a31cc27d8c1e76003f5acd1314ebf
msgctxt "scenario8:scenario8_C1DB5E46_FA01_4DD6_8F5E_004447434A7E"
msgid "⟪k:0⟫I walk at the back of the line."
msgstr "⟪k:0⟫Я шел позади всех."

#: scenario8:scenario8_B95A895B_0AE5_4A8E_B7B5_384C42CA534F
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: a59d9779ebda193adbe743f68ac9949390c0298dd3b43f9a2b0c9c42d47f421f
#. default-sha256: c88bec87aebe4702db0c69d549db07e4978824580b1e01d56a04cd747c6ccdab
msgctxt "scenario8:scenario8_B95A895B_0AE5_4A8E_B7B5_384C42CA534F"
msgid ""
"⟪k:0⟫Each step they take down the spiral staircase is slow and ponderous,⟪k:1⟫⟪k:2⟫as if weighted "
"down by the knowledge of their sins."
msgstr ""
"⟪k:0⟫Каждый шаг, который они совершали, спускаясь по спиральной лестнице,⟪k:1⟫⟪k:2⟫был медленным "
"и тяжелым, будто над ними довлел груз осознания их грехов."

#: scenario8:scenario8_BEE19C25_4387_4098_BC3E_91D6906BBC5A
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 2a03fbd8a51e743c127a5c429b9651d843b837ce0233c34b4f08b5a50c1cdb9b
#. default-sha256: 2dabd6b27b7d2a362801866d080b12ba25931ab3152f8bd89a4f668741b1629f
msgctxt "scenario8:scenario8_BEE19C25_4387_4098_BC3E_91D6906BBC5A"
msgid "⟪k:0⟫That they must make their way..."
msgstr "⟪k:0⟫Они понимали, что должны идти вперед..."

#: scenario8:scenario8_C4712DCB_C162_4710_879A_2EEF4DA9452E
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: c10f8ed88608f1bf956b6d634a31affc0481c1f522661ffd8bbf4cc845041b1f
