#: scenario8:scenario8_6859F8BA_2B60_443D_A146_6359F9BCC8F3
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 93394b12ebd4982c78d50db35d090055318bedc9d84f8b3ed2c1498643e06e2e
#. default-sha256: 3d12e522989dfa4cb0088e60d97dfe9a98bbd1546f6c07ebe7ae3fb1b5816522
msgctxt "scenario8:scenario8_6859F8BA_2B60_443D_A146_6359F9BCC8F3"
msgid "⟪k:0⟫⟪k:1⟫That endless expanse of red earth"
msgstr "⟪k:0⟫⟪k:1⟫Бескрайний простор рыжеватой земли"

#: scenario8:scenario8_A4A3F35D_D62F_4F2A_B280_64EB88F05101
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 0bcf7ade4591ffe2fb4ac06d3904567879a115a4cd84fcd5cdca73aaf16d5621
#. default-sha256: 328a7d8d4c4da192523d852a86137e8ab854c4514f1a0563bda88b9e2d395a7e
msgctxt "scenario8:scenario8_A4A3F35D_D62F_4F2A_B280_64EB88F05101"
msgid "⟪k:0⟫⟪k:1⟫remains branded into the very fabric of my mind."
msgstr "⟪k:0⟫⟪k:1⟫всегда стоит перед моим мысленным взором."

#: scenario8:scenario8_86014BCE_50E9_48BD_9AD2_C18A9B08E47F
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 0e0dabca7865a98b0941a1c125c31431e2799cc8aab2dd3cbd3c9f75ffda3d89
#. default-sha256: d4aae2819f7ad3a64f39fdbb20d8284bffaa1cd3b188b7f541b0a6049d65eb5c
msgctxt "scenario8:scenario8_86014BCE_50E9_48BD_9AD2_C18A9B08E47F"
msgid "⟪k:0⟫That’s where it was decided someone built like I am would be the most use, I suppose."
msgstr ""
"⟪k:0⟫Думаю, тогда-то и было решено, что кто-то настолько крепкий и выносливый сгодится для "
"подобной работы."

#: scenario8:scenario8_EFE14CCC_A8CF_4BAA_BE17_57EA45F3D07C
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 0283fff69c8893a939842baa78aa9a87ca49b4deb8b582953ff36a5cc836a748
#. default-sha256: fc79383a2b010f47e3415cfb6f172ddd88e7e85c16b025839ff5b7335996ee97
msgctxt "scenario8:scenario8_EFE14CCC_A8CF_4BAA_BE17_57EA45F3D07C"
msgid ""
"⟪k:0⟫But I could tell from their tone of voice and expressions that the things they were saying "
"were not friendly. ⟪k:1⟫They seemed to be mocking me, laughing at me."
msgstr ""
"⟪k:0⟫Но по тону их голосов и выражениям лиц я мог сказать, что говорили они отнюдь не дружелюбные "
"вещи. ⟪k:1⟫Казалось, будто они издевались и насмехались надо мной."

#: scenario8:scenario8_CDC5F7AC_8330_457D_B164_F088B8DEC181
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: e79c97aba881346d00358f9263e5506127b42ef3acd2f21ed14a310dfb578794
#. default-sha256: f6a0b43b17362194c6f8b0544de95bd390817172b88b7d1f8ed5475325b115bb
msgctxt "scenario8:scenario8_CDC5F7AC_8330_457D_B164_F088B8DEC181"
msgid ""
"⟪k:0⟫As you might expect, I attempted to protest,⟪k:1⟫but evidently, I had been beaten quite "
"badly while I was unconscious."
msgstr ""
"⟪k:0⟫Как ты догадываешься, я попытался сопротивляться,⟪k:1⟫но очевидно, пока я был без сознания, "
"меня сильно избили."

#: scenario8:scenario8_189711F9_D6CC_485D_95C3_728672FF3E07
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 5d712a42b84b12d51590463dc65e983e39ebfd39c3ef8a28e0ce0306e865950f
#. default-sha256: 99680248640f6c2b7696f6491b77da58a2179acea93b4d019d3309127ee32d8a
msgctxt "scenario8:scenario8_189711F9_D6CC_485D_95C3_728672FF3E07"
msgid ""
"⟪k:0⟫My joints were stiff and swollen, on top of my dehydration,⟪k:1⟫so I could barely move, let "
"alone put up a fight."
msgstr ""
"⟪k:0⟫Мои суставы опухли и задеревенели, вдобавок я был обезвожен,⟪k:1⟫поэтому с трудом мог "
"передвигаться, не говоря уже о том, чтобы дать отпор."

#: scenario8:scenario8_64D83DD8_B6FF_487B_AA17_AC0B63B424CF
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 05271db40aa690e6335ac47c48e717e0e2c1bb0094e0b659858bd934a0851ced
#. default-sha256: 9aeb4bf774dbe7799e1b7b2e9cf1dfd5df7c3da325b5b3d896efffabb85647d1
msgctxt "scenario8:scenario8_64D83DD8_B6FF_487B_AA17_AC0B63B424CF"
msgid ""
"⟪k:0⟫As strong as I might have been at full health, I was in no condition to do anything then."
msgstr ""
"⟪k:0⟫Насколько бы силен я не был, находясь в полном здравии, в тогдашнем своем состоянии я ничего "
"не мог сделать."

#: scenario8:scenario8_475C661B_0BE8_4B09_A455_E9CE8A5CCB88
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 376195438aca46dfd1e31e7fe98968ae70eb644b736d11318e4664c9cee27b5d
#. default-sha256: 79076cb3ce6b74de194bb00ed92ae869eb63cb512378491089e5ac14ca341b06
msgctxt "scenario8:scenario8_475C661B_0BE8_4B09_A455_E9CE8A5CCB88"
msgid ""
"⟪k:0⟫They had many words to describe me, none of them flattering.⟪k:1⟫⟪k:2⟫Some of them would "
"even call me “beast.”"
msgstr ""
"⟪k:0⟫У них было много слов, чтобы описать меня и ни одно из них не было лестным.⟪k:1⟫⟪k:2⟫"
"Некоторые из них даже называли меня “чудовищем”."

#: scenario8:scenario8_5244F813_E939_4660_BDB7_59797A6E7A7D
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 834200b48c8bf68540fde9dfe0800b939ec456a5212fdffdf3961b0b009daa42
#. default-sha256: ab7370bab75b1ea367af26a3901ef988d7a992de06937df320430bb6098f5d26
msgctxt "scenario8:scenario8_5244F813_E939_4660_BDB7_59797A6E7A7D"
msgid ""
"⟪k:0⟫The slave trader’s guards were armed, of course.⟪k:1⟫⟪k:2⟫Swords hanging from their hips, "
"ready to cut down anyone who showed any sign of resistance."
msgstr ""
"⟪k:0⟫Конечно же охранники работорговцев были вооружены.⟪k:1⟫⟪k:2⟫У них на бедрах висели мечи, "
"готовые разрубить любого, кто попытается оказать хоть малейшее сопротивление."

#: scenario8:scenario8_95934EAA_5C56_448B_B646_04C8D400B5E6
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: b670ae9c2046113345ab0bd0e64d1aaa4c52ac8bedd374781d1ebd45d5ed97b4
#. default-sha256: 378deaa5ed105d3da99383e057277190f3f9c77f133f90de62b71a2d0dba2a83
msgctxt "scenario8:scenario8_95934EAA_5C56_448B_B646_04C8D400B5E6"
msgid "⟪k:0⟫So they sat there, lamenting their fate."
msgstr "⟪k:0⟫Поэтому они просто сидели там, оплакивая свою судьбу."

#: scenario8:scenario8_54ADD76B_A412_4AFA_BA50_2C9D1C49BD83
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 6425fe9d21e7adcc021f7a610a941e9ea3d5b393e98d332e4d03f93bd11b1648
#. default-sha256: 8b25cff378bd11dcc006456e89529b81a7374e9a5477346ef234621ef52561b5
msgctxt "scenario8:scenario8_54ADD76B_A412_4AFA_BA50_2C9D1C49BD83"
msgid ""
"⟪k:0⟫Glancing over at her, I caught a glimpse of her face—⟪k:1⟫⟪k:2⟫⟪k:3⟫large chunks of skin "
"seemed to have fallen off it."
msgstr ""
"⟪k:0⟫Бросив на нее взгляд, я мельком увидел ее лицо —⟪k:1⟫⟪k:2⟫⟪k:3⟫крупные лохмотья кожи, "
"казалось, отвалились от него."

#: scenario8:scenario8_3C09BB0D_D06D_4694_AFEE_33B7DB1722FE
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 79b9e8372770ff1efdea54304e4722649a8b11b0c4d204bdbf0ac7a5fc6a9e93
#. default-sha256: 3d3725eaab219786d8d213ead49c8de47a84f07e0a899dfe9a7a89e96d1c49a0
msgctxt "scenario8:scenario8_3C09BB0D_D06D_4694_AFEE_33B7DB1722FE"
msgid "⟪k:0⟫It was, suffice it to say, an unusual sight."
msgstr "⟪k:0⟫Это было, надо сказать, крайне необычное зрелище."

#: scenario8:scenario8_EA4C890F_1548_4752_A156_2A7C16C62C10
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: f085843e4e00b6c5b9a43b984a4782c6c457600f467bbbc21661bc34b62e9bd0
#. default-sha256: cbd9b8b730a7b4c8b1030bc5517721a8fc7de6d71f80404a4c3783ad7fcf7043
msgctxt "scenario8:scenario8_EA4C890F_1548_4752_A156_2A7C16C62C10"
msgid ""
"⟪k:0⟫I’m not sure how to describe it... ⟪k:1⟫but it seemed different somehow from everyone else "
"crying in the carriage. It was almost like..."
msgstr ""
"⟪k:0⟫Не знаю, как бы это описать... ⟪k:1⟫но ее плач отличался от тех стенаний, что издавали "
"остальные невольники в повозке. Казалось, будто..."

#: scenario8:scenario8_F2B7BADB_C3EA_40B1_AEE7_6D49DE1D5C3D
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: d7c31b7f151d16f88eafc3b6c39a137deb411421d4a8f1a1c8f3094c0003da6c
#. default-sha256: 313bf2953d8e6e050c911fcf5b60e0a83ce87130de178744e29c330767c43d32
msgctxt "scenario8:scenario8_F2B7BADB_C3EA_40B1_AEE7_6D49DE1D5C3D"
msgid "⟪k:0⟫her tears were not for herself."
msgstr "⟪k:0⟫она лила слезы не над своей участью."

#: scenario8:scenario8_4121FD91_F6D5_45F3_9CE9_623725AE1CC9
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: cdc6ec56e004d5066ff9809e3b2a3d371c1f319192764bda973308afc7adcbe0
#. default-sha256: e7b562ca503b6ed23665516e55bb10dbf93dcd97d7b3febedec6e54027104cf6
msgctxt "scenario8:scenario8_4121FD91_F6D5_45F3_9CE9_623725AE1CC9"
msgid "⟪k:0⟫Why are you crying?"
msgstr "⟪k:0⟫Почему ты плачешь?"

#: scenario8:scenario8_D6308C27_83A4_4537_B693_124430D2D1DC
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 2eab81480261d17d7db4369fee1e3270589ed0475727a577a79005203253b2ce
#. default-sha256: e39a109cd3b1821bd44870c4db789799c9853bcb4ba512036dbadfed2daeeac8
msgctxt "scenario8:scenario8_D6308C27_83A4_4537_B693_124430D2D1DC"
msgid "⟪k:0⟫After a moment’s hesitation, she said,"
msgstr "⟪k:0⟫Немного поколебавшись, она сказала,"

#: scenario8:scenario8_8D93A337_D2B1_4263_88A0_79A5D2C433CA
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 1912cc6412553fc6355c553df00961e4b00f39cefd5ce8bf25260ce2823008b5
#. default-sha256: 43c74f8bdc4feae72cce2972bc688e645c036e9e09a0a18377399555c48cc79c
msgctxt "scenario8:scenario8_8D93A337_D2B1_4263_88A0_79A5D2C433CA"
msgid "⟪k:0⟫For a moment, I was filled with a sense of tranquility,"
msgstr "⟪k:0⟫На миг меня наполнило чувство спокойствия,"

#: scenario8:scenario8_DD5FAAB1_FB91_428F_A8DF_2C1B7B49DC0C
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 271456d2935b12a125e2dd08474bbc36d4f84609d9bdd50fa35c6b2fb9dc9cfa
#. default-sha256: bb3ca092dfbc52dda3186907188913cbe46c5c1aa613a96bbd3b2951adce6933
msgctxt "scenario8:scenario8_DD5FAAB1_FB91_428F_A8DF_2C1B7B49DC0C"
msgid "⟪k:0⟫and though you may not believe it,"
msgstr "⟪k:0⟫и пускай ты можешь в это и не поверить,"

#: scenario8:scenario8_6C1999A0_BBCE_491A_9F11_3AA8BB65B59D
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: a469a58d7ad7fb61b5567604d508f89b3d75845cc83940c0251b8cf2b73e9069
#. default-sha256: a75e63574d3fe7d48966a4d578003f41adbc07ed32a56392f3dd05561f585ef1
msgctxt "scenario8:scenario8_6C1999A0_BBCE_491A_9F11_3AA8BB65B59D"
msgid "⟪k:0⟫This is no lie, I promise."
msgstr "⟪k:0⟫Даю слово, в этом нет лжи."

#: scenario8:scenario8_D377934A_089F_403D_A7CE_0876CD37C5EE
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 1811f75d3f4e2e81c3afd5e1515602c13ac3341aa9d80353b155fb66b99948b1
#. default-sha256: 48f41697b22461c825c2f67ac00db3078091b23a05c42741f58ec0ffc02c435d
msgctxt "scenario8:scenario8_D377934A_089F_403D_A7CE_0876CD37C5EE"
msgid "⟪k:0⟫............"
msgstr "⟪k:0⟫............"

#: scenario8:scenario8_C75B6762_6766_41AE_BA3B_52BF6A5BD0F5
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: e0a3453d134ffe3c5a5d79e641121b8b29c8c1e1f1df599e1452ab387dc5573a
#. default-sha256: 33b44d390c9d510d1b7044d52302b5a96c592d80fa944908fce51f9dc0801045
msgctxt "scenario8:scenario8_C75B6762_6766_41AE_BA3B_52BF6A5BD0F5"
msgid "⟪k:0⟫I’m begging you!"
msgstr "⟪k:0⟫Умоляю тебя!"

#: scenario8:scenario8_1774CFC9_2512_4570_AE5C_B1ACDF30C87C
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: a658bd221cc9281f355a698b5dff064db00aeb5d7f15099abf5693dff3cffcd3
#. default-sha256: 1d460d28b30c707a845ebe634c9e58d82446836892ca82e019c94de9278508dc
msgctxt "scenario8:scenario8_1774CFC9_2512_4570_AE5C_B1ACDF30C87C"
msgid ""
"⟪k:0⟫They let their guard down because we were restrained.⟪k:1⟫⟪k:2⟫The thought of anyone "
"resisting never once crossed their minds."
msgstr ""
"⟪k:0⟫Они позволили себе ослабить бдительность из-за того, что мы были скованы.⟪k:1⟫⟪k:2⟫Мысль о "
"том, что кто-то может оказать сопротивление никогда не приходила им в голову."

#: scenario8:scenario8_A91022C2_DDC8_404F_9E06_8CCEBACC812E
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 3d34a15a1dee9c7eedbe1fdecc08139e98cc0c55afafb9eb17b540b3ef10c9f6
#. default-sha256: 877d76e51f14471c4483d7597e4bf2c13da44753b27aa82c59557c25ffd013b5
msgctxt "scenario8:scenario8_A91022C2_DDC8_404F_9E06_8CCEBACC812E"
msgid "⟪k:0⟫Haha... ⟪k:1⟫hahahaha... ⟪k:2⟫heehee!"
msgstr "⟪k:0⟫Хаха... ⟪k:1⟫хахахаха... ⟪k:2⟫Хеехее!"

#: scenario8:scenario8_63E11C4C_470B_45C4_BDF5_9D1910BA3315
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 5591fefbdbc7c3f6fbef36dab8922b060cbf9bd79fccc7375c53f728463bf1c5
#. default-sha256: f0108b7c681f6820b62537666af0772ec62c2bec05d709e5a72fc3c9fce26a6f
msgctxt "scenario8:scenario8_63E11C4C_470B_45C4_BDF5_9D1910BA3315"
msgid "⟪k:0⟫More... ⟪k:1⟫I need more...⟪k:2⟫⟪k:3⟫I need moooooooooooore!"
msgstr "⟪k:0⟫Больше... ⟪k:1⟫Мне нужно больше...⟪k:2⟫⟪k:3⟫Мне нужно боооооооооольше!"

#: scenario8:scenario8_38158AE4_64C6_491B_98D3_B0BE5DA55015
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: fc92f582dbc911520a886da988d059bf7d08725f7729335cd12b97e9f4a5de61
#. default-sha256: 9cee1f5c386d55b981c4f5d13cff1a1b9c2465cf033e007a5fc50a25a7ea8c14
msgctxt "scenario8:scenario8_38158AE4_64C6_491B_98D3_B0BE5DA55015"
msgid "⟪k:0⟫But she said nothing, simply removing my shackles as commanded."
msgstr "⟪k:0⟫Но она ничего не сказала, а просто сняла мои оковы, как я требовал."

#: scenario8:scenario8_707AA80E_C68A_4C08_8E5F_B7EA77E984E7
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 76e785b01cab4bac46f9ca8369ea446be5f75f444be6fe82c007ef405f6a9925
#. default-sha256: 1ad7415f0c723bd77a73359c78a74b3685911f4ae5a03dc9aa936a1e2500ee70
msgctxt "scenario8:scenario8_707AA80E_C68A_4C08_8E5F_B7EA77E984E7"
msgid "⟪k:0⟫⟪k:1⟫We can have our lives back!"
msgstr "⟪k:0⟫⟪k:1⟫Вернуться к прежней жизни!"

#: scenario8:scenario8_D2F5D64A_E594_4284_9082_612E7FE2398A
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: abf7aa9bc674ada1826b44f271f0bc122b647847aca50b052a96cc366e023130
#. default-sha256: 53ec24d19f00e24500bc327a124ae37d640c9eab8f29105a882eaaf9394c9ad8
msgctxt "scenario8:scenario8_D2F5D64A_E594_4284_9082_612E7FE2398A"
msgid "⟪k:0⟫Undo our shackles, please!"
msgstr "⟪k:0⟫Пожалуйста, сними наши оковы!"

#: scenario8:scenario8_64824487_E115_4F4F_BFD9_18DCE692F95E
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: d91a81594013fc61a1ce5c4b6dbe7e7dfda3a9423b8a06673d69a2c9334f7f43
#. default-sha256: 141c3504a2d2fd92620af3dd1c1d471cc4410934d258291c7c191ac8fc24456a
msgctxt "scenario8:scenario8_64824487_E115_4F4F_BFD9_18DCE692F95E"
msgid "⟪k:0⟫...What?"
msgstr "⟪k:0⟫...Что?"

