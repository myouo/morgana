msgstr "⟪k:0⟫⟪k:1⟫⟪k:2⟫............"

#: scenario8:scenario8_89125EE1_9DEC_4B15_865B_A599E5B76AAA
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: ddbe84487bea123c97388bb695d022ea6ed08bcf496c67fbc2968007f7585501
#. default-sha256: f388d7c56659772e437cd9c780cb8dcf0ca8a6632d3fe638db94fa41eed2f955
msgctxt "scenario8:scenario8_89125EE1_9DEC_4B15_865B_A599E5B76AAA"
msgid "⟪k:0⟫⟪k:1⟫I’m glad you know how to listen, dog."
msgstr "⟪k:0⟫⟪k:1⟫Я рад, что ты умеешь слушать, пес."

#: scenario8:scenario8_2363D92A_A6B5_4C7A_B665_77ED23601537
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 20feac52e2b8808cc61aa793a9d789ec64400f53143ef575483245e86b436ee6
