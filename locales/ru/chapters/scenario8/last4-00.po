msgid "⟪k:0⟫⟪k:1⟫⟪k:2⟫Here we go..."
msgstr "⟪k:0⟫⟪k:1⟫⟪k:2⟫Ну вот, началось..."

#: scenario8:scenario8_FF3AC147_1D9F_4BCF_8298_828F15F6B027
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: f081938ad4920358499016c6f8858191eb0d89572c9a4a54e019117417788440
