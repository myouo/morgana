msgid "⟪k:0⟫⟪k:1⟫⟪k:2⟫That’s... ⟪k:3⟫a lot more people than I was expecting."
msgstr "⟪k:0⟫⟪k:1⟫⟪k:2⟫Тут... ⟪k:3⟫гораздо больше людей, чем я ожидала."

#: scenario8:scenario8_9009B8D8_4D54_46F9_846E_CF8623E0DCBC
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 40553c3b32faa21ccb3a4a4d05519c8e7883f12bee8d049d40af51b9e99f2748
