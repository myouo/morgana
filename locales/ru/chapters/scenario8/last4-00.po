msgid "⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫(He touched me while I was sleeping...)"
msgstr "⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫(Он прикасался ко мне, пока я спал...)"

#: scenario8:scenario8_4F5BDCA4_5B9A_4278_B8A1_4D70A9C8A4CF
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: ce1e840f6a398674a0de31ea1b1860235cfd6d6b2bb9ecd33e0f53756ed8e23c
