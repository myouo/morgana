msgid "⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫...Hold on... ⟪k:4⟫I need a minute..."
msgstr "⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫...Постой... ⟪k:4⟫дай мне минутку..."

#: scenario8:scenario8_25A063AC_913B_47D7_ABCD_1094D43DF76E
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 012415218725b4ad85ea166916277430bfe5e2c8a2d25ec078da164054ef47da
