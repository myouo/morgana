msgid "⟪k:0⟫⟪k:1⟫⟪k:2⟫That’s the thanks I get for waking you up?"
msgstr "⟪k:0⟫⟪k:1⟫⟪k:2⟫И это та благодарность, которую я получаю за то, что разбудил тебя?"

#: scenario8:scenario8_CB7E44A0_F4DE_4405_BA7D_B6D10E2385D9
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 1aed88e7e8e4fb66d6cf165e959cb60516de72e550741d387c6799a2390dd0c4
