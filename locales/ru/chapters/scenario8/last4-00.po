msgctxt "scenario8:scenario8_2FE65475_AEDE_48B8_9A4C_9F63D44F3EA1"
msgid ""
"⟪k:0⟫⟪k:1⟫H-⟪k:2⟫Hey, now! No cuttin’ in line, young man!⟪k:3⟫⟪k:4⟫We been waitin’ since dawn!"
msgstr "⟪k:0⟫⟪k:1⟫Э-⟪k:2⟫Эй! Не лезь без очереди, юноша!⟪k:3⟫⟪k:4⟫Мы тут с рассвета стоим!"

#: scenario8:scenario8_6D3F98F4_C6A2_4660_9EF6_330A8CED9EEA
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 28917a37baee3e386477158bdfe6ddb489e0ace4fb8c7cb00a6dc9e75dd51170
