msgid "⟪k:0⟫Haha..."
msgstr "⟪k:0⟫Хаха..."

#: scenario8:scenario8_A894CB19_55BF_49D4_A0D2_89C365A1867B
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 71d08f8482d67345447c5199a59e6dc4d1805b9928c7423e36e0b0e036c288a1
#. default-sha256: 7dd7406e22a36fa31d12298b5408395e39f13f0545dd7341cb9d547c6cf67962
