msgid "⟪k:0⟫⟪k:1⟫Hehehe..."
msgstr "⟪k:0⟫⟪k:1⟫Хехехе..."

#: scenario8:scenario8_B77B9324_C68A_4471_972E_2BC1BEA37683
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 8d95cbf45bc58608d95401238e49956760274fb5f1712e9e500e83517ef16303
#. default-sha256: d71ce64c912789871335f914f38af413c275a79bef31a04084cb9b7243563121
msgctxt "scenario8:scenario8_B77B9324_C68A_4471_972E_2BC1BEA37683"
msgid ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫Wha— ⟪k:3⟫⟪k:4⟫Th-⟪k:5⟫That can’t be right...⟪k:6⟫⟪k:7⟫I’m sure I’ve been smiling."
msgstr "⟪k:0⟫⟪k:1⟫⟪k:2⟫Что—⟪k:3⟫⟪k:4⟫Н-⟪k:5⟫Нет, не может быть...⟪k:6⟫⟪k:7⟫Я уверен, что улыбался."

#: scenario8:scenario8_71D278E8_A4E6_4699_99AB_D18D8754EC03
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 12248ea8e5be1bdd7f2b14eee20db3b8fc78ff83d5cdf1d281caee082695e748
#. default-sha256: 3221afad4396102f6e528f8f0dc6c3ed08da43901c28600a482c7a82106c9697
msgctxt "scenario8:scenario8_71D278E8_A4E6_4699_99AB_D18D8754EC03"
msgid "⟪k:0⟫I’m really glad you decided to come with me."
msgstr "⟪k:0⟫Я, и правда, очень рад, что ты решила пойти со мной."

#: scenario8:scenario8_CD72C044_BFA1_41D0_8B39_3193E6CED39F
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 8bcfe1e8d8bf9bdadb3e3d62111520c54d0680b2a608ef376bbdde05bed312f1
#. default-sha256: 267e574ba5462f5bdef283bdc3141b7c994a2c21d7961fec16b9be1576e1bac0
msgctxt "scenario8:scenario8_CD72C044_BFA1_41D0_8B39_3193E6CED39F"
msgid ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫Until that day, I had never known how good it felt to have someone who wanted me "
"in their life—"
msgstr ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫До того дня я и представить себе не мог, насколько же это чудесно, когда у тебя "
"есть кто-то, кому ты нужен—"

#: scenario8:scenario8_DCB637E0_5BB5_4D40_BF49_0311E5C87F0E
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 7992b0b2a2d13a089a0ef6d533f38b7d547e5fd38a322a5f5cf35d54f594057b
#. default-sha256: 3a39068740c67f15ec50bab46134c56aa02130c199568901c12c6d9d1db5c790
msgctxt "scenario8:scenario8_DCB637E0_5BB5_4D40_BF49_0311E5C87F0E"
msgid "⟪k:0⟫who saw me for me."
msgstr "⟪k:0⟫кто-то, кто видел в тебе тебя."

#: scenario8:scenario8_78516612_89A0_4842_AE37_8A5A650138DF
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 700ebcf5217589e53a29a73876db6990f4d0be82906c5c8c1e5cbdb059330dc8
#. default-sha256: c0dfae9983b43e367396a05cf904fe18acdcefd72af07bae3606aedf22e4cdb9
msgctxt "scenario8:scenario8_78516612_89A0_4842_AE37_8A5A650138DF"
msgid ""
"⟪k:0⟫I was hardly prince material—⟪k:1⟫⟪k:2⟫I wasn’t strong or handsome or regal enough for that—"
msgstr ""
"⟪k:0⟫Меня едва ли можно было назвать принцем — ⟪k:1⟫⟪k:2⟫я не был ни силен, ни красив, ни "
"достаточно благороден для подобного—"

#: scenario8:scenario8_75447CBB_525D_40EE_A675_182108C12D34
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 54a9e7e9cbc90e901bc22e48e9b8ca8a505e96f8497f8d9ff6b913e6663ee3bf
#. default-sha256: dcdced9e4539a801a19b5ea5410dc763dd9d9507e7ab9bda631eca3972acc3c6
msgctxt "scenario8:scenario8_75447CBB_525D_40EE_A675_182108C12D34"
msgid "⟪k:0⟫“I’m staying home because I want to be with you as much as possible.”"
msgstr "⟪k:0⟫“Я остаюсь дома, потому что хочу быть с тобой столько, сколько это возможно.”"

#: scenario8:scenario8_8D5AB42A_967E_45D3_B838_B7700592D49C
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 9d4cd92a74c74b9c43259c468d999d27399b49831618d9660de6898e12413b90
#. default-sha256: add2393071eb802e5c200520f603923f1e1eb928d031406d94189ee9b5433ffd
msgctxt "scenario8:scenario8_8D5AB42A_967E_45D3_B838_B7700592D49C"
msgid "⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫Welcome home, dearest Mell! What did you buy today?"
msgstr "⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫Добро пожаловать домой, дорогой Мелл! Что ты купил сегодня?"

#: scenario8:scenario8_D8D84C66_4B84_4F88_B226_A876B8F45AD9
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 8e6b779227d4b4c16200d3ec33448154bd916b66a0d0dfb9ddd3662792a065ff
#. default-sha256: 0b7cd37d1c6e7199460f3b29537786033be6e86aeaf4a7bb4f66c90d7149d365
msgctxt "scenario8:scenario8_D8D84C66_4B84_4F88_B226_A876B8F45AD9"
msgid ""
"⟪k:0⟫⟪k:1⟫Wow! I’ve never seen one so up close before!⟪k:2⟫⟪k:3⟫Are we going to keep it as a pet?"
msgstr ""
"⟪k:0⟫⟪k:1⟫Ух ты! Я никогда прежде не видела ее так близко!⟪k:2⟫⟪k:3⟫Мы оставим ее в качестве "
"питомца?"

#: scenario8:scenario8_B6DAF2C0_14E5_41D0_9248_6F5891F8439C
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 7b113155d194fd6aa75bf94b3ba76c21516ca9ec5fffd28629ddb16a1d74312c
