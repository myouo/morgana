msgid "⟪k:0⟫⟪k:1⟫⟪k:2⟫Carelessly revealing our hand at this stage did not seem wise."
msgstr "⟪k:0⟫⟪k:1⟫⟪k:2⟫Будет неразумно раскрывать наши карты на этом этапе."

#: scenario8:scenario8_2DC7E689_B590_4AEA_875D_FF5817E09A53
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 07947ba8bfddc8529ddd590077f1e064a65a96947dda2d7541bdc6c3ba319689
#. default-sha256: 06feebffceb2154bf5800f8815e9fa239b0376b928cafa4b502947b1eceacfbd
