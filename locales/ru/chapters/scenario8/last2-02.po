msgid "⟪k:0⟫⟪k:1⟫⟪k:2⟫Of the three, Mell was the least threatening."
msgstr "⟪k:0⟫⟪k:1⟫⟪k:2⟫Из них троих, Мелл был наименее угрожающим."

#: scenario8:scenario8_FA427C87_1978_4CE5_8AE0_85286F6A87CA
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 83ab4567d20ada2973457ca1ee5d7c57d0a9b7915ab01792a1fb0d5057dc40c0
#. default-sha256: df58cc9368733a2ce55547c1db24f2cd57372cf813e74a3f19918c8df7998cbe
