msgctxt "scenario4:scenario4_02E8E371_AD8E_4D76_908F_3112A0ACA460"
msgid "⟪k:0⟫With it, he cut through the rope that bound the box."
msgstr "⟪k:0⟫С его помощью он разрезал веревки, связывающие коробку. "

