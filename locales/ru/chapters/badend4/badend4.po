msgid "⟪k:0⟫⟪k:1⟫⟪k:2⟫Farewell, Michel."
msgstr "⟪k:0⟫⟪k:1⟫⟪k:2⟫Прощай, Мишель."

#: badend4:badend4_DEDD2D2D_E3D0_4446_8DB8_75FE39F1FEEE
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: a7fb101bde5fa72753a055e7fc7a3b1dbe13d03a23c96110b69f0ba12bcbf128
