msgid "⟪k:0⟫⟪k:1⟫Oh, jeez, how did I get myself into this?"
msgstr "⟪k:0⟫⟪k:1⟫О господи, как я угодил во все это?"

#: scenario:scenario_CF203C0A_1FA5_403E_A224_1159518A90E4
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 0929e9cd3cb6c153d7bce5fbca54bc7038b930065d70fe6b1a31feefcf02b7df
#. default-sha256: 453b971d59acf20b8f4ed1d1f815e4602dff61fce61080060e7c59a6fd68001e
