msgid "⟪k:0⟫H-⟪k:1⟫Hold on...⟪k:2⟫⟪k:3⟫Your father was an artist here?!"
msgstr "⟪k:0⟫П-⟪k:1⟫Подожди...⟪k:2⟫⟪k:3⟫Твой Отец был здесь художником?!"

#: scenario:scenario_5E34BE8D_9DC7_471B_ACDF_7167EECA3526
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 19ca77f39de87c375723b5f0ea9f38653443cc1da146e890968986817778aa58
