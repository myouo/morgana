msgid "⟪k:0⟫Why..."
msgstr "⟪k:0⟫Зачем..."

#: scenario:scenario_1625EB1B_B585_41A7_BB40_9562B88F023E
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 54eb5c5fc572c8ce700e75b455649443dbba009a9a0e362f517cc50477a5abf5
