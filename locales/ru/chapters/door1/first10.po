msgctxt "scenario:scenario_F4ADF25F_1C0F_4AEB_B771_C5CE544279C3"
msgid "⟪k:0⟫And so..."
msgstr "⟪k:0⟫Поэтому..."

#: scenario:scenario_8889171A_7420_4895_A676_A5619498CA44
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
