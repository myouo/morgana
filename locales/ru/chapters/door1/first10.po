msgctxt "scenario:scenario_2801E4E0_E4EC_488C_B0DF_A8D80C68CB0D"
msgid "⟪k:0⟫He was, long ago, a painter in service of the Rhodes family."
msgstr "⟪k:0⟫Давным-давно, его наняли в качестве художника для семейства Родс."

#: scenario:scenario_5D6D71B4_BFAE_4E86_91AC_8292A38DAFF1
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: f6ce63840cee8f157f2a868abad5831d975545f1a9dafddb00d3a9bb19a50322
