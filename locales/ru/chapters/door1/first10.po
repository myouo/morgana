msgctxt "scenario:scenario_534196E7_734B_42EC_BDEC_4BFF2AEE455D"
msgid "⟪k:0⟫For as long as I can remember, I’ve known the name Rhodes."
msgstr "⟪k:0⟫Столько, сколько себя помню, я всегда знала о династии Родс."

#: scenario:scenario_E3084A5A_0576_4250_AB4B_EE582C1FA553
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 866b70a9159e3afb14b222fd38ac72a92c5d48951155388c2f5c00f0d388a383
