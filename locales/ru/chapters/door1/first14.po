#: scenario:scenario_7C893E1F_346E_4C9F_B42E_D76879C2965A
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: b80fc801e0927fba2a7301f339fa8bf8ab2fbb79bbac6672ef46926dcc92d13e
#. default-sha256: 7d19463baf2c6f9eaa14d55b79a34992eb05cdba5cdfe5319526d2a03aaa4004
msgctxt "scenario:scenario_7C893E1F_346E_4C9F_B42E_D76879C2965A"
msgid "⟪k:0⟫But despite that, he continued to run, knowing not where he was to head."
msgstr "⟪k:0⟫Но, несмотря на это, он продолжал бежать, не зная, куда ему податься."

#: scenario:scenario_7007E2B4_607A_4FF5_8C31_8FF521D1D873
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 89ed97a6f1cbc4226daceedd321013edaa145716731a79d635a77f85d94218e1
