msgid "⟪k:0⟫Why..."
msgstr "⟪k:0⟫Почему..."

#: scenario:scenario_6ED4B62B_E12E_4D5B_8D73_7EE2BC667616
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 95d4fb8d7428970b7097bc2e5aff60b9931edd11da089abd3cd53ca4079d226d
#. default-sha256: f6c11fdd440da36522f8485e806f140ba0b53612d42eafed543642a474bfa342
msgctxt "scenario:scenario_6ED4B62B_E12E_4D5B_8D73_7EE2BC667616"
msgid ""
"⟪k:0⟫Why won’t anyone tell me the truth?⟪k:1⟫⟪k:2⟫All I want... ⟪k:3⟫All I want is for someone to "
"tell me it’s not true!"
msgstr ""
"⟪k:0⟫Почему никто не скажет мне правду?⟪k:1⟫⟪k:2⟫Все, чего я хочу... ⟪k:3⟫Все, чего я хочу, это "
"чтобы кто-нибудь сказал мне правду!"

#: scenario:scenario_C00DCF2D_6774_43CE_9214_83D0559ACD6E
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 67a699682d3e45c2518a120f04a434ad77b103045a398c814d841189882cec01
#. default-sha256: 219feb39e34be629e4167ef6776a8dd47f901e51aff5e995b794501c465ebca5
msgctxt "scenario:scenario_C00DCF2D_6774_43CE_9214_83D0559ACD6E"
msgid "⟪k:0⟫Have I sinned?!⟪k:1⟫⟪k:2⟫No, I didn’t know anything!⟪k:3⟫⟪k:4⟫I didn’t know—"
msgstr "⟪k:0⟫Я согрешил?!⟪k:1⟫⟪k:2⟫Нет, я ничего не знал!⟪k:3⟫⟪k:4⟫Я не знал—"

#: scenario:scenario_7676B9E7_B6A6_4D27_9D66_080D85ADA4E2
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 7e1a77f4b8c199aad23f46fd9432fb6e6761f969f49e8c769d24982f4f46c8c3
#. default-sha256: 809625511ec9ea4c70af184df748ee368eb11aea6484ebc549b2addb4e00cc50
msgctxt "scenario:scenario_7676B9E7_B6A6_4D27_9D66_080D85ADA4E2"
msgid ""
"⟪k:0⟫No... ⟪k:1⟫No... ⟪k:2⟫None of it’s true...⟪k:3⟫⟪k:4⟫So I... ⟪k:5⟫I haven’t done anything "
"wrong..."
msgstr ""
"⟪k:0⟫Нет... ⟪k:1⟫Нет... ⟪k:2⟫Это все неправда...⟪k:3⟫⟪k:4⟫Я ведь... ⟪k:5⟫Я не сделал ничего "
"плохого..."

#: scenario:scenario_7679B9E7_B6A6_4D27_9D66_080D85ADA4E2
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 77d8eac97320be2d2ac3dfd87e17f991924eac5bbe982e01fe389796836fbad1
#. default-sha256: 70072df2abb6dcee03e326840d5a5bd8539cdcf5f4b586b47211d31fc0c8b1c0
msgctxt "scenario:scenario_7679B9E7_B6A6_4D27_9D66_080D85ADA4E2"
msgid "⟪k:0⟫I am not at fault! ⟪k:1⟫Am I?!"
msgstr "⟪k:0⟫Я не виноват! ⟪k:1⟫Ведь так?!"

