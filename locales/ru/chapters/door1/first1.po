msgid "⟪k:0⟫⟪k:1⟫But grown-ups don’t play, Nellie."
msgstr "⟪k:0⟫⟪k:1⟫Но взрослые не играют, Нелли."

#: scenario:scenario_7F135B1F_35AC_4A45_9425_A629AA656CD3
