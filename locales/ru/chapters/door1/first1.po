msgid "⟪k:0⟫⟪k:1⟫While waiting for you, dearest Mell."
msgstr "⟪k:0⟫⟪k:1⟫Пока ждала тебя, дорогой Мелл."

#: scenario:scenario_7AC38983_ACEB_4195_BC92_FED09FABEBFE
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 4322b7967d742318613997bcfb1de9654cb2ce4cc501e1cc03f03b17736343f8
