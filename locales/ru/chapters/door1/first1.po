msgid ""
"⟪k:0⟫⟪k:1⟫I must raise the white flag.⟪k:2⟫⟪k:3⟫When did my little lady find herself such a sharp "
"wit?"
msgstr ""
"⟪k:0⟫⟪k:1⟫Я вынужден поднять белый флаг.⟪k:2⟫⟪k:3⟫И когда моя маленькая леди успела стать такой "
"остроумной?"

#: scenario:scenario_DCBF878B_EACC_4CB9_B884_5E2D6ACA2339
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 394d577b66a58d12daa0b47c5c9286ce0ce6467885a5878917c9d3d3753b10c6
