msgid ""
"⟪k:0⟫Oh dear. Please don’t look at me like that.⟪k:1⟫⟪k:2⟫I admit I was being rather fanciful..."
msgstr "⟪k:0⟫Ох, боже. Не смотрите на меня так.⟪k:1⟫⟪k:2⟫Признаю, я немного замечталась..."

#: scenario:scenario_577948E2_4A58_4B2B_9F9F_D1D1E5D12BF7
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 61dcd54e089ceafe43ab07396d28942ace4155174368cca59cf76a233821c88f
#. default-sha256: e6272578955fe1d6cfb7f22d954990d3704fc5f050ed9d9cd05c0dd9fb1d3b4e
msgctxt "scenario:scenario_577948E2_4A58_4B2B_9F9F_D1D1E5D12BF7"
msgid "⟪k:0⟫but what is a woman if not fanciful? Hehe..."
msgstr "⟪k:0⟫но разве не в этом кроется очарование женщины? Хехе..."

#: scenario:scenario_8C95A494_3B3E_4AE0_BA93_17C85B614917
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 62f60e35e57cca22729b08fba1c957040133632c7c4769f27b4b5415bef16481
