msgid ""
"⟪k:0⟫⟪k:1⟫Make-believe. ⟪k:2⟫I will be a princess taken captive by an evil kingdom, and you, "
"dearest Mell, will be my valiant knight."
msgstr ""
"⟪k:0⟫⟪k:1⟫Притворяшки. ⟪k:2⟫Я буду принцессой, заточенной в злом королевстве, а ты, дорогой Мелл, "
"будешь моим храбрым рыцарем."

#: scenario:scenario_AA7BD22D_2BD8_4A1A_9337_7B879AD41FFB
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 4f74f617072801396b3dbde97a6615e000fe7e6a1c70f52dede7309fa65742df
#. default-sha256: ef5f68dbc1eaf4d94f57e37e8c513b348ea6e817be148b1634cd716b450a1b35
msgctxt "scenario:scenario_AA7BD22D_2BD8_4A1A_9337_7B879AD41FFB"
msgid "⟪k:0⟫And then you turn into a prince when you rescue me."
msgstr "⟪k:0⟫А потом, когда ты меня освободишь, ты станешь принцем."

#: scenario:scenario_58B169A6_9D6A_46A9_91AC_F283EACD55AE
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 81b2db1dfc8a24de8715cc7bd374f5c522b65e10d9ddae909f5f56cdb41ca6e1
