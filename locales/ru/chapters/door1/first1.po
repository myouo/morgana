msgid "⟪k:0⟫⟪k:1⟫Haha, she may be right."
msgstr "⟪k:0⟫⟪k:1⟫Да, должно быть, она права."

#: scenario:scenario_0C5BC1A6_20B2_4504_A179_97A7AC903538
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: c66cf6f8befe7b0a19f45529b77c67ef00c690f8e558464f31c0eed31dfd4fa6
