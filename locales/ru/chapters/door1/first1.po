msgctxt "scenario:scenario_7F307564_3320_4CED_BC5E_3668C2A6DAEF"
msgid "⟪k:0⟫It was, in fact, a Latin grammar textbook he was reading."
msgstr "⟪k:0⟫Ведь, по сути, он читал учебник по Латинской грамматике."

#: scenario:scenario_F4B1DED2_F3CD_4A8D_8D86_709E45A055FC
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 66b50c40eb04e880df844925c9de0889e25d7fb64b94b341340b5a5ff9742b45
