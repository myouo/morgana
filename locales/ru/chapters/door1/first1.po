msgid "⟪k:0⟫⟪k:1⟫Make-believe?"
msgstr "⟪k:0⟫⟪k:1⟫Притворяшки?"

#: scenario:scenario_4030CB52_5AC7_41D5_98E4_533C1538E545
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: c72a66e098396711a8fb9e5ba8a639ef6fb8a79a1c509013150a1e9d0e53b73b
