msgid "⟪k:0⟫⟪k:1⟫A knight can become a prince?⟪k:2⟫⟪k:3⟫Impressive."
msgstr "⟪k:0⟫⟪k:1⟫Рыцарь может стать принцем?⟪k:2⟫⟪k:3⟫Впечатляет."

#: scenario:scenario_78F9CC90_3985_4D80_9A6F_3A22967A8690
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 9ad145114ed2ce27a6e1ad5cc153a14190b609df99287e9fc8358aa0377ac6ed
