msgctxt "scenario:scenario_8284B45F_DB40_4572_AD20_716ADA9B394E"
msgid "⟪k:0⟫⟪k:1⟫That’s not true!⟪k:2⟫⟪k:3⟫I’ll still play with you, even when I’m grown up!"
msgstr "⟪k:0⟫⟪k:1⟫Это не так!⟪k:2⟫⟪k:3⟫Я и дальше буду играть с тобой, даже когда повзрослею!"

#: scenario:scenario_36801EBF_08F4_41B7_8A19_C9E2134B63BE
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 222443a46813ef1f066fef1042a0fc34f512020a16c8e18a9b503ee6f17625f7
