msgid "⟪k:0⟫And the White-Haired Girl Mell saw the night before was one such maid."
msgstr "⟪k:0⟫И Белокурая Девушка, которую Мелл видел прошлой ночью, была одной из таких служанок."

#: scenario:scenario_4C756A1D_7E40_4A70_A30D_C7B42458823E
