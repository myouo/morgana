msgctxt "scenario:scenario_A4AF5B00_095B_4FC9_BB2F_3F9E80B72D72"
msgid "⟪k:0⟫Tell me, am I ⟪k:1⟫truly⟪k:2⟫ wrong?⟪k:3⟫⟪k:4⟫What did that girl tell you?"
msgstr "⟪k:0⟫Скажи, я ⟪k:1⟫правда⟪k:2⟫ ошибаюсь?⟪k:3⟫⟪k:4⟫Что эта девушка тебе сказала?"

#: scenario:scenario_AC6AC4CA_CB81_41A5_9A55_927B9C43B86D
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 5ae9c7bd0f707866b4e0a896752dc427160d3443ea95caf9728294f0691ba081
