msgid ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫⟪k:4⟫He held me in his arms and ran his hands through my hair,⟪k:5⟫⟪k:6⟫an "
"apologetic look on his face.⟪k:7⟫"
msgstr ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫⟪k:4⟫С чувством сожаления на лице он держал меня за руку,⟪k:5⟫⟪k:6⟫поглаживая "
"мои волосы.⟪k:7⟫"

#: scenario:scenario_7B6374ED_D011_47E2_BBB1_EB95CE506B96
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 25d0c809a1bf2b4f1e8f0f6bf5b60358eb1db84c61766f879960a7ab8cd9fbb1
