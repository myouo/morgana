msgctxt "scenario:scenario_5CA67A7D_01B1_4478_ABBB_72E73E62D6D5"
msgid "⟪k:0⟫But see, Mother had me, heh, ⟪k:1⟫hehe...⟪k:2⟫That I’m here is all the proof you need!"
msgstr ""
"⟪k:0⟫Но видишь ли, у матушки была я, хех, ⟪k:1⟫хехе...⟪k:2⟫То, что я здесь, лучшее тому "
"доказательство!"

#: scenario:scenario_FB6D5CAE_EC03_479C_86FC_4AFDF88DF190
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: d2e3d16cb15ad66645a40635aa05ffbb94377c288e2755e1db8f977be6febb04
