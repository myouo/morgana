msgctxt "scenario:scenario_FB6D5CAE_EC03_479C_86FC_4AFDF88DF190"
msgid "⟪k:0⟫The girl born sixteen years ago didn’t have flaxen hair!"
msgstr "⟪k:0⟫У девочки, родившейся шестнадцать лет назад, не было золотых волос!"

#: scenario:scenario_341AB355_BE5B_4E05_AC1B_2B371462CADF
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: d6608d9d6f1171dd558a9c042c5cccdd69419ccd8daaa406f464b20e04739ee3
