msgctxt "scenario:scenario_23A7B9C7_8346_49FC_924B_A63FB403D755"
msgid "⟪k:0⟫Even if their time would later come to be referred to as the Golden Age."
msgstr "⟪k:0⟫Несмотря на это, со временем тот век назовут Золотым."

#: scenario:scenario_EEE16001_D1BD_49B4_B1F4_222398717037
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
