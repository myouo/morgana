msgid "⟪k:0⟫The sun shone fiercely down on the town that day."
msgstr "⟪k:0⟫Солнце нещадно освещало город."

#: scenario:scenario_88CB335D_5BA8_4A7E_BE8C_72DA907A5FA7
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 1357d2a73e1327769950efae6f933384f8e72177533aaa8076fa8beebab9c460
