msgctxt "scenario:scenario_D18122FA_1DD4_4CC7_817E_524277FD37D8"
msgid "⟪k:0⟫⟪k:1⟫Huh?"
msgstr "⟪k:0⟫⟪k:1⟫Хах?"

#: scenario:scenario_7C5FA92F_CDF5_4AC4_93ED_0D5A211356C9
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 16f68b0d5b9da17e2a55cb1439329b16615a226e78a66aae9fd935f866093d26
#. default-sha256: 3487f9b696f35296846308559f1f249ed1eeb82413347389581d6734e3138122
msgctxt "scenario:scenario_7C5FA92F_CDF5_4AC4_93ED_0D5A211356C9"
msgid ""
"⟪k:0⟫⟪k:1⟫It doesn’t have to be a real prince—⟪k:2⟫⟪k:3⟫even just someone ⟪k:4⟫like⟪k:5⟫ one.⟪k:6⟫"
"⟪k:7⟫Is that something you dream about?"
msgstr ""
"⟪k:0⟫⟪k:1⟫Необязательно, чтобы это был настоящий принц — ⟪k:2⟫⟪k:3⟫может просто кто-то ⟪k:4⟫"
"похожий⟪k:5⟫.⟪k:6⟫⟪k:7⟫Это не то, о чем вы мечтаете?"

#: scenario:scenario_B828E736_B3A3_46BE_9F5A_3AFC624AA3E0
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 8c847fcfcc8dea70c694193e5b4455df8203bc533245f7a94b5e628a48e2ef44
#. default-sha256: dcff20c7ab9adf36fc558e3e352a354e3a8c4f0e322bb37462ab935d6a8d20bd
