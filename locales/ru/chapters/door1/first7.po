msgctxt "scenario:scenario_D35FE190_0FD7_4935_AF30_325B9163FF7B"
msgid "⟪k:0⟫Oh? ⟪k:1⟫Hehehe."
msgstr "⟪k:0⟫Ох? ⟪k:1⟫Хехехе."

#: scenario:scenario_A10B5545_1CA3_48D3_92E1_291FDC46E57E
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 0d2042597284ef769af4ba967ce212c8d908a79709bbe6c05d74f7831f37640d
