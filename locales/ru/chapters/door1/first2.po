msgid "⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫Aye, ready and waitin’, Young Master Rhodes!"
msgstr "⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫Да, готов, и ожидает вас, Юный Господин Родс!"

#: scenario:scenario_687BB062_F21E_45FD_84CB_ABD42F70BA59
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 9fd999ebace82bc65c6a51d55a05418da6fee35a300f1ff42c6c73cf24bde6df
