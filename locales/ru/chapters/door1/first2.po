msgctxt "scenario:scenario_5240F9EC_BD1E_4B14_9CC1_E09C4B90FF54"
msgid ""
"⟪k:0⟫Mell had stopped at a jewelry store in the center of town on his way back from the church."
msgstr "⟪k:0⟫Покинув церковь, Мелл заглянул в ювелирный магазин, расположенный в центре города."

#: scenario:scenario_1D9C7AB6_53A3_419D_98CC_275AA02C5E47
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 1bc61689572040ddebbe8e39859862e482a883801c5396c6747fab69be133974
