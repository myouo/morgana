msgid "⟪k:0⟫⟪k:1⟫Again... ⟪k:2⟫please don’t call me “Young Master.”"
msgstr "⟪k:0⟫⟪k:1⟫Опять же... ⟪k:2⟫пожалуйста, не зовите меня \"Юный Господин”,"

#: scenario:scenario_BD29EC5A_CDA9_4C02_8EF9_A6DB88597B5B
