msgctxt "scenario:scenario_46D19CAC_13AA_4EBA_AE9C_DC3EE2DE449C"
msgid "⟪k:0⟫And Mell was considering university."
msgstr "⟪k:0⟫И Мелл задумывался об университете."

#: scenario:scenario_6FFB82DB_D766_4D81_9654_FD543F861B72
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 9288e913d49416a6685b8898d25a17d7f512bec7c0950a4270b8b5b12c97fc03
