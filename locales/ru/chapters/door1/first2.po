msgctxt "scenario:scenario_6FFB82DB_D766_4D81_9654_FD543F861B72"
msgid ""
"⟪k:0⟫The priest wanted to recruit him to the Church, but Mell was having difficulty deciding what "
"he should do."
msgstr "⟪k:0⟫Священник хотел привлечь его в лоно Церкви, однако Мелл все еще не мог определиться."

#: scenario:scenario_448225CC_F4D1_4024_B523_14E47F0B009B
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 07970decd81e2e0085bda1c2dd971ab7bd8fe5057a42ca7cf79482f9fb0a400c
