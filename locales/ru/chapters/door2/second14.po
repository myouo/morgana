msgctxt "scenario2:scenario2_BAD9CECE_2467_4392_A237_3083253B13FA"
msgid "⟪k:0⟫Which means that, yes..."
msgstr "⟪k:0⟫Да, это означает..."

#: scenario2:scenario2_106E860A_A5CC_4547_82EE_632DB286BF3C
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: f1f71c5b903556d50970d3bca83012d736af3f36198a9bdb0188c275fa7da538
#. default-sha256: 6c4595acc435d6aada16a6a4562825971a1372ea29bd69b478223a2c7f08f2bc
msgctxt "scenario2:scenario2_106E860A_A5CC_4547_82EE_632DB286BF3C"
msgid "⟪k:0⟫her fate was set in stone well before you ever saw it."
msgstr "⟪k:0⟫что ее судьба была высечена на камне, задолго до того, как вы ее узрели."

#: scenario2:scenario2_874CF45D_CA2E_46BD_A676_AFE0AB026104
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 4061543afb157edf43ee137d34d42ebe8b7aef81ecfc4788fcab617f1f175166
