msgctxt "scenario2:scenario2_2455FA0D_CF54_4510_864E_951197A99F35"
msgid "⟪k:0⟫would you still remember those you care for?"
msgstr "⟪k:0⟫Вы бы по-прежнему помнили тех, кто вам дорог?"

#: scenario2:scenario2_BA8FEFFF_B069_4A73_8260_AC368B269E5B
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
