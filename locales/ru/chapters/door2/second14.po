msgctxt "scenario2:scenario2_A1A2ABFC_9FF9_4BC4_A64A_1C3ED1056E83"
msgid ""
"⟪k:0⟫This would have been a very different story...⟪k:1⟫⟪k:2⟫had you not discovered the truth."
msgstr "⟪k:0⟫Это была бы совершенно другая история...⟪k:1⟫⟪k:2⟫не узнай вы всей правды."

#: scenario2:scenario2_FB527226_CAA5_4839_90B7_7F04A2DE290B
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: a08d6f26feca36c141baa73e7b39c64d1a005aa88d81cbdd4be4ad3b1a3b16b2
