msgctxt "scenario2:scenario2_62228A2A_0C5A_41F9_A8AC_B3ABE806B459"
msgid "⟪k:0⟫That tale would have been far easier on you, I’m sure."
msgstr "⟪k:0⟫Я уверена, что для вас подобная история была бы намного проще."

#: scenario2:scenario2_E7DB052E_DAD7_459E_BC56_0801A835C943
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: aa1f9dafceb0d395cea2644f71101ff40ac352f4f0281a734ddaa7993000be06
