msgctxt "scenario2:scenario2_FB527226_CAA5_4839_90B7_7F04A2DE290B"
msgid "⟪k:0⟫A beast meets a white-haired girl and learns humanity."
msgstr "⟪k:0⟫Чудовище встретил Белокурую Девушку и учился быть человеком."

#: scenario2:scenario2_62228A2A_0C5A_41F9_A8AC_B3ABE806B459
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 052a9692ad664e590a2d5fc61b778eee0880dc081b590cf567b1096dca9f2b4a
