msgctxt "scenario2:scenario2_73EE22AD_3CAF_4942_824E_45B6B1CDBEE0"
msgid "⟪k:0⟫But the reality you observed through her eyes changes the “truth” of his tale."
msgstr "⟪k:0⟫Но реальность, которую вы узрели ее глазами, изменила “правдивость” его истории."

#: scenario2:scenario2_F06712C1_33E1_46A7_A834_ABA7C4446DD9
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: b416564fa00d5fd19350f9bda1e709763d586f1392cfe47ace2495bd373c8e92
