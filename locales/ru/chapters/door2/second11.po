#: scenario2:scenario2_59EC1995_9F69_4928_B63F_A488984FD7D5
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 833c9870fef38b3d163f2431be2473372b9bcf787ef8d0391fa56469542bc8f8
#. default-sha256: 459f7a62efd806ea4e7965ee16d5b2cc07a73c9d38115375f60408c0bc8afd6b
msgctxt "scenario2:scenario2_59EC1995_9F69_4928_B63F_A488984FD7D5"
msgid "⟪k:0⟫It’s hot."
msgstr "⟪k:0⟫Жарко."

#: scenario2:scenario2_48688F6C_4A2D_4F6F_8035_0F50B05DBDCA
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: f1e138323c953c3a17993acd01e1093638039b7763dabdd2bce6bfbbc3b7ea4c
#. default-sha256: bc4f0c898f64e1df0f4ca862f35d20ea36713e3fba3e424cf4f22448bbe5024d
msgctxt "scenario2:scenario2_48688F6C_4A2D_4F6F_8035_0F50B05DBDCA"
msgid ""
"⟪k:0⟫My parents’ relationship is on thin ice, but the air feels like it’s on fire. ⟪k:1⟫It’s much "
"too hot."
msgstr ""
"⟪k:0⟫Чувства моих родителей изрядно охладели, но воздух при этом будто пылает. ⟪k:1⟫Слишком жарко."

#: scenario2:scenario2_9E8AA447_803D_4FF2_867B_0D87BF0DBCA8
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 67fe84993e85abefa39d5904c1102d705af8273a95bfcc2c538aec8b6535dbec
#. default-sha256: 282a6cfa6db9e1d78bdd2c88daf89ac590d236b4400d13ec5b1bd87999beaae6
msgctxt "scenario2:scenario2_9E8AA447_803D_4FF2_867B_0D87BF0DBCA8"
msgid ""
"⟪k:0⟫My dad loves this seaside restaurant. ⟪k:1⟫It actually specializes in fish, but he always "
"asks for meat."
msgstr ""
"⟪k:0⟫Мой отец любит этот ресторан на набережной. ⟪k:1⟫Вообще-то здесь лучше всего готовят рыбу, "
"но отец всегда заказывает мясо."

#: scenario2:scenario2_7568A884_1212_4814_AD60_5BB3B1D66CA4
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 7e6e4ddc8021f1ca0626153a0891885bc650e3e84f88d08d97b8ed19c0f28b9e
#. default-sha256: bcf90bd90a4be792e8005f55d7cda191613c92b9fe0e0183615bfa63effd2e6a
msgctxt "scenario2:scenario2_7568A884_1212_4814_AD60_5BB3B1D66CA4"
msgid ""
"⟪k:0⟫Though “always” isn’t very often. He’s out of the country most of the time, so we rarely eat "
"together as a family."
msgstr ""
"⟪k:0⟫Хотя “всегда” не самое подходящее слово. По большей части он вечно в разъездах, и мы редко "
"обедаем вот так, как одна семья."

#: scenario2:scenario2_4714BF7B_C21A_4DE6_A54C_A5E914690614
