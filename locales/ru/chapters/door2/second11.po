msgid "⟪k:0⟫⟪k:1⟫Heh... ⟪k:2⟫hahaha."
msgstr "⟪k:0⟫⟪k:1⟫Хех... ⟪k:2⟫хахаха."

#: scenario2:scenario2_80C3940B_11E4_4E06_9951_89B2F8319147
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 8f8b4feb5272749ddf7123739148cfd7c289a1ed7a6793f56124c329c297eaa2
