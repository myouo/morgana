msgid "⟪k:0⟫⟪k:1⟫I could hear the cry of seagulls from the restaurant’s terrace."
msgstr "⟪k:0⟫⟪k:1⟫Я слышала крики чаек с террасы ресторана."

#: scenario2:scenario2_1E8DEAC5_3FD8_4F83_89B7_1E384764178A
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: c252845ce81ece6d21c6b73aa6cb68b262ddd80ae573d32d35478e65f9cca0a3
