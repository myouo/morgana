msgctxt "scenario2:scenario2_2CB60A18_9FD7_4795_B2D0_05EDFC4001B0"
msgid "⟪k:0⟫⟪k:1⟫⟪k:2⟫Not just out of the house—⟪k:3⟫⟪k:4⟫literally outside.⟪k:5⟫"
msgstr "⟪k:0⟫⟪k:1⟫⟪k:2⟫Не просто возле дома — ⟪k:3⟫⟪k:4⟫буквально под открытым небом.⟪k:5⟫"

#: scenario2:scenario2_8D57E0A8_1A9D_4782_A14B_B0AE10E0B057
