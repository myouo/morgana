msgid "⟪k:0⟫⟪k:1⟫The heat was searing."
msgstr "⟪k:0⟫⟪k:1⟫Жара царила неимоверная."

#: scenario2:scenario2_CFD43D05_666D_4CA7_A856_FF12D3099C17
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 875202d27a321070887224822c26d44adc84a89b07144eed1b8f78b7e3869d6c
