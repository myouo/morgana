msgid "⟪k:0⟫⟪k:1⟫Are you saying peace was not enough to sate you?"
msgstr "⟪k:0⟫⟪k:1⟫Вы хотите сказать, что мирной жизни было недостаточно, дабы насытить вас?"

#: scenario2:scenario2_74DDD056_1D04_48D8_ABCF_32277ECC01DF
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 6ea096a767e16ee0c37c3099f666b33bb70983ac44beb1870ff8589e5a0b42b2
