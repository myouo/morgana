msgid "⟪k:0⟫I must satisfy these ⟪k:1⟫urges⟪k:2⟫!"
msgstr "⟪k:0⟫Я должен утолить это ⟪k:1⟫желание⟪k:2⟫!"

#: scenario2:scenario2_3658F769_8C7F_480E_A8E0_F7FA9C5DE928
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 8d76748467f52bf99e2e5f30d7f73933885af680b1cae8d972e260c259035de9
#. default-sha256: 54698e1a23af718a49a084679313d758423c933cdd7f85ed4505d7637be57696
