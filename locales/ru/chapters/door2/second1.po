msgctxt "scenario2:scenario2_47547A2F_83BE_4437_861A_9135AF6DFC45"
msgid "⟪k:0⟫I was in quite the predicament."
msgstr "⟪k:0⟫Я находилась в весьма затруднительном положении."

#: scenario2:scenario2_9BDF0362_1EAE_4AA9_B4BF_FC6AADF9D3D7
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 2647fb55d31b663271e5798847963c5b93da9b4f9602d8ed33064880b02246e9
