#: scenario2:scenario2_AEB55A95_70E2_450A_BD31_2C12B010A75E
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: f10d82b4682abf9a1c64ba6dcfcf342a56a171ad9d4d7abffdc34dd79607a54e
#. default-sha256: 1430edcf72a4768757d0c3eaafe85552eb4079fdaeaaccc18121d82e915dcbb0
msgctxt "scenario2:scenario2_AEB55A95_70E2_450A_BD31_2C12B010A75E"
msgid "⟪k:0⟫⟪k:1⟫Oh dear, I was afraid you wouldn’t understand me.⟪k:2⟫⟪k:3⟫What am I to do?"
msgstr "⟪k:0⟫⟪k:1⟫О боже, я боялась, что вы меня не поймете.⟪k:2⟫⟪k:3⟫Что же мне делать?"

#: scenario2:scenario2_47547A2F_83BE_4437_861A_9135AF6DFC45
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: be3f099bea6d237adac08ae1408015d0b1586aef580edefb19f40c1b46ff343e
