msgid "⟪k:0⟫⟪k:1⟫What I’m trying to say..."
msgstr "⟪k:0⟫⟪k:1⟫Что я пытаюсь сказать, так это то..."

#: scenario2:scenario2_402C4EFB_FF62_4E32_B24B_4D9E431F3F6A
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: b9faae9e78529e8b8f3455fd8b58d4fa54581d0f0c88e6084f63ddabed380164
