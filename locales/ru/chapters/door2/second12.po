#: scenario2:scenario2_111F5064_ADFE_466A_A14C_A75FD5928ADF
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 589246db5551188e417978f39671bcf2300dff15e091ba32262566e45ebf3cee
#. default-sha256: a3307adf317c99b89c19e10e5e84bbd66a57b069bda800e060d3cba074cf1243
msgctxt "scenario2:scenario2_111F5064_ADFE_466A_A14C_A75FD5928ADF"
msgid "⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫⟪k:4⟫⟪k:5⟫⟪k:6⟫⟪k:7⟫⟪k:8⟫...Master. Master."
msgstr "⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫⟪k:4⟫⟪k:5⟫⟪k:6⟫⟪k:7⟫⟪k:8⟫...Хозяин. Хозяин."

#: scenario2:scenario2_11F56EE0_9C38_4F29_B74A_6FCC8A325BC3
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 3dc717ad0ed14ac25b63f3ba91ad7519c703b4b44cd67183296e0c37582f33a5
#. default-sha256: 14e26ae28af6a00be607c7855ac13b1feea826ac94f589f069bfc8fdce84b712
msgctxt "scenario2:scenario2_11F56EE0_9C38_4F29_B74A_6FCC8A325BC3"
msgid "⟪k:0⟫Ahh... ⟪k:1⟫you have awakened. ⟪k:2⟫You gave me quite the startle."
msgstr "⟪k:0⟫Ахх... ⟪k:1⟫Вы очнулись. ⟪k:2⟫Вы меня весьма напугали."

#: scenario2:scenario2_89EE87C6_5B9A_4A0A_A1DF_5919B15040CC
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 01bf13203f96a7bd542dd81f5e77f3c69ff57e30e66ec26b42421f41056bac3d
#. default-sha256: a8759975de83913a7a2a3e630167f800b4b0ab45a4fd0fe89ebdd86ef8273125
msgctxt "scenario2:scenario2_89EE87C6_5B9A_4A0A_A1DF_5919B15040CC"
msgid ""
"⟪k:0⟫Do you not remember? ⟪k:1⟫You suddenly started staring off into the distance, and you would "
"not respond to anything I said."
msgstr ""
"⟪k:0⟫Вы не помните? ⟪k:1⟫Внезапно вы уставились куда-то вдаль и не отвечали, что бы я ни говорила."

#: scenario2:scenario2_1CC76CC7_F747_47C2_8887_23081832279C
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: a8ec646fcbe152ad49dbfcba3da4dcbb5478eedca9f8ea83175c8c69164e1136
#. default-sha256: 33e96104b255e87d881fef943eed17f8d619363d135b455d5219938db5f281e3
msgctxt "scenario2:scenario2_1CC76CC7_F747_47C2_8887_23081832279C"
msgid "⟪k:0⟫Hehe. I thought you were playing a prank on me."
msgstr "⟪k:0⟫Хехе. Я думала, вы решили надо мной подшутить."

#: scenario2:scenario2_1AD64425_BDF5_4EA6_9999_FD49546236A4
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 3675f621c9669273605358c17a401ba17238bb6560544d04e278f1258141f700
#. default-sha256: 90c9defadd00db4212899ef6b24458d4ec0c1a200e54a7823e6dcaf422e9aa0e
msgctxt "scenario2:scenario2_1AD64425_BDF5_4EA6_9999_FD49546236A4"
msgid "⟪k:0⟫Your hand? ⟪k:1⟫Oh, yes, I did not let go of it."
msgstr "⟪k:0⟫Ваша рука? ⟪k:1⟫О, да, я ее не отпускала."

#: scenario2:scenario2_1A399BDF_5BE1_4A36_AB0A_D560CD523861
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: e2da76716893e0dfb1e0310b92c74deac9263f1a99c3292f47bf2925d8e9b032
#. default-sha256: b6723fb51d06724072e80064a86174bec42d618186138c915cec4035032e871d
msgctxt "scenario2:scenario2_1A399BDF_5BE1_4A36_AB0A_D560CD523861"
msgid "⟪k:0⟫For if I had, we would be in quite the predicament."
msgstr "⟪k:0⟫Если бы отпустила, мы бы оказались в крайне затруднительном положении."

#: scenario2:scenario2_F848F63F_7A17_4B90_B2F5_A318014EACD6
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: ad6e4b6bcf9b41bb44e33811c59f725d243fea5d41af2ae1252a137716e9844a
#. default-sha256: 801cc367dc3ffd47d0b8d536da7cc4df6d8f420b966f751b9e90b8cb03126b41
msgctxt "scenario2:scenario2_F848F63F_7A17_4B90_B2F5_A318014EACD6"
msgid "⟪k:0⟫Someone approaching the mansion, you say? ⟪k:1⟫You saw them?"
msgstr "⟪k:0⟫Вы говорите, кто-то приближается к особняку? ⟪k:1⟫Вы их видели?"

#: scenario2:scenario2_A1598863_CBF6_41E4_BCFE_3F9793B411E7
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 4e2f9f12bdf765518c8980507ddbc6781568bace75fdb07ff60b653a66862336
#. default-sha256: e92cc590a26b8b4c53e23835d270839efdbabdd249bcf4ff3a1f5feef731cbea
msgctxt "scenario2:scenario2_A1598863_CBF6_41E4_BCFE_3F9793B411E7"
msgid ""
"⟪k:0⟫Those images... ⟪k:1⟫were not shown to you by me. ⟪k:2⟫If you saw something, then it was by "
"your own powers."
msgstr ""
"⟪k:0⟫Эти образы... ⟪k:1⟫не я вам показала. ⟪k:2⟫Если вы что-то увидели, то это только благодаря "
"вашим собственным силам."

#: scenario2:scenario2_71F90BF4_07DD_4E07_A132_1B71D3313736
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: f853ba6e0c5f2300713e8b923eaaa07473fc61fc66920952a200eb70458efe55
#. default-sha256: bfb8cf864c773a3ccbba7aac34a3f55164bd1918c179dfda31d9df86311beb6c
msgctxt "scenario2:scenario2_71F90BF4_07DD_4E07_A132_1B71D3313736"
msgid "⟪k:0⟫But if you think about it, that is nothing unusual."
msgstr "⟪k:0⟫Но если вы немного об этом поразмыслите, то поймете, что тут нет ничего необычного."

#: scenario2:scenario2_2BC8B724_D335_4767_B5CD_FCB8966C49A9
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 5d00c32232878f03a5a42a0130f7fe8ca32003a8fb595417b07781278e569526
#. default-sha256: 1b97a7d6089eddfc859fdf7c2445d5908f9314da06b14bd5683201ca6bffa2d6
msgctxt "scenario2:scenario2_2BC8B724_D335_4767_B5CD_FCB8966C49A9"
msgid "⟪k:0⟫You are, after all, the master of this house."
msgstr "⟪k:0⟫В конце концов, вы Хозяин этого дома."

#: scenario2:scenario2_1B8C40FB_85CC_4FE2_AC7E_E24F642F5E44
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 0e6c17509faed34138ba5688dc672b73f3242463d8507a2ec01e3e2bd68b4d02
#. default-sha256: 0a923211059fc3b5750c5de85922c726fca6acb057a9aa23013c7c3214cfe471
msgctxt "scenario2:scenario2_1B8C40FB_85CC_4FE2_AC7E_E24F642F5E44"
msgid "⟪k:0⟫You should, in all actuality, be able to do anything I can do by yourself, Master."
msgstr ""
"⟪k:0⟫В действительности, вы должны обладать способностью делать то же, что делаю я сама, Хозяин."

#: scenario2:scenario2_7E71B94D_DC7F_4E9D_A51F_AD26D219E9FC
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: f13bd0442e58871a9c159b3b55a34bdfecc046f778aeefcada57cb43071a67c8
#. default-sha256: 7283227321cda209c58f7b15cd53ef16c71e819df2317832dfcda92769ade844
msgctxt "scenario2:scenario2_7E71B94D_DC7F_4E9D_A51F_AD26D219E9FC"
msgid "⟪k:0⟫So it is very possible you could have knowledge that I do not."
msgstr "⟪k:0⟫Поэтому весьма вероятно, что вы обладаете познаниями, которых нет у меня."

#: scenario2:scenario2_6E2FABCA_9F64_48A0_B7E6_6CD0ADBD4555
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 853cdf1666ac66b45d0b16052f4038f271f7120946b87812af79820685bf8c51
#. default-sha256: bd5492e24a313530a0248aa916a6010e74bbaca582f7aac5d8ba8d5798619138
msgctxt "scenario2:scenario2_6E2FABCA_9F64_48A0_B7E6_6CD0ADBD4555"
msgid "⟪k:0⟫Now, let us return to the mansion’s tale."
msgstr "⟪k:0⟫А теперь давайте вернемся к истории особняка."

#: scenario2:scenario2_0F1BEE93_B1C4_4A09_B39D_E7D9E7B6F528
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 595ad9d8489c5d0ea04cf62466e2438032a11a251cf8d41d60e681e014156fbd
#. default-sha256: c6339e65df2ecfe38d9718e0de42db70830b8c0b0cfe032b733fb35ba43e3d35
msgctxt "scenario2:scenario2_0F1BEE93_B1C4_4A09_B39D_E7D9E7B6F528"
msgid "⟪k:0⟫After the second beast paid a visit, Bestia began to destabilize again."
msgstr ""
"⟪k:0⟫После того, как второе чудовище нанесло ему визит, Бестия вновь утратил душевное равновесие."

#: scenario2:scenario2_9192764E_EBB3_456D_8944_942876725FB3
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 4b90ce31b7b4ef0a045f06ff7138cabcc562795174462c315d61b62e78e8cd69
#. default-sha256: edc2a754f5327885e01eb7097d954ecc916c67b518d1dcef70d7e7ce95a1bb89
msgctxt "scenario2:scenario2_9192764E_EBB3_456D_8944_942876725FB3"
msgid "⟪k:0⟫The White-Haired Girl would soothe his heart, but the calm was only ephemeral."
msgstr "⟪k:0⟫Белокурая Девушка успокаивала его сердце, но покой был лишь эфемерным."

#: scenario2:scenario2_E9596033_9464_4E27_AE7A_5F6978E107B7
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 90e57eb3111fc8a26929460b183cdb5acc9671fbd4d0324ffcc5e42dfac9523b
#. default-sha256: 8c5d81d8928482daffbf46dab71df37ae644f031cead7cefd7e108313e9c193d
msgctxt "scenario2:scenario2_E9596033_9464_4E27_AE7A_5F6978E107B7"
msgid "⟪k:0⟫He was like a cracked glass ball."
msgstr "⟪k:0⟫Он был словно треснувший стеклянный шар."

#: scenario2:scenario2_A0605F8E_692A_4C13_9EBC_6804BCFE93B3
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 84af4542afa458a89096dd435e8d18ef602cdb84afb15bb8811ce7a03a670b58
#. default-sha256: 2898c5f205e8871b6462d09c694bf1a6c2e50986d9f4f842d2bbcecf124b5783
msgctxt "scenario2:scenario2_A0605F8E_692A_4C13_9EBC_6804BCFE93B3"
msgid ""
"⟪k:0⟫If you dropped him, that would be the end. ⟪k:1⟫If you put too much force into handling him, "
"he would shatter. ⟪k:2⟫He was very difficult to care for."
msgstr ""
"⟪k:0⟫Если вы его уроните, ему придет конец. ⟪k:1⟫Если вы крепко его сожмете, он разобьется. ⟪k:2⟫"
"Заботиться о нем было очень трудно."

#: scenario2:scenario2_0B4F9443_56C3_456D_B951_B6010DA695FE
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: d8ee14c03e1e1a0163ec5ecc22e5563a2134ef0b87159116f6fce98da110b7d5
#. default-sha256: 98caa3dcd2248803746bc9125a9cd210c8d9de871d3fd301367ec1e744391dce
msgctxt "scenario2:scenario2_0B4F9443_56C3_456D_B951_B6010DA695FE"
msgid ""
"⟪k:0⟫And cracks do not heal. ⟪k:1⟫The damage still remains, even if the two sides appear to be "
"held together firmly in place."
msgstr ""
"⟪k:0⟫А трещины не затягиваются. ⟪k:1⟫Повреждения остаются, даже если обе стороны выглядят так, "
"будто накрепко соединены вместе."

#: scenario2:scenario2_5A7A7FC0_467A_41A0_9F25_8AB72A3349B6
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 293a9b4b999ba64d7684813a179e182b93267bd51ef05c237f7092719dc34791
#. default-sha256: ba554af66f0dee483fce22165922ce39a3b04e6c8b0c848e20d5dec4c63d98e1
msgctxt "scenario2:scenario2_5A7A7FC0_467A_41A0_9F25_8AB72A3349B6"
msgid "⟪k:0⟫Furthermore, they slowly, gradually, and without intervention spread."
msgstr "⟪k:0⟫Более того, они медленно, постепенно и без вмешательства распространяются все дальше."

#: scenario2:scenario2_F3BEFB24_9F16_4AFE_BBF4_CCCC02D9858D
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: e8de09c4c69dd84b16a38d977dc0d39f35374875402ab3efccc76a7950fa91eb
#. default-sha256: b31c979182164b140169f3e5a1fb487e561640560af21a0ec2bebd4207a1fe2b
msgctxt "scenario2:scenario2_F3BEFB24_9F16_4AFE_BBF4_CCCC02D9858D"
msgid "⟪k:0⟫The beast appeared to be afraid of someone’s voice."
msgstr "⟪k:0⟫Похоже, чудовище боялся чьего-то голоса."

#: scenario2:scenario2_3CCE8F83_81C4_47D8_99D2_C77A99D5C210
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: ad61f4075eeecb908682ed9b36548dc5b3880477e4c69e0fc0bcefa9b40d9f05
#. default-sha256: 144dcf2a8c70b2791091d24c586bb617e0ced6df6962772fc56dab82d0598d79
msgctxt "scenario2:scenario2_3CCE8F83_81C4_47D8_99D2_C77A99D5C210"
msgid "⟪k:0⟫He would on occasion stare into empty space and shout, cover his ears, and groan."
msgstr "⟪k:0⟫Порой он просто смотрел в пустоту, кричал, закрывал свои уши и стонал."

#: scenario2:scenario2_3602D6A7_C211_42BD_B283_E0DEACB10FD7
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: b1c5d1dba7c6a8831e366eaee7f7e7f8816c4c8191b42cd67e278c2128172e28
#. default-sha256: a3562ac681a09ebd6f98dce53820c3fe638fd0cffc63117162c16cb96d606edf
msgctxt "scenario2:scenario2_3602D6A7_C211_42BD_B283_E0DEACB10FD7"
msgid ""
"⟪k:0⟫One day, he shattered all the windows in the mansion, crushed the silverware I had just "
"polished to a shine..."
msgstr ""
"⟪k:0⟫Однажды он разбил все окна в особняке, разнес серебряную утварь, которую я только что "
"отполировала до блеска..."

#: scenario2:scenario2_E717A328_7A1E_4C98_AEC3_5BA798EE0BCD
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 4559355dd94ecd5259a4f074cff8506f8ee30054c996cb2005018704d8203a9f
#. default-sha256: 43c257714b57db70545f2c0fbaa0ec18576f5e817fd9f39c32132a593383bf89
msgctxt "scenario2:scenario2_E717A328_7A1E_4C98_AEC3_5BA798EE0BCD"
msgid "⟪k:0⟫and destroyed all the mirrors."
msgstr "⟪k:0⟫и уничтожил все зеркала."

#: scenario2:scenario2_3D6268C8_5E43_4895_85B3_41C34C8C23E7
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: a4649165d887849a8cb7aef6ec3af12ceee581ab99e8bbe4829d38f7fcfa38e9
#. default-sha256: 0b354e53fd031d6387bece2514bd29a0ea6cc909b8cd985c9c90e456dc4a7bb6
msgctxt "scenario2:scenario2_3D6268C8_5E43_4895_85B3_41C34C8C23E7"
msgid "⟪k:0⟫I assume he did not want to see his beastly self."
msgstr "⟪k:0⟫Я полагаю, он не хотел лицезреть свою чудовищную сущность."

#: scenario2:scenario2_E6660BE9_C4A9_4F2A_900C_9387CC154EA2
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: e6b4ee33305907a4dec6bd9db787d0bd3ad2cc5f796eff0bf1edb3f1ec51728e
#. default-sha256: d19e334ef552fb12fd095d1a93256b9a17c24371a0efc74373d426a578a8e72b
msgctxt "scenario2:scenario2_E6660BE9_C4A9_4F2A_900C_9387CC154EA2"
msgid ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫⟪k:4⟫⟪k:5⟫⟪k:6⟫⟪k:7⟫⟪k:8⟫⟪k:9⟫More... ⟪k:10⟫There’s more!⟪k:11⟫⟪k:12⟫There’s "
"still more that reflects my image!"
msgstr ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫⟪k:4⟫⟪k:5⟫⟪k:6⟫⟪k:7⟫⟪k:8⟫⟪k:9⟫Еще... ⟪k:10⟫Там есть еще!⟪k:11⟫⟪k:12⟫Есть еще "
"то, что отражает мое обличье!"

#: scenario2:scenario2_0E8A774D_89D2_40BB_B08E_32EBA92EA1AD
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 002574760ca020087d66a588733c296c638301efd831f2a80166818b0a992a3a
#. default-sha256: 267252e673ee40610ae0f6a7569ff25f0f26561f8b05edd6ffa126805e16d103
msgctxt "scenario2:scenario2_0E8A774D_89D2_40BB_B08E_32EBA92EA1AD"
msgid "⟪k:0⟫Windows! Mirrors! Vases! Dishes!⟪k:1⟫They all show my reflection!"
msgstr "⟪k:0⟫Окна! Зеркала! Вазы! Тарелки!⟪k:1⟫В них во всех видно мое отражение!"

#: scenario2:scenario2_30E1C98F_85D0_415D_9596_F850209C4998
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 69f312bd525453ddaa2cefb61f6e0011cb5aab511ede00c44f4a13baf1b4e82b
#. default-sha256: e271b6312bbcb0dc268e3d8e3f8e54a9656b595240587b50f90f07bfa186feec
msgctxt "scenario2:scenario2_30E1C98F_85D0_415D_9596_F850209C4998"
msgid "⟪k:0⟫⟪k:1⟫⟪k:2⟫Wh-⟪k:3⟫What are you doing?"
msgstr "⟪k:0⟫⟪k:1⟫⟪k:2⟫Ч-⟪k:3⟫Что ты делаешь?"

#: scenario2:scenario2_F54E30E6_55AA_42BA_AD2E_92886CDE897F
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
