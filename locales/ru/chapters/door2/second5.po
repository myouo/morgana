msgid "⟪k:0⟫⟪k:1⟫⟪k:2⟫Then... ⟪k:3⟫I suppose I shall take you up on your generosity."
msgstr "⟪k:0⟫⟪k:1⟫⟪k:2⟫Тогда... ⟪k:3⟫Тогда я думаю, что приму вашу щедрость."

#: scenario2:scenario2_4085474D_5FA7_4CF4_ABDB_FDCE6F5B07F2
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 7848c817179d861a55ec08b11890f9b1fd10bc9fa6b66682db6a96f673a74ede
