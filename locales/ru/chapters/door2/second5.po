msgctxt "scenario2:scenario2_1DBC9231_F152_4E0A_9F32_4372EB81F449"
msgid "⟪k:0⟫His next words were in large part impulsive."
msgstr "⟪k:0⟫Его следующие слова были в немалой степени импульсивны."

#: scenario2:scenario2_1DC255A9_C3A5_4CEE_A646_B2B4EE311868
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 3623bc4fbf0cc1425ff7766358d8b2ab4444af3c409329efe2579d7261fe5c9d
