#: search:search_B07EC243_739B_4E71_8C88_18A02077BB67
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 76b2172f082700ef56759f7b6500501a860efe460a1fc7556c7b160c778dfd04
#. default-sha256: 12540d60bbaefbb155008c235d0db054f223e44e4ce0bdda8477d7232175fbf7
msgctxt "search:search_B07EC243_739B_4E71_8C88_18A02077BB67"
msgid ""
"⟪k:0⟫⟪k:1⟫Caught off-guard, ⟪k:2⟫You⟪k:3⟫he⟪k:4⟫ spun around, confused, in search of the source."
msgstr "⟪k:0⟫⟪k:1⟫Застигнутый врасплох, ⟪k:2⟫Ты⟪k:3⟫Ты⟪k:4⟫ повернулся в поисках источника голоса."

#: search:search_30150091_426D_424D_BA43_80800C085731
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 10cefdbaaa1531e0f50f215c50dcd77253cb6c0395bfbef827664901ca7f0586
