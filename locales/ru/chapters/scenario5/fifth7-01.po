msgctxt "scenario5:scenario5_B63ABCFF_2F09_459A_80FD_4E04BA829F16"
msgid "⟪k:0⟫Hehehe. And it’s all thanks to you, Amédée."
msgstr "⟪k:0⟫Хехехе. И все благодаря тебе, Амеди."

#: scenario5:scenario5_6B395FC1_F244_4E44_92D9_73CEB67F8ED8
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: b3335394fe2808760b8dd168a4d7d580dc3163688fbba28056bf58ef279ba9d6
