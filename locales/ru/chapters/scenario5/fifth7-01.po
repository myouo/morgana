msgid "⟪k:0⟫Lead the way!"
msgstr "⟪k:0⟫Показывай дорогу!"

#: scenario5:scenario5_EEF21F5F_2D34_417F_A3AA_95A49C57C2AF
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: edfddaf67df14997b897e442db6441427fed7752769de1ddc0e66eaef6f69edf
