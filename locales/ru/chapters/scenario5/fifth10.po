msgid "⟪k:0⟫Oh, you’re such a cynic..."
msgstr "⟪k:0⟫Ох, вы такой циник..."

#: scenario5:scenario5_84935AD8_6A66_4484_A1FB_C41426A58610
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
