msgctxt "scenario5:scenario5_85A28BB8_B353_4F11_AEF1_689B0850595B"
msgid "⟪k:0⟫Please don’t tell me you’re bringing the “obese rat” incident back up..."
msgstr "⟪k:0⟫Пожалуйста, только не говори мне, что снова хочешь поднять тему “жирной крысы”..."

#: scenario5:scenario5_340F8457_DD3B_404E_924C_8F085AF5FF45
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
