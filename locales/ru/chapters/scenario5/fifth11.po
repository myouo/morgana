#: scenario5:scenario5_5351814B_5466_4814_92DD_53303F78A75E
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: a15954b2295a5db178120789a54a3c69bc86f43a5c6dd254d3e57a01a7b202ce
#. default-sha256: ee15892fe537982b2336438c239493285b5019bcc6606d50a955ddf3eade056b
msgctxt "scenario5:scenario5_5351814B_5466_4814_92DD_53303F78A75E"
msgid ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫⟪k:4⟫⟪k:5⟫⟪k:6⟫⟪k:7⟫Before long, winter retreated and our second spring came "
"to take its place."
msgstr ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫⟪k:4⟫⟪k:5⟫⟪k:6⟫⟪k:7⟫В скором времени зима ретировалась, и ей на смену пришла "
"наша вторая весна."

#: scenario5:scenario5_435A89A1_6490_46EC_B689_8B258E374994
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 6736b86c4cca43971147e77ff62da77ffe221790a7f688a1032faa3af49e302c
#. default-sha256: a9ff4f0c911bb7493712d791a64b4760517f515909963660a2736e1e26f49896
msgctxt "scenario5:scenario5_435A89A1_6490_46EC_B689_8B258E374994"
msgid "⟪k:0⟫A full year had passed since we had resumed living together,"
msgstr "⟪k:0⟫Минул целый год с той поры, как мы вновь начали жить вместе,"

#: scenario5:scenario5_4A897F4C_E0E2_415A_A9A0_1CCB1D2596EA
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 975ccb1beef5da93fb1ca7d1933ee7c49229e14154bc5dcb13bbe0507e646f98
#. default-sha256: 6ed1e0da8d945a60dfd77627dcda8bf0d77418c321864a016e7b37f1c1cd83e1
msgctxt "scenario5:scenario5_4A897F4C_E0E2_415A_A9A0_1CCB1D2596EA"
msgid "⟪k:0⟫and I don’t think it was my imagination that this year felt much warmer than last."
msgstr "⟪k:0⟫и не думаю, будто мне казалось, что этот год был гораздо теплее прошедшего."

#: scenario5:scenario5_CFE1213C_3933_9F57_3F36_8BD7E239BE3E
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: e72f0154bee26ba37cd4c7935d9ce282fa667d8c86efd76d43ec91c286e9713d
