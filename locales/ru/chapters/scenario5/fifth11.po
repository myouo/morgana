msgctxt "scenario5:scenario5_1BCBC943_BC9D_4727_AB28_372BA1BDAF2C"
msgid "⟪k:0⟫(I don’t follow her reasoning...)"
msgstr "⟪k:0⟫(Я не понимаю ход ее мыслей...)"

#: scenario5:scenario5_CA332F6C_B6C2_4A94_9397_F3CA7D5603B7
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 91a0930dc9bdcff59f0e3c884c865c657d54d83a233b66689b134005ecb09203
