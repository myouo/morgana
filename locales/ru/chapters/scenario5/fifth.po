msgid "⟪k:0⟫⟪k:1⟫Thank you... ⟪k:2⟫very much.⟪k:3⟫⟪k:4⟫You must be tired after such a long journey."
msgstr ""
"⟪k:0⟫⟪k:1⟫Большое... ⟪k:2⟫вам спасибо.⟪k:3⟫⟪k:4⟫Вы, должно быть, устали после столь долгого "
"путешествия."

#: scenario5:scenario5_12067F99_3293_4F77_BE6F_22FD8AE30CD3
