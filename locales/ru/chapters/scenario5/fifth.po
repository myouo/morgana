msgid "⟪k:0⟫This deep in the forest?"
msgstr "⟪k:0⟫Так глубоко в лесу?"

#: scenario5:scenario5_C490A16F_85CA_4E34_9DE0_E0DD31A4FD62
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: e4c33ddff3973294ef0fe7012a3fc8f1fbfa7fe9a9c888a44fd1de235ec86b05
