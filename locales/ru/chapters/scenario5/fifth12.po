msgctxt "scenario5:scenario5_EE74D510_74CC_4884_89C9_4CEC532E1151"
msgid "⟪k:0⟫Why my father, of all people?"
msgstr "⟪k:0⟫Почему мой отец, из всех людей?"

#: scenario5:scenario5_06E0553F_3A5D_4B6D_93C6_3F4C1F8842AE
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: adca84f6a26f3a304028ea4386ea6c3d90d0c35022ea9ea49a219632feb3960e
