msgctxt "scenario5:scenario5_96F9440B_9DEF_4B86_8826_22C98E0A04AB"
msgid "⟪k:0⟫What went through my father’s mind... ⟪k:1⟫when he looked at these?"
msgstr "⟪k:0⟫О чем думал мой отец... ⟪k:1⟫когда смотрел на это?"

#: scenario5:scenario5_4E2234B1_44E4_47E5_9DB4_217802EAE942
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: ff2e120ba2f8b82cb14802b1346d1167df098863c7f48fb064cc0c29cd4226a0
