msgid "⟪k:0⟫(Ahh, so ⟪k:1⟫that’s⟪k:2⟫ why she said I would have to see them eventually...)"
msgstr "⟪k:0⟫(Аах, так ⟪k:1⟫вот⟪k:2⟫ почему она сказала, что я однажды их увижу...)"

#: scenario5:scenario5_55C88ACA_340B_4D9F_BCE4_3EB7415B16CD
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: e984784601ae02b21153886bea4eac12218e50061f76f919777692ce0f9c0a74
#. default-sha256: 48a171d2ba244850442006e2bb8d952f66ca03b574ffdd4d504f92e9e6d316c7
msgctxt "scenario5:scenario5_55C88ACA_340B_4D9F_BCE4_3EB7415B16CD"
msgid "⟪k:0⟫My instincts told me these were wounds she would carry for the rest of her life."
msgstr "⟪k:0⟫Мои инстинкты подсказывали мне, что эти раны она будет носить до конца своей жизни."

#: scenario5:scenario5_337DF814_E1AC_4B07_A640_6BC1D14477E4
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 9b9dc11903af189cc62c1a6f59e8598f40201a9f6f16df94571759ac9801e771
