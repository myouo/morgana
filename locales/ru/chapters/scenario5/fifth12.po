msgctxt "scenario5:scenario5_6143A44C_037A_4997_95C7_39D26F7FECBC"
msgid "⟪k:0⟫Why did he have to do this to her?"
msgstr "⟪k:0⟫Зачем он так с ней поступил?"

#: scenario5:scenario5_EE74D510_74CC_4884_89C9_4CEC532E1151
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: f97af4ac8d2d25ba46fef3f2f6063cedbe59b0277e741a6ff22c5bebd5605d33
