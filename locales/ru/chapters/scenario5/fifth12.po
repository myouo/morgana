msgctxt "scenario5:scenario5_4E2234B1_44E4_47E5_9DB4_217802EAE942"
msgid "⟪k:0⟫What did he gain from giving her these wounds?"
msgstr "⟪k:0⟫Чего он добивался, нанося ей эти раны?"

#: scenario5:scenario5_6143A44C_037A_4997_95C7_39D26F7FECBC
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: fea249ce6a58ca2e93cffa7da1e953aae81dbbcd75b6a22f5fb81488e1e994a5
