msgctxt "scenario5:scenario5_711B9A6F_4494_4E8B_ACFC_EC7EEB85D849"
msgid "⟪k:0⟫Ah... ⟪k:1⟫aaah..."
msgstr "⟪k:0⟫Ах... ⟪k:1⟫ааах..."

#: scenario5:scenario5_E22FD1CE_DC1F_4F16_898F_96EFD80B6207
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 108b6c144ee6c798724a3dc0abe00d76f80aff701fd4c50c6100aafe4477202e
#. default-sha256: 70373f421343b00ffe1a17db4bbefb15dc04bf55c0afcd542cc59cbb3c7291cc
msgctxt "scenario5:scenario5_E22FD1CE_DC1F_4F16_898F_96EFD80B6207"
msgid "⟪k:0⟫I shall bring calamity upon you, as the witch of legend!"
msgstr "⟪k:0⟫Я обрушу на вас бедствия, как ведьма, о которой гласит легенда!"

#: scenario5:scenario5_B5DDA295_5464_46AA_A330_C83F64301F84
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: ed26b8563ed25414172c7d3166538ec4bd21e9f96e43841bfa0b61f259d439b9
#. default-sha256: 2f86a6653ae436763cea475c1b5b43173df3ca01a0a961e215b318318220ddc9
msgctxt "scenario5:scenario5_B5DDA295_5464_46AA_A330_C83F64301F84"
