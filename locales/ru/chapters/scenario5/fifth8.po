msgctxt "scenario5:scenario5_711B9A6F_4494_4E8B_ACFC_EC7EEB85D999"
msgid "⟪k:0⟫Behold these crimson eyes!⟪k:1⟫⟪k:2⟫A symbol of the lifeblood spilt at my hands!"
msgstr "⟪k:0⟫Узрите мои алые очи!⟪k:1⟫⟪k:2⟫Символ пролитой моими руками крови живущих!"

#: scenario5:scenario5_711B9A6F_4494_4E8B_ACFC_EC7EEB85D849
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 725e600c8ddcdac431270785f9c283808b1d5d60beb0c6b5615dd33e921ee96b
