msgctxt "scenario5:scenario5_CB63FF7A_0A1D_4306_85E6_F190B75C2889"
msgid "⟪k:0⟫Doing that made it a little easier to bear,"
msgstr "⟪k:0⟫Когда я так поступала, мне стало легче это выносить,"

#: scenario5:scenario5_BD46EAB8_8A67_4B7B_99A7_D121E318BF44
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
