msgctxt "scenario5:scenario5_2B02D1E2_4760_41EA_A31F_5E9954ACB823"
msgid "⟪k:0⟫His hands couldn’t reach my heart,"
msgstr "⟪k:0⟫Его руки не могли добраться до моего сердца,"

#: scenario5:scenario5_F7E4BD27_0335_40CB_B922_23CF301116D0
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 9b379406979809714804dcc6289aba8174e83149d389a636726e47687b8611af
