msgctxt "scenario5:scenario5_F7E4BD27_0335_40CB_B922_23CF301116D0"
msgid "⟪k:0⟫for it was not connected to my body."
msgstr "⟪k:0⟫ибо оно не связано с моим телом."

#: scenario5:scenario5_CB63FF7A_0A1D_4306_85E6_F190B75C2889
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 83f889cf107e148c15b06479eb0b5b3319b06a7913667736d04fd760c68ceb42
