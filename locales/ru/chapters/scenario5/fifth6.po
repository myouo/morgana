msgctxt "scenario5:scenario5_A591642B_1E4F_4B0D_B02F_544E1C8F0642"
msgid "⟪k:0⟫So what would bring her to come looking for someone like me?"
msgstr "⟪k:0⟫Так что же заставило ее искать кого-то вроде меня?"

#: scenario5:scenario5_7F2A06D1_D830_4DFA_8D6C_D6B4EA9152CD
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 65cd50c66bf3dd9ae6171f6c5d3e7f00043fe1ae8632390ed5d8937cb86fbdb8
