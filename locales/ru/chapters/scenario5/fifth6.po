msgid "⟪k:0⟫⟪k:1⟫You’re Giselle, aren’t you?"
msgstr "⟪k:0⟫⟪k:1⟫Ты Жизель, верно?"

#: scenario5:scenario5_DF037EBD_D86C_45CA_9C5F_83A724E96A00
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 8dd266d755aa39ed0224cb4985ca8e546a5a26681b560ae992277f0586f3770e
