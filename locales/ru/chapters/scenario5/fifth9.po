msgctxt "scenario5:scenario5_4CA04C0A_498A_4B14_8295_73157439C193"
msgid "⟪k:0⟫But that didn’t change anything..."
msgstr "⟪k:0⟫Но это ничего не меняло..."

#: scenario5:scenario5_4CB3629A_C22C_48AF_B79D_4760DD361590
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
