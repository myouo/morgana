msgctxt "scenario5:scenario5_9DE87E9A_C5CB_4993_AD68_3A37ED68FDA5"
msgid "⟪k:0⟫I would like to know everything, from start to finish."
msgstr "⟪k:0⟫Я бы хотел узнать все от начала и до конца."

