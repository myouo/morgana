msgid "⟪k:0⟫I had to do it,"
msgstr "⟪k:0⟫Я должен был это сделать,"

#: scenario5:scenario5_D831D3C4_8153_499F_8E4E_3289F4DFA12D
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 9321ffc94fe12e226a601611d52862dfd06f24dbc7f07bc38210ec3cd93e6be3
