msgid "⟪k:0⟫That’s terrible...⟪k:1⟫⟪k:2⟫What are we going to do, then?"
msgstr "⟪k:0⟫Это ужасно...⟪k:1⟫⟪k:2⟫Что же мы тогда будем делать?"

#: scenario5:scenario5_DE2ED268_F182_4E5E_B0B2_7AD5D1B6B612
