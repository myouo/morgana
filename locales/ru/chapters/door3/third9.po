msgid "⟪k:0⟫⟪k:1⟫Yes... ⟪k:2⟫Yes, you’re right..."
msgstr "⟪k:0⟫⟪k:1⟫Да... ⟪k:2⟫Да, ты права..."

#: scenario3:scenario3_17B3D791_9D1A_415F_B2DA_F9BDAC611852
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: f3acf2543bde95f811650593c7873bb3a605194b816d9fa0e4e7ce0c26251929
