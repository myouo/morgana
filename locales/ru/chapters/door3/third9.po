msgid "⟪k:0⟫⟪k:1⟫⟪k:2⟫You will not get away with it!⟪k:3⟫"
msgstr "⟪k:0⟫⟪k:1⟫⟪k:2⟫Тебе это просто так с рук не сойдет!⟪k:3⟫"

