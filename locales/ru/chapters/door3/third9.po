#: scenario3:scenario3_5F65D0CB_3C76_499E_AD53_CAB8E35B41DD
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: b10c2a5116f81486f99c47e2dc6a93d922878b1dbeafe5159db8cc7501f764ab
#. default-sha256: a4659e74090fd01b917b83e9842ef04aadf5aadb35e8e030b7a3db2eac55f02a
msgctxt "scenario3:scenario3_5F65D0CB_3C76_499E_AD53_CAB8E35B41DD"
msgid ""
"⟪k:0⟫⟪k:1⟫When did you get perfume?⟪k:2⟫⟪k:3⟫And I have to say, you seem to be having ⟪k:4⟫"
"quite⟪k:5⟫ the time.⟪k:6⟫⟪k:7⟫Look at you—⟪k:8⟫⟪k:9⟫you’re out of breath! Red as a beet!"
msgstr ""
"⟪k:0⟫⟪k:1⟫Когда это у тебя появились духи?⟪k:2⟫⟪k:3⟫И должен сказать, ты ⟪k:4⟫неплохо⟪k:5⟫ "
"проводишь время.⟪k:6⟫⟪k:7⟫Взгляни на себя — ⟪k:8⟫⟪k:9⟫запыхавшаяся! Красная как свекла!"

#: scenario3:scenario3_AF5CF907_8CD2_4393_B886_F00478BF0421
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: c43697169e198a70c1734d19ef22fd8df78027aa64884b22fec9608a7a2cf0b5
