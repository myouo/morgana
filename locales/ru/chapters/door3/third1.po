msgctxt "scenario3:scenario3_348C41F0_1B2F_40FC_A864_7A491B0FE7D7"
msgid "⟪k:0⟫⟪k:1⟫...!"
msgstr "⟪k:0⟫⟪k:1⟫...!"

#: scenario3:scenario3_86CA45F2_2704_43C8_BF1E_6CE4A596C4EC
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 81382cb9a4d11aab0f00d0933f4078da12c7810f46a260df7955f251bbfcad64
#. default-sha256: 7de563fc4ae1c49c78807ac197dad76f9cae09ebd1c3a458038371786a0b75c4
msgctxt "scenario3:scenario3_86CA45F2_2704_43C8_BF1E_6CE4A596C4EC"
msgid ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫H-⟪k:3⟫Hey now.⟪k:4⟫⟪k:5⟫No need to treat your lady like that.⟪k:6⟫⟪k:7⟫She was "
"just tryin’ to be courteous..."
msgstr ""
