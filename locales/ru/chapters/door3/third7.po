msgctxt "scenario3:scenario3_ADBAE724_EC51_462D_B101_F06FD8D4DA45"
msgid "⟪k:0⟫What do you think, Master?"
msgstr "⟪k:0⟫Как вы думаете, Хозяин?"

#: scenario3:scenario3_9E4804DD_6D28_46C6_8FB0_9A09D2E15148
