msgid "⟪k:0⟫⟪k:1⟫No, no, I don’t consider you intrusive at all."
msgstr "⟪k:0⟫⟪k:1⟫Нет, я вовсе не считаю тебя назойливой."

#: scenario3:scenario3_7E9E5480_1D4B_4834_80E1_4A151FF68D03
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 447582e37991eeca0fabc6370d62b56edc6c8096741ec496a6ed7e6ba011706f
#. default-sha256: 53b32d62146b357cef2e5460bea4df9057032281c15738c4076f2aecf542dce5
