msgid "⟪k:0⟫⟪k:1⟫Never been able to fix that..."
msgstr "⟪k:0⟫⟪k:1⟫Никогда не могла с этим справиться..."

#: scenario3:scenario3_721C24B4_53B0_431F_A1E1_A64D040B3981
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: be2fc3311fa252da06bf0f2b8a23fe48a91d69e58cc8acfce1b4b18747af0f11
