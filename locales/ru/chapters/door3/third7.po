msgid "⟪k:0⟫A small mirror before her, she tried spinning the paper disc."
msgstr "⟪k:0⟫Перед ней было маленькое зеркало, она пыталась крутить бумажный диск."

#: scenario3:scenario3_87BD0DD2_5277_473E_B9B1_3CF0387392AC
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: c216b9a208213a0eba34ef4708370a4e1829e5d832f9b245b27fe9a20deba372
