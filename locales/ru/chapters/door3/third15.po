msgid "⟪k:0⟫............"
msgstr "⟪k:0⟫............"

#: scenario3:scenario3_47AA4A64_709B_4E96_BFDD_E0F7A897DA37
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: d06a4475ad29273d83ecbdaa5712e13a9f5af14ff40b72fcc7b2f32402b42433
#. default-sha256: 54366a905e41a329677e0e98626b34128aee94711ac8c7488f5900869e3b8c4d
msgctxt "scenario3:scenario3_47AA4A64_709B_4E96_BFDD_E0F7A897DA37"
msgid ""
"⟪k:0⟫I was busy... ⟪k:1⟫preparing for our wedding.⟪k:2⟫⟪k:3⟫I had no time to attend an exhibition."
msgstr ""
"⟪k:0⟫Я был занят... ⟪k:1⟫готовился к нашей свадьбе.⟪k:2⟫⟪k:3⟫У меня не было времени ее посетить."

#: scenario3:scenario3_DD4E2548_7FAA_44ED_BE4B_A77BF4A6682B
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 230519906508312b16d5e24219103827cb0bdc85375f30c1d9817360d999998e
#. default-sha256: 19435e96cb68fc44ce7b01d7d9a4881d90a119346d41e85ef32265fb5a9f5e72
msgctxt "scenario3:scenario3_DD4E2548_7FAA_44ED_BE4B_A77BF4A6682B"
msgid ""
"⟪k:0⟫And while I was doing that—⟪k:1⟫⟪k:2⟫giving you, a woman I had never met before, my full "
"attention—"
msgstr ""
"⟪k:0⟫И пока я этим занимался—⟪k:1⟫⟪k:2⟫уделяя тебе, женщине, которую я никогда прежде не видел, "
"все свое внимание—"

#: scenario3:scenario3_265B948C_8BAF_4ED4_81E5_FA434BB590B2
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 4b91820e3ac7e2df31377de096a984843a7e827d69a7fbfaa7fd289df64471a9
#. default-sha256: 2fc87525a5d688b0291a433d9a11cd665689430884d86956eee565708a730c00
msgctxt "scenario3:scenario3_265B948C_8BAF_4ED4_81E5_FA434BB590B2"
msgid "⟪k:0⟫you were giving yours to a different man?"
msgstr "⟪k:0⟫ты уделяла свое другому мужчине?"

#: scenario3:scenario3_E6B45EF6_C756_4058_92BD_C4E3E6B1D1AA
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: d20fd5cd4c86c219af90426e9c7a8f0ddd755159cc5783e2da63d3f9f82edb39
#. default-sha256: d1353e0572ae7c3a604a08a542e4dde201fb558579832751945aa6e4dd517634
msgctxt "scenario3:scenario3_E6B45EF6_C756_4058_92BD_C4E3E6B1D1AA"
msgid "⟪k:0⟫Has this been going on for that long?"
msgstr "⟪k:0⟫Оно что длится так долго?"

#: scenario3:scenario3_611C16A4_B71A_4B53_A9C1_33F45CBCDBDC
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: d14aea07128a6f4c77a80a428a85f18471c10b4d3a6e072294cb998cb3098308
