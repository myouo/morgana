msgid "⟪k:0⟫(But if I don’t... ⟪k:1⟫my imagination will run wild.)"
msgstr "⟪k:0⟫(Но если я не буду читать... ⟪k:1⟫мое воображение в конец доведет меня.)"

#: scenario3:scenario3_7243785E_1298_4CA5_9477_3763B0721D9D
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 40ccfc9834fae4c05bbf4ebc9f7b0d3f5b73d36339aa880ec04fe2dc73b14765
