msgctxt "scenario3:scenario3_7243785E_1298_4CA5_9477_3763B0721D9D"
msgid ""
"⟪k:0⟫(Fantasizing about her writing to this other man... ⟪k:1⟫and what she might be putting in "
"her correspondence...)"
msgstr ""
"⟪k:0⟫(Представлять, как она пишет другому мужчине... ⟪k:1⟫и что она вкладывает в свои послания...)"

#: scenario3:scenario3_C66B43D4_373A_4993_9436_ABBE96833A62
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: df0be35243d16a16b6af0bc55fce568b4007d66b372b141e4a456f7225b1475c
