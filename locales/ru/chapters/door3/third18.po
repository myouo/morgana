msgid ""
"⟪k:0⟫And the sound of the last spike being driven into the ground will be transmitted across the "
"country via telegraph."
msgstr ""
"⟪k:0⟫И звук последнего гвоздя, вбитого в землю, будет передаваться по всей стране через телеграф."

#: scenario3:scenario3_F5EA36F4_C623_4342_9A43_D8DCE50A32F5
