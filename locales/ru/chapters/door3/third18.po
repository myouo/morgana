msgid "⟪k:0⟫And as such... ⟪k:1⟫I will not enter your room until you have given me your permission."
msgstr "⟪k:0⟫Так что... ⟪k:1⟫я не войду в твою комнату, пока ты не дашь мне своего разрешения."

#: scenario3:scenario3_3DAC72CB_C41E_4DD1_B5F0_FEEA4FCD1D33
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
