msgid "⟪k:0⟫⟪k:1⟫⟪k:2⟫Are you awake?⟪k:3⟫⟪k:4⟫It’s me, Jacopo.⟪k:5⟫⟪k:6⟫May I come in?"
msgstr "⟪k:0⟫⟪k:1⟫⟪k:2⟫Ты не спишь?⟪k:3⟫⟪k:4⟫Это я, Джакопо.⟪k:5⟫⟪k:6⟫Я могу войти?"

#: scenario3:scenario3_5AAE587A_3589_4AB5_8902_3829339585B7
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 92b00d612d50043e070d396da5df1200d5a6e4ccf7fd4cdd122386e06e1dc6c9
