msgid "⟪k:0⟫⟪k:1⟫You... ⟪k:2⟫won’t even give me a response?⟪k:3⟫⟪k:4⟫All right..."
msgstr "⟪k:0⟫⟪k:1⟫Ты... ⟪k:2⟫даже не ответишь мне?⟪k:3⟫⟪k:4⟫Хорошо..."

#: scenario3:scenario3_A43BA456_BD46_45F6_8BFE_E661C62BA29C
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 97d20ef1510dddb8e865843e80b24c9774640abbe64fb4eb6c86741851124008
