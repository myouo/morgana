msgid "⟪k:0⟫⟪k:1⟫Jacopo..."
msgstr "⟪k:0⟫⟪k:1⟫Джакопо..."

#: scenario3:scenario3_6EC9BC0C_6BBB_4442_9FEB_25A76E9167B2
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 27acdb6cb646c43c3429b91bec605bcf62a3c8c2b1128ae89220173df7b363d8
#. default-sha256: 0812b9f49ad1820006e46c217b95a6e6659be9c3a60856060b3c4098b0165b20
