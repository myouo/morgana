msgid "⟪k:0⟫And yet still... ⟪k:1⟫she finds other men—!"
msgstr "⟪k:0⟫И все же... ⟪k:1⟫она находит других мужчин—!"

#: scenario3:scenario3_4C875E8F_EAB6_42A4_96A3_49E3618C9C8C
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: fd79237a4b5459da6de977c95a68d80e12cf06a8f7eba32a78d504bd48e43dcb
