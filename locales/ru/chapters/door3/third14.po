msgid "⟪k:0⟫Has she not taken enough already?!⟪k:1⟫What else could she possibly want from me?!"
msgstr "⟪k:0⟫Ей что, все еще мало?!⟪k:1⟫Чего еще ей от меня нужно?!"

#: scenario3:scenario3_97EBAC32_A89C_4B29_B468_333EE3FE3BB8
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 9eaf9293e8b4aea95c71016e197b442010b7c626d999799b1046f015e1c1af5a
