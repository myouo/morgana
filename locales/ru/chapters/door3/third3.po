msgid "⟪k:0⟫............"
msgstr "⟪k:0⟫............"

#: scenario3:scenario3_9B950E9C_C136_469E_8260_D56CF5D195CA
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 22ff30492ff161f2491fa3713129561379bf9c3763804ca32a014a61c64a521b
#. default-sha256: b7c46a22629a3cc80fe54123a822d91b1f64e3612ca9feb4b61e5ce1550bf8c4
