msgid "⟪k:0⟫Ah... ⟪k:1⟫you’re right. ⟪k:2⟫That’s a shame..."
msgstr "⟪k:0⟫Ах... ⟪k:1⟫ты прав. ⟪k:2⟫Как жаль..."

#: scenario3:scenario3_A73F66AE_5CAD_4894_80D3_3C6BC3BE9147
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 9c5d61563951122859c592025112fe9ec5c895fc8ecc86651b160b7c2644d8d1
#. default-sha256: a65a2a71d06ccabf985e08821c358d77e3d988cec5da245b8b4b06810f592daf
msgctxt "scenario3:scenario3_A73F66AE_5CAD_4894_80D3_3C6BC3BE9147"
msgid "⟪k:0⟫I didn’t think you actually ⟪k:1⟫would⟪k:2⟫!"
msgstr "⟪k:0⟫Я не думал, что ты и правда это ⟪k:1⟫сделаешь⟪k:2⟫!"

#: scenario3:scenario3_1A39BFCE_29D4_483C_9085_81B6B88ACF4F
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 4b8f60db47ad513489ed35d65effca76bf66e540ab4731a23cfcfe5295021d6d
