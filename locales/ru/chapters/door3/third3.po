msgid "⟪k:0⟫⟪k:1⟫............"
msgstr "⟪k:0⟫⟪k:1⟫............"

#: scenario3:scenario3_0F1C2CA2_6503_4384_BD20_4B8CB2BF3079
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 4a313422c39adeb0538d2d1ac1ae9c2241cc09e490bb3f11a2142948bc083ce5
