msgctxt "scenario3:scenario3_D32F1859_169D_4F8E_A315_A729952F7F58"
msgid "⟪k:0⟫They looked so happy."
msgstr "⟪k:0⟫Они выглядели такими счастливыми."

#: scenario3:scenario3_DD08FD60_94EA_4A55_B511_349D52C22832
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 934d4316f8921f43a4d0d94f5a019de0eaadaffc0d02f87d722a6ab48cc3d00e
#. default-sha256: 459b4d57b6a72d3a41e8e306fff9121639ead4902e021a3e8e94703ac5324f1f
msgctxt "scenario3:scenario3_DD08FD60_94EA_4A55_B511_349D52C22832"
msgid "⟪k:0⟫I was almost certain that they were off dancing in their joyous world..."
msgstr "⟪k:0⟫Я была практически уверена, что они танцевали в своем радостном мире..."

#: scenario3:scenario3_E9CD185B_9014_49D7_B50E_BB2D96DABF5C
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 3832f2df0b1e6f8b1235e7bcca32a0b6e1fe9847e3a9688ea414f99db335bd58
