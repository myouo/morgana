msgctxt "scenario3:scenario3_E9CD185B_9014_49D7_B50E_BB2D96DABF5C"
msgid "⟪k:0⟫free from all the sorrow and loneliness and pain of this one."
msgstr "⟪k:0⟫лишенного печали, одиночества и боли нашего бытия."

#: scenario3:scenario3_760B185E_C12A_48D4_972D_8BF371762487
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 247f6af10dcbc51da726248fac6f3322df8bbee3017006df9e597bec2b9ba1d8
