msgctxt "scenario3:scenario3_B50CA345_268A_4433_BF1E_DF0A42517F0D"
msgid "⟪k:0⟫It was almost as if God had breathed life into them."
msgstr "⟪k:0⟫Было такое чувство, будто Господь вдохнул в них жизнь."

#: scenario3:scenario3_87D78214_61D3_44E0_9904_BB62CB2182D9
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 7463a1074c337ab1f5d5fdcbe87b2cf1d71b4a19d9861fe1ec374b09a3b520f8
