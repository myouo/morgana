#. default-sha256: 22965746c9540cdd03a5c31023afad4189a795ce3087d8012a827e94ba213d8c
msgctxt "scenario3:scenario3_E1EF9A59_4A8F_415D_A250_F06E12584AED"
msgid "⟪k:0⟫⟪k:1⟫You are aware that I, like you, am an immigrant, right?"
msgstr "⟪k:0⟫⟪k:1⟫Ты ведь знаешь, что я, как и ты, являюсь иммигрантом, верно?"

#: scenario3:scenario3_72DFF2CA_DE97_4C72_86C1_4534482B68C6
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 7811fca7ebaa69e2004fcd801b23f731221a83e3c4df56f80c7c81ae5bb98e85
