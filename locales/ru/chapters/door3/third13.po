msgid "⟪k:0⟫............"
msgstr "⟪k:0⟫............"

#: scenario3:scenario3_D078F5E1_7625_403F_98B3_39F5C781EF3A
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 857a01df8177c7fbe97470b7c83d56ddd7d108333058a47cbe188cedeee2d3ee
#. default-sha256: 6c533c0aec79198b8eac2cc9abb150111e5aca07e7c3aab24e4bcda9d84d9089
msgctxt "scenario3:scenario3_D078F5E1_7625_403F_98B3_39F5C781EF3A"
msgid "⟪k:0⟫You said you won’t be coming back.⟪k:1⟫⟪k:2⟫Did you mean that?"
msgstr "⟪k:0⟫Ты сказала, что не вернешься.⟪k:1⟫⟪k:2⟫Ты это серьезно?"

#: scenario3:scenario3_66F2A51C_D85C_4335_9FDE_436C354A7ACE
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 9397d62a9d78392a6dc0db32ddba96ca7ecddf61b694c910788d5b45f2f3fc93
#. default-sha256: e6dd15913ac23ac6c9b5bc37a8f5951a3f27f64e84dd2ab4c9c4480f5fa53b0e
msgctxt "scenario3:scenario3_66F2A51C_D85C_4335_9FDE_436C354A7ACE"
msgid "⟪k:0⟫Are you absolutely never returning to this town?"
msgstr "⟪k:0⟫Ты на самом деле больше никогда не вернешься в этот город?"

#: scenario3:scenario3_C6AB9DBD_DA31_4922_B89D_C3B382A55377
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 0a6a17a74113624349fadb0cd14e0486eb413ae606fc9d900608977481a2b97b
#. default-sha256: 8f0cada029f47df2068c38638a95e172b83153e161cf898580266c6dc4bddbb0
msgctxt "scenario3:scenario3_C6AB9DBD_DA31_4922_B89D_C3B382A55377"
msgid ""
"⟪k:0⟫There’s no telling what may or may not happen,⟪k:1⟫so it’s best not to get your hopes up."
"⟪k:2⟫⟪k:3⟫Better that than the pain of getting let down."
msgstr ""
"⟪k:0⟫Никто не может сказать, что уготовило будущее,⟪k:1⟫поэтому лучше особо не надеяться.⟪k:2⟫"
"⟪k:3⟫Лучше уж так, чем испытывать боль от разочарований."

#: scenario3:scenario3_81909208_21EC_449A_A0C3_9F99880108A6
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 2a0b9fd49560785b1e000455dd511d568da2d76be676bb50f7ab7e31406ae379
#. default-sha256: 64e1370ff11eeb7e75d893df435858360fd9732972f3fe7d2d67780c09dd87b7
msgctxt "scenario3:scenario3_81909208_21EC_449A_A0C3_9F99880108A6"
msgid "⟪k:0⟫Well, well, I’ve turned into quite the cynic, huh."
msgstr "⟪k:0⟫Ну и ну, а я стала тем еще циником, а."

#: scenario3:scenario3_A893CCD9_E92A_46B7_8928_A019DE169A8D
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 017ad8693e8c0729ed797a14b749648da7289dddca0c0ed7af535ea206fd2beb
#. default-sha256: e4315b87e0d7a73cd2eb894a96cf2e1e0272e8bf547287c23a6d252f13eb94bb
msgctxt "scenario3:scenario3_A893CCD9_E92A_46B7_8928_A019DE169A8D"
msgid ""
"⟪k:0⟫Maybe if I’d been born into a more normal family,⟪k:1⟫I’d be in my room in a pile of dolls "
"right about now,⟪k:2⟫my head in the clouds."
msgstr ""
"⟪k:0⟫Может быть, если бы я родилась в более нормальной семье,⟪k:1⟫я бы сейчас сидела в своей "
"комнате с кучей кукол,⟪k:2⟫витая в облаках."

#: scenario3:scenario3_1F77B153_B0C0_402A_8BE1_79015F2B8336
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 59a221f584195bd6d16e4e95f0c9039740a2befd0b86530e010279161505e4a4
#. default-sha256: e9bf345a6dd6a94ac6d7675476a12a7324432c8d1cd4c0582560c2d867614a0c
msgctxt "scenario3:scenario3_1F77B153_B0C0_402A_8BE1_79015F2B8336"
msgid "⟪k:0⟫I can’t imagine you doing that, nor do I think that’s “normal.”"
msgstr "⟪k:0⟫Я не могу представить тебя за этим занятием, и не считаю, что это “нормально”."

#: scenario3:scenario3_E0769FFD_5E46_48FF_B08D_B86D6CA2261A
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 4d6676cdae5cdf86bc09376b211b9dc059c6703fb8cad7db6f7c9eadc3f4f21e
