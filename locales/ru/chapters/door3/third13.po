#: scenario3:scenario3_07C975E2_D356_4E7B_844A_489E8DC63ADD
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 0742f25fb7c391dbb2020508cd265fcac330c0a9fc046b016e4902ee417797f8
#. default-sha256: 83fac67a5969f40aca85d006507b177d4e51348c33e738d1a379befa485744f4
msgctxt "scenario3:scenario3_07C975E2_D356_4E7B_844A_489E8DC63ADD"
msgid "⟪k:0⟫Where’s your dad?⟪k:1⟫⟪k:2⟫Or are you here alone?"
msgstr "⟪k:0⟫Где твой папа?⟪k:1⟫⟪k:2⟫Или ты здесь один?"

#: scenario3:scenario3_FB79E208_7D31_47CF_A0DA_ABBDAFA22C4F
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 385903b1322a780d0e0ccf3216a0b7eaaca489cdbc99d5bab242d132e5c73bd2
#. default-sha256: c923b04e5f2c3eddaddc2a3fc2ae7ce3feae869fe19b6e00841a71ebe24647d4
msgctxt "scenario3:scenario3_FB79E208_7D31_47CF_A0DA_ABBDAFA22C4F"
msgid "⟪k:0⟫He... ⟪k:1⟫didn’t even tell me..."
msgstr "⟪k:0⟫Он... ⟪k:1⟫даже не сказал мне..."

#: scenario3:scenario3_6FE290DD_7AD9_4B2C_A50A_31C5965984F5
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 3f922a414fb8a58437938dbe32fdf3642bb79b901efddbe0b89854557d9d06a1
#. default-sha256: 7eb4ae2c08f321f2682adc959bd3a7bee4d9bf432932aa45f65b2a8ed995f813
msgctxt "scenario3:scenario3_6FE290DD_7AD9_4B2C_A50A_31C5965984F5"
msgid "⟪k:0⟫Ah..."
msgstr "⟪k:0⟫Ах..."

#: scenario3:scenario3_CDA793AA_8C43_4FEC_9F5D_017005C93182
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 5bbdd2dfea820f5bd13a7131cd01c3333f8d99d09dce0a10c2f41b437c65ff39
#. default-sha256: 2da8a1ee393a9d005fdaf085c815fef1f94c49eb10844afc31bb899e5234bbb6
msgctxt "scenario3:scenario3_CDA793AA_8C43_4FEC_9F5D_017005C93182"
msgid ""
"⟪k:0⟫There’s... ⟪k:1⟫no reason you have to leave town.⟪k:2⟫⟪k:3⟫My old man says the Campanellas "
"have more power."
msgstr ""
"⟪k:0⟫Нет... ⟪k:1⟫никакой причины, чтобы ты покидала город.⟪k:2⟫⟪k:3⟫Мой старик говорит, что у "
"Кампанелла больше власти."

#: scenario3:scenario3_16A96EA9_EC19_443A_9899_DD960278A6BB
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 1a72b3ab32b9915509e75c7b4fd06a07d8823b69e1bbd000d8510817c8d048d2
#. default-sha256: 69ed408f53a632a27ec041bbc5f5f596a1d5c8159e6e7925f8cf3ecf11e12c6d
msgctxt "scenario3:scenario3_16A96EA9_EC19_443A_9899_DD960278A6BB"
msgid "⟪k:0⟫I should be the one leaving."
msgstr "⟪k:0⟫Это я должен уходить."

#: scenario3:scenario3_4A434A8E_FC21_45BB_B783_9126F1B071DF
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: f4a82d267ea1f2f493dbea419cf2caa375504eac66813c4944a057650149bda2
#. default-sha256: 30d77f0401204a15a265221dea187f2024051bf01bf62e7e27baceef00e59c96
msgctxt "scenario3:scenario3_4A434A8E_FC21_45BB_B783_9126F1B071DF"
msgid ""
"⟪k:0⟫It’s not that simple.⟪k:1⟫Grownups have a lot to consider.⟪k:2⟫⟪k:3⟫So don’t give me that "
"look, Jacopo."
msgstr ""
"⟪k:0⟫Все не так просто.⟪k:1⟫Взрослым о многом нужно думать.⟪k:2⟫⟪k:3⟫Поэтому не смотри на меня "
"так, Джакопо."

#: scenario3:scenario3_ED963991_E6FC_4B9D_8FD8_2632C7573FA6
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: eb6ca7e97341bb7f2c4bf95fedd23c58618283e3198e3c3e2a1479234ab666a9
#. default-sha256: 48f41697b22461c825c2f67ac00db3078091b23a05c42741f58ec0ffc02c435d
msgctxt "scenario3:scenario3_ED963991_E6FC_4B9D_8FD8_2632C7573FA6"
msgid "⟪k:0⟫............"
msgstr "⟪k:0⟫............"

#: scenario3:scenario3_94BEA963_2835_4F52_912F_6D6743EBAE65
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 3548ca52340f3eeeb3624f8d386ca48cf6b99709c8182e548a632144853e6605
#. default-sha256: 7458d93abe9215b1de6b2428471624b36424f0d8d49ae1886f5e461fe09a3349
msgctxt "scenario3:scenario3_94BEA963_2835_4F52_912F_6D6743EBAE65"
msgid ""
"⟪k:0⟫We were kids, but we’d both kinda started to catch on—⟪k:1⟫⟪k:2⟫to the situation with our "
"families, and to the bonds that land held on us."
msgstr ""
"⟪k:0⟫Мы были детьми, но оба, вроде как, начали все понимать — ⟪k:1⟫⟪k:2⟫ситуации с нашими "
"семьями, и возлагающиеся на нас обязательства перед этой землей."

#: scenario3:scenario3_B0E1009B_E596_43B6_8C25_F53242CA2929
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: a2c8d324d843936116fca2f673d4641fae5a65d88857fffc4d044c4666e73c68
#. default-sha256: 1af7928580c4daad5b93ae28e6e7dcf08be75bc49ca608bd9a7ead8d35d2f658
msgctxt "scenario3:scenario3_B0E1009B_E596_43B6_8C25_F53242CA2929"
msgid "⟪k:0⟫Although we didn’t know any of the details at the time."
msgstr "⟪k:0⟫Пускай, в то время мы и не знали каких-то деталей."

#: scenario3:scenario3_420E9C01_B49E_4D3D_9484_B9EB1E8426BC
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: c1d2198c8d3db28888e020c1720a99b01e89f38f9cecc999047bd7cec7c765f1
#. default-sha256: d2fde5627cbd619c69583f97289fdb0df882a856719fce0a007a7d8fbf84dc0e
msgctxt "scenario3:scenario3_420E9C01_B49E_4D3D_9484_B9EB1E8426BC"
msgid ""
"⟪k:0⟫My grandpa owned all the land the city was built on, but he was a very conservative man. "
"⟪k:1⟫He didn’t try to spread his influence, instead opting to fortify what he already had."
msgstr ""
"⟪k:0⟫Мой дедушка владел всей землей, на которой был построен город, но он был очень "
"консервативным человеком. ⟪k:1⟫Он не пытался распространять свое влияние, вместо этого стараясь "
"укрепить то, что уже имел."

#: scenario3:scenario3_44E5E60F_619F_4783_9AF8_6D59FB70B4CA
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 59c45257471445712e0bf06ecf4a42e7502b2822968e636e889d7310698b83e5
#. default-sha256: fa7569714b70b8bdfd0f593b8144e5f123602245ef5b8e792d614899af59b655
msgctxt "scenario3:scenario3_44E5E60F_619F_4783_9AF8_6D59FB70B4CA"
msgid ""
"⟪k:0⟫I don’t know exactly when it first started, but organizations were used to administrate "
"cities."
msgstr "⟪k:0⟫Я не знаю точно, когда это впервые началось, но организации контролировали города."

#: scenario3:scenario3_FE03D2C2_CE9D_49A0_AD09_93D508BD862D
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 9ecd9b6652d9699a0262ef4f87e4a6549fbf665e9110e542274c04cf524894cf
#. default-sha256: f4f9f1c88a91ccdfe825c79866e3dbe4e86af87e857727ebbdd525e5b3577e34
msgctxt "scenario3:scenario3_FE03D2C2_CE9D_49A0_AD09_93D508BD862D"
msgid "⟪k:0⟫And when we were kids, my dad was the capofamiglia, and my grandpa his consigliere."
msgstr "⟪k:0⟫И когда мы были детьми, мой отец был капофамилья, а мой дедушка его консильери."

#: scenario3:scenario3_DE4155A7_D75E_47AA_BA2F_C5237A5D2575
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 4fa5a19935aac48917876c2f82a0b6f9033d740e4b6a4e0a727ad060c0f86ed9
#. default-sha256: 1f455387bacca148b726483b23fe4c0e0b31200f5428e95b4966d9c83bee421b
msgctxt "scenario3:scenario3_DE4155A7_D75E_47AA_BA2F_C5237A5D2575"
msgid ""
"⟪k:0⟫But just because he was an adviser didn’t mean he was powerless. ⟪k:1⟫While my dad made the "
"decisions, my grandpa was the only one allowed to fight him on them."
msgstr ""
"⟪k:0⟫Но то, что он был лишь советником, вовсе не означало, что он не обладал властью. ⟪k:1⟫Пока "
"мой отец принимал решения, только моему дедушке позволялось их оспаривать."

#: scenario3:scenario3_56045517_5319_4499_BB6B_D42414E734FE
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 5b1eaa1de2278b68cea5307d92e6fa920f7f684f4cc5902e43c206b668c1b5a3
#. default-sha256: 61b81b116f1e3144a95559242a2196215c05ed60a5e01beb346a644c1dbf38a5
msgctxt "scenario3:scenario3_56045517_5319_4499_BB6B_D42414E734FE"
msgid ""
"⟪k:0⟫Your father was a capodecina that served under my dad; ⟪k:1⟫he wasn’t especially happy about "
"that."
msgstr ""
"⟪k:0⟫Твой отец был каподечина, который служил моему отцу; ⟪k:1⟫хотя он не особо был этому рад."

#: scenario3:scenario3_E92A8C87_218D_41CE_9786_583BDA361FB7
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 2856ff93057f0f2b58e6ae2c3f09b2c843a2ff45802c3ee20597dcc2dacab5c8
#. default-sha256: e737083230905e490a94a65bccade3e7b90558c1eb2464732017075f7e5648c0
msgctxt "scenario3:scenario3_E92A8C87_218D_41CE_9786_583BDA361FB7"
msgid ""
"⟪k:0⟫But parents’ quarreling doesn’t affect their kids—⟪k:1⟫⟪k:2⟫or at least, that’s what I "
"thought at the time, and what you probably thought too."
msgstr ""
"⟪k:0⟫Но ссоры родителей не влияют на их детей — ⟪k:1⟫⟪k:2⟫во всяком случае, тогда я так думала, и "
"ты, вероятно, тоже."

#: scenario3:scenario3_28B62F9C_A22F_4061_8C74_AF06E01EF4AE
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: e7b604a099275a96396ead3fb909504ee0ea12c6592cd5f0f1304e06396a7773
#. default-sha256: 02da806ce1eb9fad5c11afa6ad0be5bc8618c0e4efb4705f46b5e4ac820b23c3
msgctxt "scenario3:scenario3_28B62F9C_A22F_4061_8C74_AF06E01EF4AE"
msgid ""
"⟪k:0⟫But there was still a chance we could be caught in the crossfire, so my dad decided to send "
"me and my mom away."
msgstr ""
"⟪k:0⟫И все-таки был шанс, что мы могли угодить под перекрестный огонь, поэтому мой отец решил "
"отослать меня и маму как можно дальше."

#: scenario3:scenario3_F203B666_9A02_4FA1_97BC_4021E9442EBC
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 49cac61607bbb8dbf6a26c7a156407c82d7cfe8d43b0c65b1a7bab0e4be76e23
#. default-sha256: 0b740311f227d1a2e4d46a623061c967b6eaf50d15bb4ca401aa37069cc1cfd5
msgctxt "scenario3:scenario3_F203B666_9A02_4FA1_97BC_4021E9442EBC"
msgid "⟪k:0⟫Off the island and to the north were some more prosperous areas."
msgstr "⟪k:0⟫С этого острова, на север, в более благоприятные края."

#: scenario3:scenario3_EFB90E92_858C_4A69_8A70_A1F053E3BA3A
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: a4ec099fa477ae0fd2448ddd12f7020fbac982edb9cd7af5b3436088a55cb59a
#. default-sha256: eb70f60f5b83d93a3ece0190b287e00400497bc7e2d56803efad1496372e9c23
msgctxt "scenario3:scenario3_EFB90E92_858C_4A69_8A70_A1F053E3BA3A"
msgid ""
"⟪k:0⟫He thought that by sending us there, we could live our lives clean, regardless of where we "
"came from."
msgstr ""
"⟪k:0⟫Он думал, что если отправит нас туда, мы сможем начать жить с чистого листа, несмотря на то, "
"откуда прибыли."

#: scenario3:scenario3_FB5A0103_4072_4CE8_97DE_29C346E2241A
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 59c804b2b12bb44923a2fcceaf05faf05fe3266ab7877f8f351e9b912f8e8563
#. default-sha256: c802909f9c1aa74431f6d9f28fcaee61ec154322775e8471893e82e3c0725e25
msgctxt "scenario3:scenario3_FB5A0103_4072_4CE8_97DE_29C346E2241A"
msgid "⟪k:0⟫There’s no changing what’s in your blood, though."
msgstr "⟪k:0⟫Однако того, что у тебя в крови, ничто не в силах изменить."

#: scenario3:scenario3_65B10959_E51A_4BFE_BAD9_71004141E3EF
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 8e58ccb34932108e060a301ffa5b8132d69e2d5ffad277742b835ca482427b89
#. default-sha256: 32e889598d4e26848d937cf57c1754dfc05036d5cda3d1d24eb7e7b8869c0e03
msgctxt "scenario3:scenario3_65B10959_E51A_4BFE_BAD9_71004141E3EF"
msgid ""
"⟪k:0⟫You could have told me too.⟪k:1⟫⟪k:2⟫Or were you planning on leaving without saying anything?"
msgstr "⟪k:0⟫Ты тоже могла бы мне сказать.⟪k:1⟫⟪k:2⟫Или ты планировала уехать без единого слова?"

#: scenario3:scenario3_238D2C70_8B02_445E_A29F_79A27DE018DE
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 41d562c8d3d9926b0692d6de7db4b2e6b1767929d9e4e40b2166fdf2783fcd2e
#. default-sha256: 0b7626e1480767d3f39cf3a881c516f7f356904db1907d066e9416655ddee6fc
msgctxt "scenario3:scenario3_238D2C70_8B02_445E_A29F_79A27DE018DE"
msgid "⟪k:0⟫No, it was just... ⟪k:1⟫all decided so quickly."
msgstr "⟪k:0⟫Нет, просто... ⟪k:1⟫все решилось так быстро."

#: scenario3:scenario3_526F465D_F414_4B7B_BDFB_CBB6009BBC02
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: b195c9b258b79e8034daabf08cd4d5a70bcf96ea88c34d88e6ef0442cb43d093
#. default-sha256: f879b8d14ce1b354b3283280a97ed367099cbfed9aa7ffee01c097ac1a3d1180
msgctxt "scenario3:scenario3_526F465D_F414_4B7B_BDFB_CBB6009BBC02"
msgid "⟪k:0⟫Why do you sound so accepting?"
msgstr "⟪k:0⟫Почему ты говоришь так, словно смирилась?"

#: scenario3:scenario3_E46D378D_F8E2_4F01_9878_B209DD6FB66B
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 758ab67f3a61ce329f6532b170b1aa93c4bddb910edf92ed6e5a680b2748c7cb
#. default-sha256: c6990bed50d490852bd708df927092052333f4053c0aab2e6255b164ca339158
msgctxt "scenario3:scenario3_E46D378D_F8E2_4F01_9878_B209DD6FB66B"
msgid ""
"⟪k:0⟫Adults have a lot to consider?⟪k:1⟫You bet they do! But you could at least let them know "
"you’re opposed to it, Maria! But no, your tail went straight between your legs as soon as you "
"were told."
msgstr ""
"⟪k:0⟫Взрослым о многом нужно думать?⟪k:1⟫А как иначе! Но ты могла бы, по крайней мере, дать им "
"понять, что ты против, Мария! Но нет, ты тут же поджала свой хвост между ног, как только они тебе "
"сказали."

#: scenario3:scenario3_DD4238B2_DF1E_4F6E_8239_B8DCDE698AFF
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: bd0297df1f9ffd3f1f2f22a3873499e13bf1fab337e0aa2f96c676754a1e9248
#. default-sha256: 1af53aba213d48198cd10225f665fe47a9be68dbfb328eec3f4f30042b13f7be
msgctxt "scenario3:scenario3_DD4238B2_DF1E_4F6E_8239_B8DCDE698AFF"
msgid "⟪k:0⟫You just gave up and accepted it straight away!"
msgstr "⟪k:0⟫Ты просто сдалась и сразу же смирилась!"

#: scenario3:scenario3_6ACE91E0_57E9_42AB_A176_501F27BA5E25
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: f7fc024cc3c699406ee2f5e1c9aef1e01a669f170e381973ac33997c5ab475d1
#. default-sha256: 48f41697b22461c825c2f67ac00db3078091b23a05c42741f58ec0ffc02c435d
msgctxt "scenario3:scenario3_6ACE91E0_57E9_42AB_A176_501F27BA5E25"
msgid "⟪k:0⟫............"
msgstr "⟪k:0⟫............"

#: scenario3:scenario3_AA349960_186A_4D99_B875_EEA811D839DC
