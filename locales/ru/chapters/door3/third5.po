#: scenario3:scenario3_D0C9D982_C558_4D64_9BD3_7C0723FA5CB1
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 53b8f2e1bb1fdbbf0a699dd7778a1e15d8e71803c4b10a56410bc97e78678a78
#. default-sha256: 7a3735eb9fed9d322e5c8d1a54c1df1cf920ff1412100b7268ce37c99bfe7daf
msgctxt "scenario3:scenario3_D0C9D982_C558_4D64_9BD3_7C0723FA5CB1"
msgid ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫⟪k:4⟫⟪k:5⟫⟪k:6⟫⟪k:7⟫⟪k:8⟫⟪k:9⟫⟪k:10⟫Bwahahahahahahahah! That’s rich!⟪k:11⟫"
"Amazing! Oh my ⟪k:12⟫god⟪k:13⟫, you scream like a little girl!"
msgstr ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫⟪k:4⟫⟪k:5⟫⟪k:6⟫⟪k:7⟫⟪k:8⟫⟪k:9⟫⟪k:10⟫Бхаааааааахахаха! Ну и умора!⟪k:11⟫"
"Невероятно! О, ⟪k:12⟫Господи⟪k:13⟫, ты вопишь, как маленькая девочка!"

#: scenario3:scenario3_D9E3BEA2_4DBA_4189_AB9D_4E90C667BD4E
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: e9e6d2ddf484ba7bd49f6a2d79ed95f71d41ec6c05d05fc604637fc6614c6b4e
