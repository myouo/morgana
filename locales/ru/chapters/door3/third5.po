msgid "⟪k:0⟫⟪k:1⟫Actin’ tough after the fact just makes you look like twice as much of a wuss."
msgstr "⟪k:0⟫⟪k:1⟫Со своей показной бравадой, ты только выглядишь вдвое трусливее."

#: scenario3:scenario3_1A9151F1_9AF4_40AE_BE2E_9A023E3EADF0
