msgid "⟪k:0⟫Oh, right... ⟪k:1⟫just a second."
msgstr "⟪k:0⟫Ох, верно... ⟪k:1⟫одну секунду."

#: scenario9:scenario9_248F1D6E_8271_41CC_90F2_854250BEC6BF
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: bb995e89fba9e648603bf7316945c3f705a2bbc1244b0d34de8d378296b37d10
