msgid "⟪k:0⟫Hmm? Ah, that one?⟪k:1⟫⟪k:2⟫Looks like she goes to the junior high a few streets down?"
msgstr "⟪k:0⟫Хмм? Вон та?⟪k:1⟫⟪k:2⟫Похоже, она направляется в среднюю школу, в соседнем квартале?"

#: scenario9:scenario9_F197EFDC_7DCD_43E4_A35E_B6655CB7E1DD
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 4b17b9b0b49feada4a852a00e33fb2978bc900469d5e3084a4f2ed09584fadf8
