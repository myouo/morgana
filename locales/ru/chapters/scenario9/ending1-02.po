msgid "⟪k:0⟫To remember who I am."
msgstr "⟪k:0⟫Вспомнить, кто я такая."

#: scenario9:scenario9_BC25A711_5E45_4DC4_8C15_3BF938940FA9
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: fca0699b087f87dcbaa0727497d604f8b6c977a89e27089d33e00314f83d09d0
