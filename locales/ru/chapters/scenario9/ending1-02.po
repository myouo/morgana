msgctxt "scenario9:scenario9_BC25A711_5E45_4DC4_8C15_3BF938940FA9"
msgid "⟪k:0⟫You mean that you’re a part of Morgana?"
msgstr "⟪k:0⟫Ты хочешь сказать, что являешься частью Морганы?"

#: scenario9:scenario9_6E4A8859_8DE0_46C7_ADD1_3C484B066284
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 2aeeb6e1209518602de3d9962074018b8b4360027224cb81e5386802ee491dc9
#. default-sha256: 1588251d6786085f267de3ce8559e29514113c38a40e35d3cc3523a79c6175c1
msgctxt "scenario9:scenario9_6E4A8859_8DE0_46C7_ADD1_3C484B066284"
msgid ""
"⟪k:0⟫My apologies. Bringing your soul here without any preparation has left you in a bit of a... "
"⟪k:1⟫nebulous state."
msgstr ""
"⟪k:0⟫Прими мои извинения. Перенесшись сюда без подготовки, ты, конечно же, находишься в "
"некотором... ⟪k:1⟫замешательстве."

#: scenario9:scenario9_848F96ED_BA6F_4955_9574_ACD71035010C
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: c7cecd0499e607fe0badbc863728c5c06a5f0849097806307b24959154460fe0
