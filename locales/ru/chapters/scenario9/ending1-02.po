msgid "⟪k:0⟫You always acted... ⟪k:1⟫out of the good of your heart."
msgstr "⟪k:0⟫Ты всегда действовала... ⟪k:1⟫из самых лучших побуждений."

#: scenario9:scenario9_3553894F_EA73_4C5E_BD18_85D9258CD87B
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 8691f47c0996d6689655f43d734641efb0483159065683a62acd53e34db15eb6
