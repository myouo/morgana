msgid "⟪k:0⟫I pray you will be able to help me."
msgstr "⟪k:0⟫Я молюсь о том, чтобы ты сумел мне помочь."

#: scenario9:scenario9_67E6FE66_E9AF_49A2_BAB8_937EC9E55832
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: d608ff87e76d9daa473a7bcf82c71f2bb6e161083e770424e954ba27f623dc7b
