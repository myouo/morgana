msgctxt "scenario9:scenario9_7A53115B_CAC3_4A69_B7CF_15B5D7581784"
msgid "⟪k:0⟫Of course I do...⟪k:1⟫⟪k:2⟫How could I ⟪k:3⟫not⟪k:4⟫ know who you are?"
msgstr "⟪k:0⟫Конечно знаю...⟪k:1⟫⟪k:2⟫Как я могу ⟪k:3⟫не⟪k:4⟫ знать о том, кто ты?"

#: scenario9:scenario9_5F8FC082_08D1_41B5_AF9E_44E99A4CA02F
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 0b1a3d4b6fb1f7462869a1a2d6a886a329c31bc83f1a82bf830c3641f36115e9
