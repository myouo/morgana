#: scenario9:scenario9_EF768DFA_9AB5_4F1E_9BAC_8B54FEC7F54E
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 01f64bf564d1eea633574f5317fbf1eec1a7eae7b39e0cb5d3094099fbcc922b
#. default-sha256: a4e3840dac6fc21c6637acb210ae76cea2ba83b2497a8efebafc2ca30c83ec80
msgctxt "scenario9:scenario9_EF768DFA_9AB5_4F1E_9BAC_8B54FEC7F54E"
msgid "⟪k:0⟫Why is there a sword in your hands?"
msgstr "⟪k:0⟫Почему у тебя в руках меч?"

#: scenario9:scenario9_68EEC317_9276_4E14_A303_77624A0F3FB5
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: b4c3d59c976eda34acf34ec9037257002a6ce9608625a21af305c931af8bd55d
#. default-sha256: 17df8c679173509bd209ba5d504f22027544221c8fb978a7322232404f55b35d
msgctxt "scenario9:scenario9_68EEC317_9276_4E14_A303_77624A0F3FB5"
msgid ""
"⟪k:0⟫I realize that it’s cruel for me to ask this of you,⟪k:1⟫⟪k:2⟫and for that, I deeply "
"apologize."
msgstr ""
"⟪k:0⟫Я осознаю, что с моей стороны жестоко просить тебя о таком,⟪k:1⟫⟪k:2⟫и за это прими мои "
"глубочайшие извинения."

#: scenario9:scenario9_148F91BC_E4C1_467E_B6E2_A38C3FA5AEE7
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: df54497d1502e0629b38c826a36c1cafec88f22fc72171c03944cc3fa1d51cce
#. default-sha256: 0fd0581781f5b34baaf9ce59ee6192ef448b6a46a1a9680536de6279bb3a6303
msgctxt "scenario9:scenario9_148F91BC_E4C1_467E_B6E2_A38C3FA5AEE7"
msgid ""
"⟪k:0⟫That’s not why I sought the truth...⟪k:1⟫⟪k:2⟫Not because I wanted to see anyone "
"“extinguished”..."
msgstr ""
"⟪k:0⟫Я не для того искал правду...⟪k:1⟫⟪k:2⟫Не потому, что хотел видеть, как кто-то будет "
"“уничтожен”..."

#: scenario9:scenario9_04875D08_CAE1_4730_9063_7003DD5C6999
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: ea480b5c4615f23e0ca95d7324c93ec63802c1a77d9730bd31ae026ad8b81789
#. default-sha256: c6590be8976ef0cfe8ccd539d9b8342b8c011a435888cf392dfc358e283db7cf
msgctxt "scenario9:scenario9_04875D08_CAE1_4730_9063_7003DD5C6999"
msgid "⟪k:0⟫Because I wanted to put an ⟪k:1⟫end⟪k:2⟫ to this cycle of pain and suffering..."
msgstr "⟪k:0⟫Потому что хотел положить ⟪k:1⟫конец⟪k:2⟫ этому круговороту боли и страдания..."

#: scenario9:scenario9_DE0645BD_A94B_49F2_97B1_549192018D30
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 5a1612ea526bb587f33c6cddf358fd3d2a2ffe1fcbde0529b40f54bd45388260
#. default-sha256: 3d78dde5805b6886e66b40a3b8d68b17cd71fbbbaaf7428b9c872bde78cb34b7
msgctxt "scenario9:scenario9_DE0645BD_A94B_49F2_97B1_549192018D30"
msgid "⟪k:0⟫That includes you."
msgstr "⟪k:0⟫Тебя в том числе."

#: scenario9:scenario9_47FB5147_8F88_4FBA_BD47_47D48530ED8A
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 5a7bf23277f3be51614abde8f56f7531ac599d56b5f986cffdeaeddc696a626b
#. default-sha256: ae573aa4f164028b0d97e19bd86f523d7fc06e9ef440928ab2ad6b81635627da
msgctxt "scenario9:scenario9_47FB5147_8F88_4FBA_BD47_47D48530ED8A"
msgid "⟪k:0⟫I was not a victim in the tragedies...⟪k:1⟫⟪k:2⟫I am culpable for them."
msgstr "⟪k:0⟫Я не была жертвой трагедий...⟪k:1⟫⟪k:2⟫Я была их виновником."

#: scenario9:scenario9_830104B4_BEF4_412F_BDDC_A90871F518EB
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 966613a8e26addc258da028fd228b48c39b9ffa63b22d63e7729c7085abb3953
