msgctxt "scenario9:scenario9_830104B4_BEF4_412F_BDDC_A90871F518EB"
msgid "⟪k:0⟫I saw everything, from start to finish."
msgstr "⟪k:0⟫Я все видел, от начала и до конца."

#: scenario9:scenario9_0AE6046F_3ED5_40C0_85EA_E230A5B45AA4
