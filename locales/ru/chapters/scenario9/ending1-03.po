msgctxt "scenario9:scenario9_7F8EE5F7_11D1_4996_A0CA_9123B8E172A8"
msgid "⟪k:0⟫Never mind that... ⟪k:1⟫Where ⟪k:2⟫am⟪k:3⟫ I?"
msgstr "⟪k:0⟫Это не важно... ⟪k:1⟫Где ⟪k:2⟫я⟪k:3⟫?"

#: scenario9:scenario9_7A53115B_CAC3_4A69_B7CF_15B5D7581784
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 5395d88e734e3b27da71d6ae3574f579b94237506d06cf2c033801bd41388aa0
