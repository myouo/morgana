#: scenario9:scenario9_CDE192CC_D8E1_483D_ADDA_BF5B772FFBF8
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 28972b52afbe8c08d464808e0bef99596749f46a078d9c526b919d3fa68e87db
#. default-sha256: f62caa0126ece4096cf2986ee24e92e2d390a9c224449a1ceb8a4a1cc892e018
msgctxt "scenario9:scenario9_CDE192CC_D8E1_483D_ADDA_BF5B772FFBF8"
msgid "⟪k:0⟫that there’s anything wrong with wanting to live."
msgstr "⟪k:0⟫что в желании жить есть хоть что-то неправильное."

#: scenario9:scenario9_427B61FA_F1B1_48B4_A6BF_CD32FDF16F18
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: c9b2406dbfd9b78fec441a685d541484fd503fcf238b5cb9aac45dd589d0b829
#. default-sha256: 94628faed70f0c36ec9474b8a7188e8d63111a3108121fc864c66e50fcbb9dfb
msgctxt "scenario9:scenario9_427B61FA_F1B1_48B4_A6BF_CD32FDF16F18"
msgid "⟪k:0⟫I was supposed to remain within Morgana, as a part of her."
msgstr "⟪k:0⟫Я должна была оставаться внутри сущности Морганы, быть ее частью."

#: scenario9:scenario9_107F121F_562F_4D89_9F82_76A29429BD7B
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: ad61b21e2f918be4818314948fda4249b1e166d00aa4900fe5161e5972b4b89e
#. default-sha256: b51b1544d5ffb8ec99a04f50de113943dadc22778e572cf99347dfe644bb078f
msgctxt "scenario9:scenario9_107F121F_562F_4D89_9F82_76A29429BD7B"
msgid "⟪k:0⟫To become one... ⟪k:1⟫was to turn against the laws of the universe."
msgstr "⟪k:0⟫Стать ей... ⟪k:1⟫означало пойти против законов вселенной."

#: scenario9:scenario9_B3DA77E1_8EE0_4E8D_964B_3B154B0396F5
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 5467f0dfc91ba3e7f4f02fb31d78adede4630ed6eed6479058ca749f588ad0d0
#. default-sha256: b4753a283da8c26d36bb5392ad4de4361452f4b1e7acd794b9a40d9b9498ea3d
msgctxt "scenario9:scenario9_B3DA77E1_8EE0_4E8D_964B_3B154B0396F5"
msgid "⟪k:0⟫Because that was where she lingered—⟪k:1⟫⟪k:2⟫the girl from which I was formed."
msgstr ""
"⟪k:0⟫Потому что именно в нем обитала она — ⟪k:1⟫⟪k:2⟫девушка, частью которой я некогда являлась."

#: scenario9:scenario9_13865182_DB1B_4F73_B3AA_181FDF2483F0
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: aca29289c02ac1fa6ceefb1a9fffc5a7be77ff95b9871a47145a7225e9ce9ff1
