msgid "⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫⟪k:4⟫We meet at last..."
msgstr "⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫⟪k:4⟫Наконец-то мы встретились..."

#: scenario9:scenario9_7F8EE5F7_11D1_4996_A0CA_9123B8E172A8
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: e35139c6389261906e5bc2c6c54dd04fecdb30b7e47310608f85b7581eda0e44
