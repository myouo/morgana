#: scenario9:scenario9_1E9F04AC_24CD_462E_9AC3_D4184EABDCD7
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 0e2aaae1b246e9886b80bff7053b419a8d122dcb70c86253397399e3fd8cfc98
#. default-sha256: a9bd4d9bb916255079fcc53c1d1d9f6b2a779516f6ee8cdf407abbb68389e685
msgctxt "scenario9:scenario9_1E9F04AC_24CD_462E_9AC3_D4184EABDCD7"
msgid "⟪k:0⟫And why... ⟪k:1⟫can I not speak?"
msgstr "⟪k:0⟫И почему... ⟪k:1⟫я не могу говорить?"

#: scenario9:scenario9_FDA1CBD3_AAFE_4D07_AB73_5CB3BF3EE90A
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: e63191d06ec57421b333ddefa5bd74ac3b0937ae5b759d6861f20726a0146353
#. default-sha256: 4caa3aa53462345286c8f70fd328ed22c47b4ca305819e1e492e9bda728eb8ce
msgctxt "scenario9:scenario9_FDA1CBD3_AAFE_4D07_AB73_5CB3BF3EE90A"
msgid "⟪k:0⟫I was able to return to this gathering place of souls thanks to your efforts."
msgstr "⟪k:0⟫Благодаря твоим стараниям я смогла вернуться в это обиталище душ."

#: scenario9:scenario9_D024F237_3183_4E5B_BE81_82AD558E0E75
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 3729028829e5bfc09c3b5d81b4b739bc4b89f45be3b1cf7905f39c10b8dd3016
#. default-sha256: b1aaca66e634c83d74b558079715508c7e3cc6090266945a2c47f98ba99c2777
msgctxt "scenario9:scenario9_D024F237_3183_4E5B_BE81_82AD558E0E75"
msgid "⟪k:0⟫But my heart told me I had to do this now."
msgstr "⟪k:0⟫Но мое сердце сказало мне, что я должна сделать это именно сейчас."

#: scenario9:scenario9_74D6CBEA_B305_4027_B19E_4D301A77EACC
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: a76f5ad8a901cf318d5142f150d22e43155ca7431b37726581ca3b7b06bce3f6
#. default-sha256: f6eb73755756c02f64d775f7c9c75d7ef94ac436a5017622006f0d0fac03744f
msgctxt "scenario9:scenario9_74D6CBEA_B305_4027_B19E_4D301A77EACC"
msgid "⟪k:0⟫I have brought you here to ask for your assistance."
msgstr "⟪k:0⟫я привела тебя сюда, чтобы просить о помощи."

#: scenario9:scenario9_6BA1FB6E_E41D_48FA_90FD_50C8BA4E5933
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: bc207a3b01332383d2c641797031308dd13ad8cc2fb58341cc13ea7f20a7abff
#. default-sha256: 79020ab0979c0923240bec4651625ca122580609b1c71910994c26a78bde6fba
msgctxt "scenario9:scenario9_6BA1FB6E_E41D_48FA_90FD_50C8BA4E5933"
msgid "⟪k:0⟫take this blade, and with it, extinguish my soul."
msgstr "⟪k:0⟫возьми меч и с его помощью уничтожь мою душу."

#: scenario9:scenario9_46C9FD96_4824_4A8E_B09A_005FD2D06FB3
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 4639762426522ea2ec2cf7a32c8bddc3f24ce5d9246ed1f28b5516cc3cf5644b
#. default-sha256: a1d850d0a4bc2356d37439d91c4c8b2079eca83812ce23558dac86a4f8d35af8
msgctxt "scenario9:scenario9_46C9FD96_4824_4A8E_B09A_005FD2D06FB3"
msgid "⟪k:0⟫Because I wanted to save every last person caught in this tragic quagmire."
msgstr "⟪k:0⟫Потому что хотел спасти каждого, кого поглотила эта трясина бесконечных несчастий."

#: scenario9:scenario9_EB0AB613_6210_4CB4_B8ED_D5CAAEC5535D
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 8013ba3e371ee5a0ca295f635728ec50334345cf52c9aa7a9498dd87956bb529
#. default-sha256: 1f2d7a9e76108ac8ff51495370717b401e0e6e2e32cd2d713892482d55e38fef
msgctxt "scenario9:scenario9_EB0AB613_6210_4CB4_B8ED_D5CAAEC5535D"
msgid ""
"⟪k:0⟫You can’t tell me that after everything you’ve seen...⟪k:1⟫⟪k:2⟫you haven’t realized that I "
"have no place in their lives."
msgstr ""
"⟪k:0⟫Не говори, что после всего увиденного...⟪k:1⟫⟪k:2⟫ты не осознал, что мне нет места в их "
"жизнях."

#: scenario9:scenario9_B62E9CEB_A857_4BDC_8BC4_DE2D0B129191
