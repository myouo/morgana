msgid "⟪k:0⟫But what are you doing here?"
msgstr "⟪k:0⟫Но что ты тут делаешь?"

#: scenario9:scenario9_2350185D_01F0_4ECC_8739_736AF54BE615
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 9ef079a5f213eeac6052f96ff3c58fff373b0c02fe71cf1efb60a75aae098527
