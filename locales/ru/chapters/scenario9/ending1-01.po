msgid "⟪k:0⟫What? ⟪k:1⟫Why is... ⟪k:2⟫the White-Haired Girl here...?"
msgstr "⟪k:0⟫Что? ⟪k:1⟫Почему здесь... ⟪k:2⟫Белокурая Девушка...?"

#: scenario9:scenario9_EDA5A59B_1C8D_42AA_B3CE_97BFD760A867
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 70e2a5df712494df1eed16b84ad6a8c474705d1f3ddae1fe91312898e08d7751
