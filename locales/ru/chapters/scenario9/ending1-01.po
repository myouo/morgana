msgctxt "scenario9:scenario9_EDA5A59B_1C8D_42AA_B3CE_97BFD760A867"
msgid "⟪k:0⟫I was trying to get back to the mansion..."
msgstr "⟪k:0⟫Я пытался вернуться в особняк..."

#: scenario9:scenario9_5A6522EC_2818_41C0_A275_E01EFE5F6893
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: f751d3c3526d39ca3a0b88c77270a4ff127ebe65b3c2f15217421848c13b13ab
