msgctxt "scenario9:scenario9_2350185D_01F0_4ECC_8739_736AF54BE615"
msgid "⟪k:0⟫Remember... ⟪k:1⟫who you are?"
msgstr "⟪k:0⟫Вспомнить... ⟪k:1⟫кто ты такая?"

#: scenario9:scenario9_35B96620_2434_4B0B_AFA5_99A6EF685A71
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 276c4abbb4e2a7b66ac4f8c6b90abbd1629cc565e1900da4bd7f150f76ef3e5f
