msgctxt "scenario7:scenario7_2B1306B5_E4DA_499A_A661_6936ECC0D8BB"
msgid "⟪k:0⟫but it would seem my will is not as absolute as I had thought."
msgstr "⟪k:0⟫но, похоже, я не обладаю абсолютной властью, как мне казалось."

#: scenario7:scenario7_693D17D2_4D59_444F_8262_01C1D36A1DE5
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: e6bb2c6c4a6588e7ceb055a41e13f6be2aff1395a16d6e9875ee771d0fc09f75
