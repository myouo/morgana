msgid ""
"⟪k:0⟫This is my mansion. ⟪k:1⟫My domain.⟪k:2⟫⟪k:3⟫She was ⟪k:4⟫supposed⟪k:5⟫ to be locked up,"
msgstr ""
"⟪k:0⟫Это мой особняк. ⟪k:1⟫Мои владения.⟪k:2⟫⟪k:3⟫Она ⟪k:4⟫должна была⟪k:5⟫ оставаться запертой,"

#: scenario7:scenario7_2B1306B5_E4DA_499A_A661_6936ECC0D8BB
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 25a017c867fc53391e43718528133f210b6678b3acb6b30091b89b70ca7706e2
