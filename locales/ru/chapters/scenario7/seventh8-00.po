#: scenario7:scenario7_3905A0DF_5399_40E6_89EA_481CCE30AF81
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 431ef298421f7599f8bd0d6ec24b132a0bc77c2102e8df4dfaeb4e48907d9069
#. default-sha256: e0e522d0296669b2760e9974084f95d01628810eb7ab2a521afb8c2fff8a3cbb
msgctxt "scenario7:scenario7_3905A0DF_5399_40E6_89EA_481CCE30AF81"
msgid "⟪k:0⟫Thank you... ⟪k:1⟫for opening the door."
msgstr "⟪k:0⟫Спасибо... ⟪k:1⟫за то, что открыл дверь."

#: scenario7:scenario7_D7BF15E8_BDB8_49BE_9389_3050755E9FC2
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 40ebf634437925b12808286f26019d20e161d1d29b67e973149f1abc241b6357
#. default-sha256: 220ab8eb956904437b2c201e00d8282230ecfb426d1e9adb883b84a5c0df93e7
msgctxt "scenario7:scenario7_D7BF15E8_BDB8_49BE_9389_3050755E9FC2"
msgid ""
"⟪k:0⟫The skeleton, which had been sitting there as long as I had been at this house, had vanished "
"without a trace."
msgstr ""
"⟪k:0⟫Скелет, который сидел там все то время, пока я был в этом доме, теперь исчез без следа."

#: scenario7:scenario7_C1990B51_6F38_4EE4_9AB4_3AA0E740A217
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 9d15b9001a429053f9e34d82c6f9fe6e1245907d62c935336327fab0fae3f347
#. default-sha256: dc9d258c1533730d8cbf9e8ff12b58129da98c6221bfeb3dcdaaccbd7561d7aa
msgctxt "scenario7:scenario7_C1990B51_6F38_4EE4_9AB4_3AA0E740A217"
msgid ""
"⟪k:0⟫I spun around, my gaze darting back and forth across the chamber,⟪k:1⟫but there was no one "
"there—"
msgstr "⟪k:0⟫Я оглянулся по сторонам, осматривая каждый уголок комнаты,⟪k:1⟫но там никого не было—"

#: scenario7:scenario7_3717CEB8_6B08_4EF7_A689_0AE58EACA40A
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 2a95abb48ddf4dd6fbfda866b2cf656d5d5c63c7c2b94346aa11378526a34202
#. default-sha256: ab99423a2354a3d20bb13df00c7b3b6e1e668aef0e42dd6dc1e12ec3fda9430d
msgctxt "scenario7:scenario7_3717CEB8_6B08_4EF7_A689_0AE58EACA40A"
msgid "⟪k:0⟫⟪k:1⟫You gave me the chance to have my revenge."
msgstr "⟪k:0⟫⟪k:1⟫Ты подарил мне шанс свершить мое отмщение."

#: scenario7:scenario7_5C785F31_06F7_4173_9DE7_2858777CFD91
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 583aaa55b9c4a0624e9cf9f3fd4d08eda3eb90e5e07f960be1907d947bad8d1a
#. default-sha256: bec490f720abdf7c701a4835eea068cdd0a18c9cb255e3328e772caf682f27dd
msgctxt "scenario7:scenario7_5C785F31_06F7_4173_9DE7_2858777CFD91"
msgid "⟪k:0⟫Revenge...?"
msgstr "⟪k:0⟫Отмщение...?"

#: scenario7:scenario7_17FE593C_D11B_4B3A_9B4A_FF51BD304787
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 4e253b0c150ab124702939891f563de602c495b88f80aa87dccedb630c2ce282
#. default-sha256: 9eeead260f1948c67141c40c74dcea5f755b1e2dac836173505da93fe5ee6fa8
msgctxt "scenario7:scenario7_17FE593C_D11B_4B3A_9B4A_FF51BD304787"
msgid "⟪k:0⟫Now, I can make those men suffer a hell even worse than the one they put me through..."
msgstr ""
"⟪k:0⟫Теперь я смогу ввергнуть этих мужчин в такой Ад, что будет даже хуже того, через который они "
"заставили пройти меня..."

#: scenario7:scenario7_7C059B14_A129_4954_80FC_3C436FFA9B93
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: ae03d306ed4c863eed0d3b59dfb64426cdb2209e3ee26adb84be69644cb4eb4c
#. default-sha256: 9f23b28b74266e3cdbf569f07d1a6b946a366a2758b10ecbdf50d828bc6ab25c
msgctxt "scenario7:scenario7_7C059B14_A129_4954_80FC_3C436FFA9B93"
msgid "⟪k:0⟫Hah... ⟪k:1⟫haha... ⟪k:2⟫hahaha..."
msgstr "⟪k:0⟫Хах... ⟪k:1⟫хаха... ⟪k:2⟫хаха..."

#: scenario7:scenario7_A4FDA90C_FB78_4D12_9A5B_61011E6CB9DD
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: e703e90bcdaad7db618a58ffa2e31a0fa6df2acf2a675960076e339758049fa5
#. default-sha256: 50455b608f74a0f3f847a742ee6d7582af57a68890b6203e04a2e178794e64d5
msgctxt "scenario7:scenario7_A4FDA90C_FB78_4D12_9A5B_61011E6CB9DD"
msgid "⟪k:0⟫Ahahahahahaha..."
msgstr "⟪k:0⟫Аахахахаха..."

#: scenario7:scenario7_E057D1CB_B59B_439E_AE89_1CA6201F6CE0
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 665039291e206db72453160990a33dccf0e6f34aa939bb20fafc7c9cc6ef8510
#. default-sha256: 5b0354fadd420bf10212252d54b270bdae5f278bd694e5c7d4bb82350e37ded2
msgctxt "scenario7:scenario7_E057D1CB_B59B_439E_AE89_1CA6201F6CE0"
msgid "⟪k:0⟫Oh, you poor dear. They locked you up here without telling you whose house it was?"
msgstr "⟪k:0⟫Ох, бедняжка. Они заперли тебя здесь, не сказав, чей это был дом?"

#: scenario7:scenario7_D110955E_8C94_4B5F_8B3B_023D2D661687
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: ff42971d1794865a6e1a3cf379dfd3b83bf53851e6f80f32d8bb10203500a075
#. default-sha256: 7674fe2ef608735869b1a7ec56419a90b43afd3d323d4599c9254acaa9f2754e
msgctxt "scenario7:scenario7_D110955E_8C94_4B5F_8B3B_023D2D661687"
msgid "⟪k:0⟫You sad, pathetic thing...⟪k:1⟫⟪k:2⟫Though that’s exactly the kind of person I needed."
msgstr "⟪k:0⟫Ты жалкое, печальное создание...⟪k:1⟫⟪k:2⟫Хотя как раз такой человек мне и был нужен."

#: scenario7:scenario7_021FDB46_4407_4465_A38D_7CB739227033
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 34049ba5208e15ee04504c96413a861b52a5f84546a9daa1d7e1e079f33fbcd9
#. default-sha256: aa2ac380e935b1bf068b9959107ff007879c0ad3ed3eddd58b559effb7a25db7
msgctxt "scenario7:scenario7_021FDB46_4407_4465_A38D_7CB739227033"
msgid "⟪k:0⟫You’re... ⟪k:1⟫You’re not the witch, are you...?"
msgstr "⟪k:0⟫Ты... ⟪k:1⟫ты ведь не ведьма, или ведьма...?"

#: scenario7:scenario7_628FA3F9_73B9_45FC_9FBF_59CF1C8441D7
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 332763caaf20d6e5cfaeb590eba96d88467031d0478640bf4d1cc389c0f28c91
#. default-sha256: 558ffa46366f036f578c0bacbe801a6f801a25d53315eb2c8b46f5d6a603d3b3
msgctxt "scenario7:scenario7_628FA3F9_73B9_45FC_9FBF_59CF1C8441D7"
msgid "⟪k:0⟫I assumed... ⟪k:1⟫the witch was nothing but a legend. A tale..."
msgstr "⟪k:0⟫Я полагал... ⟪k:1⟫что ведьма не более, чем легенда. Сказка..."

#: scenario7:scenario7_AD899BFA_FFBD_4B11_9952_AADF7BCE7E87
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 100055a44ba1319d031ae9eafc3759c4bb40975fce8f437701c583268a972b30
