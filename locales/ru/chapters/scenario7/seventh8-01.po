msgid "⟪k:0⟫He deserves at ⟪k:1⟫least⟪k:2⟫ that.⟪k:3⟫⟪k:4⟫He brought you more than enough pain."
msgstr "⟪k:0⟫Хотя бы это он ⟪k:1⟫заслужил⟪k:2⟫.⟪k:3⟫⟪k:4⟫Он принес тебе более чем достаточно боли."

#: scenario7:scenario7_8906939C_E484_4AD9_B410_5DD0F4EABDB9
