msgid "⟪k:0⟫I know your pain."
msgstr "⟪k:0⟫Я знаю твою боль."

#: scenario7:scenario7_A1F30229_A70F_4449_B9EA_47D4032BAEA2
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 6665f38b750035adba248823cd05f19193b13ff2a52e29855533a88346d7ab76
