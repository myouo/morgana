#: scenario7:scenario7_4192695C_CD64_45F6_B7B2_D9385A7FEC77
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: f45b29a449af1b5be011ef797cbc1f0a9cbcb072f5e1b1a7698abdc663b5614f
#. default-sha256: d786b3ddd832d255799afcb64b3d668ef3174fbacef1d1533f30fa77678a6b79
msgctxt "scenario7:scenario7_4192695C_CD64_45F6_B7B2_D9385A7FEC77"
msgid "⟪k:0⟫When you arrived at this house... ⟪k:1⟫I felt the hands of fate at work."
msgstr "⟪k:0⟫Когда ты прибыл в этот дом... ⟪k:1⟫я ощутила, что тебя привела сюда длань проведения."

#: scenario7:scenario7_81463A50_FEBD_4A7A_9C7A_E2EC0C6BCF0C
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 182ec6a54dbff9a69fe3c5131d82811cac92dcbc55e57b187eae56d61b1facb5
