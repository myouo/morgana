msgid "⟪k:0⟫only her voice whispering in my ear."
msgstr "⟪k:0⟫лишь ее голос, шепчущий мне на ухо."

#: scenario7:scenario7_1F16E57D_9149_4683_A6EF_EE377EEF2BDD
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
