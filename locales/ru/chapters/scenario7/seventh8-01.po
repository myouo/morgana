msgid "⟪k:0⟫Who ⟪k:1⟫are⟪k:2⟫ you?"
msgstr "⟪k:0⟫Кто ⟪k:1⟫ты⟪k:2⟫?"

#: scenario7:scenario7_E2088DD3_5F4E_4D55_B5A4_21971D01EB82
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 63c13d2d3431e57bb9e95c3e559e1b19eaedb14211bce3656f6bcfd70a596058
#. default-sha256: 887f615837fa8d83bf46ca9dec9f85c49ac1fb1bf70d6e4cbf103952551939f8
msgctxt "scenario7:scenario7_E2088DD3_5F4E_4D55_B5A4_21971D01EB82"
msgid ""
"⟪k:0⟫That I am.⟪k:1⟫⟪k:2⟫I am the cursed witch, who loathes this puny, wretched world—⟪k:3⟫⟪k:4⟫"
"⟪k:5⟫curses it."
msgstr ""
"⟪k:0⟫Это я.⟪k:1⟫⟪k:2⟫Я проклятая ведьма, которая ненавидит этот маленький, жалкий мир—⟪k:3⟫⟪k:4⟫"
"⟪k:5⟫проклинает его."

#: scenario7:scenario7_B635749A_FC83_4FFC_A662_B0FD9832BB0B
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 6c30af5dbe200a7ef396ad09e875ee2986cb08b1aee14d3bb4ecc8543e7c6ed8
