msgctxt "scenario7:scenario7_E693A7E3_F555_4086_BBE8_BDB52E3857CF"
msgid "⟪k:0⟫It was empty."
msgstr "⟪k:0⟫Внутри было пусто."

#: scenario7:scenario7_D33AF05A_D351_474B_AC22_EB755E2EBFAD
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
