msgctxt "scenario7:scenario7_5591326A_723D_440F_BD0C_467CDB8381D6"
msgid "⟪k:0⟫And for that, I will grant you your wish."
msgstr "⟪k:0⟫И за это я исполню твое желание."

#: scenario7:scenario7_4965D32C_A833_4DA2_A2B2_72ED7724F309
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
