msgctxt "scenario7:scenario7_A1F30229_A70F_4449_B9EA_47D4032BAEA2"
msgid "⟪k:0⟫You were the only one to ever have pity for me..."
msgstr "⟪k:0⟫Ты был единственным, кто когда-либо проявил ко мне жалость..."

#: scenario7:scenario7_9FA6C8F3_2B7D_4816_A931_950BCA707563
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 3e10527b7477edca192d291c2fd677ac04fa1d97c35565157d95827d5502e4a6
