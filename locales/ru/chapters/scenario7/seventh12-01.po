#: scenario7:scenario7_090A51F1_861C_4F72_B0D5_474947B3F7E3
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: d1e533ef61f3befeb7d7401fe5576a96ec48f3d5c342d31ebf3df33170f77cc0
#. default-sha256: fd8c542be940fa74444fa769c6ee1c213ad56cc4ce3c98b3bfc98b49afb7413d
msgctxt "scenario7:scenario7_090A51F1_861C_4F72_B0D5_474947B3F7E3"
msgid ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫⟪k:4⟫⟪k:5⟫⟪k:6⟫⟪k:7⟫⟪k:8⟫⟪k:9⟫⟪k:10⟫⟪k:11⟫⟪k:12⟫⟪k:13⟫⟪k:14⟫⟪k:15⟫⟪k:16⟫⟪k:17⟫"
"⟪k:18⟫⟪k:19⟫⟪k:20⟫⟪k:21⟫⟪k:22⟫...And so, my life came to an end."
msgstr ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫⟪k:4⟫⟪k:5⟫⟪k:6⟫⟪k:7⟫⟪k:8⟫⟪k:9⟫⟪k:10⟫⟪k:11⟫⟪k:12⟫⟪k:13⟫⟪k:14⟫⟪k:15⟫⟪k:16⟫⟪k:17⟫"
"⟪k:18⟫⟪k:19⟫⟪k:20⟫⟪k:21⟫⟪k:22⟫...И вот так моя жизнь подошла к концу."

#: scenario7:scenario7_5D8C55D5_BF96_41AE_A46B_B7820CB71569
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 46cda5e17f7361bb80430b1baec05c49f90600a8d5838c62507480f383b330fc
#. default-sha256: 1569be2549fe0e0d984fe66ac80367f3559070e556526391caad20e7c732d44f
msgctxt "scenario7:scenario7_5D8C55D5_BF96_41AE_A46B_B7820CB71569"
msgid "⟪k:0⟫But that wasn’t the end of the story."
msgstr "⟪k:0⟫Однако это не был конец истории."

#: scenario7:scenario7_C51746E0_7E56_4329_86EF_EDB666693DA2
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: a6ec0c19ed681d11f13fa5acd3e0520d2cb50ea567b3c4965565d88718c8dfdc
#. default-sha256: 3c671ecdc2f72c5138751b70c67c9968edf31af3268c4995843602fa137bef71
msgctxt "scenario7:scenario7_C51746E0_7E56_4329_86EF_EDB666693DA2"
msgid ""
"⟪k:0⟫I don’t know if what comes next could be called “my” story,⟪k:1⟫⟪k:2⟫but memories of these "
"events linger in my soul."
msgstr ""
"⟪k:0⟫Хотя не знаю, можно ли называть то, что случилось потом, “моей” историей,⟪k:1⟫⟪k:2⟫но "
"воспоминания о тех событиях прочно запали мне в душу."

#: scenario7:scenario7_3DE6F1A1_7E45_4823_BB18_DFE93D6A6332
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: cb220c7eff85a6900984e649334ff80566b86f29195bb5ef89e774bf4d6725c4
#. default-sha256: 27b946b97600769b934844e80f8a77e173babec812f9674b0ce975292c25379a
msgctxt "scenario7:scenario7_3DE6F1A1_7E45_4823_BB18_DFE93D6A6332"
msgid ""
"⟪k:0⟫How could I have ever imagined...⟪k:1⟫⟪k:2⟫that I would be made to witness my own misery "
"even in death?"
msgstr ""
"⟪k:0⟫Как мог я представить себе...⟪k:1⟫⟪k:2⟫что буду вынужден лицезреть свои страдания даже после "
"смерти?"

#: scenario7:scenario7_8C20439B_C5B4_4D4A_AFAB_5CCD52C9ED90
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 8cf2f9554135be41dd3a893ac6d63509cfa64fd4a73d30fa1808863d48e7729b
#. default-sha256: e3f82e525af1892e031b041d27c94552fd1d01b5a22af205ef3f609069e475ed
msgctxt "scenario7:scenario7_8C20439B_C5B4_4D4A_AFAB_5CCD52C9ED90"
msgid "⟪k:0⟫And my soul—⟪k:1⟫⟪k:2⟫evidently still bound to my flesh—"
msgstr "⟪k:0⟫И моя душа — ⟪k:1⟫⟪k:2⟫по-видимому, все еще связанная с телом—"

#: scenario7:scenario7_A3D92C5D_C2DD_4CE0_8512_FCF7FE870B04
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 957dc7dadf3b321982c64b97fd6bbf7152b6cc1d972a473048a941c6cf2129d3
#. default-sha256: 8a93356037f9518bbf9359e9dcb01c651ec32d0eab2aa7a88e9c2b661f0c3ad8
msgctxt "scenario7:scenario7_A3D92C5D_C2DD_4CE0_8512_FCF7FE870B04"
msgid "⟪k:0⟫was dragged along with it, against my will, down to the nearby village."
msgstr "⟪k:0⟫против моей воли, последовала за ним в близлежащую деревню."

#: scenario7:scenario7_E61D0C8B_E817_4C49_8BCD_986BDDA99580
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 659c1330dbc11d3eb9f3d88d8a273434979802d1dbf72b500e8716e8fc69af28
#. default-sha256: d065d9ad41bcd71f50ad38ee5d727bca9f3ec045cf5f64ba98c54d3d91f1b782
msgctxt "scenario7:scenario7_E61D0C8B_E817_4C49_8BCD_986BDDA99580"
msgid "⟪k:0⟫⟪k:1⟫The knights have returned from their holy quest!"
msgstr "⟪k:0⟫⟪k:1⟫Рыцари вернулись из своего священного похода!"

#: scenario7:scenario7_4BC5D94C_29C0_4512_8464_CFCAC63C2BC4
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 768b3f8062dcbc55734659ff4a8ffb18b32ae1818c915561632816ff9472f825
#. default-sha256: bc3c2ee985ae39a8cb3c79b7a965b40d0785c5b1b4ef01cde237cbb472cd9437
msgctxt "scenario7:scenario7_4BC5D94C_29C0_4512_8464_CFCAC63C2BC4"
msgid "⟪k:0⟫⟪k:1⟫Oh, how we’ve awaited your arrival!"
msgstr "⟪k:0⟫⟪k:1⟫Ох, как же мы ждали вашего прибытия!"

#: scenario7:scenario7_CB3ED887_927B_45F4_AD8F_4F1D0214AA0F
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 05ae6d853fb2dd9649cf7c9d22e9a5c10592a1e454333808c82607f4bbb8b4ac
#. default-sha256: 81e313daf5862cd1c2cb235b5462af13ac76c79bb639111c0c65fdb6d84f7618
msgctxt "scenario7:scenario7_CB3ED887_927B_45F4_AD8F_4F1D0214AA0F"
msgid "⟪k:0⟫⟪k:1⟫How glorious it is to see you!"
msgstr "⟪k:0⟫⟪k:1⟫Как отрадно видеть вас!"

#: scenario7:scenario7_1E29A1D1_0BEE_452D_97A6_C04B078CD2D4
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 3d0a092b701accb110c8dcef3f885a7a2cba42d0a175ddd65c30816934cde7bf
#. default-sha256: f5e93a5c233c41fe078196b362e2d5374c6c4d06f8cca3ba90dc8cd1c0106865
msgctxt "scenario7:scenario7_1E29A1D1_0BEE_452D_97A6_C04B078CD2D4"
msgid ""
"⟪k:0⟫Waiting for us there was a cluster of villagers.⟪k:1⟫⟪k:2⟫A large cross lay on the ground in "
"the center of the square."
msgstr "⟪k:0⟫Там нас ждала группа селян.⟪k:1⟫⟪k:2⟫На земле в центре площади лежал большой крест."

#: scenario7:scenario7_A1924AEC_E6D6_462F_BDE5_51024E31F01B
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: d488fc1ab6a2b3b47511c9af3b241ca54cd10780f97a5cfd705ebe7f829cc047
#. default-sha256: 96628ff29c243ca43b88fc348ecbf5babb5d40bd2f1976fb56a5f843b7e0276e
msgctxt "scenario7:scenario7_A1924AEC_E6D6_462F_BDE5_51024E31F01B"
msgid ""
"⟪k:0⟫Holding torches, they formed a crowd around the knights, several of them familiar faces."
msgstr "⟪k:0⟫Держа факелы, они столпились вокруг рыцарей, лица некоторых из них были мне знакомы."

#: scenario7:scenario7_F52A9436_A594_40DB_8213_25E1D487198D
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 8d3d9ac6aca7395d81b2855c30542af20e7ee9dff3e21fcc6e3fac04b7bef9d4
#. default-sha256: 6bf821975eb169e72ab22fac7a7116d7b2b5647d0086a31c026d05d6208ca677
msgctxt "scenario7:scenario7_F52A9436_A594_40DB_8213_25E1D487198D"
msgid ""
"⟪k:0⟫No longer shall we live in fear of the curse befalling us!⟪k:1⟫⟪k:2⟫Eternal peace is assured!"
msgstr ""
"⟪k:0⟫Более не будем мы жить в страхе пред проклятьем, что может пасть на головы наши!⟪k:1⟫⟪k:2⟫"
"Наконец наступил вечный мир!"

#: scenario7:scenario7_16B2FCE2_C477_4BD9_8C7D_E88D8A4AF579
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 6f8e0629e855a006d4e6a239306c09ff81a782bde833cecdf34f6911e5029a16
#. default-sha256: fca1416faed18363a396006d776703a47dff3ee40325153be0d7fd0c8e0a725a
msgctxt "scenario7:scenario7_16B2FCE2_C477_4BD9_8C7D_E88D8A4AF579"
msgid "⟪k:0⟫Why, then... ⟪k:1⟫were they acting like I was at fault?"
msgstr "⟪k:0⟫Тогда почему... ⟪k:1⟫вы ведете себя так, будто это моя вина?"

#: scenario7:scenario7_4CEDA84C_E7DE_4F7A_8E6C_4075FF9ED2EC
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: f2aff198e2f9bd584c7a316549f0aebe7ac2cdd5215f15f8f718f7c9fa2d7883
#. default-sha256: ad30f42690872596b8dec5d47bb57f928ce5fd4586fda4e1e9d06b217d3a25ad
msgctxt "scenario7:scenario7_4CEDA84C_E7DE_4F7A_8E6C_4075FF9ED2EC"
msgid "⟪k:0⟫Why was I the sinner, and why did I need to be judged?"
msgstr "⟪k:0⟫Почему я был грешником, и почему меня следовало судить?"

#: scenario7:scenario7_2A266E31_4BB9_464A_9B6B_7551BF55087C
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 1be3e1c1703c949aeb605af06fd11e8ffaf3a5b89d26a122d8bb44adf0e26220
#. default-sha256: dcfc1efe3545026f29a38a7ef68297ecd8e44ed167943067212d160d711af1f0
msgctxt "scenario7:scenario7_2A266E31_4BB9_464A_9B6B_7551BF55087C"
msgid ""
"⟪k:0⟫My soul trembled at the overwhelming fervor consuming the crowd, ⟪k:1⟫their zealous desire "
"to see judgment cast."
msgstr ""
"⟪k:0⟫Моя душа дрогнула от того, с каким отчаянным пылом толпа ⟪k:1⟫рьяно жаждала увидеть "
"приведение приговора в исполнение."

#: scenario7:scenario7_4055B4D2_8A2F_48DF_801C_6AA7C0D5ADC8
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 8eae3c1202cd7ce6fe574c52414d959e0d1d1e4169dcb39ec69ddec0996cc6b3
#. default-sha256: 174deee5b16824ffcc134df76e4201868edd902388f177b7d01cdcf7f945bb8d
msgctxt "scenario7:scenario7_4055B4D2_8A2F_48DF_801C_6AA7C0D5ADC8"
msgid "⟪k:0⟫Please don’t do this, Didier...⟪k:1⟫⟪k:2⟫Please, hear my voice..."
msgstr "⟪k:0⟫Пожалуйста, Дидье, не делай этого...⟪k:1⟫⟪k:2⟫Пожалуйста, услышь мой голос..."

#: scenario7:scenario7_90CACC1B_FB5C_4F6A_A11B_C62ACBF86CA5
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: bb54032682ebd6029d1dbeb4efb3f915a9c779f507d80aee1dc1b36e48614f5e
#. default-sha256: 7235114e06e707a15e9147d2fa976348556293fff81ee1beafbc1545c63a69f5
msgctxt "scenario7:scenario7_90CACC1B_FB5C_4F6A_A11B_C62ACBF86CA5"
msgid "⟪k:0⟫Please, tell me ⟪k:1⟫you⟪k:2⟫, at least, don’t think I did those things..."
msgstr ""
"⟪k:0⟫Пожалуйста, скажи мне, что хотя бы ⟪k:1⟫ты⟪k:2⟫ не думаешь, что я совершил эти деяния..."

#: scenario7:scenario7_1809491C_BCB6_4470_BD73_A9E1B6453A66
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 1abd34ad0726a2628d15d82d5505b9f7531e9f23b85106a97085c624504c7b48
#. default-sha256: 539eeefd4ce290e08113d11a9268042cc308902007f803434a0cc89846cd1ebb
msgctxt "scenario7:scenario7_1809491C_BCB6_4470_BD73_A9E1B6453A66"
msgid "⟪k:0⟫Don’t put me on that cross...⟪k:1⟫⟪k:2⟫If it was Mother who sold me out to the Church,"
msgstr "⟪k:0⟫Не вешай меня на крест...⟪k:1⟫⟪k:2⟫Если это мать выдала меня Церкви,"

#: scenario7:scenario7_748FDB2D_891F_4063_B06B_CA7A27FC96BC
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 522a80505e7039e4e6c3b3d143df7de5663f208faa87a3bb87d2975082f89d2a
#. default-sha256: a5e6751f0a08c6cfbb86b12b1daeae86e53ac9a35af10630a84c2dc83b756143
msgctxt "scenario7:scenario7_748FDB2D_891F_4063_B06B_CA7A27FC96BC"
msgid ""
"⟪k:0⟫The nails and rope for the crucifixion are here.⟪k:1⟫⟪k:2⟫We would have you, O knight, "
"deliver the Lord’s judgment unto this vile witch!"
msgstr ""
"⟪k:0⟫Веревка и гвозди для распятия находятся здесь.⟪k:1⟫⟪k:2⟫И у нас есть вы, о, рыцари, вершащие "
"суд Божий над этой поганой ведьмой!"

#: scenario7:scenario7_FE7C6CF8_459E_46AF_AA1C_47F64264FA6A
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: a55325bb6cf380cbc47c6c6acd9cf5e5528673bef441dcbacb9311b9c01aea46
#. default-sha256: 8b22601999a8848a7dc8b6a995993583589ad674d10485d20d4dcbfb55d6b070
msgctxt "scenario7:scenario7_FE7C6CF8_459E_46AF_AA1C_47F64264FA6A"
msgid "⟪k:0⟫Didier..."
msgstr "⟪k:0⟫Дидье..."

#: scenario7:scenario7_83319B1E_A3C6_4451_9E94_294CD95D46DE
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: eb6acc0b5abd60cddc844567060df42bc72f3122f6f1dea03fa7c65ceaf5c9e1
#. default-sha256: 7ace45cd07962958620782b7e5a27efe7c7e064ef8634b93ef7f8b30160e3d46
msgctxt "scenario7:scenario7_83319B1E_A3C6_4451_9E94_294CD95D46DE"
msgid "⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫Crucifixion!"
msgstr "⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫Распятие!"

#: scenario7:scenario7_4307D535_FE8B_4BE6_BCDC_93F1F1C3CF34
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: e032f52a91f33c1f5cd7cb91f42a010a4bc865ce78593a7d6aabbbf6843d8efa
#. default-sha256: 35513a2607dc292b69513bc03d98c6866b741c4e9ed8b4a708fbe4d2e9a4290f
msgctxt "scenario7:scenario7_4307D535_FE8B_4BE6_BCDC_93F1F1C3CF34"
msgid "⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫Crucify it!"
msgstr "⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫Распять его!"

#: scenario7:scenario7_BE5EED1B_42A0_45A3_A6C7_15DD67C76C1B
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 4d8694298e0d7e69a392097b1e6de3a1b31a1e47d99fcec14c15c7b8c97ef7f2
#. default-sha256: 38fb7fecdbec91fe44b74216d8ae8a4ce934c175771fcd4561fee45aaa822965
msgctxt "scenario7:scenario7_BE5EED1B_42A0_45A3_A6C7_15DD67C76C1B"
msgid ""
"⟪k:0⟫My brother lowered my corpse to the ground and began removing my clothing, ⟪k:1⟫and in that "
"very moment, I realized the purpose of hanging someone from a cross."
msgstr ""
"⟪k:0⟫Брат положил мое тело на землю и начал снимать с меня одежду, ⟪k:1⟫и в тот самый момент я "
"осознал, что за цель преследовало распятие кого-то на кресте."

#: scenario7:scenario7_B88FDF38_E3ED_4B5C_B13B_53B336DCF166
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 6115707a72af1b34cc0d5106e03b74157cfe32b9af2c9186d7fa41d037714a23
#. default-sha256: e5115cd8b98e3b2658c1a4be8668972838754c2cb9578ef22b724298293ce11f
msgctxt "scenario7:scenario7_B88FDF38_E3ED_4B5C_B13B_53B336DCF166"
msgid "⟪k:0⟫Overwhelmed by hopelessness, tears streamed down my face."
msgstr ""
"⟪k:0⟫Меня переполняло чувство беспомощности, слезы стремительным потоком текли у меня из глаз."

#: scenario7:scenario7_F330EC48_B442_43BB_867C_F9A5674ECE91
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 3a74b7655109774e9bb39fc1b96d925b0f1e6a92ef236c0632b8559583bbfc3b
#. default-sha256: 0d933b0e5e5c9feb61806170d2574b5d19719cfc8e627c1e25d47960ab8c9a41
msgctxt "scenario7:scenario7_F330EC48_B442_43BB_867C_F9A5674ECE91"
msgid "⟪k:0⟫don’t do it!"
msgstr "⟪k:0⟫не делай этого!"

#: scenario7:scenario7_BFF95DC4_C5B9_4167_A118_3B8955B2FC84
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 39390d8a7ec1b555849740ddca42de67b95c7ce617acb5d2d78b0f17c0dbd128
#. default-sha256: 8db7f027c3df312340f7bc82d92e1cbfb2f07cadc41f899a8961afb74f2bfc6a
msgctxt "scenario7:scenario7_BFF95DC4_C5B9_4167_A118_3B8955B2FC84"
msgid ""
"⟪k:0⟫For a brief moment, an unpleasant silence spread through the crowd. ⟪k:1⟫The erratic "
"crackling of their torches was the only sound that could be heard in the square."
msgstr ""
