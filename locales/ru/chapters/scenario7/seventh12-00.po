#: scenario7:scenario7_19C8A4BC_99C1_487D_8145_8D0EA7C19F58
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 0405351ec76ac208ab89a82f4b2d084ec67c4cc73a697d8cf289b0d7b030c627
#. default-sha256: c180e2a78a73b873db1621239c8ba07f8b5b68bf746b1b1eacf9f31ced2860ee
msgctxt "scenario7:scenario7_19C8A4BC_99C1_487D_8145_8D0EA7C19F58"
msgid ""
"⟪k:0⟫After being pierced by Didier’s blade,⟪k:1⟫⟪k:2⟫I found myself looking down upon my own "
"corpse."
msgstr ""
"⟪k:0⟫После того, как клинок Дидье пронзил меня,⟪k:1⟫⟪k:2⟫я обнаружил, что смотрел сверху вниз на "
"свой собственный труп."

#: scenario7:scenario7_80A15A9D_1B5F_42D0_A41D_B1D1F2177CA8
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: d84192775b3726bd69c8e6eb9c4e32909e428436148a80ac161fb7ede4168e56
#. default-sha256: 36bc3199d746cc57bb3b3ae8644b8af9cb8db9278712531cbcf6e287b2490a5a
msgctxt "scenario7:scenario7_80A15A9D_1B5F_42D0_A41D_B1D1F2177CA8"
msgid "⟪k:0⟫I watched as my eldest brother dragged me to the place of my crucifixion."
msgstr "⟪k:0⟫Я смотрел, как мой старший брат поволок меня к месту моего распятия."

#: scenario7:scenario7_6BA73D07_65B7_4AFD_884C_81E2F012DF25
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: cd51ca84f9b9efcf6e4430dc60ca94b9928e0d87f7dcfae3a1365044b1f44595
#. default-sha256: 3e7a78ab8510cec102436e29f3a59880ac231005922a6b6eeb7ee427e17d8bd1
msgctxt "scenario7:scenario7_6BA73D07_65B7_4AFD_884C_81E2F012DF25"
msgid "⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫⟪k:4⟫The knights!"
msgstr "⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫⟪k:4⟫Рыцари!"

#: scenario7:scenario7_8B7324EA_75E9_434E_B1E0_E73B255130B5
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 700cd2ace52da44c303068e6d8b73ed122ab70bafac2c02c50e2131678fd512f
#. default-sha256: 5faa75c01e6246ed7ed904e226e24ff11d4e851077ef5ad1557215ee8ab237bc
msgctxt "scenario7:scenario7_8B7324EA_75E9_434E_B1E0_E73B255130B5"
msgid ""
"⟪k:0⟫The men who had come to ransack the mansion were standing there, staring at my body in awe."
msgstr ""
"⟪k:0⟫Мужчины, которые ранее пришли разграбить особняк, стояли там, с благоговейным ужасом глядя "
"на мое тело."

#: scenario7:scenario7_ED90C3D4_9453_4321_A580_7F1D34EEEF7D
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 24329b717eb640d3ad61d15740fe7c48751f363e62ad49618243273215a0f3b5
#. default-sha256: 674463d79f0ee708fcaae2b315eec9fb9282b7072685648cc13c4e4656421391
msgctxt "scenario7:scenario7_ED90C3D4_9453_4321_A580_7F1D34EEEF7D"
msgid ""
"⟪k:0⟫Ahh, the Lord’s judgment has been delivered unto the witch of the cursed mansion by His holy "
"servants."
msgstr "⟪k:0⟫Ахх, суд Божий был свершен над ведьмою из проклятого особняка Его священными воинами."

#: scenario7:scenario7_9A1A1486_1AC2_4F6B_93BF_65F63A063C83
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 2322a37ef34622949625a13acdf8efb3d04978821991d921a299694e7a399752
#. default-sha256: 05f73b9612048126e83bc224b67c95e70ad87c8f207a3d470b711d811f6253ab
msgctxt "scenario7:scenario7_9A1A1486_1AC2_4F6B_93BF_65F63A063C83"
msgid ""
"⟪k:0⟫We have assembled all the tools you need to execute your divine mission. ⟪k:1⟫A cross, "
"befitting of such a heinous sinner!"
msgstr ""
"⟪k:0⟫Мы приготовили все необходимое, дабы вы смогли выполнить ваш священный долг. ⟪k:1⟫Крест, что "
"вполне сгодится для такого гнусного грешника!"

#: scenario7:scenario7_71CEAC7F_E583_49D1_AD46_B531CE5EA92D
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: fe2f439d561296d604dce49a0a8d003b147a292c2cadc887d0788ef7ec03cb45
#. default-sha256: 999e63c05f0e980aafb5614f6097f14982c19e99490c0bd00cf8c1c0b07a2be2
msgctxt "scenario7:scenario7_71CEAC7F_E583_49D1_AD46_B531CE5EA92D"
msgid "⟪k:0⟫That witch threatened to curse us!⟪k:1⟫⟪k:2⟫Sullied our pure ears with its blasphemy!"
msgstr ""
"⟪k:0⟫Эта ведьма угрожала проклясть нас!⟪k:1⟫⟪k:2⟫Оскорбляя наш слух своими грязными "
"богохульствами!"

#: scenario7:scenario7_C92DCB1B_C140_4C09_A9F4_4E152AD3CBD0
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: ed6083155307868ed5ac00535423544900f53470ce166623a412b56f8469c011
#. default-sha256: c657a092875778209a551e61c11b41d75752edf113df315cd79acb2a868cfd6e
msgctxt "scenario7:scenario7_C92DCB1B_C140_4C09_A9F4_4E152AD3CBD0"
msgid ""
"⟪k:0⟫I had done no such thing...⟪k:1⟫⟪k:2⟫I hadn’t cursed anyone.⟪k:3⟫⟪k:4⟫I had merely been "
"defending myself..."
msgstr ""
"⟪k:0⟫Я ничего подобного не делал...⟪k:1⟫⟪k:2⟫Я никого не проклинал.⟪k:3⟫⟪k:4⟫Я просто защищался..."

#: scenario7:scenario7_01CDD73C_7009_4BF2_A713_A9D75E21BF1C
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: d53c045b6a4b71304f0dc223943c82f9b67040280fbb76e5a5df31300311ddf7
#. default-sha256: aebc76f4ac5d4b30cf335b397441206700b1ade4ab7127f439ffe78ca08e6043
msgctxt "scenario7:scenario7_01CDD73C_7009_4BF2_A713_A9D75E21BF1C"
msgid ""
"⟪k:0⟫They had been armed and outnumbered me...⟪k:1⟫⟪k:2⟫so I had said what was necessary to chase "
"them off."
msgstr ""
"⟪k:0⟫Они были вооружены и превосходили меня числом...⟪k:1⟫⟪k:2⟫поэтому я сказал то, что было "
"необходимо, чтобы прогнать их."

#: scenario7:scenario7_9F09D42E_C560_4E6C_85CC_E1446F093B6E
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 1e59c14c484b8f0f11f8b87235f3a314343dbd580dbfd2f787342ed50dd8f4e7
#. default-sha256: 81d0580a380bb3051a74b6805bf42d279249b8478022fd3acac5dfd03b0598d8
msgctxt "scenario7:scenario7_9F09D42E_C560_4E6C_85CC_E1446F093B6E"
msgid ""
"⟪k:0⟫Our poor harvest and our suffering at the hands of the greedy lord were all the work of the "
"witch!"
msgstr "⟪k:0⟫Наш скудный урожай и наши страдания от рук жадного лорда были работой ведьмы!"

#: scenario7:scenario7_95CFA38E_6A0D_45D8_AC57_B18FBA96D197
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 0720e943c27737b13fd8eb7eef894c53f30994552d7e2451754b6cc1f5b75261
#. default-sha256: 7d59fd83f284390f76af59097ba4ad9f80e610655c73e7c1d6bd99063af62a15
msgctxt "scenario7:scenario7_95CFA38E_6A0D_45D8_AC57_B18FBA96D197"
msgid "⟪k:0⟫So I prayed. ⟪k:1⟫I asked God to grant me the smallest of miracles."
msgstr "⟪k:0⟫Поэтому я молился. ⟪k:1⟫Я попросил Господа послать мне одно крохотное чудо."

#: scenario7:scenario7_033A2315_AC2C_41C2_8315_A7996EA3E827
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 730092202dda437a9cbdc09257c77d74f8d4ac80af0b49a700f30cbdd6d493fc
#. default-sha256: 46d8584c186584fe4875b7704358ce035e281844367242ac97bde9a1b067549d
msgctxt "scenario7:scenario7_033A2315_AC2C_41C2_8315_A7996EA3E827"
msgid "⟪k:0⟫To let my voice reach my brother, who carried my body."
msgstr "⟪k:0⟫Позволить брату, что нес мое бездыханное тело, услышать мой голос."

#: scenario7:scenario7_3862AE0C_464A_4525_8ECB_6E3291ABEB35
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: c91b746eaec9ace334f78ff16c57d24b6314d3320ebf0103a03e93c0e98520bb
#. default-sha256: 02196d4c07c4e233cf40ca20bc8ebccff64956c039e33ca828bb42bf617aaf45
msgctxt "scenario7:scenario7_3862AE0C_464A_4525_8ECB_6E3291ABEB35"
msgid "⟪k:0⟫You know me better than that...⟪k:1⟫⟪k:2⟫You know I’ve done nothing wrong..."
msgstr ""
"⟪k:0⟫Ты же знаешь меня лучше, чем кто-либо...⟪k:1⟫⟪k:2⟫Ты знаешь, что я не сделал ничего "
"дурного..."

#: scenario7:scenario7_D009FECC_2960_47A6_8DA6_F92E9871462F
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 7a92c611512f2e47a0241324cb71ef69dfe71ac6df48bbb285d2e3ea05553de4
#. default-sha256: efd4802dc7bb33dc3c4708fc58af920233c27b6ce670be18f1db553d02e43a62
msgctxt "scenario7:scenario7_D009FECC_2960_47A6_8DA6_F92E9871462F"
msgid ""
"⟪k:0⟫Those men smirking at the sight of my body...⟪k:1⟫⟪k:2⟫they’re the ones putting the blame "
"for their sins on me..."
msgstr ""
"⟪k:0⟫Эти люди ухмыляются при виде моего тела...⟪k:1⟫⟪k:2⟫это их надлежит обвинить в грехах, а не "
"меня..."

#: scenario7:scenario7_00B923A4_C9C9_4378_986A_F8838E238D0B
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 74e0b6142eac4db8e2aed671a4e2cc73bfe4debf5d1a1764fd7ab5bfd85d00cd
#. default-sha256: 87f00b369e9ab3f96b0d634b39504456a23f1fe6a1e21549978d3c9e6dc456be
msgctxt "scenario7:scenario7_00B923A4_C9C9_4378_986A_F8838E238D0B"
msgid "⟪k:0⟫then surely ⟪k:1⟫you⟪k:2⟫ can give me a respectable burial..."
msgstr "⟪k:0⟫тогда ⟪k:1⟫ты⟪k:2⟫ наверняка можешь похоронить меня, как подобает..."

#: scenario7:scenario7_B29EA92E_1B87_454B_8F71_08A903F801C9
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: eb43237bf6a6024ee8c8ecb1adc81f4184af1187ef0b79db00a3ad6fc2018aa9
#. default-sha256: 48f41697b22461c825c2f67ac00db3078091b23a05c42741f58ec0ffc02c435d
msgctxt "scenario7:scenario7_B29EA92E_1B87_454B_8F71_08A903F801C9"
msgid "⟪k:0⟫............"
msgstr "⟪k:0⟫............"

#: scenario7:scenario7_811B82B8_CEB2_4DEE_AEBD_1FA47DD3DB02
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 4608e934079b9696216ee2f591ec5484683e9c58828ec7ffb0e25da1b95ef7b9
#. default-sha256: 709182f2afc6da489e77e59b904bcc030225fe2fed01b482c622cae9918771a1
msgctxt "scenario7:scenario7_811B82B8_CEB2_4DEE_AEBD_1FA47DD3DB02"
msgid "⟪k:0⟫Why do you say nothing?"
msgstr "⟪k:0⟫Почему ты ничего не говоришь?"

#: scenario7:scenario7_EA47D360_0BC7_473A_B649_CFC04349B927
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: bbc3e33670239e58184f55bca4b9da6798f00408467326252bd34db5befdaeb5
#. default-sha256: 4a3daaefef7e0d08f926f83c545c2e3dd3e1f15125af283f85580b946e890658
msgctxt "scenario7:scenario7_EA47D360_0BC7_473A_B649_CFC04349B927"
msgid "⟪k:0⟫Why do you accept the tools this man presents you—"
msgstr "⟪k:0⟫Почему ты принимаешь предметы, что передает тебе этот человек—"

#: scenario7:scenario7_E6DB3BE6_2FD3_48F8_9DB3_67C9E599D0B8
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: b3eb0a59a60b8e7ee361561c12f3907a0023729b3120b0435e216dbb0346e602
#. default-sha256: 4dc8b774164859a48f059b1ff0a04d6eae840eadaf4a25b9695d1798ce5f52b8
msgctxt "scenario7:scenario7_E6DB3BE6_2FD3_48F8_9DB3_67C9E599D0B8"
msgid "⟪k:0⟫tools meant to punish me?"
msgstr "⟪k:0⟫орудия моей кары?"

#: scenario7:scenario7_5B464F04_9A92_4579_8C51_EC91CD240255
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: aca225d047c58facfaba27fcae767cf251a75460492d477502a6e2b32b10d24b
#. default-sha256: 26e281de0745a77f4c2cbffa3c32ba6a23e142eb1b26fe0cc7a9ead6261dfc9b
msgctxt "scenario7:scenario7_5B464F04_9A92_4579_8C51_EC91CD240255"
msgid "⟪k:0⟫Tell me, Didier..."
msgstr "⟪k:0⟫Скажи мне, Дидье..."

#: scenario7:scenario7_12D6FB59_6A51_4848_942F_F4928D9277D5
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: ebe8e4b0333fb794f73f3fc72271edbde634f2411f8d8647457b15ac1be79333
#. default-sha256: d7b4cae141b874b5e5477cced6b569699cafb3d3cb24374b93492e032e19e077
msgctxt "scenario7:scenario7_12D6FB59_6A51_4848_942F_F4928D9277D5"
msgid "⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫Crucify the witch!"
msgstr "⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫Распять ведьму!"

#: scenario7:scenario7_06E89998_6C35_4344_BE0B_EE8EF13FA4D4
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 0fa2da57f24b7bf80770c74c3be0a0977eb0869cb237ec24e19db353c050eb4d
#. default-sha256: fa6053a885cd6c12c0e984d9bffffd25c6089de6193ed4f9d7eed191bf851151
msgctxt "scenario7:scenario7_06E89998_6C35_4344_BE0B_EE8EF13FA4D4"
msgid ""
"⟪k:0⟫Please, anything but that... ⟪k:1⟫I’m begging you...⟪k:2⟫⟪k:3⟫don’t expose me to these "
"people..."
msgstr ""
"⟪k:0⟫Пожалуйста, все что угодно, но только не это... ⟪k:1⟫умоляю тебя...⟪k:2⟫⟪k:3⟫Не выставляй "
"меня напоказ перед этими людьми..."

#: scenario7:scenario7_1281D409_8BEB_4CAE_888D_48DFD6D3CBC6
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: f88161b286d3f371217cafce20ddb07eb8d6d8e17f78f2c4a3db252100845a04
#. default-sha256: e6aebc1920bd9d2c74364aeb3711a9f99c5a43fba1bd7453fe408453281d7362
msgctxt "scenario7:scenario7_1281D409_8BEB_4CAE_888D_48DFD6D3CBC6"
msgid "⟪k:0⟫Don’t expose my body, Didier!"
msgstr "⟪k:0⟫Не обнажай мое тело, Дидье!"

#: scenario7:scenario7_CF06DD32_7A5D_48DC_AA4A_7BDD93E968AC
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: bf7e8f3891c9c4cb7b1f60b884a97618f5cb018749a5366cc14a08fb3255559f
#. default-sha256: 9d52d09ab8edc2d6a369cde8c78871ec87ecb343c849c6b17d1e1b5f68106857
msgctxt "scenario7:scenario7_CF06DD32_7A5D_48DC_AA4A_7BDD93E968AC"
msgid "⟪k:0⟫I’m begging you—"
msgstr "⟪k:0⟫Я умоляю тебя—"

#: scenario7:scenario7_D05EA808_47E5_4593_A6B0_973EFD32CE3F
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 46001cee6b0e344a9a7fb56554b3e803a0f805827dfd2bbdae8df70d4e063fb3
#. default-sha256: 60a57c262944895db5c487476efe653a8e0c62c438278ef32781d981be0e8ce5
msgctxt "scenario7:scenario7_D05EA808_47E5_4593_A6B0_973EFD32CE3F"
msgid ""
"⟪k:0⟫But of course, my voice had no way of reaching him,⟪k:1⟫⟪k:2⟫and he proceeded to remove my "
"clothing, piece by piece,"
msgstr ""
"⟪k:0⟫Но, конечно же, мой голос не мог быть им услышан,⟪k:1⟫⟪k:2⟫и он начал снимать с меня одежды, "
"одну за другой,"

#: scenario7:scenario7_1DCF0803_C04F_40B6_958E_B00ADB3E0CED
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: f3ac778e42f9ffc4f346fdd234bbf48b2ef362bc2f1b8e81b5b80bb5ce489b0f
#. default-sha256: bbbdd9201c672dda2c417594969344c96a070e3fb3efe201054bfca3a9d2e346
msgctxt "scenario7:scenario7_1DCF0803_C04F_40B6_958E_B00ADB3E0CED"
msgid "⟪k:0⟫until I was left fully nude."
msgstr "⟪k:0⟫пока я не остался совершенно нагим."

#: scenario7:scenario7_8239D993_E4CC_494D_AE65_0BC3127CD6EC
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 2e0e56668b404e4dad1eef0f808da2215e9e5f0b34a280f546d61aa5f0b0de60
#. default-sha256: 11438aa5d190f7961223595fdb6b7a4fd3643b883cbc6275c1b0911ebc145ea3
msgctxt "scenario7:scenario7_8239D993_E4CC_494D_AE65_0BC3127CD6EC"
msgid "⟪k:0⟫And then, with a mocking laugh, one man spoke,"
msgstr "⟪k:0⟫А затем, с издевательским смехом, один человек сказал,"

#: scenario7:scenario7_90C9BCAA_38F4_4491_BFFE_F74F8614A885
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: ec6b74aa1ea6bc1d24698da893b0f6f3db12d3b68452ba873b062e766387fbc4
#. default-sha256: 4433e8370d1a763b4cfa50b51f28308f5ea4547e38b3bdf8cbbd2f3e76d460ae
