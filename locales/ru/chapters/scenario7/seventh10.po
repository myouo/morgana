msgctxt "scenario7:scenario7_54937B5C_3963_425D_BCAC_D5A7E1C53EFE"
msgid "⟪k:0⟫She treated me the same as before.⟪k:1⟫⟪k:2⟫She never stopped smiling."
msgstr ""
"⟪k:0⟫Она относилась ко мне так же, как и прежде.⟪k:1⟫⟪k:2⟫Она никогда не переставала улыбаться."

#: scenario7:scenario7_79A92454_E1EF_4CA8_A746_7066EACBE329
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 803425d83601bfe76acbbc424e5e99fc66733258f0e555fa868a8296798c9368
