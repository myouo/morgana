msgid "⟪k:0⟫I had come to accept that—⟪k:1⟫or so I’d thought."
msgstr "⟪k:0⟫Я должен был принять это — ⟪k:1⟫или, по крайне мере, я так думал."

#: scenario7:scenario7_C82A27E0_D8BD_4232_9550_E317F7852BDE
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 295b2d507908c22993cce13b0152c9bd6d5e03547841dc6ad788f87f253134e9
