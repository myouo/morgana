msgid "⟪k:0⟫“You will never be with anyone.”"
msgstr "⟪k:0⟫“Ты никогда не сможешь быть с кем-то.”"

#: scenario7:scenario7_3C97A903_F410_4790_BA1D_B9A1FB892D63
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 991ec83f86293c03ccef2f3cc20dbb638adaf7ed2fcb99b6a2e4606a2767adc2
