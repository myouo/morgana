msgctxt "scenario7:scenario7_AD1B4A28_CEB0_442E_8EF3_BFF5A855B1B6"
msgid "⟪k:0⟫And then there was me, the youngest—⟪k:1⟫⟪k:2⟫the only daughter."
msgstr "⟪k:0⟫И затем был я, младшая — ⟪k:1⟫⟪k:2⟫и единственная дочь."

#: scenario7:scenario7_6C9D1053_1A98_4762_893E_69AFE856DEBF
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: e923996a57cdeb4c4990038616f6952a3291e40256c52dc359980b85381fd420
