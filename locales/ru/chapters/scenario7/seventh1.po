#: scenario7:scenario7_92B0D07C_2019_4902_A2AC_B4BB784EAAB2
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 3559a8c9ee76916471a260a1bead0cc67f7315d770d27d5c1fbd4e3aca7709e6
#. default-sha256: b8392b503ca1e050180516bda318f7980d67c3a47dc1b501630a3d488480cb16
msgctxt "scenario7:scenario7_92B0D07C_2019_4902_A2AC_B4BB784EAAB2"
msgid "⟪k:0⟫⟪k:1⟫Chess is in many ways similar to real war tactics."
msgstr "⟪k:0⟫⟪k:1⟫Шахматы во многом схожи с реальной военной тактикой."

#: scenario7:scenario7_BFADEB03_D38A_45C1_9006_15F7E3D42DF7
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: d9a1668d11afad87a001b8d3fd300b8d6058877ece4b135644513f527427384f
