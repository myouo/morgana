msgid "⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫⟪k:4⟫⟪k:5⟫⟪k:6⟫⟪k:7⟫⟪k:8⟫⟪k:9⟫⟪k:10⟫Haaaaaaaahh... ⟪k:11⟫Kill me now!"
msgstr "⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫⟪k:4⟫⟪k:5⟫⟪k:6⟫⟪k:7⟫⟪k:8⟫⟪k:9⟫⟪k:10⟫Хааааааххх... ⟪k:11⟫Убей меня!"

#: scenario7:scenario7_CD50AFD7_87D0_48C7_8639_D6EB9500FCA8
