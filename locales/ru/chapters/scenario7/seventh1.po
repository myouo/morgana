msgid "⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫⟪k:4⟫⟪k:5⟫Come on! Put your back into it!"
msgstr "⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫⟪k:4⟫⟪k:5⟫Ну же! Вложи в удар всю силу!"

#: scenario7:scenario7_36EE3520_274C_40E3_AACF_BBDDB32D87FF
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 07f4799581f8469ef586afc7dab88e1c921040ec1c8d0ece926303afd1566d12
