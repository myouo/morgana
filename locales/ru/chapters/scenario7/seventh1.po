msgctxt "scenario7:scenario7_B9118A00_7227_437E_8F29_49E2F4594EDD"
msgid "⟪k:0⟫⟪k:1⟫It was not inspiration. ⟪k:2⟫It was derivation."
msgstr "⟪k:0⟫⟪k:1⟫Дело не во вдохновении. ⟪k:2⟫Это было логичное решение."

#: scenario7:scenario7_3C5A1CB6_686D_417B_994F_EB5518EC831F
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
