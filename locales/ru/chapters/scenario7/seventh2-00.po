msgid "⟪k:0⟫⟪k:1⟫Allow me to introduce you to a few of my friends."
msgstr "⟪k:0⟫⟪k:1⟫Позволь мне представить нескольких моих друзей."

#: scenario7:scenario7_954BEF59_2273_4536_8F23_E33530701344
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: de3170849f541b0adb363a8d6e686c46d39f432ea173841b6e9a056fcc92342f
