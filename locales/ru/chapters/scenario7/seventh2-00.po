msgid "⟪k:0⟫I felt moderately ill."
msgstr "⟪k:0⟫От всего этого мне стало не по себе."

#: scenario7:scenario7_D1B90557_ED48_4919_8403_C0F432F5C17F
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 0b28783c95c36f5588568b8654eb328d101cdccfc646acce55be8e796386666a
