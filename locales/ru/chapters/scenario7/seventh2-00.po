msgctxt "scenario7:scenario7_67F2CD7F_C951_4A30_8910_248C96E23924"
msgid "⟪k:0⟫I didn’t ⟪k:1⟫want⟪k:2⟫ a body shaped like Aimee’s or my mother’s."
msgstr "⟪k:0⟫Я не ⟪k:1⟫хотел⟪k:2⟫, чтобы это тело имело формы, как у Эми или матери."

#: scenario7:scenario7_481D4D50_4CAB_4A3F_8ED5_405217E1C554
