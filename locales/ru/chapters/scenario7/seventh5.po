msgctxt "scenario7:scenario7_FE2852C9_6404_492F_9DAD_A7BD9AD46F5B"
msgid "⟪k:0⟫Heavy rain pounded against the windows like thousands of little spears."
msgstr "⟪k:0⟫Ливень бился в окна, подобно тысячам маленьких копий."

#: scenario7:scenario7_82D364DC_A28D_4574_B89E_DA4218B2F4B7
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
