#: scenario7:scenario7_BACD08A1_9263_4A2D_8B26_1FF261B8F58D
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 3147c32bc63c90bfcc5a37a72ef9beba2ba0a93b6284042e9babb77b2dc125da
#. default-sha256: 02456d437606032a56bf89aac9e5b03313d208a6fed778bcb14dac4ee52cbb9d
msgctxt "scenario7:scenario7_BACD08A1_9263_4A2D_8B26_1FF261B8F58D"
msgid ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫⟪k:4⟫⟪k:5⟫⟪k:6⟫⟪k:7⟫Michelle! Ohh Mich⟪k:8⟫eeee⟪k:9⟫eeeelle! Are you in there?"
msgstr "⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫⟪k:4⟫⟪k:5⟫⟪k:6⟫⟪k:7⟫Мишелль! Охх, Миш⟪k:8⟫ееее⟪k:9⟫еееелль! Ты там?"

#: scenario7:scenario7_FB32878E_3B65_40D1_962A_0B9F5ADBCA69
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 9eba344815aef72c6618e7cf60daa02a3cb38281bbe377fab361461daf2b83e8
#. default-sha256: 179bc46da3b1ad930b2a0cf0237e40ee6e208aa5526b4405983a2db27e609788
msgctxt "scenario7:scenario7_FB32878E_3B65_40D1_962A_0B9F5ADBCA69"
msgid "⟪k:0⟫⟪k:1⟫⟪k:2⟫Did you need something, Georges?"
msgstr "⟪k:0⟫⟪k:1⟫⟪k:2⟫Тебе что-то нужно, Жорж?"

#: scenario7:scenario7_A55F8FEF_1AB7_4FE2_986A_3FBBE54321B0
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: ddef1e03283ca085836d5b9765faa6fdee6f4d3104bed843140f0f5c02833fac
#. default-sha256: b9f89eaf94d3cc715f3bfbfd3dc3d8ee77055eeb13f6c3ea9687731743130feb
msgctxt "scenario7:scenario7_A55F8FEF_1AB7_4FE2_986A_3FBBE54321B0"
msgid ""
"⟪k:0⟫⟪k:1⟫Oh, c’mon, don’t be like that.⟪k:2⟫⟪k:3⟫Do I have to “need something” to talk to you?"
msgstr ""
"⟪k:0⟫⟪k:1⟫О, перестань, не будь такой.⟪k:2⟫⟪k:3⟫Мне непременно должно быть “что-то нужно”, чтобы "
"поговорить с тобой?"

#: scenario7:scenario7_3ED6DA89_DABD_4E8E_A636_8C03D240695F
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 325bae98c578e01105a8c990e6ac0e51ed4ee8d0a9dbca82b2934fe67225dd5d
#. default-sha256: 06c9ca37c7b2c27f50bab548c9a5a2b5595a9da7be7a2ecaa4c16e6253d04dac
msgctxt "scenario7:scenario7_3ED6DA89_DABD_4E8E_A636_8C03D240695F"
msgid ""
"⟪k:0⟫⟪k:1⟫N-⟪k:2⟫No, but you looked like you were in an unusually good mood,⟪k:3⟫so I thought..."
msgstr ""
"⟪k:0⟫⟪k:1⟫Н-⟪k:2⟫Нет, но ты, кажется, в необычайно приподнятом настроении,⟪k:3⟫поэтому я "
"подумала..."

#: scenario7:scenario7_CF12D587_2FF9_4EE4_991C_31AAEB65C73E
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 56f01e42344821766dfa5e02a1a1d50bda707061c47b16c13550f85400a7686f
#. default-sha256: be99133593081ad131dcf826c95ff65b554aa85521db61f104c6552f07e44393
msgctxt "scenario7:scenario7_CF12D587_2FF9_4EE4_991C_31AAEB65C73E"
msgid "⟪k:0⟫⟪k:1⟫Well, why wouldn’t I be?⟪k:2⟫⟪k:3⟫It’s a wonderfully gloomy day out!"
msgstr "⟪k:0⟫⟪k:1⟫Ну, а почему бы мне не быть таким?⟪k:2⟫⟪k:3⟫Сегодня чудесный хмурый денек!"

#: scenario7:scenario7_B074DBC1_FA01_4CC8_954A_6C085E79F2EC
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 4785cd71f46f2a4ec42499bd735a5bc68c796d3f55d9a742e59062312594e542
#. default-sha256: b10d82a68a4d62c3150b0936b91ec0a6453ec8e4e51fd231ecb20cc3c4dfeb9e
msgctxt "scenario7:scenario7_B074DBC1_FA01_4CC8_954A_6C085E79F2EC"
msgid "⟪k:0⟫⟪k:1⟫............"
msgstr "⟪k:0⟫⟪k:1⟫............"

#: scenario7:scenario7_2F81EBB3_F8A2_41F0_93EE_05BA4326A48B
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 07909a05f25974edd4505012499a0c20c90885f8e5c9009e840e97b95cc0b772
#. default-sha256: 86ac12c5a3ab0ab513a8729d7e612575931f413af895fcdac5820a70c5c57c82
msgctxt "scenario7:scenario7_2F81EBB3_F8A2_41F0_93EE_05BA4326A48B"
msgid ""
"⟪k:0⟫⟪k:1⟫I would understand if it were clear out...⟪k:2⟫⟪k:3⟫but can you really say it’s "
"“wonderfully” gloomy?"
msgstr ""
"⟪k:0⟫⟪k:1⟫Я поняла бы, если б небо было чистым...⟪k:2⟫⟪k:3⟫но ты и правда можешь назвать "
"пасмурный день “чудесным”?"

#: scenario7:scenario7_DFA0EF82_350D_475B_8014_D38E3E4E9C6F
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 4984cdbf75427a71c666f63dbc7cb62d6431ca7a389f1d320ee7cd6f628f7419
#. default-sha256: 8fa27587a47e6a0c07d06a4fa3d52ef341404cf304f13d7c664a2c97aceaebc6
msgctxt "scenario7:scenario7_DFA0EF82_350D_475B_8014_D38E3E4E9C6F"
msgid ""
"⟪k:0⟫⟪k:1⟫Well, you can’t be outside for very long when it’s not cloudy, so in our case, this is "
"perfect weather."
msgstr ""
"⟪k:0⟫⟪k:1⟫Ну, ты ведь не можешь выходить на улицу в погожий день, так что в нашем случае это "
"просто идеальная погода."

#: scenario7:scenario7_E1821575_CA6E_403F_8D30_4330B21534A6
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 57877180bc311e013b2514f8bb6145fc5777b25572b976cec7907d5a6e5ca97d
#. default-sha256: 18ed98788ec36fbea54bbb587dcc596abaaf5b8795ec36093640521f585b21d8
msgctxt "scenario7:scenario7_E1821575_CA6E_403F_8D30_4330B21534A6"
msgid "⟪k:0⟫⟪k:1⟫Ah..."
msgstr "⟪k:0⟫⟪k:1⟫Ах..."

#: scenario7:scenario7_C01E4773_3075_4DCE_B133_8C7266956346
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: df9413ce735ca5d0a3b5b4bb6894af50159261c41bdd4536012e0ed8dac09cf3
#. default-sha256: 8dbe5c5c578d3c86c8762ba60cd9440e6cb658dd636b5d97da35970284ce3e1e
msgctxt "scenario7:scenario7_C01E4773_3075_4DCE_B133_8C7266956346"
msgid ""
"⟪k:0⟫⟪k:1⟫What do you say we go for a little stroll, while we can?⟪k:2⟫⟪k:3⟫Dee’s around today "
"too, so we can see if he’s up for it.⟪k:4⟫⟪k:5⟫It’ll be like old times."
msgstr ""
"⟪k:0⟫⟪k:1⟫Что ты скажешь, если мы немного прогуляемся, раз уж есть такая возможность?⟪k:2⟫⟪k:3⟫Ди "
"тоже сегодня дома, так что, если он не будет против, мы можем погулять.⟪k:4⟫ Это будет прямо как "
"в старые времена."

#: scenario7:scenario7_9406F46A_7FED_421F_A304_80D3F5789C3F
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 4ccf2288f40e0bf002f6ebc68b032280a8e3bf1dcaa8ee6422eeb3f2050f34c0
#. default-sha256: 4f9c007015fcbf1fa06945c44f201e2be201106c6f2d75339afc5298184e99ba
msgctxt "scenario7:scenario7_9406F46A_7FED_421F_A304_80D3F5789C3F"
msgid ""
"⟪k:0⟫⟪k:1⟫We’ve been running around like headless chickens lately,⟪k:2⟫so we haven’t had much of "
"a chance for a sibling outing.⟪k:3⟫⟪k:4⟫We’ll have Mom make us a lunch, and then—"
msgstr ""
"⟪k:0⟫⟪k:1⟫В последнее время мы носились как угорелые,⟪k:2⟫и у нас не было шанса устроить семейный "
"пикник.⟪k:3⟫⟪k:4⟫Попросим маму, чтобы она приготовила нам что-нибудь перекусить, а потом—"

#: scenario7:scenario7_2086E62F_87B2_47C7_B186_8D57CAE02078
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 1a8bc02daf04568bf1c4a3386cf161f08e6000614a59d23cf1e3ec83eabd32b6
#. default-sha256: 60ae4bc3e69ad6eab89b3250a28e95b5f468054f5a31fe70368da35a54cb6a9f
msgctxt "scenario7:scenario7_2086E62F_87B2_47C7_B186_8D57CAE02078"
msgid "⟪k:0⟫⟪k:1⟫Ooh, we’ll take a couple horses up to the forest’s edge!"
msgstr "⟪k:0⟫⟪k:1⟫Оох, еще возьмем парочку лошадей, чтобы прокатиться верхом до опушки леса!"

#: scenario7:scenario7_AB202D56_42D8_44B8_855B_BA820064EA7D
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: a4771c166fc5c4490064dbbe2ade91ae6074c870b98714c84909c7bcab6d9acf
#. default-sha256: 7be2691726525edf0e46868ba2d21631482f0a69dfdfd26109db71d9217f43cb
msgctxt "scenario7:scenario7_AB202D56_42D8_44B8_855B_BA820064EA7D"
msgid "⟪k:0⟫⟪k:1⟫I-⟪k:2⟫I’m fine with that if you are."
msgstr "⟪k:0⟫⟪k:1⟫Я-⟪k:2⟫Я не против, если ты не против."

#: scenario7:scenario7_1CC04FBE_D7D3_499E_8D23_9241BEE32370
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 0964ec269578b9e6348c6d09db77c66e9834b7970c9faf3db3829b8c3bfb85a3
#. default-sha256: 5437bd250285b581dea008c50f05c5964224c0d857cb2d1b9c26e53cb9e69804
msgctxt "scenario7:scenario7_1CC04FBE_D7D3_499E_8D23_9241BEE32370"
msgid "⟪k:0⟫⟪k:1⟫You bet your bum I am. I asked, after all!⟪k:2⟫⟪k:3⟫Now c’mon, let’s go!"
msgstr "⟪k:0⟫⟪k:1⟫Конечно я не против. В конце концов, это ведь я спросил!⟪k:2⟫⟪k:3⟫А теперь идем!"

#: scenario7:scenario7_34D266ED_1135_4E45_9C31_EA6D46852228
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: f4e0284cc1916075490421aa6fd952a11cebdb721eeec1913c6d11a95476a3aa
#. default-sha256: 62b5bb460e2278fb66b50d8c8950c389c87d81cb22649b7e85d560fc8152759b
msgctxt "scenario7:scenario7_34D266ED_1135_4E45_9C31_EA6D46852228"
msgid "⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫⟪k:4⟫⟪k:5⟫⟪k:6⟫⟪k:7⟫An outing, you say?"
msgstr "⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫⟪k:4⟫⟪k:5⟫⟪k:6⟫⟪k:7⟫Пикник значит?"

#: scenario7:scenario7_54C4A907_7278_42D2_914B_8485A57F286B
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: c34230646bcd048c268da224c9a1ea94e9391d2f44b9a5bb68e647cfebebb6bf
#. default-sha256: 9669fa4ef0ff71a1787d5e4a3ae45a8911c19ac970bd352efc12c0e9c6ebff0a
msgctxt "scenario7:scenario7_54C4A907_7278_42D2_914B_8485A57F286B"
msgid ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫Yepyep. Hop on a couple horses and head for the forest.⟪k:3⟫⟪k:4⟫We haven’t done "
"this in a while, so I figured why not."
msgstr ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫Ага. Запряжем несколько лошадей и отправимся в лес.⟪k:3⟫⟪k:4⟫Мы уже давно этого не "
"делали, так что я подумал, а почему бы нет."

#: scenario7:scenario7_C7FE1404_21B8_4AFB_ACBC_CE0D1EBB2D6E
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 2df64dc2631b3d395a6a8e830b16fe81c98e91f1a237cdf6a2e3e9c3577cd969
#. default-sha256: 8ff0759e4034c95c672ee2d839b6ec4e3093f3ab86d8d4ef49133bb4a5431c4c
msgctxt "scenario7:scenario7_C7FE1404_21B8_4AFB_ACBC_CE0D1EBB2D6E"
msgid ""
"⟪k:0⟫⟪k:1⟫I see. Well, if Michelle is coming, I see no reason to say no.⟪k:2⟫⟪k:3⟫Let’s set off "
"right away."
msgstr ""
"⟪k:0⟫⟪k:1⟫Понятно. Ну чтож, если Мишелль идет, тогда и я не вижу причины отказываться.⟪k:2⟫⟪k:3⟫"
"Отправляемся немедля."

#: scenario7:scenario7_0439C8F3_C6DE_422D_BA4F_F3A310E5967F
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 63c03cc0bdc88f41dddc39a7b0856e6bf0ba90dcb4b721cbdad13b7a86515bc5
#. default-sha256: 7924da0f4f85c5e55038987c777db375044e49c233568ec4aa1f314447d3d211
msgctxt "scenario7:scenario7_0439C8F3_C6DE_422D_BA4F_F3A310E5967F"
msgid ""
"⟪k:0⟫⟪k:1⟫Whoa, whoa, slow down there.⟪k:2⟫⟪k:3⟫Are you saying you wouldn’t go if it was just me?"
"⟪k:4⟫⟪k:5⟫It’s Michelle or nothing?"
msgstr ""
"⟪k:0⟫⟪k:1⟫Эй, эй, погоди-ка.⟪k:2⟫⟪k:3⟫То есть ты хочешь сказать, что будь только я, ты бы не "
"пошел?⟪k:4⟫⟪k:5⟫То есть либо с Мишелль, либо никак?"

#: scenario7:scenario7_8DF16205_0566_4025_B2D9_528D1AA14340
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: dc9cc4d82e13dde3ea2b2c578e2b648d8de5570949506c09857695c14d1b7417
#. default-sha256: 3b39f773a8a9a80c7212761e95a816800ac30395a03c3abe520fbf3e0273964e
msgctxt "scenario7:scenario7_8DF16205_0566_4025_B2D9_528D1AA14340"
msgid ""
"⟪k:0⟫⟪k:1⟫Of course. Why on earth would I want to go horse-riding alone with you? ⟪k:2⟫I would "
"rather drown myself."
msgstr ""
"⟪k:0⟫⟪k:1⟫Конечно. Чего ради, мне отправляться на конную прогулку в твоей компании? ⟪k:2⟫Уж лучше "
"утопиться."

#: scenario7:scenario7_D6BBF839_251E_423D_AD38_1E3477201973
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: d9f2312e9355ad0a9699d81455757eaa13978946ea74bb38e27275fc6ec42ec7
#. default-sha256: 50d36024e10e1b53dd4b6b6e426ab27d4aa2180c9d2116fd7a7283cbb3e6b8aa
msgctxt "scenario7:scenario7_D6BBF839_251E_423D_AD38_1E3477201973"
msgid "⟪k:0⟫⟪k:1⟫⟪k:2⟫LE GAAAAAAAAAAAAAAAASP!"
msgstr "⟪k:0⟫⟪k:1⟫⟪k:2⟫Да ну тебяяяяяяяяяяяя!"

#: scenario7:scenario7_F4B2BA61_62B5_4150_BFC7_104328D10817
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: b9233c519ae9c483697e3c27c01c93251de566fea06938a19bd888d80a9aaf6e
#. default-sha256: 10a7215a208d7e45bd619adc64c09ad564ca71e3e85f305e6c1a522d4e06a507
msgctxt "scenario7:scenario7_F4B2BA61_62B5_4150_BFC7_104328D10817"
msgid "⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫Um, Didier... ⟪k:4⟫could I, perhaps, make a small request?"
msgstr "⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫Ам, Дидье... ⟪k:4⟫могу я попросить о небольшом одолжении?"

#: scenario7:scenario7_D5201F50_0026_463D_ACA6_0B41AE96A802
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: e78cc20699ef6cce2aa67f9ea1729ef8f35b8b8b634f4c0b5c32c6f34d151076
#. default-sha256: 59f540861f6a0af2fea22c4359859ed302b7c071d190229d1d16a92f660a7db3
msgctxt "scenario7:scenario7_D5201F50_0026_463D_ACA6_0B41AE96A802"
msgid "⟪k:0⟫⟪k:1⟫Go on, let’s hear it."
msgstr "⟪k:0⟫⟪k:1⟫Говори, что ты хочешь."

#: scenario7:scenario7_50A8EFA1_E5B5_46CF_BAFF_2E5A5D2666AC
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 6f3a0ca8f04ef823f3bacfef9c86c7d702b5f032c209bb6dbc7eec3f9bee7dd1
#. default-sha256: b0a3e659d0739b7ff59e4c8bf1a545b2a4470350ec59090f2a2f067ac33add54
msgctxt "scenario7:scenario7_50A8EFA1_E5B5_46CF_BAFF_2E5A5D2666AC"
msgid "⟪k:0⟫⟪k:1⟫Do you mind if I... ⟪k:2⟫hold the horse’s reins?"
msgstr "⟪k:0⟫⟪k:1⟫Ты не возражаешь, если я... ⟪k:2⟫буду держать поводья?"

#: scenario7:scenario7_CD4C7EE4_B103_480B_8DB0_1A19F8854021
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 3a4cd399b89cc35b2da781c97cb46f13e31998a3b4d6636c47108562f8998ce1
#. default-sha256: e21a3c278e1b5c186d4fd836ecd1637d7bb568446bff1810ed8517a6c9ef45ab
msgctxt "scenario7:scenario7_CD4C7EE4_B103_480B_8DB0_1A19F8854021"
msgid ""
"⟪k:0⟫⟪k:1⟫Oh, that’s all? By all means.⟪k:2⟫⟪k:3⟫I’ll be there behind you to make sure nothing "
"happens, so have at it."
msgstr ""
"⟪k:0⟫⟪k:1⟫Ох, это все? Разумеется.⟪k:2⟫⟪k:3⟫Я буду прямо за тобой и позабочусь, чтобы ничего не "
