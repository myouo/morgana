msgctxt "scenario7:scenario7_6999A1C8_7815_4679_9DB7_59ACA4299776"
msgid "⟪k:0⟫Screamed some more."
msgstr "⟪k:0⟫Много крича."

#: scenario7:scenario7_771E490D_02E1_49C6_8BF1_E8C383DF1858
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 8b3c1d9609d80e0e22e4b5ef740885c09678946e3d5164412d01d8e226ae385f
