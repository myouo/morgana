msgctxt "scenario7:scenario7_82D364DC_A28D_4574_B89E_DA4218B2F4B7"
msgid "⟪k:0⟫I was sitting quietly on my bed, unable to fall asleep,"
msgstr "⟪k:0⟫Я тихо сидел в своей постели, не в состоянии уснуть,"

#: scenario7:scenario7_7391F8E9_C7B8_4994_BB40_16210B92C3C8
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: fd026be7643383180263646ea4e62968b82407faf06c546d71a2aac61e2d3abe
