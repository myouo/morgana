msgid "⟪k:0⟫Absolute wretchedness."
msgstr "⟪k:0⟫Абсолютное убожество."

#: scenario7:scenario7_2EE2D0E3_BE2A_4F6A_BF2B_63B905D1F7AA
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: fb9017f50602d23313b6aa2dd91d7b720099fc82cf1a67cdd44906e9801d8e16
