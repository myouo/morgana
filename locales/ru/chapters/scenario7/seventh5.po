msgctxt "scenario7:scenario7_771E490D_02E1_49C6_8BF1_E8C383DF1858"
msgid "⟪k:0⟫It was the very image of pitiful."
msgstr "⟪k:0⟫Это было весьма жалкое зрелище."

#: scenario7:scenario7_AEE1FA1B_A986_4635_8CD3_A9866142011B
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
