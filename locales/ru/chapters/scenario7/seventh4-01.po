msgctxt "scenario7:scenario7_115FC035_3AAB_4941_9F70_A7FDD8BA7472"
msgid "⟪k:0⟫the female name she bestowed upon me at birth, which I so despised."
msgstr "⟪k:0⟫женским именем, что она даровала мне при рождении, и тем, что я так ненавидел."

#: scenario7:scenario7_8E96DBA4_1306_4485_9EFA_369E279396E5
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 5d23575436dd85b635fd21f96aa6c7a99b349bcc21bfd1de43bc9c5ecb2051d7
