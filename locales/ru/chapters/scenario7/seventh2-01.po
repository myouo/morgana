msgctxt "scenario7:scenario7_B1709379_FCD0_44C9_8B31_332A230F7D21"
msgid "⟪k:0⟫I didn’t think he was especially strong, either. ⟪k:1⟫He was hardly built like Didier."
msgstr "⟪k:0⟫Я не думал, что он был особо сильным. ⟪k:1⟫Он был сложен далеко не так, как Дидье."

#: scenario7:scenario7_D07D61E7_BE90_4A13_A224_5D00CA7DE1D2
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 454f5e118bae4a93d51b0688784c62fe483c08627b12f0442cb8c48404e73219
