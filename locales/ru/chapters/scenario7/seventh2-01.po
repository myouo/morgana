msgid "⟪k:0⟫The bitter scent of wine wafted from above."
msgstr "⟪k:0⟫От него разило вином."

#: scenario7:scenario7_D140738E_BA9B_4F3D_8411_8E98B35C97B6
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: ea9e62942b45cbde174af1cca74a455d6416669cc761db0d046724f82b7b00e6
