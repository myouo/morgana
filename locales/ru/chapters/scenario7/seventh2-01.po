msgid "⟪k:0⟫⟪k:1⟫⟪k:2⟫...?"
msgstr "⟪k:0⟫⟪k:1⟫⟪k:2⟫...?"

#: scenario7:scenario7_43E1C2D0_3F06_485B_BCC9_00626FFF67B2
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: dcba6cb0e08876736404bc334c7795b3a97aa98fd7fb5a684200756f8c5dfadf
#. default-sha256: 6f2fba6771887b0c31c60e72c60946ca2c1b4f3302da8ec5ef5aafb345bf1f11
msgctxt "scenario7:scenario7_43E1C2D0_3F06_485B_BCC9_00626FFF67B2"
msgid "⟪k:0⟫A warm breeze blew past, sending up a swirl of flower petals."
msgstr "⟪k:0⟫Прошелестел теплый ветерок, вздымая вихрь цветочных лепестков."

#: scenario7:scenario7_FE166405_06E9_48C9_B91E_7D545B24CDC6
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 49946e1f2565701197bd37ae8c8338f811f7c457d327026d0186dd96aa8ecd9c
#. default-sha256: ab778865b1f2b248332077033277ab7da4cbf324df8937403851ea18f9f7a721
msgctxt "scenario7:scenario7_FE166405_06E9_48C9_B91E_7D545B24CDC6"
msgid "⟪k:0⟫The girl’s dress hung lightly over her frame, tracing her gentle curves."
msgstr "⟪k:0⟫Платье слегка облегало стан девушки, подчеркивая его нежные изгибы."

#: scenario7:scenario7_CFB6B5B7_B005_45AD_AEAE_EF9562430783
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 491561a6d75d14a6423dcab62252b01c212fe4c8e275eeccfbe38fad3e66545e
#. default-sha256: 0df1d564f847c87314c0d376289bca6025040388156fc1a075c3e513d714d69c
msgctxt "scenario7:scenario7_CFB6B5B7_B005_45AD_AEAE_EF9562430783"
msgid "⟪k:0⟫⟪k:1⟫And you are?"
msgstr "⟪k:0⟫⟪k:1⟫А ты?"

#: scenario7:scenario7_E59D31B4_85C2_4732_A368_4E4D1F67B857
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 7c04b1b0143fdd916abfc7625fa82c0431ebd6af2de8edfbd1aa35755926c46c
#. default-sha256: 42fcd7206c6118d42febc920d2de8d8170b762ac98cfe053247742a5e95eeae3
msgctxt "scenario7:scenario7_E59D31B4_85C2_4732_A368_4E4D1F67B857"
msgid "⟪k:0⟫⟪k:1⟫My name is Aimee.⟪k:2⟫⟪k:3⟫It’s a pleasure to finally meet you."
msgstr "⟪k:0⟫⟪k:1⟫Меня зовут Эми.⟪k:2⟫⟪k:3⟫Приятно, наконец, встретиться с тобой."

#: scenario7:scenario7_F9079209_E85A_47FC_B2FA_F9843BD38D98
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 17fe70afb9d502cd0702a73b640d0da2f52f30912427842785f10366f1814480
#. default-sha256: 73191ff90d88b746df3a15ad983fde786401a5ec2ee5a52c3bb672a7f98c1c86
msgctxt "scenario7:scenario7_F9079209_E85A_47FC_B2FA_F9843BD38D98"
msgid "⟪k:0⟫she stepped toward me, kissing me softly on the cheek."
msgstr "⟪k:0⟫она подошла и легонько поцеловала меня в щеку."

#: scenario7:scenario7_BDFDDAED_DC39_40E0_BAAC_48879F664DE0
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: b9f48aab2282e3847e3fae95f2128d9089e7fef6c6d5e87346bdaa58443df077
#. default-sha256: 6cdae358836074f60c02bba473f5e2d9b9c3a697875a003ee8a820961ccf3b36
msgctxt "scenario7:scenario7_BDFDDAED_DC39_40E0_BAAC_48879F664DE0"
msgid "⟪k:0⟫Electrifyingly sweet."
msgstr "⟪k:0⟫Чарующе приятный."

#: scenario7:scenario7_09505D2C_BFC5_4070_A5DF_6C8CB3F33C4C
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: a60b278ed18659d3cf56885595f86bd8ee02ede8dfe887caa07d0e948a892b77
#. default-sha256: 266a7309ee0832b4c6a2fa8b60969ec1ab6fd78dfbd22661d5c897f49acbc0c2
msgctxt "scenario7:scenario7_09505D2C_BFC5_4070_A5DF_6C8CB3F33C4C"
msgid "⟪k:0⟫⟪k:1⟫I’m Georges’s fiancée."
msgstr "⟪k:0⟫⟪k:1⟫Я невеста Жоржа."

#: scenario7:scenario7_0CC24CFF_DFBA_42EC_A670_E87AED53CB32
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 9da833f8b5017ce5f7a30f3008f89d1ce03ab1b4ae7db5e84404daa3a9d463e8
#. default-sha256: 1b883d545263c130d13c49a14fbba2ee854d52abb65305bad98a806623e6150f
msgctxt "scenario7:scenario7_0CC24CFF_DFBA_42EC_A670_E87AED53CB32"
msgid "⟪k:0⟫And it also"
msgstr "⟪k:0⟫А еще,"

#: scenario7:scenario7_7FC60674_11DD_464C_AB5F_B4B8A969DD1D
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 62996cd102fab6aa4024c63ee47094461935ff0c3d171ec026d25014690215d0
#. default-sha256: ce43e1201400b7e00885e3e58d7bd7170acd7ce043c63955982a57d0a4fec9e8
msgctxt "scenario7:scenario7_7FC60674_11DD_464C_AB5F_B4B8A969DD1D"
msgid ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫⟪k:4⟫⟪k:5⟫⟪k:6⟫⟪k:7⟫⟪k:8⟫She was a noble girl by the name of Aimee Joubert. "
"⟪k:9⟫Though only fifteen, she was the very image of refined—⟪k:10⟫⟪k:11⟫polished to a shine."
msgstr ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫⟪k:4⟫⟪k:5⟫⟪k:6⟫⟪k:7⟫⟪k:8⟫Она была знатной девушкой по имени Эми Юбер. ⟪k:9⟫И "
"хотя ей было всего пятнадцать лет, она была очень изысканной — ⟪k:10⟫⟪k:11⟫прямо-таки "
"отполированной до блеска."

#: scenario7:scenario7_CE727012_CD18_480E_AAB1_20A8B589F913
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 9e05fa7f000c73e3f2540c3279becf7d9e4fcdb1bd098a07966095452185bccd
#. default-sha256: 71ab15fc4a5bbe72df0dc9fbb03837a2e6ce4061c7bef05047f2291e98268deb
msgctxt "scenario7:scenario7_CE727012_CD18_480E_AAB1_20A8B589F913"
msgid "⟪k:0⟫It came out of nowhere, ⟪k:1⟫and it seemed I was the only one who didn’t know."
msgstr ""
"⟪k:0⟫Это произошло как-то спонтанно, ⟪k:1⟫и похоже, я был единственным, кто об этом не знал."

#: scenario7:scenario7_4C7E4720_9197_41B4_925D_5BAB63DFAD73
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 6932f614157f6ef0070afbc6420233991522fb7ee35fed1de8fe45bfe0500a8b
#. default-sha256: 58b3ebe52be0e8519c1a35812b4a6468ad42a7e650a8543c5fabf4a1b9950a94
msgctxt "scenario7:scenario7_4C7E4720_9197_41B4_925D_5BAB63DFAD73"
msgid ""
"⟪k:0⟫That evening, when the family gathered around the table for supper, Aimee was there too. "
"⟪k:1⟫And they prepared an extravagant feast for the occasion."
msgstr ""
"⟪k:0⟫В тот вечер, когда семья собралась за ужином, Эми тоже там была. ⟪k:1⟫И по этому случаю, они "
"устроили роскошный пир."

#: scenario7:scenario7_2451AB79_1AEF_4C56_B230_8116FEE02F34
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 8c0d87f2f7b36f9b44d0f7b1daea48ecffc1449fede1c1d071f11a733e788e93
#. default-sha256: 8b62dc9db7f4e5c1c6e85915ae5769d11977a314be785b85aea804702f1cd51d
msgctxt "scenario7:scenario7_2451AB79_1AEF_4C56_B230_8116FEE02F34"
msgid "⟪k:0⟫Mother was pleased to have another girl around."
msgstr "⟪k:0⟫Мать была рада еще одной девушке в доме."

#: scenario7:scenario7_64269743_0DF3_4D1E_9780_A9512BF3F822
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 3141d1f6cf4b2244b4af6fac4369dff299686eede236975a3690f15d71930e3b
#. default-sha256: ac300d49ca124ccca52bb8f1662aa4a6da17f08f737b2c99e4885e12c0ca43d6
msgctxt "scenario7:scenario7_64269743_0DF3_4D1E_9780_A9512BF3F822"
msgid ""
"⟪k:0⟫Or, more specifically, she was relieved to have found someone other than my brothers for me "
"to spend time with."
msgstr ""
"⟪k:0⟫Или, если выражаться точнее, она была рада тому, что появился еще кто-то, помимо моих "
"братьев, с кем я мог провести время."

#: scenario7:scenario7_AFA09C65_DDDD_4F1D_8E4F_B475801780C8
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: b1771ceda628d4688c8aa86c2f756d409b0535bf411230824afe4a2eef3d7749
#. default-sha256: 5ec138470b6e5676a124da1256ab7eea0e5b320f306c9e5fd21442503ac6d0ba
msgctxt "scenario7:scenario7_AFA09C65_DDDD_4F1D_8E4F_B475801780C8"
msgid "⟪k:0⟫I felt much less... ⟪k:1⟫suffocated around her than my mother."
msgstr "⟪k:0⟫я чувствовал себя в ее присутствии менее... ⟪k:1⟫подавленно, нежели со своей матерью."

#: scenario7:scenario7_FD5E8DB1_8AFB_4E85_A513_2395D28F0324
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: e2f5f7ab1d0e6a9f932b54c1aedfc10c0a6a4a7ac5fc187ecf366aafc1bdef12
#. default-sha256: 52913e90bcdce8598d961b2cfa78ba3edc25245ec23a8613eec1e6475bf6ca54
msgctxt "scenario7:scenario7_FD5E8DB1_8AFB_4E85_A513_2395D28F0324"
msgid "⟪k:0⟫A din the likes of which I had never heard in my life filled the great hall."
msgstr "⟪k:0⟫Шум, которого я прежде никогда за всю свою жизнь не слышал, наполнил главный зал."

#: scenario7:scenario7_FB6993ED_C256_4432_A9BF_47990377BB60
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: b8ff1d06450a36334761c414898dbe331d4748c21a3110a62a535f3d76fd1019
#. default-sha256: 30902f56bb9521557ba40c995610e05b0439dfcbdbfd98cc518b1f9966d9acbc
msgctxt "scenario7:scenario7_FB6993ED_C256_4432_A9BF_47990377BB60"
msgid "⟪k:0⟫Everywhere I looked, there were people, people, people."
msgstr "⟪k:0⟫Куда бы я ни посмотрел, везде были люди, люди, люди."

#: scenario7:scenario7_AE3C5140_E779_4907_BA91_7508DDAFC3DA
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 7f8b89663caf5292fc734b0540cc165dd49ce73d9cf59a4888f6c4c4d4b4843c
#. default-sha256: ce51e9f9dd8002a5b12655ed6b06acf01b7b012caccdfd2367712942bd43ca24
msgctxt "scenario7:scenario7_AE3C5140_E779_4907_BA91_7508DDAFC3DA"
msgid "⟪k:0⟫Voices from all directions."
msgstr "⟪k:0⟫Со всех сторон слышались голоса."

#: scenario7:scenario7_9326FF57_90A9_44C3_9FA6_46CDCF4F59BB
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: c0b458c610a1910e47904052dab929c60825614475cf9043255f7e9aa2341f11
#. default-sha256: 36627fafc245804ef475e4244a4ed638c0a7cec68c3f9aa8108810bf32f70335
msgctxt "scenario7:scenario7_9326FF57_90A9_44C3_9FA6_46CDCF4F59BB"
msgid ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫⟪k:4⟫⟪k:5⟫⟪k:6⟫Hey Dee, I feel like we’re critically short on waiters.⟪k:7⟫"
"⟪k:8⟫This don’t look good for us."
msgstr ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫⟪k:4⟫⟪k:5⟫⟪k:6⟫Эй, Ди, похоже, нам крайне не хватает официантов.⟪k:7⟫⟪k:8⟫Не "
"очень-то это хорошо для нас."

#: scenario7:scenario7_4AB296AE_1FCD_47C1_AE8A_959666A52A0A
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: d28109c972db5004d4acf624a99d5b1f567e6d1e48f3fb90c54712390c001c1d
#. default-sha256: ad9cb28df71bb2684e8fa5b0a6fa28b0d9134f9fc9262ce43eb957f7e1600594
msgctxt "scenario7:scenario7_4AB296AE_1FCD_47C1_AE8A_959666A52A0A"
msgid ""
"⟪k:0⟫⟪k:1⟫They’re ⟪k:2⟫artistes⟪k:3⟫ like me. I met them at the court.⟪k:4⟫⟪k:5⟫Let’s see, we "
"have some painters, composers, sculptors, troubadours, poets, writers, you name it."
msgstr ""
"⟪k:0⟫⟪k:1⟫Они ⟪k:2⟫артисты⟪k:3⟫ как и я. Я встретил их в королевском дворе.⟪k:4⟫⟪k:5⟫Посмотрим, у "
"нас есть художники, композиторы, скульпторы, трубадуры, поэты, писатели, да все, кого душа "
"пожелает."

#: scenario7:scenario7_371CF7E6_AB99_46C2_A916_9B22E1E37DAB
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: c77b23c4647ce9d282fc85c9c131a9582579d9a2fbbae409eaf67cfb013a03eb
#. default-sha256: 4aa977031b7e29e3f180113951e6910b03b32eb4a67d53fc160a06a139cbf2bd
msgctxt "scenario7:scenario7_371CF7E6_AB99_46C2_A916_9B22E1E37DAB"
msgid "⟪k:0⟫⟪k:1⟫None of them have any connection to the Jouberts ⟪k:2⟫or⟪k:3⟫ Bollingers!"
msgstr "⟪k:0⟫⟪k:1⟫Никто из них не имеет ни малейшего отношения к Юбер ⟪k:2⟫или⟪k:3⟫ Болинье!"

#: scenario7:scenario7_03A91D8F_173E_4C91_B91D_251A71428750
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 5a1e99006a32b4434f0aa549bd5c94f4eb6c66e72311f295f0029427e396b154
#. default-sha256: 73f1b2461aad9b769a1df70990ba6d1b129cae5a713c65995bd8caadcbd6560c
msgctxt "scenario7:scenario7_03A91D8F_173E_4C91_B91D_251A71428750"
msgid ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫⟪k:4⟫Off in one corner, several men—⟪k:5⟫⟪k:6⟫presumably Georges’s friends—"
"⟪k:7⟫⟪k:8⟫gathered in a circle."
msgstr ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫⟪k:4⟫Поодаль, в уголке несколько мужчин — ⟪k:5⟫⟪k:6⟫предположительно, друзья "
"Жоржа — ⟪k:7⟫⟪k:8⟫собрались в круг."

#: scenario7:scenario7_BBBF8C7F_DC36_4327_B785_C5D10320209F
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 4e1f07c922777bd51d02f775878a47b16d6ec5bba6c20bad5829d1c928d42423
#. default-sha256: a216d519dad9a701cfca0363c85f7696732ac186dcd53a27663bca4235738670
msgctxt "scenario7:scenario7_BBBF8C7F_DC36_4327_B785_C5D10320209F"
msgid ""
"⟪k:0⟫They stood out from the other aristocrats, both in appearance and the air they gave off. "
"⟪k:1⟫The clothes they wore. The embroidery hidden beneath their jacket cuffs."
msgstr ""
"⟪k:0⟫Они заметно выделялись на фоне других аристократов, как внешностью, так и некой аурой, что "
"излучали. ⟪k:1⟫Одеждой, которую носили. Вышивками, спрятанными под манжетами."

#: scenario7:scenario7_01049DFE_0896_43B2_81A6_1E04BA9F3200
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 61cca7da54a425e613aab6c50a88a8eec885d0c45c99e839b593d935ebc1f503
#. default-sha256: f37d2263830d2cff0c4efddf2fa69375358482bf26fb57281beeb01fad05ad3d
msgctxt "scenario7:scenario7_01049DFE_0896_43B2_81A6_1E04BA9F3200"
msgid ""
"⟪k:0⟫Their manner of speech. The way they held themselves. ⟪k:1⟫They were, simply put, a far cry "
"from the hardheaded Didier’s ideal party guests."
msgstr ""
"⟪k:0⟫Манерой речи. Тем, как они держались в обществе. ⟪k:1⟫Говоря простым языком, они были весьма "
"далеки от того, как Дидье представлял себе идеальных гостей."

#: scenario7:scenario7_6B76385C_D544_4488_9F4C_9DA809AEB49F
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 1991aa86fff86a9a18e5a77bb609e7655163ca581d77f4eadfab94da3c0b0e40
#. default-sha256: e6478085923c31095d65d1fb86f4a3f3b559bc945797b70b49195331a8427027
msgctxt "scenario7:scenario7_6B76385C_D544_4488_9F4C_9DA809AEB49F"
msgid ""
"⟪k:0⟫If they had been strangers, I doubt their paths would cross much—⟪k:1⟫⟪k:2⟫⟪k:3⟫and if they "
"did, those intersections would be quite rocky."
msgstr ""
"⟪k:0⟫Будь они незнакомцами, сомневаюсь, что их пути могли бы часто пересекаться—⟪k:1⟫⟪k:2⟫⟪k:3⟫а, "
"если бы такое случалось, их стычки были бы крайне напряженными."

#: scenario7:scenario7_A3872563_5584_4414_82BC_819BD9AC075A
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: a52b2130ec6b16adba70e1b422a21194dc653defb81073ae9f56e8b3a235a5ba
#. default-sha256: 5c82e5001593c4059f41e9101fba0b070a6be97a350e2858d3dfffe4955bd28e
