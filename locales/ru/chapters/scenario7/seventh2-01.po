msgid "⟪k:0⟫That wasn’t very nice of ya, runnin’ off like that."
msgstr "⟪k:0⟫С твоей стороны не очень-то любезно было вот так убегать."

#: scenario7:scenario7_6196453A_A457_4F87_8764_022166054E43
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 3b8aa3008ed641cd0e2075fca5013c939e2b675efd7bc678171ef6ee9f5d3e54
