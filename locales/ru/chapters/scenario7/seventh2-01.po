msgctxt "scenario7:scenario7_924161D0_BAEC_48AD_9DC5_167596F0F25C"
msgid "⟪k:0⟫⟪k:1⟫This is my baby sister Michelle. Be nice."
msgstr "⟪k:0⟫⟪k:1⟫Это моя младшая сестра, Мишелль. Прошу любить и жаловать."

#: scenario7:scenario7_9DB376F2_EDFE_4A6D_A1B9_34BD3888BB6C
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 4d39d151db9048064580b50f7a213d215486292a7345ef0b1306d3bd9fbce8b5
