msgid "⟪k:0⟫And so long as I was sick, I couldn’t be let out."
msgstr "⟪k:0⟫И пока я был болен, я не мог выходить."

#: scenario7:scenario7_BF92EEC8_A75F_41EE_A68E_28898B4C2636
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 8a62f6c5618a4585942676d1c8d63b58bd0b9552a9fe15183e5759490ccfd134
