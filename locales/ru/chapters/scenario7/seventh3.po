msgid "⟪k:0⟫One month passed, then two, then three."
msgstr "⟪k:0⟫Прошел месяц, за ним второй, затем третий."

#: scenario7:scenario7_639C439F_7FBD_4174_9335_18B330CEF9E6
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 8a73c2efb4550736ff89473c779ecf73fcd791cf19131ccb6d178d9ad20c4014
