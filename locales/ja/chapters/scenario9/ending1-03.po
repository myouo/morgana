msgid "⟪k:0⟫Never mind that... ⟪k:1⟫Where ⟪k:2⟫am⟪k:3⟫ I?"
msgstr "⟪k:0⟫いや……、⟪k:1⟫ここは……、⟪k:2⟫いったい……。"

#: scenario9:scenario9_7A53115B_CAC3_4A69_B7CF_15B5D7581784
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: f9ff3fa859b18f5993cec921e5b926f012f076831954eedc87270ed184388948
