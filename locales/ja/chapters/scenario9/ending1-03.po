msgid "⟪k:0⟫............"
msgstr "⟪k:0⟫…………。"

#: scenario9:scenario9_D4862E8D_0992_442C_82B4_6E6CBBB09432
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 24f726e2928fba44acbcbcbebe36903836ad90e023e58e7ba13641fc31519ab2
#. default-sha256: d9ce1efdbd95361bbbf6bab186a45ff3412f7537fc0854f6cbcb99887ef0c591
msgctxt "scenario9:scenario9_D4862E8D_0992_442C_82B4_6E6CBBB09432"
msgid "⟪k:0⟫You’re not a defect..."
