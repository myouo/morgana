msgid "⟪k:0⟫Splendid."
msgstr "⟪k:0⟫そう……、⟪k:1⟫良かった……。"

#: scenario9:scenario9_EF768DFA_9AB5_4F1E_9BAC_8B54FEC7F54E
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 6e34f8d7df438f9050ab1b61fcacec753f79e11099d9273002d9bf6497017ab1
