msgctxt "scenario9:scenario9_B62E9CEB_A857_4BDC_8BC4_DE2D0B129191"
msgid "⟪k:0⟫............"
msgstr "⟪k:0⟫…………。"

#: scenario9:scenario9_EEB2D58B_2A68_4E9C_8379_91E1270DF884
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: c8809c801e240b1f3ea65c71774323d3b105f9dabd5c4a3a1c519a63b0b3ef6d
#. default-sha256: 6bc083c8537f1644c441c6d926f576b33ff7e404901839e17022e44d89e24535
msgctxt "scenario9:scenario9_EEB2D58B_2A68_4E9C_8379_91E1270DF884"
msgid "⟪k:0⟫Why are you acting... ⟪k:1⟫like it’s all your fault?"
msgstr "⟪k:0⟫なんで……、⟪k:1⟫そんな言い方をする……。"

#: scenario9:scenario9_DF5DEAFE_AB08_4F9A_BCBA_1DA2539EC800
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: b6c5c1b242b6a0b48e07cbc2cc1bdd6b9edce85761ccff253f891bb1528fa92d
#. default-sha256: f7394d75c9ca79747394541f6a00e3bc96eccef0d7b3e1eb03add6fe5f19f584
msgctxt "scenario9:scenario9_DF5DEAFE_AB08_4F9A_BCBA_1DA2539EC800"
msgid "⟪k:0⟫Are you trying to say everyone would be better off without you?"
msgstr "⟪k:0⟫自分がいない方が良かったと……、⟪k:1⟫そう言うつもりなのか……。"

#: scenario9:scenario9_924BB831_2A65_4066_B6DF_6B5AF8268651
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 317428aada77703b863b4ca0e5da802903b1345f58746ffe25807b9edb428288
#. default-sha256: 2de2e2f1f5ceed496cc834203dbeeb3feab6f2307b9ad41e3b154d49885a1155
msgctxt "scenario9:scenario9_924BB831_2A65_4066_B6DF_6B5AF8268651"
msgid "⟪k:0⟫Like hell you were."
msgstr "⟪k:0⟫そんな……、⟪k:1⟫馬鹿な話があるか……。"

#: scenario9:scenario9_B139A233_E70D_4F3B_8565_A51B4A55377C
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: da1df6e5cd645e49bf73f2c2caf368f744d4ce48b81cd1cece90ae5c7684878b
#. default-sha256: 26a3502520850e02a970fd68034c701b69ef5eacd6ce28d027bceaeb7bff9c7f
msgctxt "scenario9:scenario9_B139A233_E70D_4F3B_8565_A51B4A55377C"
msgid "⟪k:0⟫I was born to be a receptacle for her pain, to ease her suffering."
msgstr ""
"⟪k:0⟫私は彼女の痛みを受け取り、⟪k:1⟫彼女の苦痛を和らげるためだけの存在でした。⟪k:2⟫そのために私は"
"産まれたのです。"

#: scenario9:scenario9_8EC6D6CB_F486_41D7_BCDE_441BCF502863
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 2b188971fef2f89fd3a29ce2268589cecb3bf86139057990159fb8dc7d6d816e
#. default-sha256: 52c3270676cc22087bf1636a0cb4a632d662f0574262bc11ee10d248be9ec50c
msgctxt "scenario9:scenario9_8EC6D6CB_F486_41D7_BCDE_441BCF502863"
msgid ""
"⟪k:0⟫That was not how she felt deep down, though.⟪k:1⟫⟪k:2⟫She was not a saint out of the "
"goodness of her heart."
msgstr ""
"⟪k:0⟫それは――、⟪k:1⟫彼女の善意からくるものではなく、⟪k:2⟫また、⟪k:3⟫本意でもありませんでした。"

#: scenario9:scenario9_27B4F3AD_B200_46E0_9E39_760FA23116D6
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 4221bb17783c91923cefbf0bc120403624b4d41d2d64ce53cee5c30c46c09dce
#. default-sha256: ac369e103614739a6009732a41b6d6e2349aa525919786baad4071854e12683c
msgctxt "scenario9:scenario9_27B4F3AD_B200_46E0_9E39_760FA23116D6"
msgid ""
"⟪k:0⟫So she took all her “saintly” characteristics and gave them to me—⟪k:1⟫⟪k:2⟫caring for "
"others, putting herself second, being forgiving—"
msgstr ""
"⟪k:0⟫ですから……、⟪k:1⟫人を思いやることや、⟪k:2⟫犠牲的であること、⟪k:3⟫⟪k:4⟫人を許すこと……すべての"
"聖女的な概念を……"

#: scenario9:scenario9_300588D5_5543_4925_9C59_B86D0CDF8E42
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 10c8dec2b7b20f597e8d8cccb7652ced8bbeebc8f426be965f7e8df03a970f9b
#. default-sha256: ebb8dbe630102fe29ffc8cfa496d48a45ac16b09ec227bb87d16f6d95a2eafa9
msgctxt "scenario9:scenario9_300588D5_5543_4925_9C59_B86D0CDF8E42"
msgid "⟪k:0⟫............"
msgstr "⟪k:0⟫…………。"

#: scenario9:scenario9_AA49492A_FB24_4BEB_8A11_1B6DE71754A6
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 93a2a53a5c8146f8162bc1c999ffb09451de162857c862b67312cf1c3bf980b2
#. default-sha256: eae8e243a77a579cc85e28b70b34ab53792fd54f340f014e34f238222e7f2ccf
msgctxt "scenario9:scenario9_AA49492A_FB24_4BEB_8A11_1B6DE71754A6"
msgid "⟪k:0⟫In a world where I was never meant to exist."
msgstr "⟪k:0⟫これは……、⟪k:1⟫あってはならないことでした。"

#: scenario9:scenario9_82D5CD06_EFF9_4E8C_BF26_7855E821AEAB
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 27ccb231d84cd05611edb0a4b52791fe2e56b6b9fc5784442becb874b167305a
#. default-sha256: 95e9845ccb05f65f2fe3386a5b1a35aacd298105da9abc1643b9ffd1bf412907
msgctxt "scenario9:scenario9_82D5CD06_EFF9_4E8C_BF26_7855E821AEAB"
msgid "⟪k:0⟫and Morgana wished to curse the three men’s souls."
msgstr "⟪k:0⟫そしてモルガーナの願いは、⟪k:1⟫三人の男の魂を呪うこと。"

#: scenario9:scenario9_D3FF89B2_C0DD_42E7_9E15_DDDEC5A0FD03
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: db8f55a6d78bdf9e28cba6d6082113b55c528b4f58daf50281a060859734d67b
#. default-sha256: 9d3e304debfe83d148bf6c9c3da9c43d5fab9389258bf566cfcc76efa9848577
msgctxt "scenario9:scenario9_D3FF89B2_C0DD_42E7_9E15_DDDEC5A0FD03"
msgid ""
"⟪k:0⟫In order for an incomplete soul like mine to survive, it needs something to bind itself to "
"the world—⟪k:1⟫⟪k:2⟫something strong enough to prevent the universe from “correcting” the anomaly."
msgstr ""
"⟪k:0⟫私は、⟪k:1⟫魂という単位で不完全な存在でした。⟪k:2⟫そのような異物が存在し続けるためには、⟪k:3⟫"
"この世と私を結びつける強い何かがなければなりません。"

#: scenario9:scenario9_26C22C6F_3835_4C3F_BA35_F932EDDE9DE7
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 14a26be50a612d80abb244974a6f9a7feae857f9f08f104b8e27bcd17469478d
#. default-sha256: 46bde12c8daa4bf8617c9158c94fa462bdc2981a24e2874725b0df9697bb8c0e
msgctxt "scenario9:scenario9_26C22C6F_3835_4C3F_BA35_F932EDDE9DE7"
msgid "⟪k:0⟫And so the wish of that anomaly... ⟪k:1⟫gave birth to yet another anomaly—"
msgstr ""
"⟪k:0⟫この世のことわりから外れた私の願いは、⟪k:1⟫やはり、⟪k:2⟫この世のことわりから外れたものを産み"
"だしました。"

#: scenario9:scenario9_D21274E5_3971_4179_BCFE_1CCDE07DEAD6
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 3a3a3e6142cf27e3257af7ff2e496fa03c3f00a418ad112dcb7e27bff3a5ddcc
#. default-sha256: 680c077fdd81f7a84d119c7b7945edc5c629cdb82753be6892f8efe96a5d2987
msgctxt "scenario9:scenario9_D21274E5_3971_4179_BCFE_1CCDE07DEAD6"
msgid ""
"⟪k:0⟫a house that sat outside the currents of time.⟪k:1⟫⟪k:2⟫One that could descend into the "
"mortal realm at various times and places."
msgstr "⟪k:0⟫時と場所を超えて、⟪k:1⟫現世に現れる、⟪k:2⟫時の流れを置き去りにした館……。"

#: scenario9:scenario9_7B0EB139_01EE_4014_9911_2C1CB1F186DD
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: f74f7609ba37cb5a878ddee42b3b2eb5d335fe50f0b66eca49105da4c3d6e1ca
#. default-sha256: df82abad1ac766708bc14b5ccbe08b1eb572267d8869854bdb637375f44cedb4
msgctxt "scenario9:scenario9_7B0EB139_01EE_4014_9911_2C1CB1F186DD"
msgid "⟪k:0⟫And why did it have to be that house that bound me to the world?"
msgstr "⟪k:0⟫なぜ私とこの世を結びつけるものが、⟪k:1⟫館でならなければならなかったのか……。"

#: scenario9:scenario9_A9956F34_AC58_4FD8_AAB2_17ADFA21C0EF
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 10c8dec2b7b20f597e8d8cccb7652ced8bbeebc8f426be965f7e8df03a970f9b
#. default-sha256: ebb8dbe630102fe29ffc8cfa496d48a45ac16b09ec227bb87d16f6d95a2eafa9
msgctxt "scenario9:scenario9_A9956F34_AC58_4FD8_AAB2_17ADFA21C0EF"
msgid "⟪k:0⟫............"
msgstr "⟪k:0⟫…………。"

#: scenario9:scenario9_3D76D3F0_B785_4847_BC7D_4F8DC241C59C
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 0eaeb6fa32af6db1654c57ebc1a9b6e403d49bd8d4c4e13b0516591dce8a4ebc
#. default-sha256: 451070d3c43553065ecad7f51e869fbf117305a03902ad5cd7063ff5e03b81f5
msgctxt "scenario9:scenario9_3D76D3F0_B785_4847_BC7D_4F8DC241C59C"
msgid "⟪k:0⟫My very presence malevolent."
msgstr "⟪k:0⟫私の存在自体が……、⟪k:1⟫罪悪だったのです。"

#: scenario9:scenario9_77583269_3E0D_416C_A4DD_9CEC53949443
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 559c3f1ac5caceb041a5d07e5a881d661a280baaf9438d542075bc3064376d23
#. default-sha256: a1b7b6110094e3f5130501f591dee0b3a19d37a3470c7c33101f56455bd214c1
msgctxt "scenario9:scenario9_77583269_3E0D_416C_A4DD_9CEC53949443"
msgid "⟪k:0⟫Please, stop..."
msgstr "⟪k:0⟫……言わないでくれ……。"

#: scenario9:scenario9_4FA002B7_F14F_45BB_A19E_6A99E0CF9FDA
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 8f4540628830a6ae7e9a0b0d8b4e2a32f25c7d265a30b6cd274e8f4c70fcdcce
#. default-sha256: e18ac04c1f2f158e0e4a2b88538489358b8377a21cf7db5003d542eca93c2a45
msgctxt "scenario9:scenario9_4FA002B7_F14F_45BB_A19E_6A99E0CF9FDA"
msgid "⟪k:0⟫The universe must be returned to its proper state, Michel."
msgstr "⟪k:0⟫だから、⟪k:1⟫ミシェル……。⟪k:2⟫世のことわりを、⟪k:3⟫元に戻さなければなりません。"

#: scenario9:scenario9_4DECEAE2_970C_4CD6_BDDF_DE47457B4E9A
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 7ca5537da97a034cb4ffa8899845146de1fc61e42762ecc590fa53a8dca45310
#. default-sha256: 97e1e9ef792efe7c88f575f9ef65dbfdf495323875729ec11f14a71cf53e5085
msgctxt "scenario9:scenario9_4DECEAE2_970C_4CD6_BDDF_DE47457B4E9A"
msgid "⟪k:0⟫Don’t talk about yourself like that..."
msgstr "⟪k:0⟫……そんな……、⟪k:1⟫言い方を……、⟪k:2⟫しないでくれ……。"

#: scenario9:scenario9_A9F321DC_32EA_49D0_A6B0_F157BEECC80C
