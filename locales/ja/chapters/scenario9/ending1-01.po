msgid "⟪k:0⟫You... ⟪k:1⟫What are you..."
msgstr "⟪k:0⟫何を……、⟪k:1⟫言っているんだ……。"

#: scenario9:scenario9_16985783_0C9E_45D6_976E_5508F0AB78BF
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 2c001d51a1b8db8c96b6bcdd27f43aeed54117fd0886c3d06334696c394af7cc
