msgctxt "scenario9:scenario9_D103C95F_E067_4B9E_A23E_5D1E2174843E"
msgid "⟪k:0⟫To live."
msgstr "⟪k:0⟫……生きることです……。"

#: scenario9:scenario9_A7F6DEB0_17A1_48CC_BD38_B89FF9CE350D
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 848c47ca74fd9faa08fdfc904efb1291a80e3bd913578017e3823f6745993a77
#. default-sha256: 045f8b7ce045b4b974352a462bdd801736d1f5bf49f17cb2978793dad5fadf20
msgctxt "scenario9:scenario9_A7F6DEB0_17A1_48CC_BD38_B89FF9CE350D"
msgid "⟪k:0⟫I wished for a continued existence in this world."
msgstr "⟪k:0⟫私は私という存在が、⟪k:1⟫この世に在り続けることを、⟪k:2⟫願ったのです。"

#: scenario9:scenario9_F647F9E0_EC92_4137_8F87_3071135A8F6C
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
