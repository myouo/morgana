msgid "⟪k:0⟫And you’re trying to tell me that makes you culpable?"
msgstr "⟪k:0⟫それを……、⟪k:1⟫加害者だと……、⟪k:2⟫自分で言うのか……。"

#: scenario9:scenario9_53DD53DC_BE1F_481A_B933_EBB17AB7A0C5
