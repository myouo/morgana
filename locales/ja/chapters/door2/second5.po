#: scenario2:scenario2_8673E044_1B98_4FBC_BB7C_DC6901A79B14
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: dfeaead7b970e2a5e8f2f2784a365718e77fa1f8d727ace403dc993410702899
#. default-sha256: 2e3c9bc978689716558c75d7716ac9c77a72d45620a591c03cc8398e5084fb27
msgctxt "scenario2:scenario2_8673E044_1B98_4FBC_BB7C_DC6901A79B14"
msgid "⟪k:0⟫⟪k:1⟫⟪k:2⟫Then... ⟪k:3⟫I suppose I shall take you up on your generosity."
msgstr "⟪k:0⟫\t\t\t\t\t\t\t\t⟪k:1⟫⟪k:2⟫それなら……、⟪k:3⟫お言葉に甘えても良いでしょうか……？"

#: scenario2:scenario2_4085474D_5FA7_4CF4_ABDB_FDCE6F5B07F2
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: ed2d496a5582e4bf5bb5d21a9e67d3ab0722294a5ccbebc34d2a3c46d6ece89f
