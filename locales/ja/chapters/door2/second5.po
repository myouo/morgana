msgid "⟪k:0⟫Is anyone... ⟪k:1⟫Is anyone there?"
msgstr "⟪k:0⟫どなたか……、⟪k:1⟫いらっしゃいませんか。"

#: scenario2:scenario2_E3B8080E_64F4_494C_8748_E633AB9B7B86
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: dc2033d496e960e57b3eba847b8f76c0efe9ba0a804b8f0b63674b745c8fc5fb
