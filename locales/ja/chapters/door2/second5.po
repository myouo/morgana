msgid "⟪k:0⟫............"
msgstr "⟪k:0⟫…………。"

#: scenario2:scenario2_14B4EFA8_4CDC_4E77_9678_C64085275876
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 57f39dd3513c61e76bf8209f95bf6740bbcf1e3e220417f4f1fa104e14a322db
