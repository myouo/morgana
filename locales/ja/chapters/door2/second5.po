msgid "⟪k:0⟫(If God guides us—)"
msgstr "⟪k:0⟫（神の導きがあるというのなら――）"

#: scenario2:scenario2_199A37CC_E988_4B72_800C_A64861EC0549
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 85ace99b685fcb6a23676892a54fa836761d3a9abf5d1da0580b6617f66cd5f4
