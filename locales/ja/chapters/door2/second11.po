msgid "⟪k:0⟫⟪k:1⟫Heh... ⟪k:2⟫hahaha."
msgstr "⟪k:0⟫⟪k:1⟫いやあ……、⟪k:2⟫ははは。"

#: scenario2:scenario2_80C3940B_11E4_4E06_9951_89B2F8319147
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 16f6fa85e2856c7655193ab4aa2994f391bcfe4b6ea4bf5a5c712da42f110232
