msgid "⟪k:0⟫⟪k:1⟫⟪k:2⟫I’m a huge fan of this country’s food."
msgstr "⟪k:0⟫⟪k:1⟫⟪k:2⟫私はこの国の味が気に入ってねえ。"

#: scenario2:scenario2_1DD2EEC4_9504_480C_A032_69636D6B850E
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: a1d1ddcc28ad416f576cc432a06c5030fe9b35f809e110815454333854a7d7ee
