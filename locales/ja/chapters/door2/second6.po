msgctxt "scenario2:scenario2_5FDA6BE2_1924_4963_BEDA_BF537EC984FF"
msgid "⟪k:0⟫(I ⟪k:1⟫enjoyed⟪k:2⟫ it.)"
msgstr "⟪k:0⟫（おれは……楽しんでいた）"

#: scenario2:scenario2_13329D0F_E001_4658_8979_1CED36B9A9DC
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 5b671ac47eadd9d7828aa9ea4f2082714d2dc9243e99ebaa98174d7985605943
#. default-sha256: b6c529ed295193d7129bb0f843fbe36f7826363313039a2649a60c3ae1f309f1
msgctxt "scenario2:scenario2_13329D0F_E001_4658_8979_1CED36B9A9DC"
msgid "⟪k:0⟫(I basked in their terror.)"
msgstr "⟪k:0⟫（恐怖を、⟪k:1⟫楽しんでいた）"

#: scenario2:scenario2_CF810AEE_F1A6_4B2C_8B58_3FFE098C534E
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 77845116c86785f1bf41e89d575dce041279dcef7ef566e90e00eb86b3b1a303
#. default-sha256: 68635a3809dfcd677c6e1e9555d4147779414958c9e87f8cfbbccd6a5786bb9c
msgctxt "scenario2:scenario2_CF810AEE_F1A6_4B2C_8B58_3FFE098C534E"
msgid "⟪k:0⟫(So why... ⟪k:1⟫Why do I not want you to find out?)"
msgstr "⟪k:0⟫（それなのに……どうして……⟪k:1⟫知られたくないなどと、⟪k:2⟫思うのだ）"

#: scenario2:scenario2_B9787E55_09F7_40B2_B99F_E1824044313A
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: e6790791e6bd8de2e1298f36d7b1b5abccd2abd946900fb23b3b4f0112f35635
#. default-sha256: 8f2df2e8ee3681ff48d2c7cb5b2d2e1ea2af64a1b61d4a78b67b7326ec77244b
msgctxt "scenario2:scenario2_B9787E55_09F7_40B2_B99F_E1824044313A"
msgid ""
"⟪k:0⟫(I don’t want you to know how many people I’ve tortured,⟪k:1⟫how many I’ve slaughtered, how "
"much blood I’ve imbibed...)"
msgstr "⟪k:0⟫（そうだ、⟪k:1⟫知られたくない……⟪k:2⟫おれが何人も殺め、⟪k:3⟫殺し、⟪k:4⟫生き血を啜り……）"

#: scenario2:scenario2_FF7D2F93_0EE1_4904_82BC_CFBF1E4C29EF
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 397f3e29948732815cb1d3d6fe5b3f7c87b19dc9289c9475dd580ad7fc323c40
#. default-sha256: 18e2dc0dc70fad4c03f95a98c5b3804afd5644c35056d166a7316c42bd4c6c8c
msgctxt "scenario2:scenario2_FF7D2F93_0EE1_4904_82BC_CFBF1E4C29EF"
msgid "⟪k:0⟫(all the horrible things I’ve done.)"
msgstr "⟪k:0⟫（どれほどひどい振る舞いを続けてきたのか）"

#: scenario2:scenario2_0A61BE1F_38C0_4EDA_BF3F_E5B5FACFAD54
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 756e95b665959ec54d7f3ec6361e3e6f863b3a5a81bb901309488b9a79bab3d3
#. default-sha256: a401ad5d69956d189b34beaa1a48cc31bc75a57651de36e56884bd88d799cd0f
msgctxt "scenario2:scenario2_0A61BE1F_38C0_4EDA_BF3F_E5B5FACFAD54"
msgid "⟪k:0⟫(“Horrible”? I’m ⟪k:1⟫aware⟪k:2⟫ that what I’ve done is wrong?)"
msgstr "⟪k:0⟫（ひどい――、⟪k:1⟫ひどい？　⟪k:2⟫自覚があるのか、⟪k:3⟫おれは）"

#: scenario2:scenario2_215A2D46_B2AB_4C00_8D11_BCA5D5A8AF86
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 81255ae9055eacd4465d27b2dcd4dfdfea83ac98e3dcb341b5e487e3f7ec6c39
#. default-sha256: ec7d4a269257984b2f7c17cd87e4fa9c68d1e35f42b42c23c39c973ff81ee076
msgctxt "scenario2:scenario2_215A2D46_B2AB_4C00_8D11_BCA5D5A8AF86"
msgid "⟪k:0⟫(But I relished in it...)"
msgstr "⟪k:0⟫（おれは喜んでいたじゃないか………）"

#: scenario2:scenario2_B81F4DF4_2CAE_4BFB_9662_057572CF1458
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 0d26ab92c6690d70e7b958bbdfda9bc9eb1d97119dc8e281b536a569849f857c
#. default-sha256: 3b87c89da3ef37632960aa2379c0811ef7c20ccee0adca183b23ee38d4a71503
msgctxt "scenario2:scenario2_B81F4DF4_2CAE_4BFB_9662_057572CF1458"
msgid "⟪k:0⟫(I wanted... ⟪k:1⟫for so long... ⟪k:2⟫to slaughter them...)"
msgstr "⟪k:0⟫（ずっと………⟪k:1⟫殺してやりたかったんだ………）"

#: scenario2:scenario2_5AA9AE97_F7A2_4AFA_A2FD_3B7BBDA70572
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 9815cfedf48a03a591a888bc4a95e88082e7847efbc71fd4e193480e4949438b
#. default-sha256: 10e0c9a12c35c9f5f9551b62c72fd4c9a96d7211582ed6e32a4d1e435bb78ebb
msgctxt "scenario2:scenario2_5AA9AE97_F7A2_4AFA_A2FD_3B7BBDA70572"
msgid "⟪k:0⟫(I desperately desired to see blood—⟪k:1⟫⟪k:2⟫human blood...)"
msgstr "⟪k:0⟫（人間の血が見たくてたまらなかったんだ………）"

#: scenario2:scenario2_D48F470C_5E20_4CC0_84F6_388845B1A72F
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: ec2653c940256dd27cce7f95ccbf9e6cacf9781b047bff269aa55ac0c28e895e
#. default-sha256: e7360dc2b7b980eebcadfcdb93dcf72e960b381bbc3bf7760c5c9c83d79f60ea
msgctxt "scenario2:scenario2_D48F470C_5E20_4CC0_84F6_388845B1A72F"
msgid "⟪k:0⟫(What is it I crave? Murder? Or laughter?)"
msgstr "⟪k:0⟫（おれは何なのだ？　⟪k:1⟫殺したいのだろう？　⟪k:2⟫笑いたいのだろう？）"

#: scenario2:scenario2_47464B74_3291_424D_B8E6_799F589CED24
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: ec23d46c63d6dbc26c4707bbdab26cd668b71b394212793ba3d1e777650f8881
#. default-sha256: d43745893b68fe40a76a282c2b8c1eb8e67b04ff3b3f5c4e4a0371c7c8e620c0
msgctxt "scenario2:scenario2_47464B74_3291_424D_B8E6_799F589CED24"
msgid "⟪k:0⟫(I said... ⟪k:1⟫that I had no need for peace, yet here I am...)"
msgstr "⟪k:0⟫（平穏など、⟪k:1⟫おれに必要なものではなかったと――言ったのに）"

#: scenario2:scenario2_8994C00C_0D88_487E_804B_8DE5B11C8C54
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 6d3a95dcd474ddb62f95a4d7b7e71ea39a1d690d81832182dd2a576b54f55940
#. default-sha256: 10537a367935683173499c3d015754f2a8878492c9beecf4193fa0c98229e580
msgctxt "scenario2:scenario2_8994C00C_0D88_487E_804B_8DE5B11C8C54"
msgid "⟪k:0⟫⟪k:1⟫Is something the matter?"
msgstr "⟪k:0⟫⟪k:1⟫………どうしたんです？ "

#: scenario2:scenario2_D01C2A63_1F68_4FAA_A4F0_1AF90DC52647
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 5738346bba1ea7b9277f4a21ffa87dc85757a9e032dab0cc629141d47cd58563
