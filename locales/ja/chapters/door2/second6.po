msgid "⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫⟪k:4⟫⟪k:5⟫⟪k:6⟫⟪k:7⟫............"
msgstr "⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫⟪k:4⟫⟪k:5⟫⟪k:6⟫⟪k:7⟫…………。"

#: scenario2:scenario2_BCBD67FC_A76D_41C8_85A8_CB3C53F9EF2D
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: c5d75a2eb70c74ed2b49450420068321e387458532ccb9f29ebeaa997b73cf6d
#. default-sha256: 164a2b5e286307065258f2addd1f4e137a1cd43795199ec33f28209e334dcec6
msgctxt "scenario2:scenario2_BCBD67FC_A76D_41C8_85A8_CB3C53F9EF2D"
msgid "⟪k:0⟫⟪k:1⟫...What is the matter?"
msgstr "⟪k:0⟫⟪k:1⟫…………どうしたんですか？ "

#: scenario2:scenario2_B5BD6D06_AAF2_49FD_BAD8_8B3BA4A5AD55
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: e6a277e994cc642cb278fdbe1bc607366812a706c23c5715eed0d72ebcb9fae8
#. default-sha256: 85de884f18f156c648b5098268b2f1158e539662769b580c127d65cbe6436e82
msgctxt "scenario2:scenario2_B5BD6D06_AAF2_49FD_BAD8_8B3BA4A5AD55"
msgid "⟪k:0⟫⟪k:1⟫Do you honestly not fear me?"
msgstr "⟪k:0⟫⟪k:1⟫おまえ………、⟪k:2⟫本当におれを恐れないのか。"

#: scenario2:scenario2_FB16E62F_6D73_4768_AC4F_888E6DAFFCCD
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: cc5834d79322a28dfe6ac6a61429a2c2a75c130793bbbcc43a1f880d3c008fd4
#. default-sha256: bd5b2993e0a3d2b9e15ebdaeb0faf56edbd2b990063770cad357d4d6600dc6a5
msgctxt "scenario2:scenario2_FB16E62F_6D73_4768_AC4F_888E6DAFFCCD"
msgid "⟪k:0⟫⟪k:1⟫Do I appear to be afraid of you?"
msgstr "⟪k:0⟫⟪k:1⟫私があなたを恐れているように見えるのですか？ "

#: scenario2:scenario2_819774A8_0F00_452F_8CA5_49691425E1DE
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 7948ed16d8082ab00d9a1e5433524e8878ea220c9d4489378360e23b8eace994
#. default-sha256: f70f346454bc8003d6a477484a47feddf0e3ba670f487fa90741191fecefb37d
msgctxt "scenario2:scenario2_819774A8_0F00_452F_8CA5_49691425E1DE"
msgid "⟪k:0⟫⟪k:1⟫No... ⟪k:2⟫y-⟪k:3⟫you do not."
msgstr "⟪k:0⟫⟪k:1⟫いや………。⟪k:2⟫み、⟪k:3⟫みえない。"

#: scenario2:scenario2_FA13F74E_6111_4089_8272_900D124FD583
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: e1f3ebebcaf85443677725ab0ddb7161a67fecd2d13b6f2690f8acc974c6d67d
#. default-sha256: ae68de3c267c5fb0e2b49b071bab8a160ce3a6cb93945c4e3d4437f7c5d83fc5
msgctxt "scenario2:scenario2_FA13F74E_6111_4089_8272_900D124FD583"
msgid ""
"⟪k:0⟫(But you ⟪k:1⟫would⟪k:2⟫. ⟪k:3⟫If you could see me,⟪k:4⟫you would react the same as everyone "
"else.⟪k:5⟫⟪k:6⟫You would mock me; ⟪k:7⟫you would despise me;⟪k:8⟫you would want to kill me.)"
msgstr ""
"⟪k:0⟫（だが……、⟪k:1⟫恐れるはずなんだ。⟪k:2⟫おれの姿を見たら、⟪k:3⟫他の奴らと同じになる。⟪k:4⟫おれ"
"を蔑み、⟪k:5⟫憎み、⟪k:6⟫殺したいと思うはずだ）"

#: scenario2:scenario2_ADED7667_51B0_42A8_966B_728429B71DF1
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 161ade351db8f589e0b1e33e587011cdb4a0d346b266e6a72ce06de8aac65bb1
#. default-sha256: fe41ecc1cd241431bae43de5ed9a6d57863c3be1d2b28ab287f18e75330eab7a
msgctxt "scenario2:scenario2_ADED7667_51B0_42A8_966B_728429B71DF1"
msgid "⟪k:0⟫(You don’t know what I’ve done, because you can’t see.)"
msgstr "⟪k:0⟫（目が見えないから……おれが何をしてきたのか、⟪k:1⟫分かっていないのだ）"

#: scenario2:scenario2_5FDA6BE2_1924_4963_BEDA_BF537EC984FF
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 1e7a5885b69acfc815768d38e88237edc75f549e777795a5f7a5324124a5f180
