msgid "⟪k:0⟫⟪k:1⟫No, ⟪k:2⟫uh, ⟪k:3⟫some tea..."
msgstr "⟪k:0⟫⟪k:1⟫いや、⟪k:2⟫茶を………"

#: scenario2:scenario2_EC7C9912_7445_4D8E_B611_A08CA62ACB9D
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 3505a928efc36805fde466267b2e8cfb1641778f13f56c0b06aae3de18bcb20e
#. default-sha256: f0077e4cc80c96b251282fde15ebf1d185091e6c410e3ab61f4a5485a1d6df0b
msgctxt "scenario2:scenario2_EC7C9912_7445_4D8E_B611_A08CA62ACB9D"
