msgid "⟪k:0⟫I must satisfy these ⟪k:1⟫urges⟪k:2⟫!"
msgstr "⟪k:0⟫おれを満たすものが必要なんだァァァ……！"

#: scenario2:scenario2_3658F769_8C7F_480E_A8E0_F7FA9C5DE928
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 9c18bea5b483bb0d5ec6ed4a8112b3afc7c968e15c58c7519746b911ffd49651
