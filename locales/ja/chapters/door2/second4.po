msgctxt "scenario2:scenario2_F3463257_B8F0_4A65_9B30_63C2DAA67D32"
msgid "⟪k:0⟫I was quite disappointed."
msgstr "⟪k:0⟫わたくし……⟪k:1⟫悲しかったですわ。"

