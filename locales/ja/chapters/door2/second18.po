msgctxt "scenario2:scenario2_03D04C05_B7DF_4E7B_A9FB_9B8158470996"
msgid "⟪k:0⟫What a tragic man."
msgstr "⟪k:0⟫それにしても、⟪k:1⟫何て………"

#: scenario2:scenario2_C5845D39_5F76_4715_86EA_9803C2B8290F
