msgctxt "scenario2:scenario2_DB158C2D_F0EB_422E_947E_27340295256D"
msgid "⟪k:0⟫It could not be unraveled."
msgstr "⟪k:0⟫もう、⟪k:1⟫ほどけないくらいに……。"

#: scenario2:scenario2_AFFE18EE_446C_4D74_A03A_DE5918DD6093
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: af91e52631c27850b874935069efbcd734e09d25ed6405bdee1220a6beec7cc4
