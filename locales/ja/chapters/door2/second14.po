msgctxt "scenario2:scenario2_BAD9CECE_2467_4392_A237_3083253B13FA"
msgid "⟪k:0⟫Which means that, yes..."
msgstr "⟪k:0⟫ええ、⟪k:1⟫ですから―――"

#: scenario2:scenario2_106E860A_A5CC_4547_82EE_632DB286BF3C
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 50dad5af5638036c50c037bd409ba59839f91dba0eb0caa0f0185edf815069c4
#. default-sha256: 4ee5c390fa6822c70665aed9877809c69d16dd55ce909deda74bd6f16621d6c2
msgctxt "scenario2:scenario2_106E860A_A5CC_4547_82EE_632DB286BF3C"
msgid "⟪k:0⟫her fate was set in stone well before you ever saw it."
msgstr "⟪k:0⟫すべては始まりの方で、⟪k:1⟫決まっていたことなのです。"

#: scenario2:scenario2_874CF45D_CA2E_46BD_A676_AFE0AB026104
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 37cd39e841a9aa982c11791f4ea885b8bd21c03004844bb8908a3c271b26e975
