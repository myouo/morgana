msgid "⟪k:0⟫⟪k:1⟫Hehehe..."
msgstr "⟪k:0⟫⟪k:1⟫……ふふっ……。"

#: scenario8:scenario8_B77B9324_C68A_4471_972E_2BC1BEA37683
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 21879c69ac2874849a451268994f98ccea90c1876ec3191643ac40637967d986
