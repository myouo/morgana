msgid "⟪k:0⟫⟪k:1⟫⟪k:2⟫Nellie..."
msgstr "⟪k:0⟫⟪k:1⟫⟪k:2⟫ネリー……。"

#: scenario8:scenario8_4628AC94_86B1_412F_AF1B_3E7270C71B3D
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 1dee38aa38602dd0238d8ac0a8d7a7f9ec0cbb8f9a958c07799044d0c19d3907
