msgid "⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫............"
msgstr "⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫…………。"

#: scenario8:scenario8_E681D104_B68C_446D_B5FE_E46E6C1477B6
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: c8efa1fbff9f3b0df980b2e3790d6614177b6169aeb2bef6cf223e24b10f2048
#. default-sha256: e14be5fa21b6847ff314a7e48692c455a67876a3154b8f40a8026b96e2f38472
