msgctxt "scenario8:scenario8_B6DAF2C0_14E5_41D0_9248_6F5891F8439C"
msgid "⟪k:0⟫⟪k:1⟫Wha— ⟪k:2⟫⟪k:3⟫You’re... ⟪k:4⟫going to cook it?"
msgstr "⟪k:0⟫⟪k:1⟫えっ……、⟪k:2⟫この子……料理にしちゃうの？"

#: scenario8:scenario8_46FE45DB_48F9_4B11_A5B7_E9CFA7AAD163
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 369f26b9ff899df1c23875bb50acc397fa4938d5a5f6b08eb397fb9d8fa1be17
