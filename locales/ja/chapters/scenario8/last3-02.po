msgctxt "scenario8:scenario8_BA468D70_3326_41B2_B93D_17BDBE2EAD12"
msgid "⟪k:0⟫⟪k:1⟫............"
msgstr "⟪k:0⟫⟪k:1⟫…………。"

#: scenario8:scenario8_3C079421_56E1_4F15_93A3_DA796E86F4D7
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 2a27082eb9494f097fa7a53fc0a57891b3e3a5a9d6d7543dc49cf9fb398f6125
