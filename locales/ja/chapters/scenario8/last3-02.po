msgid "⟪k:0⟫⟪k:1⟫⟪k:2⟫...O-⟪k:3⟫Okay."
msgstr "⟪k:0⟫⟪k:1⟫⟪k:2⟫………う、⟪k:3⟫うん。"

#: scenario8:scenario8_E3CEB4C4_51B4_4C52_A66E_756397078185
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 08ba5fcdf98242d3ac29acd64516a10e7dcc249203913ccbb43d1209a9566160
#. default-sha256: 88975e899feed3b45f3aecafcd8be663cf3d04bf723684cb3ae89e29ae44c3f9
msgctxt "scenario8:scenario8_E3CEB4C4_51B4_4C52_A66E_756397078185"
msgid "⟪k:0⟫The chefs back home always took care of it."
msgstr "⟪k:0⟫……いつもは料理人がやってくれてたし。"

#: scenario8:scenario8_3737D91C_677F_4BC1_BCC4_B8F5346B51B4
