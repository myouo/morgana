msgid "⟪k:0⟫⟪k:1⟫It was picturesque."
msgstr "⟪k:0⟫⟪k:1⟫絵に描いたような毎日さ。"

#: scenario8:scenario8_E40F536E_2011_4E5B_8A02_79D40DFD0443
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 9ac45feca8feab57f40beacfd8dafc2c81eeed349e848745122474d049e5f3f6
#. default-sha256: 4291938ae09695f850ffed0b6055056274cf53a004606cae092cb0e0f30a7f63
msgctxt "scenario8:scenario8_E40F536E_2011_4E5B_8A02_79D40DFD0443"
msgid "⟪k:0⟫⟪k:1⟫And you were always there with me."
msgstr "⟪k:0⟫⟪k:1⟫そして、そう、隣にはいつも君がいたね。"

#: scenario8:scenario8_DC2B4A05_1531_4721_B9A6_AB21828E1C77
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: e9e402a17a4f1e7ea6f223f0dd5745be14b80f485fe8388f691772e4b6f7779f
