msgid "⟪k:0⟫⟪k:1⟫Understand each other?"
msgstr "⟪k:0⟫⟪k:1⟫……共感？　⟪k:2⟫あなたと……？"

#: scenario8:scenario8_29559203_2011_43F1_94B7_17B03A94B8D6
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 1fd9b89b899041d7fc3ba4dc453c3abb0853ad00dabbc98aac036d198554d48f
