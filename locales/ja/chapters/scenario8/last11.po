msgid "⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫............with me..."
msgstr "⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫…………て、⟪k:4⟫ください………。"

#: scenario8:scenario8_31362096_C7AE_4CF9_A254_0B4A302A014A
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 75c1da386dfcad5617482ca04e3887716d85aa698fa7249f32e533e8e7e07bde
#. default-sha256: 8925f60930b6fe2bbefd14ad8bc3eb811174ff1fc791687813f096ba96d50f34
msgctxt "scenario8:scenario8_31362096_C7AE_4CF9_A254_0B4A302A014A"
msgid "⟪k:0⟫Come on..."
msgstr "⟪k:0⟫……ねえ……。"

#: scenario8:scenario8_676F36FE_D222_4CE8_AD37_C5209D73A750
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: ad685cecbe4c4604ff9c5246b8a9a07e296b302db6cbb4d5a506eff950fd4220
#. default-sha256: d570a87ac64e27792617c330700d19bc580c3aa6d1be9206c4e9ce93bf46452a
msgctxt "scenario8:scenario8_676F36FE_D222_4CE8_AD37_C5209D73A750"
msgid "⟪k:0⟫⟪k:1⟫............"
msgstr "⟪k:0⟫⟪k:1⟫…………。"

#: scenario8:scenario8_3B4BE779_C9C7_482C_A89E_5FF6CDF9661D
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: ee6ad204d56dd840bb489ef9716de2b4858a5f3f9064e44fe5313343b479b656
#. default-sha256: 68cd8e60d6405eb03399b1eb1dac0bcf49b5a612d6935005b588cf33df154187
msgctxt "scenario8:scenario8_3B4BE779_C9C7_482C_A89E_5FF6CDF9661D"
msgid "⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫Do you guys hear... ⟪k:4⟫talking... ⟪k:5⟫behind the door?"
msgstr "⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫ねえ……、⟪k:4⟫なんか、⟪k:5⟫扉の奥から……声がしない？"

#: scenario8:scenario8_52A585C6_D183_4D44_9B87_E24EC8892F9F
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: a3f66ad128b36a239ed7771228ed1841bc2a5941db67008c62eb04b7f073307f
#. default-sha256: 20d15f4e3c15c31dec4de9d36af2cd1644da9d446169ec61a2c3aa0859ba8fb8
msgctxt "scenario8:scenario8_52A585C6_D183_4D44_9B87_E24EC8892F9F"
msgid "⟪k:0⟫⟪k:1⟫⟪k:2⟫...Is there someone else in there with her?"
msgstr "⟪k:0⟫⟪k:1⟫⟪k:2⟫……他に誰かがいるのか……？"

#: scenario8:scenario8_8FE029FB_D592_49EB_9D67_18DFF2710A8C
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: f66da21ca5bfa1a39f3355dfb7b6d970527f83a513f90af92957f759ec28d9d0
#. default-sha256: 3caa15a59e54671f7721352eac7a5b7a5325cf5f64b16a2e39c090d556f88923
msgctxt "scenario8:scenario8_8FE029FB_D592_49EB_9D67_18DFF2710A8C"
msgid "⟪k:0⟫⟪k:1⟫⟪k:2⟫There couldn’t be. It’s only Morgana."
msgstr "⟪k:0⟫⟪k:1⟫⟪k:2⟫……そんなはずはなかろう、⟪k:3⟫中にいるのはモルガーナだけだ……。"

#: scenario8:scenario8_90CC1DC7_EBA9_415C_975A_E1CCEC9571C7
