msgid "⟪k:0⟫⟪k:1⟫............"
msgstr "⟪k:0⟫⟪k:1⟫…………。"

#: scenario8:scenario8_CA21102A_AA1A_4425_BEA0_0896B9F5B5C4
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 21ec3367a6d62cd28c177f513c4a693e59465fcce77e69060d79ed615f9cf281
