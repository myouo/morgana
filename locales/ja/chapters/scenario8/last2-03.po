msgctxt "scenario8:scenario8_6971D90D_6A3C_4F04_901C_F6B27FFBCE89"
msgid "⟪k:0⟫⟪k:1⟫⟪k:2⟫...Ah... ⟪k:3⟫r-⟪k:4⟫right... ⟪k:5⟫it was..."
msgstr "⟪k:0⟫⟪k:1⟫⟪k:2⟫……あ……、⟪k:3⟫そ、⟪k:4⟫そう……でしたね……。"

#: scenario8:scenario8_AF506607_D9DD_4D8A_BA11_5EC5B392ADF7
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: d477d1a02a9347c82a1914f8771b97a8010657c35b6a91f2b466c6156c37fbff
#. default-sha256: 151b23186e8082b3c329fbbff93aa7932e9b437670b747359199f3b11d79c8b5
msgctxt "scenario8:scenario8_AF506607_D9DD_4D8A_BA11_5EC5B392ADF7"
msgid "⟪k:0⟫⟪k:1⟫⟪k:2⟫...Hmm?"
msgstr "⟪k:0⟫⟪k:1⟫⟪k:2⟫え………？"

#: scenario8:scenario8_F480A4C3_8233_4415_B4ED_CE9DAD21C337
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 455535952d09af05ea878e1efe0e0d8df003c401e0cd033d83f4f82463a647c0
#. default-sha256: d15846f9794519005c442ed2149a1ac742f007125989cd667ca95d6bf4a20a32
msgctxt "scenario8:scenario8_F480A4C3_8233_4415_B4ED_CE9DAD21C337"
msgid "⟪k:0⟫⟪k:1⟫⟪k:2⟫No need to apologize for the truth."
msgstr "⟪k:0⟫⟪k:1⟫⟪k:2⟫事実ですから、⟪k:3⟫謝ることじゃないですって。⟪k:4⟫⟪k:5⟫それに、⟪k:6⟫ほら――"

#: scenario8:scenario8_F6ACCCD6_9C77_43C8_9909_208AA8649AA1
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 5a80382c4c0d6e472f1675f2e456984914f80b790c32b8c415073f408bbd9808
#. default-sha256: 5852fe3f5ca19e7148edbe2be19ee571fb2162586095f70f65af1b3aa42aa266
msgctxt "scenario8:scenario8_F6ACCCD6_9C77_43C8_9909_208AA8649AA1"
msgid "⟪k:0⟫(And today, you’re the fire to my oil.)"
msgstr "⟪k:0⟫（今、⟪k:1⟫さらっとひどいことを言われた気が……）"

