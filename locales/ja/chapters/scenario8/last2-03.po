msgid "⟪k:0⟫⟪k:1⟫⟪k:2⟫I..."
msgstr "⟪k:0⟫⟪k:1⟫⟪k:2⟫私は………。"

#: scenario8:scenario8_2F9ACABB_618D_4FCC_B73F_5C46346069BB
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 9ba563a759188fe6988ef686aeea5d9624ae40e6df868d99c5f39da3360c35ec
