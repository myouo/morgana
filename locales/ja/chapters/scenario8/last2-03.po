msgctxt "scenario8:scenario8_95D11894_E9D5_4C48_887C_518C2C448366"
msgid "⟪k:0⟫⟪k:1⟫............"
msgstr "⟪k:0⟫⟪k:1⟫…………。"

#: scenario8:scenario8_6971D90D_6A3C_4F04_901C_F6B27FFBCE89
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 684ea536d74779fca31b679548734aad258675d7b32eba10dfd1cda72d02caaf
