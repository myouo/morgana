msgctxt "scenario8:scenario8_65A49D97_4226_44D1_B2E7_9F913841121F"
msgid "⟪k:0⟫⟪k:1⟫⟪k:2⟫............"
msgstr "⟪k:0⟫⟪k:1⟫⟪k:2⟫…………。"

#: scenario8:scenario8_D96F361C_877C_4409_8093_134A7AFA2081
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: f7860dc999b462df0de0d4e8d2943c367937db59d3f0d4879df911a0f3f8b67c
