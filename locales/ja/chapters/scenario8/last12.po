#: scenario8:scenario8_AED42863_A424_4B04_8542_1D46FD5715DA
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: d5f67a778fc1961cf106992cf786682ca8263c295c6b54e7b5346a86f36d7fdc
#. default-sha256: 2d9e5fbb5d698a486f09ea40175d2a0ee17ea23568d774b3b094af71afce6ea3
msgctxt "scenario8:scenario8_AED42863_A424_4B04_8542_1D46FD5715DA"
msgid "⟪k:0⟫⟪k:1⟫He opens the door, heading the four-man procession out of the tower, as he had in."
msgstr ""
"⟪k:0⟫⟪k:1⟫物見の塔の扉は……彼が、⟪k:2⟫押し開いた。⟪k:3⟫⟪k:4⟫最初のように、⟪k:5⟫彼が先導をし――"

#: scenario8:scenario8_C1DB5E46_FA01_4DD6_8F5E_004447434A7E
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 8af32fc6999ac2fdb266308226c2db2db8baa7301d51d063d113083b0b93cead
#. default-sha256: 09085ffad01199db7b4746d2b6d17084cf0dcd3e140f464ca1b0211dce94a515
msgctxt "scenario8:scenario8_C1DB5E46_FA01_4DD6_8F5E_004447434A7E"
msgid "⟪k:0⟫I walk at the back of the line."
msgstr "⟪k:0⟫私は、⟪k:1⟫最後を歩んだ。"

#: scenario8:scenario8_B95A895B_0AE5_4A8E_B7B5_384C42CA534F
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: c03a4a39544beb73b27f237f654fedb31265b14a1adcc2e1c2515d95641f8ea5
#. default-sha256: 4cd616d8333fa6ed510a94f4ccf739eb720e3ad55d5f522487059a3bdd290357
msgctxt "scenario8:scenario8_B95A895B_0AE5_4A8E_B7B5_384C42CA534F"
msgid ""
"⟪k:0⟫Each step they take down the spiral staircase is slow and ponderous,⟪k:1⟫⟪k:2⟫as if weighted "
"down by the knowledge of their sins."
msgstr "⟪k:0⟫らせん階段を下る我々の足音は、⟪k:1⟫とても重く――⟪k:2⟫⟪k:3⟫罪の重責が、⟪k:4⟫漂っていた。"

#: scenario8:scenario8_BEE19C25_4387_4098_BC3E_91D6906BBC5A
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 67a7e582ff1eae755eb64b48595b213b920b646085e9c16ec76cb1e2f197e5a5
#. default-sha256: 85ec481819072cfebabbead65004ed725f0308efb6ad3ba053f033c1a1c1fc1c
msgctxt "scenario8:scenario8_BEE19C25_4387_4098_BC3E_91D6906BBC5A"
msgid "⟪k:0⟫That they must make their way..."
msgstr "⟪k:0⟫……贖罪の場に――"

#: scenario8:scenario8_C4712DCB_C162_4710_879A_2EEF4DA9452E
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 7af15be45ffe84cdf7baeb5f913c61249a4dc650a1fa2f24cf9c76a1bfc80e03
#. default-sha256: d329422d149e52c1868451dcded3dca51ffbfe110dd7086fd379329832d02584
msgctxt "scenario8:scenario8_C4712DCB_C162_4710_879A_2EEF4DA9452E"
msgid "⟪k:0⟫to the place they will make their atonement."
msgstr "⟪k:0⟫向かわねばならない……。"

#: scenario8:scenario8_C16EBD60_51C9_4BC5_8094_E87636C13BEB
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 3419e7bb6a5c3945cc25d6ac2f1589b1d41f7d6e8bc0007cec0a8930dd47d33b
#. default-sha256: 799a291d3ac068527770019a03bf893d8a641d5a6e78ac1ac1fe1121ce9a5429
msgctxt "scenario8:scenario8_C16EBD60_51C9_4BC5_8094_E87636C13BEB"
msgid "⟪k:0⟫⟪k:1⟫I wasn’t able to prevent Morgana’s death,"
msgstr "⟪k:0⟫⟪k:1⟫モルガーナの死は、⟪k:2⟫覆せなかった。"

#: scenario8:scenario8_5936BA73_B67E_4639_9327_7606198B04B6
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: f6f06695d5484e9d0928c9a06d32ca1282e754a8fe59477bc0406ea6bc0dd5f6
#. default-sha256: e966ef4c87b7a145ad7ad095bd9d111e84e9910a22ca7c9f2a70abc1e3d7b624
msgctxt "scenario8:scenario8_5936BA73_B67E_4639_9327_7606198B04B6"
msgid "⟪k:0⟫but I ⟪k:1⟫was⟪k:2⟫ able to uncover the truth."
msgstr "⟪k:0⟫けれど……、⟪k:1⟫私は本当の真実を明らかにした。"

#: scenario8:scenario8_423170AA_9BC6_400F_8FD8_60750E032EA6
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 8bff57aacc5ba6442d85902c3c0a2de8cf214c0de3cf1dea71042b47a7de78fe
#. default-sha256: f7da2b51e5f8cc724135018abefc1179b5ca3e73cd99909b43b792ffd0cdb27d
msgctxt "scenario8:scenario8_423170AA_9BC6_400F_8FD8_60750E032EA6"
msgid "⟪k:0⟫I ⟪k:1⟫accomplished⟪k:2⟫ something."
msgstr "⟪k:0⟫私が変えたものも、⟪k:1⟫確かにあったはずだ……。"

#: scenario8:scenario8_9C6ECEBE_D077_4098_BD2B_1FA6B64D6C53
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: fd3a09efb2c8cf52d53eb90cd790d7190f1aeae05783ba74e82ae77f0d90bdde
#. default-sha256: 75ae450798873918c138540ab3dd958a9e098bbab0d7c1e1c3445218acf57827
msgctxt "scenario8:scenario8_9C6ECEBE_D077_4098_BD2B_1FA6B64D6C53"
msgid "⟪k:0⟫The sum of everything I did these three days..."
msgstr "⟪k:0⟫私の行動が……、⟪k:1⟫きっと……"

#: scenario8:scenario8_CB3C7978_9C00_4437_A359_E6D28E83A517
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 1e65f755f407e056b8ef77b0752175123457f26487b4649c0148eb81e2c7f12f
#. default-sha256: 3133a45ee984144f857f8a70c5a823ac885cd6272e5facce1e4bcfc4d49d5d9f
msgctxt "scenario8:scenario8_CB3C7978_9C00_4437_A359_E6D28E83A517"
msgid "⟪k:0⟫⟪k:1⟫should⟪k:2⟫ be enough to change her heart..."
msgstr "⟪k:0⟫彼女の認識を変え……、⟪k:1⟫そして――"

#: scenario8:scenario8_856665BF_C630_4CA9_AE54_B340A95F78B2
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 633343a2b41af424357182e2fe4b3b8da5eb78223403661bdbcf0a3a3699d467
#. default-sha256: 815286cce5a0e13aa077273bb6d2e77fde8975811bc873193a8bdfe8bdd00fb3
msgctxt "scenario8:scenario8_856665BF_C630_4CA9_AE54_B340A95F78B2"
msgid "⟪k:0⟫and change the course of their next lives."
msgstr "⟪k:0⟫彼らの来世を……変えたはずだ。"

#: scenario8:scenario8_F92CB0CC_84A8_4080_A3E0_B5194806340E
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 2eb928e447010db62f8e998cbc7b641012a604a98af8ff5c867772c74e9ee58a
#. default-sha256: fc639807d624ab76963922f3ef9a071572fa3d88a91b3b945f6a7d766fb714af
msgctxt "scenario8:scenario8_F92CB0CC_84A8_4080_A3E0_B5194806340E"
msgid "⟪k:0⟫They should be able to avoid the tragedies I witnessed through each of their doors."
msgstr "⟪k:0⟫私が見た悲劇は――、⟪k:1⟫起きないはずだ……。"

#: scenario8:scenario8_F93A566A_BD29_44BD_BE2A_8ED6A23FA60F
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 1dae8d382d1ae06554fe35b022a2d115c474432847f6f65f6dc1f243c38e703d
#. default-sha256: fa7d42b62a5e615a7af4fd074ec47c132b02adcab29565f837adbdab15ee7a0a
msgctxt "scenario8:scenario8_F93A566A_BD29_44BD_BE2A_8ED6A23FA60F"
msgid ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫⟪k:4⟫When we step through this door and people see Morgana’s body,⟪k:5⟫we’ll "
"be made to pay for our sins."
msgstr ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫⟪k:4⟫……この扉を開き、⟪k:5⟫モルガーナの死体を明らかにすれば――、⟪k:6⟫我々の罪も"
"問われることとなる。"

#: scenario8:scenario8_4E429D64_4256_4431_AEE5_082107636ABC
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 307680a0a59d743ee3cf433252bac4ecf6bfc6acd7c19d883a0abd2c0d3607ac
#. default-sha256: b6de0e5547243d8ed3c974aa46ee8548b35eee0046c663242dcc89b4dd50bd57
msgctxt "scenario8:scenario8_4E429D64_4256_4431_AEE5_082107636ABC"
msgid ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫Ultimately, I’m the one responsible,⟪k:3⟫⟪k:4⟫so the two of you are welcome to "
"stay behind..."
msgstr "⟪k:0⟫⟪k:1⟫⟪k:2⟫……首謀者は私だ。⟪k:3⟫お前たちは、⟪k:4⟫ここに残ってもいい……。"

#: scenario8:scenario8_A6C300C5_C8C4_4A4F_95DA_668A7568FA32
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: d363f753bce1d7969e3c48a1aec48bcff99c2be882776d722b028b3cf62d9622
#. default-sha256: 9591176e75a85283099dfee83db5fff3bcef3ddeeeef61b3d3870c4c339abee5
msgctxt "scenario8:scenario8_A6C300C5_C8C4_4A4F_95DA_668A7568FA32"
msgid ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫I’m coming with you.⟪k:3⟫⟪k:4⟫A girl died because of the things I did...⟪k:5⟫⟪k:6⟫"
"I can’t just pretend it didn’t have anything to do with me..."
msgstr ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫僕も……、⟪k:3⟫行くよ……。⟪k:4⟫ひとりの女の子を殺しておいて……⟪k:5⟫⟪k:6⟫もう見て見ぬ振"
"りなんて出来ない……。"

#: scenario8:scenario8_3D6F1818_603A_4F36_83E6_C18293AF930E
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 9f646f3c41d77e5cefc7ff19bc77c0a81503abd810ced88c26332d7b9541aca0
#. default-sha256: 2a5c7168c8fab70eaa43123306e931506c1da78f05faf438963ff55d13700182
msgctxt "scenario8:scenario8_3D6F1818_603A_4F36_83E6_C18293AF930E"
msgid "⟪k:0⟫⟪k:1⟫No, I don’t ⟪k:2⟫want⟪k:3⟫ to."
msgstr "⟪k:0⟫⟪k:1⟫いや……、⟪k:2⟫したくないんだ。"

#: scenario8:scenario8_0EC45386_CC26_4273_9642_877D8503B806
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 03409be0eaf9260f7621f992c0ae0d08bffb4bc74dc8fd9c27aa6eb54ba3edb5
#. default-sha256: cf734b3e32c51ac589468103f17c7518463f476aa086d910078e537926b50684
msgctxt "scenario8:scenario8_0EC45386_CC26_4273_9642_877D8503B806"
msgid ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫I never had any intention of fleeing.⟪k:3⟫⟪k:4⟫You may have been the one running "
"the operation,⟪k:5⟫but I did just as many terrible things as you."
msgstr ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫元より覚悟は決まっている。⟪k:3⟫首謀者がお前であろうと、⟪k:4⟫俺がやったことも同等に"
"外道だったと思うからな……。"

#: scenario8:scenario8_65A49D97_4226_44D1_B2E7_9F913841121F
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 4255dd8a7872b0771f7b21cdb0bcb58cea6b730b1ae857630d6162364d9d1df4
