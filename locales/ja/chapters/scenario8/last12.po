msgctxt "scenario8:scenario8_D96F361C_877C_4409_8093_134A7AFA2081"
msgid "⟪k:0⟫⟪k:1⟫Well then..."
msgstr "⟪k:0⟫⟪k:1⟫……そうか……。"

#: scenario8:scenario8_5DCA870D_5F4F_466E_8618_E250C3C08FE7
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 976e9cb265569d60b23bef80f430f70b2b38aed2bf26fed3ac946e55d3d3c7ff
#. default-sha256: d45d69d9732e19a70639458a48bb12b0e16ea7251aecef602e026ae8d3f2c594
msgctxt "scenario8:scenario8_5DCA870D_5F4F_466E_8618_E250C3C08FE7"
msgid "⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫⟪k:4⟫⟪k:5⟫............"
msgstr "⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫⟪k:4⟫⟪k:5⟫…………。"

#: scenario8:scenario8_02CA0422_0A08_4714_8645_26C09B263BDA
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 7460486137db76a79d27a6122e72affdc02b8bf1d4b2b4b3d3964334d24f1746
#. default-sha256: 7865c20a2fb6b481a112019cb650304d3a5dd2f23b9beb7f736dc3defb795404
msgctxt "scenario8:scenario8_02CA0422_0A08_4714_8645_26C09B263BDA"
msgid "⟪k:0⟫⟪k:1⟫...Say, ⟪k:2⟫uh, ⟪k:3⟫Michel?"
msgstr "⟪k:0⟫⟪k:1⟫………あのさ、⟪k:2⟫ミシェル。⟪k:3⟫ちょっと……いいかな。"

#: scenario8:scenario8_15D9F7C9_63B1_4D3F_9C17_4A1054182987
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 4cdbc91c2a98579c39d7686a72fbac446a285bebdec0ada1dfd50c2d186762ad
#. default-sha256: 7da336c8b35048e8843efe7bc20821722cd48691cc9c8dae21215af8bc229e96
msgctxt "scenario8:scenario8_15D9F7C9_63B1_4D3F_9C17_4A1054182987"
msgid "⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫Yes?"
msgstr "⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫………はい。"

#: scenario8:scenario8_0357EF2B_3EF5_4C3A_BAC0_D828E0C3AB1A
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 1988ccc1046fbc638a0886702e8f12c8c1b45420ba962de4bb04a1599f1d515d
#. default-sha256: 23c70b5ab2bb826013ba3c13e7f56d805b9d9e4315a3f91c0ec902b35ccf5853
msgctxt "scenario8:scenario8_0357EF2B_3EF5_4C3A_BAC0_D828E0C3AB1A"
msgid ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫I figure this is probably my last chance to say it,⟪k:3⟫⟪k:4⟫so... ⟪k:5⟫thank you "
"for convincing me to hand over my key."
msgstr ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫今じゃないと、⟪k:3⟫言えないと思うから。⟪k:4⟫⟪k:5⟫……僕から鍵を取ってくれて、⟪k:6⟫あ"
"りがとう……。"

#: scenario8:scenario8_FF87DF36_1317_4F06_B292_9C10C06315C2
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 9c2d5a8b49f38f3e03feb9f00f5b68f3cdd9ba9fb51f09d61fe5c8a7d33a6176
#. default-sha256: f69aebaf26fa5dbb096977215944a90689f8e91f0b9a3898e89a8ef3eebc5d1b
msgctxt "scenario8:scenario8_FF87DF36_1317_4F06_B292_9C10C06315C2"
msgid "⟪k:0⟫⟪k:1⟫For giving me the courage to open my eyes."
msgstr "⟪k:0⟫⟪k:1⟫僕に、⟪k:2⟫向き合う勇気を与えてくれて……。"

#: scenario8:scenario8_00F54393_691B_4C8B_9333_2734C66DD262
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 63013becbfd147a3dd6a0b776fd071a75f9b1173dafccd76d7c5d8297e2818c4
#. default-sha256: 26db89f4a94cd4902abe73babe7895081d9f87f34bf335cfc65f1bac25b352df
msgctxt "scenario8:scenario8_00F54393_691B_4C8B_9333_2734C66DD262"
msgid ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫You always had the courage within you, Mell.⟪k:4⟫⟪k:5⟫You simply needed a "
"little help finding it."
msgstr ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫それは……、⟪k:4⟫本来、⟪k:5⟫貴方が持っていたものだと思います。⟪k:6⟫⟪k:7⟫その一歩"
"が踏み出せず……、⟪k:8⟫目を背けてしまっただけで――"

#: scenario8:scenario8_8083C7A0_A13C_418B_BA18_0C5A13DB5AA0
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: cb0be41897334073cfff6abdf205e940ffe38e7aa9876dbbef6b09c7c4a4d9ac
#. default-sha256: aab7351016ae153dee82561325365ff562c09bfa164d99635932e36d054607cd
msgctxt "scenario8:scenario8_8083C7A0_A13C_418B_BA18_0C5A13DB5AA0"
msgid "⟪k:0⟫It wasn’t my strength that allowed you to take action,⟪k:1⟫but your own."
msgstr "⟪k:0⟫今……、⟪k:1⟫決断が出来たのは、⟪k:2⟫貴方の力です。"

#: scenario8:scenario8_473582DE_B5DC_4205_8803_8FB0FCD38B8E
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: d4800931f1907f7a6af47c4193e380d3bd63ec187349b9bdea34c664ae114ab6
#. default-sha256: d6a4697fe0a0761c20b80118a6cad4e988585666bef7388abef21021f35b2939
