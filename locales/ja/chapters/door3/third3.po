msgid "⟪k:0⟫⟪k:1⟫Your country?"
msgstr "⟪k:0⟫⟪k:1⟫国を……？"

#: scenario3:scenario3_E1EF9A59_4A8F_415D_A250_F06E12584AED
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
