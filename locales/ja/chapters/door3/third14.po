msgctxt "scenario3:scenario3_1535AF1C_3BFA_4B19_B085_573C6485B903"
msgid "⟪k:0⟫On the other hand, the payoff is fantastic."
msgstr "⟪k:0⟫でもまあ、⟪k:1⟫その分、⟪k:2⟫愉快な見返りがあるから――"

#: scenario3:scenario3_FD2D5706_0EA9_4127_A930_AC96782529F3
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 2c8fc61b7922afb1a9297597c131144705f0e7cfe4e144c18eb9174689c3230f
