msgid "⟪k:0⟫⟪k:1⟫Ugh. Sickening."
msgstr "⟪k:0⟫⟪k:1⟫やだもう気持ち悪い。"

#: scenario3:scenario3_1535AF1C_3BFA_4B19_B085_573C6485B903
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: de0bb1edb877f76264f48c8a829ff5a2337966644af5b0b6897153c59405ddad
