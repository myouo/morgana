#: scenario3:scenario3_D94E54B6_BEB8_42C3_911C_659E587625D6
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 4706ae9da52740e31a2ff76ac69b1b52040d1d6266ac490b5377f88b66359c16
#. default-sha256: 72d0b40f905822b48222636c764257630fcde78377626dda1441ad83f1aca5f2
msgctxt "scenario3:scenario3_D94E54B6_BEB8_42C3_911C_659E587625D6"
msgid "⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫⟪k:4⟫⟪k:5⟫⟪k:6⟫⟪k:7⟫⟪k:8⟫⟪k:9⟫...Jacopo?"
msgstr "⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫⟪k:4⟫⟪k:5⟫⟪k:6⟫⟪k:7⟫⟪k:8⟫⟪k:9⟫……ヤコポ……？"

#: scenario3:scenario3_2DF7179A_50DD_48A1_B9C4_D0C6B18EBD99
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 418e48f66bf6e7fff6cc85a582fa6e6516fcb455ae7f2a592fcf6f52e3f27ab1
#. default-sha256: ebb8dbe630102fe29ffc8cfa496d48a45ac16b09ec227bb87d16f6d95a2eafa9
msgctxt "scenario3:scenario3_2DF7179A_50DD_48A1_B9C4_D0C6B18EBD99"
msgid "⟪k:0⟫............"
msgstr "⟪k:0⟫…………。"

#: scenario3:scenario3_07C975E2_D356_4E7B_844A_489E8DC63ADD
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 2fca3f1474820f7332d4c3ada048e0c7c93683c57fb0aaca2caa7f3f5504737c
#. default-sha256: 0ee4fb05475f15b3a5e4773d933bccecdc15ede349df1c79081394bafa25aff8
msgctxt "scenario3:scenario3_07C975E2_D356_4E7B_844A_489E8DC63ADD"
msgid "⟪k:0⟫Where’s your dad?⟪k:1⟫⟪k:2⟫Or are you here alone?"
msgstr "⟪k:0⟫お父さんとかは？　⟪k:1⟫ひとりでここまで来たんだ？"

#: scenario3:scenario3_FB79E208_7D31_47CF_A0DA_ABBDAFA22C4F
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 2203b3571fe20c1afd12612b071290673d434eb06e914a54908c8a7146ccd196
#. default-sha256: eb438f9831ebfe385c2fc7e7123513164373fab8344f7170f6fa12f992a5ce33
msgctxt "scenario3:scenario3_FB79E208_7D31_47CF_A0DA_ABBDAFA22C4F"
msgid "⟪k:0⟫He... ⟪k:1⟫didn’t even tell me..."
msgstr "⟪k:0⟫親父は、⟪k:1⟫教えてくれなかったし……。"

#: scenario3:scenario3_6FE290DD_7AD9_4B2C_A50A_31C5965984F5
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 2865ec18c4c6620c9b4b513669d3d1bfcf4273c0222144bf769f71d8dbc6166a
#. default-sha256: 4f7d5cfe0fc3d71fd78dd606fb5c936d4df3f1710b319265ce099997960dd3d2
msgctxt "scenario3:scenario3_6FE290DD_7AD9_4B2C_A50A_31C5965984F5"
msgid "⟪k:0⟫Ah..."
msgstr "⟪k:0⟫そっかぁ……。"

#: scenario3:scenario3_CDA793AA_8C43_4FEC_9F5D_017005C93182
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 05bf8fc94574dcea9aeb162e44501173903ac3e66273d8be12148f8fd5babe17
#. default-sha256: ce1e18f681f40593f9af49f7f4f6eabaaa286d80317033a01cb6f67e36db0c06
msgctxt "scenario3:scenario3_CDA793AA_8C43_4FEC_9F5D_017005C93182"
msgid ""
"⟪k:0⟫There’s... ⟪k:1⟫no reason you have to leave town.⟪k:2⟫⟪k:3⟫My old man says the Campanellas "
"have more power."
msgstr ""
"⟪k:0⟫何も……、⟪k:1⟫君が街を出ていく必要はないじゃないか。⟪k:2⟫⟪k:3⟫この街で強いのは、⟪k:4⟫カンパ"
"ネッラの方だって親父も言ってたんだ。"

#: scenario3:scenario3_16A96EA9_EC19_443A_9899_DD960278A6BB
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: f113ebe90ef30756262b927a8792dda5b1c6033c083b708c5c36584265a43150
#. default-sha256: 2ea8c34fcbfc8a54111ac6e009016d6bfe7728bc9644026148f69f6efa4c2e1e
msgctxt "scenario3:scenario3_16A96EA9_EC19_443A_9899_DD960278A6BB"
msgid "⟪k:0⟫I should be the one leaving."
msgstr "⟪k:0⟫それなら、⟪k:1⟫出ていくのはぼくの方だろう。"

#: scenario3:scenario3_4A434A8E_FC21_45BB_B783_9126F1B071DF
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 833c16a4422e61c0f6ccbb35d9eba323132fe4f12c2bb089d101cfc21bc283b6
#. default-sha256: 6dc2d7591306413f3a407205a561187d0edd1e2e9f146a27ad5c7325db5c0ef4
msgctxt "scenario3:scenario3_4A434A8E_FC21_45BB_B783_9126F1B071DF"
msgid ""
"⟪k:0⟫It’s not that simple.⟪k:1⟫Grownups have a lot to consider.⟪k:2⟫⟪k:3⟫So don’t give me that "
"look, Jacopo."
msgstr "⟪k:0⟫おとなの世界は色々フクザツなんだよ。⟪k:1⟫⟪k:2⟫ヤコポがそんな顔する必要ないって。"

#: scenario3:scenario3_ED963991_E6FC_4B9D_8FD8_2632C7573FA6
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 418e48f66bf6e7fff6cc85a582fa6e6516fcb455ae7f2a592fcf6f52e3f27ab1
#. default-sha256: ebb8dbe630102fe29ffc8cfa496d48a45ac16b09ec227bb87d16f6d95a2eafa9
msgctxt "scenario3:scenario3_ED963991_E6FC_4B9D_8FD8_2632C7573FA6"
msgid "⟪k:0⟫............"
msgstr "⟪k:0⟫…………。"

#: scenario3:scenario3_94BEA963_2835_4F52_912F_6D6743EBAE65
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 62c0708c852099a27f1a431367ded47710e86277a04f9480226c2cdede5636b9
#. default-sha256: 31f3fe6ec5541b7a237cf8753a0c9ed34a64c715f5c08b2566d1ec0ccf0dd62f
msgctxt "scenario3:scenario3_94BEA963_2835_4F52_912F_6D6743EBAE65"
msgid ""
"⟪k:0⟫We were kids, but we’d both kinda started to catch on—⟪k:1⟫⟪k:2⟫to the situation with our "
"families, and to the bonds that land held on us."
msgstr ""
"⟪k:0⟫お互い、⟪k:1⟫子供ながらに何となく察していたよね。⟪k:2⟫⟪k:3⟫お互いの家系のこととか、⟪k:4⟫この"
"土地のしがらみだとか。"

#: scenario3:scenario3_B0E1009B_E596_43B6_8C25_F53242CA2929
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 04553923dd660d146efd771a3d3ba217d0fc6b5a913e955b3ba152cf002b3fee
#. default-sha256: 2525641afcda30f116508947b7898dd1cef867499c4ad04026f8c97bed56142f
msgctxt "scenario3:scenario3_B0E1009B_E596_43B6_8C25_F53242CA2929"
msgid "⟪k:0⟫Although we didn’t know any of the details at the time."
msgstr "⟪k:0⟫その当時は詳しいことなんて分かっていなかったけど、⟪k:1⟫さ。"

#: scenario3:scenario3_420E9C01_B49E_4D3D_9484_B9EB1E8426BC
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: ccead3a847d34aefb382defb26fe1a31647849344077cd31dd85be5df4a8b3f9
#. default-sha256: 24bfa2c7d772dd4233c57274ae0ba5988ef31fb991b500334eecdedec5bd26be
msgctxt "scenario3:scenario3_420E9C01_B49E_4D3D_9484_B9EB1E8426BC"
msgid ""
"⟪k:0⟫My grandpa owned all the land the city was built on, but he was a very conservative man. "
"⟪k:1⟫He didn’t try to spread his influence, instead opting to fortify what he already had."
msgstr ""
"⟪k:0⟫街の大地主はあたしのお爺さんだった。⟪k:1⟫でも、⟪k:2⟫保守的な人でさ。⟪k:3⟫⟪k:4⟫権力を広げるん"
"じゃなくて、⟪k:5⟫内に内に固めていこうとするタイプ……。"

#: scenario3:scenario3_44E5E60F_619F_4783_9AF8_6D59FB70B4CA
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 9a0294d18ed006c2aca3370948a81b9542eac647dec6d37d5822899ce71d26f1
#. default-sha256: 343e027b89d79313d8ff26eb74774218bbb16c16f3482ada31e12bfd4abd79a5
msgctxt "scenario3:scenario3_44E5E60F_619F_4783_9AF8_6D59FB70B4CA"
msgid ""
"⟪k:0⟫I don’t know exactly when it first started, but organizations were used to administrate "
"cities."
msgstr "⟪k:0⟫いつの時代からか良くわかんないけど、⟪k:1⟫街を管理するのに組織が作られた。"

#: scenario3:scenario3_FE03D2C2_CE9D_49A0_AD09_93D508BD862D
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 1fd0161732b8f293b8a8d9fb6c445d163e50a5959dd704d0f250f37b51e17e17
#. default-sha256: 73a425a7b569be5e68adf2147852d638301ecc74de86a0a4f97f288ca3ef7bb3
msgctxt "scenario3:scenario3_FE03D2C2_CE9D_49A0_AD09_93D508BD862D"
msgid "⟪k:0⟫And when we were kids, my dad was the capofamiglia, and my grandpa his consigliere."
msgstr ""
"⟪k:0⟫あたしらが子供の頃は、⟪k:1⟫あたしの父さんがカーポ＜頭＞で、⟪k:2⟫爺さんがコンシリエーレ＜相談"
"役＞だった。"

#: scenario3:scenario3_DE4155A7_D75E_47AA_BA2F_C5237A5D2575
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: d01eecb58182d63aac04e66144b21e9a07261e8a3a8aad2b44f776eb3856144b
#. default-sha256: 3912b6186d2526eebe7e56eb9751a3336e255f8fe5de98bf086193c41ca25c1c
msgctxt "scenario3:scenario3_DE4155A7_D75E_47AA_BA2F_C5237A5D2575"
msgid ""
"⟪k:0⟫But just because he was an adviser didn’t mean he was powerless. ⟪k:1⟫While my dad made the "
"decisions, my grandpa was the only one allowed to fight him on them."
msgstr ""
"⟪k:0⟫でも、⟪k:1⟫この相談役ってのが、⟪k:2⟫なかなか馬鹿には出来ないんだよね。⟪k:3⟫⟪k:4⟫決定権は父さ"
"んにあるけど、⟪k:5⟫口を出すのは爺さんなワケで。"

#: scenario3:scenario3_56045517_5319_4499_BB6B_D42414E734FE
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 26f4d1d5dd77156bd69c841eab5453c386a98e177390d7db0fac7133b8ec4b05
#. default-sha256: 3c88ae18448b9d17845e0bd9b7396a1c757d76418cfde357b5b1bc153a4e8c7c
msgctxt "scenario3:scenario3_56045517_5319_4499_BB6B_D42414E734FE"
msgid ""
"⟪k:0⟫Your father was a capodecina that served under my dad; ⟪k:1⟫he wasn’t especially happy about "
"that."
msgstr ""
"⟪k:0⟫あんたの親父さんは、⟪k:1⟫あたしの父さんの下でカポ・レジーム＜幹部＞をやっていて、そういう体制"
"を嫌ってたんだよな。"

#: scenario3:scenario3_E92A8C87_218D_41CE_9786_583BDA361FB7
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 48cfa8757705465073ca5eb1e994f9dc454be7e2a1cefd59594c61249556c6b0
#. default-sha256: 56c3e1bff774fde19f788990d41bdc27fe9e118fb2ce86f9f6212955f4ccfa70
msgctxt "scenario3:scenario3_E92A8C87_218D_41CE_9786_583BDA361FB7"
msgid ""
"⟪k:0⟫But parents’ quarreling doesn’t affect their kids—⟪k:1⟫⟪k:2⟫or at least, that’s what I "
"thought at the time, and what you probably thought too."
msgstr ""
"⟪k:0⟫でも、⟪k:1⟫親同士の諍いなんて、⟪k:2⟫子供には関係ないじゃん？　⟪k:3⟫⟪k:4⟫少なくともあたしはそ"
"う思ってたし、⟪k:5⟫あんたもそう思ってたよね。"

#: scenario3:scenario3_28B62F9C_A22F_4061_8C74_AF06E01EF4AE
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 1ac58c2b55e210341ceb449357367e92bbbd61b9a4bf031b23fe20bccd64feb5
#. default-sha256: af72779cd89110b6cd8a95a2d13d272898ffd1a9e4d2a71172b81b1dcac31e26
msgctxt "scenario3:scenario3_28B62F9C_A22F_4061_8C74_AF06E01EF4AE"
msgid ""
"⟪k:0⟫But there was still a chance we could be caught in the crossfire, so my dad decided to send "
"me and my mom away."
msgstr ""
"⟪k:0⟫そうは言っても、⟪k:1⟫子供にとばっちりが来るかもしれないのは、⟪k:2⟫⟪k:3⟫事実だったから……、"
"⟪k:4⟫父さんは、⟪k:5⟫あたしと母さんを遠くにやろうとした。"

#: scenario3:scenario3_F203B666_9A02_4FA1_97BC_4021E9442EBC
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 01f196aed755f84feeea58b2e48f7399aa28eefb4cdbaa432b15075b0b805a55
#. default-sha256: 0ecb8084c5e7ae9db6ef00d27c015a21aa11f1d7032a276c102044775e84fa99
msgctxt "scenario3:scenario3_F203B666_9A02_4FA1_97BC_4021E9442EBC"
msgid "⟪k:0⟫Off the island and to the north were some more prosperous areas."
msgstr "⟪k:0⟫島の外に出て、⟪k:1⟫もっと北の――栄えている方へ。"

#: scenario3:scenario3_EFB90E92_858C_4A69_8A70_A1F053E3BA3A
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 39198aff4dfe293ec69ee8f475b19770fb37b24681bcea6a41ff99f1833a7cb2
#. default-sha256: 2bac3ff818d04af5d7433ba20e91371c9361949ee7cd4810afe9f238f93fb1f0
msgctxt "scenario3:scenario3_EFB90E92_858C_4A69_8A70_A1F053E3BA3A"
msgid ""
"⟪k:0⟫He thought that by sending us there, we could live our lives clean, regardless of where we "
"came from."
msgstr ""
"⟪k:0⟫北の方に行けば、⟪k:1⟫あたしらみたいな出自だって――、⟪k:2⟫綺麗な生き方が出来るだろうってね。"
"⟪k:3⟫そう考えたんだ。"

#: scenario3:scenario3_FB5A0103_4072_4CE8_97DE_29C346E2241A
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: fe3462393c68a12f7333d2c1b6fcd6bbfff598086d2edf1a01972c89332e4c14
#. default-sha256: f41830032056024959b7034533cd6ca1b0a96ce0f31d6a29607c6b3027be4bce
msgctxt "scenario3:scenario3_FB5A0103_4072_4CE8_97DE_29C346E2241A"
msgid "⟪k:0⟫There’s no changing what’s in your blood, though."
msgstr "⟪k:0⟫どこに行ったって、⟪k:1⟫血筋は変わらないっていうのにさ。"

#: scenario3:scenario3_65B10959_E51A_4BFE_BAD9_71004141E3EF
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: f722b6af1a83aed60f051a3709d54a762bedaaec38eade7e82403b78d0fd77dc
#. default-sha256: 3d6e55d2a126c666e6dc8cb6d2633c1049cefd8587989406e981cbe33851a2fe
msgctxt "scenario3:scenario3_65B10959_E51A_4BFE_BAD9_71004141E3EF"
msgid ""
"⟪k:0⟫You could have told me too.⟪k:1⟫⟪k:2⟫Or were you planning on leaving without saying anything?"
msgstr ""
"⟪k:0⟫……君だって、⟪k:1⟫教えてくれたら良かった。⟪k:2⟫⟪k:3⟫なんにも言わずに、⟪k:4⟫出ていっちまうつも"
"りだったのか。"

#: scenario3:scenario3_238D2C70_8B02_445E_A29F_79A27DE018DE
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 5ef1ad5d710e3189a080edc813b68ecad91f030060642786d7c1086ffe7d2f1a
#. default-sha256: 02ccf27a593dd3b05113892ec5145e42f281bafcc02907f77815dddf3b0e0e71
msgctxt "scenario3:scenario3_238D2C70_8B02_445E_A29F_79A27DE018DE"
msgid "⟪k:0⟫No, it was just... ⟪k:1⟫all decided so quickly."
msgstr "⟪k:0⟫そんなことないけど……、⟪k:1⟫決まったのだって、⟪k:2⟫急だったしさ。"

#: scenario3:scenario3_526F465D_F414_4B7B_BDFB_CBB6009BBC02
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 30ce8252351683480b17dfd515fa830d066d77f6d32cef31ec8a4cd272395411
#. default-sha256: 57e07376af68b6a30fa833ad2802f8daab8d00519e9604c3af6cce3fe8de2ceb
msgctxt "scenario3:scenario3_526F465D_F414_4B7B_BDFB_CBB6009BBC02"
msgid "⟪k:0⟫Why do you sound so accepting?"
msgstr "⟪k:0⟫なんでそんな……、⟪k:1⟫割り切った言い方をするんだ。"

#: scenario3:scenario3_E46D378D_F8E2_4F01_9878_B209DD6FB66B
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: ea1bd75f34164a11bbbf12473825af6ab8925ba0efb03c13b228251471f01528
#. default-sha256: 39d877ab4344b028a11cf508b4df0953ab81205275def7fb0256588646ec3aa0
msgctxt "scenario3:scenario3_E46D378D_F8E2_4F01_9878_B209DD6FB66B"
msgid ""
"⟪k:0⟫Adults have a lot to consider?⟪k:1⟫You bet they do! But you could at least let them know "
"you’re opposed to it, Maria! But no, your tail went straight between your legs as soon as you "
"were told."
msgstr ""
"⟪k:0⟫大人の世界が複雑？　⟪k:1⟫確かにそうだろうさ！　⟪k:2⟫だがマリーア、⟪k:3⟫君は反抗の意志も見せ"
"ず、⟪k:4⟫最初から言いなりになるつもりなのか！"

#: scenario3:scenario3_DD4238B2_DF1E_4F6E_8239_B8DCDE698AFF
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 8e264113188389f175148b4a7297eabefa20177405d8cf5efb85e7271cb60c10
#. default-sha256: 077bf61fa215ebbbc21a54ef850ebde91b422742940eff314306ab0665962872
msgctxt "scenario3:scenario3_DD4238B2_DF1E_4F6E_8239_B8DCDE698AFF"
msgid "⟪k:0⟫You just gave up and accepted it straight away!"
msgstr "⟪k:0⟫仕方ないと最初から割り切って……！"

#: scenario3:scenario3_6ACE91E0_57E9_42AB_A176_501F27BA5E25
