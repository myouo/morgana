msgctxt "scenario3:scenario3_CE2D6955_0DD6_4D3C_B282_B5CC49998B4F"
msgid "⟪k:0⟫They were far from picturesque partners."
msgstr "⟪k:0⟫お世辞にも、⟪k:1⟫円満な夫婦生活とは言えませんわ。"

#: scenario3:scenario3_36CA8F90_33C5_4F93_96E6_E05FB48E7ED7
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 2e07ec305fc623f232eab994ce6f38492c2e07a25abe86e02a31d45cf4cb4dd5
