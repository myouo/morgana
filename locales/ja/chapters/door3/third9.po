msgid "⟪k:0⟫You were just ⟪k:1⟫waiting⟪k:2⟫ for this opportunity, weren’t you?"
msgstr "⟪k:0⟫―――その機を狙ってでもいたのか？"

#: scenario3:scenario3_FD4C0B48_39AF_43DA_B62F_02CB1F94D6BA
