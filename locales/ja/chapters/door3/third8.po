msgid "⟪k:0⟫See?⟪k:1⟫What’d I tell ya?⟪k:2⟫Fun, huh?"
msgstr "⟪k:0⟫ね、⟪k:1⟫ね。⟪k:2⟫楽しくない？　⟪k:3⟫どう？"

#: scenario3:scenario3_EFF7A002_53EC_4B9F_B5AA_580D15A808BC
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 210dcc6017294558cc502e9483f5122245d80be5ff1a32c4c905453e6f544254
