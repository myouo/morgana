msgid "⟪k:0⟫Hahah! Glad to hear it!"
msgstr "⟪k:0⟫ははっ――、⟪k:1⟫よかった！"

#: scenario3:scenario3_C4F380E4_755E_4CE7_BBD6_18E9B3510388
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 7f3d9e868fc1b0e6d77c6f67ae0ddecb51586417d0cddc790eb41a2bda4cb6fa
