msgctxt "scenario3:scenario3_4BD5B9AC_1407_4118_9077_28D9615E3102"
msgid "⟪k:0⟫She looked over at Maria regretfully."
msgstr "⟪k:0⟫白い髪の娘は少し、⟪k:1⟫申し訳なさそうにしました。"

#: scenario3:scenario3_AA806ABD_A17D_4C0B_B0DC_407908E135F7
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: c3ba822e8ac77f77648ca62043d80eed40bbe994d44c38f442bd570d91461c59
