msgctxt "scenario3:scenario3_311AD7AE_688C_4BEA_97FF_A0B2E3E315FB"
msgid "⟪k:0⟫the other people stepping up to join in."
msgstr "⟪k:0⟫それらが、⟪k:1⟫目に浮かぶようでございました。"

#: scenario3:scenario3_153FE6BB_4F57_4B7C_BC7B_A0991FD49AAD
