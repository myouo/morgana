msgctxt "search2:search2_D20D6053_076D_4F80_B267_25DDC33180BA"
msgid "⟪k:0⟫⟪k:1⟫Giselle!"
msgstr "⟪k:0⟫⟪k:1⟫ジゼル………！"

#: search2:search2_6C1E3712_DB41_4FC0_9741_04C66D419C6C
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 572d9695780ad7473d2e2e2ce0791fbaddc3cf1cf842fb5a95dc572156f6f709
#. default-sha256: 89da5b51786ed89eb95f5f7483013910ed525a3245e9c24af9482a061560da02
msgctxt "search2:search2_6C1E3712_DB41_4FC0_9741_04C66D419C6C"
msgid ""
"⟪k:0⟫Everything comes back to me all at once.⟪k:1⟫⟪k:2⟫That’s right... ⟪k:3⟫I watched Morgana "
"kidnap her."
msgstr ""
"⟪k:0⟫私の身に起きたすべてのことを思いだす。⟪k:1⟫⟪k:2⟫そうだ――、⟪k:3⟫私は、⟪k:4⟫目の前で彼女を奪わ"
"れたのだ。"

#: search2:search2_317EB5A2_A2E1_46B1_839A_92BC9F210064
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: e46ed6e07e31ebe6fb24b9b317bcecfdc9000714cd05b33ee396a566ef2b09d7
#. default-sha256: 9a17cc56e2a295afdb08466b27c24e4ef0941730a6c9b15bd500e2ed41cc01ae
msgctxt "search2:search2_317EB5A2_A2E1_46B1_839A_92BC9F210064"
msgid "⟪k:0⟫I watched the witch drag her into the darkness...⟪k:1⟫⟪k:2⟫unable to reach her hand."
msgstr "⟪k:0⟫彼女の手を握ることが出来ずに――、⟪k:1⟫⟪k:2⟫闇の向こうへと奪われたのだ……。"

#: search2:search2_51530F60_E669_44C1_B5EB_FED125E8E7AF
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 1c25bf82ed97b6a08be8304bc70197e55954f29fbdac864bafecf21a1b639780
