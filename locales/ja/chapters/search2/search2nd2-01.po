msgid "⟪k:0⟫⟪k:1⟫............"
msgstr "⟪k:0⟫⟪k:1⟫…………。"

#: search2:search2_0BF6EFA1_487D_4896_A517_B219C8E09DB0
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 796ea4b13d5c1f1bfbbbbdfd7bc0046a4d0a9da1acd6deaa5da50ec2e7bcb558
#. default-sha256: c149490d0a9cecbe6adf1ace26937666dadbe2008ae053bec3e291aa29bc0e85
msgctxt "search2:search2_0BF6EFA1_487D_4896_A517_B219C8E09DB0"
msgid "⟪k:0⟫Why won’t it open?"
msgstr "⟪k:0⟫……なぜ、⟪k:1⟫開かない……。"

#: search2:search2_96F73FBF_5BBB_4919_9815_440D63E09F0C
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 5e202d6160cd2aa63d9142bab6c6e24ef756b198a8e80dd44df3aa7b10a3d35f
#. default-sha256: 921c5db581129cdff62a36ac8fc5e4dedd336bf8e75142df2ccbafc3502cf2f4
msgctxt "search2:search2_96F73FBF_5BBB_4919_9815_440D63E09F0C"
msgid "⟪k:0⟫There shouldn’t be a lock..."
msgstr "⟪k:0⟫ここに……、⟪k:1⟫鍵なんてものは、⟪k:2⟫なかったはずだ……。"

#: search2:search2_0FB7C85A_64C1_4CE4_AB67_F029F2EE8EE7
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 757a9c7da7a9fcb3496337705211519cc67ee8f0b1699bb3b224b2ed4153583e
#. default-sha256: 9b55152a760b8a17d79e71e92122959829fae2f98601e7a0ed06efffc2f5d3f6
msgctxt "search2:search2_0FB7C85A_64C1_4CE4_AB67_F029F2EE8EE7"
msgid "⟪k:0⟫Lustrous black chains seal the metal door."
msgstr ""
"⟪k:0⟫その鉄製の扉を閉ざし、⟪k:1⟫縛り付けているのは、⟪k:2⟫黒々と光る鎖だった。⟪k:3⟫⟪k:4⟫私の生前の"
"記憶にも、⟪k:5⟫ジゼルに手を引かれていた時にも――"

#: search2:search2_CE0D7F82_7EA3_4CEF_8BCA_130F0610B5AD
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 219237fc9e99deb970e1193887151bfef98daaa04bc14dd680af6977a673a377
#. default-sha256: f7c6bc4741e8a9c5b0a3fe93a8eee7281b586f70c90742c121fda97fa1a9e51b
msgctxt "search2:search2_CE0D7F82_7EA3_4CEF_8BCA_130F0610B5AD"
