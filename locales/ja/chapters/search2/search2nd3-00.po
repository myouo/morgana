msgctxt "search2:search2_EB3E4669_3E5E_4FAB_9FEB_FBCB06166DD9"
msgid "⟪k:0⟫my surroundings crumble."
msgstr "⟪k:0⟫再び崩れていく。"

#: search2:search2_E5461650_64E8_4EEB_808D_5137668D24F9
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
