msgctxt "search2:search2_E5461650_64E8_4EEB_808D_5137668D24F9"
msgid "⟪k:0⟫My bloody body sinks back into the abyss."
msgstr "⟪k:0⟫私の身は、⟪k:1⟫その流れる血ごと、⟪k:2⟫暗闇へと落とされていく。"

#: search2:search2_1A541188_8FB8_4B98_993F_EFD1169156C0
