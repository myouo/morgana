msgctxt "search2:search2_1A541188_8FB8_4B98_993F_EFD1169156C0"
msgid "⟪k:0⟫The pain becomes more than just a memory,"
msgstr "⟪k:0⟫痛みが――再び鮮明となり、"

#: search2:search2_9093129F_4911_4E39_AC77_70B201633B95
