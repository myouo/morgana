#: omake:omake_FC88912E_2931_41A4_92DD_9E4111F94673
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: c4895d4d00479d09f017380a975de91b0118e7c74b415480d51c5cb37665fc6f
#. default-sha256: 31566613eb19e4747b63a36214febf7bdc813e5f9e1c389935a92ce45606e56a
msgctxt "omake:omake_FC88912E_2931_41A4_92DD_9E4111F94673"
msgid "⟪k:0⟫⟪k:1⟫⟪k:2⟫Well, never mind that for now."
msgstr "⟪k:0⟫⟪k:1⟫⟪k:2⟫……まあいいわ。⟪k:3⟫この際細かいことは気にしません。"

#: omake:omake_842EAA67_89AC_4204_B51D_994B16A9A5B6
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 5450ac9f6b18ecbacf4b1228fa22cec29fb87042a8baf42a95ddc26801a4d699
#. default-sha256: cde4ade3653b70e6a2397d0ac7d3b9fd5f07f04981fc9d9ffdd9389ad0f48d37
msgctxt "omake:omake_842EAA67_89AC_4204_B51D_994B16A9A5B6"
msgid ""
"⟪k:0⟫I would ask you what you thought of it,⟪k:1⟫but unfortunately, that is beyond even my powers."
msgstr "⟪k:0⟫あなたがどういう感想を抱いているのか、⟪k:1⟫その声が聞けなくて残念よ。"

#: omake:omake_F9A09CB9_71D9_41BD_8D28_DFAE4B4D5048
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 3b9a4d3b5456e3dd0b13f065a3a4c45e72ed9fdf5a7453fb6f6071b7ac5dba5c
#. default-sha256: aaa2f4d55fa0e847cf1cfa48a2a96b11bf968bbeea70d1b072604770fe3f3e47
msgctxt "omake:omake_F9A09CB9_71D9_41BD_8D28_DFAE4B4D5048"
msgid "⟪k:0⟫⟪k:1⟫⟪k:2⟫...You’ve got a strong stomach, at least."
msgstr "⟪k:0⟫⟪k:1⟫⟪k:2⟫そう……、⟪k:3⟫度胸があるのね。"

#: omake:omake_3D14B59C_669A_473A_81E7_82B165B4E507
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 516154964ef721f27a4cf80fa7685699aa624f46b6205e286c135c569a58cf6b
#. default-sha256: 559956d627203f9d6b76df20d088e7b4b7815aba9d683654ac796a77dddd64e9
msgctxt "omake:omake_3D14B59C_669A_473A_81E7_82B165B4E507"
msgid ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫Before we begin our little trek, I would like to emphasize that this is,⟪k:3⟫as "
"the title implies, a look behind the curtains of ⟪k:4⟫The House in Fata Morgana⟪k:5⟫."
msgstr ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫じゃあ早速……、⟪k:3⟫と言いたいところですけど、⟪k:4⟫タイトルにあったようにここは舞台"
"裏なんです。"

#: omake:omake_5973E007_064C_48B3_A4D6_641D2CD416FC
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 1b03ee52d0c280534522ae1795b6e87d6a0f72a665110234dfd886c587af82bc
#. default-sha256: 464f8ea551a7ca98c693fa25abdc6cb64a95cb34adc59ca9a7a37009d6d2777f
msgctxt "omake:omake_5973E007_064C_48B3_A4D6_641D2CD416FC"
msgid ""
"⟪k:0⟫You’ll be making your way into the heads of the staff themselves,⟪k:1⟫and I promise you—⟪k:2⟫"
"⟪k:3⟫it’s not a pretty sight."
msgstr ""
"⟪k:0⟫⟪k:1⟫それでも行くと言うのなら、⟪k:2⟫行きましょう。⟪k:3⟫⟪k:4⟫制作陣のあれやこれが駄々漏れな舞"
"台裏にね。"

#: omake:omake_8A3E8667_5714_4479_945B_89A82141E83A
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 1c16888f22518b42f5c64dfe93d845abad56aa2bc139050a64ff1417a921da16
#. default-sha256: d18f6588d2bff09cc1ff107bdf9b1b609b0a9a9e2a62ac61220ed29d5d2429ca
msgctxt "omake:omake_8A3E8667_5714_4479_945B_89A82141E83A"
msgid "⟪k:0⟫Let us be off, then."
msgstr "⟪k:0⟫じゃあ、⟪k:1⟫行きましょうか。"

#: omake:omake_0D388061_5E2E_478A_ACF1_CABD30013371
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: f1f190857cde7601ae93be0b60059c2a14ad2b13c96ab0e3f72ec67d0554ded8
#. default-sha256: d6e3be210c4e67c200da9c6f026917c73f736419aad546fec15a3622563db793
msgctxt "omake:omake_0D388061_5E2E_478A_ACF1_CABD30013371"
msgid ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫⟪k:4⟫⟪k:5⟫⟪k:6⟫Ah! I found another split end!⟪k:7⟫⟪k:8⟫Look, this one’s split "
"into three!"
msgstr ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫⟪k:4⟫⟪k:5⟫⟪k:6⟫あっ、⟪k:7⟫また枝毛見つけちゃいましたよ！　⟪k:8⟫ほらここ、⟪k:9⟫"
"毛先が三つに分かれてる！"

#: omake:omake_C02C6675_80EB_49E5_9A4B_007813BB63CA
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: ee945f6de09168a79b3241b3d780b0a02291a296be88f91a7284beca1469ab67
#. default-sha256: aacc13131aa844d94d109bea15472b7764ec0a93eb1f196ed24d9ac675155a1a
msgctxt "omake:omake_C02C6675_80EB_49E5_9A4B_007813BB63CA"
msgid ""
"⟪k:0⟫I-⟪k:1⟫I— ⟪k:2⟫⟪k:3⟫I didn’t actually mean that!⟪k:4⟫⟪k:5⟫I was just, ⟪k:6⟫you know, ⟪k:7⟫a "
"little overwhelmed at the time!⟪k:8⟫About how unexpectedly handsome you were!⟪k:9⟫But I couldn’t "
"bring myself to say it!"
msgstr "⟪k:0⟫あ、⟪k:1⟫あれはほら！　⟪k:2⟫照れ隠しですって……！"

#: omake:omake_DE51EA4A_A870_40CF_91A4_9D835B779A79
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 62077b46368689d911f50bc4c1dc425aa946b6d72e29f07a45a9b4e7036a4f80
#. default-sha256: 1050fc00a4ebd388f2e5652bab4dfcd5dec0fcc670e4b735fdb68d7e0897f206
msgctxt "omake:omake_DE51EA4A_A870_40CF_91A4_9D835B779A79"
msgid "⟪k:0⟫I hope you two sickening lovebirds spontaneously combust..."
msgstr "⟪k:0⟫………呪爆発しろバカップルども………。"

#: omake:omake_7F2F89CD_77AE_4D18_96BE_501ABA446818
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 011d49a51e1061a28ed5d40841d3c197e2e917f656c654b85c4074e83b261a6b
#. default-sha256: 026a82dfcd2a0ed50bd907f9b3177bf87edd000c4d5a8aa4975f2ef9412f3142
msgctxt "omake:omake_7F2F89CD_77AE_4D18_96BE_501ABA446818"
msgid ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫As the true master of this house, I am everywhere at all times.⟪k:3⟫⟪k:4⟫Even in "
"the bathrooms."
msgstr ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫私はこの館の真の主ですから、⟪k:3⟫いつでもどこでも神出鬼没ですよ。⟪k:4⟫ええ、⟪k:5⟫あ"
"なたのトイレの最中でもね。"

#: omake:omake_05A8DDD2_7450_494D_9A7A_1B323EC72C6E
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 61a37bcced253c0d50707b58de9ad95950f25487849043f11dbc9e7a9792425d
#. default-sha256: fa4bfc78a00f84a5c516e7636e1a98f537128e5a2c4c40c33deb54835df43a0e
msgctxt "omake:omake_05A8DDD2_7450_494D_9A7A_1B323EC72C6E"
msgid ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫I think that’s enough toilet humor for the time being.⟪k:3⟫⟪k:4⟫Especially in "
"front of our guest."
msgstr "⟪k:0⟫⟪k:1⟫⟪k:2⟫まあトイレの話は置いておきましょう。⟪k:3⟫⟪k:4⟫お客さんの前ですからね。"

#: omake:omake_FD6983FC_6500_4BC7_BE9D_0AC6E8F24B4A
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: b69dd8aa12571a025075c3b4d0483715c058915f92f3a71128893716c941ec80
#. default-sha256: aab539542c4f3f49ce53d2819748edbdbef11fa3861b81f07df5540a13163fd9
msgctxt "omake:omake_FD6983FC_6500_4BC7_BE9D_0AC6E8F24B4A"
msgid "⟪k:0⟫⟪k:1⟫It just... ⟪k:2⟫never really seemed that way to me..."
msgstr "⟪k:0⟫⟪k:1⟫いや、⟪k:2⟫あまり自覚がなかったから……。"

#: omake:omake_8BA87D65_BDE0_4565_B0AE_E16CA2BF4C6D
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 210f53525a04aff9889cdec647f46940fd98014fdf692aa4d415e3241efda6e6
#. default-sha256: fca2c0599e60ecf517b7c1148b4bf1bbc90c62d61d5c7a33109564f7ce2384ac
msgctxt "omake:omake_8BA87D65_BDE0_4565_B0AE_E16CA2BF4C6D"
msgid ""
"⟪k:0⟫⟪k:1⟫But once you reclaimed yourself, you were most definitely playing the protagonist. ⟪k:2⟫"
"Especially the final chapter! You had me swooning by the end!"
msgstr ""
"⟪k:0⟫⟪k:1⟫でも、⟪k:2⟫取り戻してからはすごく主人公してたと思いますよ。⟪k:3⟫⟪k:4⟫特に最終章！　⟪k:5⟫"
"最後とか、⟪k:6⟫かっこよかったです。"

#: omake:omake_48AEFCD0_9BAB_438B_A1E5_5BD013A1151B
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 2935e59e854ca9598977e9105553a9b626ec44c678df6aace90b953e44a3403b
#. default-sha256: d0ae0207d41405a31c49235300e493751308f6f640e82368d00c6bec0dad4c70
msgctxt "omake:omake_48AEFCD0_9BAB_438B_A1E5_5BD013A1151B"
msgid ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫What do you think, my dear? ⟪k:3⟫What any respectable behind-the-scenes extra "
"would do, of course—"
msgstr ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫あら、⟪k:3⟫それは決まっているでしょう。⟪k:4⟫⟪k:5⟫舞台裏らしく、⟪k:6⟫それぞれの部屋"
"を回って――"

#: omake:omake_2A7F3CA3_1134_4621_BF76_8BE0B1176ACB
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: bce5d9c7d6655b65df81e9fcce03f44ea26bcacf19d344791bc87bc6df33eae9
#. default-sha256: 73131beadf55cd115d6a8aa02e40e20c9b594f537a5ef827444d7aaf74abb5d6
msgctxt "omake:omake_2A7F3CA3_1134_4621_BF76_8BE0B1176ACB"
msgid "⟪k:0⟫we’re going visit each room in the mansion and faff about like a bunch of fools."
msgstr "⟪k:0⟫言いたい放題してくるんです。"

#: omake:omake_060CE94C_E0AE_47B9_9D2B_6BC0BB35989D
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 5a4a6d4e1674cca92b189ec1289dffe02a68fea2622466e61b25b9673b0d700f
#. default-sha256: d570a87ac64e27792617c330700d19bc580c3aa6d1be9206c4e9ce93bf46452a
msgctxt "omake:omake_060CE94C_E0AE_47B9_9D2B_6BC0BB35989D"
msgid "⟪k:0⟫⟪k:1⟫............"
msgstr "⟪k:0⟫⟪k:1⟫…………。"

#: omake:omake_DD46117D_9ECB_4B85_BC2C_B5C1D59040E9
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 5dda9161a8241f08e79bd33aa37f4a07547a5fd7e39bba578b5e7910cfe12349
#. default-sha256: 6daa7802f82ce2e371f9a792e8d190a0440f1a34b4b6e1ceb11cf87f20d95280
msgctxt "omake:omake_DD46117D_9ECB_4B85_BC2C_B5C1D59040E9"
msgid ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫You can’t deny a lot of readers probably didn’t expect the creepy white-haired "
"recluse to turn out to be the main character."
msgstr ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫まあでも、⟪k:3⟫多くの人が驚いたと思いますよ。⟪k:4⟫⟪k:5⟫まさか怪しいロンゲ野郎が主人"
"公とはね。"

#: omake:omake_AB7DE4F2_5BDB_46C5_B426_851B3684F16C
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 408e53adbb0f4eddc5e8f5a3a815ebbf3abe022ef3bcd72ccead5e595dc1a1ac
#. default-sha256: b5e3a74390afdfbec670d63d895f75bd22c1eb80f9e642a1f69c1482806e8df7
msgctxt "omake:omake_AB7DE4F2_5BDB_46C5_B426_851B3684F16C"
msgid ""
"⟪k:0⟫Though perhaps there are some people whose interpretations did not change throughout the "
"course of the tales."
msgstr ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫本筋の私の話に入る前でも、⟪k:3⟫一章から三章でそれぞれ認識逆転が起きていたと思いま"
"す。⟪k:4⟫逆転しないでそのままの人もいるでしょうけれど。"

#: omake:omake_409E38F1_AD87_424A_9225_01F6D09C8F9D
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 0c9244f640683a51478b51291e59accd166515635c5e01c5355cb63c5ba42e21
#. default-sha256: 7f6a03745e8363bd83f544b1683b7ec80d09a7bd14f7f2de04f19b57ba7d92f4
msgctxt "omake:omake_409E38F1_AD87_424A_9225_01F6D09C8F9D"
msgid "⟪k:0⟫⟪k:1⟫No, that’s not how you pronounce his name.⟪k:2⟫⟪k:3⟫As I recall, it’s Eucalyptus—"
msgstr "⟪k:0⟫⟪k:1⟫いや、⟪k:2⟫その発音は間違っている。⟪k:3⟫確か、⟪k:4⟫ウキサマ――"

#: omake:omake_0563CC2F_1F91_4F15_AA9C_CA7CEC8E9CA9
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: a9641e7a4f2ce2a6c89ee3d2d7c2476679492884d9291a08a549af8aa3317f6c
#. default-sha256: 9445153f70f1290ebcb13aa4ac456b901c51cd88eeeb107649de6e3d2d93ae40
msgctxt "omake:omake_0563CC2F_1F91_4F15_AA9C_CA7CEC8E9CA9"
msgid ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫You already made that joke. Let it go, please.⟪k:3⟫⟪k:4⟫That creature doesn’t need "
"a name. Just call him “the beast.”"
msgstr ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫もうそのネタから離れなさいよ、⟪k:3⟫あなたたち……。⟪k:4⟫⟪k:5⟫あれは獣と呼べば十分で"
"す。"

#: omake:omake_E6ED0CF4_EA96_43F7_8609_288EDFB5E6DA
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: f292b3bf4af82e7ed297532cf83e3a43f619b45f17ddc9f723f40929c39344c5
#. default-sha256: 16a941d8e95f09d59b6ed9c55e1e81a960d59ccc0dd80d1890c8b130ca35aa51
msgctxt "omake:omake_E6ED0CF4_EA96_43F7_8609_288EDFB5E6DA"
msgid ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫At the end of that chapter, you learn what kind of man he really was, which then "
"ties into the revelations in the final chapter."
msgstr ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫その最後で明らかになった彼らの性質が、⟪k:3⟫本来のものであるという作りだそうです。"
"⟪k:4⟫それが分かった状態で、⟪k:5⟫最終章に繋がるわけね。"

#: omake:omake_C5A798EB_B811_4ED8_AFAC_A061A9511D1D
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: dde5848252096f2b6193597b8b5c448257740b85d8d073b32c46038e2e9f24e1
#. default-sha256: f1ea8f4986abec5339e9db95127ad83a763ebbb0233c0b6c174892768fc3ea5b
msgctxt "omake:omake_C5A798EB_B811_4ED8_AFAC_A061A9511D1D"
msgid "⟪k:0⟫⟪k:1⟫.................."
msgstr "⟪k:0⟫⟪k:1⟫………………。"

#: omake:omake_50B816BD_A179_493D_9A53_C8C56CE248FA
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: bf2eb4f25684608511457c2d04c206df743814a08301a843ab09cf48a671f4d9
#. default-sha256: 75e9aa7c78ac9d96f02bf01738c7df2bb5837859c11542215d7255f472579650
msgctxt "omake:omake_50B816BD_A179_493D_9A53_C8C56CE248FA"
msgid "⟪k:0⟫I don’t hold it against you, though."
msgstr "⟪k:0⟫でも今は、⟪k:1⟫恨んでませんから。"

#: omake:omake_6F5B9841_CFC1_491F_A9B2_FBB2DF203B6D
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: e722b92ac107bf8e3597bc041f6218d4131a119d3741b329d8392bab48fe4538
#. default-sha256: d570a87ac64e27792617c330700d19bc580c3aa6d1be9206c4e9ce93bf46452a
msgctxt "omake:omake_6F5B9841_CFC1_491F_A9B2_FBB2DF203B6D"
msgid "⟪k:0⟫⟪k:1⟫............"
msgstr "⟪k:0⟫⟪k:1⟫…………。"

#: omake:omake_0A72F11A_330D_41F5_9178_3472164D57AD
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 3023bbc7c9b2e1c8c0a5df60e592054b3920948abb33ce7794931dfde62cf3c3
#. default-sha256: 7ffbbd853962576dd8f37ec43b2129573bfdf2fe84dd565c9b94c583e2cfe237
msgctxt "omake:omake_0A72F11A_330D_41F5_9178_3472164D57AD"
msgid ""
"⟪k:0⟫(I really need to peel these two apart. ⟪k:1⟫We’ll never finish if they keep making goo-goo "
"eyes at each other every ten seconds...)"
