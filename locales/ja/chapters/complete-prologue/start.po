msgctxt "prologue:prologue_B351EC4B_885F_482C_B4CB_BCEFFF7E34F7"
msgid "⟪k:0⟫⟪k:1⟫⟪k:2⟫Ahh... ⟪k:3⟫right.⟪k:4⟫⟪k:5⟫That’s true."
msgstr "⟪k:0⟫⟪k:1⟫⟪k:2⟫ああ……、⟪k:3⟫そうね。⟪k:4⟫そうですとも。"

#: prologue:prologue_219F44A4_AECD_4C4F_AFBA_6559324490AB
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 6c8ad7282ce611c6c8a517c5826ea74149137889ba01ef5068143aac990bfe32
