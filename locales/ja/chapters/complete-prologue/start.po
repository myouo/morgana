msgctxt "prologue:prologue_FE9551A9_E7B3_4525_AC83_90F29E5824B3"
msgid "⟪k:0⟫⟪k:1⟫⟪k:2⟫(It’s like I’m talking to a child...)"
msgstr "⟪k:0⟫⟪k:1⟫⟪k:2⟫（ちょっと面倒ね……）"

#: prologue:prologue_9A642A70_8B15_47C9_BD7B_BEB6E479AED8
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 2ffb8c2cf74ee2f500f4dcea0ec603a2d3d3b289e9c84ba6abf96534ae2211b5
#. default-sha256: fe5afa7dd021d9de295cc49bf64aee62e4dbd412b20f828dc74927ed746a17fe
msgctxt "prologue:prologue_9A642A70_8B15_47C9_BD7B_BEB6E479AED8"
msgid ""
"⟪k:0⟫All right, then, how about this? ⟪k:1⟫I’m going to ask you a question,⟪k:2⟫and if you give "
"me an answer I like, I’ll tell you the story again."
msgstr "⟪k:0⟫……そうね、⟪k:1⟫じゃあ、⟪k:2⟫私が気に入る返答をしてくれたら、⟪k:3⟫また話しましょうか？"

#: prologue:prologue_37041A75_7016_4F96_B9C5_AD3F59AEC5F5
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: e98cfe686bd2f847ffe47a1a894096ac597f6134b017fc2adea63c6e28ef2096
#. default-sha256: 8deb2129dc3cd34bf1c8f1fd5347c8318e2898c82699fc93d1713d0c890b0c2b
msgctxt "prologue:prologue_37041A75_7016_4F96_B9C5_AD3F59AEC5F5"
msgid "⟪k:0⟫⟪k:1⟫Oh? What kind of question?"
msgstr "⟪k:0⟫⟪k:1⟫まあ、⟪k:2⟫どのようなことをお返しすればよろしいのかしら。"

#: prologue:prologue_DDEDFAD1_E397_4B12_B05A_473A3CDE182C
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 810c5bcdef25a7031d36b7837c8b4bd839c85913158581e091279dff8d65bce2
#. default-sha256: 69b1a5906133306a17ae34ccc6d004e0c51f33b42e06e1f92af77dae881af76d
