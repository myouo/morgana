msgid "⟪k:0⟫(Foolish woman.)"
msgstr "⟪k:0⟫（愚かな人ね……）"

#: prologue:prologue_2494829B_6EF8_4259_8A89_724BF8C2E9BE
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: cffbba18ccac2261e14a9e7bdf184f1f9fd789bc0c30d772fbed7918fc430106
