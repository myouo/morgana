msgid "⟪k:0⟫⟪k:1⟫That is most unfortunate."
msgstr "⟪k:0⟫⟪k:1⟫まあ……、⟪k:2⟫残念。"

#: prologue:prologue_8FC837AF_E40A_4C1D_94F4_77A8DB4EDBD0
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: bc3b2dab9e6dd94124ac0e7e3d30582647f1917954724fd0557d1f17097b4ff4
