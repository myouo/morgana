#: search:search_D216F5A2_90FB_432B_8641_E77B5EBFC230
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 1cfe2772ad5d1b459140f9af105f374de6c53455dfe30587845a807e678d1d56
#. default-sha256: f41dd159aca9fd8f596ae929d8365184451ad40a43ee99fdde60b5ada456b626
msgctxt "search:search_D216F5A2_90FB_432B_8641_E77B5EBFC230"
msgid ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫⟪k:4⟫Oh, there you are, Master. ⟪k:5⟫You gave me quite the scare.⟪k:6⟫⟪k:7⟫"
"After returning from the third door, you disappeared without a word."
msgstr ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫⟪k:4⟫まあ、⟪k:5⟫こんなところにいらしたのですね？⟪k:6⟫　驚きましたわ。⟪k:7⟫"
"⟪k:8⟫気が付いたら、⟪k:9⟫姿が見えなくなっているんですもの。"

#: search:search_76472D0C_19F0_45BD_95FE_38AFC767ED36
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 9f1f2b57bd7b0dc06204acfaad3b91517ebba785a68cd1e90d898ac1d62876f8
#. default-sha256: dabc11c8d12bce34e32edfb13af429e35dffff4e85a86063cf6548544943ffb1
