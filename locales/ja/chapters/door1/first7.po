msgctxt "scenario:scenario_944EF2BA_DA9A_401C_A94E_33EF98DC569D"
msgid "⟪k:0⟫What do you think she did?"
msgstr "⟪k:0⟫彼女は……どうしたと思いますか。"

#: scenario:scenario_6BA85D26_61EC_4840_A811_4DC4ABA3B256
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 4ee6998786cff07f8ce9669a59582982d6af2c2136373a32b716fa508c8cf29a
