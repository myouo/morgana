msgctxt "scenario:scenario_0064EE85_B55F_4F23_BFFE_56AA12E5CDD7"
msgid "⟪k:0⟫⟪k:1⟫(There she is. ⟪k:2⟫Is she cleaning?⟪k:3⟫⟪k:4⟫No, it looks like she’s reading.)"
msgstr "⟪k:0⟫⟪k:1⟫（彼女だ。⟪k:2⟫掃除……じゃ、⟪k:3⟫ないな。⟪k:4⟫本を見ている？）"

#: scenario:scenario_A3BEDA6B_AC81_44AA_8E43_67485521CCCC
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: cf801be760e65116439b7e0c190648c108b65344667f3e8f15c0b54d5c93d06d
#. default-sha256: 589ef5b376d01789a5371aea216c37c5e4749a36db2cdc3b24fd7344134778a3
msgctxt "scenario:scenario_A3BEDA6B_AC81_44AA_8E43_67485521CCCC"
msgid "⟪k:0⟫⟪k:1⟫⟪k:2⟫(It’s now or never.)"
msgstr "⟪k:0⟫⟪k:1⟫⟪k:2⟫（……今日こそは……）"

#: scenario:scenario_FCDD3A5A_AE3F_4E8A_9DBD_6B37D25F6AB7
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: b5c803d2cb0b831a47a064a8f2497649b3d3de3bd756561dbe987defb15975a3
