msgctxt "scenario:scenario_BC97EB88_FDFF_4D90_AB47_4F0D1FC6292F"
msgid "⟪k:0⟫............"
msgstr "⟪k:0⟫…………。"

#: scenario:scenario_1E811AC6_6801_426B_A54D_0CA525E34CCE
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 7d42db6006b61292a4d6121038e683a418ac96732e9e14132d4918ac9ce810e9
#. default-sha256: 65f651323faeadc138fa0c5cb08e33ac03d06d8bac47f367ff2d90d8c97fcaeb
msgctxt "scenario:scenario_1E811AC6_6801_426B_A54D_0CA525E34CCE"
msgid "⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫⟪k:4⟫...⟪k:5⟫⟪k:6⟫Boo!"
msgstr "⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫⟪k:4⟫……――わあ！"

#: scenario:scenario_C0A92B75_E7CB_491A_9F5A_B1375AC091C4
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
