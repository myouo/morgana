msgid "⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫............"
msgstr "⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫…………。"

#: scenario:scenario_BC97EB88_FDFF_4D90_AB47_4F0D1FC6292F
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 4d026d919c1781e09e16950b4342642b431b6b2660847cea3d76b6d52d6efb75
