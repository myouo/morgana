msgid "⟪k:0⟫⟪k:1⟫⟪k:2⟫............"
msgstr "⟪k:0⟫⟪k:1⟫⟪k:2⟫…………。"

#: scenario:scenario_CD482BA8_A73A_4792_99CF_38E3C49F8D14
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 3d921e249238a14cf69a607260e18e3efc7f9f8302f310861b14a1db86ab42da
