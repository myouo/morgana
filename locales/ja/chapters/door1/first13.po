msgctxt "scenario:scenario_71606EEB_9DAB_4875_B9AD_52E5AFA70C4E"
msgid "⟪k:0⟫G-⟪k:1⟫Get off me!"
msgstr "⟪k:0⟫は、⟪k:1⟫はなれろ――ッ！！"

#: scenario:scenario_F3473CBE_D848_48B2_B063_CD14C0C95CF2
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 72b78320ae2c3a7f5dbb21e31e0875f291505213f1a56401bab277dfebb7509c
