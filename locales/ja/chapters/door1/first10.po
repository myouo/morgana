msgctxt "scenario:scenario_480EC6D3_51C4_47F4_8798_38493C5712CC"
msgid "⟪k:0⟫And that’s... ⟪k:1⟫why you tried to kill me."
msgstr "⟪k:0⟫それで……僕を、⟪k:1⟫殺そうとしたのか……。"

#: scenario:scenario_3FC565AD_D74E_4DD5_9DB3_30143B74377F
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 77daf5421684e148c489baddc733e0eea0161ef2d84b0d558e4820aecf2038ba
