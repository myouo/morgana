#: scenario7:scenario7_88E91C20_1FAC_4F1B_8BB7_CAF9D0FF2818
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 454b657031d6eb1f8651da4674db43a89b96237de9568cba2ff360586c6dafbe
#. default-sha256: a305353635d638f5237a922b21e60ca3ab9bc2c7394aac2f7c4e561b54eeedc4
msgctxt "scenario7:scenario7_88E91C20_1FAC_4F1B_8BB7_CAF9D0FF2818"
msgid ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫⟪k:4⟫⟪k:5⟫⟪k:6⟫⟪k:7⟫⟪k:8⟫⟪k:9⟫For so long, I have been waiting.⟪k:10⟫⟪k:11⟫"
"Waiting for the day I would be rid of this darkness."
msgstr ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫⟪k:4⟫⟪k:5⟫⟪k:6⟫⟪k:7⟫⟪k:8⟫⟪k:9⟫私はずっと待っていたんです。⟪k:10⟫この暗闇の世界"
"から抜け出す日を――"

#: scenario7:scenario7_EC62F4D2_4935_49F4_B0A7_B492F0D33511
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 7453ee58c6bfd4ee69c6d69d1ec19520f36648100ad94f4b5721adab2f4f0941
