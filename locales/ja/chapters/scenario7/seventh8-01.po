msgstr "⟪k:0⟫…………。"

#: scenario7:scenario7_4192695C_CD64_45F6_B7B2_D9385A7FEC77
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 17be5837a01507b817bc462a5d58294449f422e51bc802b5599e7d4290f09587
#. default-sha256: 203c0f53640705e04cefa73d173d2470c1755c773820c6f45ee7a607176feee2
msgctxt "scenario7:scenario7_4192695C_CD64_45F6_B7B2_D9385A7FEC77"
msgid "⟪k:0⟫When you arrived at this house... ⟪k:1⟫I felt the hands of fate at work."
msgstr "⟪k:0⟫あなたが屋敷に訪れて――運命を感じました。"

#: scenario7:scenario7_81463A50_FEBD_4A7A_9C7A_E2EC0C6BCF0C
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: d792b10c52e8d2c619e1ff571a469e40f268d56043205be9a8aba52e8dee38a7
#. default-sha256: 8ec20d306f51a43c820277525f0ef74789dbbe9a9b6bffda50de333c27a17aa3
msgctxt "scenario7:scenario7_81463A50_FEBD_4A7A_9C7A_E2EC0C6BCF0C"
msgid "⟪k:0⟫You’ve been through so much to get here..."
msgstr "⟪k:0⟫それまで多くの辛いことがあったのでしょう……。"

#: scenario7:scenario7_D858E240_F039_447C_B1C0_07C43C90FB4C
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 4ff5f4597d7bed86e91130d4a0a8b83f0f3001fd26b89193f9885adf48be0f74
#. default-sha256: 59f6bab3ff119affea2e7ea1df5714da3d215dc0858cc667c8fd773ab4465ef4
msgctxt "scenario7:scenario7_D858E240_F039_447C_B1C0_07C43C90FB4C"
msgid "⟪k:0⟫I know your pain."
msgstr "⟪k:0⟫私はその痛みを共有することが出来る。"

#: scenario7:scenario7_A1F30229_A70F_4449_B9EA_47D4032BAEA2
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 47ef302b7325cd3b08b673e670746c20218143e1025346e19a7266c80c28e8b4
