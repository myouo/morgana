msgctxt "scenario7:scenario7_E693A7E3_F555_4086_BBE8_BDB52E3857CF"
msgid "⟪k:0⟫It was empty."
msgstr "⟪k:0⟫そこに――⟪k:1⟫何もなかったのだ。"

#: scenario7:scenario7_D33AF05A_D351_474B_AC22_EB755E2EBFAD
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: e506b02f6c2b985f4b4e0e7ca1ad523c39ca857f5197197b5c65be614bc1928f
