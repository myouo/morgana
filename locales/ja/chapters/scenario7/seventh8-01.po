msgctxt "scenario7:scenario7_C9983542_4050_4C4B_8BDE_1D60BA4A957C"
msgid "⟪k:0⟫............"
msgstr "⟪k:0⟫…………。"

#: scenario7:scenario7_F26DF4E0_B5F5_4A9A_AADA_023B06F5F5DA
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: ce9119aaa4ee4520280cb33a18322eb2d81948db05aa9b99d599ef67055f1bc8
#. default-sha256: 318c6172067672772a0c265b1b0afef887196f854fcb7521645b5c77ff2b29ed
msgctxt "scenario7:scenario7_F26DF4E0_B5F5_4A9A_AADA_023B06F5F5DA"
msgid "⟪k:0⟫Tell me who you wish to curse...⟪k:1⟫⟪k:2⟫and I can lead them here."
msgstr "⟪k:0⟫あなたが呪いたい人を教えてくれれば……、⟪k:1⟫私はきっと……その人を導けますから。"

#: scenario7:scenario7_5455BC8D_74CC_4A29_9CA7_A75AD3ED4949
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 5f6ef2bd8e74e9affb947cce57f0967b25a3532a948bd8406818c4a353f56da0
#. default-sha256: 2df96b59270ac3f5bc74d78cd39c68cb12d1e0d229f4ad2ece01359fc0ccc511
msgctxt "scenario7:scenario7_5455BC8D_74CC_4A29_9CA7_A75AD3ED4949"
msgid "⟪k:0⟫I can force the cross you were made to bear onto them."
msgstr "⟪k:0⟫そして……あなたが背負ってきた不運を、⟪k:1⟫その人に押し付けることが出来る。"

#: scenario7:scenario7_DCB2D6AB_E33F_4477_9CBE_4AB12A0CCD9A
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 5895d0809f0b47fc597e7c72ee135b4e2f314c19b3b18461743a71aee0027bac
#. default-sha256: aefb091c53459d80a34febc07b05b8f6e1ad5c363c23167c4fd05ace4db758a8
msgctxt "scenario7:scenario7_DCB2D6AB_E33F_4477_9CBE_4AB12A0CCD9A"
msgid "⟪k:0⟫Georges..."
msgstr "⟪k:0⟫ジョルジュ……⟪k:1⟫兄さんを……。"

#: scenario7:scenario7_CD0DCF14_1A13_4F5B_8915_D36D67C12D3C
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: f367fccf078f3806ca1e090e63548c9f1ed338fe91acc38929bb028ee753e21a
#. default-sha256: 483e6912ba9dfcc12065d475491006c6dac3189bb2de3ce607dfee89b332ef87
msgctxt "scenario7:scenario7_CD0DCF14_1A13_4F5B_8915_D36D67C12D3C"
msgid "⟪k:0⟫Shall we kill him?"
msgstr "⟪k:0⟫殺してやりましょうよ……。"

#: scenario7:scenario7_0A5F76DF_0B8B_46B1_A2CA_DA1DDCF29E00
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 570ccc1e8ed69203d6e4bfb1b0a71d7f7fe34c8169ef386f85646524ac0869f1
#. default-sha256: 21d4a587e158ecc3c56e9fd5faf186b0babcb6d9b9b28e3da73a78dd54e2d675
msgctxt "scenario7:scenario7_0A5F76DF_0B8B_46B1_A2CA_DA1DDCF29E00"
msgid "⟪k:0⟫He deserves at ⟪k:1⟫least⟪k:2⟫ that.⟪k:3⟫⟪k:4⟫He brought you more than enough pain."
msgstr ""
"⟪k:0⟫それだけの報いを受ける必要があるでしょう？⟪k:1⟫⟪k:2⟫ねえ……、⟪k:3⟫あなたにあれほどの痛みを与え"
"たんですもの。"

