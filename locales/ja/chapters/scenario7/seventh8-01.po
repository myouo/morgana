msgctxt "scenario7:scenario7_1F16E57D_9149_4683_A6EF_EE377EEF2BDD"
msgid "⟪k:0⟫You made this possible..."
msgstr "⟪k:0⟫あなたのおかげで……⟪k:1⟫私は……"

#: scenario7:scenario7_38463CB7_E401_467F_9703_51F921B5D5D9
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 92c449ef6afbc51d8f8109d8db17f731380e192bb72417cbd76cb7b336cb55a6
