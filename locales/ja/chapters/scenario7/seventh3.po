msgctxt "scenario7:scenario7_8EE36FF4_3BBA_47F2_98F5_3049A87697ED"
msgid "⟪k:0⟫Whenever I would drift off to sleep, I would hear the sound of my own joints creaking."
msgstr "⟪k:0⟫眠りに落ちると骨の軋むような音が響いて――"

#: scenario7:scenario7_B57FDB2E_A93D_47EA_8BE2_90D44DD03B33
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: d0d91d72a4891387fbb5c1f94010e94117b3a6bd63fb8be2c8ad22a94aaf58da
