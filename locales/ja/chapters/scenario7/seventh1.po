msgctxt "scenario7:scenario7_7B2E246B_09D9_4CC7_BC27_FC94313AEFE1"
msgid "⟪k:0⟫Nevertheless, the Bollinger family name was upheld by Didier."
msgstr "⟪k:0⟫それでも、⟪k:1⟫ボランジェ家の名誉を守るのは、⟪k:2⟫長兄だった。"

#: scenario7:scenario7_AD1B4A28_CEB0_442E_8EF3_BFF5A855B1B6
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: e2a00dc4460e5b91e82b69204009c37ac23078398c16d0b829f4448e4f1f040e
