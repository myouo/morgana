msgctxt "scenario7:scenario7_154C9031_3418_4249_8289_BA9B04115CA1"
msgid "⟪k:0⟫to have you in my life, always nearby."
msgstr "⟪k:0⟫そう思っていたはずだった。"

#: scenario7:scenario7_FF73576A_7E96_4468_B183_07FA2C041689
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: ca82d9b7897bd37912acc3c4be56ff154ac418985c67089cfedea3ab774ab5db
