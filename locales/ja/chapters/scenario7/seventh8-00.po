msgctxt "scenario7:scenario7_8A86B1D0_BF72_47AB_BA59_0FE2F2EFE272"
msgid "⟪k:0⟫Enticingly so."
msgstr "⟪k:0⟫私をいざなう。"

#: scenario7:scenario7_CCCBCFB1_6548_4761_A7EB_DD6CF25A2928
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: c1b0998f7e452048c9d5a4951b8cf9317094207a20d8fe73a22189a7d956a9e6
