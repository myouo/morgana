msgctxt "scenario7:scenario7_CE2C3D9A_0F22_4351_83D0_38C93BCABC0D"
msgid "⟪k:0⟫And nothing else."
msgstr "⟪k:0⟫それだけだった。"

#: scenario7:scenario7_3905A0DF_5399_40E6_89EA_481CCE30AF81
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: b1bff2907847ab4c3307d4d35a848fb5f5c2a92566f460588abfddeea6878fa0
#. default-sha256: dd387fa5b5ff59f6df386a2701e12fa54568c731bd0dbe45eaeb802fd86d8614
msgctxt "scenario7:scenario7_3905A0DF_5399_40E6_89EA_481CCE30AF81"
msgid "⟪k:0⟫Thank you... ⟪k:1⟫for opening the door."
msgstr "⟪k:0⟫ありがとう……、⟪k:1⟫扉を開いてくれて。"

#: scenario7:scenario7_D7BF15E8_BDB8_49BE_9389_3050755E9FC2
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 0f9078933659d22dc5a2e72d9262dbe7eb391f62868d26d22b1cb22893d04e05
#. default-sha256: 068a2ca72d2d60c80a0a343f38dd2c1409a60c71af3f1c524ebd0b4d1dcc2915
msgctxt "scenario7:scenario7_D7BF15E8_BDB8_49BE_9389_3050755E9FC2"
msgid ""
"⟪k:0⟫The skeleton, which had been sitting there as long as I had been at this house, had vanished "
"without a trace."
msgstr "⟪k:0⟫ずっと在り続けた白骨死体が、⟪k:1⟫忽然と消えていた。"

#: scenario7:scenario7_C1990B51_6F38_4EE4_9AB4_3AA0E740A217
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: c95040db018af247c7fa14eea278e75988d96aab5bec7b0867e6b6fb78e1a675
#. default-sha256: 2ad0a206b39d2ad1b54254d4c1a7d582dbccd696e56b80370fcfd5ccce62a4c7
msgctxt "scenario7:scenario7_C1990B51_6F38_4EE4_9AB4_3AA0E740A217"
msgid ""
"⟪k:0⟫I spun around, my gaze darting back and forth across the chamber,⟪k:1⟫but there was no one "
"there—"
msgstr "⟪k:0⟫周囲を見渡し、⟪k:1⟫後ろを振り返る。⟪k:2⟫けれど人の姿は無く――"

#: scenario7:scenario7_3717CEB8_6B08_4EF7_A689_0AE58EACA40A
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: a5b1a9096511274f3b2ce41fa9aeef9c9dce692e415723cf83fe277dd4c684a0
#. default-sha256: 403deeee513ee3b6428b6dd46e5de6f9bd5e956fa65f52dc1ed4098d0bb5a885
msgctxt "scenario7:scenario7_3717CEB8_6B08_4EF7_A689_0AE58EACA40A"
msgid "⟪k:0⟫⟪k:1⟫You gave me the chance to have my revenge."
msgstr "⟪k:0⟫⟪k:1⟫私は―――復讐することが出来る。"

#: scenario7:scenario7_5C785F31_06F7_4173_9DE7_2858777CFD91
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 81e1aac58aeb86b6e268106f99a5c59d7e65b14c8cafbd14148e304431302b8c
#. default-sha256: e56f159c7e97643a05b5b5d3f2c3e195e508d75fc1b1a88c0383d7b927c4fb2d
msgctxt "scenario7:scenario7_5C785F31_06F7_4173_9DE7_2858777CFD91"
msgid "⟪k:0⟫Revenge...?"
msgstr "⟪k:0⟫……復讐……。"

#: scenario7:scenario7_17FE593C_D11B_4B3A_9B4A_FF51BD304787
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: e0b9a95658aa71498ae03e9918ab04ae11f30ef18fb2211cd1bddd09e50609f0
#. default-sha256: 855927db28232e7e3fecb836f822bb48b3e5a258a0c9803eb1d26c9e7aef4e37
msgctxt "scenario7:scenario7_17FE593C_D11B_4B3A_9B4A_FF51BD304787"
msgid "⟪k:0⟫Now, I can make those men suffer a hell even worse than the one they put me through..."
msgstr "⟪k:0⟫私を奈落の底へと叩き落としたあの男たちに……⟪k:1⟫⟪k:2⟫私が味わった以上の絶望を……"

#: scenario7:scenario7_7C059B14_A129_4954_80FC_3C436FFA9B93
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: da200bbc5647d1e697b7668ffa92cf31ff1ff5c12830c7684d5532579ec90de1
#. default-sha256: b723dbd507b2e5830058ab322eceb7839e0551daf073a2908093bbde30ae6072
msgctxt "scenario7:scenario7_7C059B14_A129_4954_80FC_3C436FFA9B93"
msgid "⟪k:0⟫Hah... ⟪k:1⟫haha... ⟪k:2⟫hahaha..."
msgstr "⟪k:0⟫ふっ、⟪k:1⟫……ふふ……⟪k:2⟫ふふふ………。"

#: scenario7:scenario7_A4FDA90C_FB78_4D12_9A5B_61011E6CB9DD
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 743081692e6ead640b3effe1be7dbb1501880b666b951b52b9d09d39612f09bc
#. default-sha256: 44528ef81bb70e5d399b8a1fbe20d4a58d91188d63082e79bcedd4e6ed42fe05
msgctxt "scenario7:scenario7_A4FDA90C_FB78_4D12_9A5B_61011E6CB9DD"
msgid "⟪k:0⟫Ahahahahahaha..."
msgstr "⟪k:0⟫あはははははは…………。"

#: scenario7:scenario7_E057D1CB_B59B_439E_AE89_1CA6201F6CE0
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: bf641f2a2adea23d3acda6a1bb4496c5d8a3f5cc9a329add3db6d4a8a62a6515
#. default-sha256: 44d7a386b2da91789e3952f6219ccaf25d35a7795c8ec47615f5c0b8e14841c2
msgctxt "scenario7:scenario7_E057D1CB_B59B_439E_AE89_1CA6201F6CE0"
msgid "⟪k:0⟫Oh, you poor dear. They locked you up here without telling you whose house it was?"
msgstr ""
"⟪k:0⟫それも知らないで、⟪k:1⟫この屋敷に閉じ込められたんですか？⟪k:2⟫⟪k:3⟫ああ……本当にかわいそうな人"
"ね……。"

#: scenario7:scenario7_D110955E_8C94_4B5F_8B3B_023D2D661687
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 21e98707f7e8095c0d0acdc99770bd0475865466f09154bf45aa7774f84fc42b
#. default-sha256: 2eba971fc69b4c3408af01ad9efa8547fedc5610c1abb154f0b070ef30195f55
msgctxt "scenario7:scenario7_D110955E_8C94_4B5F_8B3B_023D2D661687"
msgid "⟪k:0⟫You sad, pathetic thing...⟪k:1⟫⟪k:2⟫Though that’s exactly the kind of person I needed."
msgstr "⟪k:0⟫本当にかわいそう……、⟪k:1⟫だからこそ……良かったのだけど。"

#: scenario7:scenario7_021FDB46_4407_4465_A38D_7CB739227033
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: ffcd679eb6cf044183e165b2dc84969996ba2fb09b452d04ae38c8178fcc81f2
#. default-sha256: a0d76de9a7aa937656e6c62fd771544069674fcc23c48f5914676fb2c3a13b13
msgctxt "scenario7:scenario7_021FDB46_4407_4465_A38D_7CB739227033"
msgid "⟪k:0⟫You’re... ⟪k:1⟫You’re not the witch, are you...?"
msgstr "⟪k:0⟫……まさか……、⟪k:1⟫本当に……魔女なのか……。"

#: scenario7:scenario7_628FA3F9_73B9_45FC_9FBF_59CF1C8441D7
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: f8a0ad8ea08703bfa4bcdc391c24c13480484271a7eae2bb03f2de9da295c942
#. default-sha256: 136f6f38de40b0d7bbbb9de562bf9dd5c10f22bfc210830f5f37b0827471146b
msgctxt "scenario7:scenario7_628FA3F9_73B9_45FC_9FBF_59CF1C8441D7"
msgid "⟪k:0⟫I assumed... ⟪k:1⟫the witch was nothing but a legend. A tale..."
msgstr "⟪k:0⟫……魔女など……ただの迷信だと……、⟪k:1⟫作り話だと、⟪k:2⟫思っていた……。"

#: scenario7:scenario7_AD899BFA_FFBD_4B11_9952_AADF7BCE7E87
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 1e845b4450af6db59a407532bb0e06503560130d33c0aecc59dc4dad2147afc4
