msgid "⟪k:0⟫⟪k:1⟫⟪k:2⟫............"
msgstr "⟪k:0⟫⟪k:1⟫⟪k:2⟫…………。"

#: scenario4:scenario4_BE10CFE3_211A_4E34_88DD_5AB38D5D4A1B
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: ffac68121280fd6a99dae8aec331024e6983ecb451a93b7c41463460c99c9901
