msgctxt "scenario6:scenario6_5ECC5EC6_1C2A_4C00_8926_9D15828AFB8B"
msgid "⟪k:0⟫............"
msgstr "⟪k:0⟫…………。"

#: scenario6:scenario6_7B26F9EF_ABA1_4645_A700_F7B61B22ED50
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 53267f082237287ce89c6f8287a43be1fecda1d0a95e123836e14e2b86ea4153
#. default-sha256: 1e4167bbfb7b6869e11e8a5060e0ef2de7a756d6af7b8c14d1cc61a7aa14c0bc
msgctxt "scenario6:scenario6_7B26F9EF_ABA1_4645_A700_F7B61B22ED50"
msgid "⟪k:0⟫Now go on.⟪k:1⟫⟪k:2⟫I’m quite looking forward to this..."
msgstr "⟪k:0⟫さあ、⟪k:1⟫行きなさい。⟪k:2⟫楽しみにしていますよ……。"

#: scenario6:scenario6_C3C24115_B057_484A_BDCF_F58B0F781072
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: ea0379abd2c4e29ac353f07badabe55f404fc2ed3b8c29f0eaf8059fd410636a
