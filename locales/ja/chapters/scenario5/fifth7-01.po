msgid ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫Perfect darkness embraces us once more.⟪k:4⟫⟪k:5⟫I can see nothing—⟪k:6⟫⟪k:7⟫"
"not even the woman beside me—"
msgstr "⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫目の前すら定かでない、⟪k:4⟫本当の暗闇が、⟪k:5⟫再び私たちを覆い隠す。"

#: scenario5:scenario5_A6033E7A_86D1_4124_8A68_8D00A54D929B
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 564baa101144bd624ecfc35420be026567d1483226ea382372aefcedcac753ba
#. default-sha256: 0ce597829bf5a0191b15b0f8796db253e8b62148ce6182983ef3a984d0d88be3
msgctxt "scenario5:scenario5_A6033E7A_86D1_4124_8A68_8D00A54D929B"
msgid "⟪k:0⟫but I shall not let go of her hand."
msgstr "⟪k:0⟫けれど――、⟪k:1⟫決してこの手は離さない。"

