msgctxt "scenario5:scenario5_ADC1683E_0503_4966_AC64_A863666C520E"
msgid "⟪k:0⟫Do you remember when I first arrived here?⟪k:1⟫⟪k:2⟫When I was cleaning the library..."
msgstr "⟪k:0⟫最初の頃のことです。⟪k:1⟫わたしが書庫の掃除をしていて……"

#: scenario5:scenario5_85A28BB8_B353_4F11_AEF1_689B0850595B
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: b7448cc1f6aa3e1653edefff78578b81d091b32c6211707d4b9868ba45796247
