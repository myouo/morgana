msgid "⟪k:0⟫............"
msgstr "⟪k:0⟫…………。"

#: scenario5:scenario5_9FB03DE8_0D5D_4717_8FB2_F44670EFEC03
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: e448d2f3089f60d40fccd36ad6f9d51bce5eb574e14f3024abcb9a3cb759ac7d
