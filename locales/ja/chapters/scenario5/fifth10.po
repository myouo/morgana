msgctxt "scenario5:scenario5_819B68D7_8CBF_4ED6_8349_253CF4B86714"
msgid "⟪k:0⟫Oh, you’re such a cynic..."
msgstr "⟪k:0⟫もう、⟪k:1⟫夢がないんですから……。"

#: scenario5:scenario5_84935AD8_6A66_4484_A1FB_C41426A58610
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 8e00ae86e7300b7351767cda1796b9cad3a7bb1d07c7e49aee0596cde3c3b56b
