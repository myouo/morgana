msgctxt "scenario5:scenario5_285A114B_CE40_48E8_A101_D05970835748"
msgid "⟪k:0⟫Besides..."
msgstr "⟪k:0⟫それに………。"

#: scenario5:scenario5_8A74422A_EB14_4C1B_9C52_8A4D968F7929
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: ea0379abd2c4e29ac353f07badabe55f404fc2ed3b8c29f0eaf8059fd410636a
