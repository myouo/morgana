msgctxt "scenario5:scenario5_E6E9EE2F_B390_4656_B00F_C3A012929933"
msgid "⟪k:0⟫That was why I was afraid of men shouting."
msgstr "⟪k:0⟫だから、⟪k:1⟫わたしは……男の怒声が怖い。"

#: scenario5:scenario5_9195DB89_6797_4324_B511_9CEC5DAD8063
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 74675f2a6cb8201279dc1f9805b307136b594a7573c9b132314e411a8d0eaa36
