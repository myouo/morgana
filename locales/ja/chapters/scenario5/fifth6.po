msgid "⟪k:0⟫That was why I was afraid of knives."
msgstr "⟪k:0⟫だから、⟪k:1⟫わたしは……刃物が怖い。"

#: scenario5:scenario5_E6E9EE2F_B390_4656_B00F_C3A012929933
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 9f72fa6ff80590ab7dc208d9874e640a0e3b969f3ef382f12b73e65b2c0d2a0f
