msgid "⟪k:0⟫⟪k:1⟫........................"
msgstr "⟪k:0⟫⟪k:1⟫……………………。"

#: scenario5:scenario5_49D5E257_54BA_4E32_B22D_FB6A2A431C0E
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
