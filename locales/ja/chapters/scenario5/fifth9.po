msgid "⟪k:0⟫⟪k:1⟫............"
msgstr "⟪k:0⟫⟪k:1⟫…………。"

#: scenario5:scenario5_3E162B84_873A_4674_91CC_E3B88D707B3F
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 66b1a391a9855903a3b44b51dc20e426bd9f43876e8eb55eb699191fe5cae94e
#. default-sha256: 07740c82775f253d652c33eaa6eec89b32074487fcec23d9145324c637220081
msgctxt "scenario5:scenario5_3E162B84_873A_4674_91CC_E3B88D707B3F"
msgid ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫Could you please tell me... ⟪k:3⟫what you did at—⟪k:4⟫⟪k:5⟫⟪k:6⟫no, what was done "
"to you at my family’s home,"
msgstr ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫教えて……もらえますか。⟪k:3⟫貴女が私の家でおこなったこと――いや、⟪k:4⟫されたことと言"
"うべきか……"

#: scenario5:scenario5_9C3B4E45_04D7_436C_93E2_3859E3D15729
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 01e215cc063e3218e7a13df1491c17732f243dc27bf64fdf32dd0ea8e21e7dd2
#. default-sha256: e57cc8f5d38222627f90b6dccd76c793d1feac7ed8b977d76a1f8f252d2a96ae
msgctxt "scenario5:scenario5_9C3B4E45_04D7_436C_93E2_3859E3D15729"
msgid "⟪k:0⟫how you ended up coming to this mansion,⟪k:1⟫and what happened after you left?"
msgstr "⟪k:0⟫それから……なぜ私の元に訪れるようになったか。⟪k:1⟫この館を離れて何が起きたのか……"

#: scenario5:scenario5_9DE87E9A_C5CB_4993_AD68_3A37ED68FDA5
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 731636788e465bda7d50fd900a5ebda1c7d9026915851430c5eb31e184fc2dc8
#. default-sha256: 5fbc987c328a0e837bc5289858c23c8f8c1a4c17dea7fb0934fedbb29a20ad27
msgctxt "scenario5:scenario5_9DE87E9A_C5CB_4993_AD68_3A37ED68FDA5"
msgid "⟪k:0⟫I would like to know everything, from start to finish."
msgstr "⟪k:0⟫ひとつずつ……、⟪k:1⟫すべてを。"

#: scenario5:scenario5_306526DD_A850_4383_BF7C_F5A824839349
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
