msgid "⟪k:0⟫⟪k:1⟫⟪k:2⟫............"
msgstr "⟪k:0⟫⟪k:1⟫⟪k:2⟫…………。"

#: scenario5:scenario5_22848201_EC36_45E5_986B_B9A9D1A7BF9A
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 8f50dff6a9c653a5da9d425f90688b0023c8c7e99ce7dc7b1b7cc8b846f7f474
