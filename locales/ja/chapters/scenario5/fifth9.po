msgctxt "scenario5:scenario5_4CB3629A_C22C_48AF_B79D_4760DD361590"
msgid "⟪k:0⟫I had to do it,"
msgstr "⟪k:0⟫問わなければならない……。"

#: scenario5:scenario5_D831D3C4_8153_499F_8E4E_3289F4DFA12D
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 8ab8f565445cf422a305f40fa020066b56eceb848d844f5c3fae2bfe6f6265d0
#. default-sha256: b249b98d0fd5e1f06d343521967c99d37b878c919e34f7b10d5cd56c33f13da1
msgctxt "scenario5:scenario5_D831D3C4_8153_499F_8E4E_3289F4DFA12D"
msgid "⟪k:0⟫even if down that road lay truths I would be happier not seeing."
msgstr "⟪k:0⟫そこに、⟪k:1⟫私の知りたくもない真実があったとしても――"

#: scenario5:scenario5_11AD9665_548E_4721_9E8C_08EE36F08894
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: b4d1e54d87ea054269dc9d89176022e099ca8a1b6eed1d72a937c16cf6abb66b
#. default-sha256: dec6d9e56b3886964f9a4f5693b2e72b6510b6527c702113ecc857fbf757e64d
msgctxt "scenario5:scenario5_11AD9665_548E_4721_9E8C_08EE36F08894"
msgid "⟪k:0⟫⟪k:1⟫⟪k:2⟫Giselle..."
msgstr "⟪k:0⟫⟪k:1⟫⟪k:2⟫……ジゼル……。"

#: scenario5:scenario5_7426F5EF_9110_47F0_A693_0D4F57D7DD4E
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: c805c00fc2a3b452f069c4379c82c8a38b506d7fb521999255e5f411f2caf455
