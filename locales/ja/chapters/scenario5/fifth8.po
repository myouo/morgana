msgctxt "scenario5:scenario5_D8D799E7_FF18_48BA_B6E3_2BE52A033C20"
msgid "⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫⟪k:4⟫were like two blazing infernos staring out across the mob."
msgstr "⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫⟪k:4⟫燃える火炎のように揺らめく、⟪k:5⟫赤い瞳だった。"

#: scenario5:scenario5_C3378308_A7A1_4887_A697_04438710BFDE
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 6c18b0bdb1501ee4ad3b72df4df4750f5ed868edde57fa293de65e074fb9fac7
#. default-sha256: e6cc853b6c86f04c58b4b6f9b50a2bcafc7da25af1f91e1e041b6274c0f5a1a7
msgctxt "scenario5:scenario5_C3378308_A7A1_4887_A697_04438710BFDE"
msgid "⟪k:0⟫⟪k:1⟫...A-⟪k:2⟫A demon..."
msgstr "⟪k:0⟫⟪k:1⟫………あ、⟪k:2⟫悪魔だ………。"

#: scenario5:scenario5_BFA40E06_D27F_497F_B8CF_AE295E4DD6A5
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 72ece3d912893a9fa6ee7da46808e52ec8eb96eb859ea4a9ffa963fdc29423a1
#. default-sha256: ad791ec2f04eee4224de00a9c9d64a783c93ffc3d9794d5d8f9e6b38c7085b08
msgctxt "scenario5:scenario5_BFA40E06_D27F_497F_B8CF_AE295E4DD6A5"
msgid "⟪k:0⟫Someone muttered, probably unconsciously."
msgstr "⟪k:0⟫誰かが、⟪k:1⟫そう、⟪k:2⟫自失したように呟いた。"

#: scenario5:scenario5_82BBF69C_0AA9_4DFA_BC35_4C07A8FFD1EB
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 984074846d4cf390d666d12da445885d8379b84569b50ef652974a2ab703cb85
#. default-sha256: 75a57e940d81615d6cdc17fb43ff321d9b057803de0674ba03adfad4f2501b5c
msgctxt "scenario5:scenario5_82BBF69C_0AA9_4DFA_BC35_4C07A8FFD1EB"
msgid "⟪k:0⟫He did, indeed, look like something not of this world."
msgstr "⟪k:0⟫まさしくその人の容貌は――、⟪k:1⟫人ならざる者のように、⟪k:2⟫見えた。"

#: scenario5:scenario5_4E2AFB9D_7BB0_47E8_9C5E_82973E743E92
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 62cb38004a3e7dc4d70b49c045072bbbe2a8c2e812da5c5980ff5cd02ea77156
#. default-sha256: 424f2bb337591294bbb901f33c26c5edbf2fffddaf2a8c53fcba032957dbd847
msgctxt "scenario5:scenario5_4E2AFB9D_7BB0_47E8_9C5E_82973E743E92"
msgid "⟪k:0⟫Aaah, ⟪k:1⟫i-⟪k:2⟫it’s a demon!⟪k:3⟫The rumors about this place were true!"
msgstr "⟪k:0⟫ああ、⟪k:1⟫あ、⟪k:2⟫悪魔だッ！　⟪k:3⟫本当だったんだ！　⟪k:4⟫呪われた館の話は……！"

#: scenario5:scenario5_4D6A6178_F6D8_4178_A294_DC884CA04616
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 92692dcbb82173ffd49d6b9a2e13d3608a2ce61d9b99a3aadb18fffd0acfdde8
#. default-sha256: ffef21709bd552a16a2b123f041fcfd90db03c4bdec624d64a70e19d5aec7a54
msgctxt "scenario5:scenario5_4D6A6178_F6D8_4178_A294_DC884CA04616"
msgid "⟪k:0⟫A cursed demon lives there!"
msgstr "⟪k:0⟫呪われた悪魔だッ……！！"

#: scenario5:scenario5_B3899674_34FA_4458_A891_DA3A390A1B3D
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: d4c2bbce642c313f02758d4c478af5abba0bdd6a6c65ae38687ac3e4815c1f92
#. default-sha256: 2af641e0fa6b87e2751392b6cb1a6d11e320ad3c52f10e881ab853b9094c0627
