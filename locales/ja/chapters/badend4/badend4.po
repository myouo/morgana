msgid "私だけが、⟪k:0⟫暗闇に落ちていく。"
msgstr "私だけが、⟪k:0⟫暗闇に落ちていく。"

#: badend4:unlabelled:badend4:12
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: c0b4b7fcad493f40361bea48f3ff6c46a329cacdf83e0862bd830519921a6e5a
