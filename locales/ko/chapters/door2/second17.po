msgctxt "scenario2:scenario2_D5C20E2C_69BF_4D9B_9A13_9C315EB5C891"
msgid "⟪k:0⟫(Why now?!)"
msgstr "⟪k:0⟫(왜 하필 이럴 때!)"

#: scenario2:scenario2_7593BC16_F5B2_438F_B584_D8EF2AE2BF5B
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 314ec620387b6cb654ecfaeb0dd73591e2fc8bd66ce43eb275340fd8a86ef0e5
#. default-sha256: 4b58558c04195947a100d611949869e1287909237f8cab0dbaa06a3b661a2fef
msgctxt "scenario2:scenario2_7593BC16_F5B2_438F_B584_D8EF2AE2BF5B"
msgid "⟪k:0⟫(Why when I’m not there?!)"
msgstr "⟪k:0⟫(왜 하필 ⟪k:1⟫내가 저택을 비운 지금!!)"

#: scenario2:scenario2_C6C6ECE2_2B57_46AC_A2C5_74301BE9D85F
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: dea90c2cde04ebd8efe6cdbc4f1ebf739274fdd629a5ac27a9792c793df8a0ac
#. default-sha256: efd679eb3f5f3d83beb0d968179b6e7c214784a541fdf07c0b6fc1a6ccd40252
msgctxt "scenario2:scenario2_C6C6ECE2_2B57_46AC_A2C5_74301BE9D85F"
msgid "⟪k:0⟫(I’m the beast! I’m right here!⟪k:1⟫I’m what you’re trying to hunt!)"
msgstr "⟪k:0⟫(짐승은 나다! ⟪k:1⟫여기 있다! ⟪k:2⟫너희가 퇴치할 건 나라고!)"

#: scenario2:scenario2_D2BEC6D3_699C_41E5_9FBA_8B3545211A76
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 207b9ad29f94a69eab2ef205aa78a2854d4a839e36a194cdc7b04c8bc51211d0
#. default-sha256: 36bbb469164902fb279fc3ad1ce5dce5545f7ee2cc1602fb70b4ecf59c1da60d
msgctxt "scenario2:scenario2_D2BEC6D3_699C_41E5_9FBA_8B3545211A76"
msgid "⟪k:0⟫(The only person at the mansion right now...)"
msgstr "⟪k:0⟫(지금―― ⟪k:1⟫저택에는――)"

#: scenario2:scenario2_2629E980_D7C8_4B51_A9D5_D2680983321A
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: bd1c410182f6fd0fff96f61f6330328155b1dac3bbd5ca4ff6fdeff40be0826f
#. default-sha256: 94c810a60bdb8ca343a78af1a616218779301d17872b1eaf94b1b6fdb90e2651
msgctxt "scenario2:scenario2_2629E980_D7C8_4B51_A9D5_D2680983321A"
msgid "⟪k:0⟫(⟪k:1⟫is her⟪k:2⟫!)"
msgstr "⟪k:0⟫(그 여자밖에 없어……!!!)"

#: scenario2:scenario2_DF6C6484_6706_4CE3_A3A2_27129A4FA96B
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 5520213ea57ae8f3e4d91e14dfea698494b74d8a69662210d2878257352fb724
#. default-sha256: 3040909dd1c875dec61dc3f1d41e53f3f9718a02f5ac1e38187e60b334743129
msgctxt "scenario2:scenario2_DF6C6484_6706_4CE3_A3A2_27129A4FA96B"
msgid "⟪k:0⟫⟪k:1⟫He regretted not asking the fruit vendor how long ago the party set off."
msgstr ""
"⟪k:0⟫⟪k:1⟫남자는 청과점 주인에게 ⟪k:2⟫남자들이 출발한 시간을 묻지 않은 걸 ⟪k:3⟫후회했습니다."

#: scenario2:scenario2_5D143F08_50F0_42D9_A80E_0EB3AE2B25D5
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: a2ce2bce2f9b881abc5e50db967174a47a382967dbc7fda025330ced8e8cc431
#. default-sha256: b373c185863a36ddd8df1c7ac681c4512aee3828b27a8ac131c0211907a12b6a
msgctxt "scenario2:scenario2_5D143F08_50F0_42D9_A80E_0EB3AE2B25D5"
msgid ""
"⟪k:0⟫Though what good would that knowledge have done him?⟪k:1⟫⟪k:2⟫He had to hurry back "
"regardless."
msgstr ""
"⟪k:0⟫하지만 묻는다고 무슨 보탬이 될까요.⟪k:1⟫⟪k:2⟫결국 서둘러야 한단 점은 ⟪k:3⟫변치 않는데 말이지"
"요."

#: scenario2:scenario2_3380BD21_7C7C_4798_84A2_08A06159DE42
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: f5fbf177b50bd3e77109cea3c3c2e865c0b18ce13e887408a8ca0ec22301abb2
#. default-sha256: 5095f46ce510763624773fb1580b31a8b5cff4b7cc4cec618bdb3272cbb5bf49
msgctxt "scenario2:scenario2_3380BD21_7C7C_4798_84A2_08A06159DE42"
msgid "⟪k:0⟫The sun was beginning to set, draping the surroundings in a deep blackness."
msgstr "⟪k:0⟫해가 저물어 ⟪k:1⟫주위는 칠흑빛 어둠에 잠겼습니다."

#: scenario2:scenario2_90DC954B_85AB_4D14_9969_34AE653F673B
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 2ad6c0bfbf50bf58d54b796ed72671829d32ffaab099063f19fcf4a17d68ee66
#. default-sha256: 45813ad38e735e2e640cb64048f26b31c78f7907ac1802d5593c5b78b06bf01e
msgctxt "scenario2:scenario2_90DC954B_85AB_4D14_9969_34AE653F673B"
msgid ""
"⟪k:0⟫As if to keep him from returning home, the night wrapped its hands around his head, covering "
"both eyes."
msgstr "⟪k:0⟫남자의 앞길을 방해하듯이 ⟪k:1⟫밤의 손길이 남자를 옭아매어 ⟪k:2⟫두 눈을 가렸습니다."

#: scenario2:scenario2_A3292FE9_7ACB_44F2_B5E3_E573DF8E53F4
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: b15bb818391f0b0202e617865096ffad39fa7f266b3cad6fdd4625458803bace
#. default-sha256: 732792a0240d59d11598d608841448af2a7abcbb97201d4350cc952a05e35777
msgctxt "scenario2:scenario2_A3292FE9_7ACB_44F2_B5E3_E573DF8E53F4"
msgid "⟪k:0⟫In what direction did he have to head to return to the mansion?"
msgstr "⟪k:0⟫저택은―― ⟪k:1⟫과연 ⟪k:2⟫어느 방향에 있을까요?"

#: scenario2:scenario2_3990E263_69AA_4FC5_88B9_662FEA8F802B
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: a76832559caf028153527633abd7fe6bbdd154e10c012954f36812d1132e7496
#. default-sha256: b679e7c2ecbfe6127921f51d4ba4a746bade6f504fe29a6798c294dbb0199514
msgctxt "scenario2:scenario2_3990E263_69AA_4FC5_88B9_662FEA8F802B"
msgid ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫He stormed through the forest, and eventually, the mansion appeared before him"
"—⟪k:4⟫⟪k:5⟫like the world fading into view after a dream. ⟪k:6⟫Bestia was a tempest in the night, "
"blowing through the overgrowth toward the house."
msgstr ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫숲을 질주한 끝에, ⟪k:4⟫남자 앞에 ⟪k:5⟫잠에서 깨어 마주하는 순간처럼 저택이 불"
"쑥 나타났습니다. ⟪k:6⟫남자는 어둠 속의 폭풍이 되어―― 달려 나갔습니다."

#: scenario2:scenario2_EA847C11_5B15_4355_86CC_D779D64DACF8
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: cc313b3ba465923b08cfd5dee7e462a8c2cbfd048490c0fb56d1b2381dde8ea7
#. default-sha256: 443a8f0a9a0cac852c0e3ee449499c0fd97c497380f11853f30a4988a729a3c4
msgctxt "scenario2:scenario2_EA847C11_5B15_4355_86CC_D779D64DACF8"
msgid "⟪k:0⟫Please! Please make it in time!⟪k:1⟫I... ⟪k:2⟫I need her!"
msgstr "⟪k:0⟫제발! ⟪k:1⟫제발, ⟪k:2⟫늦지 않았기를! ⟪k:3⟫내게는…… ⟪k:4⟫내게는 필요하단 말이다!"

#: scenario2:scenario2_C0B57555_892F_44C3_A7EB_F4ED713FB67B
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 66ba042e6861d50d55c160113e3c276588a7f8e5a6466c7adafb2b27f7dd05a2
#. default-sha256: 848bf1d3a592fa0c571902103cb48fd96b7811df77ebc8df3acc2b9309b28456
msgctxt "scenario2:scenario2_C0B57555_892F_44C3_A7EB_F4ED713FB67B"
msgid "⟪k:0⟫I need... ⟪k:1⟫the peace that she provides me!"
msgstr "⟪k:0⟫평온이……! ⟪k:1⟫그 여자가 주는 평온이!!"

#: scenario2:scenario2_AFBC4D9F_D3B4_42C7_8555_FF3FEECD0463
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: a5d5f7a2c96e0c5f273b29afec2416d1e4ca521b10c374e8865294dd7afa16e9
#. default-sha256: 9f4682adde14b36664b0dd4dfe51cc721d6090a3a5c5b6439ff365c51de1a32b
msgctxt "scenario2:scenario2_AFBC4D9F_D3B4_42C7_8555_FF3FEECD0463"
msgid "⟪k:0⟫The last thing I want is for her to die!"
msgstr "⟪k:0⟫그 여자만큼은 죽게 할 수 없어………!"

#: scenario2:scenario2_F701A115_9D6D_4503_8460_A05F96D323AF
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 7ad12792a10b0161aca7c53fa17c6d3042b704c38329bd7f3feaf157073968cf
#. default-sha256: d4d9997e76049cd41072c8ab09dbfe8362428fdced5bfe9cb4db3a385da4d437
msgctxt "scenario2:scenario2_F701A115_9D6D_4503_8460_A05F96D323AF"
msgid ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫In the blink of an eye, he was through the door, charging down the mansion’s halls."
msgstr "⟪k:0⟫⟪k:1⟫⟪k:2⟫그리고 잽싸게 문을 열어―― 저택 안을 뛰어다녔습니다."

#: scenario2:scenario2_661D5D51_C0CA_4BD0_AC8A_2B5045A5B24B
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 5ac93334ee2d8a2f9a5665c2ec600df9d7d5d2466bdafc0b9784203dfaf1e664
#. default-sha256: edc2c463727006ca150ed2a1e30d1b09efd5d26aa9a63350356484b62611bb8f
msgctxt "scenario2:scenario2_661D5D51_C0CA_4BD0_AC8A_2B5045A5B24B"
msgid ""
"⟪k:0⟫He could not sense anyone else inside, though. ⟪k:1⟫All he could hear was the ⟪k:2⟫"
"whoosh⟪k:3⟫ of the wind blowing into the house from somewhere."
msgstr "⟪k:0⟫하지만 ⟪k:1⟫인기척은 없었습니다.⟪k:2⟫⟪k:3⟫어디선가 ⟪k:4⟫바람만이 거세게 불었습니다."

#: scenario2:scenario2_F0F7C33E_EDE8_4694_BD76_088F43491772
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: e2caa145c4b596f6941dde42e722989ad014579724b5f14e9aba830249698448
#. default-sha256: 0669b6ea5a5080b6729cb346e76a779c4acb6b893fb8d6d6dac75f98877fc915
msgctxt "scenario2:scenario2_F0F7C33E_EDE8_4694_BD76_088F43491772"
msgid "⟪k:0⟫It seemed a window was open."
msgstr "⟪k:0⟫아무래도 창문이 ⟪k:1⟫열려 있나 봅니다."

#: scenario2:scenario2_C21968AA_3E68_475A_8CEE_41A366EBEB0E
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 9e7e856426a4a608eb82da5d212c010371d783f34414a9829c50dee63b4a9ba3
#. default-sha256: c13a9d3d645a183879ad1d105f3fd380e14a191c4310c8922241a55d08ce100b
msgctxt "scenario2:scenario2_C21968AA_3E68_475A_8CEE_41A366EBEB0E"
msgid "⟪k:0⟫Wh-⟪k:1⟫Where are you?!⟪k:2⟫⟪k:3⟫Where have you gone?!"
msgstr "⟪k:0⟫어, ⟪k:1⟫어디 갔어………! ⟪k:2⟫어디로 간 거냐!!"

#: scenario2:scenario2_31E7D424_9031_4349_99C9_8668A8D958A6
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: d647382859c69fe8ed360fb474ba4919deb464f8eda9a5007248f6a3e4b8e6f8
#. default-sha256: 62c4a5af6971f4d9c250e5e1ff6206aeca016edbfe2db680d169c7c08ab745b1
msgctxt "scenario2:scenario2_31E7D424_9031_4349_99C9_8668A8D958A6"
msgid "⟪k:0⟫Answer me!⟪k:1⟫Please answer me!"
msgstr "⟪k:0⟫대답――, ⟪k:1⟫대답해 다오……!!"

#: scenario2:scenario2_F19635B6_4DF0_4CA8_8611_FF8663DB2043
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 88ae799a9413c8a8a3d8cf23ae861b35ce708b5b7e2e04b71b1949d3c967cb9c
#. default-sha256: e771be946e8b0da02a04aa2318a6f93802d0e1e241879f64455bbe9623a8fbf4
msgctxt "scenario2:scenario2_F19635B6_4DF0_4CA8_8611_FF8663DB2043"
msgid "⟪k:0⟫××××××××!"
msgstr "⟪k:0⟫――――!!"

#: scenario2:scenario2_9F5ED5C7_5F2F_4620_A0B7_C83D518D27A8
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: be1741e6c742a7bfc4f0275a59f3bddb2f7dfb3b9b7bcb843112da9be253b517
#. default-sha256: d64b89fa254db89ca86bda0958541203efa664a1364ad2f21e25169043f1907c
msgctxt "scenario2:scenario2_9F5ED5C7_5F2F_4620_A0B7_C83D518D27A8"
msgid ""
"⟪k:0⟫He cried out the girl’s name, again and again, until his throat was sore and his voice "
"hoarse."
msgstr "⟪k:0⟫남자는 소녀의 이름을 불렀습니다.⟪k:1⟫⟪k:2⟫메마른 목소리로 ⟪k:3⟫수도 없이 불렀습니다."

#: scenario2:scenario2_60A663E3_24DA_499E_8804_9A1736A49032
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: e5dc94ce67406bc20358fe5e568584cf34fcb2350ce93e3460407f47d0300405
#. default-sha256: 2b4f60dcde2ff42812a9f6286cc7faa695cdae19ad7d005eae539d3dd14943bc
msgctxt "scenario2:scenario2_60A663E3_24DA_499E_8804_9A1736A49032"
msgid "⟪k:0⟫But she did not respond."
msgstr "⟪k:0⟫……하지만 대답은 없었습니다."

#: scenario2:scenario2_F951CE9F_5016_4688_AD9A_DB672D42CAE7
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 27485b523acfadea0f7f8bfbc00b935d275a50bb688c8b069504fc221cd01117
#. default-sha256: 79bda3c97e2744cffb1cb82d6a8874f5909c380f154d60c798767f6dce5c62cf
msgctxt "scenario2:scenario2_F951CE9F_5016_4688_AD9A_DB672D42CAE7"
msgid "⟪k:0⟫⟪k:1⟫⟪k:2⟫He rushed into her bedchamber."
msgstr "⟪k:0⟫⟪k:1⟫⟪k:2⟫남자는 ⟪k:3⟫침실로 들어갔습니다."

#: scenario2:scenario2_A0883191_4EEB_4AB9_BA3E_78EEB0B61F57
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 7a98a6ddc3936297194f0f71b703682a75da49ba9ba9bdd0e1a4a7c7d365a4a1
#. default-sha256: 25bfac46fc63c56cb6f36655daf84005e951d6681de665532981218b826ef346
msgctxt "scenario2:scenario2_A0883191_4EEB_4AB9_BA3E_78EEB0B61F57"
msgid "⟪k:0⟫Hahh! ⟪k:1⟫Hey...⟪k:2⟫⟪k:3⟫Hey! Hello?!"
msgstr "⟪k:0⟫큭………! ⟪k:1⟫……이봐……? ⟪k:2⟫……이봐! ⟪k:3⟫이봐!!"

#: scenario2:scenario2_8C3FE4E3_BD76_4716_ADA4_B7642D8011A6
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: df894adf45ce8f0bf3429f65d909ac13188479f099eeab42184284be9f5f603f
#. default-sha256: 600f0a96ef38092b3c666fb3961eaa07aac39bc0aab254c9eba42dee59cb8045
msgctxt "scenario2:scenario2_8C3FE4E3_BD76_4716_ADA4_B7642D8011A6"
