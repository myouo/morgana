msgid "⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫(The men... ⟪k:4⟫have banded together!)"
msgstr "⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫(짐승을……… ⟪k:4⟫죽이고자!)"

#: scenario2:scenario2_7F990A04_B888_44B6_8F84_E6AA3000DFEB
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 1232688a031b6f17e11dc226cb049d2ecbb8e9754f8eab5ad67f7a149ead64ae
#. default-sha256: 6c7246cf880ed432f11dd99ef3d35d4053a2a4d34265c65d44ba04b9454d2584
msgctxt "scenario2:scenario2_7F990A04_B888_44B6_8F84_E6AA3000DFEB"
msgid "⟪k:0⟫(And they’re going to kill the beast?!)"
msgstr "⟪k:0⟫(마을 남자들이 ⟪k:1⟫들고 일어섰다고―――)"

#: scenario2:scenario2_D5C20E2C_69BF_4D9B_9A13_9C315EB5C891
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: f353ece67841c035e901f48c965b7a27136b128b7fd0e57d3bada5d67ef3aad5
