msgctxt "scenario2:scenario2_D138DAE7_5A54_4526_8D38_E50F0F258A3D"
msgid "⟪k:0⟫The “beast” was a convenient skin for you to wear."
msgstr "⟪k:0⟫그렇기에―― ⟪k:1⟫당신 안에선 ⟪k:2⟫당신이 짐승인 게 훨씬 편했지요."

#: scenario2:scenario2_F4E49F3B_D9CA_427E_B899_1389FEB24806
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: f0d45f20d4c13b8fb48e3a6581e929d031418a28ec235449069ac0b327399455
