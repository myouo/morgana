msgctxt "scenario2:scenario2_BC12F9A1_5EF3_4F36_8B21_34156C856F89"
msgid "⟪k:0⟫⟪k:1⟫............"
msgstr "⟪k:0⟫⟪k:1⟫…………."

#: scenario2:scenario2_1F958433_A113_45F6_AE77_CC35BD0A3475
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: b57c9a6d2cb76e5eeb14758b10a172ef2967d4554ec0e2456246d9dbd11c7c48
#. default-sha256: c99dfe9334d6ce5db7090c0faaf6b12ed6ea77c0949c5afd497ccef41c601224
msgctxt "scenario2:scenario2_1F958433_A113_45F6_AE77_CC35BD0A3475"
msgid "⟪k:0⟫⟪k:1⟫⟪k:2⟫Do you get it...⟪k:3⟫⟪k:4⟫Do you ⟪k:5⟫finally⟪k:6⟫ understand..."
msgstr "⟪k:0⟫⟪k:1⟫⟪k:2⟫알겠냐고……, ⟪k:3⟫이제 알겠냐고……."

#: scenario2:scenario2_75D98767_DAFC_4C57_B4F1_53CD9A91B6F6
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 13b431f6871c0487909fa5d2d7816da7ce77adad2a4a859957e04c6a9ed1d7c3
