msgctxt "scenario2:scenario2_03D04C05_B7DF_4E7B_A9FB_9B8158470996"
msgid "⟪k:0⟫What a tragic man."
msgstr "⟪k:0⟫그나저나 ⟪k:1⟫참으로………"

#: scenario2:scenario2_C5845D39_5F76_4715_86EA_9803C2B8290F
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: bc9112b0115e622688d2717407d9256acb1ea1574f1aef90aacccdd57bac3566
