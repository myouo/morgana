msgctxt "scenario2:scenario2_BBE87457_07C0_4483_A0F1_BF17269574BD"
msgid "⟪k:0⟫You held these deep, constant urges to cause others harm."
msgstr "⟪k:0⟫아주 ⟪k:1⟫오래 전부터 ⟪k:2⟫남을 해치고 싶었지요……."

#: scenario2:scenario2_83059EA1_5DA0_4439_9CF7_8FDEC8492F2D
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 3d6ec70db407cf716ca6932144ee9841c5d62069acba7b19aed364325558368e
