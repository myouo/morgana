msgctxt "scenario2:scenario2_0E8D56ED_B04A_4486_8890_8D54FDBC5C4C"
msgid "⟪k:0⟫And you are welcome to stay the night, get some rest."
msgstr "⟪k:0⟫드신 후에……, ⟪k:1⟫하루 ⟪k:2⟫머물다 가시오."

#: scenario2:scenario2_6040F48C_740F_4AD2_9E2D_F4EA9507B988
