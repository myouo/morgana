msgctxt "scenario2:scenario2_8673E044_1B98_4FBC_BB7C_DC6901A79B14"
msgid "⟪k:0⟫⟪k:1⟫⟪k:2⟫Then... ⟪k:3⟫I suppose I shall take you up on your generosity."
msgstr "⟪k:0⟫⟪k:1⟫⟪k:2⟫그럼…… ⟪k:3⟫그래도 될까요……?"

#: scenario2:scenario2_4085474D_5FA7_4CF4_ABDB_FDCE6F5B07F2
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 6356d288f002a79af54cdbe4e5b7b750102c33381a02bb12a35b35dce253185e
