msgid "⟪k:0⟫It’s a pipe dream, this transcontinental railroad of yours."
msgstr "⟪k:0⟫몽상이지 그냥. ⟪k:1⟫――대륙을 횡단하는 선로라니."

#: scenario3:scenario3_0AF904F0_8718_4FED_9D6B_A7DCBA69B1C1
