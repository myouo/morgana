msgctxt "scenario3:scenario3_595B9CE1_E64A_4CC0_A787_63066803C4CD"
msgid "⟪k:0⟫I mean it."
msgstr "⟪k:0⟫진짠데."

#: scenario3:scenario3_AF5831BE_12C1_44B1_98B0_CDC9025A6FA1
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 6dc6361d8b29d383c8e84e9f651c6c4a3d9a9cf4b751a5c07809bcb02f1f7330
