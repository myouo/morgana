msgctxt "scenario3:scenario3_A3B5D426_171E_4310_AC2B_B01EA65000F1"
msgid "⟪k:0⟫But if it doesn’t, then my country is doomed to collapse."
msgstr "⟪k:0⟫안 그러면 ⟪k:1⟫머지않아 망할 나라지."

#: scenario3:scenario3_1B3FE176_0473_4B6F_8BA3_D7578AAAB12E
