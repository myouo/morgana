msgid "⟪k:0⟫⟪k:1⟫The world..."
msgstr "⟪k:0⟫⟪k:1⟫세계……."

#: scenario3:scenario3_E76E4A67_8AF1_4E9E_B980_C8B65E3584E5
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 71d1204ce203d8622cdf2a49d74094e5d0d66e98a1a8d19f2be9c9ec4d2f1c66
