msgctxt "scenario3:scenario3_39734B13_3D4C_4B9B_A507_3A350D7C0483"
msgid "⟪k:0⟫⟪k:1⟫No—⟪k:2⟫⟪k:3⟫I’d wager most don’t notice the changes at all."
msgstr "⟪k:0⟫⟪k:1⟫아니―― 세계가 바뀌는 것조차 ⟪k:2⟫모를 수도 있겠군."

#: scenario3:scenario3_C6C73090_D254_45AD_A1CB_9FE8662CAAFC
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 511f178c509620f014b9af187dd1b0e42cc80ba8e07fc7f29218af4874cbbd98
#. default-sha256: 0d11088ff8fe0f5594b4c8f1f12305867ac5c5afa98c28246e021b2867785d8d
