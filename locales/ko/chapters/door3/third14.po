msgctxt "scenario3:scenario3_1535AF1C_3BFA_4B19_B085_573C6485B903"
msgid "⟪k:0⟫On the other hand, the payoff is fantastic."
msgstr "⟪k:0⟫그래도 뭐, ⟪k:1⟫그러는 만큼 ⟪k:2⟫유쾌한 보상이 생겨서――"

#: scenario3:scenario3_FD2D5706_0EA9_4127_A930_AC96782529F3
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 58f3cd1e06b04e0145da35996c1d9ce08b678106a553c5da58f4c6bd2bf5685e
