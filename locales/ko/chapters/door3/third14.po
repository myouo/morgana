msgctxt "scenario3:scenario3_25878519_CDCD_411E_A2D0_DAFE5078ED3A"
msgid "⟪k:0⟫⟪k:1⟫Ugh. Sickening."
msgstr "⟪k:0⟫⟪k:1⟫어우 닭살 돋아."

#: scenario3:scenario3_1535AF1C_3BFA_4B19_B085_573C6485B903
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 506edb9485acb8c886bcf434635ae7dfcd88101f1aa31abd83ab40cfa4fa4b27
