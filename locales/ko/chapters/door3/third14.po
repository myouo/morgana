msgid "⟪k:0⟫⟪k:1⟫then I’ve got news for you, pal:"
msgstr "⟪k:0⟫⟪k:1⟫좋은 거 하나 알려 줄게."

#: scenario3:scenario3_F957672E_BEC1_4C80_A09E_2E5C92DBF85D
