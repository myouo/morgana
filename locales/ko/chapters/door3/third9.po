msgid "⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫⟪k:4⟫⟪k:5⟫⟪k:6⟫⟪k:7⟫⟪k:8⟫⟪k:9⟫Ah..."
msgstr "⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫⟪k:4⟫⟪k:5⟫⟪k:6⟫⟪k:7⟫⟪k:8⟫⟪k:9⟫아………."

#: scenario3:scenario3_CAEC62BC_BD5B_4929_B928_197019260213
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 1e9e4ce5ef34f9b8016eb7934c16d1268f2c7926508c2a482595989ae2088d5c
#. default-sha256: 582f37053219db7210d8700489cb630b04877f1f060980871debdff5b000ddd0
msgctxt "scenario3:scenario3_CAEC62BC_BD5B_4929_B928_197019260213"
msgid "⟪k:0⟫⟪k:1⟫I... ⟪k:2⟫thought you would not be back until tomorrow..."
msgstr "⟪k:0⟫⟪k:1⟫여보……. ⟪k:2⟫오늘은 ⟪k:3⟫외박하신다고――"

#: scenario3:scenario3_B74CB945_C245_45C6_839C_00792C4502EE
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 17574636588ae0c050935f3a7c87163fe246f7fe98c2ea3aed782115a3be012d
#. default-sha256: ab73284ff476ae5542c343225888980511b9ece15c56f9fc3649b24ed2adc907
msgctxt "scenario3:scenario3_B74CB945_C245_45C6_839C_00792C4502EE"
msgid "⟪k:0⟫⟪k:1⟫And how would you know that?"
msgstr "⟪k:0⟫⟪k:1⟫……그걸 왜 ⟪k:2⟫네가 알아."

#: scenario3:scenario3_230FAB18_C6D0_42E8_8E3F_667C09CD3A73
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: d5f809007b50d975ac9cb65c6866577fe4868bf764800e69ce27eb0d1eddb372
#. default-sha256: 920696211224c55bb577e32fb0ac7f4dc9bdc415d5612ecac5d2d838f80c659f
msgctxt "scenario3:scenario3_230FAB18_C6D0_42E8_8E3F_667C09CD3A73"
msgid "⟪k:0⟫No, forget that.⟪k:1⟫Does my staying the night elsewhere have any effect on you?"
msgstr "⟪k:0⟫아니, ⟪k:1⟫그건 됐고――⟪k:2⟫⟪k:3⟫내가 외박하는 게 중요하단 투인데?"

#: scenario3:scenario3_125B54F2_A985_410B_998D_230249B5DAA4
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 3f1d3d9b14c67557015a5992c3167724c9dca38aef66a2883c46709ea7f735dd
#. default-sha256: ccc21458d820b90559f1daf170931bf90d6a3a765c845460219b5cbad8083a63
msgctxt "scenario3:scenario3_125B54F2_A985_410B_998D_230249B5DAA4"
msgid "⟪k:0⟫You were just ⟪k:1⟫waiting⟪k:2⟫ for this opportunity, weren’t you?"
msgstr "⟪k:0⟫―――이 기회를 노리기라도 했어?"

#: scenario3:scenario3_FD4C0B48_39AF_43DA_B62F_02CB1F94D6BA
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 57f814321bee875c3dd9ee22c6ee82b3d6fa2f1adeaaadc18652cc0f06c50f99
#. default-sha256: 7903d48c181a7b4806534583e19d37680a5fdf5a2adfc13f6b1c3d02c2e2dc8b
msgctxt "scenario3:scenario3_FD4C0B48_39AF_43DA_B62F_02CB1F94D6BA"
msgid "⟪k:0⟫⟪k:1⟫No... ⟪k:2⟫What would I possibly want you out of the house for?"
msgstr "⟪k:0⟫⟪k:1⟫세상에……, ⟪k:2⟫제가 왜 ⟪k:3⟫남편의 외박을 바라야 하나요?"

#: scenario3:scenario3_6416130A_29D0_4ECC_B946_9B0650632268
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 6186367198b300d9e8879b578935c8ee29b90a7ba26c684f35e37a0c2b38a933
