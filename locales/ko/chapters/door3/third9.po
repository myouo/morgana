msgctxt "scenario3:scenario3_6416130A_29D0_4ECC_B946_9B0650632268"
msgid "⟪k:0⟫⟪k:1⟫I’m sure you know better than anyone."
msgstr "⟪k:0⟫⟪k:1⟫그 이유는 ⟪k:2⟫네가 가장 잘 알 거 아니야?"

#: scenario3:scenario3_BBF691D3_FDBA_4A1B_B183_0D76087D0568
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 23da0d9154078f69634c5fdfac0eeccfc7c59bfccc0e971dea11152bea3c5217
