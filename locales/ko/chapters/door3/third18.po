msgctxt "scenario3:scenario3_6EB8BE68_C493_4B2F_9754_C84D02B1D6D3"
msgid "⟪k:0⟫I was unable to do anything nice for you then either."
msgstr "⟪k:0⟫그때도 ⟪k:1⟫나는 네게 ⟪k:2⟫따스히 대하질 못 했지."

#: scenario3:scenario3_112CA0BD_E718_42D6_A0E1_B8C8842A7736
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
