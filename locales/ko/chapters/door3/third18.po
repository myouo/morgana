msgid "⟪k:0⟫............"
msgstr "⟪k:0⟫…………."

#: scenario3:scenario3_5FF8C5D5_C00C_4776_B178_AB7DABE05F4A
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
