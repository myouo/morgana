msgid "⟪k:0⟫..........................."
msgstr "⟪k:0⟫………………………."

#: scenario3:scenario3_BBBC7FFF_6443_4D41_80F1_F9D8D4F5AABE
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: aeb6638b3b82a3a923a273601f6861ec39914c05cd6f495ea513a3a04a6e01ae
#. default-sha256: abab42b4dadbcaa6d9988b7c47122aeca7590a9a37357df336ac8d2230bc0a7e
