msgctxt "scenario4:scenario4_64A0889C_8CE4_4672_BB47_145C028D4202"
msgid "⟪k:0⟫To stay with me."
msgstr "⟪k:0⟫저와 함께 있어 주시는 분……."

#: scenario4:scenario4_63D359E4_87C2_4F17_8508_63216F223EE3
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: fefa081bb3d1d8898215917b271bb09e97bc8fe53c39a9dfa84395b502a82978
