msgctxt "scenario4:scenario4_63D359E4_87C2_4F17_8508_63216F223EE3"
msgid "⟪k:0⟫So let us put an end to this journey."
msgstr "⟪k:0⟫……자, ⟪k:1⟫그만 끝을 내지요."

#: scenario4:scenario4_590C7DF6_DB76_420D_9175_E9571739B519
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 93724e4c8c8f035d461e517fce12a9d44c9fb6cf6d744aebecac4657fda92c9f
