msgctxt "scenario4:scenario4_9DFE67AB_5ECC_4308_89CB_B63FBA7695C7"
msgid "⟪k:0⟫For surely you would not willingly repeat the same fate..."
msgstr "⟪k:0⟫이토록 힘겨운 운명을 반복한단 사실을 ⟪k:1⟫당신이 똑똑히 이해하시고 나면……"

#: scenario4:scenario4_1DF94103_D2F4_420A_B86F_8DE789045661
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: bdd5db3b3a636567cff795129367b09a4dc03c5ba82d456ce2312c9adf0038c7
