msgctxt "scenario4:scenario4_48576C9C_408D_4479_B9E3_D4FD79EAA46A"
msgid "⟪k:0⟫and you are the tragic plaything of fate, the White-Haired Girl named Giselle."
msgstr "⟪k:0⟫그리고 당신이 ⟪k:1⟫비극적인 운명에 번롱당하던 백발 소녀, ⟪k:2⟫지젤."

#: scenario4:scenario4_C5E7A395_2B07_4B4A_9C2B_E0E8372CDB24
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: db5151a915a5a60abb8b0b672059c22e5d4f3d4673e2d212d74acff931199d9c
