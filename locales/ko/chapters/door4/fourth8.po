#. native-sha256: 2947549863d677821c2408d1058746945b1d30624668e52ec9206e551b4703db
#. default-sha256: f5b93ca998c9b0d04ee11051dc257bbf6986a63949c253bc5fd85785ca604862
msgctxt "scenario4:scenario4_9904B2D4_8558_4113_BBA9_1FEBB68DC1DB"
msgid "⟪k:0⟫⟪k:1⟫and I am sure you shall find happiness."
msgstr "⟪k:0⟫⟪k:1⟫틀림없이 ⟪k:2⟫행복해질 거랍니다. ⟪k:3⟫그렇지 않은지요……?"

