msgid "⟪k:0⟫What a sweet girl she was.⟪k:1⟫"
msgstr "⟪k:0⟫참 착하기 그지없지요…….⟪k:1⟫"

#: scenario4:scenario4_49AB0168_0BFF_4FA2_8EE8_7FD96A89692B
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 6f58df6f910bde57eaeafb1c571c8680b8ab754b4ebaa61dcbeebe74f4f8c82f
