#: scenario4:scenario4_1788B948_3811_48FC_969B_EFF9781C218B
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: f7deed6f9c25c82df1f271b8462463af2225b9731dd247b1271f1c1f9e69848f
#. default-sha256: c3da7039149394d62fe995a89f720ee3e0aad31ec05866f7f8e0115dfbbbe534
msgctxt "scenario4:scenario4_1788B948_3811_48FC_969B_EFF9781C218B"
msgid "⟪k:0⟫⟪k:1⟫...You do not enter my room.⟪k:2⟫⟪k:3⟫That is all I ask of you."
msgstr "⟪k:0⟫⟪k:1⟫제 방에는 들어오지 말 것. ⟪k:2⟫그것만은 ⟪k:3⟫꼭 지키십시오."

#: scenario4:scenario4_93C197BB_AC1B_458A_8891_957752431C4C
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
