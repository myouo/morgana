msgctxt "scenario4:scenario4_889C62FA_412E_4E4C_AC7D_ED5CE742BFB1"
msgid "⟪k:0⟫The villagers almost certainly came armed, as well."
msgstr "⟪k:0⟫마을 사람들은 ⟪k:1⟫당연히 무장하고 왔을 테니까요……."

#: scenario4:scenario4_9FEAECBA_F62E_42C3_8ECB_254154240E90
