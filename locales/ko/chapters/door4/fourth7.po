msgid "⟪k:0⟫⟪k:1⟫⟪k:2⟫—!"
msgstr "⟪k:0⟫⟪k:1⟫⟪k:2⟫………!"

#: scenario4:scenario4_84535F4E_8D18_4A6A_86E3_3EDAD62B1681
