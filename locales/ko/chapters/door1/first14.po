msgid "⟪k:0⟫Please, open the door!"
msgstr "⟪k:0⟫열어 주세요……!"

#: scenario:scenario_7D8E98AD_4144_4EF2_9E46_6491CDFD4B36
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
