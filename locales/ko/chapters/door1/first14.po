msgctxt "scenario:scenario_A737D17B_7F90_44CE_BBCC_E5F99BB3C160"
msgid "⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫⟪k:4⟫⟪k:5⟫⟪k:6⟫⟪k:7⟫⟪k:8⟫⟪k:9⟫⟪k:10⟫F-⟪k:11⟫Father!⟪k:12⟫"
msgstr "⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫⟪k:4⟫⟪k:5⟫⟪k:6⟫⟪k:7⟫⟪k:8⟫⟪k:9⟫⟪k:10⟫시, ⟪k:11⟫신부님……!⟪k:12⟫"

#: scenario:scenario_B8F5453A_3E8A_4557_A72E_D24859653357
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
