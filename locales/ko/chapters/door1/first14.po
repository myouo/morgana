msgid "⟪k:0⟫(About that painting, about her, and about Nellie’s feelings.)"
msgstr "⟪k:0⟫(그림 얘기도, ⟪k:1⟫그 애도, ⟪k:2⟫넬리의 마음도)"

#: scenario:scenario_7D077E74_D86D_4AD4_982D_EBA758761BF9
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: a7e445110242ca3d9dab5dd4809a770740985c0c6850f2d8544d4e9b96a9892a
