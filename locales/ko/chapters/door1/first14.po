msgctxt "scenario:scenario_7D077E74_D86D_4AD4_982D_EBA758761BF9"
msgid "⟪k:0⟫(Not her lies, but the truth!)"
msgstr "⟪k:0⟫(그런 거짓투성이 말이 아니라 ⟪k:1⟫진실만을……!)"

#: scenario:scenario_79061396_354A_4D72_852F_7D33E819F438
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: b766815bd924b5107073bac98864e964995977255f389ecbe9eb65e067fff74b
