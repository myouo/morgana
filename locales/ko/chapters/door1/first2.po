msgctxt "scenario:scenario_46D19CAC_13AA_4EBA_AE9C_DC3EE2DE449C"
msgid "⟪k:0⟫And Mell was considering university."
msgstr "⟪k:0⟫……멜은 아무래도 ⟪k:1⟫대학에 소속될 것을 고려하는 중이었나 봅니다."

#: scenario:scenario_6FFB82DB_D766_4D81_9654_FD543F861B72
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: aa01e67fc478e34310d96d4fc672d0f80e26e5b2c5b2665dc4964a46237274a0
