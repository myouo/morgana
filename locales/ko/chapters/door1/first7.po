msgid "⟪k:0⟫⟪k:1⟫⟪k:2⟫(It’s now or never.)"
msgstr "⟪k:0⟫⟪k:1⟫⟪k:2⟫(……오늘은 꼭……)"

#: scenario:scenario_FCDD3A5A_AE3F_4E8A_9DBD_6B37D25F6AB7
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 167615236454cd2042323df721238fa26d5c5f9b0e5bc57c8e383941fcb1c32e
