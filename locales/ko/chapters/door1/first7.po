msgid "⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫⟪k:4⟫⟪k:5⟫Ah..."
msgstr "⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫⟪k:4⟫⟪k:5⟫아……."

#: scenario:scenario_0064EE85_B55F_4F23_BFFE_56AA12E5CDD7
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: bf10e4820e2a116938f359744615e00d8de95e024ea961030996a9286910fdae
