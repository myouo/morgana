msgctxt "scenario:scenario_2AC24185_B847_4C08_854B_01126C59DF24"
msgid "⟪k:0⟫Her pale fingers were trembling, like she had tried to squeeze them again and failed."
msgstr "⟪k:0⟫그리고 흰 손가락이 ⟪k:1⟫조금 떨렸습니다. ⟪k:2⟫도로 힘을 주려다 ⟪k:3⟫실패한 것처럼요."

#: scenario:scenario_81F6FC89_2B58_4C3C_BAE7_82FA74AF0CB3
