msgctxt "scenario:scenario_915E5451_8083_472C_8693_C47ACEFE7ED5"
msgid "⟪k:0⟫But no one was willing to separate the art from the artist."
msgstr "⟪k:0⟫하지만 ⟪k:1⟫아무도 ⟪k:2⟫작품만을 봐 주진 않아요……."

#: scenario:scenario_21810620_3685_4F78_9BCA_832550E29B62
