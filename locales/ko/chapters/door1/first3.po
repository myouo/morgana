msgctxt "scenario:scenario_F4C7CEBA_FFC0_4989_80F1_0B18359A4581"
msgid "⟪k:0⟫⟪k:1⟫They’ll probably throw an even bigger one next year."
msgstr "⟪k:0⟫⟪k:1⟫내년에는 더 커지지 않을까?"

#: scenario:scenario_CD0AD072_93C9_4C07_88DF_F34C115B1CF6
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 8aa7e0626c7a69c3060b61562ff140e8c49e1075a7e352cb4d5a59299bcd1a95
