msgctxt "scenario:scenario_C20CD433_B0CD_417B_B181_C24666F35234"
msgid "⟪k:0⟫⟪k:1⟫(But I think that ⟪k:2⟫is⟪k:3⟫ true for you, Nellie.)"
msgstr "⟪k:0⟫⟪k:1⟫(넬리는 실제로도 ⟪k:2⟫그런 것 같은데)"

#: scenario:scenario_BA226F13_9347_408F_AC5B_C26B4A5BDFB0
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 9a3a87c9673e78d08a130cef0bb70a6056ed60b800988fac41a073794b81f6e3
#. default-sha256: b76f1f7e02d92576f3a2786bb97107b28d3c53595b043713155e4895a0171949
msgctxt "scenario:scenario_BA226F13_9347_408F_AC5B_C26B4A5BDFB0"
msgid "⟪k:0⟫⟪k:1⟫(Though... ⟪k:2⟫why is she disappointed with me?)"
msgstr "⟪k:0⟫⟪k:1⟫(그런데 ⟪k:2⟫나 보고 기가 막힌단 건가……?)"

#: scenario:scenario_4E973416_1EE7_46FA_86CD_CB839058D2EE
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 4ab73ab970de7e742cc22b31e487a1c9ffa6d792abfd6868c9fbc59d86035655
#. default-sha256: 32a14c8b31e2f33d7cb93c9566c0bbc3f204c96079b92096d3bedb69abd7a744
msgctxt "scenario:scenario_4E973416_1EE7_46FA_86CD_CB839058D2EE"
msgid "⟪k:0⟫⟪k:1⟫Uggggh, I think I’m done with birthday parties after this year."
msgstr "⟪k:0⟫⟪k:1⟫에휴~, ⟪k:2⟫역시 생일 파티는 내년부터 하지 말자고 해야지."

#: scenario:scenario_F4C7CEBA_FFC0_4989_80F1_0B18359A4581
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: b94f76a425e3e37f837ee8c376d6e440945b42b553eed4dba0c4236fc73d94e6
