msgid "⟪k:0⟫⟪k:1⟫Huh? ⟪k:2⟫Why?!"
msgstr "⟪k:0⟫⟪k:1⟫어어, ⟪k:2⟫왜!?"

#: scenario:scenario_DCB893DC_6670_47A0_BD44_6606BE247DA5
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 9a19225aa1075f6a6a8a63c715c9cd24da84f1a0a56165302058087a6dfac948
