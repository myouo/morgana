msgid "⟪k:0⟫⟪k:1⟫............"
msgstr "⟪k:0⟫⟪k:1⟫…………."

#: search2:search2_0BF6EFA1_487D_4896_A517_B219C8E09DB0
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: e4faa5e219e23088845b3a5cb65d2afd2fff5027ac50983b0ec16ce966fb19d2
