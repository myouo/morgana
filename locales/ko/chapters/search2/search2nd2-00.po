msgctxt "search2:search2_EC7E50AC_94F3_4F4E_9CB3_398A34C3BBAD"
msgid "⟪k:0⟫It’s all so... ⟪k:1⟫unreal."
msgstr "⟪k:0⟫몹시―― ⟪k:1⟫비⟪k:2⟫현실적이다."

#: search2:search2_44E62CF9_E6C3_4C50_AEAB_30D5C2F230FB
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: bba0dda55fed3a5fa3f833f098326816362f5f7584f50002030825d401709da2
