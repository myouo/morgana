msgid "⟪k:0⟫⟪k:1⟫“It’s the blood of the witch!”"
msgstr "⟪k:0⟫⟪k:1⟫「마녀의 피야!」"

#: search2:search2_20B7F719_A77B_4C98_AE25_384AFDFEB29B
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 6ee441bdbe0b116ad711988d8aea2f8c3b3cdc9e47dd4e4c0a1526fdd77218c7
