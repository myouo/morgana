msgctxt "search2:search2_04789EE4_0318_4743_8DEA_36118CF6A471"
msgid "⟪k:0⟫Is it hers?"
msgstr "⟪k:0⟫모르가나의 피일까?"

#: search2:search2_2238410D_8F84_4E98_9967_175B3C57B224
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: d1711bda09b1dbf3bbdc5de319f1ea973b31a6e8ec00dff0aa1d971c18f18559
#. default-sha256: e09792b85bc2a841cd6a443241661c27b36531b666f6062ac21b4b58f4fee991
msgctxt "search2:search2_2238410D_8F84_4E98_9967_175B3C57B224"
msgid "⟪k:0⟫Is it mine?"
msgstr "⟪k:0⟫내 피일까?"

#: search2:search2_31A59C10_5260_4EEE_8735_2145A49D07BE
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 73213158b8df72240f368a98e64d4835660c2bf57593edee4ab5865dbd0cabd1
#. default-sha256: 90f9f8e8470bc82a8ba6034231e6514f564cbe43877614a31fb4e05cdc2db339
msgctxt "search2:search2_31A59C10_5260_4EEE_8735_2145A49D07BE"
msgid "⟪k:0⟫Who am I?"
msgstr "⟪k:0⟫나는 누구지……?"

#: search2:search2_2618D824_D3CC_4480_BBE7_60BF7A87E9D4
