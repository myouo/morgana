msgctxt "search2:search2_C9EF1025_700F_4735_9376_32D40D132B8F"
msgid "⟪k:0⟫⟪k:1⟫⟪k:2⟫“The witch killed her...”"
msgstr "⟪k:0⟫⟪k:1⟫⟪k:2⟫「……마녀가 죽인 거야……」"

#: search2:search2_CF282D4A_F922_453D_9611_E9E33BC11C03
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 6402a6ee0976065bc2cdc7be1f7203b2fc21d07fe50673af115d32dea26af260
