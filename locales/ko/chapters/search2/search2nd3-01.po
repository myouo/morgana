msgctxt "search2:search2_B452B934_50B9_47F3_9906_BE86228BD71C"
msgid "⟪k:0⟫⟪k:1⟫“It’s—”"
msgstr "⟪k:0⟫⟪k:1⟫「그건――」"

#: search2:search2_89C4334A_B7A2_49BE_AD29_6C93E6F4427E
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 441c7f7c1ca5033e21bac97431b9233e44a5f30b7898676d98d7cd573c2ca143
