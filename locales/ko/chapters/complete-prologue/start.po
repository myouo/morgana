msgctxt "prologue:prologue_1EB62C36_88AE_4696_8FA0_CF1CB598490F"
msgid "⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫⟪k:4⟫Hehehe... ⟪k:5⟫Good morning."
msgstr "⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫⟪k:4⟫우후후……, ⟪k:5⟫안녕히 주무셨는지요."

#: prologue:prologue_B69DEE9D_18C2_4F49_944C_D342A9737DE1
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: df7469761b540bc99337eac711bafdb0d05e9504ab17fc5faf3098aee13a5bd5
