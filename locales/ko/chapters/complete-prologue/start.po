msgid "⟪k:0⟫⟪k:1⟫Please wake up..."
msgstr "⟪k:0⟫⟪k:1⟫일어나 주시어요……"

#: prologue:prologue_7D0E1091_7FB9_4B93_A239_A3A383BA05E0
