msgctxt "scenario5:scenario5_5C27C276_20FF_47C7_BBF5_1D013ADE1DD5"
msgid "⟪k:0⟫But I had found my resolve. I had overcome my hesitation."
msgstr "⟪k:0⟫하지만…… ⟪k:1⟫이미 결심했을 것이다. ⟪k:2⟫나는 ⟪k:3⟫내 망설임을 떨쳐 내기로 했다."

#: scenario5:scenario5_49BEA644_DBAA_4555_B36C_0F6F150DDB36
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 368d4a6a3971919b85d71e97e0e4f327c76c01b523f82e32c75eed97e20a81b2
