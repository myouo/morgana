msgctxt "scenario5:scenario5_B942DD66_8C99_4968_87FD_1D3FFE9C1D1A"
msgid "⟪k:0⟫............"
msgstr "⟪k:0⟫…………."

#: scenario5:scenario5_F7C4203F_4410_4B98_B817_505CC68B5AF9
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: ddf38c27292667ab549b4ea9d6a76adb0b0d1145978af93b07cd1cbf49a2fd09
