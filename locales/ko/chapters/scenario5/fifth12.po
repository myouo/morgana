msgctxt "scenario5:scenario5_F7C4203F_4410_4B98_B817_505CC68B5AF9"
msgid "⟪k:0⟫(Before I throw in the towel... ⟪k:1⟫I need to take some real time to think.)"
msgstr "⟪k:0⟫(벌써부터 한탄만 하지 말고…… ⟪k:1⟫내가 가능한 걸 생각하자……)"

#: scenario5:scenario5_C607AC72_14D4_43C5_B576_0811265DB0BC
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 5af60b54d7fc3343a870b51a325969945730ec467e03c7e7ac80a78cddcb8c0e
