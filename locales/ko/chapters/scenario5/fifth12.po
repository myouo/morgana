msgctxt "scenario5:scenario5_E23440DB_5BBB_4AFD_A39B_A63B8A3FD27A"
msgid "⟪k:0⟫be properly joined with you... ⟪k:1⟫and it will be wonderful."
msgstr "⟪k:0⟫언젠가 똑바로…… ⟪k:1⟫이어질 수―― 있을 것 같아요."

