msgctxt "scenario5:scenario5_E67AFB0D_3773_49F8_A138_CD8B727CCBF1"
msgid "⟪k:0⟫I wondered what kind of place Hell was."
msgstr "⟪k:0⟫……과연 ⟪k:1⟫지옥이란 ⟪k:2⟫어떤 곳일까."

#: scenario5:scenario5_19F49EA3_922F_4E40_AE60_1A34DD78A799
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
