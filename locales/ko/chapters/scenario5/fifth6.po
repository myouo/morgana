msgctxt "scenario5:scenario5_6D36D0F3_1DEF_4CCA_9866_5579CD4F894E"
msgid "⟪k:0⟫I assumed he would just stand back and watch,"
msgstr "⟪k:0⟫어차피 아무것도 안 하겠거니 ⟪k:1⟫싶었는데……"

#: scenario5:scenario5_F8429FFA_4F5E_4833_B615_7CA650327914
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
