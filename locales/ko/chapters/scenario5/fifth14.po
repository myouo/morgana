msgctxt "scenario5:scenario5_038F8655_503F_4EF9_838F_75B320335DF8"
msgid "⟪k:0⟫(They’re coming this way?)"
msgstr "⟪k:0⟫(……이리로 오는 건가……?)"

#: scenario5:scenario5_8E2C4C4A_46B5_4F08_A54B_AE2964846171
