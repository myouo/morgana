msgctxt "scenario5:scenario5_F987E310_0542_4FA0_ADCA_98946A2FFDBB"
msgid ""
"⟪k:0⟫(It would be terrible if the coachman rolled the carriage because he couldn’t see where we "
"were going.)"
msgstr "⟪k:0⟫(앞이 안 보여서 엎어지기라도 하면 ⟪k:1⟫큰일일 거 아니야)"

