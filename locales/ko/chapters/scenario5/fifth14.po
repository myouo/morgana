msgctxt "scenario5:scenario5_53E54130_E223_4221_ADC7_D0176A8A58B1"
msgid "⟪k:0⟫As more and more came into view, my mind began seeing them as people carrying torches."
msgstr "⟪k:0⟫서서히 숫자가 늘어나는 그건―― 인간이 든 횃불처럼 보였다."

#: scenario5:scenario5_038F8655_503F_4EF9_838F_75B320335DF8
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: c6bfe4966f06a52a2c528e035a9f691f4a559bde0011dc8212e5e2067f8c3272
