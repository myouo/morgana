msgctxt "scenario5:scenario5_D40B4C91_DFB6_436C_8534_233B6CA85B30"
msgid "⟪k:0⟫But it wouldn’t disappoint me if that didn’t end up happening."
msgstr "⟪k:0⟫이루어지지 않더라도 ⟪k:1⟫낙담하진 않을 것이다."

#: scenario5:scenario5_F89F45BE_B90A_4045_AF43_36DD2A1929AB
