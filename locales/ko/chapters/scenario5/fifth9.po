msgid "⟪k:0⟫⟪k:1⟫⟪k:2⟫I..."
msgstr "⟪k:0⟫⟪k:1⟫⟪k:2⟫………그건………."

#: scenario5:scenario5_0C4432C5_4125_4ADD_B0B3_F2A8BF3982BD
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 7ad13a1a755080bfe28749b4b64cc0206bfa111571a33932e129ec15f0e59916
