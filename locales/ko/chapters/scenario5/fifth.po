msgctxt "scenario5:scenario5_9485AF68_781D_418F_B49F_D30C7DAB73A6"
msgid "⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫⟪k:4⟫Please do not touch the drapes."
msgstr "⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫⟪k:4⟫암막에 손대지 마십시오."

#: scenario5:scenario5_C1F7E9CF_BD82_44A7_A6E8_30A0E3E37A86
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 50059d0e4a7994006889d5c90276919134b5784cabef3915cbe6f82dd5458d3c
#. default-sha256: 1c378ce91d742daafb867a52eef13b4302e6befacb8e75fe5235b1c4e491a96a
msgctxt "scenario5:scenario5_C1F7E9CF_BD82_44A7_A6E8_30A0E3E37A86"
msgid "⟪k:0⟫...!"
msgstr "⟪k:0⟫………!"

