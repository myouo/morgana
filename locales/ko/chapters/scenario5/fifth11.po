msgctxt "scenario5:scenario5_386B0606_04E2_4C8B_907D_763CF8B59F2C"
msgid "⟪k:0⟫But..."
msgstr "⟪k:0⟫하지만………"

#: scenario5:scenario5_EB50DC78_C467_445D_B720_B07CD523D1E6
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
