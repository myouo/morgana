msgctxt "scenario5:scenario5_DC81D8E7_D1D5_403A_9526_7464AF7139EE"
msgid "⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫⟪k:4⟫Oh, you picked it?⟪k:5⟫Are you going to bring it back to your room?"
msgstr "⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫⟪k:4⟫어머……, ⟪k:5⟫꺾으셨어요? ⟪k:6⟫방에 ⟪k:7⟫가져가시게요?"

#: scenario5:scenario5_B7CB4395_74CB_4BED_BC91_77ED56383548
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: d61f00808f150e3760d251b3a19a4aaf2b3025107ae9cec7c762fe24f53079f7
