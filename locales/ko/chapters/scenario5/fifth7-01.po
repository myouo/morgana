msgid "⟪k:0⟫So long as there is testimony against you, your guilt is assured."
msgstr "⟪k:0⟫목격자가 있는 이상 ⟪k:1⟫너는 발뺌 못 해."

#: scenario5:scenario5_82DC5954_591A_4293_A04B_ABD6F9A04FC1
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 6dc93effb0460b04934f92a1494c90424aa4bb7524f8fc5d15415cae36e66b6f
