msgctxt "scenario5:scenario5_433AD9C5_8D01_4816_9DFA_2A7298F26081"
msgid "⟪k:0⟫Now, let us return to our past."
msgstr "⟪k:0⟫――갑시다. ⟪k:1⟫우리의 ⟪k:2⟫남은 과거로."

#: scenario5:scenario5_3ED561DE_557E_43B9_A04B_1E4B69D11101
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 882a2119aa5a274e2c5ed239b2de54456c37a995a526efb7d2b46b85c3cddcd5
#. default-sha256: b6883e6feb966df01c9375f57fa2659f5fbec02f744fce65b6809abae2f52754
msgctxt "scenario5:scenario5_3ED561DE_557E_43B9_A04B_1E4B69D11101"
msgid "⟪k:0⟫no matter what we lost or how much pain we suffered..."
msgstr "⟪k:0⟫이 뒤에도 ⟪k:1⟫가슴 아픈 과거가 이어지더라도――"

#: scenario5:scenario5_7783E930_C944_4CE5_BD88_E5DAF654594B
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: a41712c0b0258c70b0b29fa8df40a87b7ea0b579260646e2cce4ae66fac64dbd
