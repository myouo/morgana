msgid "⟪k:0⟫(I’d rather never wake up at all...)"
msgstr "⟪k:0⟫(영원히 잘 수 있다면, ⟪k:1⟫그만……)"

#: scenario5:scenario5_E8FAFA97_31D0_4266_A274_D31311E04329
