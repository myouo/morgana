msgid "⟪k:0⟫⟪k:1⟫Huh? Arm wrestling?"
msgstr "⟪k:0⟫⟪k:1⟫예……? ⟪k:2⟫팔씨름………?"

#: scenario5:scenario5_1AE9BA9E_ECE7_4A48_97E5_F81A18AE3BF8
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 53d599a35578ebfb872a8fe67b30f3e0890b608838583fe0ea4637dd4e9e391b
