msgctxt "scenario5:scenario5_2B45F5D5_EB6C_46B7_8E54_614134CFCB42"
msgid "⟪k:0⟫⟪k:1⟫Who would ever willingly participate in such a primitive competition?"
msgstr "⟪k:0⟫⟪k:1⟫뭘 굳이 ⟪k:2⟫그런 원시적인 놀이를 할 필요가 있는지……."

#: scenario5:scenario5_0B9A9026_49D9_4C79_8DFB_CC357B045A1F
