msgid "⟪k:0⟫Reaaaaaaaady, ⟪k:1⟫⟪k:2⟫⟪k:3⟫⟪k:4⟫go!"
msgstr "⟪k:0⟫………하나 둘 셋!"

#: scenario5:scenario5_FACC0EF5_916F_4B00_A206_FF8C7BBEF407
