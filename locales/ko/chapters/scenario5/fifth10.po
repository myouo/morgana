msgid "⟪k:0⟫Please, Giselle... ⟪k:1⟫don’t let the things you felt..."
msgstr "⟪k:0⟫지젤……, ⟪k:1⟫그 순간의 감정을……."

#: scenario5:scenario5_9B71C28B_95D9_48BC_84AD_BA24F734766B
