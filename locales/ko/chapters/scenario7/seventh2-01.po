msgid "⟪k:0⟫⟪k:1⟫⟪k:2⟫...?"
msgstr "⟪k:0⟫⟪k:1⟫⟪k:2⟫…………?"

#: scenario7:scenario7_43E1C2D0_3F06_485B_BCC9_00626FFF67B2
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: bfe12f83f4d2078f6926030c3113dc4825db099d757d527e97b1428601497b15
#. default-sha256: 522ebe7681a7014844adf0209eca30afebf41dfbb5da648de3cf5d6965bd5461
msgctxt "scenario7:scenario7_43E1C2D0_3F06_485B_BCC9_00626FFF67B2"
msgid "⟪k:0⟫A warm breeze blew past, sending up a swirl of flower petals."
msgstr "⟪k:0⟫미지근한 바람이 불어―― ⟪k:1⟫꽃잎이 휘날렸다."

#: scenario7:scenario7_FE166405_06E9_48C9_B91E_7D545B24CDC6
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 34541f3d247008a80d9c9bf0b506cb64baac7f7dd0136b015a4d0074fa76ed8b
#. default-sha256: 1422ca85164932c02f4ae0b5e4a9ca7e85da633b34d8193282bd1902ae933cd2
msgctxt "scenario7:scenario7_FE166405_06E9_48C9_B91E_7D545B24CDC6"
msgid "⟪k:0⟫The girl’s dress hung lightly over her frame, tracing her gentle curves."
msgstr "⟪k:0⟫여자가 입은 옷도 ⟪k:1⟫바람에 나부껴 몸의 능선을 부각시켰다."

#: scenario7:scenario7_CFB6B5B7_B005_45AD_AEAE_EF9562430783
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: d7a7b94e7f89266bfe3f811ee9eb0d420559e5b968a425a1a2f0028f51a799a4
#. default-sha256: a01929af0d89d219b06d645118a33f8627b475dd8c47f27b24e1d098dde5af75
msgctxt "scenario7:scenario7_CFB6B5B7_B005_45AD_AEAE_EF9562430783"
msgid "⟪k:0⟫⟪k:1⟫And you are?"
msgstr "⟪k:0⟫⟪k:1⟫당신은……?"

#: scenario7:scenario7_E59D31B4_85C2_4732_A368_4E4D1F67B857
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 2af418bb9fcab509d2bba4bdbf86995a95e9e261d1359a0e39d9cc869215569f
#. default-sha256: 1ba778eab878e2baa02a7031925fff51bd4d277301e5fd4cebb9faeb0b51b25d
msgctxt "scenario7:scenario7_E59D31B4_85C2_4732_A368_4E4D1F67B857"
msgid "⟪k:0⟫⟪k:1⟫My name is Aimee.⟪k:2⟫⟪k:3⟫It’s a pleasure to finally meet you."
msgstr "⟪k:0⟫⟪k:1⟫나는 에이미야, ⟪k:2⟫……앞으로 잘 부탁해."

#: scenario7:scenario7_F9079209_E85A_47FC_B2FA_F9843BD38D98
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 618e5292dafd3a4d5e35ca3fe6afa69299bf985a62b3e7afbfae93bb4fcb304c
#. default-sha256: 06ef5ebae05df13c3e1a73317dbe2eedbdcbde80dd039f8c46c34d025b90dc0b
msgctxt "scenario7:scenario7_F9079209_E85A_47FC_B2FA_F9843BD38D98"
msgid "⟪k:0⟫she stepped toward me, kissing me softly on the cheek."
msgstr "⟪k:0⟫그 사람이 다가와 ⟪k:1⟫뺨에 키스했다."

#: scenario7:scenario7_BDFDDAED_DC39_40E0_BAAC_48879F664DE0
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: bd01a216ab4e952725c0eae8bab71b419bc8a12401ce15127652bfa1e211f957
