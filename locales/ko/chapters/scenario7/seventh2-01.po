msgctxt "scenario7:scenario7_BDFDDAED_DC39_40E0_BAAC_48879F664DE0"
msgid "⟪k:0⟫Electrifyingly sweet."
msgstr "⟪k:0⟫나를 마비시켰다."

#: scenario7:scenario7_09505D2C_BFC5_4070_A5DF_6C8CB3F33C4C
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 09dfaf79cc13bde40f37a77abe34c387a039cd0ed51b72eba4eb02a2864d19f5
