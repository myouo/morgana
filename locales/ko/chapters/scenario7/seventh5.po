msgid "⟪k:0⟫⟪k:1⟫⟪k:2⟫............"
msgstr "⟪k:0⟫⟪k:1⟫⟪k:2⟫…………."

#: scenario7:scenario7_F423A4CA_6100_483D_A674_DBE90030ECF5
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 37dfb9811e906978dc2f2af5c10b43d5a4e03af40717cfba06527ebf1d3be469
#. default-sha256: 88e41ab83f548a27092a6f90a3f49060a977781f8a0c89295cb8ad84c359ba82
msgctxt "scenario7:scenario7_F423A4CA_6100_483D_A674_DBE90030ECF5"
msgid "⟪k:0⟫When I first heard my brothers’ voices after so long, I thought I was hallucinating."
msgstr "⟪k:0⟫오랜만에 들은 두 형의 목소리, ⟪k:1⟫처음에는 그게 ⟪k:2⟫환청인 줄 알았다."

#: scenario7:scenario7_707C3528_0ED3_4B8C_84F9_332C4C18C445
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: a53e1a0a6dac1e0cc571b2953a5a74e77edda50e13fcfdde58d37093e28aadde
