msgctxt "scenario7:scenario7_9ECD9F30_D5FF_4DB9_A415_410F65846AB4"
msgid "⟪k:0⟫But—!"
msgstr "⟪k:0⟫그래도 말이야……!"

#: scenario7:scenario7_1FA67F55_EF23_43FC_936F_70CBAF94326A
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 1bddd60c4e0d55d81ccbe1e20cf8e21c84feacb3dfad5b2984c724b48e20c998
