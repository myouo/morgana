msgctxt "scenario7:scenario7_931B90A8_7F36_426E_8A22_5EE2C7BAC3B5"
msgid "⟪k:0⟫Lower your damned voice!"
msgstr "⟪k:0⟫너는 소리 좀 낮춰라!"

#: scenario7:scenario7_9ECD9F30_D5FF_4DB9_A415_410F65846AB4
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 485a963ab1cb2b0e2a0f3d55e68bfc58bbd4fe0823df13137da82e143de77cfe
