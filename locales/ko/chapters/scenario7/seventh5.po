msgid "⟪k:0⟫⟪k:1⟫⟪k:2⟫Michel... ⟪k:3⟫Michel, are you awake?"
msgstr "⟪k:0⟫⟪k:1⟫⟪k:2⟫미셸……, ⟪k:3⟫미셸, ⟪k:4⟫일어나 있냐."

#: scenario7:scenario7_DD9E9B27_5FA3_474F_83BD_2B242C9AC627
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 2056b50a8a4d9fc2d006b7f01acb4078e141f79971af355d5fde498af11b20d9
