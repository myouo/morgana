msgid "⟪k:0⟫⟪k:1⟫⟪k:2⟫Now, open the door, ⟪k:3⟫Michel."
msgstr "⟪k:0⟫⟪k:1⟫⟪k:2⟫자, ⟪k:3⟫문을 여세요. ⟪k:4⟫……미셸."

#: scenario7:scenario7_8A86B1D0_BF72_47AB_BA59_0FE2F2EFE272
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: b9f3a0e105f43a2387ece170afc5c3b4e2a6aeb90abab6264df6ba6e7d19e625
