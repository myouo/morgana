msgctxt "scenario7:scenario7_8A86B1D0_BF72_47AB_BA59_0FE2F2EFE272"
msgid "⟪k:0⟫Enticingly so."
msgstr "⟪k:0⟫나를 움직이게 했다."

#: scenario7:scenario7_CCCBCFB1_6548_4761_A7EB_DD6CF25A2928
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: d8527942a5ea37c15e5e6f2f383ebbfd6ccc6ed8869d6d389912c3a4e4130d74
