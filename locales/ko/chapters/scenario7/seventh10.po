msgctxt "scenario7:scenario7_EE26A5A7_5D28_4939_B54F_8D06D4837FB1"
msgid "⟪k:0⟫⟪k:1⟫And so..."
msgstr "⟪k:0⟫⟪k:1⟫그래서――"

