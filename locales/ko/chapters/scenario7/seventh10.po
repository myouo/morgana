msgid "⟪k:0⟫⟪k:1⟫I do."
msgstr "⟪k:0⟫⟪k:1⟫맞아."

#: scenario7:scenario7_6FC2541E_7EDE_4AA8_A380_23647591A82B
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 83d2f52f5e1d729ace82226733948fe6fae0c66bf68da7ea42d93d7d5dc67f36
#. default-sha256: 48bf1dcead2b553fe1f8d47a620f96e2b20d3d7e8f03c47ae065de1fddbc6335
msgctxt "scenario7:scenario7_6FC2541E_7EDE_4AA8_A380_23647591A82B"
msgid ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫Haha... ⟪k:3⟫You came all the way up here ⟪k:4⟫just⟪k:5⟫ to tell me that?⟪k:6⟫⟪k:7⟫"
"A needless formality."
msgstr ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫……후후……, ⟪k:3⟫겨우 그런 얘기나 하자고 ⟪k:4⟫몸소 여기까지 오셨군요? ⟪k:5⟫당신은 참 "
"⟪k:6⟫성실하시네요."

#: scenario7:scenario7_9266396C_7AD9_4B0C_BA3F_3283EE0A8CF2
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 7208dbcf701d7522063ae1b05bb346883f41f3b2a402816fa48a9540731a9272
#. default-sha256: 2bf0ea6aa3c4527027e168a28f339cf100e6c24c254ac3e7f2d794d415bcecc6
