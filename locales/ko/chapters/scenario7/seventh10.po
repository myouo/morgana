#: scenario7:scenario7_D9FF90F2_A55A_4456_8AAA_52BC068B4C01
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 40acf741e1de13314d3989c5f896e3e432bc24b16d60469073247a0f9e2945d7
#. default-sha256: c8e6ee15a8eae347e3a7a5bf738be6746052c2a591997da854adabf951773fa7
msgctxt "scenario7:scenario7_D9FF90F2_A55A_4456_8AAA_52BC068B4C01"
msgid ""
"⟪k:0⟫⟪k:1⟫My desires haven’t changed since our first encounter.⟪k:2⟫⟪k:3⟫I wish to be a person..."
msgstr "⟪k:0⟫⟪k:1⟫내 소원은 ⟪k:2⟫너와 만났을 때부터…… 바뀐 게 없어.⟪k:3⟫⟪k:4⟫나는 사람이자―――"

#: scenario7:scenario7_8B41CDCB_EDAB_4B67_B2AF_74E0A6E6EEB5
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: b15e35432f339a2b669a93b9212e3fd8992460ff3b7d08470487f74c047ecb4e
#. default-sha256: 99e4c77b8136f11f1e68b5b53fd975cfcd5198350b0fdedf1567ff6ba13ba8bf
