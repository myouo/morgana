msgid "⟪k:0⟫⟪k:1⟫⟪k:2⟫To be a man?"
msgstr "⟪k:0⟫⟪k:1⟫⟪k:2⟫남자이고 싶다고요?"

#: scenario7:scenario7_64053E54_4631_46A1_96B8_4F2DF71A2A13
