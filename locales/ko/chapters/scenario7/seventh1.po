msgid "⟪k:0⟫⟪k:1⟫I didn’t know you were home, Georges."
msgstr "⟪k:0⟫⟪k:1⟫조르주 형님, ⟪k:2⟫돌아오셨습니까."

#: scenario7:scenario7_98404427_389F_4D69_887E_D7799D4222A2
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: ff9ffea127ae68f3665513cc3e153885daace789e8ca5f3f1394e0fb403f3a9f
#. default-sha256: 55db8daabe4e2a4d9d993fb5394950948f6eb77134972bc281be004c54890394
msgctxt "scenario7:scenario7_98404427_389F_4D69_887E_D7799D4222A2"
msgid ""
"⟪k:0⟫⟪k:1⟫Just got back, yep.⟪k:2⟫⟪k:3⟫Ohoho, playin’ chess again, are ya?⟪k:4⟫⟪k:5⟫Lessee, what "
"do we have here?"
msgstr "⟪k:0⟫⟪k:1⟫방금 전에.⟪k:2⟫⟪k:3⟫하하앙, ⟪k:4⟫또 체스 둬? ⟪k:5⟫어디 전황 좀 보자."

#: scenario7:scenario7_8892F554_0600_4155_BDFE_A628C9B8BFC4
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: adbf149e0703031a9897a16ea8b516e96977278f77ff03fd9bf20681b6ef22ea
