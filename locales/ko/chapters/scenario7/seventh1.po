msgctxt "scenario7:scenario7_9DA2CE17_6D52_4AD7_8BE6_7554BB814987"
msgid "⟪k:0⟫And it had for as long as I could remember."
msgstr "⟪k:0⟫철이 들었을 때부터 ⟪k:1⟫이랬다."

#: scenario7:scenario7_DFBBA795_374C_4B95_A3D4_D000C829AE2C
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: f8d48ba0d6857516abae30e7cece09d03bd00ed3582fe93b01c499fcf3b3cc78
