msgctxt "scenario7:scenario7_22C434B2_4CF3_4B38_B305_E352B14E7470"
msgid "⟪k:0⟫While hardly anything unusual, it bothered me deeply."
msgstr "⟪k:0⟫그렇건만―― ⟪k:1⟫나는 강한 위화감을 느꼈다."

#: scenario7:scenario7_9DA2CE17_6D52_4AD7_8BE6_7554BB814987
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 67e774c4dd1ec6d1e316fecde156aa1a04ab51236e05db5dbe16d653a9d616a6
