msgctxt "scenario7:scenario7_1D59474D_9500_47E7_8F45_EC4626759061"
msgid "⟪k:0⟫⟪k:1⟫...Yes, Mother."
msgstr "⟪k:0⟫⟪k:1⟫………네."

#: scenario7:scenario7_C21A020B_1246_4398_9CF7_D41FF00FBC1D
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: d3d6bf6b8043d4ba7acab388bff90adcaa86b13965c9af8f09dac9e6774e3983
