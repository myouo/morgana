msgid "⟪k:0⟫⟪k:1⟫I have nothing but time."
msgstr "⟪k:0⟫⟪k:1⟫……심심했거든요."

#: scenario7:scenario7_4E77BB0A_41C7_4E74_BEFF_6D5F3A6E5C9F
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: eec8882e015633e06759c09fb211200ee0f2430cc630c36fef750fc60fd0b471
