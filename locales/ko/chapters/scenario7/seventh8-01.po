#: scenario7:scenario7_4192695C_CD64_45F6_B7B2_D9385A7FEC77
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: a1bdda4d1fc53c37b13003c927afa75f64eacfd871a16a0029a4cfe593765940
#. default-sha256: 0d1efb10d3ed3a15b80c39a5a09f0a1f314aaa4b68dafe0ef05a6e2d3f042cb0
msgctxt "scenario7:scenario7_4192695C_CD64_45F6_B7B2_D9385A7FEC77"
msgid "⟪k:0⟫When you arrived at this house... ⟪k:1⟫I felt the hands of fate at work."
msgstr "⟪k:0⟫당신이 이 저택에 오셨을 때―― 운명을 느꼈어요."

#: scenario7:scenario7_81463A50_FEBD_4A7A_9C7A_E2EC0C6BCF0C
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: ea45b3f450ae855e1223c324bc0f614037adced373c1ce29388f195762b4b688
#. default-sha256: 1b90e165c730775d2c7a0431b2844ed2ec215dd263a8cb6c28df244bd709c00f
msgctxt "scenario7:scenario7_81463A50_FEBD_4A7A_9C7A_E2EC0C6BCF0C"
msgid "⟪k:0⟫You’ve been through so much to get here..."
msgstr "⟪k:0⟫여기 오기 전까지 많은 고초를 겪으셨겠죠……."

#: scenario7:scenario7_D858E240_F039_447C_B1C0_07C43C90FB4C
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 29441701f52566a32b49569c779b7df061df0ef62170c1d26db410dd112a6677
#. default-sha256: ffcfbfe7cbff431aa9767bf890f2a0898c7dc960bc832b653f45221e1bf099ff
msgctxt "scenario7:scenario7_D858E240_F039_447C_B1C0_07C43C90FB4C"
msgid "⟪k:0⟫I know your pain."
msgstr "⟪k:0⟫저는 그 고통을 공유할 수 있어요."

#: scenario7:scenario7_A1F30229_A70F_4449_B9EA_47D4032BAEA2
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 22673762e988d5205364d4e0db66b486eaef517c16107490272bdbd8d8a486fb
#. default-sha256: 3e8f08995d82f74e85ef12f07b9424fecd0666ba02327b7504eb8f107cd623d2
msgctxt "scenario7:scenario7_A1F30229_A70F_4449_B9EA_47D4032BAEA2"
msgid "⟪k:0⟫You were the only one to ever have pity for me..."
msgstr "⟪k:0⟫당신만이 저를 불쌍히 여기셨듯이……"

#: scenario7:scenario7_9FA6C8F3_2B7D_4816_A931_950BCA707563
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 05700aad933443f7e1c356d31344eee334bb107e299bf14077e78289a00de200
#. default-sha256: 6523cd90b16d2e92dbebdb224f53bc1d88456ffcd18e0dbe8ee423d318a0019c
msgctxt "scenario7:scenario7_9FA6C8F3_2B7D_4816_A931_950BCA707563"
msgid "⟪k:0⟫and I shall do the same for you."
msgstr "⟪k:0⟫저만이 당신 곁에 있어 드릴게요."

#: scenario7:scenario7_ED94CB92_5964_46E6_9B5A_7065208EF56B
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 3f23c3fb0e194ca8d3b4ab691bbc0da3b64ecfdcf3b72bf9c4025615a6f278c9
#. default-sha256: a9156f1f0ed4a6d5f1907d59c44e796149fcf19b186fe0b1a628531d0b6d562f
msgctxt "scenario7:scenario7_ED94CB92_5964_46E6_9B5A_7065208EF56B"
msgid "⟪k:0⟫You can give me life again. You can resurrect me."
msgstr "⟪k:0⟫저는 당신의 손으로―― 되살아났으니까요."

#: scenario7:scenario7_7F088681_CBC3_406F_B370_45C16AA79EFD
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 27c6eeb26078045a67f0390b5763391435ec52353f3778d25959c840e81bb5cf
#. default-sha256: b56872e1b13e153174fbeea3455fc099f035609bf67f5f251b1a2e2a28730b1b
msgctxt "scenario7:scenario7_7F088681_CBC3_406F_B370_45C16AA79EFD"
msgid ""
"⟪k:0⟫It felt like I was no longer in control of my own body.⟪k:1⟫⟪k:2⟫Her voice was tender in a "
"way unlike either Mother’s or Aimee’s."
msgstr ""
"⟪k:0⟫내 의지가 ⟪k:1⟫개입하지 않는 것 같았다.⟪k:2⟫⟪k:3⟫어머니나 ⟪k:4⟫에이미하곤 다른 소녀의 ⟪k:5⟫맑"
"은 목소리가……"

#: scenario7:scenario7_E693A7E3_F555_4086_BBE8_BDB52E3857CF
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 2c254ddba1aad5ebddc477f5232a3b49233237e252d3c36d0792100367950be3
#. default-sha256: 41d0e4d5be26e9c57ef2a97b0c2a040838d8a8b9e055b8a9166ccc2b54d5abb4
msgctxt "scenario7:scenario7_E693A7E3_F555_4086_BBE8_BDB52E3857CF"
msgid "⟪k:0⟫It was empty."
msgstr "⟪k:0⟫그곳에는―― ⟪k:1⟫아무것도 없었다."

#: scenario7:scenario7_D33AF05A_D351_474B_AC22_EB755E2EBFAD
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 6d0386374d026c8bd821ec4e466a506c90bcc880fd86b5420d7daff240ae7299
#. default-sha256: 5b8a5e950978b15fe2abdba1513fb15dec4cc9d0d767f37c3bdb6bd7efc215b6
msgctxt "scenario7:scenario7_D33AF05A_D351_474B_AC22_EB755E2EBFAD"
msgid "⟪k:0⟫only her voice whispering in my ear."
msgstr "⟪k:0⟫귓가에 속삭이는 ⟪k:1⟫명료한 목소리만이 들렸다."

#: scenario7:scenario7_1F16E57D_9149_4683_A6EF_EE377EEF2BDD
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: f6ef23eb4ba3792de6888d06487e8f837510a81f1391f0788802ecb88172eb05
#. default-sha256: e9d08112e7cbeb29a91b4e15342dd705886856af5350eb720b8889498f592667
msgctxt "scenario7:scenario7_1F16E57D_9149_4683_A6EF_EE377EEF2BDD"
msgid "⟪k:0⟫You made this possible..."
msgstr "⟪k:0⟫당신 덕분에…… ⟪k:1⟫저는……"

#: scenario7:scenario7_38463CB7_E401_467F_9703_51F921B5D5D9
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 4dda76e243882d737bb6ead81cadb5b69ce20fb76840c2f541dc4f74921cb6e6
#. default-sha256: bde61fb32882d601067cf524984de0440eedf90641f8899babc8807d178afbd5
msgctxt "scenario7:scenario7_38463CB7_E401_467F_9703_51F921B5D5D9"
msgid "⟪k:0⟫Constant, everlasting despair..."
msgstr "⟪k:0⟫영원히 줄 수 있어요……."

#: scenario7:scenario7_2FA8154B_757D_40E8_B98D_4630AF243643
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 59d72743c930c2015fafefea6c09da169af01636fcdf3991756552c293e07c34
#. default-sha256: 3e0636901eff73823795d5893771c1d446b833f8e1e9a02a70aa6335a1e1ad0b
msgctxt "scenario7:scenario7_2FA8154B_757D_40E8_B98D_4630AF243643"
msgid "⟪k:0⟫Their flesh may turn to dust..."
msgstr "⟪k:0⟫비록 그 자들의 육체가 썩어 문드러져도……"

#: scenario7:scenario7_D4E5927C_C209_48BF_A235_21727A0C5234
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: e69a5c4be8a4fc42c049ecc424f9b04a18e191e50e37f7dac8224a2e2fe8f5ff
#. default-sha256: 355db66949871c4662f4e800d50f04421c616b5ac4d6fdb69508a4ca797406e2
msgctxt "scenario7:scenario7_D4E5927C_C209_48BF_A235_21727A0C5234"
msgid "⟪k:0⟫but so long as their souls live on, their torture will know no end..."
msgstr "⟪k:0⟫혼이 존재하는 한, ⟪k:1⟫고통을 줄 수 있죠……."

#: scenario7:scenario7_D449F5C1_B1B1_4276_B37A_ADD7D10D46BE
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 8a1ab1f0c4ba93c227b7882740155d36b589a5e8d58095c37132804403ef5b41
#. default-sha256: bd9a099eb834bab5290455bdd0e885ad290d60dce9afeaa2a7af583823f4105e
msgctxt "scenario7:scenario7_D449F5C1_B1B1_4276_B37A_ADD7D10D46BE"
msgid ""
"⟪k:0⟫The tenderness in her voice crumbled away, leaving only raw loathing behind. ⟪k:1⟫She then "
"let out a half-muffled cackle."
msgstr ""
"⟪k:0⟫덧없고 맑던 그 목소리는 ⟪k:1⟫증오에 찌든 목소리로 변모했다.⟪k:2⟫⟪k:3⟫이어서 ⟪k:4⟫감정이 서린 "
"웃음소리가 들렸다."

#: scenario7:scenario7_9BCB69A7_9EEB_4A04_BAB8_2B40788CF6C1
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: f9ade8e8c04b2d769fd19bdd393cc86b585dfab465212e7f3062b0a440505f1b
#. default-sha256: 28e64ea78b0697150cfe5864dbcd1308b21733d21a7e8d387cb71861620bb69c
msgctxt "scenario7:scenario7_9BCB69A7_9EEB_4A04_BAB8_2B40788CF6C1"
msgid "⟪k:0⟫Who ⟪k:1⟫are⟪k:2⟫ you?"
msgstr "⟪k:0⟫너는…… ⟪k:1⟫누구야……."

#: scenario7:scenario7_E2088DD3_5F4E_4D55_B5A4_21971D01EB82
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: fcc0f9416a819092391ed75fb619fa682b4bc0988b2ee3e4ad7f583611127eab
#. default-sha256: dc4c6c5cbc37db70d8b7202664afa97cfcac5f76144a839c951584150ee272c7
msgctxt "scenario7:scenario7_E2088DD3_5F4E_4D55_B5A4_21971D01EB82"
msgid ""
"⟪k:0⟫That I am.⟪k:1⟫⟪k:2⟫I am the cursed witch, who loathes this puny, wretched world—⟪k:3⟫⟪k:4⟫"
"⟪k:5⟫curses it."
msgstr ""
"⟪k:0⟫네……, ⟪k:1⟫저는 저주받은 마녀…….⟪k:2⟫⟪k:3⟫이 작은 세계를 증오하며 ⟪k:4⟫영원히 저주하는 마"
"녀……."

#: scenario7:scenario7_B635749A_FC83_4FFC_A662_B0FD9832BB0B
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: f6859add2981903e4b6a05c48896b2a9ba8956560575aa5a5d3aa53cfe5d437e
#. default-sha256: 7737541dd904789c2fa692f2eb9515f27aea1c143f65ec6a45ed41086df08a75
msgctxt "scenario7:scenario7_B635749A_FC83_4FFC_A662_B0FD9832BB0B"
msgid "⟪k:0⟫⟪k:1⟫And my name is Morgana."
msgstr "⟪k:0⟫⟪k:1⟫제 이름은 모르가나."

#: scenario7:scenario7_771B2BBE_68D4_4842_B6F4_FAF4FD301BC8
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 7357e139e14a309f73ac34e06d503cd8894b285179adec4a42d036ed2ffeb73f
#. default-sha256: 9250da86e5c43002be93588112f5cc5006c5964991b706a690c6765835c693f4
msgctxt "scenario7:scenario7_771B2BBE_68D4_4842_B6F4_FAF4FD301BC8"
msgid "⟪k:0⟫Morgana..."
msgstr "⟪k:0⟫모르가나………."

#: scenario7:scenario7_745E07C6_2877_4A93_BE88_6009A8257722
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: b26c10f5c2448b3c621e4fe303b4fc5bffb427f0838521caf8b40d893fb688b8
#. default-sha256: 20547bd5e86e78f02d58f919155c2517573976b7413f6c29f80898d7c424e4d9
msgctxt "scenario7:scenario7_745E07C6_2877_4A93_BE88_6009A8257722"
msgid ""
"⟪k:0⟫I could place a curse on someone you have a grudge against.⟪k:1⟫⟪k:2⟫Drag them down into the "
"dark abyss."
msgstr ""
"⟪k:0⟫당신이 증오하는 인간을 ⟪k:1⟫저주해 드릴게요.⟪k:2⟫⟪k:3⟫빛이 안 드는 어둠 속으로 ⟪k:4⟫떨구는 거"
"죠."

#: scenario7:scenario7_5591326A_723D_440F_BD0C_467CDB8381D6
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 9e0da178ff543d84fb8e9df8c447bd574e8b30786d3ff2484bc68144f0903402
#. default-sha256: 5e46e50ce2a2cbc702af979f4190afe9ccfe686a74c4cd0ad725129cfed4b6bd
msgctxt "scenario7:scenario7_5591326A_723D_440F_BD0C_467CDB8381D6"
msgid "⟪k:0⟫And for that, I will grant you your wish."
msgstr "⟪k:0⟫그러니 ⟪k:1⟫소원을 이루어 드릴게요……."

#: scenario7:scenario7_4965D32C_A833_4DA2_A2B2_72ED7724F309
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: f33ab3c8fc2e5b82cef7421e82a0438cb33547d6ff994d2e269b9b71715d3c90
#. default-sha256: 5dc8819323c2be3f134c6108e143a57d38c593672b2c68b84d9a2a05a5f7032d
msgctxt "scenario7:scenario7_4965D32C_A833_4DA2_A2B2_72ED7724F309"
msgid "⟪k:0⟫if you remain steadfast in your desires, they will become reality,"
msgstr "⟪k:0⟫굳센 마음으로 ⟪k:1⟫기도하다 보면…… 실현돼요."

#: scenario7:scenario7_C9983542_4050_4C4B_8BDE_1D60BA4A957C
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: b8454e9d74eab7cf9d350a99348dcfc2288bcfff0a1cc493e597b0374b28fbc1
