msgid "⟪k:0⟫............"
msgstr "⟪k:0⟫…………."

#: scenario7:scenario7_F26DF4E0_B5F5_4A9A_AADA_023B06F5F5DA
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 82e381d2d96eda3adc6af44adc1e70991490678ba717a6997c08d40be4fae950
#. default-sha256: c37e96471c512231796ce8c65387c213b96a8afa495efd4688a84d449b4ee1e3
msgctxt "scenario7:scenario7_F26DF4E0_B5F5_4A9A_AADA_023B06F5F5DA"
msgid "⟪k:0⟫Tell me who you wish to curse...⟪k:1⟫⟪k:2⟫and I can lead them here."
msgstr "⟪k:0⟫당신이 저주하고픈 사람을 알려 주시면…… ⟪k:1⟫저는 반드시…… 그 사람을 이끌게요."

#: scenario7:scenario7_5455BC8D_74CC_4A29_9CA7_A75AD3ED4949
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 5d9127fa36c7b3e3063a931cca3102b556eeb8ac78bb2050a813b007c495382b
#. default-sha256: 3520befe233d5fde7f1e201ef19fe182cf7b7b1d7aaec70a74fcf00a47b41b48
msgctxt "scenario7:scenario7_5455BC8D_74CC_4A29_9CA7_A75AD3ED4949"
msgid "⟪k:0⟫I can force the cross you were made to bear onto them."
msgstr "⟪k:0⟫그리고…… 당신이 짊어진 불행을 ⟪k:1⟫그 사람이 겪게 만들겠어요."

#: scenario7:scenario7_DCB2D6AB_E33F_4477_9CBE_4AB12A0CCD9A
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: b5941609c520ea8bee2b8b078163873ac161259ec912a471ef18828eef449534
#. default-sha256: 97ef78b8247bc8fae2762e032b282070865bec085991f268ce30adda961e90e8
msgctxt "scenario7:scenario7_DCB2D6AB_E33F_4477_9CBE_4AB12A0CCD9A"
msgid "⟪k:0⟫Georges..."
msgstr "⟪k:0⟫조르주…… ⟪k:1⟫형님을……."

#: scenario7:scenario7_CD0DCF14_1A13_4F5B_8915_D36D67C12D3C
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: a2079cbd0fec47fd0b1ee7f9b8846217e33e954932d69214b5c7e84b39788e82
#. default-sha256: 471db2e4a59632f598d5ff24d443401754c9d19fe7f717bf076db569be935e16
msgctxt "scenario7:scenario7_CD0DCF14_1A13_4F5B_8915_D36D67C12D3C"
msgid "⟪k:0⟫Shall we kill him?"
msgstr "⟪k:0⟫콱 죽이죠……."

