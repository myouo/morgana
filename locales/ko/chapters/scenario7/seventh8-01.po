#: scenario7:scenario7_88E91C20_1FAC_4F1B_8BB7_CAF9D0FF2818
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: dff243396122c7e6fefb2a6f5e30ae0c52a6b50c15a1d512311f75a08aa99815
#. default-sha256: e5d15bd07b2ef06e766ab1ea532aff3cb275571bfa10df1040d9b7b454ae0409
msgctxt "scenario7:scenario7_88E91C20_1FAC_4F1B_8BB7_CAF9D0FF2818"
msgid ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫⟪k:4⟫⟪k:5⟫⟪k:6⟫⟪k:7⟫⟪k:8⟫⟪k:9⟫For so long, I have been waiting.⟪k:10⟫⟪k:11⟫"
"Waiting for the day I would be rid of this darkness."
msgstr ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫⟪k:4⟫⟪k:5⟫⟪k:6⟫⟪k:7⟫⟪k:8⟫⟪k:9⟫저는 오랫동안 기다렸어요. ⟪k:10⟫이 어둠의 세계에"
"서 나오는 날을――"

#: scenario7:scenario7_EC62F4D2_4935_49F4_B0A7_B492F0D33511
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: b8454e9d74eab7cf9d350a99348dcfc2288bcfff0a1cc493e597b0374b28fbc1
