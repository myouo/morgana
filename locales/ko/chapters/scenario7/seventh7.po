msgctxt "scenario7:scenario7_00600734_021A_4638_A6FC_DC5987DEE7F9"
msgid "⟪k:0⟫And that’s precisely what happened."
msgstr "⟪k:0⟫실제로도 ⟪k:1⟫지젤은 당신을 거절했으니까요."

#: scenario7:scenario7_4555C85C_7547_4B45_96CF_4A05F9159693
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 0f68a5a048f6eced56f49296564a0cce8489ee6a36dfcc6ae8860c05d227c751
