msgctxt "scenario7:scenario7_9F728206_D7EF_4E18_A7D5_C4953F7D7C41"
msgid "⟪k:0⟫And perhaps... ⟪k:1⟫you could tell me how much my soul weighs too."
msgstr "⟪k:0⟫또…… ⟪k:1⟫제 혼의 무게가…… 얼마나 되는지."

#: scenario7:scenario7_FA1A0764_45B3_44ED_B663_B811C6F46B52
