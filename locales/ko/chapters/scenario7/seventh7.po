msgid "⟪k:0⟫............"
msgstr "⟪k:0⟫…………."

#: scenario7:scenario7_A61B843E_6FBB_4813_AB1A_9706B0A29741
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 7d22d8828099e8778c00ec5776b92a9432b30a27a9432236f6ca98b1d5f9de76
#. default-sha256: b7f76b9b62f15b39e0791c5df2c5ddc8aa86ab03c08d6d5e229eb9ecfb723110
msgctxt "scenario7:scenario7_A61B843E_6FBB_4813_AB1A_9706B0A29741"
msgid ""
"⟪k:0⟫Doesn’t it seem a bit unfair, Michel?⟪k:1⟫⟪k:2⟫You tore down the walls around Giselle’s "
"heart, around her past,"
msgstr ""
"⟪k:0⟫미셸……, ⟪k:1⟫비겁한 거 아닌가요.⟪k:2⟫⟪k:3⟫지젤의 과거는―― 그 마음의 흉터는 ⟪k:4⟫들춰 놓고."

#: scenario7:scenario7_66CA2B35_CBEA_453C_B4CA_045F2AA56432
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 37f3508bd4cb43b45fd8a6e74730f45e28eed0a80f50a08126fe85e892c75dfa
#. default-sha256: c78f0536f72e45894fad8a55c1171143459fca51a2b8a382a738295adf71a561
msgctxt "scenario7:scenario7_66CA2B35_CBEA_453C_B4CA_045F2AA56432"
msgid "⟪k:0⟫but you wanted to keep your own nice and safe and hidden away."
msgstr "⟪k:0⟫본인의 흉터는 숨기려고 들다니요."

#: scenario7:scenario7_487160CF_D97E_429C_8936_DFF965E16044
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 0f68a5a048f6eced56f49296564a0cce8489ee6a36dfcc6ae8860c05d227c751
