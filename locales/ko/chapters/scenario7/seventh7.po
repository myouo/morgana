msgctxt "scenario7:scenario7_9C16AE7A_4C5F_453F_B2FF_F8ED60FD6DD4"
msgid "⟪k:0⟫⟪k:1⟫A..."
msgstr "⟪k:0⟫⟪k:1⟫………이건………."

#: scenario7:scenario7_9C229545_33D1_471B_BC3C_74EEADDDC7E9
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: c1fa88b8cf74c710c8bcf6cf1c7ae0e09bc64c7ba0e9e235e1dd383fd7eef93f
#. default-sha256: d3fb1857cf50c6c00bd00d59e91f7fbed20138f3fe6da2989c9c73ed6dbd61e9
msgctxt "scenario7:scenario7_9C229545_33D1_471B_BC3C_74EEADDDC7E9"
msgid "⟪k:0⟫stained-glass window...?"
msgstr "⟪k:0⟫스테인드 글라스……?"

#: scenario7:scenario7_B12DF282_261A_452D_8216_44715016049B
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: ad6a28557db77d9a498524ea2da94c91777579bb9efef168cde65139199990df
