#: scenario7:scenario7_2C293D69_3002_4295_AEB8_9FAF13C3DBE8
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: ea8299bafc49856e83c1052f266575a4aea297d84c332953f921aff919deaad0
#. default-sha256: cec83205f54e9d08e3b01ac2079db38689aa6cb18bccd01e9421a11c0362e26f
msgctxt "scenario7:scenario7_2C293D69_3002_4295_AEB8_9FAF13C3DBE8"
msgid "⟪k:0⟫She has every right to be upset."
msgstr "⟪k:0⟫지젤도 화가 날 만해요……."

#: scenario7:scenario7_5431043D_B74A_448E_A00B_6FE96095FDE0
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 0f68a5a048f6eced56f49296564a0cce8489ee6a36dfcc6ae8860c05d227c751
