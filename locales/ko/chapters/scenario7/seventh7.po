#: scenario7:scenario7_EFB61159_3CD4_494C_9278_317FEAA6FC75
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: fbff8a739d26cbebf9a17039eb04e9db68bcaea1bcb957952b9c9d4c95bbfa16
#. default-sha256: 8c1fa092bbaf54fad5c4e45317fdb8c689b873439c32c763c2e609d54382c73d
msgctxt "scenario7:scenario7_EFB61159_3CD4_494C_9278_317FEAA6FC75"
msgid "⟪k:0⟫But can you honestly blame her?"
msgstr "⟪k:0⟫하지만…… 뭘 어쩌겠어요.⟪k:1⟫⟪k:2⟫정상적이라면 ⟪k:3⟫못 받아들여요."

#: scenario7:scenario7_AC7D6F8D_2FF8_4974_8F51_9EE8A1E9B614
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 66a26ac7f5e3330de8aaa5f7319849e03c3f1c8bb7ee454919932f87c056ea0e
#. default-sha256: 6048d3586a21d3493e76e8213088d0ca524554aacd05f231b0b2456007d6ce6b
msgctxt "scenario7:scenario7_AC7D6F8D_2FF8_4974_8F51_9EE8A1E9B614"
msgid "⟪k:0⟫The truth you’ve kept hidden away is not something most would be able to accept."
msgstr "⟪k:0⟫당신의 비밀과 ⟪k:1⟫과거는요."

#: scenario7:scenario7_3CB6D232_B56D_4D48_9A1A_793C42F14A17
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: ab7d575f49e60f4644009df2d0196123ea181ad3943a295803340092b114b1d4
#. default-sha256: afcf52b8d526bc56f5ef118cc4b5c1312f6b0d5d3fd9c130975e6ae95a2b4400
