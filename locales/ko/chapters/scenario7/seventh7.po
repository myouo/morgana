msgctxt "scenario7:scenario7_933BF01C_F2A4_4DAA_9DE6_EE0873D08279"
msgid "⟪k:0⟫⟪k:1⟫Probably not very much..."
msgstr "⟪k:0⟫⟪k:1⟫필시…… ⟪k:2⟫가벼울 테죠……."

#: scenario7:scenario7_51EE7D7E_C2F2_4960_B156_BC5FD7AB4C4F
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 690af5eb124070085965caf7ae19f2685f1f4e78c8726210ae919f12af1afea3
