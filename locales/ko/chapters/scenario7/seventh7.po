msgctxt "scenario7:scenario7_6858B302_A59E_4CA5_ABC1_BA1B62686BE5"
msgid "⟪k:0⟫If I truly am cursed..."
msgstr "⟪k:0⟫제가 저주받았는지……."

#: scenario7:scenario7_9F728206_D7EF_4E18_A7D5_C4953F7D7C41
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 7462adb6cfe027436917801e272fe7dc88803b6ff595d62c56085182ce829071
