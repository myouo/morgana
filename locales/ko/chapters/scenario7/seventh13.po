msgctxt "scenario7:scenario7_0C31D945_0A4D_40AB_AF8A_632FDCEE4025"
msgid "⟪k:0⟫It’s time..."
msgstr "⟪k:0⟫……지금이 바로……"

#: scenario7:scenario7_4B3F8C8C_DE39_443B_8124_F4B6CF653993
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 7cb2d4bcc578547348b8ef69035b45fe7b5bc405d9139765cccf504120efaee8
