msgid "⟪k:0⟫I empathized... ⟪k:1⟫with your loneliness."
msgstr "⟪k:0⟫그 고독에…… 공감이 갔어."

#: scenario7:scenario7_86A6FCC3_106A_4053_9A69_97CEB67B05C4
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
