msgctxt "scenario7:scenario7_368C5D2A_599F_4CB2_B091_B47F140C350E"
msgid "⟪k:0⟫To tell you the truth... ⟪k:1⟫I didn’t see this coming."
msgstr "⟪k:0⟫……솔직히…… ⟪k:1⟫놀랐어요."

#: scenario7:scenario7_A9CA6166_6219_4F16_A7B5_D37A86BA0DEF
