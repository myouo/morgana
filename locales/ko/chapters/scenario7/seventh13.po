msgid "⟪k:0⟫⟪k:1⟫............"
msgstr "⟪k:0⟫⟪k:1⟫…………."

#: scenario7:scenario7_1CC25982_A7E2_4DBD_8E96_356416572920
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 2c9ebd7ccdb931692f529ac0ae42554721c2b1f484bc20727037f54e66717dc3
