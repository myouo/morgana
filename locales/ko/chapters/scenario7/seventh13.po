msgid "⟪k:0⟫............"
msgstr "⟪k:0⟫…………."

#: scenario7:scenario7_ED8225E5_2C12_4444_9A7D_0677B39F5AA8
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: a089edd0df31e667a6d6a35ba26a5528d7b0a41730e10e75df653872debb4ae7
#. default-sha256: 07c70a2cbbb52c1a4407ae600206a7eda8f3ad21d17d07b8a11493e23702f76c
msgctxt "scenario7:scenario7_ED8225E5_2C12_4444_9A7D_0677B39F5AA8"
msgid ""
"⟪k:0⟫A little self-esteem isn’t going to make you any less helpless when you step through that "
"door."
msgstr ""
"⟪k:0⟫당신이 긍정적으로 변하든 말든……⟪k:1⟫⟪k:2⟫이 문을 연다고 ⟪k:3⟫당신이 뭐가 가능하진 않을걸요."

#: scenario7:scenario7_DEC5725A_8512_4222_8010_1058FEE8A8E8
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 7e1b616dbe018d5e022b4388ac54df884af4bda9cd46b1bf937a147c151d4f00
#. default-sha256: 3db445f68dba881e25e75eb0de512adf6a767c0099d42163298d0c53d193f94e
msgctxt "scenario7:scenario7_DEC5725A_8512_4222_8010_1058FEE8A8E8"
msgid "⟪k:0⟫But that won’t stop me from trying."
msgstr "⟪k:0⟫지금은…… ⟪k:1⟫가능한 걸…… 할 거야."

#: scenario7:scenario7_5FA09041_5004_439E_82C7_8C289EC97455
