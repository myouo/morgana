#: scenario7:scenario7_5E152E05_968B_40E9_A2DE_B9B567E2E98E
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 48e006083a65c00dfc7d1323341b22a5e133a97f2358889c4debd5cd6474501f
#. default-sha256: c4cbba0a6c5feb71b2618ad01c10425cb2ddef17867aa74be70330fc550951c1
msgctxt "scenario7:scenario7_5E152E05_968B_40E9_A2DE_B9B567E2E98E"
msgid "⟪k:0⟫I’m done acting like you’re some inevitability—⟪k:1⟫⟪k:2⟫⟪k:3⟫some force of nature."
msgstr "⟪k:0⟫너와 마주할 각오는 마쳤어."

#: scenario7:scenario7_0C31D945_0A4D_40AB_AF8A_632FDCEE4025
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 65be8d2084f663630aa19cad9500c58ab40b9a88629cb1bfde045986f97e09d3
