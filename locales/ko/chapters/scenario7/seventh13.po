msgctxt "scenario7:scenario7_4B3F8C8C_DE39_443B_8124_F4B6CF653993"
msgid "⟪k:0⟫for me to take a stand, Morgana."
msgstr "⟪k:0⟫대치할 순간이야, ⟪k:1⟫모르가나."

