msgctxt "scenario7:scenario7_B0E88E04_7456_4076_8BFF_6E0903327CD8"
msgid "⟪k:0⟫⟪k:1⟫Well, I can’t say I blame you.⟪k:2⟫⟪k:3⟫Who would believe the word of a witch?"
msgstr "⟪k:0⟫⟪k:1⟫뭐…… 그렇게 보실 만도 하겠네요,⟪k:2⟫⟪k:3⟫마녀의 말은 믿을 게 못 되죠."

#: scenario7:scenario7_2BB206BC_7DCE_4FD5_8EBA_918311D467A4
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 7ff717bf757d088219e93a4338ba145a55f56c12f873be318c367662da5da7c3
