msgctxt "scenario9:scenario9_EDA5A59B_1C8D_42AA_B3CE_97BFD760A867"
msgid "⟪k:0⟫I was trying to get back to the mansion..."
msgstr "⟪k:0⟫나는 저택으로 돌아가려…… ⟪k:1⟫했는데……."

#: scenario9:scenario9_5A6522EC_2818_41C0_A275_E01EFE5F6893
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: c1302686ab7075d2b59d72ba360276e9e2ccc6219572cc4319219a6db7aac317
