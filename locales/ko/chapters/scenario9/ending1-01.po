msgid "⟪k:0⟫What? ⟪k:1⟫Why is... ⟪k:2⟫the White-Haired Girl here...?"
msgstr "⟪k:0⟫어째서…… ⟪k:1⟫여기에…… ⟪k:2⟫백발 소녀가……."

#: scenario9:scenario9_EDA5A59B_1C8D_42AA_B3CE_97BFD760A867
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: c888d581cd8ef54ac100e499fe9b8c1a3907643620343af5a33f8bd9dbe7702c
