#: scenario9:scenario9_4CAF03CD_72D6_4EEB_9E8D_67CE76E05838
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 5bcb4f9729b95b7ec412cb1e355ebadee74c9925c626fa36b5057169ec386080
#. default-sha256: e0c63aa336e1dc9a4a81a4e048b11f6369c651809d379545549fcc0620dda93e
msgctxt "scenario9:scenario9_4CAF03CD_72D6_4EEB_9E8D_67CE76E05838"
msgid "⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫⟪k:4⟫We meet at last..."
msgstr "⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫⟪k:4⟫……마침내…… ⟪k:5⟫당신과 만나는군요……."

#: scenario9:scenario9_7F8EE5F7_11D1_4996_A0CA_9123B8E172A8
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: b29c9e2d40e5cadea6b56018f3e77ad55348f32c3df5911057f1d3876b5a1615
#. default-sha256: 83b36ebe0171248ca4957faa3ef2a48ab1706c426e2427124780f909bec6f9ed
msgctxt "scenario9:scenario9_7F8EE5F7_11D1_4996_A0CA_9123B8E172A8"
msgid "⟪k:0⟫Never mind that... ⟪k:1⟫Where ⟪k:2⟫am⟪k:3⟫ I?"
msgstr "⟪k:0⟫아니……, ⟪k:1⟫여긴…… ⟪k:2⟫대체……."

#: scenario9:scenario9_7A53115B_CAC3_4A69_B7CF_15B5D7581784
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 05e5f3b60bece76f4ce24cae9b4f0b8f58e6ae4e5c866678eed83ce700686ad8
#. default-sha256: f98e5bc1dfc7fada4be7d55e5a76ae4e7a558aeebad9bcacee1dac09830ad7af
msgctxt "scenario9:scenario9_7A53115B_CAC3_4A69_B7CF_15B5D7581784"
msgid "⟪k:0⟫Of course I do...⟪k:1⟫⟪k:2⟫How could I ⟪k:3⟫not⟪k:4⟫ know who you are?"
msgstr "⟪k:0⟫당연하지……, ⟪k:1⟫너를…… ⟪k:2⟫어떻게 모르겠어……."

#: scenario9:scenario9_5F8FC082_08D1_41B5_AF9E_44E99A4CA02F
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 04a572ec90a230b89f5806154ae3442a59d52f9e3dafc3d690bb56919840d47f
#. default-sha256: 4a798bf191b9544cfa3a3bcdd1c23aace57fa81db9ce8c6edbb0aa278b7b9f46
msgctxt "scenario9:scenario9_5F8FC082_08D1_41B5_AF9E_44E99A4CA02F"
msgid "⟪k:0⟫Splendid."
msgstr "⟪k:0⟫그래요……, ⟪k:1⟫다행이네요……."

#: scenario9:scenario9_EF768DFA_9AB5_4F1E_9BAC_8B54FEC7F54E
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: e49ff182d47291deda353bcb0f72937b7368a17d67133bf92176ce400aad238e
#. default-sha256: 02d05fca1cd4aab87e631fa493462eb51422cffe802f9c7f0b8c6d210503cfb1
msgctxt "scenario9:scenario9_EF768DFA_9AB5_4F1E_9BAC_8B54FEC7F54E"
msgid "⟪k:0⟫Why is there a sword in your hands?"
msgstr "⟪k:0⟫그 검은…… ⟪k:1⟫뭐야……?"

#: scenario9:scenario9_68EEC317_9276_4E14_A303_77624A0F3FB5
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 29d31f8748d56d81661af1fb2e29f95c4d72f25565d17a6b3636f4d2117b2d0e
#. default-sha256: 28b29062632cee263e324818a28f3a2cc6005b3c11b01918029152c4e6690e0b
msgctxt "scenario9:scenario9_68EEC317_9276_4E14_A303_77624A0F3FB5"
msgid ""
"⟪k:0⟫I realize that it’s cruel for me to ask this of you,⟪k:1⟫⟪k:2⟫and for that, I deeply "
"apologize."
msgstr "⟪k:0⟫당신에게…… ⟪k:1⟫매우 힘든 부탁을 하는 거긴 해요.⟪k:2⟫⟪k:3⟫그게…… 죄송스럽기도 해요."

#: scenario9:scenario9_148F91BC_E4C1_467E_B6E2_A38C3FA5AEE7
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 3ac4671f3330fb71fb87fd9db55c1b524a439bfa4e579bf3e7e523426064af9d
#. default-sha256: 7a35ec46aba9d8d79829bf4bd6724fe390d8ddb377e03aa37e4a5bbff63fc843
msgctxt "scenario9:scenario9_148F91BC_E4C1_467E_B6E2_A38C3FA5AEE7"
msgid ""
"⟪k:0⟫That’s not why I sought the truth...⟪k:1⟫⟪k:2⟫Not because I wanted to see anyone "
"“extinguished”..."
msgstr "⟪k:0⟫나는…… ⟪k:1⟫누군가를 소멸시키려고…… ⟪k:2⟫행동한 게 아니야……."

#: scenario9:scenario9_04875D08_CAE1_4730_9063_7003DD5C6999
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 1154437eee565c47944b20f2a38301f4158f3b4db79e210a10b6a6cfae26b6b0
#. default-sha256: 2b94272d2fd1e0eebc0b6336359c2b180293182648984ab756b9f91633b46f2b
msgctxt "scenario9:scenario9_04875D08_CAE1_4730_9063_7003DD5C6999"
msgid "⟪k:0⟫Because I wanted to put an ⟪k:1⟫end⟪k:2⟫ to this cycle of pain and suffering..."
msgstr "⟪k:0⟫누구도 보답을 못 받는 연쇄를…… ⟪k:1⟫끊으려고……."

#: scenario9:scenario9_DE0645BD_A94B_49F2_97B1_549192018D30
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 25e6d663ab2035eaef4764d9645e031b6f286c8e3b11c94fda05445493968b53
#. default-sha256: 548ec36b3d9e607fa7f3409898879c62e895a94814a0f880d4990244e48cdcca
msgctxt "scenario9:scenario9_DE0645BD_A94B_49F2_97B1_549192018D30"
msgid "⟪k:0⟫That includes you."
msgstr "⟪k:0⟫그건…… ⟪k:1⟫너도…… ⟪k:2⟫예외가 아니었어……."

#: scenario9:scenario9_47FB5147_8F88_4FBA_BD47_47D48530ED8A
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: c0eeb383b0fefd9df1f42f0134ac725dd02ccda82e5d27ccb3708118dced9d84
#. default-sha256: ebdd3aa9218ecdac7a1302c0b75ab49403a6acacca8b2c956a17bd7f2fbf9c5d
msgctxt "scenario9:scenario9_47FB5147_8F88_4FBA_BD47_47D48530ED8A"
msgid "⟪k:0⟫I was not a victim in the tragedies...⟪k:1⟫⟪k:2⟫I am culpable for them."
msgstr "⟪k:0⟫저는…… 비극에 휘말리는 피해자가 아니라……⟪k:1⟫⟪k:2⟫비극을 일으킨 가해자였어요."

#: scenario9:scenario9_830104B4_BEF4_412F_BDDC_A90871F518EB
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: db945d2ae2e9b0dae2c8797befb59b3cf5cdb378b4c801730b74f874de99ae36
#. default-sha256: bfa3619de1aacaeb1bcde9ab0401c072cfbb6780a1778b5ec9f23144638fe02c
msgctxt "scenario9:scenario9_830104B4_BEF4_412F_BDDC_A90871F518EB"
msgid "⟪k:0⟫I saw everything, from start to finish."
msgstr "⟪k:0⟫나는…… ⟪k:1⟫봤단 말이야……. ⟪k:2⟫너를…… ⟪k:3⟫여러 번……."

#: scenario9:scenario9_0AE6046F_3ED5_40C0_85EA_E230A5B45AA4
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 9137d85890612e7aa74830544725fd7b1b9afffa3e3ce7503177b3c730579ad6
#. default-sha256: bcf78cd9b88eebdc9df8cb4ea8e45cd5186718f53a9a4ae7faa0161eb84dfcdf
msgctxt "scenario9:scenario9_0AE6046F_3ED5_40C0_85EA_E230A5B45AA4"
msgid "⟪k:0⟫The question... ⟪k:1⟫of what I am."
msgstr "⟪k:0⟫저란 존재의…… 정체예요."

#: scenario9:scenario9_CAE2958D_3138_4A74_BE43_EB9F4F99CF1A
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 26b1a66ab762124f98a3cf451faa9cebdc9d25acefe227cbbad7f1879eca1393
#. default-sha256: 31b54adc12e8b28c98d65600e59c1d439b16301d3d9228e49b6b12fab27675af
msgctxt "scenario9:scenario9_CAE2958D_3138_4A74_BE43_EB9F4F99CF1A"
msgid "⟪k:0⟫............"
msgstr "⟪k:0⟫…………."

#: scenario9:scenario9_3E50B9A6_CAE2_4F7F_8B64_AC4D3DF8CAE5
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: cfb7abc6b6103818fd411a33758033ba86b15ccb4f732b133dd8c2c9518f6380
#. default-sha256: 2b95586c56a852557b01b72f7e1fe75d6f519e48d171092806674096c80847c4
msgctxt "scenario9:scenario9_3E50B9A6_CAE2_4F7F_8B64_AC4D3DF8CAE5"
msgid "⟪k:0⟫I was, as you ascertained, created by Morgana’s mind as it broke down in that tower."
msgstr "⟪k:0⟫저는 ⟪k:1⟫당신이 밝혀내셨듯이 ⟪k:2⟫한계에 내몰린 모르가나의 정신이 만든 인격이에요."

#: scenario9:scenario9_E4F254F0_79F2_42C0_A49A_1A604A14E118
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 2ef133e109da587f74236705103a8a4fa863fb326b3ec2b7cce901dc10b0c5e7
#. default-sha256: 652b4e4f89ba56f36eafad21464665cb802295c339e6f17aca94710835853f7f
msgctxt "scenario9:scenario9_E4F254F0_79F2_42C0_A49A_1A604A14E118"
msgid "⟪k:0⟫The fact that she viewed herself as a saint only served to amplify that agony."
msgstr ""
"⟪k:0⟫모르가나의 고통을 더욱 크게 키운 건 ⟪k:1⟫본인이 성녀라는 멍에였어요. ⟪k:2⟫성녀란 개념은 ⟪k:3⟫"
"모르가나 안에선 존재의의이자――"

#: scenario9:scenario9_19D976E8_DA0B_4502_90FC_4BD8611A2DAD
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 17eca91f6a6ad22355a8b5afab2aaa64b3497bc83e3b44b67314f82971770320
#. default-sha256: a3cca63ee85f2a52d1cc695f0d3f3eccc8aaf12708d27828682b1dcf62dd7dbc
msgctxt "scenario9:scenario9_19D976E8_DA0B_4502_90FC_4BD8611A2DAD"
msgid ""
"⟪k:0⟫She wanted to hate them, but her identity would not allow her.⟪k:1⟫⟪k:2⟫Those two "
"conflicting aspects of her self tore Morgana apart.⟪k:3⟫⟪k:4⟫She was unable to withstand it."
msgstr ""
"⟪k:0⟫증오하고 싶지만 ⟪k:1⟫성녀란 멍에가 방해하는 상황…….⟪k:2⟫⟪k:3⟫모르가나는 ⟪k:4⟫그 끔찍한 고통"
"을 ⟪k:5⟫견디지 못 했어요."

#: scenario9:scenario9_20348580_23F0_480E_B537_06DE51FCD92D
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 3cc5df363c35d3c731a64340730761473019db5fa7c901524eadf37337ccfcd9
#. default-sha256: f9159f3b03bfdf419844705600ad08ed3b50c38f054fa43641339671dfb9a6e9
msgctxt "scenario9:scenario9_20348580_23F0_480E_B537_06DE51FCD92D"
msgid ""
"⟪k:0⟫When you came to the mansion and resurrected Morgana,⟪k:1⟫you resurrected me as well. ⟪k:2⟫"
"But I had no “self” at first."
msgstr ""
"⟪k:0⟫당신이 저택에 와서 ⟪k:1⟫모르가나를 되살리셨을 때……, ⟪k:2⟫저도 똑같이 되살아났어요. ⟪k:3⟫하지"
"만 ⟪k:4⟫저란 의지는 ⟪k:5⟫어디에도 없었죠."

#: scenario9:scenario9_8F2F6F70_E9CD_4537_BD1D_4E10BA755ECD
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 1d7558ed1c79662a28f662711e7793d5cf27564445ae9751c6f8408bd3a2982e
#. default-sha256: 0af6a32bf7cb517054e73150747e5019573515d41b50bbebcf78ac03808dddb8
msgctxt "scenario9:scenario9_8F2F6F70_E9CD_4537_BD1D_4E10BA755ECD"
msgid ""
"⟪k:0⟫I was, I suppose, not much different than the particles of dust floating around the mansion."
msgstr "⟪k:0⟫빗대자면…… ⟪k:1⟫저택에 맴도는 물질 중 하나였을 거예요."

#: scenario9:scenario9_345DE38B_7BBA_447C_85FD_38908279F629
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: d9bf79270a050f397612c762239eede090d474bd48e0ed0369db2d9a1e8f926b
#. default-sha256: 3aaa668fbaed4a4c565ecbc6d78680f114256460b3a539286aa392d9851ec482
msgctxt "scenario9:scenario9_345DE38B_7BBA_447C_85FD_38908279F629"
msgid "⟪k:0⟫and descended into the realm of man and the fate which governs it."
msgstr "⟪k:0⟫그리고 ⟪k:1⟫의지를 얻은 저는 ⟪k:2⟫사람들의 운명 속으로 내려갔어요."

#: scenario9:scenario9_3E9DBD4F_9BD0_4586_B216_C3C3AD288452
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 76de843314544669c82754db4d173ea70bb6468b73896d729d2dfeda986a7d1a
#. default-sha256: fa2ee7156a393df9dabe734436f2a92a85a8d1aef3dbb59829bf6784929824fa
msgctxt "scenario9:scenario9_3E9DBD4F_9BD0_4586_B216_C3C3AD288452"
msgid "⟪k:0⟫What do you think the first thing a new soul wishes for when it is born, Michel?"
msgstr "⟪k:0⟫미셸……, ⟪k:1⟫갓 태어난 존재가 ⟪k:2⟫무얼 바라겠나요?"

#: scenario9:scenario9_CB0407A9_E339_4D48_B7DA_0AE8D959EE69
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 26b1a66ab762124f98a3cf451faa9cebdc9d25acefe227cbbad7f1879eca1393
#. default-sha256: 31b54adc12e8b28c98d65600e59c1d439b16301d3d9228e49b6b12fab27675af
msgctxt "scenario9:scenario9_CB0407A9_E339_4D48_B7DA_0AE8D959EE69"
msgid "⟪k:0⟫............"
msgstr "⟪k:0⟫…………."

#: scenario9:scenario9_CDE192CC_D8E1_483D_ADDA_BF5B772FFBF8
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 8717484ae1351c5a479069b2d2467c393030ae1b52b3fe12fc78e18d2bd305f4
#. default-sha256: 16a4eb638d83994611fd4cc0ceddd3ff941d18faa4189a9e33d7ec85ac361c03
msgctxt "scenario9:scenario9_CDE192CC_D8E1_483D_ADDA_BF5B772FFBF8"
msgid "⟪k:0⟫that there’s anything wrong with wanting to live."
msgstr "⟪k:0⟫하려는…… ⟪k:1⟫거야……?"

#: scenario9:scenario9_427B61FA_F1B1_48B4_A6BF_CD32FDF16F18
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 4e646e930830e43e2b45f6b5024e63388f14f08e233480637cd68a8ef374da24
#. default-sha256: ac399be69ab62672597586e30966b459bcd8d38e61511b5a098668869a6e7595
msgctxt "scenario9:scenario9_427B61FA_F1B1_48B4_A6BF_CD32FDF16F18"
msgid "⟪k:0⟫I was supposed to remain within Morgana, as a part of her."
msgstr "⟪k:0⟫원래 ⟪k:1⟫저는 하나의 혼이 될 존재가 아니었어요."

#: scenario9:scenario9_107F121F_562F_4D89_9F82_76A29429BD7B
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: c6d2e1771c289f70f810d355026a76b9206cf259be4829bba5bdb7564e1e5ec8
#. default-sha256: 7ffccdf85962690d546d5e71c41f0947d613967a116feb6d4650fc45be35ad31
msgctxt "scenario9:scenario9_107F121F_562F_4D89_9F82_76A29429BD7B"
msgid "⟪k:0⟫To become one... ⟪k:1⟫was to turn against the laws of the universe."
msgstr ""
"⟪k:0⟫그런 제가 ⟪k:1⟫인간으로서 존재를 획득한 건――⟪k:2⟫⟪k:3⟫세계의 섭리에서 ⟪k:4⟫벗어난 행위였어요."

#: scenario9:scenario9_B3DA77E1_8EE0_4E8D_964B_3B154B0396F5
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 7ce7bdd8768a48ca0f984f54dc92ad12f543fcb5f9f46a89963431d836501c2d
#. default-sha256: 74e70a7726b630d63c963000edb80260ebf34bcf71111fff8aec0c02a8feaf51
msgctxt "scenario9:scenario9_B3DA77E1_8EE0_4E8D_964B_3B154B0396F5"
msgid "⟪k:0⟫Because that was where she lingered—⟪k:1⟫⟪k:2⟫the girl from which I was formed."
msgstr "⟪k:0⟫이는 ⟪k:1⟫제 존재의 근본이 된 모르가나가 ⟪k:2⟫거기 남았기 때문이에요."

#: scenario9:scenario9_13865182_DB1B_4F73_B3AA_181FDF2483F0
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: fe427e958842ea4525256610c583e915392d2523d56c581e26ad4dce30e680ae
#. default-sha256: 8650e9a83a40064ffcbe99730f99075dcc890d5221d9cc5618aac28d94c5649c
msgctxt "scenario9:scenario9_13865182_DB1B_4F73_B3AA_181FDF2483F0"
msgid "⟪k:0⟫Falling in love was an act of villainy."
msgstr "⟪k:0⟫제가 누군가와 정을 나누는 것 자체가…… ⟪k:1⟫악이었어요."

#: scenario9:scenario9_D33E3A1B_B033_473B_9FC2_8153900A76B5
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 26b1a66ab762124f98a3cf451faa9cebdc9d25acefe227cbbad7f1879eca1393
#. default-sha256: 31b54adc12e8b28c98d65600e59c1d439b16301d3d9228e49b6b12fab27675af
msgctxt "scenario9:scenario9_D33E3A1B_B033_473B_9FC2_8153900A76B5"
