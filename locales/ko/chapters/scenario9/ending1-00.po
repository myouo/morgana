msgid "⟪k:0⟫............"
msgstr "⟪k:0⟫…………."

#: scenario9:scenario9_BFFABA15_63BD_40FC_B8ED_40BF543856FA
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: b97ec0d70cee844196b211ba447562c14b108698a69f404d9a463683a399575d
#. default-sha256: 79feb3d8cc0a59ede3f245eb2e7a4a2c17905e35e1d74217ee02ab61c8934a60
msgctxt "scenario9:scenario9_BFFABA15_63BD_40FC_B8ED_40BF543856FA"
msgid "⟪k:0⟫Do you know who I am?"
msgstr "⟪k:0⟫제가 누군지…… ⟪k:1⟫아시겠나요……?"

#: scenario9:scenario9_1E9F04AC_24CD_462E_9AC3_D4184EABDCD7
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 84b3c2ce7b3bb7a7a94817ab067c5160a2c6ae41ae07101efb75f02b69164eb2
#. default-sha256: ebd41df8d1c75c445077d9804c8a01428db75663af25927f4a6b06f0b79f72e8
msgctxt "scenario9:scenario9_1E9F04AC_24CD_462E_9AC3_D4184EABDCD7"
msgid "⟪k:0⟫And why... ⟪k:1⟫can I not speak?"
msgstr "⟪k:0⟫왜…… ⟪k:1⟫말을 하려 해도…… ⟪k:2⟫아무 말도 안 나와……?"

#: scenario9:scenario9_FDA1CBD3_AAFE_4D07_AB73_5CB3BF3EE90A
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: a6abb4df229de8595a86bb1ea90d792e8248db1d88ab8a2c59ad3203c1003eae
#. default-sha256: 5f568fc08dfb03bf81f9a3613278c869c2d4f97b8b4855f6591e4dcacb19f319
msgctxt "scenario9:scenario9_FDA1CBD3_AAFE_4D07_AB73_5CB3BF3EE90A"
msgid "⟪k:0⟫I was able to return to this gathering place of souls thanks to your efforts."
msgstr ""
"⟪k:0⟫당신이…… ⟪k:1⟫모르가나가 죽었을 때의 진상을 밝혀내셔서…… ⟪k:2⟫저도 혼이 모이는 이곳으로 돌아"
"오는 게 가능해졌어요."

#: scenario9:scenario9_D024F237_3183_4E5B_BE81_82AD558E0E75
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 26466fa25842cdd3b0c80595191fb230d39283ca8ff422207b8cac7d668291e3
#. default-sha256: 88d866450bf1fdd2b0d22cec128356df84133fb39f233bf20fe17d37beb941a9
msgctxt "scenario9:scenario9_D024F237_3183_4E5B_BE81_82AD558E0E75"
msgid "⟪k:0⟫But my heart told me I had to do this now."
msgstr "⟪k:0⟫하지만…… ⟪k:1⟫반드시 이 순간이어야겠다 ⟪k:2⟫판단했어요."

#: scenario9:scenario9_74D6CBEA_B305_4027_B19E_4D301A77EACC
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 9496cbadc8e0e0a6c7409ba904394c292d6546f3809a0f101128ac87bb1562f8
#. default-sha256: c06d5284497f6058d525fa697d0330729a7791a58a5c510d022e89086bf071e7
msgctxt "scenario9:scenario9_74D6CBEA_B305_4027_B19E_4D301A77EACC"
msgid "⟪k:0⟫I have brought you here to ask for your assistance."
msgstr "⟪k:0⟫당신에게 ⟪k:1⟫드릴 부탁이 있어서 ⟪k:2⟫이 자리로 불렀어요."

#: scenario9:scenario9_6BA1FB6E_E41D_48FA_90FD_50C8BA4E5933
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 211cbf81a40b6cddbd6048fb69822e80865ce01907ae695764d589fcc34e43ad
#. default-sha256: 15cf9fe4cdbd3b0a6091fc3fb427e7f3962fcfab7fae22e8a90aed4c32fceaef
msgctxt "scenario9:scenario9_6BA1FB6E_E41D_48FA_90FD_50C8BA4E5933"
msgid "⟪k:0⟫take this blade, and with it, extinguish my soul."
msgstr "⟪k:0⟫이 검으로 ⟪k:1⟫제 혼을 소멸시켜 달란 거예요."

#: scenario9:scenario9_46C9FD96_4824_4A8E_B09A_005FD2D06FB3
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: f1f02e0a002ee837d637847549ef39c2e05bb78b7a18997b7fb77b4daee84bfe
#. default-sha256: 4d93fc8d421170d504af7d320825c052cc90dbe792832ad2de04f89532e74769
msgctxt "scenario9:scenario9_46C9FD96_4824_4A8E_B09A_005FD2D06FB3"
msgid "⟪k:0⟫Because I wanted to save every last person caught in this tragic quagmire."
msgstr "⟪k:0⟫이 불행의 굴레에서…… ⟪k:1⟫탈출시키고자…… ⟪k:2⟫행동한 거야……."

#: scenario9:scenario9_EB0AB613_6210_4CB4_B8ED_D5CAAEC5535D
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: a53974e176776656018f9d75537078f4f2ef0c59cdebec7700ddab64e989c25d
#. default-sha256: 86a60dcb91eb6163dcabc0ed1dcf67604881d9bf565c0282470d9fc4489ddcd8
msgctxt "scenario9:scenario9_EB0AB613_6210_4CB4_B8ED_D5CAAEC5535D"
msgid ""
"⟪k:0⟫You can’t tell me that after everything you’ve seen...⟪k:1⟫⟪k:2⟫you haven’t realized that I "
"have no place in their lives."
msgstr "⟪k:0⟫과거의 남자들을 보고…… ⟪k:1⟫저란 존재의 이질적인 점을…… 알아채지 않으셨나요."

#: scenario9:scenario9_B62E9CEB_A857_4BDC_8BC4_DE2D0B129191
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 26b1a66ab762124f98a3cf451faa9cebdc9d25acefe227cbbad7f1879eca1393
#. default-sha256: 31b54adc12e8b28c98d65600e59c1d439b16301d3d9228e49b6b12fab27675af
msgctxt "scenario9:scenario9_B62E9CEB_A857_4BDC_8BC4_DE2D0B129191"
msgid "⟪k:0⟫............"
msgstr "⟪k:0⟫…………."

#: scenario9:scenario9_EEB2D58B_2A68_4E9C_8379_91E1270DF884
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: b8d7895631fc8c828bc91335e117f2ceebfb782857447848ee19e436ab800054
#. default-sha256: ba83f972b0bc4bafe282b7d343f514338cd2e623083a30a9b5d818e0d4aba6f1
msgctxt "scenario9:scenario9_EEB2D58B_2A68_4E9C_8379_91E1270DF884"
msgid "⟪k:0⟫Why are you acting... ⟪k:1⟫like it’s all your fault?"
msgstr "⟪k:0⟫왜…… ⟪k:1⟫그런 식으로 말해……."

#: scenario9:scenario9_DF5DEAFE_AB08_4F9A_BCBA_1DA2539EC800
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 04a21150a9e070740c481c7b4bf0bec022a133229465b3cacde83e016f4ff603
#. default-sha256: d63eab6cd093c19c1986a686fc18f571577faff48c559ac7fb0d93e387bb30ee
msgctxt "scenario9:scenario9_DF5DEAFE_AB08_4F9A_BCBA_1DA2539EC800"
msgid "⟪k:0⟫Are you trying to say everyone would be better off without you?"
msgstr "⟪k:0⟫네가 없는 게 나았다고…… ⟪k:1⟫주장하려는 거야……?"

#: scenario9:scenario9_924BB831_2A65_4066_B6DF_6B5AF8268651
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 81e74422e9c52fc6a31cd3032e8cb441d0dcd716902e320c8c20564ab9c57f76
#. default-sha256: a9bd9f2d1fe52a08722e046ea102557b82568a295cdf5278a4b17c35f7de7961
msgctxt "scenario9:scenario9_924BB831_2A65_4066_B6DF_6B5AF8268651"
msgid "⟪k:0⟫Like hell you were."
msgstr "⟪k:0⟫그게…… ⟪k:1⟫무슨 말도 안 되는 소리야……."

#: scenario9:scenario9_B139A233_E70D_4F3B_8565_A51B4A55377C
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 4825ee6a0f07dbed6a779a853572e3a6e1d391065a93065afe74b3691f35aea8
#. default-sha256: e96eedb6e869ed97f4653c5520af04f8f143a3518b5fe666da3daac018c8d33c
msgctxt "scenario9:scenario9_B139A233_E70D_4F3B_8565_A51B4A55377C"
msgid "⟪k:0⟫I was born to be a receptacle for her pain, to ease her suffering."
msgstr ""
"⟪k:0⟫저는 모르가나의 고통을 받아 주며, ⟪k:1⟫그 고통을 덜기 위한 존재였어요. ⟪k:2⟫저는 그걸 위해서"
"만 탄생했죠."

#: scenario9:scenario9_8EC6D6CB_F486_41D7_BCDE_441BCF502863
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: ec8613c01e4fe7e935a3218718b1755ae4084ef390863c3486e75824290f59ad
#. default-sha256: 90b1740800a78fdfa2c9075a54c9f6cf24c40a73e58d13b6f5b343c279c40612
msgctxt "scenario9:scenario9_8EC6D6CB_F486_41D7_BCDE_441BCF502863"
msgid ""
"⟪k:0⟫That was not how she felt deep down, though.⟪k:1⟫⟪k:2⟫She was not a saint out of the "
"goodness of her heart."
msgstr "⟪k:0⟫이는―― ⟪k:1⟫모르가나의 선의에서 비롯된 게 아니며, ⟪k:2⟫본인의 의지도 ⟪k:3⟫아니었어요."

#: scenario9:scenario9_27B4F3AD_B200_46E0_9E39_760FA23116D6
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 1c18f09a6585db918e50d34c7bfd31a8537a4f795b5bdf6bf8aac7fa669c5dd8
#. default-sha256: e62c15a7c95c899b69b7400a5c7aff12b165d7c66e3b85be6b2731745d61d6b8
msgctxt "scenario9:scenario9_27B4F3AD_B200_46E0_9E39_760FA23116D6"
msgid ""
"⟪k:0⟫So she took all her “saintly” characteristics and gave them to me—⟪k:1⟫⟪k:2⟫caring for "
"others, putting herself second, being forgiving—"
msgstr ""
"⟪k:0⟫그래서…… ⟪k:1⟫남을 아끼는 면, ⟪k:2⟫희생적인 면,⟪k:3⟫⟪k:4⟫용서하는 면…… 성녀의 모든 개념을……"

#: scenario9:scenario9_300588D5_5543_4925_9C59_B86D0CDF8E42
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 26b1a66ab762124f98a3cf451faa9cebdc9d25acefe227cbbad7f1879eca1393
#. default-sha256: 31b54adc12e8b28c98d65600e59c1d439b16301d3d9228e49b6b12fab27675af
msgctxt "scenario9:scenario9_300588D5_5543_4925_9C59_B86D0CDF8E42"
msgid "⟪k:0⟫............"
msgstr "⟪k:0⟫…………."

#: scenario9:scenario9_AA49492A_FB24_4BEB_8A11_1B6DE71754A6
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: ddcfca81ece53d479e2120d2c9a102a43f23d7891b79b57fa71feaaf0c439120
#. default-sha256: da90f7329dac83517587a751b801ed1f0502e9c5e88e7587a839027edc5f456f
msgctxt "scenario9:scenario9_AA49492A_FB24_4BEB_8A11_1B6DE71754A6"
msgid "⟪k:0⟫In a world where I was never meant to exist."
msgstr "⟪k:0⟫이건…… ⟪k:1⟫결코 그래선 안 되는 거였어요."

#: scenario9:scenario9_82D5CD06_EFF9_4E8C_BF26_7855E821AEAB
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 8a5837a265e407e1eacd1bacd69ea56604b9bfd244dfecaca2f71dc24d2bbbd7
#. default-sha256: 0f1136cf9151acd1c786efa50112e1d6cf877908bbb9b7ccd550f712ab7d2751
msgctxt "scenario9:scenario9_82D5CD06_EFF9_4E8C_BF26_7855E821AEAB"
msgid "⟪k:0⟫and Morgana wished to curse the three men’s souls."
msgstr "⟪k:0⟫모르가나가 바란 건 ⟪k:1⟫세 남자의 혼을 저주하는 것."

#: scenario9:scenario9_D3FF89B2_C0DD_42E7_9E15_DDDEC5A0FD03
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 60be9e4fd294c9c0da9880e01fe6ad4332fa89c88aa1357509921e106a3fa33c
#. default-sha256: 24a55430db157142d58a809b9342a367da9548fa1f8f3d7359388b8c122867e9
msgctxt "scenario9:scenario9_D3FF89B2_C0DD_42E7_9E15_DDDEC5A0FD03"
msgid ""
"⟪k:0⟫In order for an incomplete soul like mine to survive, it needs something to bind itself to "
"the world—⟪k:1⟫⟪k:2⟫something strong enough to prevent the universe from “correcting” the anomaly."
msgstr ""
"⟪k:0⟫저는 ⟪k:1⟫혼 단위에서부터 불완전한 존재였어요. ⟪k:2⟫그런 이물질이 존재하기 위해선 ⟪k:3⟫이 세"
"계와 저를 잇는 강한 것이 있어야 했죠."

#: scenario9:scenario9_26C22C6F_3835_4C3F_BA35_F932EDDE9DE7
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: de9beb3793764496e557dab111e6eda891d97300c470aa6a4e71442dcc1e4303
#. default-sha256: 3a9dea8f852ad590b8cfa7c12ec564df0e8f924698c851fcb9e21c21ba4ae0e2
msgctxt "scenario9:scenario9_26C22C6F_3835_4C3F_BA35_F932EDDE9DE7"
msgid "⟪k:0⟫And so the wish of that anomaly... ⟪k:1⟫gave birth to yet another anomaly—"
msgstr ""
"⟪k:0⟫이 세계의 섭리에서 벗어난 제 소망은 ⟪k:1⟫똑같이 ⟪k:2⟫이 세계의 섭리에서 벗어난 걸 만들었어요."

#: scenario9:scenario9_D21274E5_3971_4179_BCFE_1CCDE07DEAD6
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: efae100b91f9c09bacf0a3078c06266c0d6754b2fdd893d115784a90d55b73f1
#. default-sha256: 976039ae706281e44c1c2bde3bdb639e4a9f4978f72f5ee895152cd4c809340a
msgctxt "scenario9:scenario9_D21274E5_3971_4179_BCFE_1CCDE07DEAD6"
msgid ""
"⟪k:0⟫a house that sat outside the currents of time.⟪k:1⟫⟪k:2⟫One that could descend into the "
"mortal realm at various times and places."
msgstr "⟪k:0⟫시간과 장소를 초월하여 ⟪k:1⟫현세에 나타나는 곳, ⟪k:2⟫시간의 흐름을 무시하는 저택……."

#: scenario9:scenario9_7B0EB139_01EE_4014_9911_2C1CB1F186DD
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 40735a5456be9a76bf324f57893db7b7be20333cc372af89b21046dd454e1878
#. default-sha256: 6a278cc1f599bc9afd58d0f274534a24c99efb94eb506950d3287a0ed43b5cdb
msgctxt "scenario9:scenario9_7B0EB139_01EE_4014_9911_2C1CB1F186DD"
msgid "⟪k:0⟫And why did it have to be that house that bound me to the world?"
msgstr "⟪k:0⟫저와 이 세계를 잇는 것이 ⟪k:1⟫왜 저택이어야 했는가……."

#: scenario9:scenario9_A9956F34_AC58_4FD8_AAB2_17ADFA21C0EF
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 26b1a66ab762124f98a3cf451faa9cebdc9d25acefe227cbbad7f1879eca1393
#. default-sha256: 31b54adc12e8b28c98d65600e59c1d439b16301d3d9228e49b6b12fab27675af
msgctxt "scenario9:scenario9_A9956F34_AC58_4FD8_AAB2_17ADFA21C0EF"
msgid "⟪k:0⟫............"
msgstr "⟪k:0⟫…………."

#: scenario9:scenario9_3D76D3F0_B785_4847_BC7D_4F8DC241C59C
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 9b3316295a4620cf77c2b5c09c48c0fb42998671a8a349bb8f575da506fa72d5
#. default-sha256: 260b2f0fcdae9f4b0d2a4a373a18f3de32f3e9d4ae1057da5fe49dfbe9417ba9
msgctxt "scenario9:scenario9_3D76D3F0_B785_4847_BC7D_4F8DC241C59C"
msgid "⟪k:0⟫My very presence malevolent."
msgstr "⟪k:0⟫제 존재 자체가…… ⟪k:1⟫죄악이었어요."

#: scenario9:scenario9_77583269_3E0D_416C_A4DD_9CEC53949443
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 5548cd36e7201f384624b23eaa757220caafa384352f81aebf63df9bbf21b4d3
#. default-sha256: f390b1624de634f915bf6b639418391e2f6092b2048cd245d6b36142a8bc57ea
msgctxt "scenario9:scenario9_77583269_3E0D_416C_A4DD_9CEC53949443"
msgid "⟪k:0⟫Please, stop..."
msgstr "⟪k:0⟫……그런 말은 그만해 줘……."

#: scenario9:scenario9_4FA002B7_F14F_45BB_A19E_6A99E0CF9FDA
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: f0ecb25dce2a0037ba5c20ebfaeab2f73e07600155dfde86acb6bd2848897c85
#. default-sha256: d7f56a715141caf8bd926bcbc304fb852150c08276d8ced8c9914235af179be8
msgctxt "scenario9:scenario9_4FA002B7_F14F_45BB_A19E_6A99E0CF9FDA"
msgid "⟪k:0⟫The universe must be returned to its proper state, Michel."
msgstr "⟪k:0⟫그러니 ⟪k:1⟫미셸……. ⟪k:2⟫세계의 섭리를 ⟪k:3⟫되돌려 놔야만 해요."

