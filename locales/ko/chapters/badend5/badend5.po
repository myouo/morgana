msgid "⟪k:0⟫I wish you a wonderful life,"
msgstr "⟪k:0⟫그건 필시―― 빛이 가득하여 ⟪k:1⟫눈부신 삶일 거예요."

#: badend5:badend5_D76E6452_7102_4582_A162_5866DDAB8A55
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: a1f1c1d68e6e8973ecce6ebf75411e1133f4142c43d801cd5b888dba6369beb9
#. default-sha256: 2c8da785860dd159aeedc259d0a0b64882aea4c9bd46ede223caa1739540454d
