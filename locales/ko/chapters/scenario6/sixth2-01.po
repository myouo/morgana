msgctxt "scenario6:scenario6_9E28183E_CC71_4774_A8FC_CABE9DC09E50"
msgid "⟪k:0⟫How much bitterness did you have to carry inside you to become like her?"
msgstr "⟪k:0⟫도대체 ⟪k:1⟫얼마나 증오를 품어야 ⟪k:2⟫마녀처럼 되는 걸까요……."

#: scenario6:scenario6_D60E783C_FA52_4904_8EEB_BE7A8507CCA5
