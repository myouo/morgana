msgid "⟪k:0⟫⟪k:1⟫⟪k:2⟫Are... ⟪k:3⟫Are you all right?"
msgstr "⟪k:0⟫⟪k:1⟫⟪k:2⟫저기……, ⟪k:3⟫괜찮아……?"

#: scenario8:scenario8_3BFC874A_ECCF_41B6_95AA_A276FE5B0391
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 8137ad9107ca01a54e0311368e7f6432111219793ed342d98703e3254b0a1d5e
