msgid "⟪k:0⟫Our savior!"
msgstr "⟪k:0⟫구세주야……!"

#: scenario8:scenario8_95CE83C1_6CCE_40E7_B06C_7AD50F750CD6
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
