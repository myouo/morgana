msgctxt "scenario8:scenario8_B4D713BB_E59C_4DCF_BA27_FDFA501C1E05"
msgid "⟪k:0⟫At my question, the girl finally spoke."
msgstr "⟪k:0⟫내가 묻자…… ⟪k:1⟫소녀가 그제야 입을 열었다."

#: scenario8:scenario8_3D04F2C2_DD6C_40E1_B514_6F687A1C508C
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 76e6a340790c8c234f4d0d4cb042f9b6a57982b52fd6e294f5ab0cb18c4c680c
