msgctxt "scenario8:scenario8_95CE83C1_6CCE_40E7_B06C_7AD50F750CD6"
msgid "⟪k:0⟫I’m not a savior... ⟪k:1⟫I’m not a man... ⟪k:2⟫I’m a beast.⟪k:3⟫⟪k:4⟫Isn’t that right?"
msgstr "⟪k:0⟫구세주도 아니며…… ⟪k:1⟫사람도 아닌…… 짐승이지?⟪k:2⟫⟪k:3⟫이봐……, ⟪k:4⟫그게 맞지……?"

#: scenario8:scenario8_F0E0F265_AC24_4FE2_A20B_D9CC3C3F2939
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 933ac5b7e0faef5004dd917e894e8f034cc93012c291647cdcb207ac77bf7090
#. default-sha256: 559a999f925dc261a7b2689a24b81a0595b8424c0025809506b813aa3363c8b6
msgctxt "scenario8:scenario8_F0E0F265_AC24_4FE2_A20B_D9CC3C3F2939"
msgid "⟪k:0⟫Wh-⟪k:1⟫What are you—"
msgstr "⟪k:0⟫무……, ⟪k:1⟫무슨 ⟪k:2⟫소리야………?"

#: scenario8:scenario8_FAD5924A_7933_43A1_897A_E295CF291CDD
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: f2415c000fb905b40fd36ecd01e87bcc0292070ba4868fffeda74f81c3fd505f
