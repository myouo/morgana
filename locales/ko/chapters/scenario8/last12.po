#: scenario8:scenario8_AED42863_A424_4B04_8542_1D46FD5715DA
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 00423b904ee80aa6feda294f05b983a61b7e10d4f0918e7c38067a5cb3566f4c
#. default-sha256: 2c47489a09f897aa240c74c825b61c6057e13e0655ff6df3606d4cda3219d863
msgctxt "scenario8:scenario8_AED42863_A424_4B04_8542_1D46FD5715DA"
msgid "⟪k:0⟫⟪k:1⟫He opens the door, heading the four-man procession out of the tower, as he had in."
msgstr "⟪k:0⟫⟪k:1⟫감시탑 문은…… 야코포가 ⟪k:2⟫열었다.⟪k:3⟫⟪k:4⟫왔을 때처럼 ⟪k:5⟫야코포가 앞장섰고――"

#: scenario8:scenario8_C1DB5E46_FA01_4DD6_8F5E_004447434A7E
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 42158b91fa654d293169be73c112096e5ab4edb2f77ad19b54e105a54fb46e42
#. default-sha256: e28afd6ddef1be48e768f5ab8fd468c6d7934aa588dec485a6fd6744b630f17e
msgctxt "scenario8:scenario8_C1DB5E46_FA01_4DD6_8F5E_004447434A7E"
msgid "⟪k:0⟫I walk at the back of the line."
msgstr "⟪k:0⟫나는 ⟪k:1⟫맨 뒤에서 걸었다."

#: scenario8:scenario8_B95A895B_0AE5_4A8E_B7B5_384C42CA534F
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 923bbbc7c6b27780b171c6070dd760c7901829d9ac15dfbd8723696606db1156
#. default-sha256: 9c07ce2e31c861e1ea0be007cd6387febba8aa4142076ee171d1bffe3454fcce
msgctxt "scenario8:scenario8_B95A895B_0AE5_4A8E_B7B5_384C42CA534F"
msgid ""
"⟪k:0⟫Each step they take down the spiral staircase is slow and ponderous,⟪k:1⟫⟪k:2⟫as if weighted "
"down by the knowledge of their sins."
msgstr ""
"⟪k:0⟫나선 계단을 내려가는 우리의 발소리는 ⟪k:1⟫몹시 무거워서――⟪k:2⟫⟪k:3⟫죄의 중책이 ⟪k:4⟫감돌았다."

#: scenario8:scenario8_BEE19C25_4387_4098_BC3E_91D6906BBC5A
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 068c720451bba8468f660558dea812eeacc3f8cce7a24d1b7fab0dd621f5dff7
#. default-sha256: 5b1dd23b6a15945656b993980631ef97d9b5c47d7a262feefbdfb03468f555da
msgctxt "scenario8:scenario8_BEE19C25_4387_4098_BC3E_91D6906BBC5A"
msgid "⟪k:0⟫That they must make their way..."
msgstr "⟪k:0⟫……속죄의 자리로――"

#: scenario8:scenario8_C4712DCB_C162_4710_879A_2EEF4DA9452E
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: c4a645debea282ff84dd66e536612f1a72ff0a663f56336872fac0fd733c3b96
#. default-sha256: 0cd9196466cbb55b5df1f6ba4fd480935780898475b197917d39092ecea55092
msgctxt "scenario8:scenario8_C4712DCB_C162_4710_879A_2EEF4DA9452E"
msgid "⟪k:0⟫to the place they will make their atonement."
msgstr "⟪k:0⟫가야 한다……."

#: scenario8:scenario8_C16EBD60_51C9_4BC5_8094_E87636C13BEB
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 6563e4e9c2d76185f997eda24c99a467aa36206cd10f3278d18df31f543d7044
#. default-sha256: af955845718e7031d6a3bc8216718f3eaca26ae1386427848c3b8951127169c6
msgctxt "scenario8:scenario8_C16EBD60_51C9_4BC5_8094_E87636C13BEB"
msgid "⟪k:0⟫⟪k:1⟫I wasn’t able to prevent Morgana’s death,"
msgstr "⟪k:0⟫⟪k:1⟫모르가나의 죽음은 ⟪k:2⟫바꿀 수 없었다."

#: scenario8:scenario8_5936BA73_B67E_4639_9327_7606198B04B6
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 77d2a901415119632ad8805fa30bf1b686324d6df6c2c3576c7baea5a336cb06
#. default-sha256: a266670a11a623571c3f7909b747c25d9dcb28f9b843f8de2b5d4ea4a6b620e9
msgctxt "scenario8:scenario8_5936BA73_B67E_4639_9327_7606198B04B6"
msgid "⟪k:0⟫but I ⟪k:1⟫was⟪k:2⟫ able to uncover the truth."
msgstr "⟪k:0⟫하지만…… ⟪k:1⟫나는 진실을 밝혀냈다."

#: scenario8:scenario8_423170AA_9BC6_400F_8FD8_60750E032EA6
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 9597605b7e4d4e179058fdc70d38677ffcdf0229be2b5072ee319f9285e6f642
#. default-sha256: 00dd61f885d4984195aaf788cb3221d2b4026ef83575fcddc76cc46eeceb92bc
msgctxt "scenario8:scenario8_423170AA_9BC6_400F_8FD8_60750E032EA6"
msgid "⟪k:0⟫I ⟪k:1⟫accomplished⟪k:2⟫ something."
msgstr "⟪k:0⟫내가 바꾼 것도 ⟪k:1⟫있긴 할 것이다……."

#: scenario8:scenario8_9C6ECEBE_D077_4098_BD2B_1FA6B64D6C53
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 97d7a07db3919b3a6166cadcc6a79c77769282705a7f3b59f8efe6adbb15ebe3
#. default-sha256: 70c2a57b092667a4860aa703f8eb794610fe099b8927d4194c25fbc679059cbe
msgctxt "scenario8:scenario8_9C6ECEBE_D077_4098_BD2B_1FA6B64D6C53"
msgid "⟪k:0⟫The sum of everything I did these three days..."
msgstr "⟪k:0⟫내 행동이…… ⟪k:1⟫반드시……"

#: scenario8:scenario8_CB3C7978_9C00_4437_A359_E6D28E83A517
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: a30a39de63d5d0e521bde5be376d58da9a6b25780f0535026fd755ee83030bc8
#. default-sha256: b39ffbccb1458f37b960e3be508e6aa271edf22501c029cbeac4853002c8ba35
msgctxt "scenario8:scenario8_CB3C7978_9C00_4437_A359_E6D28E83A517"
msgid "⟪k:0⟫⟪k:1⟫should⟪k:2⟫ be enough to change her heart..."
msgstr "⟪k:0⟫모르가나의 인식을…… ⟪k:1⟫바꾸었을 것이며――"

#: scenario8:scenario8_856665BF_C630_4CA9_AE54_B340A95F78B2
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 225dbfbb6566d35feca88ff265c1eaec121fa9831f8c2ab94e5d21114d8e417b
#. default-sha256: 8ebfda3412d39f92b036a9ddda86e00703e2ddac9ef75d2713b972a10776bb1e
msgctxt "scenario8:scenario8_856665BF_C630_4CA9_AE54_B340A95F78B2"
msgid "⟪k:0⟫and change the course of their next lives."
msgstr "⟪k:0⟫세 남자의 내세를…… 바꾸었을 것이다."

#: scenario8:scenario8_F92CB0CC_84A8_4080_A3E0_B5194806340E
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: abeaeb137e6995b4971d24145cc36f04d92764f9f5eb823b7df71adde04747cb
#. default-sha256: 6a9c2a6fc0ec5184c29264379aa466a151c6aee495a9fc985890c7c00c11c15f
msgctxt "scenario8:scenario8_F92CB0CC_84A8_4080_A3E0_B5194806340E"
msgid "⟪k:0⟫They should be able to avoid the tragedies I witnessed through each of their doors."
msgstr "⟪k:0⟫내가 본 비극은―― ⟪k:1⟫일어나지 않을 것이다……."

#: scenario8:scenario8_F93A566A_BD29_44BD_BE2A_8ED6A23FA60F
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 7ea211c8450fc2a9ab601b6d2201b802828983940d130989dda1c2e988dc05a4
#. default-sha256: c386fe5e7862c5bf63609ba6668addfac2c28fa233136f175b85a804dfd14266
msgctxt "scenario8:scenario8_F93A566A_BD29_44BD_BE2A_8ED6A23FA60F"
msgid ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫⟪k:4⟫When we step through this door and people see Morgana’s body,⟪k:5⟫we’ll "
"be made to pay for our sins."
msgstr ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫⟪k:4⟫……이 문을 열어 ⟪k:5⟫모르가나의 시체가 백일하에 드러나면―― ⟪k:6⟫우리의 죄"
"도 추궁받을 거야."

#: scenario8:scenario8_4E429D64_4256_4431_AEE5_082107636ABC
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 39ee42ec9c484c8c169cfea050d1563117dfd8c3cc593825f2785e5777e0696d
#. default-sha256: e3fd82b01d2740d3418ef1d395715daf0a67eff6dbccd6b30a6a86f6fab0b52a
msgctxt "scenario8:scenario8_4E429D64_4256_4431_AEE5_082107636ABC"
msgid ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫Ultimately, I’m the one responsible,⟪k:3⟫⟪k:4⟫so the two of you are welcome to "
"stay behind..."
msgstr "⟪k:0⟫⟪k:1⟫⟪k:2⟫……주모자는 나야. ⟪k:3⟫너희는 ⟪k:4⟫여기 남아도 돼……."

#: scenario8:scenario8_A6C300C5_C8C4_4A4F_95DA_668A7568FA32
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 9bdc1298b5afdab40b0bbbe41ac9ed99c3fc3376de41c02cdef1d722a440c930
#. default-sha256: bb75778035ce8a4d2476a36e6ecd1411f7411d51b0493d71866acdef466ff486
msgctxt "scenario8:scenario8_A6C300C5_C8C4_4A4F_95DA_668A7568FA32"
msgid ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫I’m coming with you.⟪k:3⟫⟪k:4⟫A girl died because of the things I did...⟪k:5⟫⟪k:6⟫"
"I can’t just pretend it didn’t have anything to do with me..."
msgstr ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫나도…… ⟪k:3⟫갈게……. ⟪k:4⟫소녀 한 명을 죽게 해 놓고……⟪k:5⟫⟪k:6⟫더는 못 본 척 외면할 "
"수 없어……."

#: scenario8:scenario8_3D6F1818_603A_4F36_83E6_C18293AF930E
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: a4b44dfaa33396a09bbd32e54c6a898ddad15ea4fdfa805656cb8add578ecd5c
#. default-sha256: dbbce51506218210ec1c84057535954928d376e2c140a6f182a3354d5e678bce
msgctxt "scenario8:scenario8_3D6F1818_603A_4F36_83E6_C18293AF930E"
msgid "⟪k:0⟫⟪k:1⟫No, I don’t ⟪k:2⟫want⟪k:3⟫ to."
msgstr "⟪k:0⟫⟪k:1⟫아니……, ⟪k:2⟫외면하기가 싫어."

#: scenario8:scenario8_0EC45386_CC26_4273_9642_877D8503B806
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 95414b2ec3dd8b019fd9ab9f61f588f85c6a938cc8bd159504573cb617c1b45b
#. default-sha256: 52d0e74f128950361124f6149fa1460ed4ce485b259c27616f2c027514c2f2ce
msgctxt "scenario8:scenario8_0EC45386_CC26_4273_9642_877D8503B806"
msgid ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫I never had any intention of fleeing.⟪k:3⟫⟪k:4⟫You may have been the one running "
"the operation,⟪k:5⟫but I did just as many terrible things as you."
msgstr ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫처음부터 각오는 되었다. ⟪k:3⟫주모자가 너라도, ⟪k:4⟫내가 한 짓 또한 그에 견줄 만큼 "
"악독했으리라 본다……."

#: scenario8:scenario8_65A49D97_4226_44D1_B2E7_9F913841121F
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: de6e5362da04efa00fd34251bed4c872556016edb1cdb2711bc4ad5a6c4a51c1
#. default-sha256: e92e89fc8abbb93b74f333accd7bf72fb3016c97225ae006876a944f6a3e9411
msgctxt "scenario8:scenario8_65A49D97_4226_44D1_B2E7_9F913841121F"
msgid "⟪k:0⟫⟪k:1⟫⟪k:2⟫............"
msgstr "⟪k:0⟫⟪k:1⟫⟪k:2⟫…………."

#: scenario8:scenario8_D96F361C_877C_4409_8093_134A7AFA2081
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 248ce506b9bcb25c61df80fb1c365be4b02d4a05c863da5aaf75792745749d29
#. default-sha256: 3c789d12ca7e277c7f0b32c66d1f695acebdaf99573eee742d44ce2a7c51bcbc
msgctxt "scenario8:scenario8_D96F361C_877C_4409_8093_134A7AFA2081"
msgid "⟪k:0⟫⟪k:1⟫Well then..."
msgstr "⟪k:0⟫⟪k:1⟫……그래……."

#: scenario8:scenario8_5DCA870D_5F4F_466E_8618_E250C3C08FE7
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 3690b9106d1c5620e9d44dbc8e75c917208503ccdc3cc78b73433719b3d95fdf
#. default-sha256: 80cb989643815f08f78751069f69e22f0d0e12326608834b0e7034748fc06a9a
msgctxt "scenario8:scenario8_5DCA870D_5F4F_466E_8618_E250C3C08FE7"
msgid "⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫⟪k:4⟫⟪k:5⟫............"
msgstr "⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫⟪k:4⟫⟪k:5⟫…………."

#: scenario8:scenario8_02CA0422_0A08_4714_8645_26C09B263BDA
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: fe5e2f164cc833fe68df5ca8ac73c4f14fe980d1be5cc5fcd905a5e2d89a2fa2
#. default-sha256: 7eb80e2618c9e5aad38c0220787b4bfadbee21aaabe54e9b89611eeb0254d034
msgctxt "scenario8:scenario8_02CA0422_0A08_4714_8645_26C09B263BDA"
msgid "⟪k:0⟫⟪k:1⟫...Say, ⟪k:2⟫uh, ⟪k:3⟫Michel?"
msgstr "⟪k:0⟫⟪k:1⟫………저기, ⟪k:2⟫미셸. ⟪k:3⟫잠깐…… 괜찮을까."

#: scenario8:scenario8_15D9F7C9_63B1_4D3F_9C17_4A1054182987
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: da3f551b4631dfc1076acd785ed05ab96cfd465b0feffe0ece444e969fba3636
#. default-sha256: 3636ed712f747b18da5baebfd5abf05f8658f6bea5e0b2398a30bad4932a5d54
msgctxt "scenario8:scenario8_15D9F7C9_63B1_4D3F_9C17_4A1054182987"
msgid "⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫Yes?"
msgstr "⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫………네."

#: scenario8:scenario8_0357EF2B_3EF5_4C3A_BAC0_D828E0C3AB1A
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 49592279ef167ca7f76f2e6b2abe3dfdfcaeacedf3985050eb97f15bf8e876d6
#. default-sha256: bd94b4644026aed5964b3dc543620f3d901be90e1083749f4d96db984e7cfb22
msgctxt "scenario8:scenario8_0357EF2B_3EF5_4C3A_BAC0_D828E0C3AB1A"
msgid ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫I figure this is probably my last chance to say it,⟪k:3⟫⟪k:4⟫so... ⟪k:5⟫thank you "
"for convincing me to hand over my key."
msgstr ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫지금이 ⟪k:3⟫말을 할 마지막 기회 같거든.⟪k:4⟫⟪k:5⟫……나한테서 열쇠를 가져가 줘서 "
"⟪k:6⟫고마워……."

#: scenario8:scenario8_FF87DF36_1317_4F06_B292_9C10C06315C2
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 47d9e49b337b62c3a00c22393173234e5ca5399e35e41cb8ac1242c80997a07f
#. default-sha256: 6d1b5b0a534bc258cc1a5459e42d67ad10d7a180fb2a4483d628c460d4394cc9
msgctxt "scenario8:scenario8_FF87DF36_1317_4F06_B292_9C10C06315C2"
msgid "⟪k:0⟫⟪k:1⟫For giving me the courage to open my eyes."
msgstr "⟪k:0⟫⟪k:1⟫나한테 ⟪k:2⟫마주할 용기를 줘서 고마워……."

#: scenario8:scenario8_00F54393_691B_4C8B_9333_2734C66DD262
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 691ea21c0eeb4d1c77593f370526eadb3a4bea7b3238ceb53a67b00f738c9448
#. default-sha256: fe9404fd8ea8d90debda5a007c66f98155052657876213634db5f026504c756d
msgctxt "scenario8:scenario8_00F54393_691B_4C8B_9333_2734C66DD262"
msgid ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫You always had the courage within you, Mell.⟪k:4⟫⟪k:5⟫You simply needed a "
"little help finding it."
msgstr ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫그건…… ⟪k:4⟫원래부터 ⟪k:5⟫당신 안에 있던 겁니다.⟪k:6⟫⟪k:7⟫그 한 걸음을 내딛지 "
"못 하여…… ⟪k:8⟫외면했을 뿐이죠――"

#: scenario8:scenario8_8083C7A0_A13C_418B_BA18_0C5A13DB5AA0
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 45ec0ffdefc545b08e0d531e80b5477b6a40065840b98fa8ce727e32366f2b84
#. default-sha256: 3b1e79d86d2e6afc8e2d17cfafd058d9bef2628362fe0aa3974845d8ae91706f
msgctxt "scenario8:scenario8_8083C7A0_A13C_418B_BA18_0C5A13DB5AA0"
msgid "⟪k:0⟫It wasn’t my strength that allowed you to take action,⟪k:1⟫but your own."
msgstr "⟪k:0⟫지금…… ⟪k:1⟫결단한 건 ⟪k:2⟫당신의 힘입니다."

