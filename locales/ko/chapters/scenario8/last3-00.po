msgctxt "scenario8:scenario8_51D028D6_FAB7_4011_B45D_AA78823E0D66"
msgid "⟪k:0⟫but I’m willing to bet I looked like hell."
msgstr "⟪k:0⟫몰골이 ⟪k:1⟫말이 아니었을걸."

#: scenario8:scenario8_1FC153A0_693A_4ADF_A944_6DC8C27F7142
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 72b68c4bc927e87dc8240d2ae45710fcd55dbc7f70d806a4c4d5216dcc8e82b2
