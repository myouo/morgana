msgid "⟪k:0⟫⟪k:1⟫You.⟪k:2⟫"
msgstr "⟪k:0⟫……이봐……."

#: scenario8:scenario8_B05D0D1C_5531_4869_B128_1EE982010B41
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 5b76e6a9f29a744074c128e282933e0d82ee7917cf3e397d44eb91502648a7c7
