msgctxt "scenario8:scenario8_88A62996_2911_496C_B786_3B60A5428774"
msgid "⟪k:0⟫Dozens of people passed by, silently pretending not to see anything."
msgstr "⟪k:0⟫아무 말도 않고 ⟪k:1⟫그대로 지나갔지."

#: scenario8:scenario8_9E9505E8_ADC2_4926_B9AB_77C27BD268AF
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: b5f4f4aaa121d074a26a75bd9742e6c8eabfde2ebd38fb69dfd6f206738569af
