msgctxt "scenario8:scenario8_45258DE4_1484_4CB0_9C16_AB00FD264442"
msgid "⟪k:0⟫Was I really a beast?"
msgstr "⟪k:0⟫내가 과연 사람이냐 짐승이냐는 의문이었다."

#: scenario8:scenario8_8D4B1283_A266_48EB_81E1_BBEC1E1C1B3D
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: ca93d10aca6357005cedb98420f2d1e11e7db34e7aa2f9c8dc11a721e4801240
