msgctxt "scenario8:scenario8_524E1026_2EE0_462F_9DE3_85EB7A4EC19F"
msgid "⟪k:0⟫Why didn’t you run?"
msgstr "⟪k:0⟫……왜 안 도망치지……."

#: scenario8:scenario8_5B9209F1_5239_4729_B387_866C915A2997
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 8e3c4fe4b44fdf78ddec2b5019115ba8739bc0f6c4806e7e6666521479149e28
#. default-sha256: 5898822193824e547af914a5e684d832aefd2e9fe044a319c95efb106ecaccc5
msgctxt "scenario8:scenario8_5B9209F1_5239_4729_B387_866C915A2997"
msgid "⟪k:0⟫In retrospect, I realize now that her voice was my first tether,"
msgstr "⟪k:0⟫지금은 ⟪k:1⟫그 소녀의 목소리가 내 첫 사슬이었단 걸――⟪k:2⟫⟪k:3⟫단언할 수 있지만……"

#: scenario8:scenario8_45258DE4_1484_4CB0_9C16_AB00FD264442
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: e72bf5358e698a5712943808491fe4f75c3ac0b31cab684f87154b6a6480014d
