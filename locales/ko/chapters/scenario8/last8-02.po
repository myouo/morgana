msgid "⟪k:0⟫⟪k:1⟫⟪k:2⟫............"
msgstr "⟪k:0⟫⟪k:1⟫⟪k:2⟫…………."

#: scenario8:scenario8_393F4499_5007_4714_BBDE_9B0F633FBDB5
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: d034e9a2eddae521fba544210c3c9af602f0b9511c14728a2bbe36412fa4fe73
