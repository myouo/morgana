msgctxt "scenario8:scenario8_79E140B8_0FC7_4041_9AF8_2651829A1694"
msgid "⟪k:0⟫that, and quenching my thirst."
msgstr "⟪k:0⟫내 갈증을 축이기 위함. ⟪k:1⟫……그래서 그렇게 생활했다."

#: scenario8:scenario8_5037EDDB_CAFB_4F0B_B178_215016F9CE6B
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 612066f723e93d1d45d43de4db1bd26af2127b31ce177e5959e798310897757c
