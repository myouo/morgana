msgctxt "scenario8:scenario8_668C0414_917B_4B95_8543_254F4F1764EE"
msgid "⟪k:0⟫All of that was buried beneath the waves of bliss that ravished me."
msgstr "⟪k:0⟫그 유열 앞에선 ⟪k:1⟫모든 게 무의미했다."

#: scenario8:scenario8_524E1026_2EE0_462F_9DE3_85EB7A4EC19F
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 82a1b044aeb6f209cb846543b665ae8d0a52174147704841ca7782028b3e81e6
