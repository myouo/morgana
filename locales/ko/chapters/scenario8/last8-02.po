msgctxt "scenario8:scenario8_CBD04A9A_7B75_4FE0_980B_B2D7D060FB41"
msgid "⟪k:0⟫⟪k:1⟫We’re free to go home!"
msgstr "⟪k:0⟫이제…… ⟪k:1⟫우린 집으로 갈 수 있어……!"

#: scenario8:scenario8_2CFDEB6F_DF07_4455_AA31_0E15BD3C46A7
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: c5aee7a1f777a3cd37dc9e6daa2890d95d33f8a4789913c8e8ba24b41fdd102a
#. default-sha256: f3ea05615cf1fd915dccdb8cf96d0207060a1e758c5a8adafac48055a8652341
msgctxt "scenario8:scenario8_2CFDEB6F_DF07_4455_AA31_0E15BD3C46A7"
msgid "⟪k:0⟫I thirst for ⟪k:1⟫more⟪k:2⟫!"
msgstr "⟪k:0⟫내 갈증이…… ⟪k:1⟫전혀…… ⟪k:2⟫축여지질 않았어……!"

#: scenario8:scenario8_83881989_C7C0_471C_ACBE_BAD3493E5052
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 23c7510e3b7f53e3d90d207ded776b044448c0f4aa60955afc715fe6da5b48cc
