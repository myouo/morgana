msgid "⟪k:0⟫Haha..."
msgstr "⟪k:0⟫………하하………."

#: scenario8:scenario8_D2028BE3_1C49_4685_9BA6_05D8B7988A70
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: be81592681357cfd1fd6b03d207d0e0a2d18355c2a7b8fa0c4c8cce92a32212e
#. default-sha256: 65c662ccb6630f6bf325fa60cbfc181204e0c4fc95dc4edb6c6a28de7a37ffd1
msgctxt "scenario8:scenario8_D2028BE3_1C49_4685_9BA6_05D8B7988A70"
msgid "⟪k:0⟫Hahahahahahah... ⟪k:1⟫hee, ⟪k:2⟫heehee, ⟪k:3⟫ahaha, ⟪k:4⟫hahahaha!"
msgstr "⟪k:0⟫하하하하하핫……, ⟪k:1⟫히, ⟪k:2⟫히힉, ⟪k:3⟫아핫, ⟪k:4⟫하하하하……!"

#: scenario8:scenario8_146F5F6C_B470_4D37_810A_EE5AD2905462
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 7cb0b688ad6608064485523b0e93956d0edd4ad508255db52b81412dfdc561d6
#. default-sha256: 0a41eb57c3a8e2b54b3cccfddf83cbeb0b865ba6b07aaf94c513c8e4007ebe41
msgctxt "scenario8:scenario8_146F5F6C_B470_4D37_810A_EE5AD2905462"
msgid "⟪k:0⟫the corpses would have had nothing to stimulate in the first place."
msgstr "⟪k:0⟫사람 시체를 보고 흥분하진 않겠지……."

#: scenario8:scenario8_2A5E35D9_C8E6_41C3_B884_D8A2B1C396F2
