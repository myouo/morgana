msgid "⟪k:0⟫I’m the man... ⟪k:1⟫who freed you from his grasp."
msgstr "⟪k:0⟫나는…… ⟪k:1⟫너를 ⟪k:2⟫그 안에서 구출했어……."

#: scenario8:scenario8_1B14DB30_F2F0_44F7_9D09_00CCA70C9733
