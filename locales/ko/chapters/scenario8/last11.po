msgctxt "scenario8:scenario8_7DE594BE_BC6B_4A94_907B_CC9AD84B6A16"
msgid "⟪k:0⟫And then there was Maria..."
msgstr "⟪k:0⟫그때는 ⟪k:1⟫마리아도 있었지……."

#: scenario8:scenario8_A7435A5E_DC60_4FFD_AF68_6FDEB67CF74F
