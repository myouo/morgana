msgctxt "scenario8:scenario8_676F36FE_D222_4CE8_AD37_C5209D73A750"
msgid "⟪k:0⟫⟪k:1⟫............"
msgstr "⟪k:0⟫⟪k:1⟫…………."

#: scenario8:scenario8_3B4BE779_C9C7_482C_A89E_5FF6CDF9661D
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 58193678c3c6b0d1b6321b61d1fd25e7fe5541b94dca6e88d8002ca6596f8f57
#. default-sha256: 6c16bdf651cc8e216fe9010dca0617690ad5372af79dabf32b31bc718b4e1627
msgctxt "scenario8:scenario8_3B4BE779_C9C7_482C_A89E_5FF6CDF9661D"
msgid "⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫Do you guys hear... ⟪k:4⟫talking... ⟪k:5⟫behind the door?"
msgstr "⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫저기……, ⟪k:4⟫문 안에서 ⟪k:5⟫무슨 소리…… 안 들려?"

#: scenario8:scenario8_52A585C6_D183_4D44_9B87_E24EC8892F9F
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: f79303748a0587e07f308971852db48ef5514152a72162a0d6e702b13073e200
#. default-sha256: cbb0cac4f7b2b437d7603a037d23b5cb6f548477c0126ef74c4bbe87843ebb44
msgctxt "scenario8:scenario8_52A585C6_D183_4D44_9B87_E24EC8892F9F"
msgid "⟪k:0⟫⟪k:1⟫⟪k:2⟫...Is there someone else in there with her?"
msgstr "⟪k:0⟫⟪k:1⟫⟪k:2⟫……누가 달리 있는 건가……?"

#: scenario8:scenario8_8FE029FB_D592_49EB_9D67_18DFF2710A8C
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 7c4d13b21d8308626352279a0926e7ea352176b5a02a9db39e64c65858b27fde
