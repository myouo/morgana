msgstr "⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫…………려 ⟪k:4⟫주세요………."

#: scenario8:scenario8_31362096_C7AE_4CF9_A254_0B4A302A014A
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 76d9f3b32a0233c3a7b6bf0cdbc34b3b4292a54d85756088c8d89a85201c62f0
#. default-sha256: ba8f9f1a37d5844367e9893e20f54a564fe46826b4948dab2da5aad332c3d448
msgctxt "scenario8:scenario8_31362096_C7AE_4CF9_A254_0B4A302A014A"
msgid "⟪k:0⟫Come on..."
msgstr "⟪k:0⟫……저기……."

#: scenario8:scenario8_676F36FE_D222_4CE8_AD37_C5209D73A750
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 038de1944ed6c00826f3bc3b5066be7920ba7baec844042c0bcd14e8b633c190
