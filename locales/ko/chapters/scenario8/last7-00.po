msgid "⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫⟪k:4⟫Ngh... ⟪k:5⟫hahh... ⟪k:6⟫hahhh!"
msgstr "⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫⟪k:4⟫……으……, ⟪k:5⟫헉……, ⟪k:6⟫………!"

