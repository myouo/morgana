msgctxt "scenario8:scenario8_BA468D70_3326_41B2_B93D_17BDBE2EAD12"
msgid "⟪k:0⟫⟪k:1⟫............"
msgstr "⟪k:0⟫⟪k:1⟫…………."

#: scenario8:scenario8_3C079421_56E1_4F15_93A3_DA796E86F4D7
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: f5b96ede11ab3703be2d527e08248efd19fc9f3d3f60b9bc475c5c637ca72af3
#. default-sha256: d9e968341272edf61703df20e9fe966076bdf7c6700b6b974097e528d999958e
