msgid "⟪k:0⟫⟪k:1⟫⟪k:2⟫...Hmm?"
msgstr "⟪k:0⟫⟪k:1⟫⟪k:2⟫어………?"

#: scenario8:scenario8_F480A4C3_8233_4415_B4ED_CE9DAD21C337
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 6aa8dc5ed53a079cc25fc345256842b3e4f22204377d6e17640b9f86290a7d4b
#. default-sha256: bf4e46a9e5ad390155f98c35a52191393d446344c3aac9ecab2d10259cb3bb98
msgctxt "scenario8:scenario8_F480A4C3_8233_4415_B4ED_CE9DAD21C337"
msgid "⟪k:0⟫⟪k:1⟫⟪k:2⟫No need to apologize for the truth."
msgstr "⟪k:0⟫⟪k:1⟫⟪k:2⟫사실이니까 ⟪k:3⟫사과하실 거 없어요.⟪k:4⟫⟪k:5⟫게다가 ⟪k:6⟫말이죠――"

#: scenario8:scenario8_F6ACCCD6_9C77_43C8_9909_208AA8649AA1
