msgid "⟪k:0⟫⟪k:1⟫You do it, Mell!"
msgstr "⟪k:0⟫⟪k:1⟫오라버니가 해 줘!!"

#: scenario8:scenario8_1661D94F_307A_4672_9DE4_6676A95DB918
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 4c5e107d6a895f87fddcd87506155ea77c424aa3581e847786f4928daf2472ba
