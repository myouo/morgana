msgctxt "scenario8:scenario8_881F42ED_CA75_4D0D_802C_C08B28D196BA"
msgid "⟪k:0⟫⟪k:1⟫But there ⟪k:2⟫is⟪k:3⟫ you and me!"
msgstr "⟪k:0⟫⟪k:1⟫그래도 ⟪k:2⟫넬리가 있고 ⟪k:3⟫오라버니가 있지!"

#: scenario8:scenario8_ED1A42F4_0083_47E0_B467_4E7A0F97768E
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 369bddec80d0c794e359b02f874c2bd993bff1e7489ca4589572e391052674a6
#. default-sha256: f687734b423e7cf6ce1d8e7466f1d102a9c50dba2304b07f506dfaba974d877b
msgctxt "scenario8:scenario8_ED1A42F4_0083_47E0_B467_4E7A0F97768E"
msgid "⟪k:0⟫⟪k:1⟫Honestly, I can live without shiny shoes and pretty dresses like Mother wears."
msgstr ""
"⟪k:0⟫⟪k:1⟫실은 ⟪k:2⟫반짝거리는 구두도 필요 없고, ⟪k:3⟫어머님이 입던 것처럼 예쁜 옷도 필요 없어."

#: scenario8:scenario8_295676A1_D635_4341_8FD6_1EA3D4F425A7
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 0f3330c4b3ba106016be0d6153455bcce3e3e2e5c8afdb3d17c53fa4be672679
