msgid "⟪k:0⟫실은 ⟪k:1⟫매우 복받은 거였단 사실도 ⟪k:2⟫비로소 이해했지."
msgstr "⟪k:0⟫실은 ⟪k:1⟫매우 복받은 거였단 사실도 ⟪k:2⟫비로소 이해했지."

#: scenario8:scenario8_2CD297F4_AE5E_441B_973A_22F0B3D9620B
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 0cb2535e65a0e947d8dae6f4ca56596a946a857f4ce6191d007b10652b69b158
#. default-sha256: 814aa051112800980a7febf75a8ea606f81a05629c294b82bccb208b103d3d75
