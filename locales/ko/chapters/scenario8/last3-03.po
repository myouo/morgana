msgctxt "scenario8:scenario8_63C0553A_2BF8_403B_8F8B_D3C168C58921"
msgid "⟪k:0⟫⟪k:1⟫하지만 네 머리카락은 햇살을 쬐면 반짝거려서――"
msgstr "⟪k:0⟫⟪k:1⟫하지만 네 머리카락은 햇살을 쬐면 반짝거려서――"

#: scenario8:scenario8_F22859B9_3BF8_4FBD_BCCD_258FBB8B2151
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 487c922ff4e423dbdb1ed53b885cc97f9f05286aa77515138f351851ce0414fe
#. default-sha256: 2ab98774f99e54649e53383a08fc14e1b80da679f72efd5550361a3dfed97ebb
msgctxt "scenario8:scenario8_F22859B9_3BF8_4FBD_BCCD_258FBB8B2151"
msgid "⟪k:0⟫⟪k:1⟫I genuinely wanted it to be."
msgstr "⟪k:0⟫⟪k:1⟫……진심으로 그럴 줄 알았지……."

#: scenario8:scenario8_B97BE98D_2583_4169_BB9B_190473D8D892
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 8cdb085a18d7c8a1198e1977504b2bb9263818ba3b94bc73d0e1800540ff4218
#. default-sha256: 319b8ac853bce957f5111463eca1627e6de73588557b744164b9e5851dc36f4d
msgctxt "scenario8:scenario8_B97BE98D_2583_4169_BB9B_190473D8D892"
msgid "⟪k:0⟫As the oldest son, normally it would fall on me to take his place."
msgstr "⟪k:0⟫정상적으로 치면 후계자는 나야. ⟪k:1⟫그 집안의 장남은 나였거든."

#: scenario8:scenario8_576823A8_8A8A_492F_B882_CA3E4A5943E8
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 70c317b226e1c15fbb00444642fbcc88d73044b5f81d77d585b5fe446b16a66d
