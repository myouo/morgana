msgctxt "scenario8:scenario8_576823A8_8A8A_492F_B882_CA3E4A5943E8"
msgid "⟪k:0⟫Nobody else did, though."
msgstr "⟪k:0⟫주위에선 그렇게 안 보더라."

#: scenario8:scenario8_3FAC48C1_DFA9_4B0E_979A_DBA10D2BF36D
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 8d0fab1bccd3df7dea9cc37510bfec9aba15df4b2971b782143ed69d81b62830
#. default-sha256: 4a8b5b3f6fd74c8e72b2fa55571ca7780909f72e417a89fea8999405d1e71cab
msgctxt "scenario8:scenario8_3FAC48C1_DFA9_4B0E_979A_DBA10D2BF36D"
msgid "⟪k:0⟫So I was more than happy to let someone else take that responsibility."
msgstr "⟪k:0⟫그래서―― 누가 책임을 져 준다면 ⟪k:1⟫다 괜찮았어."

#: scenario8:scenario8_D57A0704_5E47_44B9_AC13_5B49D4DC3D93
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 2c626cd14b8fce533537f32c2a2cf3978669b983a547e7f38d456d13f7151e4f
#. default-sha256: a8c2f6f5cf895260b80bed87f42cb74aee8f5128ffa0ce7647e0773d20eb1428
msgctxt "scenario8:scenario8_D57A0704_5E47_44B9_AC13_5B49D4DC3D93"
msgid "⟪k:0⟫But the best thing to come out of it all..."
msgstr "⟪k:0⟫그래도 ⟪k:1⟫가장 큰 행운은――"

#: scenario8:scenario8_881F42ED_CA75_4D0D_802C_C08B28D196BA
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 1eaa241d3d541f484bce1fa875e8f50fc534a410ff1f8b6d5203bf98fcbf7851
