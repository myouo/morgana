msgctxt "scenario8:scenario8_34B52276_67B5_4158_8090_18838F65E3D2"
msgid "⟪k:0⟫I realized for the first time how blessed I had always been."
msgstr "⟪k:0⟫당연한 것처럼 누리던 나날이――"

#: scenario8:scenario8_9D740D5C_D5BF_4C64_9D67_A3B6AA0596F3
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 7e290d10050b40bd3db7c5ba6bc035639c57450c960aa1f2493a54932fd03c0d
