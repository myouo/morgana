msgctxt "scenario8:scenario8_7127F800_978D_415A_8267_11EC7B9C8592"
msgid "⟪k:0⟫⟪k:1⟫The time has come to start anew!"
msgstr "⟪k:0⟫⟪k:1⟫바로 지금이 혁명의 때다!"

#: scenario8:scenario8_40D851D5_8FD4_4474_8B95_059DFDDEDC73
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 344a53127ceb089c1e449e1783a371db04892b40a8c621da1fde25048d661611
#. default-sha256: 1d041d44101d879508929ffaf0e2eb64bc51509bef0b48269709f16c89803888
msgctxt "scenario8:scenario8_40D851D5_8FD4_4474_8B95_059DFDDEDC73"
msgid "⟪k:0⟫⟪k:1⟫And I shall be the one to lead you down that path!"
msgstr "⟪k:0⟫⟪k:1⟫내가 새로이 이끌겠다!"

#: scenario8:scenario8_B9D2A7DA_E011_4BB7_8DCA_8858D30581D3
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: f1d10244e2222381b0741a6601fe7f824970d2d0ae006d67e237a6114bbb1c91
