msgid "⟪k:0⟫I won’t stand by and watch my homeland crumble."
msgstr "⟪k:0⟫Non voglio vedere la mia terra soccombere."

#: scenario3:scenario3_E78FF1A0_52FB_40E5_8FE9_255CA0557663
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
