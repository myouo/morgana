msgid "⟪k:0⟫(Such a pitiful man I’ve become...)"
msgstr "⟪k:0⟫(Che uomo patetico sono diventato...)"

#: scenario3:scenario3_194B39BC_4CE1_43B0_A750_4A51ED4D218C
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: e1a8bccd0c01f97b6080140a32934529df06a3a7e79496deed8f13c7b67c7f23
