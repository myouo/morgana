msgctxt "scenario3:scenario3_8FB8FE28_CCF5_4335_A6FA_77687A0B1BD2"
msgid "⟪k:0⟫Letter after letter after letter."
msgstr "⟪k:0⟫Lettera dopo lettera dopo lettera."

#: scenario3:scenario3_A921A368_BDAE_4AF0_AB5C_C3B1B5926459
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 79e4e8e19b954eaa45aa58ee208610d26b75096ea0a65452be96bdc5247612de
