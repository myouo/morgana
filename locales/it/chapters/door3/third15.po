#: scenario3:scenario3_B22C54AE_13D7_4EF6_98DD_84AB3228666B
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: f325f3741d01a2a416c163d22989837ec28fbaa442d0d50f5599e6fab3738466
#. default-sha256: 4ae24aa8da484a3a51f93bf3cce756d9462c643ad7adc1054a04ae9cdf0b20c9
msgctxt "scenario3:scenario3_B22C54AE_13D7_4EF6_98DD_84AB3228666B"
msgid "⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫Master. ⟪k:4⟫Master."
msgstr "⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫Padrone. ⟪k:4⟫Padrone."

#: scenario3:scenario3_2FCCFDD8_433A_4294_9CB6_5C7C35CDD92C
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 9678df7cf6d917d036e09502b234e53d8fb630c4d7bedfb9bb7f21610f18d71e
#. default-sha256: 999460d1981d97adbb7b35b928e5dcc4afa85088f5805e0d6be2a88288a73c42
msgctxt "scenario3:scenario3_2FCCFDD8_433A_4294_9CB6_5C7C35CDD92C"
msgid "⟪k:0⟫Are you shocked?⟪k:1⟫⟪k:2⟫Or do you instead lament this development?"
msgstr ""
"⟪k:0⟫Ciò che ha visto l’ha turbata?⟪k:1⟫⟪k:2⟫Oppure questo corso degli eventi l’ha rattristata?"

#: scenario3:scenario3_1EFB07A8_8D5D_4CCA_9EFD_23CE0ACEAA07
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 85734f2604f9dd34e976251a4d2bc77b5f15dfacc114019b727d9421f1c46915
#. default-sha256: 57d812b9a6a19c79a709721c6ef7c4f2c0a856e95f8e0196e5da97aa1455ede8
msgctxt "scenario3:scenario3_1EFB07A8_8D5D_4CCA_9EFD_23CE0ACEAA07"
msgid ""
"⟪k:0⟫I was... ⟪k:1⟫I was deeply sorrowful.⟪k:2⟫⟪k:3⟫Though to a lesser degree about Maria’s true "
"intentions and more my shameful inability to recognize her machinations."
msgstr ""
"⟪k:0⟫Io... ⟪k:1⟫ero profondamente addolorata a quel tempo.⟪k:2⟫⟪k:3⟫Non tanto per le vere "
"intenzioni di Maria, quanto piuttosto per la mia vergognosa incapacità di scoprire i suoi piani."

#: scenario3:scenario3_69DB4C0C_31D8_4AFE_B6DE_D91912124EB6
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 78a2278d5d7ea949c5403d2469a90a40c93721086ec2efc3ceb41acae7034156
#. default-sha256: ac1e0e1827f8bbf632498e621658add77d2767e879e879d0902d46bf1c5bcff2
msgctxt "scenario3:scenario3_69DB4C0C_31D8_4AFE_B6DE_D91912124EB6"
msgid "⟪k:0⟫At the time, I too believed that Maria was the White-Haired Girl’s one and only ally."
msgstr ""
"⟪k:0⟫All’epoca, anch’io credevo che lei fosse la sola e unica alleata della Ragazza dai Capelli "
"Bianchi."

#: scenario3:scenario3_A420E2B1_D973_4284_8769_540A95782AF0
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 58f8e141ad0474161ca58fe70dee92498d4384ac2f709686e07f58c0676f8df2
#. default-sha256: a44d00564bbc5d6ee3c2848173d4c5109fe370fad8d9b296bd755f680eccd597
msgctxt "scenario3:scenario3_A420E2B1_D973_4284_8769_540A95782AF0"
msgid "⟪k:0⟫It was not until everything had drawn to a close that I discovered the truth."
msgstr "⟪k:0⟫Scoprii la verità solo quando ormai era già troppo tardi."

#: scenario3:scenario3_0FBCF4C5_58AC_40A3_9903_30F2EEDD78E1
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 324baeb6e0db178bdb435a44e7f4698488f9f7764115bddb75b76d84bc0fcb2b
#. default-sha256: 854d97ff3a3d760669491569b7f59701c1b418f31812b1f3c8d5f0fc5b733258
msgctxt "scenario3:scenario3_0FBCF4C5_58AC_40A3_9903_30F2EEDD78E1"
msgid "⟪k:0⟫...Then I now know how the tale ends, you say? ⟪k:1⟫Yes, that is correct."
msgstr "⟪k:0⟫...Dunque io so come si conclude la vicenda, dice? ⟪k:1⟫Sì, esatto."

#: scenario3:scenario3_BEED55E5_FC2D_4478_B59E_1B24A3621BE8
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: c54116b8cf6977bbaea7fda6fbde09727f15febe918ef60ba9cb76b6aa3688a8
#. default-sha256: fa740504987fdd5b685a1589e9d48d49e9312da5c6870acb7e5eb813bb1759f4
msgctxt "scenario3:scenario3_BEED55E5_FC2D_4478_B59E_1B24A3621BE8"
msgid ""
"⟪k:0⟫Well aware that it was not the case, I told you the story in a way that suggested she ⟪k:1⟫"
"was⟪k:2⟫ on the White-Haired Girl’s side."
msgstr ""
"⟪k:0⟫Le ho raccontato la storia in modo tale che sembrasse che Maria stesse dalla parte della "
"Ragazza dai Capelli Bianchi, ben consapevole che non era così."

#: scenario3:scenario3_037D8825_28AD_45EC_B463_30A9229BB447
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: af7a74151e5a207d82507fbb6bf9326a3e559a6c92cb6ae1c47f2fbd39b7c543
#. default-sha256: daeaac4f2a3fb63a48a29684a6ee3b70927855710f4247274c4e277ac616ff10
msgctxt "scenario3:scenario3_037D8825_28AD_45EC_B463_30A9229BB447"
msgid "⟪k:0⟫Oh my... ⟪k:1⟫I wonder if that constitutes lying to you, Master."
msgstr "⟪k:0⟫Accidenti... ⟪k:1⟫Mi chiedo se questo costituisca una menzogna per lei, Padrone."

#: scenario3:scenario3_536BA22B_D9AB_4269_98F1_CF7925EE61BA
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 9f0bbac0627dd2843d6a7df6d4405f9a3315873e1988ed0a849c5902a593d4a4
#. default-sha256: 6aca74d45835f3ec6439bf2bed756370bd2444129571127f9418d94dbf7153d0
msgctxt "scenario3:scenario3_536BA22B_D9AB_4269_98F1_CF7925EE61BA"
msgid ""
"⟪k:0⟫I merely wanted to present the events to you in order, starting from the beginning, when "
"Maria’s ill intentions were still veiled in shadow."
msgstr ""
"⟪k:0⟫Volevo semplicemente presentarle gli eventi in ordine, partendo dal principio, da quando le "
"cattive intenzioni di Maria erano ancora nascoste nell’ombra."

#: scenario3:scenario3_B07B1C5C_AD18_48B5_9A1C_9188D3B65528
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 3c74fbc38dadf68a1482773fba1253bbcf162f0074a0cc3de76aff13b156bd84
#. default-sha256: 374b7a4ae3bb97caf897508d6625aecab1092c1cc7d953842ef474dc3e8cce00
msgctxt "scenario3:scenario3_B07B1C5C_AD18_48B5_9A1C_9188D3B65528"
msgid "⟪k:0⟫I wanted you to know the same feeling of consternation I had experienced."
msgstr "⟪k:0⟫Volevo che lei provasse lo stesso turbamento che ho vissuto io."

#: scenario3:scenario3_E9E59592_BFFD_4854_A962_ECEE24240B56
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 7f44eac419bfca077ba06248f0a70756fda7cdf53e7f1f26b4c42f536eb5d21a
#. default-sha256: 6903fb2aa82d3cf359c3f8e61cf501f264c59b2d16baa1b40a0e6f7dfc081ece
msgctxt "scenario3:scenario3_E9E59592_BFFD_4854_A962_ECEE24240B56"
msgid ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫⟪k:4⟫⟪k:5⟫⟪k:6⟫⟪k:7⟫⟪k:8⟫⟪k:9⟫The White-Haired Girl continued to write letter "
"after letter."
msgstr ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫⟪k:4⟫⟪k:5⟫⟪k:6⟫⟪k:7⟫⟪k:8⟫⟪k:9⟫La Ragazza dai Capelli Bianchi continuò a "
"scrivere lettera dopo lettera."

#: scenario3:scenario3_F1FC3C19_29B2_4F4C_836F_C0D34DD55451
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 1945b22cb3635c876de858f894bf84ff72a5dcc104c30e91d4f1feeb5db7175d
#. default-sha256: fd6335a8a876b3cf34f10cdd18a6156bdaf2c27eabbaacd0f769a00c114eacfa
msgctxt "scenario3:scenario3_F1FC3C19_29B2_4F4C_836F_C0D34DD55451"
msgid ""
"⟪k:0⟫They were all addressed to her dear husband, detailing her ever-persistent love for him..."
msgstr ""
"⟪k:0⟫Erano tutte indirizzate al suo caro marito, e descrivevano nel dettaglio il suo eterno amore "
"per lui..."

#: scenario3:scenario3_8FD88E68_AF08_459F_BEA4_43220459FE5D
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 4d6ef1c4ae53b8129752b212661a8f3b0fddda3f71969f70a2ed75a498cab601
#. default-sha256: b3107399325d2b943483d77774518adcb92b254608c2cd9d2b110b5a18222fac
msgctxt "scenario3:scenario3_8FD88E68_AF08_459F_BEA4_43220459FE5D"
msgid "⟪k:0⟫and her desire for their relationship to return to what it had once been."
msgstr "⟪k:0⟫e il suo desiderio di vedere la loro relazione tornare quella di un tempo."

#: scenario3:scenario3_7332670A_DF5B_43B9_8DC2_C59C37EC2896
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: f09797ad65419ef2245f562705867633cef43c7bf9f5c07cfd6d30db63c688b8
#. default-sha256: c28defbf88ed48b525aa0d7fc95dc33ce2939ecf0522e73c4242994a3ae7379b
msgctxt "scenario3:scenario3_7332670A_DF5B_43B9_8DC2_C59C37EC2896"
msgid "⟪k:0⟫⟪k:1⟫My beloved,⟪k:2⟫⟪k:3⟫I am sure your hands are quite full right now.⟪k:4⟫"
msgstr "⟪k:0⟫⟪k:1⟫Mio amato,⟪k:2⟫⟪k:3⟫Sono sicura che tu sia molto impegnato al momento.⟪k:4⟫"

#: scenario3:scenario3_7377A6CF_B0F7_4CE8_9A1E_B62F992FB17E
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 80450ae006188aeb7023fff6a1c6512da9d9b0887ec23fee840929be40fa100f
#. default-sha256: 45d61e4664bf7a910d50f67766f090fb5c9c158eab1e99e48b96deb954195aab
msgctxt "scenario3:scenario3_7377A6CF_B0F7_4CE8_9A1E_B62F992FB17E"
msgid "⟪k:0⟫⟪k:1⟫But that is fine; it does not change my love for you.⟪k:2⟫"
msgstr "⟪k:0⟫⟪k:1⟫Ma va bene così; ciò non cambia il mio amore per te.⟪k:2⟫"

#: scenario3:scenario3_D6C01F95_238D_42FB_8CEB_21E1ACDEB556
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 925e45803ef3e8fa1c393783a7e7dc47d1bb2f7b823f74093a719e4ff1cca217
#. default-sha256: 41947df5bee32aca69f6a8913919c84d1bdd2c1982032ba3cd9d8c8daeb8d79f
msgctxt "scenario3:scenario3_D6C01F95_238D_42FB_8CEB_21E1ACDEB556"
msgid ""
"⟪k:0⟫⟪k:1⟫Do you remember the day we went out together?⟪k:2⟫⟪k:3⟫That was, perhaps, the most "
"wonderful day of my life.⟪k:4⟫⟪k:5⟫I had a truly incredible time.⟪k:6⟫"
msgstr ""
"⟪k:0⟫⟪k:1⟫Ti ricordi quel giorno in cui siamo usciti insieme?⟪k:2⟫⟪k:3⟫Quello è stato "
"probabilmente il giorno più bello della mia vita.⟪k:4⟫⟪k:5⟫Fu davvero incredibile.⟪k:6⟫"

#: scenario3:scenario3_F3789E13_79DE_4518_A353_0ECBAA53CEF0
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: f79f27cfe9939a3b150e25258a6f9c3d6fdf716e7e49329880815eab18f95d39
#. default-sha256: 1187a35633968bacbf0580419565e783c46eab9d4747e78434a15a21b761c91c
msgctxt "scenario3:scenario3_F3789E13_79DE_4518_A353_0ECBAA53CEF0"
msgid ""
"⟪k:0⟫⟪k:1⟫I still treasure the gift you gave to me,⟪k:2⟫⟪k:3⟫for it is the one and only present I "
"have received from you...⟪k:4⟫"
msgstr ""
"⟪k:0⟫⟪k:1⟫Conservo ancora il regalo che mi hai dato,⟪k:2⟫⟪k:3⟫perché è il solo e unico regalo che "
"abbia mai ricevuto da te.⟪k:4⟫"

#: scenario3:scenario3_078A285C_DB66_4D08_A856_7F85CABAF5BF
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 149d68992a198e31e9bbd5c433bb5b6b68474314c6a9464a4acf02f8902684d2
#. default-sha256: 31e90bb398a5404fc02cb9bd9a421fccdaff503c2095016bdb15e26d213c9ceb
msgctxt "scenario3:scenario3_078A285C_DB66_4D08_A856_7F85CABAF5BF"
msgid ""
"⟪k:0⟫⟪k:1⟫That reminds me, Maria tried to teach me how to dance.⟪k:2⟫⟪k:3⟫I doubt I will ever "
"progress beyond being laughably bad, though...⟪k:4⟫"
msgstr ""
"⟪k:0⟫⟪k:1⟫Sai, Maria ha provato ad insegnarmi a ballare.⟪k:2⟫⟪k:3⟫Dubito però che riuscirò ad "
"andare oltre l’essere ridicolmente pessima...⟪k:4⟫"

#: scenario3:scenario3_E062BEDC_9AE6_477E_9EAB_2F776BA9919A
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 72b92b0e79e755bd1b8357d9f73e9b7c29c1a3a37433364340fce37aee6956e6
#. default-sha256: 1a5a5ebf7cb332b0fd09291cbd083ce00458f4f7ef9fe43c8c6fcedc209603c3
msgctxt "scenario3:scenario3_E062BEDC_9AE6_477E_9EAB_2F776BA9919A"
msgid "⟪k:0⟫⟪k:1⟫It would be nice if, someday, you and I could dance together.⟪k:2⟫"
msgstr "⟪k:0⟫⟪k:1⟫Sarebbe bello se, un giorno, io e te potessimo ballare insieme.⟪k:2⟫"

#: scenario3:scenario3_26F96882_6E8B_4C97_88BF_D48D97982A92
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 8ce5d84bedd9b64c3df3e66c15edbcde2b565504bf59dc6494445dceccc73bce
#. default-sha256: 57984f5c6fbfdaf55961c2ff57fab1aff7869424c62f2ead4b19b68312003aab
msgctxt "scenario3:scenario3_26F96882_6E8B_4C97_88BF_D48D97982A92"
msgid ""
"⟪k:0⟫⟪k:1⟫Perhaps, when you have a little respite from work, we could go out again, maybe take a "
"carriage somewhere a little farther away.⟪k:2⟫"
msgstr ""
"⟪k:0⟫⟪k:1⟫Quando avrai un attimo di tregua dal lavoro, potremmo uscire di nuovo, prendere un "
"carro e andare da qualche parte, lontano da qui.⟪k:2⟫"

#: scenario3:scenario3_F7D5F193_D18B_482C_9412_88BCDF5A0C93
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 7db26a922e64989435dfb1d351233ca2944dbd1d60fc38692ed8e479ddc4efaf
#. default-sha256: 14e4e733a7f902e1f32a4432b9bd0df71a32d200dff2989bebe6bf9ea8a7da67
msgctxt "scenario3:scenario3_F7D5F193_D18B_482C_9412_88BCDF5A0C93"
msgid "⟪k:0⟫⟪k:1⟫And we could dine at a restaurant more to your liking.⟪k:2⟫"
msgstr "⟪k:0⟫⟪k:1⟫E potremmo cenare in un ristorante che ti piace davvero.⟪k:2⟫"

#: scenario3:scenario3_470CC718_B9D6_41CC_B704_B9206DFD8ED6
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 0bfbff1dea3474334032eccefa6623b15e5a4ad286a89376b93d31fa5435909f
#. default-sha256: aac3eb0e96932696dca827d95b467aed143c9a0d40ac263cb0c90a090f9148ff
msgctxt "scenario3:scenario3_470CC718_B9D6_41CC_B704_B9206DFD8ED6"
msgid ""
"⟪k:0⟫⟪k:1⟫Although, I think the cuisine at the other restaurant was exquisite, personally.⟪k:2⟫"
msgstr "⟪k:0⟫⟪k:1⟫Ciò nonostante, penso che la cucina di quel ristorante fosse squisita.⟪k:2⟫"

#: scenario3:scenario3_C35D0B18_64E9_408C_8AD3_1673B334D207
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: a1efb6d0f82b5e9426b5f3a340a162ac61223426ce04b43cacaaebeaeffdf2b7
#. default-sha256: 74a41aa72ab58c4b461cd605d6ebe82b42aa59d98494103b82d3c1b6cb722c59
msgctxt "scenario3:scenario3_C35D0B18_64E9_408C_8AD3_1673B334D207"
msgid "⟪k:0⟫⟪k:1⟫Do I, perhaps, have an unrefined palate?⟪k:2⟫"
msgstr "⟪k:0⟫⟪k:1⟫Forse il mio non è un palato abbastanza raffinato?⟪k:2⟫"

#: scenario3:scenario3_F55CE928_ED20_4637_8482_B36D44AB0A51
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 8e42253f3f8f2fea913a27eda7d185e21e63d4c8c804b243551efeacbd304683
#. default-sha256: 2900b597adc451fec3fd6531a8c4ffecd443710d52f1812301cdbc06de98cc14
msgctxt "scenario3:scenario3_F55CE928_ED20_4637_8482_B36D44AB0A51"
msgid ""
"⟪k:0⟫Maria altered the letters before delivering them, however.⟪k:1⟫⟪k:2⟫She changed the "
"addressee from Jacopo to another man."
msgstr "⟪k:0⟫Tuttavia, Maria alterava le lettere prima di consegnarle, cambiando il destinatario."

#: scenario3:scenario3_6A9592E1_29C1_4FB4_885C_5B810929B83F
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 26dbabbd3ad8fc1fb99e55a7e3ea54cafe3ec29ec337f786ccbef453a2413330
#. default-sha256: cceae9272f2cf4aac40c821b01d35c2b4c40d9b002c04cb6fc6c6435d4871286
msgctxt "scenario3:scenario3_6A9592E1_29C1_4FB4_885C_5B810929B83F"
msgid ""
"⟪k:0⟫She would cut away the top of the page with Jacopo’s name on it, and in the space below "
"write a different name."
msgstr ""
"⟪k:0⟫Tagliava la parte superiore della pagina con su scritto il nome di Jacopo, e appena sotto "
"scriveva un nome diverso."

#: scenario3:scenario3_AFBC8CD9_BD05_4D83_868A_BE1F230C0838
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 1a393e20c98ecc770bfb8440876a45a5d398d6c31c925bc777390e1164e720bd
#. default-sha256: bec20620cc0c742e59e44e52b6edcbcda8337a3d59a3bbbad7175884a5c261ed
msgctxt "scenario3:scenario3_AFBC8CD9_BD05_4D83_868A_BE1F230C0838"
msgid ""
"⟪k:0⟫She could not have mimicked the White-Haired Girl’s handwriting for the full length of a "
"letter, but Maria could make a single name look adequately similar."
msgstr ""
"⟪k:0⟫Non avrebbe saputo imitare la grafia della Ragazza dai Capelli Bianchi per l’intera "
"lunghezza di una lettera, ma avrebbe potuto rendere⟪k:1⟫un singolo nome adeguatamente simile."

#: scenario3:scenario3_101EB0A4_AF89_43CD_B7F7_037D32EFC20E
