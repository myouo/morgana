msgctxt "scenario3:scenario3_CB7A3857_AA78_4D07_B7B6_E02AE4675CD9"
msgid "⟪k:0⟫The more they writhed in anguish, the deeper her satisfaction grew."
msgstr "⟪k:0⟫Più si contorcevano dal dolore, più la sua soddisfazione aumentava."

#: scenario3:scenario3_830ADD04_45C1_4706_87D5_99FFB88E5EF6
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 234b0e1b8f369ef580c0f03a768f696d6011e18e790b86658f61fa1ac542d0ce
