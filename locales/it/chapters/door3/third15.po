msgid "⟪k:0⟫If we don’t turn our attention outwards, we will wither away and die."
msgstr "⟪k:0⟫Se non rivolgiamo la nostra attenzione altrove,⟪k:1⟫ci estingueremo, e moriremo."

#: scenario3:scenario3_E15B489D_0B69_461A_B199_9684A706F593
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 2d9a8976d7027c57260d45078a877935f624ff64545db4861a1b3a060336506c
