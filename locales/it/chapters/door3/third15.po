msgid "⟪k:0⟫I can’t— ⟪k:1⟫⟪k:2⟫I can’t believe what I’m reading!"
msgstr "⟪k:0⟫Non riesco— ⟪k:1⟫⟪k:2⟫Non riesco a credere a quello che sto leggendo!"

#: scenario3:scenario3_B4D774AE_816B_411C_8AE3_D158DE11CA5A
