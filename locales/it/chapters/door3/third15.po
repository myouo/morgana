msgid "⟪k:0⟫(In time, she’ll let go... ⟪k:1⟫and so will he...)"
msgstr "⟪k:0⟫(Col tempo, si arrenderà... ⟪k:1⟫e così anche lui...)"

#: scenario3:scenario3_47ED758F_1A81_4DD6_9DFD_A30A6993178C
