msgctxt "scenario3:scenario3_51596965_202A_4B4E_98EB_085DD0918BCE"
msgid ""
"⟪k:0⟫No one’s going to follow a capofamiglia they can’t respect.⟪k:1⟫⟪k:2⟫They’ll try to "
"undermine your authority."
msgstr ""
"⟪k:0⟫Nessuno seguirà un capofamiglia che non viene rispettato.⟪k:1⟫⟪k:2⟫Cercheranno di "
"sottostimare la tua autorità."

#: scenario3:scenario3_65FD62C1_0EB4_4358_ACF1_F8CB381AE42E
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
