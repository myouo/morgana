msgid "⟪k:0⟫Not as long as I’m intercepting them..."
msgstr "⟪k:0⟫Non finché intercetto queste lettere..."

#: scenario3:scenario3_B1DEBC2E_B042_4EE4_AE87_E0F97F180334
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 1db8d66e540c2fe752d604f2538805c8c8bb5f5a4c1ebf7f43a45db03819df66
