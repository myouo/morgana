msgctxt "scenario3:scenario3_7243785E_1298_4CA5_9477_3763B0721D9D"
msgid ""
"⟪k:0⟫(Fantasizing about her writing to this other man... ⟪k:1⟫and what she might be putting in "
"her correspondence...)"
msgstr ""
"⟪k:0⟫(Fantasticando su ciò che lei potrebbe scrivere a quest’uomo...⟪k:1⟫⟪k:2⟫e su cosa potrebbe "
"inserire nella propria corrispondenza...)"

#: scenario3:scenario3_C66B43D4_373A_4993_9436_ABBE96833A62
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: f70bfbf80ef61f4937096beafbe44e661ec1f347643105476c3d36be376de573
