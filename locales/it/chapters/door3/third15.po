msgctxt "scenario3:scenario3_D910474C_FDD5_41ED_8017_DB92FBDDF606"
msgid "⟪k:0⟫(But if I don’t... ⟪k:1⟫my imagination will run wild.)"
msgstr "⟪k:0⟫(Ma se non lo facessi...⟪k:1⟫ la mia immaginazione andrebbe fuori controllo.)"

#: scenario3:scenario3_7243785E_1298_4CA5_9477_3763B0721D9D
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: f3c9ae8900f895ad294118163cd76a28a61172325be39a81a39416fd9110f246
