msgid "⟪k:0⟫⟪k:1⟫No... ⟪k:2⟫No..."
msgstr "⟪k:0⟫⟪k:1⟫No... ⟪k:2⟫No..."

#: scenario3:scenario3_A174DBE2_8F2C_464A_9A01_1E9AEBCE5D74
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 3caba214ba8b2b7c7c8d622aa643103b7e49c023bffbffea27d0f0ffe6a78743
#. default-sha256: 5c7b602dc4d0d084ae1c770ae79f914fe6dd8d421130da27f74380d4ff0669e6
msgctxt "scenario3:scenario3_A174DBE2_8F2C_464A_9A01_1E9AEBCE5D74"
msgid ""
"⟪k:0⟫I will get through to him...⟪k:1⟫⟪k:2⟫Everything will go back to normal...⟪k:3⟫⟪k:4⟫I have "
"faith."
msgstr "⟪k:0⟫Riuscirò a convincerlo...⟪k:1⟫⟪k:2⟫Tutto tornerà come prima...⟪k:3⟫⟪k:4⟫Io ho fiducia."

#: scenario3:scenario3_434D9104_934D_4D9E_876C_33E647912E0F
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: ff46d336c00b549ac498f980f75e092b243897f5f4f1e9d3eb8038a34206f0da
#. default-sha256: 3305454a66fb4abb9d734e057864c5d9bc29fca829bbf4c0460441eb9bc07804
msgctxt "scenario3:scenario3_434D9104_934D_4D9E_876C_33E647912E0F"
msgid "⟪k:0⟫All my letters may go up in flames...⟪k:1⟫⟪k:2⟫but my faith will not be lost with them."
msgstr ""
"⟪k:0⟫Lei mie lettere potranno anche andare a fuoco...⟪k:1⟫⟪k:2⟫ma non sarà lo stesso per la mia "
"speranza."

#: scenario3:scenario3_B91FF130_107B_4C5D_91A5_56B2E0FC1501
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 9a9834503a231774bb0f3737cf06445f448ea750ff135458ed887b7214ea7107
#. default-sha256: 5c51fb6bf4038cf8919bf0d398b620584745662274dc590a1cdcf992fa99eadb
msgctxt "scenario3:scenario3_B91FF130_107B_4C5D_91A5_56B2E0FC1501"
msgid "⟪k:0⟫As long as I keep writing..."
msgstr "⟪k:0⟫Se continuo a scrivere..."

#: scenario3:scenario3_FF9E4CFF_D915_4518_9A03_681D65EB23E6
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 9e0d54741ac51901db114aecd7123ee3d540bb175bfefe02e85b4310abfe6954
#. default-sha256: 6196c72283b8fe3ec1b92ba5df7aa4917061e5ac1e0bad88c5db5e972124a60b
msgctxt "scenario3:scenario3_FF9E4CFF_D915_4518_9A03_681D65EB23E6"
msgid ""
"⟪k:0⟫eventually... ⟪k:1⟫I will get through to him.⟪k:2⟫⟪k:3⟫So I cannot stop... ⟪k:4⟫I cannot."
msgstr "⟪k:0⟫prima o poi... ⟪k:1⟫le leggerà.⟪k:2⟫⟪k:3⟫Quindi non posso fermarmi... ⟪k:4⟫non posso."

#: scenario3:scenario3_FC66C310_D0EC_4D7A_B6E2_D7C0006192FD
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 60680e40b13049e12a87e628326b9e388a5f4792f7be9ca66ff821dd61ac3289
#. default-sha256: 64f4f01d6f3796a64293db1c7a668d185e9b2634998a318bd5eec2644a51e87b
msgctxt "scenario3:scenario3_FC66C310_D0EC_4D7A_B6E2_D7C0006192FD"
msgid "⟪k:0⟫⟪k:1⟫Do you have any idea what he says about you, Madam?"
msgstr "⟪k:0⟫⟪k:1⟫Hai idea di cosa dice sul tuo conto, Madam?"

#: scenario3:scenario3_F01194CA_4BA1_4927_8D9B_8AFBA294025E
