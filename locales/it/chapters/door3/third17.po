msgid "⟪k:0⟫⟪k:1⟫................................."
msgstr "⟪k:0⟫⟪k:1⟫................................."

#: scenario3:scenario3_C7CD7239_02F4_40D9_9FA5_DCA92B72EDF5
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: c2f439bbe056330eeafd5bcb8c1dc2c10b3cfdc55df7c4f87631d06223d9b362
