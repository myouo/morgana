msgid "⟪k:0⟫⟪k:1⟫............"
msgstr "⟪k:0⟫⟪k:1⟫............"

#: scenario3:scenario3_1546908A_4815_49FB_8144_C6A5F7BDE298
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: ff3b087bea1b7e2202243eecf88de554a54e4ad6ad8a59b667eae6a8fd2e149d
#. default-sha256: b2a416a6fc665d25fec74de2d14f165175ef91ea9105884e22b1e9324ff92c54
msgctxt "scenario3:scenario3_1546908A_4815_49FB_8144_C6A5F7BDE298"
msgid ""
"⟪k:0⟫⟪k:1⟫Jacopo doesn’t trust you in the ⟪k:2⟫slightest⟪k:3⟫.⟪k:4⟫⟪k:5⟫He goes around calling "
"you a witch.⟪k:6⟫⟪k:7⟫A man-eating devil-woman."
msgstr ""
"⟪k:0⟫⟪k:1⟫Jacopo non ha la benché minima fiducia in te.⟪k:2⟫⟪k:3⟫Se ne va in giro a dire che sei "
"una strega.⟪k:4⟫⟪k:5⟫Un demone mangia-uomini."

#: scenario3:scenario3_3B0F9553_40AB_4C08_9C9A_29FEF480ED2C
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 6f8ae5b52232b55784c29786dfe8ed1fea95d5a604c8d09efcfd05f24fd25ca0
#. default-sha256: 7c28426df73a94735210b0a6dde5d26c1661549b0eac049324a70ee7564c323d
msgctxt "scenario3:scenario3_3B0F9553_40AB_4C08_9C9A_29FEF480ED2C"
msgid "⟪k:0⟫⟪k:1⟫It’s awful.⟪k:2⟫⟪k:3⟫There’s no one as pure and as beautiful as you."
msgstr "⟪k:0⟫⟪k:1⟫⟪k:2⟫È⟪k:3⟫ orribile.⟪k:4⟫⟪k:5⟫Non c’è nulla di più puro e più bello di te."

#: scenario3:scenario3_31FA80D5_12A8_4254_B2D4_55D8CD3D7FC9
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 4cda2d68c1a9cb4a33d050a45e2b18b980ae7f239123f52323a3a2260668e546
#. default-sha256: 21cce3bd783c194b4cdbe47e2c75763a80094338cf1c238218bbbc52c609f9d1
msgctxt "scenario3:scenario3_31FA80D5_12A8_4254_B2D4_55D8CD3D7FC9"
msgid "⟪k:0⟫⟪k:1⟫He says... ⟪k:2⟫I am a witch?"
msgstr "⟪k:0⟫⟪k:1⟫Ha detto... ⟪k:2⟫che sono una strega?"

#: scenario3:scenario3_2938A9B9_A728_4CA9_8E74_A87E86F07571
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 090700ad3f3455019bbb54b865f42a18dc42f597489eb360564fc3cca3f0d1d0
#. default-sha256: f167ef6d8de6ef746261eb5bd1761a1acabf76370870960fb16f323ca8f25112
msgctxt "scenario3:scenario3_2938A9B9_A728_4CA9_8E74_A87E86F07571"
msgid "⟪k:0⟫⟪k:1⟫Listen to me, Madam.⟪k:2⟫⟪k:3⟫He never for a second ⟪k:4⟫actually⟪k:5⟫ loved you."
msgstr "⟪k:0⟫⟪k:1⟫Ascoltami, Madam.⟪k:2⟫⟪k:3⟫Lui non ti ha ⟪k:4⟫mai⟪k:5⟫ amata."

#: scenario3:scenario3_7E310359_F5BE_44B4_AE3C_7F377E807B21
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 5d9e4395228bd416681711f6f21df941efb7122d240d79a5e4bf34ecb6d628d1
#. default-sha256: 82617be669b7588c32324f34f1df8ad000d28b74c4a3e08624fafb753bc95e75
msgctxt "scenario3:scenario3_7E310359_F5BE_44B4_AE3C_7F377E807B21"
msgid ""
"⟪k:0⟫He just wanted the influence attached to your name.⟪k:1⟫⟪k:2⟫Wanted to mingle with the upper "
"class."
msgstr ""
"⟪k:0⟫Aveva solo bisogno del prestigio garantito dal nome della tua famiglia.⟪k:1⟫⟪k:2⟫Non voleva "
"altro che raggiungere le classi superiori."

#: scenario3:scenario3_5997B74F_8DC7_4A29_B3D7_CE1F29A03E03
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: dd27952d0fb63ade2cf988ab72ba643d8a47ff18e9200508f7807335518afcb6
#. default-sha256: 03a02f0b8181a426757b63f2339a8996bc05a1b6f0158e40e2021a0b87363e5e
msgctxt "scenario3:scenario3_5997B74F_8DC7_4A29_B3D7_CE1F29A03E03"
msgid "⟪k:0⟫He ⟪k:1⟫used⟪k:2⟫ you."
msgstr "⟪k:0⟫Ti ha ⟪k:1⟫usata⟪k:2⟫."

#: scenario3:scenario3_4FE46BE7_958C_4C8C_B141_10A50D9C9847
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: ad1a6628112b849273f7ede3c2545ae6ebbc996990d6d247ccd3be5df053bf77
#. default-sha256: 06233bc2b8d42cf7e98f04133b31de16c71456fe9607fe067f3cbb430625da89
msgctxt "scenario3:scenario3_4FE46BE7_958C_4C8C_B141_10A50D9C9847"
msgid "⟪k:0⟫⟪k:1⟫But last year... ⟪k:2⟫when we went out together..."
msgstr "⟪k:0⟫⟪k:1⟫Ma l’anno scorso... ⟪k:2⟫siamo usciti insieme..."

#: scenario3:scenario3_3AFE7A7E_D651_4FF5_B9AC_78B8BC3B1DFC
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 0d07b060bd23f233e806a549e27d00609967abc2fa23260a31bf1ca617a76ede
#. default-sha256: c37bde532343bba944c4586db6fb5753e68eed3a9fe63d8a36a0d2fed28b51a9
msgctxt "scenario3:scenario3_3AFE7A7E_D651_4FF5_B9AC_78B8BC3B1DFC"
msgid ""
"⟪k:0⟫he gave me the phenakis wheel at the photography shop...⟪k:1⟫⟪k:2⟫He had the owner make it "
"especially for me..."
msgstr ""
"⟪k:0⟫e lui mi ha regalato la ruota al negozio di fotografie...⟪k:1⟫⟪k:2⟫L’aveva fatta creare "
"apposta per me..."

