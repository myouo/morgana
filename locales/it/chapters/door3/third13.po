#: scenario3:scenario3_07C975E2_D356_4E7B_844A_489E8DC63ADD
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: b78ede05fb67c044c8f80700416d840043a5f48f38121f84a824e40d581fb5a2
#. default-sha256: 4ad9b0b42ea001d1e7976bfaa5759e792ba2775a49d2b1e0b537865d044efd80
msgctxt "scenario3:scenario3_07C975E2_D356_4E7B_844A_489E8DC63ADD"
msgid "⟪k:0⟫Where’s your dad?⟪k:1⟫⟪k:2⟫Or are you here alone?"
msgstr "⟪k:0⟫Dov’è tuo padre?⟪k:1⟫⟪k:2⟫Sei qui da solo?"

#: scenario3:scenario3_FB79E208_7D31_47CF_A0DA_ABBDAFA22C4F
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 6f6360f8f5c31276f2ad181dde312af7c6b158ba2aad7e461569cd2cce296d0b
#. default-sha256: 504963e360ddda0834465533a9a728a1d95c463fc601449e77ff75d650795a37
msgctxt "scenario3:scenario3_FB79E208_7D31_47CF_A0DA_ABBDAFA22C4F"
msgid "⟪k:0⟫He... ⟪k:1⟫didn’t even tell me..."
msgstr "⟪k:0⟫Lui... ⟪k:1⟫non me l’ha neppure detto..."

#: scenario3:scenario3_6FE290DD_7AD9_4B2C_A50A_31C5965984F5
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: e9bab3b58774d244690e05cdfdb828a25dc5b812bbb9f38057cb1e7b564fc542
#. default-sha256: d98b5abbbb0b7d2affda7e8c07b85d3833f3a891790f0897e837ba4c87740319
msgctxt "scenario3:scenario3_6FE290DD_7AD9_4B2C_A50A_31C5965984F5"
msgid "⟪k:0⟫Ah..."
msgstr "⟪k:0⟫Ah..."

#: scenario3:scenario3_CDA793AA_8C43_4FEC_9F5D_017005C93182
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 3cd309d378cde46706d0559482d1775fee50e6228907643717c8957b05eaaa27
#. default-sha256: 5afe9c6d51654759c992eaacb930463ad3ba8ad0c6c5bbaefe7f9005fd0a46b1
msgctxt "scenario3:scenario3_CDA793AA_8C43_4FEC_9F5D_017005C93182"
msgid ""
"⟪k:0⟫There’s... ⟪k:1⟫no reason you have to leave town.⟪k:2⟫⟪k:3⟫My old man says the Campanellas "
"have more power."
msgstr ""
"⟪k:0⟫Non c’è motivo... ⟪k:1⟫perché tu lasci la città.⟪k:2⟫⟪k:3⟫Papà dice che i Campanella hanno "
"più potere."

#: scenario3:scenario3_16A96EA9_EC19_443A_9899_DD960278A6BB
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: e333de4517d38d5d9d245f340102dbf4d3ae7fddf243c6cc86467b918426f03e
#. default-sha256: c5cf39b5391f1e6e65661be3cb168c5fabb27013b0fb53d1a3f060c7c5e5f2ca
msgctxt "scenario3:scenario3_16A96EA9_EC19_443A_9899_DD960278A6BB"
msgid "⟪k:0⟫I should be the one leaving."
msgstr "⟪k:0⟫Dovrei essere io a dovermene andare."

#: scenario3:scenario3_4A434A8E_FC21_45BB_B783_9126F1B071DF
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 18bc49b80d2e69fd0510419ea571e314208e40876e7b519cd04bfe817bd2ca74
#. default-sha256: f8657870523f2305ad811f0d3ef1f0d970b05bfbad0733ce42bf10fea968d4e7
msgctxt "scenario3:scenario3_4A434A8E_FC21_45BB_B783_9126F1B071DF"
msgid ""
"⟪k:0⟫It’s not that simple.⟪k:1⟫Grownups have a lot to consider.⟪k:2⟫⟪k:3⟫So don’t give me that "
"look, Jacopo."
msgstr ""
"⟪k:0⟫Non è così semplice.⟪k:1⟫Gli adulti devono tenere in considerazione tante cose.⟪k:2⟫⟪k:3⟫"
"Quindi non guardarmi così, Jacopo."

#: scenario3:scenario3_ED963991_E6FC_4B9D_8FD8_2632C7573FA6
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: eb6ca7e97341bb7f2c4bf95fedd23c58618283e3198e3c3e2a1479234ab666a9
#. default-sha256: 48f41697b22461c825c2f67ac00db3078091b23a05c42741f58ec0ffc02c435d
msgctxt "scenario3:scenario3_ED963991_E6FC_4B9D_8FD8_2632C7573FA6"
msgid "⟪k:0⟫............"
msgstr "⟪k:0⟫............"

#: scenario3:scenario3_94BEA963_2835_4F52_912F_6D6743EBAE65
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 90e781405bb3f74c5d72f5f413adb3bd780e7e2aba34e11ef48f0de041c5f80d
#. default-sha256: 95513a4aa276a1c81e6c41b2271813ed0f40c45626a2704d45819a5a5495f742
msgctxt "scenario3:scenario3_94BEA963_2835_4F52_912F_6D6743EBAE65"
msgid ""
"⟪k:0⟫We were kids, but we’d both kinda started to catch on—⟪k:1⟫⟪k:2⟫to the situation with our "
"families, and to the bonds that land held on us."
msgstr ""
"⟪k:0⟫Eravamo bambini, ma avevamo iniziato entrambi a renderci conto della situazione delle nostre "
"famiglie, e di cosa ci vincolasse a quella terra."

#: scenario3:scenario3_B0E1009B_E596_43B6_8C25_F53242CA2929
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 828b8737dd015d4c44a918b1d25e32ee7f884422f024ca7b7904909fed3638b8
#. default-sha256: f102900e219416a9769539fd45bd590979835d18df947bbe6a536aa31ea352df
msgctxt "scenario3:scenario3_B0E1009B_E596_43B6_8C25_F53242CA2929"
msgid "⟪k:0⟫Although we didn’t know any of the details at the time."
msgstr "⟪k:0⟫Anche se all’epoca non conoscevamo i dettagli."

#: scenario3:scenario3_420E9C01_B49E_4D3D_9484_B9EB1E8426BC
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: a0bdb82cf6df090779eac72339ef9a53ab4c3156b0291853333ee630ec91f4b0
#. default-sha256: ae0814b2c1c55f46864aa003e0438a9ce16c3d1ff349e49ccbc44a4aafe9d9be
msgctxt "scenario3:scenario3_420E9C01_B49E_4D3D_9484_B9EB1E8426BC"
msgid ""
"⟪k:0⟫My grandpa owned all the land the city was built on, but he was a very conservative man. "
"⟪k:1⟫He didn’t try to spread his influence, instead opting to fortify what he already had."
msgstr ""
"⟪k:0⟫Mio nonno possedeva tutta la terra su cui era costruita la città,⟪k:1⟫ma era un uomo molto "
"conservatore. ⟪k:2⟫Non cercava di diffondere⟪k:3⟫la propria influenza, piuttosto aveva optato per "
"fortificare ciò che⟪k:4⟫già aveva."

#: scenario3:scenario3_44E5E60F_619F_4783_9AF8_6D59FB70B4CA
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: f03548091480ffb21458eeeade3a0bb7f777e3d31c75d9bd712dc4ee735fd1de
#. default-sha256: 012ad3b4d3c0aba5ac0dc7399a7cab3569e5c7b4e929b9cb5c772f2e945c3005
msgctxt "scenario3:scenario3_44E5E60F_619F_4783_9AF8_6D59FB70B4CA"
msgid ""
"⟪k:0⟫I don’t know exactly when it first started, but organizations were used to administrate "
"cities."
msgstr ""
"⟪k:0⟫Non so con esattezza da quando, ma per amministrare le città venivano usate le "
"organizzazioni."

#: scenario3:scenario3_FE03D2C2_CE9D_49A0_AD09_93D508BD862D
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: c15ed7aa46347c9a8846b7d3ccfc8cf69ff14b715ec01f1530801e1ad63a7bcf
#. default-sha256: 6ecfdbaa66d079d3a6f71418183a705f2fb69c9ef3345237202f4a8baff85ef8
msgctxt "scenario3:scenario3_FE03D2C2_CE9D_49A0_AD09_93D508BD862D"
msgid "⟪k:0⟫And when we were kids, my dad was the capofamiglia, and my grandpa his consigliere."
msgstr ""
"⟪k:0⟫E quando eravamo bambini, mio padre era il capofamiglia,⟪k:1⟫e mio nonno era il suo "
"consigliere."

#: scenario3:scenario3_DE4155A7_D75E_47AA_BA2F_C5237A5D2575
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: c1406ab88a8e10b6cf867c6221dcaae815966817fe6437ac900a3ffd5b2e6c2e
#. default-sha256: d860e729acb21d289586c4ac6656e64ab8139c153766eddab92016a3198ef4e7
msgctxt "scenario3:scenario3_DE4155A7_D75E_47AA_BA2F_C5237A5D2575"
msgid ""
"⟪k:0⟫But just because he was an adviser didn’t mean he was powerless. ⟪k:1⟫While my dad made the "
"decisions, my grandpa was the only one allowed to fight him on them."
msgstr ""
"⟪k:0⟫Ma questo non significa che non avesse alcun potere.⟪k:1⟫⟪k:2⟫Quando mio padre prendeva le "
"decisioni, mio nonno era l’unico che potesse metterle in discussione."

#: scenario3:scenario3_56045517_5319_4499_BB6B_D42414E734FE
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: dc4952bf39e19ac11ff303ef97ea30c5bafd6c1ad01e64f1180786b0f0c5ebff
#. default-sha256: 8dd0c09ce1fca01dfd8177ddc6a4225e11de37b53a33a93ea2e8c33b4d41761d
msgctxt "scenario3:scenario3_56045517_5319_4499_BB6B_D42414E734FE"
msgid ""
"⟪k:0⟫Your father was a capodecina that served under my dad; ⟪k:1⟫he wasn’t especially happy about "
"that."
msgstr ""
"⟪k:0⟫Tuo padre era un caporegime al servizio di mio padre,⟪k:1⟫e non era molto felice di questo."

#: scenario3:scenario3_E92A8C87_218D_41CE_9786_583BDA361FB7
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 9a8c283459a988023fb3d5ca115dbb89022b27364ac27e54745e7fe0cfd63be5
#. default-sha256: c302aec1485a7726b9fd22da6bf997e30c0beac5810f81045c282b92bb8fd328
msgctxt "scenario3:scenario3_E92A8C87_218D_41CE_9786_583BDA361FB7"
msgid ""
"⟪k:0⟫But parents’ quarreling doesn’t affect their kids—⟪k:1⟫⟪k:2⟫or at least, that’s what I "
"thought at the time, and what you probably thought too."
msgstr ""
"⟪k:0⟫Ma i litigi dei genitori non influenzano i loro figli—⟪k:1⟫⟪k:2⟫o almeno,⟪k:3⟫questo è "
"quello che pensavo a quel tempo, e che probabilmente pensavi anche tu."

#: scenario3:scenario3_28B62F9C_A22F_4061_8C74_AF06E01EF4AE
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 8c722cce5ca893e7be25019542dd93772f41d9988094a30a68eeee58029af623
#. default-sha256: 2c6580a17e5620c3c4850b5ec4ea10d774c5ae1e86c944ee3413a1ad86ecd71d
msgctxt "scenario3:scenario3_28B62F9C_A22F_4061_8C74_AF06E01EF4AE"
msgid ""
"⟪k:0⟫But there was still a chance we could be caught in the crossfire, so my dad decided to send "
"me and my mom away."
msgstr ""
"⟪k:0⟫Ma c’era ancora la possibilità di finire coinvolti nel loro fuoco incrociato, così mio padre "
"decise di mandare via me e mia madre."

#: scenario3:scenario3_F203B666_9A02_4FA1_97BC_4021E9442EBC
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: a837df2ef470e806208e64b7a6ccaf160a17aa885ccb00071db4d59db430419b
#. default-sha256: 415596da40e3985998da69339c25cdfd213bc57265efc1bac710910c48ec3ac1
msgctxt "scenario3:scenario3_F203B666_9A02_4FA1_97BC_4021E9442EBC"
msgid "⟪k:0⟫Off the island and to the north were some more prosperous areas."
msgstr "⟪k:0⟫Lontane dall’isola, a nord, verso terre più prospere."

#: scenario3:scenario3_EFB90E92_858C_4A69_8A70_A1F053E3BA3A
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: a53a2ed088040f643ba2c9356244ef066ddbdd52ad6675a277b729f903f1f027
#. default-sha256: 59b2e6d8b6ed628c58a8c31174ea83ddc4afde9f5e27df147fbb7b13efe833c4
msgctxt "scenario3:scenario3_EFB90E92_858C_4A69_8A70_A1F053E3BA3A"
msgid ""
"⟪k:0⟫He thought that by sending us there, we could live our lives clean, regardless of where we "
"came from."
msgstr ""
"⟪k:0⟫Pensava che mandandoci lì, avremmo potuto avere una vita pulita,⟪k:1⟫a prescindere dalla "
"nostra provenienza."

#: scenario3:scenario3_FB5A0103_4072_4CE8_97DE_29C346E2241A
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 4ff400f3cb31f74e89f43674ab491257c3d10e78262ec052fb4d37402c5c9641
#. default-sha256: 7682a993fe457099a7be41d44c7bb7d43a9869293beed7742bbde8749f0f58f7
msgctxt "scenario3:scenario3_FB5A0103_4072_4CE8_97DE_29C346E2241A"
msgid "⟪k:0⟫There’s no changing what’s in your blood, though."
msgstr "⟪k:0⟫Ma non c’è modo di cambiare il proprio sangue."

#: scenario3:scenario3_65B10959_E51A_4BFE_BAD9_71004141E3EF
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 9fb68ae9cb38ee10798f56cc3225d3251c8b1ea5cc21fc47aef1f28593b386c9
#. default-sha256: c45750085b77bbe7c89a2a596895519d7ac02f8b507cb248c9669f4a2cb69fc4
msgctxt "scenario3:scenario3_65B10959_E51A_4BFE_BAD9_71004141E3EF"
msgid ""
"⟪k:0⟫You could have told me too.⟪k:1⟫⟪k:2⟫Or were you planning on leaving without saying anything?"
msgstr ""
"⟪k:0⟫Avresti potuto dirmelo.⟪k:1⟫⟪k:2⟫Oppure avevi intenzione di andartene senza dire niente?"

#: scenario3:scenario3_238D2C70_8B02_445E_A29F_79A27DE018DE
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 81035d95450d75de366ff24c4b49f9e9c17bf814919b216c49572843055407cf
#. default-sha256: 902a7affc694f3d78d6053c41701e2df556803ed7777974335f24b1d62af0de9
msgctxt "scenario3:scenario3_238D2C70_8B02_445E_A29F_79A27DE018DE"
msgid "⟪k:0⟫No, it was just... ⟪k:1⟫all decided so quickly."
msgstr "⟪k:0⟫No, è solo che... ⟪k:1⟫è stato deciso tutto così in fretta."

#: scenario3:scenario3_526F465D_F414_4B7B_BDFB_CBB6009BBC02
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 74c3a08e3c76ed0d3490a7e16ddb95be5ce4cf444864dd1d99fa7e1ce46e47ae
#. default-sha256: 5466ca0668bcf2da19e32b3d8fb8f2a0dc168792543bab3d4d6bd34bdd6ea683
msgctxt "scenario3:scenario3_526F465D_F414_4B7B_BDFB_CBB6009BBC02"
msgid "⟪k:0⟫Why do you sound so accepting?"
msgstr "⟪k:0⟫Perché sembri così rassegnata?"

#: scenario3:scenario3_E46D378D_F8E2_4F01_9878_B209DD6FB66B
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 7c76fd3a1035f94fc7e762f7cbd48fdf0911ada3a3ca2093b1b199ed0ccbfdc1
#. default-sha256: c3711ad279ec0576dfc8be229dc4c37f872426cf898bf01413357eb72c1d7fc9
msgctxt "scenario3:scenario3_E46D378D_F8E2_4F01_9878_B209DD6FB66B"
msgid ""
"⟪k:0⟫Adults have a lot to consider?⟪k:1⟫You bet they do! But you could at least let them know "
"you’re opposed to it, Maria! But no, your tail went straight between your legs as soon as you "
"were told."
msgstr ""
"⟪k:0⟫Gli adulti devono tenere in considerazione tante cose?⟪k:1⟫Questo è ovvio! Ma avresti almeno "
"potuto dirgli che eri contraria!⟪k:2⟫⟪k:3⟫E invece no, sei scappata con la coda tra le gambe non "
"appena l’hai saputo."

#: scenario3:scenario3_DD4238B2_DF1E_4F6E_8239_B8DCDE698AFF
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 26adc817001f59616c06d952eb2884e8d7341538d989a27db93edb7e67c24c3f
#. default-sha256: 5bc7f76d504110f2cf4f610fb8f84613a945c04f688721fe43e7ea6b5cf15979
msgctxt "scenario3:scenario3_DD4238B2_DF1E_4F6E_8239_B8DCDE698AFF"
msgid "⟪k:0⟫You just gave up and accepted it straight away!"
msgstr "⟪k:0⟫Ti sei arresa subito, accettando tutto!"

#: scenario3:scenario3_6ACE91E0_57E9_42AB_A176_501F27BA5E25
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: f7fc024cc3c699406ee2f5e1c9aef1e01a669f170e381973ac33997c5ab475d1
#. default-sha256: 48f41697b22461c825c2f67ac00db3078091b23a05c42741f58ec0ffc02c435d
msgctxt "scenario3:scenario3_6ACE91E0_57E9_42AB_A176_501F27BA5E25"
msgid "⟪k:0⟫............"
msgstr "⟪k:0⟫............"

#: scenario3:scenario3_AA349960_186A_4D99_B875_EEA811D839DC
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 0733c5112d4053ab3c8b030eacfe6005006892950bdbd49a916f8cf5fe72097c
#. default-sha256: 9e4104f3656dca82c18d37c7eea2e817814b65135f1a9602b61c1c0da6554433
msgctxt "scenario3:scenario3_AA349960_186A_4D99_B875_EEA811D839DC"
msgid "⟪k:0⟫I thought you were better than that!"
msgstr "⟪k:0⟫Pensavo fossi meglio di così!"

