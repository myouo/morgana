msgid "⟪k:0⟫Well, well, I’ve turned into quite the cynic, huh."
msgstr "⟪k:0⟫Beh, pare che io sia diventata piuttosto cinica, eh?"

#: scenario3:scenario3_A893CCD9_E92A_46B7_8928_A019DE169A8D
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 9441f18f154ff2ef42a890c5ff9744999a4fce99223b3ebab70f5cb290a37405
