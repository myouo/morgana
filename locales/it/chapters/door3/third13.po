msgid "⟪k:0⟫...What were you planning to do about Nero? Just leave him behind?"
msgstr "⟪k:0⟫...Cos’hai intenzione di fare con lui? Lo lascerai qui?"

#: scenario3:scenario3_9CAF0FCC_B280_47D4_8B2E_5111F418D5CA
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 827567b67af6f800e80ccbebd74bdbe7117a684c1f696c85baf258eb3c606984
