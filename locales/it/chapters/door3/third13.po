msgctxt "scenario3:scenario3_36970D02_8361_4FF3_BD00_DA24A2B438B4"
msgid "⟪k:0⟫Oh, don’t talk about him like that.⟪k:1⟫⟪k:2⟫He’s one of us."
msgstr "⟪k:0⟫Ehi, non parlare male di Nero.⟪k:1⟫⟪k:2⟫⟪k:3⟫È⟪k:4⟫ uno di noi."

#: scenario3:scenario3_002A5ECC_42A9_46D6_9509_AC557355B3E4
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: a88e37fd57b052ad9964b158da32e7e9b2d0d9ca334785840c6b1267d2b7679b
