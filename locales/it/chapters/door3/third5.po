#: scenario3:scenario3_D0C9D982_C558_4D64_9BD3_7C0723FA5CB1
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: f557cdff345d661422eb7d3d4342718b905bc4b64ce124615cc6aa2740b76a0e
#. default-sha256: 452af81d4a0ea7278bb2040a3005fce5cf0b4be6116b6b64e996cd275feca353
msgctxt "scenario3:scenario3_D0C9D982_C558_4D64_9BD3_7C0723FA5CB1"
msgid ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫⟪k:4⟫⟪k:5⟫⟪k:6⟫⟪k:7⟫⟪k:8⟫⟪k:9⟫⟪k:10⟫Bwahahahahahahahah! That’s rich!⟪k:11⟫"
"Amazing! Oh my ⟪k:12⟫god⟪k:13⟫, you scream like a little girl!"
msgstr ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫⟪k:4⟫⟪k:5⟫⟪k:6⟫⟪k:7⟫⟪k:8⟫⟪k:9⟫⟪k:10⟫Muahahahahahahahah! Questa sì che è bella!"
"⟪k:11⟫⟪k:12⟫Oh mio ⟪k:13⟫Dio⟪k:14⟫, fantastico! Urli come una ragazzina!"

#: scenario3:scenario3_D9E3BEA2_4DBA_4189_AB9D_4E90C667BD4E
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 99d55ba39d42211a822f783eca555e8d7bbc6aeadf03a332a1ec7293a89e8f97
