msgctxt "scenario3:scenario3_D165466E_04A8_429A_AC1F_CC190883006D"
msgid "⟪k:0⟫⟪k:1⟫Actin’ tough after the fact just makes you look like twice as much of a wuss."
msgstr "⟪k:0⟫⟪k:1⟫Fare il duro dopo questa ti fa solo sembrare il doppio più cacasotto."

#: scenario3:scenario3_1A9151F1_9AF4_40AE_BE2E_9A023E3EADF0
