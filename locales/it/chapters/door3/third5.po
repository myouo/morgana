msgid "⟪k:0⟫⟪k:1⟫M-⟪k:2⟫Maria, y-⟪k:3⟫you little—!"
msgstr "⟪k:0⟫⟪k:1⟫M-⟪k:2⟫Maria, l-⟪k:3⟫lurida—!"

#: scenario3:scenario3_FA1A1781_60CF_4F37_8D9A_EC0F60D4AF49
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 516f84dd842d00f0345ac994aa7eec2c83e8243759212ed581b097ee26993bda
#. default-sha256: 7af65745fbe7cbebc17203e40f9e7199c0c1e47481739cc316e3908ff40bcb82
msgctxt "scenario3:scenario3_FA1A1781_60CF_4F37_8D9A_EC0F60D4AF49"
msgid ""
"⟪k:0⟫⟪k:1⟫“My god, are you men or ⟪k:2⟫children⟪k:3⟫?⟪k:4⟫⟪k:5⟫This is ⟪k:6⟫my⟪k:7⟫ house, and I "
"would rather you didn’t talk about it like that.”"
msgstr ""
"⟪k:0⟫⟪k:1⟫“Santo cielo, siete uomini o ⟪k:2⟫bambini⟪k:3⟫?⟪k:4⟫⟪k:5⟫Questa è ⟪k:6⟫casa mia⟪k:7⟫, e "
"vorrei che la smetteste di parlarne così.”"

#: scenario3:scenario3_9CF3B6A0_6F14_4E4D_A941_D81DE587C202
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 7489061e9c438cf8f75e642420eb52a1237a463bac177ec4e343ee72a1cc7848
#. default-sha256: 4d50dfe201288e05baf9b0743efad42ac5a57e28a7558bf018459f39da520f84
