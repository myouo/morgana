msgid "⟪k:0⟫⟪k:1⟫⟪k:2⟫Grrrrrrrrrrrr!"
msgstr "⟪k:0⟫⟪k:1⟫⟪k:2⟫Grrrrrrrrrrrr!"

#: scenario3:scenario3_CEB68370_2EDA_4E2D_A469_AD7736DAE434
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: ca2d14412aa3dd48d87ff24b198ae1db2c478ef8a46b9427ce39657aa03181f4
