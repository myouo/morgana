msgctxt "scenario3:scenario3_D1CC945B_1426_486D_A007_7D0E685D60C7"
msgid "⟪k:0⟫As a matter of fact—"
msgstr "⟪k:0⟫E infatti—"

#: scenario3:scenario3_2648BE34_8454_4A6E_A4B9_1544D81DC629
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 8141c365a355afb4b2e67272cd231057f9d1bafda459049d7624cdf1f302ac0a
#. default-sha256: f4136ab13cde43942f4e3b4e470503895bb585d99b0f46a0e4897941e4a12f88
msgctxt "scenario3:scenario3_2648BE34_8454_4A6E_A4B9_1544D81DC629"
msgid "⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫...!"
msgstr "⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫...!"

#: scenario3:scenario3_3FDDECF2_46DB_4622_9B83_A8AD0DCF0D84
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 2d34321166cdc35aa38b01cb33cda839aa74dd905706e7164ccc28d42b15b9b8
#. default-sha256: f696ce5ceeac387f9997365ee8745cbed0b0c9aad64244a1160cd2137339d0b8
msgctxt "scenario3:scenario3_3FDDECF2_46DB_4622_9B83_A8AD0DCF0D84"
msgid "⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫⟪k:4⟫⟪k:5⟫⟪k:6⟫⟪k:7⟫Oh dear.⟪k:8⟫I beg your pardon, Madam."
msgstr "⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫⟪k:4⟫⟪k:5⟫⟪k:6⟫⟪k:7⟫Oh cielo.⟪k:8⟫Vi chiedo perdono, Madam."

#: scenario3:scenario3_B4165425_8A41_45A9_87B1_4540C8B167C8
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 65144353963ad4a00352e118a296286ed8eb2a304872e2bbc035ea85f7621a43
#. default-sha256: f278936ab23fbc32b391747778c70210d9ba53359a16bdcac5237f9cec5d0a33
msgctxt "scenario3:scenario3_B4165425_8A41_45A9_87B1_4540C8B167C8"
msgid "⟪k:0⟫Ah... ⟪k:1⟫it’s fine..."
msgstr "⟪k:0⟫Ah... ⟪k:1⟫va tutto bene..."

#: scenario3:scenario3_9747367B_ECC6_47EA_B0E3_2CB573183AC4
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: d01e2c40939680cf4bb410839f4bd15dd89b9c30a5b9400fd4b9a59797951b38
#. default-sha256: 3acf7281b42b1291c626bd32817df47e58a08b4b954bdc85ecf034c6547875e3
msgctxt "scenario3:scenario3_9747367B_ECC6_47EA_B0E3_2CB573183AC4"
msgid "⟪k:0⟫—one even bumped into her, stifling a laugh as she trotted off."
msgstr "⟪k:0⟫—una delle serve la urtò, trattenendo una risata mentre si allontanava."

#: scenario3:scenario3_CD736832_7BEC_4174_A5C4_33B2132F2C71
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 834431db23992dad6215d68d9c738c5e175cc5e2bbbc6f7af323a1a740773cc6
#. default-sha256: b5ca7b8cb440bdd3e3d36586f0a01181f830d47b62cf3058856c4283a94124ac
msgctxt "scenario3:scenario3_CD736832_7BEC_4174_A5C4_33B2132F2C71"
msgid ""
"⟪k:0⟫In all likelihood, she had done it intentionally. ⟪k:1⟫The poor White-Haired Girl, who had "
"fallen to the floor, stared helplessly at the broken cups."
msgstr ""
"⟪k:0⟫Con ogni probabilità, l’aveva fatto intenzionalmente.⟪k:1⟫⟪k:2⟫La povera Ragazza dai Capelli "
"Bianchi, che era caduta per terra,⟪k:3⟫fissava impotente le tazze rotte."

#: scenario3:scenario3_755AD335_1E15_49D6_A108_2117706A1AC7
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: fe24caef6df89c692575a875937ab1db769aafc5a4ce8d241802d3796cc94e28
#. default-sha256: 05e97a08a036d821beeb2fe2a815892b1d853b3e2bf52f2b8d740f94fae263f1
msgctxt "scenario3:scenario3_755AD335_1E15_49D6_A108_2117706A1AC7"
msgid "⟪k:0⟫The tea she had made for her husband was forming a stain in the carpet."
msgstr "⟪k:0⟫Il tè che aveva preparato per suo marito stava formando una macchia sul tappeto."

#: scenario3:scenario3_D9217328_537E_44AE_A7D1_F2142D1419F2
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 412a2fff972af26dee3745b81b1ec16d5004c98d017cb403ca723dbdc405aede
#. default-sha256: e055ad749a15496fd0357a89c59b2a60e8c60753fce5fd0cfe122456fb711ee4
msgctxt "scenario3:scenario3_D9217328_537E_44AE_A7D1_F2142D1419F2"
msgid "⟪k:0⟫The maids’ behavior toward the mistress of the house was absolutely unacceptable."
msgstr ""
"⟪k:0⟫Il comportamento delle domestiche nei confronti della padrona di casa era assolutamente "
"inaccettabile."

#: scenario3:scenario3_FCE0642B_DBE2_4935_A25D_FAE1492D1023
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: ef6f9985371369ee70f7c424d52eb0c8543e78a82acdba0d93de82f219af5382
#. default-sha256: f195fd575d9591d0601f57fa46316149b419fe9dcbb7f16babf71154c8026c12
msgctxt "scenario3:scenario3_FCE0642B_DBE2_4935_A25D_FAE1492D1023"
msgid ""
"⟪k:0⟫Nonetheless, it was commonplace—⟪k:1⟫⟪k:2⟫⟪k:3⟫all because of the way Jacopo treated her."
msgstr ""
"⟪k:0⟫Ciò nonostante, era la normalità—⟪k:1⟫⟪k:2⟫⟪k:3⟫tutto a causa del modo in cui Jacopo la "
"trattava."

#: scenario3:scenario3_D68D42FA_CF32_457E_9CB5_30FBC93EEFC8
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 113e1731867a6e127bf7f2895ad4d3b293f6a6ad5cf32e0a1f7adf90f839a017
#. default-sha256: df135352ce601efa1e0d62e94802cceaaeb441b2c43a4a2b9739bec9c2ce8756
msgctxt "scenario3:scenario3_D68D42FA_CF32_457E_9CB5_30FBC93EEFC8"
msgid ""
"⟪k:0⟫The more the man of the house acted cruel to her,⟪k:1⟫the less weight her position as his "
"wife held to the servants."
msgstr ""
"⟪k:0⟫Più lui si comportava in maniera crudele con lei, meno importanza aveva per i servitori la "
"sua posizione in quanto sua moglie."

#: scenario3:scenario3_1855FFDE_01E4_46FF_B383_E9128B81C961
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 725e488797577ae5d5b54a4a886d74dfddee29624c4ac0f7dd63f13c34d9b653
#. default-sha256: dd59eedcc53718da992118474a8b6fbe35b4d06cc7fda5c8ae307ea8acdbe386
msgctxt "scenario3:scenario3_1855FFDE_01E4_46FF_B383_E9128B81C961"
msgid ""
"⟪k:0⟫Day in and day out, the maids worked busily—⟪k:1⟫⟪k:2⟫offered little opportunity for leisure—"
"⟪k:3⟫⟪k:4⟫so they would naturally have accumulated quite a bit of stress."
msgstr ""
"⟪k:0⟫Le domestiche lavoravano ininterrottamente, giorno dopo giorno—⟪k:1⟫⟪k:2⟫avendo ben poche "
"opportunità per rilassarsi—⟪k:3⟫⟪k:4⟫finendo quindi per accumulare un certo stress."

#: scenario3:scenario3_93CD596B_710F_4B6D_A9BE_C45CAFB41920
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 465a284405815ba8bdd1b6193afe0a2f9b7f5a14cf657988eb33ebce0b9a6817
#. default-sha256: 120970c06eb9d9d3748005a71188d38a100e8860c8be89ee4ba2011246c98ee3
msgctxt "scenario3:scenario3_93CD596B_710F_4B6D_A9BE_C45CAFB41920"
msgid "⟪k:0⟫And she became the target for them to let off this steam."
msgstr "⟪k:0⟫E così la donna era diventata il bersaglio della loro frustrazione."

#: scenario3:scenario3_A6A74DB4_B6EB_4691_8E51_D0B71446E496
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 7e30fa6028ee712cedeb7692f9456ca698d9da88fc2544ccca9134c6f4c90433
#. default-sha256: d70403a49d15e80a0aef8e26c602f9bfcf294c26fd45fb5436bfe7b26eaed912
msgctxt "scenario3:scenario3_A6A74DB4_B6EB_4691_8E51_D0B71446E496"
msgid "⟪k:0⟫Not directly, but through a more subdued kind of harassment from the shadows."
msgstr "⟪k:0⟫Non agivano in modo diretto, ma attraverso molestie celate nell’ombra."

#: scenario3:scenario3_C90492EF_7D04_424F_9879_017BF694F1CA
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: f65b95f1d544ee74d9d88458c07240ec52fe41566997dadd8504f1d158163374
#. default-sha256: ef5df734938b8e0ba75c04a1f7bdc9c30142b1fb15827595a35922e5d4a1d8ba
msgctxt "scenario3:scenario3_C90492EF_7D04_424F_9879_017BF694F1CA"
msgid ""
"⟪k:0⟫She must have felt quite miserable. ⟪k:1⟫I imagine she would have been better off as one of "
"the maids."
msgstr ""
"⟪k:0⟫Doveva sentirsi alquanto triste. ⟪k:1⟫Immagino che sarebbe stata meglio se fosse stata una "
"delle domestiche."

#: scenario3:scenario3_FB205E25_E6F8_4865_B3E7_3319368D8FCC
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: a03eb9845830861d2aa4a853c33eaa3095ad169ab8cdc2d515fd8c769a6bf3b6
#. default-sha256: 33d8b0a699e64295a12bf644c54f578611e6d72c886b030a5b97ea1ebffa4806
msgctxt "scenario3:scenario3_FB205E25_E6F8_4865_B3E7_3319368D8FCC"
msgid ""
"⟪k:0⟫On the surface, and in front of others, they showed respect for her as Jacopo’s bride. But "
"behind closed doors, they acted very much the opposite."
msgstr ""
"⟪k:0⟫In superficie, e di fronte agli altri, le donne della casa mostravano rispetto per lei, "
"essendo la sposa di Jacopo. Ma quando non c’era nessuno a guardare, si comportavano in tutt’altro "
"modo."

#: scenario3:scenario3_E95184CC_AC3F_4BCB_A653_912ADADA02DF
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 0de7e44c6d8986949b90a803d54c8d5ab6220aabe0887fbc837207b92eaebd59
#. default-sha256: 01499bf198cca2d750fa830c72a31a592af4727ea7c793f6892ac13a995f876a
msgctxt "scenario3:scenario3_E95184CC_AC3F_4BCB_A653_912ADADA02DF"
msgid ""
"⟪k:0⟫The disparity between the treatment she received around others—⟪k:1⟫⟪k:2⟫the treatment she "
"was ⟪k:3⟫supposed⟪k:4⟫ to receive at all times—⟪k:5⟫⟪k:6⟫and the way she was actually treated "
"made the abuse that much worse."
msgstr ""
"⟪k:0⟫Il divario tra il trattamento che la donna riceveva quando c’era gente attorno—⟪k:1⟫⟪k:2⟫"
"quello che ⟪k:3⟫avrebbe dovuto⟪k:4⟫ ricevere in ogni momento—⟪k:5⟫⟪k:6⟫⟪k:7⟫e quello che subiva "
"realmente, rendevano l’umiliazione assai peggiore."

#: scenario3:scenario3_267EE02A_941F_4448_8B47_CA74E017EE6D
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 9c38fb342d2313b1cf397644971bfedd81fd3de0b6f47676e34982a82a998feb
#. default-sha256: 0a0623352227daf48c2cf6dce53be5222a4d7a816c8eed4d0285d4df8e541296
msgctxt "scenario3:scenario3_267EE02A_941F_4448_8B47_CA74E017EE6D"
msgid ""
"⟪k:0⟫And furthermore, as you have seen through the other doors, Master, she was a very reserved "
"young woman."
msgstr ""
"⟪k:0⟫Oltretutto, come ha potuto notare dalle altre porte, Padrone,⟪k:1⟫lei era una ragazza molto "
"riservata."

#: scenario3:scenario3_9BDAD077_9CE6_4C39_8E22_6ABFFEE3ECF1
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: f50b3dc4c6e4183750f78b48fa1d6288fc94dfd4c453e77c73db79fe1d7ec7d8
#. default-sha256: 7d8971a26817eca4cc88e3d883fe13addb75b0d30f7f16288a36b5530f3ddd29
msgctxt "scenario3:scenario3_9BDAD077_9CE6_4C39_8E22_6ABFFEE3ECF1"
msgid "⟪k:0⟫She could neither raise her voice in reprimand nor raise her hand in retaliation."
msgstr ""
"⟪k:0⟫Non riusciva né ad alzare la voce come rimprovero, né ad alzare la mano in segno di "
"ritorsione."

#: scenario3:scenario3_2D2FF13F_3EAF_4424_8601_4E4DA6F69371
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: a1dd0ddae9914ab9684d0bb53cee577b29e4ac490ed0b954f8702757a8cc2c9d
#. default-sha256: 4e5785ede32a700028f37508a0ebd69c731a740144a5947d050c29a3fdef910a
msgctxt "scenario3:scenario3_2D2FF13F_3EAF_4424_8601_4E4DA6F69371"
msgid "⟪k:0⟫I have to get this cleaned up..."
msgstr "⟪k:0⟫Devo dare una pulita..."

#: scenario3:scenario3_01A7312C_4E02_430F_B6A7_45F2AA7F94C5
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 04ab496d75e9b0449e1af899c1f29c5f2c3cf0c84f39893b590001acbac7ab82
#. default-sha256: 43823febf840ffda336706e926d6958c875847ed73145e3219e469505af614bd
msgctxt "scenario3:scenario3_01A7312C_4E02_430F_B6A7_45F2AA7F94C5"
msgid "⟪k:0⟫She extended her spindly fingers toward the shards of shattered porcelain."
msgstr "⟪k:0⟫Tese le dita sottili verso i frammenti di porcellana frantumata."

#: scenario3:scenario3_6C35B0D2_1AEF_4680_A1A4_3B4661C2E547
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: a268e6038c42c56ef54929c49ec5796cd0df369e70f379e80ceb8da825dc3f05
#. default-sha256: d98b5abbbb0b7d2affda7e8c07b85d3833f3a891790f0897e837ba4c87740319
msgctxt "scenario3:scenario3_6C35B0D2_1AEF_4680_A1A4_3B4661C2E547"
msgid "⟪k:0⟫Ah..."
msgstr "⟪k:0⟫Ah..."

#: scenario3:scenario3_A2E96FCC_0E75_4993_989B_921AAAECD7EF
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 7326a31e4ebece57259e7cb17622e286ac57a61734a0b8f961e35f4e59578c3a
#. default-sha256: 83d2c67afad42b773514b7bc3f10f4ba6a455bbea3659915474da57d04f1c1a5
msgctxt "scenario3:scenario3_A2E96FCC_0E75_4993_989B_921AAAECD7EF"
msgid ""
