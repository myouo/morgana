msgctxt "scenario3:scenario3_A43BA456_BD46_45F6_8BFE_E661C62BA29C"
msgid "⟪k:0⟫Considering how you must feel about me, I shouldn’t be surprised."
msgstr "⟪k:0⟫Considerando quello che provi per me, non dovrei essere sorpreso."

#: scenario3:scenario3_9BD2FF15_7620_44A1_A6DC_55C3AA8107EB
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 8ec8d35dc28fd76098e4e1942162b4edbc485cb98ae1de07f996f7e3184be39c
