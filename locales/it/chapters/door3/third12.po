msgid "⟪k:0⟫⟪k:1⟫............"
msgstr "⟪k:0⟫⟪k:1⟫............"

#: scenario3:scenario3_69824517_24CF_4B8E_B072_5694C0E5E948
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 3a7c06420a1a9bbbd9d0f7b9395d40f309248dffb529ce33adb7326d638b31b3
#. default-sha256: 20c0e0b947180f95f4613471b891610853b3b2e63c170f1743df126e3ba45481
msgctxt "scenario3:scenario3_69824517_24CF_4B8E_B072_5694C0E5E948"
msgid ""
"⟪k:0⟫⟪k:1⟫So a couple days back, I didn’t get enough sleep the previous night, right? ⟪k:2⟫I’m "
"helping out in the kitchen, half-awake, plating up some food,"
msgstr ""
"⟪k:0⟫⟪k:1⟫In pratica, qualche notte fa non ho dormito abbastanza.⟪k:2⟫⟪k:3⟫Il giorno dopo stavo "
"dando una mano in cucina, mezza addormentata, impiattando il cibo,"

#: scenario3:scenario3_9E019DB4_7BCC_4D2A_862D_33920693D3EF
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 44b8c3f47a0f3aca0a3aeb33e833e3bcc30684ffb6c7548876634a3c62649414
#. default-sha256: f84716e9f3738128495038aaa28ff2fa4f7a93bdfa6a1056a1afedd8a208d56a
msgctxt "scenario3:scenario3_9E019DB4_7BCC_4D2A_862D_33920693D3EF"
msgid ""
"⟪k:0⟫and when I go to bring it out to the guest, my heart about leaps out of my mouth. Guess why."
msgstr ""
"⟪k:0⟫e quando ho dovuto portarlo agli ospiti, mi è venuto un colpo al cuore.⟪k:1⟫Indovina perché?"

#: scenario3:scenario3_46EBE330_AB6F_4F2A_9199_BB4397AA1818
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: d533c748a3b5e09f675012696ca26a55c5711a5994dd667585159a747c2482ae
