msgctxt "scenario3:scenario3_C36D05BF_1019_4FD0_A1BE_592FC25DA236"
msgid "⟪k:0⟫How... ⟪k:1⟫How did things end up this way?"
msgstr "⟪k:0⟫Come... ⟪k:1⟫Come siamo arrivati a questo?"

#: scenario3:scenario3_B160FB80_A524_4386_B4F3_E09D32BB5AD9
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: c8a98f04fcadecae30481e54a1bce183f6f318a5804b24e46fa99f24f08c3647
