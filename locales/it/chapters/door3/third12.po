msgid "⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫⟪k:4⟫⟪k:5⟫⟪k:6⟫⟪k:7⟫⟪k:8⟫............"
msgstr "⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫⟪k:4⟫⟪k:5⟫⟪k:6⟫⟪k:7⟫⟪k:8⟫............"

#: scenario3:scenario3_7A20BE66_CFB9_4A5D_B338_4CA03B9BF20A
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 0f9cc6cb8da0b3eff754ff312b9bca7d703d9de3e8508aa3b902c96c75123088
