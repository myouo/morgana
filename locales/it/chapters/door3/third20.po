msgid "⟪k:0⟫⟪k:1⟫I... ⟪k:2⟫see.⟪k:3⟫⟪k:4⟫Will you eventually find solace in your riches?"
msgstr "⟪k:0⟫⟪k:1⟫Capisco.⟪k:2⟫⟪k:3⟫Troverà conforto nella sua ricchezza?"

#: scenario3:scenario3_D8E891CE_4403_402C_8E3A_C9B520B6B653
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 5b654fd1589d87609bf4d15e47ef00b296d55c982be55b84bd9bd8c2f6bc53da
