msgstr "⟪k:0⟫⟪k:1⟫............"

#: scenario3:scenario3_F445B127_8D05_47F0_8E03_FF5585D8CFA0
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 137f36b59eacb6603ad436f934defbd0c50a8c2472e96dcf12e1fd1da0ca2b3b
#. default-sha256: 8d66272c9112bc15d1dd01af66654a134ca7a6988272b67ecedbcaf4c936023a
msgctxt "scenario3:scenario3_F445B127_8D05_47F0_8E03_FF5585D8CFA0"
msgid ""
"⟪k:0⟫⟪k:1⟫If you do not put them into words, your feelings will never make it through to anyone."
msgstr "⟪k:0⟫⟪k:1⟫Se non li esprime a parole,⟪k:2⟫i suoi sentimenti non raggiungeranno mai nessuno."

#: scenario3:scenario3_2DB55ED7_BC6A_4C0E_8B54_8EF9ED930FDA
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 9645925fac5a16c86d31597b46dc76bce20bbe407643c1c778b28c5082759a88
#. default-sha256: 0376d7b7d1d4618f13b985365ddd4477ce79c1bf7917db4f9270d5ebc67bdc9c
msgctxt "scenario3:scenario3_2DB55ED7_BC6A_4C0E_8B54_8EF9ED930FDA"
msgid "⟪k:0⟫⟪k:1⟫For unlike money, humans are not measurable by their appearance."
msgstr ""
"⟪k:0⟫⟪k:1⟫Perché a differenza del denaro,⟪k:2⟫gli umani non sono misurabili dalla sola apparenza."

#: scenario3:scenario3_C583503E_768B_4D30_BEFA_A830B585FA44
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: c220c67b5873170092291c5e3312a094590fac1de2dfaa6625a14df012c24655
#. default-sha256: 34bc0d69e9948d9ceafd293064a73cdacb20c5da218a62452bb3e116c8e89175
msgctxt "scenario3:scenario3_C583503E_768B_4D30_BEFA_A830B585FA44"
msgid "⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫⟪k:4⟫He failed to communicate to anyone what he held within his breast."
msgstr "⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫⟪k:4⟫Aveva fallito nel comunicare ciò che il suo cuore provava."

#: scenario3:scenario3_6CEB79CF_4400_4325_9C8E_F68A55F1FC7C
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 09c3152076dcf8797813a594aa1aac99aa85ee0ea230e19dc044431c73b2099e
#. default-sha256: 2ddf0ef1f55779f4cebbdd1d3daf9caa21455fd333138880dbe82221248fc7b4
msgctxt "scenario3:scenario3_6CEB79CF_4400_4325_9C8E_F68A55F1FC7C"
msgid ""
"⟪k:0⟫He was chained down by his place in society,⟪k:1⟫his pride, his relationships, and his own "
"heart."
msgstr ""
"⟪k:0⟫Era incatenato dal suo ruolo nella società,⟪k:1⟫dalle sue relazioni, dal suo orgoglio, e dal "
"suo stesso cuore."

#: scenario3:scenario3_644F5D01_B83A_4ACF_A18A_A9CC372A078B
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 22a5fa0c2fca404d0acd7861dde1806d067c0becfb28a6e81a875f10e325d625
#. default-sha256: 663648d01e9b103d1c4121921fc28458a620a75f158d248aa5fbd7fcba2b692e
msgctxt "scenario3:scenario3_644F5D01_B83A_4ACF_A18A_A9CC372A078B"
msgid ""
"⟪k:0⟫And at some point, he found himself in a position where he was no longer able to speak his "
"mind."
msgstr "⟪k:0⟫E ben presto, arrivò al punto da non essere più in grado di dire quello che pensava."

#: scenario3:scenario3_E2C62720_EB95_4F1A_815E_0940A0F0BF4F
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 3d214a5585775d806c54878a3bbda643e3e587efb88a5ef0d9ede22d8440d13e
#. default-sha256: 7815e8c0472c689e97c604d65217646369a9fe15020a566c2d69a7136210cd7c
msgctxt "scenario3:scenario3_E2C62720_EB95_4F1A_815E_0940A0F0BF4F"
msgid "⟪k:0⟫After enough time, he likely forgot ⟪k:1⟫how⟪k:2⟫ to be genuine at all."
msgstr "⟪k:0⟫Col tempo, dimenticò del tutto ⟪k:1⟫come fare⟪k:2⟫ per essere sincero."

#: scenario3:scenario3_013A8F6E_378F_4BE7_B040_467ED783B8B4
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: e581a722dd49119dcb3731d31f7892f8abb19080725aa6a9cb116abea48b7f11
#. default-sha256: 1c04d4c66500dc8e358dd4d00526facac896454a8f0ffd1e8838597e6d762259
msgctxt "scenario3:scenario3_013A8F6E_378F_4BE7_B040_467ED783B8B4"
msgid "⟪k:0⟫Or perhaps someone like him simply would not,⟪k:1⟫even if they knew how."
msgstr ""
"⟪k:0⟫O forse, uno come lui semplicemente non avrebbe mai potuto esserlo, anche se avesse saputo "
"come fare."

#: scenario3:scenario3_8827CF43_922A_4FB4_BA34_A1243995CC33
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: b66535acb5c4c3cb23d10b21511602111b0498820fa2888b927ca4de2c118eef
#. default-sha256: dad2a587c5cdaebc19af68f6bbe056ec83dd92a9ceaced030225ba39647065b4
msgctxt "scenario3:scenario3_8827CF43_922A_4FB4_BA34_A1243995CC33"
msgid ""
"⟪k:0⟫In any event, there are many things in this world that cannot be communicated without being "
"put into words."
msgstr ""
"⟪k:0⟫In ogni caso, ci sono cose in questo mondo che possono essere comunicate solo attraverso le "
"parole."

#: scenario3:scenario3_EB6F7602_33C3_4CDF_B2EB_BAAE31BDFAC8
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: ddbe4ef429687ac028b1000fe392e19d9e6169fca0ba0c3e96997a19466c34a0
#. default-sha256: 3713eb022f12641214fdfe845c2f04ea2c9fbfa252f21da85ec0a8ec3845f3d0
msgctxt "scenario3:scenario3_EB6F7602_33C3_4CDF_B2EB_BAAE31BDFAC8"
msgid "⟪k:0⟫How sad that his tale should end without him expressing how he truly felt."
msgstr ""
"⟪k:0⟫Com’è triste questa storia—⟪k:1⟫⟪k:2⟫finita senza che lui sia riuscito a far capire cosa "
"provava davvero."

#: scenario3:scenario3_479B4671_C193_4DFB_BFF9_1DCFB80CED03
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 4b9cc6884e321cbcda0d5f045a87388d34f7944b5eab9a3aa6f0df9e193b5675
#. default-sha256: 0de15da18582892b2f1a8521eaac1cc8f6c2439b3c291a02be83371baf6563c5
msgctxt "scenario3:scenario3_479B4671_C193_4DFB_BFF9_1DCFB80CED03"
msgid "⟪k:0⟫How hard it must have been... ⟪k:1⟫to never clear up his misunderstandings."
msgstr ""
"⟪k:0⟫Quanto dev’essere stato difficile...⟪k:1⟫⟪k:2⟫non aver mai potuto chiarire i propri equivoci."

#: scenario3:scenario3_220C8F9A_8DBA_448D_B3E7_7BC0AFD1733B
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 776797ad9174b988955defb29a53720d5191060dd603905ed51aed760fa050c8
#. default-sha256: 9fad54c87f36710abbbd5149a58f3dcd4eefa2f13a8ff72703f3d7140cff3196
msgctxt "scenario3:scenario3_220C8F9A_8DBA_448D_B3E7_7BC0AFD1733B"
msgid ""
"⟪k:0⟫...After Jacopo’s confrontation with Maria, the Pacific Railroad was completed, as scheduled."
msgstr ""
"⟪k:0⟫...Dopo il confronto tra Jacopo e Maria, la Pacific Railroad venne completata come da "
"programma."

#: scenario3:scenario3_11CC5E32_3653_409F_B9CD_6E3246AD83AA
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 22ab028cda0f43b6f7c734c05162fea28b1996d42ea8b974700fc0e18a7d2b24
#. default-sha256: 9c2e531f42616dce45019fa659a66e9f929b3d5952f575df70338046fc9a2358
msgctxt "scenario3:scenario3_11CC5E32_3653_409F_B9CD_6E3246AD83AA"
msgid ""
"⟪k:0⟫Celebratory cheers shook the New World as the last spike was driven into the rails. ⟪k:1⟫"
"Jacopo, however, could not even manage a smile listening to the telegraph."
msgstr ""
"⟪k:0⟫Gli applausi celebrativi scossero il Nuovo Mondo, quando l’ultimo chiodo venne inserito nei "
"binari. ⟪k:1⟫Jacopo, tuttavia, non riuscì a sorridere nemmeno ascoltando il telegrafo."

#: scenario3:scenario3_383C8844_8D4C_4391_8D58_066B56908012
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: bf8f3d6dc228e4fc320a0bd331486461681c38bd5958f4fc37524a87ff19f21c
#. default-sha256: 81f8a8157ed3b2ffa1e19b6bfdc66175bc8c5979b6daa142767c7b05f13abbd5
msgctxt "scenario3:scenario3_383C8844_8D4C_4391_8D58_066B56908012"
msgid ""
"⟪k:0⟫And I am sure you can take a guess as to why. ⟪k:1⟫The people with whom he wished to share "
"that moment were not there."
msgstr ""
"⟪k:0⟫E sono sicura che lei sappia il motivo. ⟪k:1⟫Le persone con cui desiderava condividere quel "
"momento non erano lì con lui."

#: scenario3:scenario3_5224486A_9E1D_47CA_9EF1_AAFEBAFC0F8F
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: a3250b108aa5754ae09b35a86bf30fdeaed1777187a7ad0553a060401b4442e1
#. default-sha256: 59d36fc420edf99e232baabf0d5df356c24e2115eced7b9276888cb59926e90d
msgctxt "scenario3:scenario3_5224486A_9E1D_47CA_9EF1_AAFEBAFC0F8F"
msgid ""
"⟪k:0⟫Shortly following her death, Jacopo held a private funeral for Maria. ⟪k:1⟫Then, he "
"commenced a search for the White-Haired Girl."
msgstr ""
"⟪k:0⟫Poco dopo la sua morte, Jacopo indisse un funerale privato per Maria. ⟪k:1⟫E a quel punto, "
"cominciò a cercare la Ragazza dai Capelli Bianchi."

#: scenario3:scenario3_A1D3D806_78F0_4920_A88A_223A680E8CD4
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 820019974f37fd53ec0c8662cabc2a7e74c0fa9b69646c9092e02429ea89d54a
#. default-sha256: c75392a65387d2d820681d2c7c6686e06fad5036502041f59b447d31854656d6
msgctxt "scenario3:scenario3_A1D3D806_78F0_4920_A88A_223A680E8CD4"
msgid ""
"⟪k:0⟫But he did not do so alone—⟪k:1⟫⟪k:2⟫he hired others to help, did everything in his power to "
"find her, tirelessly searching for many, many years."
msgstr ""
"⟪k:0⟫Ma non era da solo—⟪k:1⟫⟪k:2⟫ingaggiò altre persone per aiutarlo; fece ogni cosa in suo "
"potere pur di trovarla, continuando a cercarla senza tregua per molti, molti anni."

#: scenario3:scenario3_3A5B0260_4BEF_4255_A2A2_1EF512A712D7
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 5d48e7aa24580e029bdd984b677d03ad15f8a4b44af27a76b735a331d1c831dd
#. default-sha256: b3f9fb0768664f21143971ece7e44c2b33e1d89436ac16d7c15d50384c34e3f9
msgctxt "scenario3:scenario3_3A5B0260_4BEF_4255_A2A2_1EF512A712D7"
msgid "⟪k:0⟫However, he never was able to locate her..."
msgstr "⟪k:0⟫Tuttavia, non riuscì mai a localizzarla..."

#: scenario3:scenario3_747019C5_BC7E_41AE_80E0_782A494BD804
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: e275f5c24cd104ee2a1b4f75edfe3f72f9f4b32936e94adba05bed5008bc01a3
#. default-sha256: d908b591d4bb173cedbad7f14ed3b4290b1a834aa906a4921aed846501758913
msgctxt "scenario3:scenario3_747019C5_BC7E_41AE_80E0_782A494BD804"
msgid "⟪k:0⟫and he spent the remainder of his life alone."
msgstr "⟪k:0⟫e trascorse il resto della sua vita da solo."

#: scenario3:scenario3_038F3D17_FFA7_49DC_B250_DAF31C840EC8
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: a5994bcb16abfd38fb59e6c70c3ddb6d11dd40a6fa337fe21adfdbecc53736a0
#. default-sha256: 67f7d583430f1f372abeba0ac45f6ebf4508f3a5cad9aa0129c6d88aff7280c8
msgctxt "scenario3:scenario3_038F3D17_FFA7_49DC_B250_DAF31C840EC8"
msgid ""
"⟪k:0⟫Money. Power. Renown. Servants.⟪k:1⟫⟪k:2⟫The world around him was always quite lively..."
msgstr ""
"⟪k:0⟫Denaro. Potere. Fama. Servitù.⟪k:1⟫⟪k:2⟫Il mondo intorno a lui era sempre molto vivace..."

#: scenario3:scenario3_367A4258_929D_4544_95B4_2DDB91CC1FEA
