#. native-sha256: 2358ca1306eba2382f08526617c57a2caeea8a175c107cfe5eea5316f689fc59
#. default-sha256: 84234e47d9691a029eb90977d889ed7379a17e3186bec9054279ff8739e307e5
msgctxt "scenario3:scenario3_C5F29A22_46C5_419D_8D30_6934DCD89DA4"
msgid ""
"⟪k:0⟫All these fancy furnishings.⟪k:1⟫⟪k:2⟫You ⟪k:3⟫do⟪k:4⟫ know this stuff’s too good for you, "
"right?"
msgstr ""
"⟪k:0⟫E guarda che arredamento alla moda...⟪k:1⟫⟪k:2⟫Tu ⟪k:3⟫sai⟪k:4⟫ che questa roba è troppo per "
"te, vero?"

#: scenario3:scenario3_FDB1C6BD_EE5D_4586_B01F_C97FEA02B2DB
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: f89cd58a9103cc4038ef8eec2c83df4aa0712fd157da804ce845b0d68b3c5983
#. default-sha256: 7f3a2ceb2c45f5c55382b88f3525b77b249f9b12a65b0d1bcaa20228036d6ef4
msgctxt "scenario3:scenario3_FDB1C6BD_EE5D_4586_B01F_C97FEA02B2DB"
msgid "⟪k:0⟫And then me, I get that barren little maid’s room.⟪k:1⟫⟪k:2⟫Drives me up the wall."
msgstr ""
"⟪k:0⟫E poi ci sono io,⟪k:1⟫⟪k:2⟫a cui è toccata quella piccola e spoglia stanza per la servitù."
"⟪k:3⟫⟪k:4⟫Quanto mi fa imbestialire."

