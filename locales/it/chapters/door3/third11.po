msgctxt "scenario3:scenario3_56598359_5762_4D24_92A8_0AE6BDD415E4"
msgid "⟪k:0⟫S-⟪k:1⟫Stop— ⟪k:2⟫⟪k:3⟫Jacopo!"
msgstr "⟪k:0⟫F-⟪k:1⟫Fermo— ⟪k:2⟫⟪k:3⟫Jacopo!"

#: scenario3:scenario3_5430C9E4_D756_4A69_A643_FE060E198187
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: f2ba220c60da14340e76edc5e4144593becfa804dde4781586fde376fad80bbe
#. default-sha256: 91dbc36e139f2b6981a3972e79cabd75d5e45be40920dddef85d6314f9b9c612
msgctxt "scenario3:scenario3_5430C9E4_D756_4A69_A643_FE060E198187"
msgid "⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫⟪k:4⟫⟪k:5⟫⟪k:6⟫You look down on me!⟪k:7⟫You’re nobility!"
msgstr "⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫⟪k:4⟫⟪k:5⟫⟪k:6⟫Mi guardi dall’alto in basso!⟪k:7⟫Tu sei una nobile!"

#: scenario3:scenario3_87A868E5_3CC3_4115_AE67_41BE3A053F59
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
