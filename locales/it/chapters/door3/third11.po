msgid "⟪k:0⟫Is that... ⟪k:1⟫really necessary?"
msgstr "⟪k:0⟫...Era proprio necessario?"

#: scenario3:scenario3_5D7311C3_EBB9_4D79_9679_B329368EC393
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 77bd9a942f98d18315f3c620d302b9ea01b30404a2be8c618d86ba943b31a1fb
