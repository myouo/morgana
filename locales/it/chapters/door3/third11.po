msgid "⟪k:0⟫The garden she had once loved was now a thing of the past."
msgstr "⟪k:0⟫Il giardino che aveva tanto amato apparteneva al passato."

#: scenario3:scenario3_F9362665_BD54_4C0F_B21F_451E3F603195
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 9ea098fb17eca302bee97969e3a2a6b2b0ed78793471674e72a4d8929785fd17
