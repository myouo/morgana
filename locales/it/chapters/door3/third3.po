msgid "⟪k:0⟫⟪k:1⟫The world..."
msgstr "⟪k:0⟫⟪k:1⟫Il mondo...?"

#: scenario3:scenario3_E76E4A67_8AF1_4E9E_B980_C8B65E3584E5
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 88e64d35830a750e75d46b38a0a584068d52c5861d5b6e52dc736979a8bc9e2e
#. default-sha256: 28d3fa77988e2a45a50626e4d32225f1a0903b5d3da80af10552e85139a8146a
msgctxt "scenario3:scenario3_E76E4A67_8AF1_4E9E_B980_C8B65E3584E5"
msgid ""
"⟪k:0⟫⟪k:1⟫Yes, the world. ⟪k:2⟫And to do that, you need neither physical strength nor kindness—"
"⟪k:3⟫⟪k:4⟫but money and influence. ⟪k:5⟫People have no choice but to kneel before those forces."
msgstr ""
"⟪k:0⟫⟪k:1⟫Sì, il mondo. ⟪k:2⟫E per farlo, non si ha bisogno né di forza fisica né di gentilezza—"
"⟪k:3⟫⟪k:4⟫ma di denaro e influenza. ⟪k:5⟫Le persone non hanno altra scelta che inginocchiarsi "
"davanti a chi detiene il potere."

