msgctxt "scenario3:scenario3_9391D42B_4DFD_4122_80A1_D807F73929C4"
msgid "⟪k:0⟫Hurrying back to the carriage, I gave him my deepest thanks."
msgstr "⟪k:0⟫Tornando di corsa al carro, lo ringraziai profondamente."

#: scenario3:scenario3_7060EA44_6486_431E_9BE5_104C6DD809B2
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: c9f5c19053a197c4e1aea560ca4fe71eca26711cc2b597b473d730a9a8e2a339
