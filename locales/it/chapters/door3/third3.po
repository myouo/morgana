msgid "⟪k:0⟫⟪k:1⟫For me?"
msgstr "⟪k:0⟫⟪k:1⟫Per me?"

#: scenario3:scenario3_8CB29845_CC4F_4532_89F0_35C18F363818
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 138808a7cf8e9f6f1be46af8d6d840601474ba0ec1f3d4f2e05ce83fd4388d3d
