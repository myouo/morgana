msgid ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫⟪k:4⟫In that moment, the phenakis wheel became a precious treasure to me."
msgstr ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫⟪k:4⟫In quel momento, il fenachistoscopio diventò per me un tesoro prezioso."

#: scenario3:scenario3_93B41298_3DF4_48A0_8D07_D1426C701A97
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 18ef6fe440014e438601cdb85e35aa27a2434bccb54bfd3ae21bacd967724fa4
#. default-sha256: 555c9a2d9368a4847c76134ae0f1945044ef6256929b7bb7b11d04a2c4a2867c
msgctxt "scenario3:scenario3_93B41298_3DF4_48A0_8D07_D1426C701A97"
msgid "⟪k:0⟫We had only just married days earlier..."
msgstr "⟪k:0⟫Ci eravamo sposati solo pochi giorni prima..."

#: scenario3:scenario3_AC30B3DE_B94F_4D8D_8073_E6BBF6BCDEC7
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 0b1d5828d9d98a747a28a54fd6adebc1bb0a4c97fc2657c50ea0d554086b2b7a
#. default-sha256: d3ec224380da3bd3458b2c371bcd8cea10409a5756334d297d369a4878ccbc1b
msgctxt "scenario3:scenario3_AC30B3DE_B94F_4D8D_8073_E6BBF6BCDEC7"
msgid "⟪k:0⟫and yet, he had commissioned it for me without even knowing what I looked like."
msgstr "⟪k:0⟫eppure, lo aveva commissionato per me senza nemmeno sapere quale fosse il mio aspetto."

#: scenario3:scenario3_B2CFF835_E5E2_4264_878F_C5386AD90A33
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: ca6d127e59d07d6cfd55348e227ba9c17cf19c089c7dd92918146696684d56c0
