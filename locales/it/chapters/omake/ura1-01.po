msgid "⟪k:0⟫⟪k:1⟫............"
msgstr "⟪k:0⟫⟪k:1⟫............"

#: omake:omake_EB141178_93DE_4E33_BC7A_D412F671736F
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 86c2a565eb2c8470049e73daff4cf3a40e41bc6276b2c1b2fde3bcaacfab3281
#. default-sha256: ae4dabe75d5a8a5bc3cb62e4916c1c8b9bb36004b299d4dbaf5a7224ee578cee
msgctxt "omake:omake_EB141178_93DE_4E33_BC7A_D412F671736F"
msgid "⟪k:0⟫⟪k:1⟫Wait, what guest?"
msgstr "⟪k:0⟫⟪k:1⟫Un momento, quale ospite?"

#: omake:omake_8ECB75DE_A59F_4C1D_BB6E_A69FF03B42DB
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 61052e09e6a359814b89365cad76577b49675b6446f03a6a9baf0cc8be6dabf9
#. default-sha256: 3a1f7f5bf58e47c8c6d3898945c50bf2fe5f8319ff7ef5136cee72b64d2b5b46
msgctxt "omake:omake_8ECB75DE_A59F_4C1D_BB6E_A69FF03B42DB"
msgid "⟪k:0⟫⟪k:1⟫⟪k:2⟫Oh, so you can’t see the soul beside me?⟪k:3⟫⟪k:4⟫That’s quite a shame."
msgstr ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫Oh, dunque non siete in grado di vedere l’anima al mio fianco?⟪k:3⟫⟪k:4⟫⟪k:5⟫"
"È⟪k:6⟫ un vero peccato."

#: omake:omake_13AF1031_2797_48CE_9EED_67E0B79A030B
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 882efcb3373e1da06b1ac8f0f4d1d9815269bf65f8d6acaa8d5661b819c764b7
#. default-sha256: 9c0c49561a881f07c1e490c0f95b0fabc564334d80f7b41e1c5db5e201b0f543
msgctxt "omake:omake_13AF1031_2797_48CE_9EED_67E0B79A030B"
msgid ""
"⟪k:0⟫⟪k:1⟫Could they be who was watching over us?⟪k:2⟫⟪k:3⟫I had better give them my thanks, then."
msgstr ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫È⟪k:3⟫ forse la persona che ha vegliato su di noi per tutto questo tempo?⟪k:4⟫⟪k:5⟫"
"Farei meglio a ringraziarla come si deve, allora."

#: omake:omake_E7370332_3116_4855_B56E_38B937D881A9
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 678d34bdf38d6b5af96ea4041d5b5e634daf6e93a675fcc562a43dd764c6627e
#. default-sha256: 21fcc77b080557dfdcd88ec8a22198ddaa82403f632884d74a9fba98d1d19f84
msgctxt "omake:omake_E7370332_3116_4855_B56E_38B937D881A9"
msgid "⟪k:0⟫⟪k:1⟫Go on, Michel! You thank them too!"
msgstr "⟪k:0⟫⟪k:1⟫Avanti, Michel! Ringrazia anche tu!"

#: omake:omake_A43EC56E_9520_4C84_AD32_DAE2241E4ABC
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: d33814d141d1f98bdda19bd595d173330b92cf86cc411085eadf1f264a786f01
#. default-sha256: c0c3978823aeb33b020358fdb65a16dc138628aff397d6721840542fba9a45a4
msgctxt "omake:omake_A43EC56E_9520_4C84_AD32_DAE2241E4ABC"
msgid "⟪k:0⟫⟪k:1⟫...Could you really consider me the protagonist?"
msgstr "⟪k:0⟫⟪k:1⟫...Posso davvero essere considerato io il protagonista?"

#: omake:omake_0535F53B_0B78_4FF4_9665_CF91D0F6BE66
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: c5ff1c3628aaaafcdb622e1704b00b3b887487d6cddc11bfb4335471e15ff19c
#. default-sha256: d8ade61bf2a7594c6f18e7a78830359bd9e84d6cf03ce1cea1d3b3380a7e83b7
msgctxt "omake:omake_0535F53B_0B78_4FF4_9665_CF91D0F6BE66"
msgid "⟪k:0⟫⟪k:1⟫⟪k:2⟫What, did you hit your head and lose your memory again?"
msgstr "⟪k:0⟫⟪k:1⟫⟪k:2⟫Cosa, hai battuto la testa e hai perso nuovamente la memoria?"

#: omake:omake_9843F3CD_5378_4F13_99A0_EB4DB9DFFDAB
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 3e647ddcf4f6820866650a1ed518350ac43169a8b61abf8f57d28b1d98b1e8cc
#. default-sha256: f34f7c4610b9420dfe6f19db623028050817b801e78e11ad88233ead96ec6a98
msgctxt "omake:omake_9843F3CD_5378_4F13_99A0_EB4DB9DFFDAB"
msgid ""
"⟪k:0⟫⟪k:1⟫I can understand that. You didn’t become an active participant in the story until the "
"end of chapter four, Michel."
msgstr ""
"⟪k:0⟫⟪k:1⟫Posso capirlo. Prima della quarta porta non sei mai stato attivamente partecipe alle "
"vicende della storia, Michel."

#: omake:omake_EBB6EEB5_503B_4CCA_A351_CAA54BC41BEC
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: becc85d64ca40667378e1c70f021a2bd50a0c408d5f4935c2c29c0ce9e6ed65f
#. default-sha256: 01f3a981a20befed2187b01eed7c21015e7877e3950dc5bd76ba73e1967f5347
msgctxt "omake:omake_EBB6EEB5_503B_4CCA_A351_CAA54BC41BEC"
msgid "⟪k:0⟫⟪k:1⟫⟪k:2⟫I’m going to bring Michel with me—⟪k:3⟫⟪k:4⟫and only Michel."
msgstr ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫Bando alle ciance, ho un dietro le quinte da mandare avanti,⟪k:3⟫e ho intenzione "
"di portare Michel con me—⟪k:4⟫⟪k:5⟫e solo Michel."

#: omake:omake_FBF76F19_EE33_4711_BED9_9E49CBFF35BD
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 2810cd08f8e5de7944d8a72d3ba52810e6f37e0f01cdd310e33cdb3fb539e06a
