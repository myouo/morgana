msgctxt "omake:omake_FBF76F19_EE33_4711_BED9_9E49CBFF35BD"
msgid "⟪k:0⟫⟪k:1⟫............"
msgstr "⟪k:0⟫⟪k:1⟫............"

#: omake:omake_0D782DCD_1F8E_4EDE_86D5_7FE93BA39787
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 8c5992e43d8712d744f43003c1806151ff0c43654e970f3e894815907b691df7
#. default-sha256: 0b3c0e0525d4dd282af31780c08aec1ea024d3e5bff38253af3d70e8e240fafb
