msgid "⟪k:0⟫⟪k:1⟫⟪k:2⟫Come on, now. Get moving."
msgstr "⟪k:0⟫⟪k:1⟫⟪k:2⟫Su, avanti. Muoviamoci."

#: omake:omake_444DD365_4F93_4FB2_A2FA_261ABF8386AB
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: e0ed03400f0bbef4b52b57f47b560c5595a9efeeb9b70bb100eeacf40c2b0bcd
#. default-sha256: b16b77d60a8bad7313227abc884859a6983e1bb9ff33d7ed02e4556eac8ad696
msgctxt "omake:omake_444DD365_4F93_4FB2_A2FA_261ABF8386AB"
msgid "⟪k:0⟫⟪k:1⟫Ah! I have just the thing!⟪k:2⟫⟪k:3⟫Here. They’re cue cards."
msgstr ""
"⟪k:0⟫⟪k:1⟫Ah! Ho proprio ciò che fa al caso vostro!⟪k:2⟫⟪k:3⟫Ecco, tieni. Sono delle carte "
"profilo."

#: omake:omake_B44799FF_B4C3_4535_BF81_A46E7773DC6B
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: c734a6525bdd294f5f87ea863d4609e5dfd4218a1bceecf34637358f2b074c85
#. default-sha256: 15890830730c71139cea3b2603d40131a058ea93e58bd9bddd67fae8075f93c5
msgctxt "omake:omake_B44799FF_B4C3_4535_BF81_A46E7773DC6B"
msgid "⟪k:0⟫⟪k:1⟫Cue... ⟪k:2⟫cards...?"
msgstr "⟪k:0⟫⟪k:1⟫Carte... ⟪k:2⟫profilo...?"

#: omake:omake_A87D5BDB_8773_4BE5_BF34_E2108986F136
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: fc658c49641c00c0af37a2813c2bbba9cf9b85ac4f7463fe06bcf741057d7f7b
#. default-sha256: b630f9a4e21cd35f576f8ab5a84be0f752e9f9def880d7291189e1013e36a715
msgctxt "omake:omake_A87D5BDB_8773_4BE5_BF34_E2108986F136"
msgid "⟪k:0⟫⟪k:1⟫(I can’t help but feel the creators were screwing with us on some level...)"
msgstr "⟪k:0⟫⟪k:1⟫(Non riesco a fare a meno di pensare che i creatori ci stessero sfottendo...)"

#: omake:omake_AA37F756_B8B6_4FFA_9098_BC7DE35F1956
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 88b43d72dd9806e6dc4248c9e7cc4444010110318223e7707908f1dd46f428b1
#. default-sha256: d96b9a33a850ba1028a12076d8363bebcfa2702832756c8b5d638e2934bd2b76
msgctxt "omake:omake_AA37F756_B8B6_4FFA_9098_BC7DE35F1956"
msgid ""
"⟪k:0⟫I’ll read your profile, Michel.⟪k:1⟫⟪k:2⟫I doubt you’d want to do it yourself, would you?"
msgstr "⟪k:0⟫Leggerò io la tua scheda, Michel.⟪k:1⟫⟪k:2⟫Dubito che tu voglia farlo personalmente..."

#: omake:omake_0B010E48_5948_48F7_8799_61BC8F2C990A
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 4d7504b615d8d51967d874a7adbc824a41ee3d82f34dd747008989856c0fc88a
#. default-sha256: 9708c58e81e65b1688cbffa07d4c7839e5724e93a847005b907ef0c88a311feb
msgctxt "omake:omake_0B010E48_5948_48F7_8799_61BC8F2C990A"
msgid ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫⟪k:4⟫⟪k:5⟫⟪k:6⟫All right, now let’s begin.⟪k:7⟫⟪k:8⟫This pathetic, long-"
"haired man is, believe it or not, the protagonist of ⟪k:9⟫The House in Fata Morgana⟪k:10⟫."
msgstr ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫⟪k:4⟫⟪k:5⟫⟪k:6⟫D’accordo, cominciamo.⟪k:7⟫⟪k:8⟫Questo patetico capellone è—"
"che ci crediate o no—il protagonista di ⟪k:9⟫The House in Fata Morgana⟪k:10⟫."

#: omake:omake_2576ECFB_3A48_4763_918E_642E7E2C1E4E
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 42580ae30c1c70bbeae3c17dd5bc834c538eceaed01009f5fcf39c497a30a259
#. default-sha256: 8687dbe6c3dca53ffbbfc4c424fafbf4edd568b45e17bc1eca593a119552cc3f
msgctxt "omake:omake_2576ECFB_3A48_4763_918E_642E7E2C1E4E"
msgid "⟪k:0⟫⟪k:1⟫See, I ⟪k:2⟫told⟪k:3⟫ you this is how it would go!"
msgstr "⟪k:0⟫⟪k:1⟫Visto? ⟪k:2⟫L’avevo detto⟪k:3⟫ che sarebbe andata così!"

#: omake:omake_18CE4F3C_2FEB_4F17_906F_B13198B468DE
