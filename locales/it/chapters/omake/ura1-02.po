msgid "⟪k:0⟫⟪k:1⟫(Don’t forget about yourself, Morgana...)"
msgstr "⟪k:0⟫⟪k:1⟫(Non dimenticare che ci sei anche tu, Morgana...)"

#: omake:omake_C735FC1D_0557_4962_A5BB_14F11B1C53E0
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 80a45c98eb99dd604ffc8a81f137b97987b551114f54fcd9c841f99ab38332ec
