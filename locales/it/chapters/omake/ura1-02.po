#: omake:omake_FA818BD6_BB3B_4F25_9C0C_5DBC194FFB00
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: f0058329e564f50dc15bd2cfe842c3ab0dc0c79e2b904ad0363a366d8e099528
#. default-sha256: b15499af006bd72056d65db337632a951e9a50eb0a21094f3bb787e31bbdd888
msgctxt "omake:omake_FA818BD6_BB3B_4F25_9C0C_5DBC194FFB00"
msgid "⟪k:0⟫Nor do I really think of myself that way.⟪k:1⟫⟪k:2⟫I’m hardly a paragon of virtue..."
msgstr ""
"⟪k:0⟫Inoltre, non mi vedo affatto in quel modo.⟪k:1⟫⟪k:2⟫Non sono affatto un esempio di virtù..."

#: omake:omake_144794EF_6F90_4486_983B_6646972FE572
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 1d597984e440f99c88d63e756830e1a480b03522617f6239b1b0c24fbb81576f
#. default-sha256: 94acf6c2c23e53b2904297c784bb6f3b41da286d08e759cc4b2eea9ff906ee06
msgctxt "omake:omake_144794EF_6F90_4486_983B_6646972FE572"
msgid ""
"⟪k:0⟫Your circumstances in life forced you to repress yourself, and once you were free from those "
"restrictions in the final chapter, you were able to act as the man you truly are. Or something to "
"that effect."
msgstr ""
"⟪k:0⟫Le circostanze in cui ti trovavi ti avevano costretto a reprimere⟪k:1⟫te stesso, e una volta "
"libero da quelle restrizioni, nel capitolo finale,⟪k:2⟫sei stato in grado di comportarti come "
"l’uomo che sei veramente.⟪k:3⟫⟪k:4⟫O qualcosa del genere."

#: omake:omake_EA304DC3_4096_42AB_8FD6_4ADFDF7BCA8C
