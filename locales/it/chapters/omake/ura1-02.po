msgctxt "omake:omake_7030094C_A4E0_4498_9378_3BA384A3D331"
msgid "⟪k:0⟫⟪k:1⟫Since you’re here, though, how would you like to take a little tour of the house?"
msgstr "⟪k:0⟫⟪k:1⟫Ma visto che sei qui, che ne dici di fare un breve tour della villa?"

#: omake:omake_2574838F_36C7_4107_9AF5_2F7E11A0C43F
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 3a1f1d1f3f9ecf5003328a778201d102559b6e432ace244b72aa0516b6eeece4
#. default-sha256: 177b2839fae80349b8afcf4104c466ff738474dba2d6e72523d4e3c0d7d9a1f7
msgctxt "omake:omake_2574838F_36C7_4107_9AF5_2F7E11A0C43F"
msgid ""
"⟪k:0⟫I don’t know why you’re so excited about split ends...⟪k:1⟫⟪k:2⟫If my hair’s such a mess, "
"maybe I should just cut it all off."
msgstr ""
"⟪k:0⟫Non so cosa ti eccita tanto delle doppie punte...⟪k:1⟫⟪k:2⟫Se i miei capelli sono un "
"disastro, forse dovrei semplicemente tagliarmeli."

#: omake:omake_0C0EE1DB_3843_4E39_AA33_F255BD48212B
