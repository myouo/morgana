#: omake:omake_8F3B5A95_060E_4BAC_972A_F08911B67416
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 005a8c0f2165e5a272c8c8723b10da97cd2e299987565116b9e32f2a11425769
#. default-sha256: ed056890c1b553f0e837aa1a11f2836470b3fa9b16b7f4268a0307f094461a86
msgctxt "omake:omake_8F3B5A95_060E_4BAC_972A_F08911B67416"
msgid "⟪k:0⟫⟪k:1⟫The fact that you’re here means you’ve uncovered all the mansion’s mysteries, yes?"
msgstr ""
"⟪k:0⟫⟪k:1⟫Il fatto che tu sia qui significa che hai svelato tutti i misteri di questa villa, "
"giusto?"

#: omake:omake_33DB8421_3078_4DDB_BCC8_CC85C82A31C9
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: fe8ec52c962600547a3cca594dff6d1bf446169746883cc4da08ca67489a91f9
#. default-sha256: c082753739522db63f61d2b1fd95de816457f90eac71b0816859f33f9803aa26
msgctxt "omake:omake_33DB8421_3078_4DDB_BCC8_CC85C82A31C9"
msgid ""
"⟪k:0⟫⟪k:1⟫Hehe... ⟪k:2⟫My congratulations for having the fortitude to endure such a... ⟪k:3⟫grim "
"tale."
msgstr ""
"⟪k:0⟫⟪k:1⟫Hehe... ⟪k:2⟫Congratulazioni per aver avuto la forza d’animo di sopportare una storia "
"così... ⟪k:3⟫triste."

#: omake:omake_D63F2895_E50C_46E2_9865_90EE7DAEF191
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 59a6a738eed193f762dd5c0b6a5558c430a019602df1f3999a6ea6679a248252
#. default-sha256: b010d08c857d2c16ecf2381e925d3e5b33341375dd0cdd48dce2a1a06ea70b4c
msgctxt "omake:omake_D63F2895_E50C_46E2_9865_90EE7DAEF191"
msgid "⟪k:0⟫⟪k:1⟫⟪k:2⟫That is, if you’re willing to take this hand."
msgstr "⟪k:0⟫⟪k:1⟫⟪k:2⟫Sempre se sei disposto a prendere questa mano, s’intende."

#: omake:omake_A617AD89_AEC1_4805_99EF_AA6B38AE5A1E
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: dbae2c029d735681cae03373b8ca4f00676f40215362acc42c5579f89d2e91d9
#. default-sha256: 666746b436f39e0dc5a988cf1dc16506251573d3939385fb10d1ef521529107b
msgctxt "omake:omake_A617AD89_AEC1_4805_99EF_AA6B38AE5A1E"
msgid ""
"⟪k:0⟫⟪k:1⟫That said, I would prefer not to have to guide you around the house all by myself. ⟪k:2⟫"
"Not because I have anything in particular against you, of course."
msgstr ""
"⟪k:0⟫⟪k:1⟫Detto questo, preferirei non doverti guidare in giro per la casa da sola. ⟪k:2⟫Non "
"perché abbia qualcosa contro di te, ovviamente."

#: omake:omake_DA265B35_DB52_473A_9DE9_B33FBA039094
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 06f57dc98157e606ab4a7a8b7019eb61f1e2be8611d42e83e92ce115af91871b
#. default-sha256: 19ced6a852a6bf4ce453045cda7878a014192bf915dd285c0e63980efd5ca7e4
msgctxt "omake:omake_DA265B35_DB52_473A_9DE9_B33FBA039094"
msgid ""
"⟪k:0⟫⟪k:1⟫I simply think it would be inappropriate for him not to accompany us—⟪k:2⟫yes, him. "
"This story’s protagonist."
msgstr ""
"⟪k:0⟫⟪k:1⟫Penso soltanto che sarebbe inappropriato per lui⟪k:2⟫non accompagnarci—⟪k:3⟫sì, lui. "
"⟪k:4⟫Il protagonista di questa storia."

#: omake:omake_0794DE9D_FE35_4A86_8F75_5AD32CE22656
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 0826d55951ff874a3ca1f840a8dc94d8e0932d0dbf2c833e2a3d52bd6e20d918
#. default-sha256: d2bd7a6b1ec52e0c209f608b5fd2f81c6f1c09e284265edd9fe9265d975fd22e
msgctxt "omake:omake_0794DE9D_FE35_4A86_8F75_5AD32CE22656"
msgid ""
"⟪k:0⟫⟪k:1⟫D-⟪k:2⟫Don’t worry! When I was in her position, I closed my eyes and plugged my ears "
"when you were doing your business!"
msgstr ""
"⟪k:0⟫⟪k:1⟫N-⟪k:2⟫Non preoccuparti, Michel! Quando ero al posto suo mi tappavo occhi e orecchie "
"ogni volta che andavi a fare i tuoi bisogni!"

#: omake:omake_C86A283F_EF5F_4910_9E27_FEEE835E9822
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: a07f8d70bacb230f96f31ba213f3519a0ccbff14187933d7edc2ce067a11e205
#. default-sha256: 5d20cfdb16494ba79cebd86499ca88c7bc3c13a419af9658b13606d33eb18c78
msgctxt "omake:omake_C86A283F_EF5F_4910_9E27_FEEE835E9822"
msgid "⟪k:0⟫⟪k:1⟫⟪k:2⟫In some ways, you could call the first four chapters an extended prologue."
msgstr ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫In un certo senso, le prime quattro porte potrebbero essere considerate un prologo "
"esteso."

#: omake:omake_04EFEC16_E072_4AAB_8F7F_27F92146FDB2
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 34adf381164c084b4c836af0fa43122b920852f87af3ac4541c2493c5e2d2083
#. default-sha256: ae1d1cf3a7e818b5221e8f10269a16df55aa26031d42f33871dd46901099e538
msgctxt "omake:omake_04EFEC16_E072_4AAB_8F7F_27F92146FDB2"
msgid "⟪k:0⟫⟪k:1⟫Aww! What about me?!"
msgstr "⟪k:0⟫⟪k:1⟫Ohh, uffa! E io?!"

#: omake:omake_FAE92C38_A7AE_47BC_988B_8D0A204B48A5
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 4ac6a7393165507a4a0bb0656f1cb24e8dfd9ed46e598b26c517f08f261d01b6
#. default-sha256: b692521b75dcf7f15caf62857004958772b34983297ca03f2ae77f0fd658b77c
msgctxt "omake:omake_FAE92C38_A7AE_47BC_988B_8D0A204B48A5"
msgid ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫Because with you around, he turns into a lovesick, airheaded dope. ⟪k:3⟫He’s about "
"as useful to me as a wet paper sack full of potatoes."
msgstr ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫Se venissi con noi si comporterebbe da fidanzatino rammollito.⟪k:3⟫⟪k:4⟫Mi sarebbe "
"utile quanto un sacco di patate."

#: omake:omake_01DFD587_996F_4535_AD66_8069416148E1
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 3229986f1de6dd519c88fd3130b64196e5b53b2636c88da9222d0a146f7e4d0f
#. default-sha256: 673d94174a53955394dc81d57dc1d65edb694edd56e6fea03ed653b30c5784c4
msgctxt "omake:omake_01DFD587_996F_4535_AD66_8069416148E1"
msgid "⟪k:0⟫⟪k:1⟫⟪k:2⟫Absolutely not.⟪k:3⟫⟪k:4⟫You spoil him—⟪k:5⟫⟪k:6⟫in more ways than one."
msgstr "⟪k:0⟫⟪k:1⟫⟪k:2⟫Assolutamente.⟪k:3⟫⟪k:4⟫Tu lo coccoli troppo."

#: omake:omake_00458DC6_24DD_49A1_9A44_7913F792FA41
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 3363485548e5500f79b3d1c87b3a3b4990e83b09e23e6c42f5456dc41c22d037
#. default-sha256: 1729a3ae9a1f7db35e498150c6096f42235cfd08597c2d4a64fd9fff58e4cacb
msgctxt "omake:omake_00458DC6_24DD_49A1_9A44_7913F792FA41"
msgid "⟪k:0⟫⟪k:1⟫What are we going to do, though?"
msgstr "⟪k:0⟫⟪k:1⟫Cosa andiamo a fare, comunque?"

#: omake:omake_0A87396A_6CA3_4EBB_A1DC_2E718908DE9B
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 82ac9fb879dba86e0c747aed8f161da3dca88e7c0cff0f16b83d65afabd26009
#. default-sha256: 4261a4c95fb4839c9493bb3a88ba0c6d825ca1b5b6e97305179d34a8d50ecfd2
msgctxt "omake:omake_0A87396A_6CA3_4EBB_A1DC_2E718908DE9B"
msgid ""
"⟪k:0⟫⟪k:1⟫I seem to recall plenty of faffing about in the main game anyway;⟪k:2⟫⟪k:3⟫⟪k:4⟫why "
"don’t we do something we ⟪k:5⟫couldn’t⟪k:6⟫ do there?"
msgstr ""
"⟪k:0⟫⟪k:1⟫Mi sembra di ricordare che abbiamo “bighellonato” fin troppo nel gioco principale, ad "
"ogni modo;⟪k:2⟫⟪k:3⟫ perché non facciamo qualcosa che⟪k:4⟫⟪k:5⟫non⟪k:6⟫ potevamo fare lì?"

#: omake:omake_3270FD07_2CA5_4EB1_A3EC_A58FAF8F9135
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: f846c36eb7d27504f5cff51549fa238cba4450b8e127c489d9ce67ce2bb7aa10
#. default-sha256: 91a5931e53e6475184b28819165736abd21e4c3ff08ff6b38700909764045b4d
msgctxt "omake:omake_3270FD07_2CA5_4EB1_A3EC_A58FAF8F9135"
msgid ""
"⟪k:0⟫⟪k:1⟫They’ve got profiles and other miscellaneous notes from the creators about each of the "
"characters. ⟪k:2⟫I thought they might come in handy."
msgstr ""
"⟪k:0⟫⟪k:1⟫Sono delle schede su cui gli autori hanno annotato varie informazioni sui personaggi "
"del gioco. ⟪k:2⟫Ho pensato che potessero esservi d’aiuto."

#: omake:omake_D9720B49_BE4B_4233_AD85_F5EE3AB8852A
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: d3b5078a3c4ec2482d8d28c0b3a1d3725ac91fd5802f6e7c5a0a3b0b1e2aaa3d
#. default-sha256: 62e7eaab9033b79a91e9901c5c9c4fb9d239cc07b0ef741a2f1059d05c6e074a
msgctxt "omake:omake_D9720B49_BE4B_4233_AD85_F5EE3AB8852A"
msgid ""
"⟪k:0⟫⟪k:1⟫I can see them being useful, yes...⟪k:2⟫⟪k:3⟫but why exactly do you ⟪k:4⟫have⟪k:5⟫ "
"those?"
msgstr "⟪k:0⟫⟪k:1⟫Potrebbero esserci utili, sì...⟪k:2⟫⟪k:3⟫ma come fai ad averle, esattamente?"

#: omake:omake_B908C0B0_A59E_4A40_A466_5B4855F5E803
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: b1bc7b9ca4e8ed2463062b0d70be91c6e3b65aa452339c505df93b76bf83d12c
#. default-sha256: 82ea0124fdab7be59018f341f3aee491aa3a0c4a10b81da7db421f438899bb70
msgctxt "omake:omake_B908C0B0_A59E_4A40_A466_5B4855F5E803"
msgid "⟪k:0⟫⟪k:1⟫(I’d rather pretend those miniaturized ⟪k:2⟫things⟪k:3⟫ were not actually us...)"
msgstr ""
"⟪k:0⟫⟪k:1⟫(Preferirei far finta che quelle... ⟪k:2⟫⟪k:3⟫cose⟪k:4⟫ miniaturizzate non fossimo "
"davvero noi...)"

#: omake:omake_0410FEE1_869D_46D3_9374_1966D808C9F3
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 468831d4c56ab9a80e5335cb6b5366c86943a282ebf3c04fb7b320605f9781a6
#. default-sha256: 253ace5c154471296ba6b3938be050b382dbdfbce6c50864266864457ca61580
msgctxt "omake:omake_0410FEE1_869D_46D3_9374_1966D808C9F3"
msgid "⟪k:0⟫⟪k:1⟫⟪k:2⟫Hand over the cue cards."
msgstr "⟪k:0⟫⟪k:1⟫⟪k:2⟫Su, dammi le carte profilo."

#: omake:omake_523CA8EE_C152_D46E_6915_5E57E7AB78F5
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 1782b5c27e76f9f66d76d41b25019324f398cee651b6f239ba2945b7bb15f93b
#. default-sha256: 79d5022f57c4779ecbf4e7926c381a7ba1411ede7a938a9a2f23d1e2da99de76
msgctxt "omake:omake_523CA8EE_C152_D46E_6915_5E57E7AB78F5"
msgid ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫According to this, two of the creators’ goals for this game were to subvert "
"readers’ expectations and cast new light on old information the farther you progressed through "
"the story."
msgstr ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫Stando a ciò che c’è scritto qui, tra gli obiettivi degli autori per questo gioco "
"c’era quello di sovvertire le aspettative dei lettori, e gettare nuova luce sulle informazioni "
"precedenti man mano che si avanzava⟪k:3⟫con la storia."

#: omake:omake_7B6F174A_D4E5_B493_7D56_89C3D06E0122
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: e074607a5e9f23149ad441b809f5b4a446ce5997205157dc8f9a754066851221
#. default-sha256: db612b7e55e5b4f66edc905837d3d319d3f065281440ea7d7bcc504ea0968fc4
msgctxt "omake:omake_7B6F174A_D4E5_B493_7D56_89C3D06E0122"
msgid ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫Even before the focal point of the game—⟪k:3⟫⟪k:4⟫my story—⟪k:5⟫⟪k:6⟫was revealed, "
"there were examples of lines or events taking on new meaning as each of the first three chapters "
"developed."
msgstr ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫Ancora prima che il punto focale del gioco—⟪k:3⟫⟪k:4⟫la ⟪k:5⟫mia⟪k:6⟫ storia—⟪k:7⟫"
"⟪k:8⟫venisse rivelato, ci sono stati esempi di dialoghi ed eventi che assumevano nuovi "
"significati col progredire delle prime tre porte."

#: omake:omake_4043095C_4868_46C9_9D44_88A2E7235295
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 39b2236128387f1455aea1d57c348339bbf91879d5b7f2c87110053a52bc019b
#. default-sha256: 8e3d93bfcba9e04f9bcdff5d263ecbe3aec93e273541eaf132e4f741ec52ce2d
msgctxt "omake:omake_4043095C_4868_46C9_9D44_88A2E7235295"
msgid ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫The second chapter was pretty crazy too!⟪k:3⟫⟪k:4⟫When we found out about, ⟪k:5⟫"
"uh, ⟪k:6⟫Ukulele, that was it!"
msgstr ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫Anche la seconda porta era una roba pazzesca!⟪k:3⟫⟪k:4⟫Quando abbiamo scoperto la "
"verità su, ⟪k:5⟫ehm... ⟪k:6⟫Ukulele!"

#: omake:omake_FB1C8C58_BDE7_4C25_A96D_8C079BBFE140
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 2b69efa907d323f306c61db3f2168cad5171286db3b5fbff96b43db9e840dab3
#. default-sha256: acdea1dcdfed4a4b00ef06f08f0438c054733b50cdff8203dd19a600dce646c6
msgctxt "omake:omake_FB1C8C58_BDE7_4C25_A96D_8C079BBFE140"
msgid ""
"⟪k:0⟫A-⟪k:1⟫Ahaha.⟪k:2⟫⟪k:3⟫Chapter three was something else too.⟪k:4⟫⟪k:5⟫My impression of "
"Jacopo and Maria had completely turned around by the end."
msgstr ""
"⟪k:0⟫A-⟪k:1⟫Ahaha.⟪k:2⟫⟪k:3⟫Anche la terza porta è stata incredibile.⟪k:4⟫ Le mie impressioni su "
"Jacopo e Maria si erano completamente ribaltate nel finale."

#: omake:omake_54FAF5B0_AB1F_4D4B_8DD6_4EB27BAB9EC3
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 0825a4e8a59bf35028a13b9a18dc0480bee55d76cae8c2c9f5f51bb8bd4c325e
#. default-sha256: 13da3b1d0d1c21e8969ad4fd92faf01d7097daa470e77905bd1ed10fef4016a0
msgctxt "omake:omake_54FAF5B0_AB1F_4D4B_8DD6_4EB27BAB9EC3"
msgid "⟪k:0⟫Piles of human garbage, the three of them."
msgstr "⟪k:0⟫Dei veri rifiuti umani, quei tre..."

#: omake:omake_4A3B06DA_3318_4B85_897A_EFAC99CB3699
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 3b4e10c94b71d3de9a3c2bb589881706dcc86de587a4f6c3fbf039d98d691db9
#. default-sha256: ad5375f1c32d9cfbdd779f0815cfcb1be20a3bf1db5f2934309f8694e4be3422
msgctxt "omake:omake_4A3B06DA_3318_4B85_897A_EFAC99CB3699"
msgid "⟪k:0⟫⟪k:1⟫..................⟪k:2⟫⟪k:3⟫Wha?"
msgstr "⟪k:0⟫⟪k:1⟫..................⟪k:2⟫⟪k:3⟫Cosa?"

#: omake:omake_AF459C50_7428_4E06_B52B_E61DDFA1FC42
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 93facf97f3b3f8149a9fcd4ffde25e922123a74a3d5d69e3d670f84428202d35
#. default-sha256: 979ed6570e93e514a0d974216e52389e8a39d2b5e56c0f93f918e6a3039807d5
msgctxt "omake:omake_AF459C50_7428_4E06_B52B_E61DDFA1FC42"
msgid ""
"⟪k:0⟫⟪k:1⟫I, ⟪k:2⟫um... ⟪k:3⟫wasn’t expecting something so...⟪k:4⟫⟪k:5⟫flattering to come out of "
"your mouth..."
msgstr ""
"⟪k:0⟫⟪k:1⟫Io, ⟪k:2⟫ehm... ⟪k:3⟫non mi aspettavo di sentire qualcosa di tanto...⟪k:4⟫ lusinghiero "
"uscire dalla tua bocca..."

#: omake:omake_015D16D7_B9C9_4D89_A4A6_0559A858ADB1
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: c03973094bc6367329b517a6f2f26c04745fbc0d9d676913d1c0efe56f11bab4
#. default-sha256: 2631a95319b2b7508d7a244d37859641889e882f4b07edef154631d1268473d2
msgctxt "omake:omake_015D16D7_B9C9_4D89_A4A6_0559A858ADB1"
msgid "⟪k:0⟫⟪k:1⟫⟪k:2⟫That’s true.⟪k:3⟫⟪k:4⟫Putting a knife to a woman’s neck isn’t very righteous."
msgstr ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫In effetti.⟪k:3⟫⟪k:4⟫Puntare un coltello al collo di una donna non è propriamente "
"giusto."

#: omake:omake_C5E64966_43BC_4099_8D0D_6DA0BD579942
