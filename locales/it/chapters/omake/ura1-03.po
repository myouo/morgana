#: omake:omake_FC88912E_2931_41A4_92DD_9E4111F94673
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: f05def17b4b41c8ed43e06a367def1746f94c611084504ee1140b3b21d337143
#. default-sha256: 449603c256dc8b31232fe41951e8e5be860f7b3886c02a325009d4202df01cd4
msgctxt "omake:omake_FC88912E_2931_41A4_92DD_9E4111F94673"
msgid "⟪k:0⟫⟪k:1⟫⟪k:2⟫Well, never mind that for now."
msgstr "⟪k:0⟫⟪k:1⟫⟪k:2⟫Beh, lasciamo perdere per adesso."

#: omake:omake_842EAA67_89AC_4204_B51D_994B16A9A5B6
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 5d583d21fca9fb51618322a0e0b9327d8429d2b5367cbc614714f91cdfd806da
#. default-sha256: 2fc4a70d0c7de5ec80c2a8e5ea9368dc7f5ea874b4d2f34f2f61e23104c0fdd8
msgctxt "omake:omake_842EAA67_89AC_4204_B51D_994B16A9A5B6"
msgid ""
"⟪k:0⟫I would ask you what you thought of it,⟪k:1⟫but unfortunately, that is beyond even my powers."
msgstr ""
"⟪k:0⟫Ti chiederei cosa ne pensi, ma sfortunatamente, questo va al di là persino delle mie "
"capacità."

#: omake:omake_F9A09CB9_71D9_41BD_8D28_DFAE4B4D5048
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 01518cf9dc8a55cc6583f7e4fbe62f51de1a58a5e4ae32e360ab2ef811bc6016
#. default-sha256: 61117f535b80f008f88234a188abf55325f1c656317ee74e5b071f8c90afc275
msgctxt "omake:omake_F9A09CB9_71D9_41BD_8D28_DFAE4B4D5048"
msgid "⟪k:0⟫⟪k:1⟫⟪k:2⟫...You’ve got a strong stomach, at least."
msgstr "⟪k:0⟫⟪k:1⟫⟪k:2⟫...Devo dirlo, hai uno stomaco forte."

#: omake:omake_3D14B59C_669A_473A_81E7_82B165B4E507
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: f7389f520c3a02325ca7b02e5ec0fa4b65d7c0a7bbeb2b450042a3d9bcf19b1b
#. default-sha256: 28f9a1dc43f1a0b1142b7035d4ad7d8163f55705bd44b4cda22b71456aab74d1
msgctxt "omake:omake_3D14B59C_669A_473A_81E7_82B165B4E507"
msgid ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫Before we begin our little trek, I would like to emphasize that this is,⟪k:3⟫as "
"the title implies, a look behind the curtains of ⟪k:4⟫The House in Fata Morgana⟪k:5⟫."
msgstr ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫Prima di iniziare il nostro giretto, vorrei sottolineare che questo è uno sguardo "
"dietro le quinte di ⟪k:3⟫The House in Fata Morgana⟪k:4⟫, come il titolo suggerisce."

#: omake:omake_8C0E56DE_602A_2D29_9429_071DD0D4C50A
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 3f06ed8d8247b7d3a7f5e2021f9e9d0e82728e92655a4220258230ad057656eb
#. default-sha256: 6ed86cd49c3869d9112aac821160c8e787ac81ad42d51f0ee4fac7cab5a34a39
msgctxt "omake:omake_8C0E56DE_602A_2D29_9429_071DD0D4C50A"
msgid ""
"⟪k:0⟫⟪k:1⟫But should you choose to continue, I encourage you to do so knowing that what you’re "
"about to read does not in any way respect the tone of the game proper."
msgstr ""
"⟪k:0⟫⟪k:1⟫Ma se scegli di procedere, ti invito a farlo sapendo che ciò che stai per leggere non "
"rispecchia in alcun modo i toni del gioco."

#: omake:omake_5973E007_064C_48B3_A4D6_641D2CD416FC
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 9a1503492af05838ec2c6f5e3538adc3e4af608b1f4a94f1603db1dc69a16724
#. default-sha256: df72e4a7af31e867dfc68d5e68c10f7983134e37d0ef40e36d4c710b75f46b6c
msgctxt "omake:omake_5973E007_064C_48B3_A4D6_641D2CD416FC"
msgid ""
"⟪k:0⟫You’ll be making your way into the heads of the staff themselves,⟪k:1⟫and I promise you—⟪k:2⟫"
"⟪k:3⟫it’s not a pretty sight."
msgstr ""
"⟪k:0⟫Entrerai nella mente dei creatori stessi,⟪k:1⟫⟪k:2⟫e te lo assicuro—⟪k:3⟫⟪k:4⟫non è un bello "
"spettacolo."

#: omake:omake_8A3E8667_5714_4479_945B_89A82141E83A
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 1fc33436aaedbda9e33a0a1a026b14f56124f9725dbe0f14ca2547c4f60536ef
#. default-sha256: 97a35e57bccf2479fa1b7f05e597ed6d9781af911fe5af29e3aa81ef172dc353
msgctxt "omake:omake_8A3E8667_5714_4479_945B_89A82141E83A"
msgid "⟪k:0⟫Let us be off, then."
msgstr "⟪k:0⟫Andiamo, allora."

#: omake:omake_0D388061_5E2E_478A_ACF1_CABD30013371
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: bbc257bedb44ad2395bdc922ba2f1c82c120b403dd1397318f5a8081d1c171ed
#. default-sha256: 6f06c6835665468441f4c5a4410eb36e9a2f8bb733417f8ca2a89caaeb2b9ac7
msgctxt "omake:omake_0D388061_5E2E_478A_ACF1_CABD30013371"
msgid ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫⟪k:4⟫⟪k:5⟫⟪k:6⟫Ah! I found another split end!⟪k:7⟫⟪k:8⟫Look, this one’s split "
"into three!"
msgstr ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫⟪k:4⟫⟪k:5⟫⟪k:6⟫Ah! Ho trovato un’altra doppia punta!⟪k:7⟫⟪k:8⟫Guarda, questa "
"è addirittura una tripla punta!"

#: omake:omake_C02C6675_80EB_49E5_9A4B_007813BB63CA
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 825d1d77dafcf867c052e113d03bf72edd8bb3e2e851a6f3fd260307beba2a24
#. default-sha256: fb38733aa37fd21745c3fab30152d2e4053f619fce21841dc09b5981f4dfd9ae
msgctxt "omake:omake_C02C6675_80EB_49E5_9A4B_007813BB63CA"
msgid ""
"⟪k:0⟫I-⟪k:1⟫I— ⟪k:2⟫⟪k:3⟫I didn’t actually mean that!⟪k:4⟫⟪k:5⟫I was just, ⟪k:6⟫you know, ⟪k:7⟫a "
"little overwhelmed at the time!⟪k:8⟫About how unexpectedly handsome you were!⟪k:9⟫But I couldn’t "
"bring myself to say it!"
msgstr ""
"⟪k:0⟫N-⟪k:1⟫Non— ⟪k:2⟫⟪k:3⟫Non dicevo sul serio!⟪k:4⟫⟪k:5⟫⟪k:6⟫È⟪k:7⟫ solo che, ⟪k:8⟫ecco... ⟪k:9⟫"
"ero un po’ scombussolata in quel momento!⟪k:10⟫Ero sorpresa, non pensavo fossi così bello!⟪k:11⟫"
"Ma non avevo il coraggio di dirtelo!"

#: omake:omake_DE51EA4A_A870_40CF_91A4_9D835B779A79
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: c4be2976839684e52eb2b47308ff1d97784ea541554b560319bda2bd44dfa74d
#. default-sha256: ce70813273296c1015153a21ce4a9dfe1f1c85e407dd489bb3ca124a960946e9
msgctxt "omake:omake_DE51EA4A_A870_40CF_91A4_9D835B779A79"
msgid "⟪k:0⟫I hope you two sickening lovebirds spontaneously combust..."
msgstr "⟪k:0⟫Spero che andiate in autocombustione, con le vostre nauseanti smancerie..."

#: omake:omake_7F2F89CD_77AE_4D18_96BE_501ABA446818
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 97f90978a5f87a976867ccdff309050b830f621a5df3bfde09fc6210ba12ed79
#. default-sha256: 5146d54065866a1ba0d4a736250178da4e54b49e3909b3c20c22f8a928563067
msgctxt "omake:omake_7F2F89CD_77AE_4D18_96BE_501ABA446818"
msgid ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫As the true master of this house, I am everywhere at all times.⟪k:3⟫⟪k:4⟫Even in "
"the bathrooms."
msgstr ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫In quanto vera padrona di questa casa, sono ovunque in ogni momento.⟪k:3⟫ Anche in "
"bagno."

#: omake:omake_05A8DDD2_7450_494D_9A7A_1B323EC72C6E
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 72f5064568edd19d3806ec649786dc3a70c3030c6961e2ca165f21f12c72ab52
#. default-sha256: d3b37871ba11a3ba357f008c02d1dabec50a0e232fd899ba9f10d6e20c6aa9a5
msgctxt "omake:omake_05A8DDD2_7450_494D_9A7A_1B323EC72C6E"
msgid ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫I think that’s enough toilet humor for the time being.⟪k:3⟫⟪k:4⟫Especially in "
"front of our guest."
msgstr ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫Basta parlare di bagni, adesso.⟪k:3⟫⟪k:4⟫Specialmente di fronte al nostro ospite."

#: omake:omake_FD6983FC_6500_4BC7_BE9D_0AC6E8F24B4A
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 75c778f4a243b13f12df2bdd502c6f11a378583fc147eebd791b7de82db14b2c
#. default-sha256: 813ea82c3514b58a166106270dcc1676a9af0a0645be842a1a351d887a1edb75
msgctxt "omake:omake_FD6983FC_6500_4BC7_BE9D_0AC6E8F24B4A"
msgid "⟪k:0⟫⟪k:1⟫It just... ⟪k:2⟫never really seemed that way to me..."
msgstr "⟪k:0⟫⟪k:1⟫⟪k:2⟫È⟪k:3⟫ solo che... ⟪k:4⟫non l’ho mai vista in questo modo..."

#: omake:omake_8BA87D65_BDE0_4565_B0AE_E16CA2BF4C6D
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 3e531c449b450801a9f099958ab955c474d281df80a31340955e131735c787f6
#. default-sha256: 6b2dc041d913d97e61cea6b5fad034cab5d3fe213be3c25b08aee98e50182774
msgctxt "omake:omake_8BA87D65_BDE0_4565_B0AE_E16CA2BF4C6D"
msgid ""
"⟪k:0⟫⟪k:1⟫But once you reclaimed yourself, you were most definitely playing the protagonist. ⟪k:2⟫"
"Especially the final chapter! You had me swooning by the end!"
msgstr ""
"⟪k:0⟫⟪k:1⟫Ma dopo aver reclamato te stesso, sei diventato a tutti gli effetti⟪k:2⟫il "
"protagonista. ⟪k:3⟫In particolar modo nell’ultima porta!⟪k:4⟫⟪k:5⟫Ero completamente in estasi, "
"alla fine!"

#: omake:omake_48AEFCD0_9BAB_438B_A1E5_5BD013A1151B
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 74cee24b6ba47137d6fd00144bb152b9d3da6508d2d2d408d729e6a000aec22b
#. default-sha256: b24bf0de5c7f36e478fa7b2b9f01b206e00ab87d5424bf40f614bade0e9a3f3f
msgctxt "omake:omake_48AEFCD0_9BAB_438B_A1E5_5BD013A1151B"
msgid ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫What do you think, my dear? ⟪k:3⟫What any respectable behind-the-scenes extra "
"would do, of course—"
msgstr ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫Secondo te? ⟪k:3⟫Ciò che chiunque farebbe in un dietro le quinte che si rispetti, "
"ovviamente—"

#: omake:omake_2A7F3CA3_1134_4621_BF76_8BE0B1176ACB
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 73ee51a98c5ae9ef208527abd06c538c6ab837b958b47fadc1d41a1871f2bd5c
#. default-sha256: c6f93e89d3f51c00cbd38d97d3d774bb48932fc926780fac8b438be85154f720
msgctxt "omake:omake_2A7F3CA3_1134_4621_BF76_8BE0B1176ACB"
msgid "⟪k:0⟫we’re going visit each room in the mansion and faff about like a bunch of fools."
msgstr "⟪k:0⟫andremo a visitare ogni stanza della villa,⟪k:1⟫bigellonando come due idioti."

#: omake:omake_060CE94C_E0AE_47B9_9D2B_6BC0BB35989D
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 2810cd08f8e5de7944d8a72d3ba52810e6f37e0f01cdd310e33cdb3fb539e06a
#. default-sha256: b10d82a68a4d62c3150b0936b91ec0a6453ec8e4e51fd231ecb20cc3c4dfeb9e
msgctxt "omake:omake_060CE94C_E0AE_47B9_9D2B_6BC0BB35989D"
msgid "⟪k:0⟫⟪k:1⟫............"
msgstr "⟪k:0⟫⟪k:1⟫............"

#: omake:omake_DD46117D_9ECB_4B85_BC2C_B5C1D59040E9
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 5e2f412ad675fc5bea199de78fd0c7d33c1706e5968513a0a1ad34e5980fef01
#. default-sha256: d67de74e52c1fbba6a1acd56d8679d270e2c4cc06950ad71e97ba5a3f2316c77
msgctxt "omake:omake_DD46117D_9ECB_4B85_BC2C_B5C1D59040E9"
msgid ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫You can’t deny a lot of readers probably didn’t expect the creepy white-haired "
"recluse to turn out to be the main character."
msgstr ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫Non si può negare che molti lettori non si aspettavano che l’inquetante recluso "
"dai capelli bianchi si sarebbe rivelato essere il personaggio principale."

#: omake:omake_AB7DE4F2_5BDB_46C5_B426_851B3684F16C
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 63c14558f6d19339a293a783268c56dc26e1ba4c52d403fb84ba313f697c65ee
#. default-sha256: f6168dcd4f16612ef3db645d5ea2c59babb1fcf32bd1756dd979619074756f19
msgctxt "omake:omake_AB7DE4F2_5BDB_46C5_B426_851B3684F16C"
msgid ""
"⟪k:0⟫Though perhaps there are some people whose interpretations did not change throughout the "
"course of the tales."
msgstr ""
"⟪k:0⟫Anche se forse ci sono state persone la cui interpretazione non è cambiata procedendo con la "
"lettura."

#: omake:omake_409E38F1_AD87_424A_9225_01F6D09C8F9D
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: d02fc5b048c1b6d9bc6fc443e27a852a3491838f26e6795223b0d35d97d0b3dc
#. default-sha256: c05591fe7aecb9467200f67f9731d7e1638d50417a8089a186659842f555d53e
msgctxt "omake:omake_409E38F1_AD87_424A_9225_01F6D09C8F9D"
msgid "⟪k:0⟫⟪k:1⟫No, that’s not how you pronounce his name.⟪k:2⟫⟪k:3⟫As I recall, it’s Eucalyptus—"
msgstr "⟪k:0⟫⟪k:1⟫No, non è quello il suo nome.⟪k:2⟫⟪k:3⟫Da quel che ricordo, è Eucalipto—"

#: omake:omake_0563CC2F_1F91_4F15_AA9C_CA7CEC8E9CA9
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: e51e04e3e5b6d21c82c81b7dcb993448254697cc8ef362bde1dcca1368a8fd70
#. default-sha256: bae9c2bec05a3dc3bb9c1a6daa7c129456045da6cc095bc7591c21c8baf14854
msgctxt "omake:omake_0563CC2F_1F91_4F15_AA9C_CA7CEC8E9CA9"
msgid ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫You already made that joke. Let it go, please.⟪k:3⟫⟪k:4⟫That creature doesn’t need "
"a name. Just call him “the beast.”"
msgstr ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫L’hai già fatta questa battuta. Smettila, per favore.⟪k:3⟫⟪k:4⟫Quella creatura non "
"ha bisogno di un nome.⟪k:5⟫Chiamiamola semplicemente “la bestia”."

#: omake:omake_E6ED0CF4_EA96_43F7_8609_288EDFB5E6DA
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 2a5c3b60eeab892bcf5dc96eeb8109de3aad5b58a722f9709be10355a1a62cc4
#. default-sha256: cc922c10d0c7dec68e66f5fabbebc8d0220d2d0ece267aa9d0ec78a437147fa9
msgctxt "omake:omake_E6ED0CF4_EA96_43F7_8609_288EDFB5E6DA"
msgid ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫At the end of that chapter, you learn what kind of man he really was, which then "
"ties into the revelations in the final chapter."
msgstr ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫Alla fine di quel capitolo, si scopre che tipo di uomo era veramente,⟪k:3⟫e tutto "
"si ricollega poi alle rivelazioni dell’ultima porta."

#: omake:omake_C5A798EB_B811_4ED8_AFAC_A061A9511D1D
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: c74eec995e795ecc94e0c754a16c21d094c15d962b5e5505047668d20ea50db2
#. default-sha256: 801635a9c4b0c19349b03dced24cd5e56d12b606c0f3b9af33c5d46e0bc6fe1a
msgctxt "omake:omake_C5A798EB_B811_4ED8_AFAC_A061A9511D1D"
msgid "⟪k:0⟫⟪k:1⟫.................."
msgstr "⟪k:0⟫⟪k:1⟫.................."

#: omake:omake_50B816BD_A179_493D_9A53_C8C56CE248FA
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: f0a7f4fb46b9b3da3ad1aeb42f24dc86fd92dd0c3e7017e58b997baac0c6a089
#. default-sha256: 14d7e3b3c7f4746cd4d39ca72f7dd250ae0cf56a066a1333770e0d85351a172d
msgctxt "omake:omake_50B816BD_A179_493D_9A53_C8C56CE248FA"
msgid "⟪k:0⟫I don’t hold it against you, though."
msgstr "⟪k:0⟫Non ce l’ho con te, comunque."

#: omake:omake_6F5B9841_CFC1_491F_A9B2_FBB2DF203B6D
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: ba449d91ae6bf686705116dbf98862ff47fdcf933043902885edf45e9775a7aa
#. default-sha256: b10d82a68a4d62c3150b0936b91ec0a6453ec8e4e51fd231ecb20cc3c4dfeb9e
msgctxt "omake:omake_6F5B9841_CFC1_491F_A9B2_FBB2DF203B6D"
msgid "⟪k:0⟫⟪k:1⟫............"
msgstr "⟪k:0⟫⟪k:1⟫............"

#: omake:omake_0A72F11A_330D_41F5_9178_3472164D57AD
