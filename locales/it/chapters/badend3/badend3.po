#: badend3:badend3_C70F299F_DA84_4B00_9E9E_EDA04274BA9A
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 08529ecaa54908091d7c0f06e9e0a55883954ee46b12337d88d8580f5b2b4db9
#. default-sha256: a57cb83544647e9eba36f6ae33d51adaa881d9f1718d84e25e01584dab6031d3
msgctxt "badend3:badend3_C70F299F_DA84_4B00_9E9E_EDA04274BA9A"
msgid ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫⟪k:4⟫⟪k:5⟫⟪k:6⟫⟪k:7⟫⟪k:8⟫⟪k:9⟫⟪k:10⟫⟪k:11⟫⟪k:12⟫⟪k:13⟫⟪k:14⟫⟪k:15⟫⟪k:16⟫I "
"can’t force her to do something she doesn’t want to."
msgstr ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫⟪k:4⟫⟪k:5⟫⟪k:6⟫⟪k:7⟫⟪k:8⟫⟪k:9⟫⟪k:10⟫⟪k:11⟫⟪k:12⟫⟪k:13⟫⟪k:14⟫⟪k:15⟫⟪k:16⟫Non "
"posso costringerla a fare qualcosa che non vuole."

#: badend3:badend3_74F825C4_270A_4F90_9221_8B5CA412E57C
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 8d97b9f192155f773f274861688742c31fdd56fe7a202096133a55bb8312e048
#. default-sha256: 6d9648c40c3b3dcfc1a64613f00b444ad3b7d6796efbd86dd48f0153ab3517f7
msgctxt "badend3:badend3_74F825C4_270A_4F90_9221_8B5CA412E57C"
msgid ""
"⟪k:0⟫If she doesn’t reclaim herself on her own... ⟪k:1⟫I’ll never get to hear her say my name "
"again..."
msgstr ""
"⟪k:0⟫Se non reclamerà se stessa da sola...⟪k:1⟫ non la sentirò mai più pronunciare il mio nome..."

#: badend3:badend3_547360EE_32D4_4534_8ED5_5D740F96586D
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: cccb450562ff7325e2ccfe671662e849d7f80e3f185e74fe4ff754a0ca093aa5
#. default-sha256: 6f6ced4c58f8b61c12018e1459e02880955e6abc5a31ed1cf0ae0f6de4688a57
msgctxt "badend3:badend3_547360EE_32D4_4534_8ED5_5D740F96586D"
msgid ""
"⟪k:0⟫But if she wants to leave all that behind her... ⟪k:1⟫then it’s not my place to interfere."
msgstr "⟪k:0⟫Ma se vuole lasciarsi tutto alle spalle... ⟪k:1⟫allora non posso interferire."

#: badend3:badend3_547360EE_32D4_4534_8ED5_5D740F96686D
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 5f1cd69064a9bb1315c79b8f8bdd0e3c53808d6c7d0fe0eed072c36bc187cfec
#. default-sha256: 2a8a18f5fce37d85f02ec292c97c93b408e2f0cc7b6c24661682503559900739
msgctxt "badend3:badend3_547360EE_32D4_4534_8ED5_5D740F96686D"
msgid ""
"⟪k:0⟫I’ve done things that would warrant her wanting to rewrite her past, erasing me entirely."
msgstr ""
"⟪k:0⟫Ho fatto cose che giustificherebbero la sua decisione di riscrivere⟪k:1⟫il proprio passato, "
"e di cancellarmi per sempre."

#: badend3:badend3_14501C98_A043_4232_9EFD_BCFC5DCC400A
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: c9e6cb29d5847f8c6d6978be52be5a57e76e2ab739297abe623957d192532e77
#. default-sha256: e7310e4672616563a3b275eb5643f3cd0838fe6e5ad547e9cd154390a71ace52
msgctxt "badend3:badend3_14501C98_A043_4232_9EFD_BCFC5DCC400A"
msgid "⟪k:0⟫But I think, more than anything..."
msgstr "⟪k:0⟫Ma credo che, più di ogni altra cosa..."

#: badend3:badend3_71304866_D2C8_406C_A8AF_B269483EF474
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: b94bb30bbf6b32eb11c755d8f60912a1c69331307fe1de1cd926ee4c11392e2b
#. default-sha256: 57ec500eab8fc9759fb7f1a95c8936c754bb62da31a096a9b67029d30c7ddd4b
msgctxt "badend3:badend3_71304866_D2C8_406C_A8AF_B269483EF474"
msgid "⟪k:0⟫I’m afraid of hurting her, of breaking her any more than she already is."
msgstr "⟪k:0⟫io abbia paura di ferirla ancora più di quanto non abbia già fatto."

#: badend3:badend3_202FBE8C_5025_42D3_AB14_844F51FDD442
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 39c0e93329f60a83b73e46ee3edd9cee836203fc6af66970bef729a512d7ea0c
#. default-sha256: 1c812955ab9bac78e3a90e06d812791e1961c834f796f1436b7f9a497f0f3238
msgctxt "badend3:badend3_202FBE8C_5025_42D3_AB14_844F51FDD442"
msgid "⟪k:0⟫⟪k:1⟫⟪k:2⟫............"
msgstr "⟪k:0⟫⟪k:1⟫⟪k:2⟫............"

#: badend3:badend3_63F96811_C8E8_4907_87B9_416FA37B0D60
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: ca2eba0334d7dc11e7f75da45294807211dd65f529344a0975738a7d428086bf
#. default-sha256: 73199f5a328755fe708b2c8ad985c0f6b0f4600f67651753f1fb29170a6a440f
msgctxt "badend3:badend3_63F96811_C8E8_4907_87B9_416FA37B0D60"
msgid ""
"⟪k:0⟫No, mine is a more cowardly fear.⟪k:1⟫⟪k:2⟫I’m just afraid she’ll no longer take my hand."
msgstr ""
"⟪k:0⟫No, la mia è una paura persino più vile.⟪k:1⟫⟪k:2⟫Ho paura... ⟪k:3⟫che non prenderà mai più "
"la mia mano."

#: badend3:badend3_9B32C9AE_4431_40EB_8BDD_4E5E2BDCC447
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: d19f17085b2abda7733c3a0d812d86f68f29d0d817ef5657e14ecde05c095e07
#. default-sha256: 38ad13e485cffdcd9a5e330c85a45aab285a1b265da7e9cb0de4a1e6f87d0cf2
msgctxt "badend3:badend3_9B32C9AE_4431_40EB_8BDD_4E5E2BDCC447"
msgid "⟪k:0⟫⟪k:1⟫All right... ⟪k:2⟫then..."
msgstr "⟪k:0⟫⟪k:1⟫D’accordo, allora..."

#: badend3:badend3_F984F247_AA15_40B3_9095_233FAF5E052E
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: b4c4d122e24918677cb139bfb382464c343a0b2853acf97983439e021cbb544d
#. default-sha256: f9657bc51dc4743f811f89ef491adcec65bbb3c0257b0607b3d317f095446024
msgctxt "badend3:badend3_F984F247_AA15_40B3_9095_233FAF5E052E"
msgid "⟪k:0⟫What should have been behind the door... ⟪k:1⟫was our life together."
msgstr ""
"⟪k:0⟫Quello che avrebbe dovuto esserci dietro quella porta...⟪k:1⟫era la nostra vita insieme."

#: badend3:badend3_F35D6B1C_3494_447D_A012_22EF8C656B19
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: c8e4272f1d507eed4dd8d4b1fcc750226b8cee4b4862c8bb3a7e9aa1977ced39
#. default-sha256: 1fbdd9ce9fe3a3eff85dba17f13643dae7b2ba8e1fc1d41a171f55ab9c87dbdf
msgctxt "badend3:badend3_F35D6B1C_3494_447D_A012_22EF8C656B19"
msgid ""
"⟪k:0⟫But for her, there’s nothing but misery there anymore.⟪k:1⟫⟪k:2⟫In our time together, and in "
"me."
msgstr ""
"⟪k:0⟫Ma ormai, per lei non c’è nient’altro che sofferenza lì.⟪k:1⟫⟪k:2⟫Nella nostra vita insieme,"
"⟪k:3⟫ e in me."

#: badend3:badend3_B135271A_95CE_45F0_A7ED_3B803136CB56
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 6a372943bcdea63a7415b72bf88981cc47ef5933c23ed9d2957849796407e13f
#. default-sha256: b9e500fcbf956bdcb570600451355534fc32626149c6eafc70dca31534b74f71
msgctxt "badend3:badend3_B135271A_95CE_45F0_A7ED_3B803136CB56"
msgid ""
"⟪k:0⟫Forget everything I’ve said.⟪k:1⟫⟪k:2⟫The tale within the fourth door was the whole truth."
msgstr ""
"⟪k:0⟫Dimentica tutto ciò che ho detto.⟪k:1⟫⟪k:2⟫Il racconto della quarta porta era tutto vero."

#: badend3:badend3_A6302219_4360_40D0_9A8C_5619F188455C
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: c69389873ccf7dda32075c9208ad058aed3251ca3c81c05833155b6e15ea2e1c
#. default-sha256: 33045fee5eb29e210a806906242b7243a981705570cfaf8f6dccc6e444654215
msgctxt "badend3:badend3_A6302219_4360_40D0_9A8C_5619F188455C"
msgid "⟪k:0⟫I can live with that."
msgstr "⟪k:0⟫Me ne farò una ragione."

#: badend3:badend3_FAF57415_6FEA_4EBA_83E5_5340DBE4ADA7
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 57db94a85badfb5b1f2df7e2478eb679be6ca44aef2976c59239381936ab4729
#. default-sha256: 6eba272befa0746d5e17298f73b93018dff10f0bac17d1ec97be3828a1c9c62d
