msgid "⟪k:0⟫⟪k:1⟫....................."
msgstr "⟪k:0⟫⟪k:1⟫....................."

#: badend3:badend3_F205E639_DF0B_4F13_BC4F_A7D8A77FE9A0
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 1e0c14fe1a1ce051ba9e4590d416b280d7216d838d6985ab28bb55acb5d26e22
#. default-sha256: de3b1635f1a294aa4fa849bf56dc4d108ece22362defdd5bd0d0360a015ab13e
msgctxt "badend3:badend3_F205E639_DF0B_4F13_BC4F_A7D8A77FE9A0"
msgid ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫I would just ask you to allow me one thing...⟪k:3⟫⟪k:4⟫To remain by your side."
msgstr "⟪k:0⟫⟪k:1⟫⟪k:2⟫Ti chiedo soltanto una cosa...⟪k:3⟫⟪k:4⟫Permettimi di restare al tuo fianco."

#: badend3:badend3_1CBBB369_2794_43B9_9D76_29CBF71151CD
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: bbda6d310c7bd860ab4cfb0268d9814888f31044bfa4276fe077521a4b8ab8b5
#. default-sha256: 43905b1aa8ba6c997ca42d81db3d557714d587388d10c879d53f17a50562d758
msgctxt "badend3:badend3_1CBBB369_2794_43B9_9D76_29CBF71151CD"
msgid "⟪k:0⟫⟪k:1⟫I..."
msgstr "⟪k:0⟫⟪k:1⟫Io..."

#: badend3:badend3_7617E012_B4C3_4E0E_9BDF_9A7BF2BC9F7F
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 7978b42bf4e9514fb1b733f644d7a6fa6a43e56301503763981b59d89ee3c107
#. default-sha256: 100a77e078f1c414984dd60be9a0403bacfc765cd705ced0c6368c9680728ae4
msgctxt "badend3:badend3_7617E012_B4C3_4E0E_9BDF_9A7BF2BC9F7F"
msgid "⟪k:0⟫⟪k:1⟫Of course you may."
msgstr "⟪k:0⟫⟪k:1⟫Certo che può."

#: badend3:badend3_B66E0276_AEE5_48AA_84C5_BBE775A309AE
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 3bd94fab46a8c8a3a5439d2748f03fb89a3c7bc967b1a38c2a38932cc75822d7
#. default-sha256: 31289051e577122aa9e7d9a9ae1e69c7009ca2cc470c9461f544e13bd0798879
msgctxt "badend3:badend3_B66E0276_AEE5_48AA_84C5_BBE775A309AE"
msgid ""
"⟪k:0⟫⟪k:1⟫I was the one who asked you...⟪k:2⟫⟪k:3⟫to forget about everything and live in eternal "
"darkness with me."
msgstr ""
"⟪k:0⟫⟪k:1⟫Sono io ad averle chiesto...⟪k:2⟫⟪k:3⟫di dimenticare ogni cosa e di vivere con me "
"nell’oscurità eterna."

#: badend3:badend3_889CF03A_8988_4A6B_9154_05B232166190
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: abf6d3428c23cad45453a37cf4d0904f0da166fae49db929955df0408306050d
#. default-sha256: ad0b2dc75de4498a044baf9d66365fde22b989ebc377e33d2985348a8fe4d3b5
msgctxt "badend3:badend3_889CF03A_8988_4A6B_9154_05B232166190"
msgid "⟪k:0⟫⟪k:1⟫Hehe... ⟪k:2⟫what a silly question.⟪k:3⟫⟪k:4⟫Did you think I would ever say no?"
msgstr "⟪k:0⟫⟪k:1⟫Hehe... ⟪k:2⟫che domanda sciocca.⟪k:3⟫⟪k:4⟫Pensava che le avrei detto di no?"

#: badend3:badend3_CD69DE7F_D1E0_4D28_A5A9_DD42EFFE124E
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 39c0e93329f60a83b73e46ee3edd9cee836203fc6af66970bef729a512d7ea0c
#. default-sha256: 1c812955ab9bac78e3a90e06d812791e1961c834f796f1436b7f9a497f0f3238
msgctxt "badend3:badend3_CD69DE7F_D1E0_4D28_A5A9_DD42EFFE124E"
msgid "⟪k:0⟫⟪k:1⟫⟪k:2⟫............"
msgstr "⟪k:0⟫⟪k:1⟫⟪k:2⟫............"

#: badend3:badend3_58A47977_610A_406A_A124_07F807C0BEC9
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 12020bd4d10d3c50ede87a677075d75c66f8af0bb9528e148ecad363f8cccc69
#. default-sha256: 690020e96721ad953b04b54c7d1874def257174ef662a9e8fe149a989eeb1727
msgctxt "badend3:badend3_58A47977_610A_406A_A124_07F807C0BEC9"
msgid "⟪k:0⟫Right...⟪k:1⟫⟪k:2⟫You did, didn’t you?"
msgstr "⟪k:0⟫Già, è vero...⟪k:1⟫⟪k:2⟫Me lo avevi chiesto tu..."

#: badend3:badend3_BCB801E7_1364_4128_8DD0_6657F4D6B165
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: dc5a3e2816208c9a0a2946e475810e6fbdd9638cc1f286a5e80688aec8e7bb33
#. default-sha256: 7e7f9361ef27cb0f793a53eab93ca08e314b8fdabd0ed737f4dddf3d670acdbb
msgctxt "badend3:badend3_BCB801E7_1364_4128_8DD0_6657F4D6B165"
msgid ""
"⟪k:0⟫⟪k:1⟫Yes, I did. ⟪k:2⟫Worry not, I will banish the memory.⟪k:3⟫⟪k:4⟫I am sure you were "
"simply disoriented at having learned who you are."
msgstr ""
"⟪k:0⟫⟪k:1⟫Proprio così. ⟪k:2⟫Non si preoccupi, rimuoverò ogni ricordo.⟪k:3⟫⟪k:4⟫Sono sicura che "
"era semplicemente disorientata dopo aver scoperto chi era."

#: badend3:badend3_A1187E10_34D3_4C5E_8103_EA7C68FA9C4A
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 5fe403c6183ab4205ea2c6abff8767f552ccfec73396925e710d0e8d0422ce8e
#. default-sha256: 6908c5aeebfe43a2d705fcd3e659b639736694d9a5583481c7908e11e9034e3b
msgctxt "badend3:badend3_A1187E10_34D3_4C5E_8103_EA7C68FA9C4A"
msgid "⟪k:0⟫⟪k:1⟫There is nothing to fear.⟪k:2⟫⟪k:3⟫Only happiness awaits you."
msgstr "⟪k:0⟫⟪k:1⟫Non c’è nulla di cui aver paura.⟪k:2⟫⟪k:3⟫La felicità la attende."

#: badend3:badend3_3F28DBBC_B943_4C4C_B38C_3B9F909A66AC
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 39c0e93329f60a83b73e46ee3edd9cee836203fc6af66970bef729a512d7ea0c
#. default-sha256: 1c812955ab9bac78e3a90e06d812791e1961c834f796f1436b7f9a497f0f3238
msgctxt "badend3:badend3_3F28DBBC_B943_4C4C_B38C_3B9F909A66AC"
msgid "⟪k:0⟫⟪k:1⟫⟪k:2⟫............"
msgstr "⟪k:0⟫⟪k:1⟫⟪k:2⟫............"

#: badend3:badend3_5E64EA09_117B_4525_A7F3_166A536C201C
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: a681501ddc3ed79e31c6786eac6b179b9276af955dd3ce26b8bf719e1e4811e8
#. default-sha256: 1c0bd671531bc89eeb13611985ccfd029d01536cf866902b36ba42b47e6754e8
msgctxt "badend3:badend3_5E64EA09_117B_4525_A7F3_166A536C201C"
msgid "⟪k:0⟫⟪k:1⟫Hehehe. I am getting excited now.⟪k:2⟫⟪k:3⟫What should we do first?"
msgstr "⟪k:0⟫⟪k:1⟫Hehehe. Sono così eccitata.⟪k:2⟫⟪k:3⟫Cosa dovremmo fare prima?"

#: badend3:badend3_432A5F2E_31DA_49C2_A4E2_ABE599E5AE13
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 0613a36fcf3c6aec5f6c709fa9765b0a160f61bb335f3bf8932e959c63dcbccd
#. default-sha256: 9ebb694f52becce2127d02e96cc025185eb0989ab4cdaafd89d25bb74d186deb
msgctxt "badend3:badend3_432A5F2E_31DA_49C2_A4E2_ABE599E5AE13"
msgid ""
"⟪k:0⟫⟪k:1⟫Oh, I know. We should throw a party in commemoration of your decision to remain here "
"with me."
msgstr ""
"⟪k:0⟫⟪k:1⟫Ah, ho trovato. ⟪k:2⟫Dovremmo organizzare una festa per commemorare la sua decisione di "
"rimanere qui con me."

#: badend3:badend3_BF9EC4E9_3B95_4859_AFAD_0E0CCD71D182
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: a56300a85e740f1a02b90c399dd26eef9939d2d555d5a788a9970a23ae508849
#. default-sha256: a81aa7a2047fd156808809576f719a1ca260ac8440658fe1d65e5179a7d410a4
msgctxt "badend3:badend3_BF9EC4E9_3B95_4859_AFAD_0E0CCD71D182"
msgid "⟪k:0⟫I shall prepare the most wonderful feast, my sweet girl."
msgstr "⟪k:0⟫Preparerò la festa più bella di sempre, piccola mia."

#: badend3:badend3_4180AD12_835B_41D8_983B_14CDBAD51201
