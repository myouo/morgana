#: badend5:badend5_97113EAB_1C5C_404C_959A_3651C60A21A5
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 9009b80d3c01317075e67a678c8cbe524772fdc9a3ae22fada28f1e9db305824
#. default-sha256: 4aaf9555792a4f0cc391d36155d3954328dd37decced3128ef429ea58f123053
msgctxt "badend5:badend5_97113EAB_1C5C_404C_959A_3651C60A21A5"
msgid "⟪k:0⟫It was a day just like any other."
msgstr "⟪k:0⟫Era una giornata come un’altra."

#: badend5:badend5_16E70DB7_800A_4AB5_8915_E9E4B83CA6A1
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: f83c3b0b7db23562ac9b2c184b7f7b2bd95351e2cf3433367234783849e87609
#. default-sha256: 32e2db2ccd8250ab53634ae48b55cf58aba6b2ae441fdaea0f80b8cd71dde9b1
msgctxt "badend5:badend5_16E70DB7_800A_4AB5_8915_E9E4B83CA6A1"
msgid ""
"⟪k:0⟫A layer of clouds drifted slowly across the sky.⟪k:1⟫⟪k:2⟫We sat across from one another at "
"a café’s outdoor table."
msgstr ""
"⟪k:0⟫Uno strato di nuvole si spostava lentamente nel cielo.⟪k:1⟫⟪k:2⟫Eravamo seduti al tavolino "
"di un bar, all’aperto, l’uno di fronte all’altra."

#: badend5:badend5_08D685DB_E611_4FA5_A9DF_2AF90B2BA5B8
