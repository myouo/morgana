msgid "⟪k:0⟫What were... ⟪k:1⟫you saying, again?"
msgstr "⟪k:0⟫Cosa... ⟪k:1⟫stavi dicendo?"

#: badend5:badend5_22A3A367_B50D_46BE_8D2A_00044CB8B667
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 7cb3e2c586e9aebc74113b2e679a6ff0e35646fc746013cd3de48920945db2a5
#. default-sha256: 4527955c12d3e94d9b7e00c04dfcfdf47de462ab71ace9541963cda31666bd7e
msgctxt "badend5:badend5_22A3A367_B50D_46BE_8D2A_00044CB8B667"
msgid ""
"⟪k:0⟫Are you sure you’re okay?⟪k:1⟫⟪k:2⟫I was saying we need to settle on a destination for our "
"trip next month."
msgstr ""
"⟪k:0⟫Sei sicuro di star bene?⟪k:1⟫⟪k:2⟫Stavo dicendo che dobbiamo decidere una meta per il nostro "
"viaggio del mese prossimo."

#: badend5:badend5_86396821_A704_466D_BDC8_B9DA192F8AC1
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: f44c29f4ddfb9268f4d50cf38e110a967c611265a6401cb31f10599a43a3e946
#. default-sha256: 381676ab76da9564acb4bdc5bc815268bb1e76ff251b9f87e9950dffc4f71bbe
msgctxt "badend5:badend5_86396821_A704_466D_BDC8_B9DA192F8AC1"
msgid "⟪k:0⟫Ahh... ⟪k:1⟫Anywhere you’d like is fine with me."
msgstr "⟪k:0⟫Ahh... ⟪k:1⟫Per me va bene qualunque posto preferisci."

#: badend5:badend5_7B84C3A8_4D0F_4F9F_BAC2_E5C67DB83917
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 1bb917110706ba9bc2bfef9d6012b640a399a27144d9e6acff4649517a6c530b
#. default-sha256: 263f32cbcca1e8777934d7d4304753c0190e00f4492e5f3be0b8aaf99114b7fb
msgctxt "badend5:badend5_7B84C3A8_4D0F_4F9F_BAC2_E5C67DB83917"
msgid ""
"⟪k:0⟫Hehe... ⟪k:1⟫that’s always how it goes with you, isn’t it?⟪k:2⟫⟪k:3⟫You are allowed to have "
"an opinion of your own, you know."
msgstr ""
"⟪k:0⟫Hehe... ⟪k:1⟫le cose vanno a finire sempre allo stesso modo con te, eh?⟪k:2⟫⟪k:3⟫Ti è "
"concesso avere una tua opinione, sai?"

#: badend5:badend5_8FAE56BF_1795_4ACC_B488_406EB3C79BEC
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: ecf2787100814e7edd88284c4f429fc1ef5c7ebdb50e9519efbea8df52a6d2f4
#. default-sha256: 9dc3db6ce66c0299425df3b8d8dabb3bc7f947db1241021e393d6e805dd00cb0
msgctxt "badend5:badend5_8FAE56BF_1795_4ACC_B488_406EB3C79BEC"
msgid "⟪k:0⟫We’ll end up going to Prague again if you let me pick."
msgstr "⟪k:0⟫Se proprio devo scegliere, mi piacerebbe tornare a Praga."

#: badend5:badend5_4F9A34C5_FB50_441D_A1C9_B99B9E40C585
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: ea680e20960a5a901f2dd92acd9524ed147f4e89ec0a66a003bf630d941a19bd
#. default-sha256: 000ad47465d9dc18de981ad88b613b39764ade3866a0d5405fc4b47ead6a4aa0
msgctxt "badend5:badend5_4F9A34C5_FB50_441D_A1C9_B99B9E40C585"
msgid ""
"⟪k:0⟫There’s nothing wrong with Prague.⟪k:1⟫⟪k:2⟫We can go see Mucha’s stained-glass window at "
"the St. Vitus Cathedral and visit the Petřín Gardens again."
msgstr ""
"⟪k:0⟫Praga va benissimo.⟪k:1⟫ Possiamo andare a vedere la vetrata di Alfons Mucha alla Cattedrale "
"di San Vito, o a visitare nuovamente i Giardini di Petřín."

#: badend5:badend5_DDC5A25E_7AAF_4FF8_957F_F3CCFF4C6A23
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: ec108f9d5c6eb3ebed2216b92e7f33520000171c5bcbc69096387847d134ec96
#. default-sha256: 4134f50b23f90057878a368fbd5cacbd7f9942d94c2293c4765842da96e81d38
msgctxt "badend5:badend5_DDC5A25E_7AAF_4FF8_957F_F3CCFF4C6A23"
msgid "⟪k:0⟫And maybe this time, we won’t be late for the Walk of the Apostles at the clock tower."
msgstr ""
"⟪k:0⟫E forse stavolta faremo in tempo per il Corteo degli Apostoli all’orologio astronomico."

#: badend5:badend5_235E0583_6691_45E7_BA54_F8BFDE73790C
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 1f75700cdfce31d1fc78be8733df44344d4583f5ed7c18dfdc17a94fa6c4fa7b
#. default-sha256: 59231ab71f1630233153c09a436166355e3213850ecc38010e14b0c8b3b7c16d
msgctxt "badend5:badend5_235E0583_6691_45E7_BA54_F8BFDE73790C"
msgid "⟪k:0⟫All right, then we should start looking at hotels."
msgstr "⟪k:0⟫D’accordo, allora dovremmo iniziare a vedere gli alberghi."

#: badend5:badend5_BE7D8084_75C7_447A_AA86_79065F6C5CC7
