#: badend5:badend5_121A7CDC_3548_4519_9C0D_1EACDCD8F100
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 1bdc66befdeb95d2357352f696d6f55f1f3c19db333a132529255ffc6755facc
#. default-sha256: 6b008e4c018957e52032145c303dfb93986f1df64361f327b2f696c402da9b4c
msgctxt "badend5:badend5_121A7CDC_3548_4519_9C0D_1EACDCD8F100"
msgid "⟪k:0⟫Oh, ⟪k:1⟫um, ⟪k:2⟫sorry. I’m fine."
msgstr "⟪k:0⟫Ah, ⟪k:1⟫ehm, ⟪k:2⟫perdonami. ⟪k:3⟫Sto bene."

#: badend5:badend5_14843988_FD1C_4853_853A_52A5802A150B
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 1cd57aa596b75a9e4571047e9e7d616e949daa9ffc70571b3ee611339c33fb54
