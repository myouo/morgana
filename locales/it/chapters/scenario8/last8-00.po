#: scenario8:scenario8_6859F8BA_2B60_443D_A146_6359F9BCC8F3
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: f4fa39ad0fdfece5bbe303c8a947ade9ffc2a3871a236b346eb54b1a1876ef83
#. default-sha256: f2ea7171e065f24152712cad1b271bc9f308c89a5b61cafad5b4bef7e46adc0b
msgctxt "scenario8:scenario8_6859F8BA_2B60_443D_A146_6359F9BCC8F3"
msgid "⟪k:0⟫⟪k:1⟫That endless expanse of red earth"
msgstr "⟪k:0⟫⟪k:1⟫Quella sconfinata distesa di terra rossa"

#: scenario8:scenario8_A4A3F35D_D62F_4F2A_B280_64EB88F05101
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 37bcf42f417c9ed0037286f40a31b4fa3ed12ea8e46a471901983b44455a56e4
#. default-sha256: d1cce45e0acf672eebab9d6f0b82ce875f3223fe3ccf1e0e3f88ff25e2a696cf
msgctxt "scenario8:scenario8_A4A3F35D_D62F_4F2A_B280_64EB88F05101"
msgid "⟪k:0⟫⟪k:1⟫remains branded into the very fabric of my mind."
msgstr "⟪k:0⟫⟪k:1⟫è marchiata a fuoco nella mia mente."

#: scenario8:scenario8_86014BCE_50E9_48BD_9AD2_C18A9B08E47F
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: f9eb89adbf662317410b35230267d423d1da3e7ef18c58ba77070c4e57e3782d
#. default-sha256: 92f45e7ea96af39f861429e551ea4fd9b07dd7c65d7c16a4af45d248a764b44c
msgctxt "scenario8:scenario8_86014BCE_50E9_48BD_9AD2_C18A9B08E47F"
msgid "⟪k:0⟫That’s where it was decided someone built like I am would be the most use, I suppose."
msgstr ""
"⟪k:0⟫Suppongo che avessero deciso che un uomo forte e robusto come me sarebbe stato più indicato."

#: scenario8:scenario8_EFE14CCC_A8CF_4BAA_BE17_57EA45F3D07C
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: dda091597ccd29535d5adeaa06a35e6d7daf7b6028c6532807150592fe83f834
#. default-sha256: a8ceb3ba07420f09a932c5aa5b666042983672b31c671c862cbc0d8b97cbbfb0
msgctxt "scenario8:scenario8_EFE14CCC_A8CF_4BAA_BE17_57EA45F3D07C"
msgid ""
"⟪k:0⟫But I could tell from their tone of voice and expressions that the things they were saying "
"were not friendly. ⟪k:1⟫They seemed to be mocking me, laughing at me."
msgstr ""
"⟪k:0⟫Ma dalle loro espressioni e dal tono di voce capii che le loro parole non erano affatto "
"amichevoli. ⟪k:1⟫Sembrava che si stessero prendendo gioco di me, deridendomi."

#: scenario8:scenario8_CDC5F7AC_8330_457D_B164_F088B8DEC181
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 4348c78568f68ae8e3778d81e48aa36dfeb13b762d8f30466971081b6c068bdf
#. default-sha256: 5ce715662c4e3412ad7fc6eef1af60e4ce09f0f7505d7694783552a657fe7151
msgctxt "scenario8:scenario8_CDC5F7AC_8330_457D_B164_F088B8DEC181"
msgid ""
"⟪k:0⟫As you might expect, I attempted to protest,⟪k:1⟫but evidently, I had been beaten quite "
"badly while I was unconscious."
msgstr ""
"⟪k:0⟫Come puoi immaginare tentai di oppormi, ma mi fu subito chiaro che ero stato malmenato "
"gravemente mentre ero privo di sensi."

#: scenario8:scenario8_189711F9_D6CC_485D_95C3_728672FF3E07
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: a6ef45142bd764b088a5d3369bc336d4728fbe26cb7234773de1f06752f63e81
#. default-sha256: a6aea5d57124d80886790f68bb044f1a5763cf0ecd2c2251da0b7c658f09ad9c
msgctxt "scenario8:scenario8_189711F9_D6CC_485D_95C3_728672FF3E07"
msgid ""
"⟪k:0⟫My joints were stiff and swollen, on top of my dehydration,⟪k:1⟫so I could barely move, let "
"alone put up a fight."
msgstr ""
"⟪k:0⟫Le mie articolazioni erano rigide e gonfie, al culmine della mia disidratazione,⟪k:1⟫ per "
"cui riuscivo a muovermi a malapena, figuriamoci⟪k:2⟫a combattere."

#: scenario8:scenario8_64D83DD8_B6FF_487B_AA17_AC0B63B424CF
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: a8d4cca93a339c8bdabdae10f315d56a59c2f0667d0f1ace98b02b865dc2f967
#. default-sha256: 661210f4f2bb6cb14896cb741d724ae3dfb4073d36ae0b357981eb74e76f3047
msgctxt "scenario8:scenario8_64D83DD8_B6FF_487B_AA17_AC0B63B424CF"
msgid ""
"⟪k:0⟫As strong as I might have been at full health, I was in no condition to do anything then."
msgstr ""
"⟪k:0⟫Per quanto forte avrei potuto essere nel pieno della forma,⟪k:1⟫in quella situazione non ero "
"nelle condizioni di poter fare niente."

#: scenario8:scenario8_475C661B_0BE8_4B09_A455_E9CE8A5CCB88
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 088bacc19004413a0df9f9545828c96840b4a85db7be1ba29716ef3d131bd80e
#. default-sha256: ae1f7fe3b1ec67beb6706a7f548d1354a57be2335f50c5e4ba7ae980d7b787a5
msgctxt "scenario8:scenario8_475C661B_0BE8_4B09_A455_E9CE8A5CCB88"
msgid ""
"⟪k:0⟫They had many words to describe me, none of them flattering.⟪k:1⟫⟪k:2⟫Some of them would "
"even call me “beast.”"
msgstr ""
"⟪k:0⟫Avevano molte parole per descrivermi, e nessuna di queste era lusinghiera.⟪k:1⟫ Molti di "
"loro mi chiamavano addirittura “bestia”."

#: scenario8:scenario8_5244F813_E939_4660_BDB7_59797A6E7A7D
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 66d12389a90e273344980e68da7160839de01b818e92e93751fe88d464168a9b
#. default-sha256: 91cc542af27f3411bf0a00e3cdd198fc40f847ee2098a2f665c561e1063b726b
msgctxt "scenario8:scenario8_5244F813_E939_4660_BDB7_59797A6E7A7D"
msgid ""
"⟪k:0⟫The slave trader’s guards were armed, of course.⟪k:1⟫⟪k:2⟫Swords hanging from their hips, "
"ready to cut down anyone who showed any sign of resistance."
msgstr ""
"⟪k:0⟫Le guardie del trafficante di schiavi erano armate, ovviamente.⟪k:1⟫⟪k:2⟫Le spade pendevano "
"dai loro fianchi, pronte per abbattere chiunque mostrasse il minimo segno di resistenza."

#: scenario8:scenario8_95934EAA_5C56_448B_B646_04C8D400B5E6
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: aecabfa1149811a7415d7885b07750059c67e8f010f3c2a1b602ae9eb383ef7f
#. default-sha256: e216058918baa073139ee90f3ed6d576c908467712833dba98144f8e45dd02d7
msgctxt "scenario8:scenario8_95934EAA_5C56_448B_B646_04C8D400B5E6"
msgid "⟪k:0⟫So they sat there, lamenting their fate."
msgstr "⟪k:0⟫Perciò gli schiavi se ne stavano lì, lamentandosi della propria sorte."

#: scenario8:scenario8_54ADD76B_A412_4AFA_BA50_2C9D1C49BD83
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 2adde2144023622dddeef1e9d21ef7605dc9a646d82cc07bfc083f87980b7dea
#. default-sha256: a564fd83c865b13de275942e7d4ccce6b3f07c618d67d543c6cd4e5ccb690969
msgctxt "scenario8:scenario8_54ADD76B_A412_4AFA_BA50_2C9D1C49BD83"
msgid ""
"⟪k:0⟫Glancing over at her, I caught a glimpse of her face—⟪k:1⟫⟪k:2⟫⟪k:3⟫large chunks of skin "
"seemed to have fallen off it."
msgstr ""
"⟪k:0⟫Osservandola meglio, intravidi il suo volto—⟪k:1⟫⟪k:2⟫⟪k:3⟫sembrava che le fossero caduti "
"grossi pezzi di pelle dalla faccia."

#: scenario8:scenario8_3C09BB0D_D06D_4694_AFEE_33B7DB1722FE
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: d3f99c8315b620a528c3193090611123d500016b033e86b3d6a6bc1e7f5b648e
#. default-sha256: 01b39b6cfb619258d7c85979ce345edeecb1ae27d7b3f583736acfb3f4306ab8
msgctxt "scenario8:scenario8_3C09BB0D_D06D_4694_AFEE_33B7DB1722FE"
msgid "⟪k:0⟫It was, suffice it to say, an unusual sight."
msgstr "⟪k:0⟫Non serve dire altro, se non che quella era una vista insolita."

#: scenario8:scenario8_EA4C890F_1548_4752_A156_2A7C16C62C10
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 486057da9eb4516aa415e1f6c51279ed9f00129e6ffe28806dd796ac76106701
#. default-sha256: b107746217727d438e5f55f2f8f707f58386a8544eefe5bb90ccb8a1314d76e6
msgctxt "scenario8:scenario8_EA4C890F_1548_4752_A156_2A7C16C62C10"
msgid ""
"⟪k:0⟫I’m not sure how to describe it... ⟪k:1⟫but it seemed different somehow from everyone else "
"crying in the carriage. It was almost like..."
msgstr ""
"⟪k:0⟫Non so bene come descriverlo... ⟪k:1⟫ma il suo pianto sembrava in qualche modo diverso da "
"quello degli altri schiavi all’interno del carro."

#: scenario8:scenario8_F2B7BADB_C3EA_40B1_AEE7_6D49DE1D5C3D
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 82f5fe07a02424ae91d2f2d1ef49aa41489d5d73a69e333834c090da22b4468b
#. default-sha256: 1875813923d8f5b5173ed15bf2a8a159a7ff35e01c62a108d058be6f6f6bf97f
msgctxt "scenario8:scenario8_F2B7BADB_C3EA_40B1_AEE7_6D49DE1D5C3D"
msgid "⟪k:0⟫her tears were not for herself."
msgstr "⟪k:0⟫Era quasi... ⟪k:1⟫come se le sue lacrime non fossero per se stessa."

#: scenario8:scenario8_4121FD91_F6D5_45F3_9CE9_623725AE1CC9
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 63ede952bc897dff212eea2114dde1011cb84152bb12148a2cbcc72b29093d7b
#. default-sha256: cf8e3d98896e88f7f4c597cb1d0ed52da271bf0d270167da68931f55397f9969
msgctxt "scenario8:scenario8_4121FD91_F6D5_45F3_9CE9_623725AE1CC9"
msgid "⟪k:0⟫Why are you crying?"
msgstr "⟪k:0⟫Perché stai piangendo?"

#: scenario8:scenario8_D6308C27_83A4_4537_B693_124430D2D1DC
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: e957c4e36223f9674cfb91dd0711b8e73a4ddd3c57ba64bed7ccb08b11785b2f
#. default-sha256: e551bfee67cb5dd2c6c4ac7230e5395ddfe64aaacc942e7da6707faadb6a5ac0
msgctxt "scenario8:scenario8_D6308C27_83A4_4537_B693_124430D2D1DC"
msgid "⟪k:0⟫After a moment’s hesitation, she said,"
msgstr "⟪k:0⟫Dopo un momento d’esitazione, disse,"

#: scenario8:scenario8_8D93A337_D2B1_4263_88A0_79A5D2C433CA
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 9c039ced99ada3c4c0eb95a8d1658119099536c4e192986881a2e923f014300a
#. default-sha256: f7482aaf87d7eed23fbddae01d881c621c76c6e6816134de2f60930c3b87463c
msgctxt "scenario8:scenario8_8D93A337_D2B1_4263_88A0_79A5D2C433CA"
msgid "⟪k:0⟫For a moment, I was filled with a sense of tranquility,"
msgstr "⟪k:0⟫Per un momento, mi sentii pervaso da un senso di tranquillità,"

#: scenario8:scenario8_DD5FAAB1_FB91_428F_A8DF_2C1B7B49DC0C
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 95c246c11e454a3c2a4e3befccc1d366357baf28bd4b4f9858274da6e4fc34af
#. default-sha256: be30a734f45c42ea1a142c7690e98e003825169ec5484f08deb4ab66ed4d2c63
msgctxt "scenario8:scenario8_DD5FAAB1_FB91_428F_A8DF_2C1B7B49DC0C"
msgid "⟪k:0⟫and though you may not believe it,"
msgstr "⟪k:0⟫e anche se potresti non credermi,"

#: scenario8:scenario8_6C1999A0_BBCE_491A_9F11_3AA8BB65B59D
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 3632aac4fdaf45197b5237185bbf17446d2c03ca16fafbb643cb2c9ff5d8246a
#. default-sha256: 7b2d6216cb7ec6d741f4639cc8657ea4b7e84e5ec17f3cd6e5c8a84710f98af2
msgctxt "scenario8:scenario8_6C1999A0_BBCE_491A_9F11_3AA8BB65B59D"
msgid "⟪k:0⟫This is no lie, I promise."
msgstr "⟪k:0⟫Non sto mentendo, te lo assicuro."

#: scenario8:scenario8_D377934A_089F_403D_A7CE_0876CD37C5EE
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 1811f75d3f4e2e81c3afd5e1515602c13ac3341aa9d80353b155fb66b99948b1
#. default-sha256: 48f41697b22461c825c2f67ac00db3078091b23a05c42741f58ec0ffc02c435d
msgctxt "scenario8:scenario8_D377934A_089F_403D_A7CE_0876CD37C5EE"
msgid "⟪k:0⟫............"
msgstr "⟪k:0⟫............"

#: scenario8:scenario8_C75B6762_6766_41AE_BA3B_52BF6A5BD0F5
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 49f7a720293f4a2752488210903549db06b9a09fa7076df0dba2886984c9b6e9
#. default-sha256: 908b10aea69cee84431c89e609c27d9d1250823bb55f990c9c00f19fd12c3df8
msgctxt "scenario8:scenario8_C75B6762_6766_41AE_BA3B_52BF6A5BD0F5"
msgid "⟪k:0⟫I’m begging you!"
msgstr "⟪k:0⟫Ti scongiuro!"

#: scenario8:scenario8_1774CFC9_2512_4570_AE5C_B1ACDF30C87C
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 493f177d66d6e190ee067847c940a8bfc002514e14fb7bf9eb4336de1c137865
#. default-sha256: a57a49da06552ca269a88a18fa39b0d4de2ff47f8ed45fc41bd5c2c6836650c2
msgctxt "scenario8:scenario8_1774CFC9_2512_4570_AE5C_B1ACDF30C87C"
msgid ""
"⟪k:0⟫They let their guard down because we were restrained.⟪k:1⟫⟪k:2⟫The thought of anyone "
"resisting never once crossed their minds."
msgstr ""
"⟪k:0⟫Avevano abbassato la guardia perché eravamo ammanettati.⟪k:1⟫⟪k:2⟫Il pensiero che qualcuno "
"potesse opporsi non gli era minimamente passato per la testa."

#: scenario8:scenario8_A91022C2_DDC8_404F_9E06_8CCEBACC812E
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 048c0da95a85ff133d35ffe984be251a135ec9b5eb70fbeb7885b0608b40bb44
#. default-sha256: 364c239174cee06b761b65866e8f97414bfe2f19088874f788d8169e1caf24a8
msgctxt "scenario8:scenario8_A91022C2_DDC8_404F_9E06_8CCEBACC812E"
msgid "⟪k:0⟫Haha... ⟪k:1⟫hahahaha... ⟪k:2⟫heehee!"
msgstr "⟪k:0⟫Haha... ⟪k:1⟫hahahaha... ⟪k:2⟫heehee!"

#: scenario8:scenario8_63E11C4C_470B_45C4_BDF5_9D1910BA3315
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 6d1ca75db4b70ec1f412a09cbd6c880c2c7328691b3fedd3ecd757c670f2f231
#. default-sha256: 8a5d4ac206d7ccb8f612a8c20fc53cc406c42df351f188ed831e4487932e2f65
msgctxt "scenario8:scenario8_63E11C4C_470B_45C4_BDF5_9D1910BA3315"
msgid "⟪k:0⟫More... ⟪k:1⟫I need more...⟪k:2⟫⟪k:3⟫I need moooooooooooore!"
msgstr "⟪k:0⟫Ancora... ⟪k:1⟫Ne voglio ancora...⟪k:2⟫⟪k:3⟫Ne voglio ancoraaaaaaaaaaaa!"

#: scenario8:scenario8_38158AE4_64C6_491B_98D3_B0BE5DA55015
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: bd43cafbdb2aa192386f1e3aabd48489f3261e76336380e990ce4d12b91e9ae5
#. default-sha256: 751596dc20b83701dfc88f68e19e9aac348ac88e382c7fcce5ef8cd9d0d82a6f
msgctxt "scenario8:scenario8_38158AE4_64C6_491B_98D3_B0BE5DA55015"
msgid "⟪k:0⟫But she said nothing, simply removing my shackles as commanded."
msgstr "⟪k:0⟫Ma lei non disse niente, si limitò a rimuovermi le manette come avevo ordinato."

#: scenario8:scenario8_707AA80E_C68A_4C08_8E5F_B7EA77E984E7
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: ba8c50a833445983a8f38e4f871ffa1e6cafc35bdf83b8ed06a67e0c4ffb2977
#. default-sha256: ac5ccc3586b78bb467b07d0d446e7b337ece9355e7d66951d4427ec01f7cb4f5
msgctxt "scenario8:scenario8_707AA80E_C68A_4C08_8E5F_B7EA77E984E7"
msgid "⟪k:0⟫⟪k:1⟫We can have our lives back!"
msgstr "⟪k:0⟫⟪k:1⟫Abbiamo di nuovo la nostra vita!"

#: scenario8:scenario8_D2F5D64A_E594_4284_9082_612E7FE2398A
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: e171bf1bfcdb3c0a208086fe77fd66e7070f8af961c2af4902b4cc6efb5015f9
#. default-sha256: c052cb752045f9ed22164bba1bae986e60f22bb6eb0ec2043981291e3c33906f
msgctxt "scenario8:scenario8_D2F5D64A_E594_4284_9082_612E7FE2398A"
msgid "⟪k:0⟫Undo our shackles, please!"
msgstr "⟪k:0⟫Toglici le manette, per favore!"

#: scenario8:scenario8_64824487_E115_4F4F_BFD9_18DCE692F95E
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 2dac8972332b8fdd8e8764e9f37106753a5bbcf0545a4226fa58da7d4c48e260
#. default-sha256: a25c2a26425c85e6e1907f943a674b1590762f36210cbfdda58c02ce2b36fdb6
msgctxt "scenario8:scenario8_64824487_E115_4F4F_BFD9_18DCE692F95E"
msgid "⟪k:0⟫...What?"
msgstr "⟪k:0⟫...Cosa?"

#: scenario8:scenario8_E0FF7BD7_1173_4629_BCC6_D320C1A7BDDB
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: e12a2dfb962f9d9f1a365379ca459ede5d9934fb71c37a5c323cd3a7ea912b57
#. default-sha256: 62218689bcccdfb720aacd7ecf8c778fc9fd67f0f2141dbbfa955b454b10429e
msgctxt "scenario8:scenario8_E0FF7BD7_1173_4629_BCC6_D320C1A7BDDB"
msgid "⟪k:0⟫More... ⟪k:1⟫I need... ⟪k:2⟫I need more..."
msgstr "⟪k:0⟫Ancora... ⟪k:1⟫ne voglio ancora..."

#: scenario8:scenario8_73ED03DA_8312_4CD3_8143_2A66A23CB002
