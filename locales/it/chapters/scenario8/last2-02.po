msgid "⟪k:0⟫⟪k:1⟫⟪k:2⟫Of the three, Mell was the least threatening."
msgstr "⟪k:0⟫⟪k:1⟫⟪k:2⟫Dei tre, Mell è stato la minaccia minore."

#: scenario8:scenario8_FA427C87_1978_4CE5_8AE0_85286F6A87CA
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 7ce231dbe494f0610ca0a2c6768e53e1bdddb4d2d13ee289fc9e1df6fcaccc5d
