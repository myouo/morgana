msgid "⟪k:0⟫⟪k:1⟫(I was only able to converse with them after I had reclaimed myself.)"
msgstr "⟪k:0⟫⟪k:1⟫(Sono riuscito a parlare con loro solamente dopo aver reclamato me stesso.)"

#: scenario8:scenario8_367C4FD1_075B_42F3_B4A2_E58575185E11
