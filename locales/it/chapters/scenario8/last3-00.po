#: scenario8:scenario8_D1B494DA_31AD_409F_91EE_C3F61A2683A9
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: a6cc9a6400de3edace2f5a088c26ae3ae4a8ac8144400e46575c784062edf7a3
#. default-sha256: 6ed7eebe021d235e23842de54130b36fe1f058999f293df5280e144cf6d59aa7
msgctxt "scenario8:scenario8_D1B494DA_31AD_409F_91EE_C3F61A2683A9"
msgid ""
"⟪k:0⟫⟪k:1⟫On days when it was nice out,⟪k:2⟫⟪k:3⟫I would take walks around the house’s grounds,"
msgstr "⟪k:0⟫⟪k:1⟫Quando fuori c’era bel tempo⟪k:2⟫⟪k:3⟫passeggiavo nel cortile di casa,"

#: scenario8:scenario8_A9BABB81_749F_4964_9AD1_E69F58DEE34D
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: c85d8e07d21e5e44c1fc48536592980af1517067895d802920215cd22a51e481
#. default-sha256: 52dd14f23054cae94c165976544b1461177cf67f334047a16daab8d8ba9ffcb6
msgctxt "scenario8:scenario8_A9BABB81_749F_4964_9AD1_E69F58DEE34D"
msgid "⟪k:0⟫⟪k:1⟫sometimes napping beneath a tree."
msgstr "⟪k:0⟫⟪k:1⟫a volte appisolandomi sotto gli alberi."

#: scenario8:scenario8_4BED022D_815C_4FFF_B1B1_70419C5FC109
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 8f0b9064142b8b030d9bf0c1629f4f24bcbb1e63c897dc9d65ecedc4862bcca0
#. default-sha256: e0f38675c54125a2bf202a005ffe685be950ac9fcc933d734812cb0fb71c48b8
msgctxt "scenario8:scenario8_4BED022D_815C_4FFF_B1B1_70419C5FC109"
msgid "⟪k:0⟫⟪k:1⟫whereas mine is flat and dull."
msgstr "⟪k:0⟫⟪k:1⟫mentre i miei sono spenti e sbiaditi."

#: scenario8:scenario8_E3166BAA_BA5A_4E7B_9D32_689B25DD9633
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: b87a72c3bcae82aac0701b776b44059ec7d0e567b201c8c47c61871c3e9581cb
#. default-sha256: 1696e92b4415a9bebb884caaead57506c4f127f9f89d95db904b63c44c3c00e4
msgctxt "scenario8:scenario8_E3166BAA_BA5A_4E7B_9D32_689B25DD9633"
msgid "⟪k:0⟫⟪k:1⟫You shone like a tiny little dancing sun."
msgstr "⟪k:0⟫⟪k:1⟫Splendevi come una piccola stella."

#: scenario8:scenario8_0114CDC6_DD89_463C_AF9E_DD612D17C3A0
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 4d3fce1b1bcee690f943a34d31a1b451dbeb49e6bc2853a6e77921d9db3acfce
#. default-sha256: 846b3446c3415a06736b46bca29efa23fed9c4ba29e3c89f82ce489b926e83f8
msgctxt "scenario8:scenario8_0114CDC6_DD89_463C_AF9E_DD612D17C3A0"
msgid "⟪k:0⟫⟪k:1⟫At the time, I assumed that was how life would always be."
msgstr "⟪k:0⟫⟪k:1⟫Al tempo, ero convinto che la vita sarebbe rimasta così per sempre."

#: scenario8:scenario8_026D5E20_738D_4C2B_A483_A709FFB94996
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 76fe9dd1fff515fb58272d9e1ee6bc613ca29be73dc4b6041402b2c4c61d5f1e
#. default-sha256: f6b40a5772e31164b81528cb35b7497d5f403af67f3a023ca3130a3c60d9b9e2
msgctxt "scenario8:scenario8_026D5E20_738D_4C2B_A483_A709FFB94996"
msgid ""
"⟪k:0⟫Part of me wanted to know why nobody bothered talking to me,⟪k:1⟫and part of me was "
"relieved. ⟪k:2⟫Somewhere inside, I knew I didn’t have what it took."
msgstr ""
"⟪k:0⟫Da una parte volevo sapere come mai nessuno si fosse degnato di consultarmi, e dall’altra "
"ero sollevato. ⟪k:1⟫Dentro di me, sapevo di non avere ciò che serviva."

#: scenario8:scenario8_0C1CDE28_7606_473D_B23B_F7FB5A3A1B49
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 27c7f6b0f24d148bddba68c0e124d52423878ea0d153fba0769fa5a13fab7c48
#. default-sha256: 3b0a1fbbbd6de1692cd5551ef4447e21bdf476b81bbd95aec30a7af7814b219a
msgctxt "scenario8:scenario8_0C1CDE28_7606_473D_B23B_F7FB5A3A1B49"
msgid "⟪k:0⟫and in response, he formally disowned me."
msgstr "⟪k:0⟫e in risposta, fui disconosciuto ufficialmente."

#: scenario8:scenario8_70CAA6B3_33FB_4FAC_ACFC_5AAD1525E679
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: c797825f5fff0010a525470a4f858df989d33d06a22ad1c1d60909358ff74348
#. default-sha256: d77e3503c0742a0f254a9a363a3f34dc3c9520697807e14d1e16fb59a12a62d1
msgctxt "scenario8:scenario8_70CAA6B3_33FB_4FAC_ACFC_5AAD1525E679"
msgid ""
"⟪k:0⟫You’re not the only one who still had some growing up to do, Nellie...⟪k:1⟫⟪k:2⟫I wasn’t "
"quite the adult I’d thought I was either."
msgstr ""
"⟪k:0⟫Non eri l’unica a dover crescere, Nellie...⟪k:1⟫⟪k:2⟫Anch’io non ero l’adulto che credevo di "
"essere."

#: scenario8:scenario8_FA7D6747_967F_4BD1_8158_BB4648567C75
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: dd441ecef6eb4bc4c5976f9706491ee993968e520bd16cd02ea06a421bd38d73
#. default-sha256: 4ce590024c8ec4ce34e0fd1f51b0a0f554ad2c2ee12b2a19c993ed1a0740fe29
msgctxt "scenario8:scenario8_FA7D6747_967F_4BD1_8158_BB4648567C75"
msgid ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫Fortunately—⟪k:3⟫⟪k:4⟫if you want to call it fortune—⟪k:5⟫⟪k:6⟫I was given enough "
"money to live on for a decent length of time, as well as a place to stay."
msgstr ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫Per fortuna—⟪k:3⟫⟪k:4⟫se così la si può chiamare—⟪k:5⟫⟪k:6⟫ricevetti abbastanza "
"denaro da continuare a vivere per un discreto periodo di tempo, oltre che ad un posto dove stare."

#: scenario8:scenario8_82CD33D1_0CF8_440F_B31F_CA3D47AD9315
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 313249432df776082b0fb9382ca081e573cebf9702de5e17d79f9926c98bffe4
#. default-sha256: 05e2c2706131ac147733c94f7868df6e13efcb54312a230e2c907f9bdad225b7
msgctxt "scenario8:scenario8_82CD33D1_0CF8_440F_B31F_CA3D47AD9315"
msgid "⟪k:0⟫⟪k:1⟫⟪k:2⟫...Oh?"
msgstr "⟪k:0⟫⟪k:1⟫⟪k:2⟫...Ah sì?"

#: scenario8:scenario8_F0F66272_1A70_4843_A7E7_E74FE97787A7
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 373bf9a69d8ddff8db6711b6b17765782e8cef2855d503785c9c1a563d5f5ee4
#. default-sha256: b9150e958f23607f53348eab57ddb338da61e37cb2e95d5483eef7ddf45d71a6
msgctxt "scenario8:scenario8_F0F66272_1A70_4843_A7E7_E74FE97787A7"
msgid ""
"⟪k:0⟫⟪k:1⟫I don’t need composers to come and write me songs for my birthday. ⟪k:2⟫As long as I "
"have the one thing that matters most to me, I can do without anything else."
msgstr ""
"⟪k:0⟫⟪k:1⟫Non ho bisogno di compositori che scrivano canzoni per il mio compleanno. ⟪k:2⟫Fintanto "
"che ho la cosa che per me conta di più,⟪k:3⟫posso farcela senza avere nient’altro."

#: scenario8:scenario8_4CAD8A9E_DEF1_4D17_9955_4D40055BA4EB
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 956c70b07d2e9e9193786bb2765484de75b69f7b30ef6e70e6da168143fcff09
#. default-sha256: d57daa8fac3759dc18f5c4cca819ce16e6d438287a71f3ea0cf11f416145edf7
msgctxt "scenario8:scenario8_4CAD8A9E_DEF1_4D17_9955_4D40055BA4EB"
msgid ""
"⟪k:0⟫We may not have a huge yard, but the sun shines everywhere.⟪k:1⟫⟪k:2⟫Flowers can grow even "
"without a gardener tending to them."
msgstr ""
"⟪k:0⟫Potremmo non avere un cortile enorme, ma il sole splende ovunque.⟪k:1⟫⟪k:2⟫E i fiori possono "
"crescere anche senza un giardiniere che se ne occupi."

#: scenario8:scenario8_0781453F_274D_4AFD_AE30_1C99F1552F2F
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: ba751c6615e8642fb832651fbaea9941b14cdf454ca0a26a6d194e73b540c719
#. default-sha256: d0a968e2477a29df6f51443f360b4fb5b6337da0c8821a151650dc308984f8bb
msgctxt "scenario8:scenario8_0781453F_274D_4AFD_AE30_1C99F1552F2F"
msgid "⟪k:0⟫What else sounds good? ⟪k:1⟫Hmm... ⟪k:2⟫I’m craving cookies!"
msgstr "⟪k:0⟫Cos’altro c’è di buono? ⟪k:1⟫Mmh... ⟪k:2⟫Ho voglia di biscotti!"

#: scenario8:scenario8_16735FB1_6A43_4AAC_A996_D588EFCC1B56
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: ce56356d9292e440b2b410010b7873f47acb67187112600a13bde13540da49c2
#. default-sha256: 3fc24347791e91af904b4061f536d6738e5e8410b2c9c40a63d8fca9d328dae1
msgctxt "scenario8:scenario8_16735FB1_6A43_4AAC_A996_D588EFCC1B56"
msgid "⟪k:0⟫⟪k:1⟫That’s the first smile I’ve seen since we got here."
msgstr "⟪k:0⟫⟪k:1⟫Quello è il primo sorriso che vedo da quando siamo arrivati."

#: scenario8:scenario8_7A6088F2_2857_4496_9125_BCEA0EA68271
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: daed8c1b2ac0aad3338f2828c1a9b3a11b53b6695972aa65a2dbfbbe23955467
#. default-sha256: 46643c9edfac2798fba09d1bddc24b6faeb3db92a6b6e2c560fc55909c076cf2
msgctxt "scenario8:scenario8_7A6088F2_2857_4496_9125_BCEA0EA68271"
msgid ""
"⟪k:0⟫⟪k:1⟫Who cares that we’re not rich anymore?⟪k:2⟫⟪k:3⟫We’ll figure things out in no time."
msgstr ""
"⟪k:0⟫⟪k:1⟫Chi se ne importa se non siamo più ricchi?⟪k:2⟫⟪k:3⟫Capiremo cosa fare in men che non "
"si dica."

#: scenario8:scenario8_65533E70_3D7C_4305_92E2_C898165BAD9F
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 36839a2e65c6f34266e9ed3109e944f4b594b79236b05ca6155fbebb7dff9834
#. default-sha256: 0f1a5b7a93b4555367241ee3bb537bc9e384316e9c831e9f8419cfeccb0ab3ec
msgctxt "scenario8:scenario8_65533E70_3D7C_4305_92E2_C898165BAD9F"
msgid "⟪k:0⟫And then we’ll have even more fun than we did back there!"
msgstr "⟪k:0⟫E poi ci divertiremo ancora più di prima!"

#: scenario8:scenario8_89CC1705_38AE_40B2_BCEF_1A28D235D33D
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: c0db4b36bf8b75bae8fa0e4f6d99d6d11d42b9913fa38fe18cdbdfaaf8713522
#. default-sha256: c80b56e9eae36b1b6ea8d7eb9158f871fda8c6da27cb89d4644f9813f31a6a9f
msgctxt "scenario8:scenario8_89CC1705_38AE_40B2_BCEF_1A28D235D33D"
msgid ""
"⟪k:0⟫⟪k:1⟫You’ve got yourself an adorable little princess!⟪k:2⟫⟪k:3⟫What more could you possibly "
"need?"
msgstr ""
"⟪k:0⟫⟪k:1⟫Ti sei trovato una principessa adorabile!⟪k:2⟫⟪k:3⟫Di cos’altro potresti mai aver "
"bisogno?"

#: scenario8:scenario8_8871344A_3F24_4690_8C8C_8A34F4D9E84D
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 2dfcbbbe503daef6079e6c8c8a0fd2de8b0e5c843374b4d0fa6210252a078035
#. default-sha256: 66867ca1643f2980d6253ad95c3426bc9386d039eb18d2e194d41f9a852ae5bb
msgctxt "scenario8:scenario8_8871344A_3F24_4690_8C8C_8A34F4D9E84D"
msgid "⟪k:0⟫⟪k:1⟫Cheer up!"
msgstr "⟪k:0⟫⟪k:1⟫Su col morale!"

#: scenario8:scenario8_3E139956_A055_4D47_B55D_3FAAA6856A23
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 47ddceb6d120a703ead75d9dedc40b9e8e71449ecbf9cad241edec0669a31b8d
#. default-sha256: 5d290ddf2ed5051d337d90d7a2f7f458bb9dcf631fdc0f2f9ee62229de92e463
msgctxt "scenario8:scenario8_3E139956_A055_4D47_B55D_3FAAA6856A23"
msgid ""
"⟪k:0⟫⟪k:1⟫Ohoho. Did you think for a second I wouldn’t?⟪k:2⟫⟪k:3⟫I’m your princess, dearest Mell!"
msgstr ""
"⟪k:0⟫⟪k:1⟫Eheh. Hai forse pensato che non sarei venuta?⟪k:2⟫⟪k:3⟫Sono la tua principessa, mio "
"caro Mell!"

#: scenario8:scenario8_3ED2A53C_3AFD_4A2F_89B6_974A96B940D5
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: c65c2c16cfbe6d15bcf840b0b6e88c8f3cc43f2be4f19df33750f4ded896ae01
#. default-sha256: 948f0bbddcd42cc75e9186608df0f1e2ea2a02be1c37c607f0bb3b9ba5c336cc
msgctxt "scenario8:scenario8_3ED2A53C_3AFD_4A2F_89B6_974A96B940D5"
msgid "⟪k:0⟫⟪k:1⟫And princesses belong with their princes."
msgstr "⟪k:0⟫⟪k:1⟫E ogni principessa dovrebbe stare accanto al proprio principe."

#: scenario8:scenario8_76276090_6E2F_4AF5_81BB_20FBB6F318B9
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 69488e4359ec8797076fce47cc69d11c9422ae33763646f0cad797df8859f4ae
#. default-sha256: 7f1757953fefd91618215570c26ce923c52ef3a67cc96898d4e12934ffefa249
msgctxt "scenario8:scenario8_76276090_6E2F_4AF5_81BB_20FBB6F318B9"
msgid "⟪k:0⟫but Nellie calling me her prince gave me the illusion of being worth something."
msgstr "⟪k:0⟫ma il fatto che Nellie mi considerava tale mi dava l’illusione di valere qualcosa."

#: scenario8:scenario8_3F2F6511_96BF_4686_99A5_2288F805FB64
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: f99dcb91032e76f83a587a0edaade4c68fcd67b040683c0992b66cdbee850199
#. default-sha256: 661101e90fcc1e0dc0f721e60f5a5112f219878ad3c3490d8ad24d15600c8609
msgctxt "scenario8:scenario8_3F2F6511_96BF_4686_99A5_2288F805FB64"
msgid ""
"⟪k:0⟫It made me feel like I could keep on being that richly blessed young man, even this far away "
"from home."
msgstr ""
"⟪k:0⟫Mi faceva sentire come se potessi continuare ad essere quel fortunato ragazzo di un tempo, "
"anche così distante da casa."

#: scenario8:scenario8_CC8CE97C_57A4_4844_94E7_B1E25F7B1C5E
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 83155fd490ec72571d48b1764d697b5c5d33250d65dc9a10c8b730d4fde7be44
#. default-sha256: 230848ca43f969df8a56266362beae8641b8d7a8090ba2cf2c9059d3e27bf89c
msgctxt "scenario8:scenario8_CC8CE97C_57A4_4844_94E7_B1E25F7B1C5E"
msgid "⟪k:0⟫but to be quite honest, I couldn’t gather the motivation to do much of anything."
msgstr "⟪k:0⟫ma ad essere onesto, non riuscivo a trovare lo stimolo di fare nulla."

#: scenario8:scenario8_63C6DAC9_1B4B_48E4_B46D_DCEA67D4D6F3
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 0ada3659edefd2bab4c5cfe10b9d07625eecb7e6cfb1889a8c2ca3fb33c81101
#. default-sha256: 1b99bfdc9a387e701c86f1b433f4d993d7d5a200ace118a7530b2605c865821a
msgctxt "scenario8:scenario8_63C6DAC9_1B4B_48E4_B46D_DCEA67D4D6F3"
msgid "⟪k:0⟫It had knocked me on my backside,⟪k:1⟫and I didn’t have the strength to get back up."
msgstr "⟪k:0⟫Ero stato messo con le spalle al muro, e non avevo la forza di reagire."

#: scenario8:scenario8_ADDC0075_5107_434C_B85B_C7D0503F1A53
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: a7fca26d48a952bfda09c64eb89750c0ea30da85aa4eacde48aa16ff6918aebc
#. default-sha256: 7722fd29130e7158a3782d81a9576b99873078489932cd4061e44884bbd32217
msgctxt "scenario8:scenario8_ADDC0075_5107_434C_B85B_C7D0503F1A53"
msgid "⟪k:0⟫I couldn’t tell Nellie that, of course, so this is what I said instead:"
msgstr "⟪k:0⟫Non potevo dirlo a Nellie, ovviamente, quindi le dissi questo, piuttosto:"

#: scenario8:scenario8_C7BB2910_3DBF_482D_A538_4565683DF042
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 929e34302c3f127b41174c24d5f3f7167dc657cdcb5fa0a1a2c56728debdcd98
#. default-sha256: db3d57f631e8f3dcacfd6675fdc196944fb20a4e75eb7d8211b3d68504ee8dd2
msgctxt "scenario8:scenario8_C7BB2910_3DBF_482D_A538_4565683DF042"
msgid "⟪k:0⟫And she happily took me at my word."
msgstr "⟪k:0⟫E lei mi prese felicemente in parola."

#: scenario8:scenario8_0B99D07D_BF8B_4995_8F5F_912A75899300
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: a0ce1808924b1f23f61cf7939e8308bc4ff1e35773e2edb64b93501da9f50fa9
#. default-sha256: c0d5b2e6913f21e6717f2b4685e86b312e240c1eb5bc61c17dce2909722b6bc5
msgctxt "scenario8:scenario8_0B99D07D_BF8B_4995_8F5F_912A75899300"
msgid "⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫I got a, ⟪k:4⟫uh... ⟪k:5⟫a chicken..."
msgstr "⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫Ho preso, ⟪k:4⟫ehm... ⟪k:5⟫un pollo..."

#: scenario8:scenario8_53B51C9D_A0DC_4863_B9CD_DAC5AAFCC9A8
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: ce2eb49b26eaabff9af651a7d1006a971700e5f3e0603c045c62938508e2d1b1
#. default-sha256: 7000bca6e23cf2dda006c83a0577e202fe20849b72058c2fcdfcd7235ce2057b
