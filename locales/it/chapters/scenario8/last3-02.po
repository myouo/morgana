msgid "⟪k:0⟫⟪k:1⟫⟪k:2⟫Whatever you say..."
msgstr "⟪k:0⟫⟪k:1⟫⟪k:2⟫...Come dici tu."

#: scenario8:scenario8_9595E7DE_C5BA_4AE0_81B9_A11C331F0E2D
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 45a7a103ea3724fea2dabdfe8520977520474d7a34a95203bd5cd510db4f3943
#. default-sha256: 0f0d473bb875a741b5f3ab3fe9d0cec5ccdb46e0da5cff993764eae6ef730ccf
msgctxt "scenario8:scenario8_9595E7DE_C5BA_4AE0_81B9_A11C331F0E2D"
msgid ""
"⟪k:0⟫⟪k:1⟫Forget about all that stuff at home.⟪k:2⟫⟪k:3⟫We’ve got each other! We can do this!"
msgstr ""
"⟪k:0⟫⟪k:1⟫Dimentica tutto quello che avevamo a casa.⟪k:2⟫⟪k:3⟫Abbiamo l’un l’altra! Possiamo "
"farcela!"

#: scenario8:scenario8_85C710CC_5FC8_4871_A087_9B1BF1901128
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: a563fb7ced9135d3f515c029df1ac2b0452679df5a34b7c7dad5dbbde0a0eb8e
#. default-sha256: d349a408adf12c28f1dbfbb5f07e2aee7987f15868054dabcff3c6161010e793
msgctxt "scenario8:scenario8_85C710CC_5FC8_4871_A087_9B1BF1901128"
msgid "⟪k:0⟫⟪k:1⟫It’ll all work out, dearest Mell.⟪k:2⟫⟪k:3⟫I’ll always be here for you."
msgstr "⟪k:0⟫⟪k:1⟫Andrà tutto bene, caro Mell.⟪k:2⟫⟪k:3⟫Io sarò sempre qui per te."

#: scenario8:scenario8_0D01B5C2_D45E_475E_B13F_467EE109DEE2
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: df47da196334c2ddb6b7f3be8b4c0f8eaf71483edc6816896c47d60767d92db6
#. default-sha256: ea0279b89a068dcfdfe4083f3849e09ab4e2f77edee9ab415838729aa6f387a7
msgctxt "scenario8:scenario8_0D01B5C2_D45E_475E_B13F_467EE109DEE2"
msgid "⟪k:0⟫I suppose so..."
msgstr "⟪k:0⟫Immagino di sì..."

#: scenario8:scenario8_276FC91D_6FDC_4871_B020_4A14D8E5C672
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 2d1903fa2345808c0137fd81a8e23adce7d53d4a0b0329647c65775a314d19b9
#. default-sha256: 0145a30e38b7d6c8bdd0d17a715255b2826b2a47c0c48c659b10ddf22500410a
msgctxt "scenario8:scenario8_276FC91D_6FDC_4871_B020_4A14D8E5C672"
msgid ""
"⟪k:0⟫My whole life had changed so abruptly, so dramatically,⟪k:1⟫that my mind just wasn’t able to "
"keep up."
msgstr ""
"⟪k:0⟫La mia intera vita aveva subito un cambiamento così improvviso,⟪k:1⟫così drastico, che la "
"mia mente non era in grado di reggerlo."

#: scenario8:scenario8_C48E29E4_2F8A_4181_BFEC_D4F2E839E1CF
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 64620d664b2582446a01294bdbd635bc0b35d7ae34e0394b9cfbe0ed49cd6ba7
#. default-sha256: 1fd2f8e5d8a480684ccf4c27462aa2ffbef5bd6161a2e4511589b1119c85937c
msgctxt "scenario8:scenario8_C48E29E4_2F8A_4181_BFEC_D4F2E839E1CF"
msgid "⟪k:0⟫Our new life together was quiet and unremarkable."
msgstr "⟪k:0⟫La nostra nuova vita insieme era tranquilla e ordinaria."

#: scenario8:scenario8_CD5F140F_2A30_4E96_B8D2_45E6694D1B3E
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 542fd1d9e3573343d8f99d6eb0afb88af879a9ab7ca2373da4264fabbafea2fa
