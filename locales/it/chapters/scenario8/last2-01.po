#: scenario8:scenario8_2EB39580_FF7B_4387_B185_A520655DDDAA
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: e923f34060aa4414dcb91d5b5443fa2bdcbd86afbced3472d1a8dcc8af182c6f
#. default-sha256: d5bcc5706360ee3ab2417aaa673513e147b2f52dfe634e1247197269908995c4
msgctxt "scenario8:scenario8_2EB39580_FF7B_4387_B185_A520655DDDAA"
msgid ""
"⟪k:0⟫⟪k:1⟫We’ll probably have more luck asking than just searching for her. ⟪k:2⟫If we can’t find "
"Mell, the nun might know."
msgstr ""
"⟪k:0⟫⟪k:1⟫Forse avremmo più fortuna se chiedessimo di lei, piuttosto che metterci a cercarla. "
"⟪k:2⟫Se non riusciamo⟪k:3⟫a trovare Mell, potremmo chiederlo alla suora."

#: scenario8:scenario8_49B91D93_C7F9_4BB2_B3FC_8873EEEDA737
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 13fee7af92891803b37c44916212e3666a9e7f2f7a84f77da0b4f66a5263c45d
