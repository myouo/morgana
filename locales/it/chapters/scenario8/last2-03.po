msgid "⟪k:0⟫⟪k:1⟫⟪k:2⟫I don’t think he has the spine for it?"
msgstr "⟪k:0⟫⟪k:1⟫⟪k:2⟫non credo abbia il coraggio di farlo."

#: scenario8:scenario8_83225998_CFAD_4684_8752_ADB0FCF8A1FD
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: c15a0ad9ca467bb845c065d81a2a1a9eaa4b5c96bd7edf0216728984c4fec0d2
#. default-sha256: c67d45824ba72a2132f33dc15f6f856cad80e4698c0436a94092a6b46da990b8
msgctxt "scenario8:scenario8_83225998_CFAD_4684_8752_ADB0FCF8A1FD"
msgid "⟪k:0⟫⟪k:1⟫⟪k:2⟫Did you ever have a chance... ⟪k:3⟫to see the shadows trapped in the mansion?"
msgstr ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫Non ti è mai capitato... ⟪k:3⟫di incontrare le tre ombre intrappolate nella villa?"

#: scenario8:scenario8_AB0BAADD_89E6_44F7_93C5_40473ED2B1D8
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 59423e1a1bf5c02d02f66b0cde35d3907da4d55017f46856014c9dac33d64631
#. default-sha256: 6a805c8383483b63ecf5e306ca4d7ece04c25ca73d2b26b23151a962640489d6
