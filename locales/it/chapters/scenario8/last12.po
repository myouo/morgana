msgctxt "scenario8:scenario8_C16EBD60_51C9_4BC5_8094_E87636C13BEB"
msgid "⟪k:0⟫⟪k:1⟫I wasn’t able to prevent Morgana’s death,"
msgstr "⟪k:0⟫⟪k:1⟫Non sono riuscito a prevenire la morte di Morgana,"

#: scenario8:scenario8_5936BA73_B67E_4639_9327_7606198B04B6
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 59044f850c17e5d8fbf6252f9f4a60c67a3b617d7ab1ca61b238f9c26a575f14
#. default-sha256: d8198dc37ceb5e306e78c34b3386032a7167e57ef33d664eeae170069951c5ab
msgctxt "scenario8:scenario8_5936BA73_B67E_4639_9327_7606198B04B6"
msgid "⟪k:0⟫but I ⟪k:1⟫was⟪k:2⟫ able to uncover the truth."
msgstr "⟪k:0⟫ma sono riuscito a scoprire la verità."

#: scenario8:scenario8_423170AA_9BC6_400F_8FD8_60750E032EA6
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: b073290e9af9263a46cdc428aa6da014e5ecd0719fae2089de0be66d7ee482cc
