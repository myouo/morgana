#: scenario8:scenario8_AED42863_A424_4B04_8542_1D46FD5715DA
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: e0fba718cfbfaf968c78859a8b3aacbdb528d5c7d9d4ab38e9f5aca92a0d68ed
#. default-sha256: 1aaa4be5e881e5524cb39c8597bcc57b9417533d7109ff215c0f090d5d633808
msgctxt "scenario8:scenario8_AED42863_A424_4B04_8542_1D46FD5715DA"
msgid "⟪k:0⟫⟪k:1⟫He opens the door, heading the four-man procession out of the tower, as he had in."
msgstr ""
"⟪k:0⟫⟪k:1⟫Apre la porta, conducendo la processione fuori dalla torre,⟪k:2⟫così come ha fatto "
"quando siamo entrati."

#: scenario8:scenario8_C1DB5E46_FA01_4DD6_8F5E_004447434A7E
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 498d49ad4fbe5d4cfe1e9672c6693ae0a1c0d1614a0a1786f2596a25795b2969
#. default-sha256: 740201c03fc83d836f889f7a8a11f2eac2e9b0b420e6f54412b0aee8cc4af1d1
msgctxt "scenario8:scenario8_C1DB5E46_FA01_4DD6_8F5E_004447434A7E"
msgid "⟪k:0⟫I walk at the back of the line."
msgstr "⟪k:0⟫Io sono l’ultimo della coda."

#: scenario8:scenario8_B95A895B_0AE5_4A8E_B7B5_384C42CA534F
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 37e8eb95f4cf9e1273dd3a544c581ea2f48dc69993712e1610418294a5c887b7
#. default-sha256: 58576b9bda7680df1c1a68eeafcc78ce8df1981e9bf5f4ec18114a70c0709f1e
msgctxt "scenario8:scenario8_B95A895B_0AE5_4A8E_B7B5_384C42CA534F"
msgid ""
"⟪k:0⟫Each step they take down the spiral staircase is slow and ponderous,⟪k:1⟫⟪k:2⟫as if weighted "
"down by the knowledge of their sins."
msgstr ""
"⟪k:0⟫Ogni loro passo lungo la scala a chiocciola è lento e ponderoso,⟪k:1⟫⟪k:2⟫come se fossero "
"appesantiti dalla consapevolezza dei propri peccati—"

#: scenario8:scenario8_BEE19C25_4387_4098_BC3E_91D6906BBC5A
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: ff6afe4bf3c55890bd3edada9e0fdf70e4fd630e865fea5014487e8e1946e79c
#. default-sha256: 011b013ecc0320a21639bee82e35bdb2d35a5b09988137befa9660ce4801d462
msgctxt "scenario8:scenario8_BEE19C25_4387_4098_BC3E_91D6906BBC5A"
msgid "⟪k:0⟫That they must make their way..."
msgstr "⟪k:0⟫dalla consapevolezza di doversi avviare..."

#: scenario8:scenario8_C4712DCB_C162_4710_879A_2EEF4DA9452E
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 15eb61a13daad67f01a5ac79e8ca9daddcb4e005ee636634008ea127ec5f82b5
#. default-sha256: 4f4ece39f334bd06030bc594ad57f502bf36fc99c708756a99f70c0862e5840b
msgctxt "scenario8:scenario8_C4712DCB_C162_4710_879A_2EEF4DA9452E"
msgid "⟪k:0⟫to the place they will make their atonement."
msgstr "⟪k:0⟫verso il luogo della loro espiazione."

#: scenario8:scenario8_C16EBD60_51C9_4BC5_8094_E87636C13BEB
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 94320b359ed51f6359c26c9484753d2bd75783dee52520b3bfcf56b47910b6ae
