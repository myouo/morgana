msgid "⟪k:0⟫⟪k:1⟫Well then..."
msgstr "⟪k:0⟫⟪k:1⟫Bene, allora..."

#: scenario8:scenario8_5DCA870D_5F4F_466E_8618_E250C3C08FE7
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 20f47e48f10a7bac86b15aada5169a70ce2c97a009b8fda1eee8c4474ac8c5fc
