msgid "⟪k:0⟫⟪k:1⟫Within me flows the blood of the previous lord!"
msgstr "⟪k:0⟫⟪k:1⟫Nelle mie vene scorre il sangue del precedente lord!"

#: scenario8:scenario8_3AFDFC3B_DE1C_4372_9397_9BF900F6B07E
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 6a92c1975f35596ac7cb3bc70522f118a0f26881cf7c433439d4e846b40c3f1d
#. default-sha256: 46eb67c5ba11a880f1d5fb9250e25745799d4c9d34b60e7f7f0aa0af7e806baa
msgctxt "scenario8:scenario8_3AFDFC3B_DE1C_4372_9397_9BF900F6B07E"
msgid "⟪k:0⟫⟪k:1⟫Behold, the Barniers’ golden ring!"
msgstr "⟪k:0⟫⟪k:1⟫Ammirate, l’anello d’oro dei Barnier!"

#: scenario8:scenario8_10CAE113_76BD_4632_A81E_C45CB576001A
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 12b5b12229ddd1e72e943fc827ce474c35ca03c8883e60e9516acd3e14c6abe8
