msgid "⟪k:0⟫⟪k:1⟫⟪k:2⟫Neither of you... ⟪k:3⟫saw any of that?"
msgstr "⟪k:0⟫⟪k:1⟫⟪k:2⟫Voi due... ⟪k:3⟫non avete visto nulla?"

#: scenario8:scenario8_C696CB66_9886_4AEB_92D8_CEDD527A2B97
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: ac8b98175b38ca98314b7de5de9911a22a9bfa5aa5768e479573380dfad8881c
#. default-sha256: 268f431a2cb23d8fc6b3800991bcd990d17410c8ccd34ca3134ba92c856e69e5
msgctxt "scenario8:scenario8_C696CB66_9886_4AEB_92D8_CEDD527A2B97"
