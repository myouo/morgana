msgid "⟪k:0⟫⟪k:1⟫⟪k:2⟫When did I first start straying from the path?⟪k:3⟫"
msgstr "⟪k:0⟫⟪k:1⟫⟪k:2⟫Quand’è che avevo iniziato a smarrire la strada?⟪k:3⟫"

#: scenario8:scenario8_5CE02E04_DBFD_40AC_9C60_98554641767A
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 7cabbd4677dd70329f940b16be90d7fad7bab993219e2909aee109997f7c3468
#. default-sha256: 1068e0c003029da4b33b8babb5008830419a93c32b0d465a783437dc39149d08
msgctxt "scenario8:scenario8_5CE02E04_DBFD_40AC_9C60_98554641767A"
msgid ""
"⟪k:0⟫⟪k:1⟫“Yes, I know her. ⟪k:2⟫Or, I knew her, years ago...”⟪k:3⟫⟪k:4⟫⟪k:5⟫“I see... What do "
"you want to do then, lord? ⟪k:6⟫You look sick.”⟪k:7⟫⟪k:8⟫⟪k:9⟫“This doesn’t change anything... We "
"lock the witch up and proceed as planned.”"
msgstr ""
"⟪k:0⟫⟪k:1⟫“Sì, la conosco. ⟪k:2⟫O meglio, la conoscevo...”⟪k:3⟫⟪k:4⟫⟪k:5⟫“Capisco... Cosa vuoi "
"fare allora, lord? ⟪k:6⟫Non hai una bella cera.”⟪k:7⟫⟪k:8⟫⟪k:9⟫“Questo non cambia niente... "
"Rinchiudiamo la strega, e procediamo come da programma.”"

#: scenario8:scenario8_6D2C6D70_9BC3_4FD6_88A7_E24794741573
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 0210551479a936baf1d8bf25d9cc93a05a243186606d5957d15df907d58e4259
