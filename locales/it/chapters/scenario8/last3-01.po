#: scenario8:scenario8_7271CF53_2F9D_4C71_BB5A_EFD55E3FD8B8
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 51fb98bc83f60c0f327a1b3b743941ad3dd74758f338c7d540af2b4ad12c3d55
#. default-sha256: d0c645464e2f9a21fe0f2004f10e5ecff3b48c1b1929e78ae7ce90e6274f482f
msgctxt "scenario8:scenario8_7271CF53_2F9D_4C71_BB5A_EFD55E3FD8B8"
msgid ""
"⟪k:0⟫After discussions I had no part in, it was decided that my uncle would be the next head. "
"⟪k:1⟫That they weren’t confident I had the spine to do the job properly."
msgstr ""
"⟪k:0⟫Dopo discussioni nelle quali non ebbi alcuna voce in capitolo,⟪k:1⟫venne deciso che sarebbe "
"stato mio zio il successore. ⟪k:2⟫Erano convinti che non avessi la spina dorsale per svolgere "
"correttamente quel ruolo."

#: scenario8:scenario8_14AA6030_BFFC_4D54_8F5F_CD1BA4D4AA3D
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 243ade11392ce0268796d8f2c2808121287c47de52b92c63f06a78dd15ef4f7d
#. default-sha256: 662cf70a998bf4c2dcdfd12ba09c94bbecf198d24f09e77a93f2b4ad4d19836b
msgctxt "scenario8:scenario8_14AA6030_BFFC_4D54_8F5F_CD1BA4D4AA3D"
msgid "⟪k:0⟫I wasn’t sure what to think."
msgstr "⟪k:0⟫Non sapevo cosa pensare."

#: scenario8:scenario8_826116EA_6045_40AC_A4A1_DE73A200E194
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 78a4ade1154de6281052a49bb4f5915cd544d34d2147abe1bba8f2fd9d7afcdf
#. default-sha256: f77b123c2278e39117485aec8388e1f36c2c4fb5cffaf7f9e7be8e5f13689a37
msgctxt "scenario8:scenario8_826116EA_6045_40AC_A4A1_DE73A200E194"
msgid "⟪k:0⟫If it meant I could go on with my quiet life,⟪k:1⟫I didn’t care who they picked."
msgstr ""
"⟪k:0⟫Se ciò significava poter continuare a vivere in tranquillità,⟪k:1⟫non mi importava chi "
"avrebbero scelto."

#: scenario8:scenario8_3A7480C5_2579_4E5D_BD3A_355A5A2BB7BC
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 1b1d64cef97b700afe019a5a8cd7accee93b4eb7efa222d02e30fc359c9c4857
#. default-sha256: 2770b913d2115b9e9079f4700e1e3efa9165cc6ff6f47865f02c81cfcc68f333
msgctxt "scenario8:scenario8_3A7480C5_2579_4E5D_BD3A_355A5A2BB7BC"
msgid ""
"⟪k:0⟫My uncle, though, seemed to have caught on to my apathy,⟪k:1⟫which he did not take kindly to,"
msgstr "⟪k:0⟫Mio zio, tuttavia, non tollerò il mio menefreghismo,"

#: scenario8:scenario8_0F9B4C2F_8D4B_457A_9E21_31B09E682CB3
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 36b65cadbc6802abf0f867e25369c14a5afa1207e56b6693c3b4514591a5fc17
#. default-sha256: ac6d852ddd775e046d6339ad5c9534b3ad655caeeeb459f21f10d5aab3096338
msgctxt "scenario8:scenario8_0F9B4C2F_8D4B_457A_9E21_31B09E682CB3"
msgid "⟪k:0⟫⟪k:1⟫So this is our new home, dearest Mell!"
msgstr "⟪k:0⟫⟪k:1⟫Dunque è questa la nostra nuova casa, caro Mell!"

