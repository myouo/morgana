#: scenario8:scenario8_BA103644_E5BA_4A61_A657_15137CCE2AB1
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 8466505f3275b2c56e2a9bf193c816916bd41b84b3bf1011910d3612e24b4848
#. default-sha256: eb40dd6045ef9b1d6f5f15edc28a604ad710c2be4de232ad06b3e7d206b793c9
msgctxt "scenario8:scenario8_BA103644_E5BA_4A61_A657_15137CCE2AB1"
msgid ""
"⟪k:0⟫You’re not going to go and say you want to return home in a couple months when you realize "
"life isn’t as luxurious here as it was back there, are you?"
msgstr ""
"⟪k:0⟫Non è che nel giro di un paio di mesi dirai di voler tornare a casa, quando ti renderai "
"conto che la vita qui non è lussuosa come quella che avevamo prima?"

#: scenario8:scenario8_D53E37F5_E62E_43EB_85DE_F5F5852B0380
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 725fb2df369cd3a06fbf056ddd9b54543f051b4e03bf4c4c75bcc0a4044c5c67
#. default-sha256: 5ae840f016b8c6b7a93c4d6bb97486f0442e8f7716006a899a486d9ab8b155ef
msgctxt "scenario8:scenario8_D53E37F5_E62E_43EB_85DE_F5F5852B0380"
msgid "⟪k:0⟫⟪k:1⟫There’s only one thing in the whole wide world I really need."
msgstr "⟪k:0⟫⟪k:1⟫C’è una sola cosa al mondo di cui ho davvero bisogno."

#: scenario8:scenario8_E9C7B0D6_955F_47A6_A1B6_B3B638AA981D
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: f5efd0949b8f46f5364038367b36c011dd19f0713d9c40d26f2e2ef8a846dd86
#. default-sha256: e535a5ab505a624e315a3c89e8c70cb9031a1b03d7ddf2b709b29e9b677e7ccd
msgctxt "scenario8:scenario8_E9C7B0D6_955F_47A6_A1B6_B3B638AA981D"
msgid ""
"⟪k:0⟫⟪k:1⟫Hehe. I’m as happy as I’ve ever been.⟪k:2⟫⟪k:3⟫I don’t need all that fancy, expensive "
"stuff."
msgstr ""
"⟪k:0⟫⟪k:1⟫Hehe. Sono felice come non mai.⟪k:2⟫⟪k:3⟫Non mi serve tutta quella roba costosa e "
"raffinata."

#: scenario8:scenario8_D08E366E_EA6D_46C9_9B0F_8668427BDBE3
