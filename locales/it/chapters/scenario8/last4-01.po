#: scenario8:scenario8_F7A52E00_EF02_4FB0_BE20_DDA30BC28DD2
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 4c141223874e4f6bc79b91ae62bd724330cc877acf8a4f9137a5092e464698e0
#. default-sha256: 573affce83a3d63249a515253c28c6dd4d15cee7bf119a47fcee8b3b690a3851
msgctxt "scenario8:scenario8_F7A52E00_EF02_4FB0_BE20_DDA30BC28DD2"
msgid ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫⟪k:4⟫Oh, thank goodness!⟪k:5⟫⟪k:6⟫You were out so good I was scared you might "
"be dead for a minute!"
msgstr ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫⟪k:4⟫Oh, grazie al cielo!⟪k:5⟫⟪k:6⟫Per un momento ho avuto paura che fossi "
"morto!"

#: scenario8:scenario8_77876211_4445_42BD_AB95_32AD2A489D48
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 96c1891e7bd6d2dd0511d5ae96ddd44eb9b35b783133ba0d8dffb2cb175fc063
#. default-sha256: 88e0b2fe7fed175507f9bc0c633d52afe26e5c3aed77eb9970a11f7122efb339
msgctxt "scenario8:scenario8_77876211_4445_42BD_AB95_32AD2A489D48"
msgid "⟪k:0⟫⟪k:1⟫⟪k:2⟫Good morning.⟪k:3⟫How are you feeling?"
msgstr "⟪k:0⟫⟪k:1⟫⟪k:2⟫Buongiorno.⟪k:3⟫Come ti senti?"

#: scenario8:scenario8_389ACB9F_C2DB_4348_B201_718B1D928DE7
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 5b9acb064842e735fbf55c5bf09cd6b24a66bb594e317e5f603a7d204a785c52
#. default-sha256: 0b13cf6677d210a1bf2461451935948c8d37725c6c38b1431af00b1d25a3512b
msgctxt "scenario8:scenario8_389ACB9F_C2DB_4348_B201_718B1D928DE7"
msgid ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫(It’s incredible how much more pleasant it is to be woken up by a woman than "
"a boy...)"
msgstr ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫(Non pensavo fosse così traumatico essere svegliato⟪k:4⟫da un ragazzino, "
"piuttosto che da una donna...)"

#: scenario8:scenario8_D4A207D5_34C3_4503_8EFC_84D4E1870A11
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: ce410221c8c8af0c148f50823235c0bc6f7e559a79bb7759aefc3eafff86ac83
