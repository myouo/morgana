msgctxt "scenario8:scenario8_F4B4F783_E865_4329_970A_47B5AEA0A51B"
msgid ""
"⟪k:0⟫Then use your miracle powers to deliver divine punishment on me.⟪k:1⟫⟪k:2⟫Go on. ⟪k:3⟫You "
"can do that, can’t you?"
msgstr ""
"⟪k:0⟫Allora usa i tuoi poteri miracolosi per infliggermi il castigo divino.⟪k:1⟫⟪k:2⟫Avanti, cosa "
"aspetti? ⟪k:3⟫Puoi farlo, no?"

#: scenario8:scenario8_8EE8C63C_F9E8_43C9_BC84_F49776BB24DB
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: a8e17d9ba7d61ce873496743cc0e81d93211d150af205a80febf80567d335072
