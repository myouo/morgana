msgid "⟪k:0⟫The Lord... ⟪k:1⟫is greatly displeased... ⟪k:2⟫with your actions!"
msgstr "⟪k:0⟫Il Signore... ⟪k:1⟫è enormemente dispiaciuto... ⟪k:2⟫per le tue azioni!"

#: scenario8:scenario8_F4B4F783_E865_4329_970A_47B5AEA0A51B
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: cebb38b1d7d9d19c30c2b377a798d7e7483dc817e116f6e53d1d0515a0750f3e
