msgid "⟪k:0⟫⟪k:1⟫⟪k:2⟫...Is there someone else in there with her?"
msgstr "⟪k:0⟫⟪k:1⟫⟪k:2⟫...C’è qualcun altro insieme a lei?"

#: scenario8:scenario8_8FE029FB_D592_49EB_9D67_18DFF2710A8C
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 301a88dab6e380c9989a66b7f28b619769a1c06d3f492eb7fdaaddbb524410d1
