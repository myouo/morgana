msgctxt "scenario8:scenario8_90CC1DC7_EBA9_415C_975A_E1CCEC9571C7"
msgid "⟪k:0⟫⟪k:1⟫Stay with me, please...⟪k:2⟫⟪k:3⟫Come on, you can’t give up now..."
msgstr "⟪k:0⟫⟪k:1⟫Resta con me, ti prego...⟪k:2⟫⟪k:3⟫Avanti, non puoi mollare adesso..."

#: scenario8:scenario8_313F8C9B_F6AE_4BEA_B463_2C2C77808735
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 1e16fcfefb511e7d302e36732f1ae57120193dcba40af10427334a162fc5bd7c
