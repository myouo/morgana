msgctxt "scenario8:scenario8_92250379_F847_47F5_9A2A_E0F63FB610C4"
msgid "⟪k:0⟫Still, she would tell me when we met up how she wished she could help even more people."
msgstr "⟪k:0⟫Ciò nonostante, continuava a dirmi quanto desiderasse poter aiutare ancora più gente."

#: scenario8:scenario8_BB3DF870_0BA7_46FF_98A4_4D74F6E907FC
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: f64682cb199dc02cc4cc6acc621cce6a6ce26a378c01941f1b6c6faa345c4e1f
