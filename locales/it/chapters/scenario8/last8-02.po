#: scenario8:scenario8_9BDA91B8_539C_4F5D_847A_7DA133F4322E
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 7cfa463518d23273529dfaec7603d3aa1d3cb0905d84371d3566fb3d2a37d7d1
#. default-sha256: 5ea886e4e8226e1c8235f6f4a0b41b07932edd8e5b544dc3635eacde57ea425f
msgctxt "scenario8:scenario8_9BDA91B8_539C_4F5D_847A_7DA133F4322E"
msgid "⟪k:0⟫Her response perplexed me to no end."
msgstr "⟪k:0⟫La sua risposta mi rese incredibilmente perplesso."

#: scenario8:scenario8_EC49C8BB_5FDB_4AE8_9EBB_AA9063A1CF4E
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 61659af0f4cf5fd89707a253bf13d71a8425bdeed157b548a0b239cc95430161
#. default-sha256: 5e21e5b1c55cba8812b370c59c8255fb76875f668dba8d77cafc33354e432c90
msgctxt "scenario8:scenario8_EC49C8BB_5FDB_4AE8_9EBB_AA9063A1CF4E"
msgid ""
"⟪k:0⟫Why was she concerned about showing gratitude?⟪k:1⟫⟪k:2⟫Why was she not despairing of her "
"own circumstances?"
msgstr ""
"⟪k:0⟫“Mostrare gratitudine”? ⟪k:1⟫Perché era ⟪k:2⟫quello⟪k:3⟫ il suo primo pensiero?⟪k:4⟫⟪k:5⟫"
"Perché non era disperata per le circostanze in cui si trovava?"

#: scenario8:scenario8_588F204E_BD55_492F_AE46_FEE88E4B0992
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 8679768a7b7f8e5251ddd6c4ea1890d3190bb83a75b62ccfdb077f44c177fac2
#. default-sha256: ad89fa7326078c6becc735df0469048a8af062f3727a70dfc94b51a57d153874
msgctxt "scenario8:scenario8_588F204E_BD55_492F_AE46_FEE88E4B0992"
msgid ""
"⟪k:0⟫Why was ⟪k:1⟫that⟪k:2⟫ the emotion that gripped her in that moment,⟪k:3⟫not hatred for the "
"slave trader or sorrow for herself?"
msgstr ""
"⟪k:0⟫Perché era ⟪k:1⟫quella⟪k:2⟫ l’emozione che l’attanagliava in quel momento,⟪k:3⟫e non l’odio "
"per il mercante di schiavi o la tristezza per se stessa?"

#: scenario8:scenario8_E741F2EC_7327_47BE_A7F8_6829F55F4BD7
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 9c6736f6b058e9007fe8b8f6316df13dcf8e667c384a1b939281038758d29be1
#. default-sha256: b25f3bf731cf3a0206ce8384007b759c4b43dcd62a711b92690712226c397df5
msgctxt "scenario8:scenario8_E741F2EC_7327_47BE_A7F8_6829F55F4BD7"
msgid "⟪k:0⟫But that wasn’t the only thing I found curious—"
msgstr "⟪k:0⟫Ma quella non era l’unica cosa che trovai curiosa—"

#: scenario8:scenario8_5208504F_1AAE_4F72_B6CB_E7190415914C
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 5bded3f58a3be89f2b8a4f6c5beec1d73a84696161d1feeec2d1524321fc4566
#. default-sha256: 605463b042a6918a1bb88603d24579ee902a2838341cb5e2c7e6bda48434aa88
msgctxt "scenario8:scenario8_5208504F_1AAE_4F72_B6CB_E7190415914C"
msgid "⟪k:0⟫untainted by its surroundings, gently undulating."
msgstr "⟪k:0⟫incontaminata da ciò che la circondava, e che ondeggiava dolcemente."

#: scenario8:scenario8_E504084A_9C20_45F3_912C_A7D0B10F5E4A
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 9f80f1d7c8d8eb5ff5c7b690f793cfc738c45d5a33ee6289a8dbe193ca4afde0
#. default-sha256: 110103b0aa22a69b8e07dc94238a7f6ee8cd3e1eeebec51604d3e676bf6ecf20
msgctxt "scenario8:scenario8_E504084A_9C20_45F3_912C_A7D0B10F5E4A"
msgid ""
"⟪k:0⟫One sentence was all she said, but there was something unbelievably calming about the sound "
"of it."
msgstr ""
"⟪k:0⟫Aveva detto un’unica frase, ma riuscivo comunque a percepire qualcosa di incredibilmente "
"rilassante nel suono della sua voce."

#: scenario8:scenario8_B8A4CC39_B636_4246_8280_80E8593A0BC9
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 000aa99e90016a3c70bf36628e1b114bbaca81acd5934c5abba32c643d4f78cc
#. default-sha256: c3b68d0b440110296e9f46168c86b9b4cfef17fb8224a9db64e44f317433e0c0
msgctxt "scenario8:scenario8_B8A4CC39_B636_4246_8280_80E8593A0BC9"
msgid ""
"⟪k:0⟫I wanted to get her out of that filthy carriage,⟪k:1⟫⟪k:2⟫to undo the shackles threatening "
"to taint her."
msgstr ""
"⟪k:0⟫volevo portarla via da quel carro sudicio,⟪k:1⟫⟪k:2⟫per rimuovere le catene che minacciavano "
"di macchiarla."

#: scenario8:scenario8_A6C67B8C_AC73_47DE_B7BA_2A35F735CC4D
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 5df8e16eeda995a812a3045f7b1e83db52a7b2e863c0922324ab8b286bd7767a
#. default-sha256: 6cf01f2884389491acfc1ace6b6ce87e16c4b947d644255261fa07d94f7afb90
msgctxt "scenario8:scenario8_A6C67B8C_AC73_47DE_B7BA_2A35F735CC4D"
msgid "⟪k:0⟫Please! Y-⟪k:1⟫You can have all my money!⟪k:2⟫You can go free, if that’s what you want!"
msgstr ""
"⟪k:0⟫Ti prego! P-⟪k:1⟫Puoi prendere tutto il mio denaro!⟪k:2⟫Sei libero di andartene, se è questo "
"che vuoi!"

#: scenario8:scenario8_E9304167_6DA8_4048_B3A9_C40F51B84193
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
