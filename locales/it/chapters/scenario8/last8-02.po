msgid "⟪k:0⟫............"
msgstr "⟪k:0⟫............"

#: scenario8:scenario8_7DBA9456_045C_4B81_80D9_855C84B146AD
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: fd95cd24537a23466097e97b5f5228486fafc59076b9f79d9e758b9a086ec186
#. default-sha256: 0b26ecf0759c64c22cf6a086936a69ae5dbcb9025cfdfdebdc52807e129f9826
msgctxt "scenario8:scenario8_7DBA9456_045C_4B81_80D9_855C84B146AD"
msgid "⟪k:0⟫What... ⟪k:1⟫Why are you laughing?!⟪k:2⟫⟪k:3⟫Please spare me!"
msgstr "⟪k:0⟫Cosa... ⟪k:1⟫Perché stai ridendo?!⟪k:2⟫⟪k:3⟫Per favore, risparmiami!"

#: scenario8:scenario8_356BBD69_CC39_40EF_B716_3DC3E83C717F
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 287a5afe94e6244d2ae98191be6d2fa511f0ed0d81371db5719ec29446ed03cf
#. default-sha256: 339c38fdab44f99a16352e2fa627360d7463ed6923e4784881c3e322e087630a
msgctxt "scenario8:scenario8_356BBD69_CC39_40EF_B716_3DC3E83C717F"
msgid ""
"⟪k:0⟫And why—⟪k:1⟫⟪k:2⟫⟪k:3⟫⟪k:4⟫⟪k:5⟫⟪k:6⟫                                             ⟪k:7⟫"
"should I care?"
msgstr ""
"⟪k:0⟫E perché mai—⟪k:1⟫⟪k:2⟫⟪k:3⟫⟪k:4⟫⟪k:5⟫                                             ⟪k:6⟫"
"dovrebbe importarmi?"

#: scenario8:scenario8_47E25499_1CB1_4FCD_812C_5E2E7E83CFEF
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 8902b8a3720b2a8f85ef7197811577117b8f2cad1026188fabf8802d6db22796
#. default-sha256: 3c0dd0b629477ec98907c7097ff31bf9bc276f401423023c7e8edc50c4aa13de
msgctxt "scenario8:scenario8_47E25499_1CB1_4FCD_812C_5E2E7E83CFEF"
msgid "⟪k:0⟫Look at this..."
msgstr "⟪k:0⟫Guardate..."

#: scenario8:scenario8_7A46B2FE_18AB_4BAF_89BD_43662D335722
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: f15f4bc926a8a8f945447bfedd50ba734fe18b2be66ea3c4b12a66504cae017f
#. default-sha256: fe95b4181156417a3b30cbad8c66ed0a62a63da7b6168f366677608e2c1adbb5
msgctxt "scenario8:scenario8_7A46B2FE_18AB_4BAF_89BD_43662D335722"
msgid "⟪k:0⟫They stood no chance against my strength!"
msgstr "⟪k:0⟫Non avevano alcuna possibilità contro la mia forza!"

#: scenario8:scenario8_B7204B16_FEB5_4ED8_9B3C_52F11A5F5D88
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: dd2c07151bd9ce3d2c79f176698621166b17c9d6187d13bfcad2a3de88a87def
#. default-sha256: 81062c3b452511d7692549da6058c61ea7bd5a8baaa3b986e7ade9b4e887012a
msgctxt "scenario8:scenario8_B7204B16_FEB5_4ED8_9B3C_52F11A5F5D88"
msgid ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫After taking the keys off one of the slave traders, I returned to the carriage, "
"doing my best to act calm and suppress the bubbling exhilaration."
msgstr ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫Dopo aver preso le chiavi dal mercante, tornai alla carrozza,⟪k:3⟫facendo del mio "
"meglio per apparire calmo e reprimere l’esaltazione che mi ribolliva dentro."

#: scenario8:scenario8_22D704DB_3077_46C5_B94C_2FE52D04285E
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 4ec96a292d986665c6591feaa1bb2bcb93e30e0057e3d74f3be3909333445e82
#. default-sha256: 9f60865a1a688201af3b41f23c36cce824fca2f3f0e6e4a9348667230b943ea9
msgctxt "scenario8:scenario8_22D704DB_3077_46C5_B94C_2FE52D04285E"
msgid "⟪k:0⟫⟪k:1⟫You.⟪k:2⟫"
msgstr "⟪k:0⟫⟪k:1⟫Ehi, dico a te.⟪k:2⟫"

