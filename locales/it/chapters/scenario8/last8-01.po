msgstr "⟪k:0⟫Heh heh... ⟪k:1⟫heh heh heh...⟪k:2⟫⟪k:3⟫hahahaha... ⟪k:4⟫AAAAAAAHAHAHAHA!"

#: scenario8:scenario8_DEC2EA83_12F0_4863_BF43_878D97A2F0EF
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 4ddea797829b1f27e8600244539e773c6ac873d8639cceb085f4411e22f44cde
#. default-sha256: cb4eed974a0b007a9b3aaaf71b4b822e3ea6af87600c716d7db85659f986ea7d
msgctxt "scenario8:scenario8_DEC2EA83_12F0_4863_BF43_878D97A2F0EF"
msgid "⟪k:0⟫I-⟪k:1⟫I have a wife... ⟪k:2⟫and children! Please!"
msgstr "⟪k:0⟫Ho—⟪k:1⟫ Ho una moglie... ⟪k:2⟫e dei figli! ⟪k:3⟫Ti prego!"

#: scenario8:scenario8_298B5185_05D6_4808_99AD_A2B0277FD14E
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 141a475fd6d02996f92268ebb107f833cbb35c3a98c909bee5eb39f8554a6f9f
#. default-sha256: 022cd5aa723f2eeba50f128a4ccf6a9dfc961b8987b7e0d620ce2d575cf58f29
msgctxt "scenario8:scenario8_298B5185_05D6_4808_99AD_A2B0277FD14E"
msgid ""
"⟪k:0⟫Even with the shackles still around my wrists, I had little trouble slaughtering the slave "
"traders and their guards."
msgstr ""
"⟪k:0⟫Nonostante avessi ancora le catene ai polsi, avevo avuto ben poche difficoltà ad annientare "
"il trafficante di schiavi e la sua scorta."

#: scenario8:scenario8_DDB36FD1_459A_41A4_BDCD_13E71889DFF8
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: a061c33ef4665fefccaffc07446a276dbae66a11a27ed2cbf9e632ff18433a2e
