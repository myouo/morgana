#: scenario4:scenario4_3A3AB18D_914F_4D7D_A8F8_47F3C26A1973
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: fc2f281e445e24ae016e436aa3bf52c804f84be0d3d315ee3d8d108f80d4e621
#. default-sha256: b00bc6b60e518f15c61f7c0790871dd01748e6c62b200c4248bd92f8c775579f
msgctxt "scenario4:scenario4_3A3AB18D_914F_4D7D_A8F8_47F3C26A1973"
msgid ""
"⟪k:0⟫It had been about a week since the White-Haired Girl had taken up residence in the mansion."
msgstr ""
"⟪k:0⟫Era passata circa una settimana da quando la Ragazza dai Capelli Bianchi si era stabilita "
"nella villa."

#: scenario4:scenario4_CA14D481_F927_4BC4_9958_89127B00B8B1
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 559f552120fc97b755e330dbef5f1125cdbca2fdfaa917a82c5380a9a37ae761
#. default-sha256: 92cd79321a5c5e7c8010cf0c68ba14e70d57831f698ecd25b50dd7e9efbcb2b8
msgctxt "scenario4:scenario4_CA14D481_F927_4BC4_9958_89127B00B8B1"
msgid ""
"⟪k:0⟫Staying in that house deprived of light was, I imagine, a very claustrophobic experience."
msgstr ""
"⟪k:0⟫Credo che stare in quella casa priva di luce fosse un’esperienza alquanto claustrofobica."

#: scenario4:scenario4_A191B3E2_744B_40E6_BC31_09F8B9BC8D69
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: ab1e9f182c6a7bcf9ca7f894f74e7877eb6f89956262f3ca44887c7f44b65727
#. default-sha256: 92f229d1f897eed1a9ac8ff8b88e6ae71e3b9e55a4f022b0ea3c79fef7ca021f
msgctxt "scenario4:scenario4_A191B3E2_744B_40E6_BC31_09F8B9BC8D69"
msgid ""
"⟪k:0⟫To anyone blessed enough to have sunlight as a part of their everyday lives, it would have "
"been unbearable."
msgstr ""
"⟪k:0⟫Per chiunque fosse stato abbastanza fortunato da godere della luce⟪k:1⟫del sole ogni giorno "
"della propria vita, sarebbe stata un’esistenza insopportabile."

#: scenario4:scenario4_FAFA92C5_1D4E_459F_9D64_B65AFCC317F0
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 298960ec3b0a04d0b268ef51a52bad77ce8b00833b1c4e26caea28ffeff31d03
#. default-sha256: 082d240e6cc3efa2a2591fbd3a605e16c072245ea46b435b8eb4a59a74562d48
msgctxt "scenario4:scenario4_FAFA92C5_1D4E_459F_9D64_B65AFCC317F0"
msgid ""
"⟪k:0⟫But for her, the mansion—⟪k:1⟫⟪k:2⟫with its prison walls and lack of either illumination or "
"recreation—"
msgstr ""
"⟪k:0⟫Ma per lei, quella villa—⟪k:1⟫⟪k:2⟫con le sue mura carcerarie e la mancanza di qualsivoglia "
"luce o opportunità di svago—⟪k:3⟫⟪k:4⟫era l’unico luogo dove potesse trovare sollievo."

#: scenario4:scenario4_2C19D17D_1B86_464E_BD1A_5D58985CF708
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 6faa8a11d6761121165088d7cc4e1f9620a22704b21e0fffe34f04e387473cfe
#. default-sha256: 4fa29949a33b684f8520307b9ef21f7082f1d58c8c59a80441ea86e33befd4a3
msgctxt "scenario4:scenario4_2C19D17D_1B86_464E_BD1A_5D58985CF708"
msgid "⟪k:0⟫She and Michel continued to be distant, however."
msgstr "⟪k:0⟫Tuttavia, lei e Michel continuavano ad essere distanti."

#: scenario4:scenario4_41A0DF7B_FEF0_4138_9D23_61C4F5FABF7B
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: d435e04b9dfcdd13314a50bd0a9a68135b562a23bebd80ff8dbe72a2500b7a7f
#. default-sha256: dd00011b23fbac1fe5e67c11feabb659e0fa2e49a749d2fa2278abe775773842
msgctxt "scenario4:scenario4_41A0DF7B_FEF0_4138_9D23_61C4F5FABF7B"
msgid ""
"⟪k:0⟫He spent most of his time in his chambers, which he had explicitly told the White-Haired "
"Girl to stay out of, leaving her unable to close that gap."
msgstr ""
"⟪k:0⟫Lui trascorreva la maggior parte del suo tempo nella propria camera, nella quale aveva "
"esplicitamente ordinato alla Ragazza dai Capelli Bianchi di non entrare, impedendole di ridurre "
"quel distacco."

#: scenario4:scenario4_419AA7BE_CF8A_47D9_B354_FE57A702C379
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: ca02d685ad67ad68462a9e8404c13d2fe2c489e04cb1f76dcc51d4fc4878ac67
#. default-sha256: ab9908c7569929d4837b3383694ea58172cf70b0c1a6d6fdbf152d0ea0399102
msgctxt "scenario4:scenario4_419AA7BE_CF8A_47D9_B354_FE57A702C379"
msgid ""
"⟪k:0⟫Nonetheless, on the occasions they did cross paths in the hallway,⟪k:1⟫their eyes would meet—"
"⟪k:2⟫⟪k:3⟫if but briefly."
msgstr ""
"⟪k:0⟫Ciò nonostante, in quelle occasioni in cui le loro strade si incrociavano,⟪k:1⟫i loro occhi "
"si sarebbero incontrati—⟪k:2⟫⟪k:3⟫anche se per poco."

#: scenario4:scenario4_BA131BFB_3883_4E0E_AA4B_FCA79D169316
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: bf3c11c12b1fa522681bda99227c5ea7c66c4ea8dc7f4dd65cc999a8b5f6f214
#. default-sha256: 8570a852d9578262a0f2e5b1c60c640c31aee34f1a419bde12580f30ae992174
msgctxt "scenario4:scenario4_BA131BFB_3883_4E0E_AA4B_FCA79D169316"
msgid ""
"⟪k:0⟫It was never for more than a few seconds.⟪k:1⟫⟪k:2⟫Whenever she saw him, she made a point of "
"giving him a little smile."
msgstr ""
"⟪k:0⟫Non era mai per più di qualche secondo.⟪k:1⟫⟪k:2⟫Ogni volta che si vedevano, lei si "
"premurava di sorridergli."

#: scenario4:scenario4_E589D0D3_9447_4659_B771_8331DEB129FD
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 213d225139d98eea4ff6c61731d7bdea387e0da3419562851eea6348ac7895c4
#. default-sha256: 208878cdc6f90f049e3590e74b8e9956b1b4fea3e46d8d36f6cc33d212369653
msgctxt "scenario4:scenario4_E589D0D3_9447_4659_B771_8331DEB129FD"
msgid ""
"⟪k:0⟫He never said anything, but still, when she had first arrived, he would not have even met "
"her gaze."
msgstr ""
"⟪k:0⟫Lui non diceva mai nulla.⟪k:1⟫ All’inizio, quando era appena arrivata,⟪k:2⟫non l’avrebbe "
"degnata nemmeno di uno sguardo."

#: scenario4:scenario4_47AC4865_F13E_483C_B557_9E8D0D9C0774
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 96fdffee970d07ad2124344fdc6b988b4f29dc51808fab80d2bf941449cca523
#. default-sha256: b5e91f3fad579a81396462799346e70d69b80768909cbc3d54f732b3f885323b
msgctxt "scenario4:scenario4_47AC4865_F13E_483C_B557_9E8D0D9C0774"
msgid "⟪k:0⟫He seemed to be taking more and more notice of her."
msgstr "⟪k:0⟫Eppure sembrava che stesse cominciando a fare sempre più caso a lei."

#: scenario4:scenario4_9050C588_7A68_4FEA_8488_372AA36F7653
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 7f037444f06ab912dd040b820cf116b0a5f861e4fe2d128157736e5a78559ae2
#. default-sha256: c4fbf6dbd199a4535682993729e36309d3427c86937eb4bdffea547371051113
msgctxt "scenario4:scenario4_9050C588_7A68_4FEA_8488_372AA36F7653"
msgid "⟪k:0⟫⟪k:1⟫One day, the White-Haired Girl stood in the cellar, a frown on her face."
msgstr ""
"⟪k:0⟫⟪k:1⟫Un giorno, la Ragazza dai Capelli Bianchi si trovava giù in cantina,⟪k:2⟫con "
"un’espressione accigliata."

#: scenario4:scenario4_1FAD219B_A05E_47E3_9C94_1A264074123E
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 8b9b806de9c54860850273d873730b8c20b64f70507353087e83d14cf49573ca
#. default-sha256: 193413d7e2481b774be60fce43486e0921ef95843b547638d8780eea524e4801
msgctxt "scenario4:scenario4_1FAD219B_A05E_47E3_9C94_1A264074123E"
msgid ""
"⟪k:0⟫(Well, this is troubling...⟪k:1⟫⟪k:2⟫I can’t go down to the village...⟪k:3⟫⟪k:4⟫but if we "
"don’t do something soon...)"
msgstr ""
"⟪k:0⟫(Beh, questo sì che è un problema...⟪k:1⟫⟪k:2⟫Non posso scendere al villaggio...⟪k:3⟫⟪k:4⟫ma "
"se non facciamo qualcosa al più presto...)"

#: scenario4:scenario4_C7C31BBE_4520_4B03_895C_9A9E2E31B043
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: a276dd232ac2a42f577922d5aec3fdb827b2884698374b8553ad6b59044cca3d
#. default-sha256: 48f41697b22461c825c2f67ac00db3078091b23a05c42741f58ec0ffc02c435d
msgctxt "scenario4:scenario4_C7C31BBE_4520_4B03_895C_9A9E2E31B043"
msgid "⟪k:0⟫............"
msgstr "⟪k:0⟫............"

#: scenario4:scenario4_6772CFC4_884E_4AA8_BC06_143BC8034363
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 28ee0c9f39560a37721beb001871036031cc5b9a69228aa98206563a557b4638
#. default-sha256: fb3b37f534e47b838fd91a4defa389ea89602b486253915dd4af61e78ad700aa
msgctxt "scenario4:scenario4_6772CFC4_884E_4AA8_BC06_143BC8034363"
msgid ""
"⟪k:0⟫The cellar was where their food was stored—⟪k:1⟫⟪k:2⟫an assortment of nonperishables and "
"dried foods, smoked meats and cheeses."
msgstr ""
"⟪k:0⟫Era in cantina che il loro cibo era riposto—⟪k:1⟫⟪k:2⟫un assortimento di cibi secchi e a "
"lunga conservazione, tra cui carni e formaggi affumicati."

#: scenario4:scenario4_7DF38F10_3DF3_45C1_9032_8EFC0EB9C983
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 36451a97768b539aa099d7eaa19588737f344dcb31b95697f859a7bc4da00fcc
#. default-sha256: 0a8c9bb7d4f38be880b5864a96d638aee306a897d25b84613a6bcce0de10784b
msgctxt "scenario4:scenario4_7DF38F10_3DF3_45C1_9032_8EFC0EB9C983"
msgid ""
"⟪k:0⟫Her daily meals were taken from the supplies there. ⟪k:1⟫However, the stockpile was "
"beginning to grow quite small."
msgstr ""
"⟪k:0⟫I loro pasti quotidiani venivano prelevati da quelle scorte.⟪k:1⟫⟪k:2⟫Tuttavia, le provviste "
"stavano iniziando a scarseggiare."

#: scenario4:scenario4_9D1FF1CA_1B11_4CEC_884A_BED48D6AC2ED
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 81f3cb34a21fffe0084f805b06d75cd581fa42dd619b1358123d7f246aab4bd3
#. default-sha256: 9d9294a54d5b346c1a663cfe1f2bc529fd57f5cd8a9d6bffaccf801c8a5a9465
msgctxt "scenario4:scenario4_9D1FF1CA_1B11_4CEC_884A_BED48D6AC2ED"
msgid "⟪k:0⟫Were she not on the run, she could have gone to the village to procure more."
msgstr ""
"⟪k:0⟫Se non fosse stata in fuga dagli abitanti del villaggio, avrebbe potuto raggiungerlo per "
"procurarsi altro cibo."

#: scenario4:scenario4_2E697E6F_E846_4699_A77B_01ABD9A7FE97
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: bb06fc21f56e0e837388bff8120efd550c7dd4c284a9400296ea50a486430308
#. default-sha256: f1dd46b947af7eb667755271470a58e098c94ced74dfb5e6513911a8d065c6ee
msgctxt "scenario4:scenario4_2E697E6F_E846_4699_A77B_01ABD9A7FE97"
msgid ""
"⟪k:0⟫Or perhaps, were she a little tougher, she could have captured a wild animal for its meat."
msgstr "⟪k:0⟫Oppure, se fosse stata più tenace, avrebbe potuto catturare un animale selvatico."

#: scenario4:scenario4_AD7A4BAA_BA3E_43B8_9766_C2C60BF2E6DB
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 900e6e83f5460908eed9c666ecfc5bf689cb9269584eb23c62080da7a914421f
#. default-sha256: f6fa45daa16abe62a8e449e20260ce1d056601fa469aa062aac1381cd4dc4c2c
msgctxt "scenario4:scenario4_AD7A4BAA_BA3E_43B8_9766_C2C60BF2E6DB"
msgid ""
"⟪k:0⟫Hehe... ⟪k:1⟫But Master, you know a young, delicate thing like her was hardly up to the task "
"of hunting for food."
msgstr ""
"⟪k:0⟫Hehe... ⟪k:1⟫Ma Padrone, lei sa che una ragazza giovane e delicata come lei non era indicata "
"per il compito di procurare il cibo."

#: scenario4:scenario4_058A15FB_40C9_4C42_B7C6_7467071F65FD
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 79178795bc0f61c20257f8ad480961b224dba3dfb0875f5a1adeea18e68715c3
#. default-sha256: 2f50742189f23a5f079d4039ee2c879bd2606e881ca3312c365027dcb0c8c813
msgctxt "scenario4:scenario4_058A15FB_40C9_4C42_B7C6_7467071F65FD"
msgid "⟪k:0⟫How does he normally get his supplies, I wonder?"
msgstr "⟪k:0⟫Mi chiedo come faccia per rifornirsi..."

#: scenario4:scenario4_0F8AAD60_039D_4743_90BB_E791E77745CE
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: f3096199fb8b11169456d0e7b7ac7424826a2fec6be5958393c7c37413552db9
#. default-sha256: 6c7c18c81fb7263bf6cb9af0f147742052fa48e6245f521f2481745673a573bb
msgctxt "scenario4:scenario4_0F8AAD60_039D_4743_90BB_E791E77745CE"
msgid ""
"⟪k:0⟫From there, other questions about Michel started rising in her mind. ⟪k:1⟫No matter how "
"lifeless he seemed..."
msgstr ""
"⟪k:0⟫Da quel momento, altre domande su Michel iniziarono a sollevarsi nella sua testa. ⟪k:1⟫Non "
"importava quanto lui apparisse esanime..."

#: scenario4:scenario4_87865C14_5F55_44EC_942E_30D9AA895D4C
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: d5c807829eced8e75ffee6e5606b4e290d3242abfac4a45be3b6074ab5590fe6
#. default-sha256: 044c388cdc974255adc2659ced6cec4776a6ba3c401930c0359b66c7c0e390d2
msgctxt "scenario4:scenario4_87865C14_5F55_44EC_942E_30D9AA895D4C"
msgid "⟪k:0⟫⟪k:1⟫surely⟪k:2⟫ he still had to eat, right?"
msgstr "⟪k:0⟫doveva ⟪k:1⟫pur⟪k:2⟫ mangiare, no?"

#: scenario4:scenario4_C7D68F39_01B3_452B_97D1_6070B28AC292
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 82bcc0409f6704706ac27f058dc297029b571967f5a75e3b56ebbe707149a40a
#. default-sha256: f8191eeedd1749e8c8f464852462f039432e63b07e556e283b4246f3f0a1b408
msgctxt "scenario4:scenario4_C7D68F39_01B3_452B_97D1_6070B28AC292"
msgid ""
"⟪k:0⟫The White-Haired Girl nodded, then made her way out of the cellar, intending to head for his "
"bedchamber."
msgstr ""
"⟪k:0⟫La Ragazza dai Capelli Bianchi annuì, poi lasciò la cantina,⟪k:1⟫intenzionata a raggiungere "
"la camera da letto del padrone di casa."

#: scenario4:scenario4_4D147211_E99D_42C2_B81C_D7CE886146E1
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 135c5bfebe0e866827c6878b1966163ab2f427a39095a4a6156b97f568674cf2
#. default-sha256: 288ec68d25382eb9433193b808702d17a96fb8a94b27f7c2ed05e9d8f26f4930
msgctxt "scenario4:scenario4_4D147211_E99D_42C2_B81C_D7CE886146E1"
msgid "⟪k:0⟫⟪k:1⟫⟪k:2⟫Ah..."
msgstr "⟪k:0⟫⟪k:1⟫⟪k:2⟫Ah..."

#: scenario4:scenario4_3B0F559A_0143_4023_936D_B8594593E90A
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 1606a74aba99af83c01bfdad879f5257d17881b7e9340622dad0fa8e74266076
#. default-sha256: fae4f4c6398cc35b3841267d5902a28363bf9cec576bfd847ac3830f4f49adf9
msgctxt "scenario4:scenario4_3B0F559A_0143_4023_936D_B8594593E90A"
msgid "⟪k:0⟫But on her way there, she spotted him standing by the entrance,"
msgstr "⟪k:0⟫Ma lungo la strada, avvistò l’uomo davanti all’ingresso della villa,"

#: scenario4:scenario4_E0603546_E5DC_49EA_85A5_308CDFAB747B
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 43f12f457d2f92f558a1a2c8c7aef8f3a4a1569f84ec9c78e70acd90d530bbdd
#. default-sha256: 74170090e1267a6532d30661b137e524f8b02d262a30fb9030daa20b4f6658fc
msgctxt "scenario4:scenario4_E0603546_E5DC_49EA_85A5_308CDFAB747B"
msgid ""
"⟪k:0⟫staring motionless at the door, lit by a single candle. ⟪k:1⟫He appeared to be waiting for "
"something."
msgstr ""
"⟪k:0⟫mentre fissava immobile la porta, illuminato da una singola candela. ⟪k:1⟫Sembrava stesse "
"aspettando qualcosa."

#: scenario4:scenario4_F165E07F_0730_4DD0_BBF8_22866D9D8BAE
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 1b2336b42209c841f41f0b68cd95f97a0bc70d64d0abe4823addf87c17c7f55e
#. default-sha256: 0710aca3a4dc1631eb70d03b7920c73438d3e7f46d7a3afdda8e9b7402be82f7
msgctxt "scenario4:scenario4_F165E07F_0730_4DD0_BBF8_22866D9D8BAE"
msgid "⟪k:0⟫Um..."
msgstr "⟪k:0⟫Ehm..."

#: scenario4:scenario4_561B3E19_6D73_4271_B805_36A8F0766D4A
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 33cfe2ab2802f9c576c06961c86ff2364362be144e518ae8b8a709920d69f962
#. default-sha256: 1c812955ab9bac78e3a90e06d812791e1961c834f796f1436b7f9a497f0f3238
msgctxt "scenario4:scenario4_561B3E19_6D73_4271_B805_36A8F0766D4A"
msgid "⟪k:0⟫⟪k:1⟫⟪k:2⟫............"
msgstr "⟪k:0⟫⟪k:1⟫⟪k:2⟫............"

#: scenario4:scenario4_BB3FEDC7_2916_48C0_8656_991CDA3D5EBA
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 2e7d432c8baa4d2bc71a93fcb85319c922bc38c9e3637b99ccebcf3a794c95f7
