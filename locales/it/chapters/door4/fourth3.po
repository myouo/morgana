msgid ""
"⟪k:0⟫The crate was fairly hefty; ⟪k:1⟫the slightly built girl had considerable difficulty "
"bringing it into the house."
msgstr ""
"⟪k:0⟫Il baule era piuttosto pesante; ⟪k:1⟫con la corporatura che aveva,⟪k:2⟫la ragazza ebbe "
"considerevoli difficoltà a portarlo dentro casa."

#: scenario4:scenario4_B209F362_E56D_4702_B665_2D9FEC5833CE
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: de78b0dc35264fa09047733eb8eda98d8978ddab2182cb0ce4631781fb30f588
