msgid "⟪k:0⟫⟪k:1⟫Do whatever you like... ⟪k:2⟫As long as..."
msgstr "⟪k:0⟫⟪k:1⟫Fai pure come desideri... ⟪k:2⟫fintanto..."

#: scenario4:scenario4_EF556DD7_E0BA_4AE3_8F56_32EB6D3A8B1F
