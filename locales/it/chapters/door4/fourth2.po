msgid "⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫I want to repay you for allowing me to stay here..."
msgstr "⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫Vorrei ripagarla per avermi permesso di restare..."

#: scenario4:scenario4_5D5AB78C_0984_436E_A62A_E3D175B98131
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 151b1d38acdc313d498ca059a136e3514056879958a535c75a7cf4f387b93acd
#. default-sha256: 5bc0a2940e1cfe9d7698a78b6fe17516b7c17c2e10e8c1a85356610fb08e19b5
msgctxt "scenario4:scenario4_5D5AB78C_0984_436E_A62A_E3D175B98131"
msgid ""
"⟪k:0⟫⟪k:1⟫You need not feel indebted to me.⟪k:2⟫⟪k:3⟫The weight of that obligation will only turn "
"into disdain."
msgstr ""
"⟪k:0⟫⟪k:1⟫Non devi sentirti in debito con me.⟪k:2⟫⟪k:3⟫Il peso di quest’obbligo non farà che "
"trasformarsi in disprezzo."

#: scenario4:scenario4_5989BD40_9C21_4DF3_BC15_C6D54F5A1546
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: ec6e3a68cf3a8046dc76765badd1b125d4f6c3817c50862da61b95b4e8355364
