msgid "⟪k:0⟫⟪k:1⟫⟪k:2⟫B-⟪k:3⟫But... ⟪k:4⟫I can’t just stay here and do nothing..."
msgstr "⟪k:0⟫⟪k:1⟫⟪k:2⟫M-⟪k:3⟫Ma... ⟪k:4⟫non posso restare qui senza far niente..."

#: scenario4:scenario4_50086CCC_ABE3_4BC5_BF22_BCA61B0D64F1
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 153b550b5c2761b70f4d728890e41155510f5a9777ab9b07fe02b213b1fe3acd
