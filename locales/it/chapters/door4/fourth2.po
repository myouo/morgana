msgstr "⟪k:0⟫⟪k:1⟫⟪k:2⟫............"

#: scenario4:scenario4_C59BA84F_5331_4567_A82E_6BA83629ACDD
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 27ea692caad84e4888e61ec5aa71e9a4dce91f064adabe75fea6c63ac28b87ee
#. default-sha256: 85c7da3f98520ec3c7d80f3a36bd29558744e40b6c1edb442bd92388700f195b
