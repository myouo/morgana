msgctxt "scenario4:scenario4_C231E26C_8323_44D6_A318_3DB948571F9E"
msgid "⟪k:0⟫and they eventually began to take each other’s lives."
msgstr "⟪k:0⟫e infine cominciarono a uccidersi a vicenda."

#: scenario4:scenario4_98DF4AD6_699B_490B_98F3_DFC68EF93678
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: c1f9bddb7e1e0cd77ba68834cdd2d687ab1e5c09b445553f5a60184975e9d1c7
