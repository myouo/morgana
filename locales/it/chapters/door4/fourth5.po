msgid ""
"⟪k:0⟫A fleeting moment between a young man with a cursed touch, and a kindhearted, beautiful girl."
msgstr ""
"⟪k:0⟫Un momento sfuggente tra un giovane uomo dal tocco mortale,⟪k:1⟫e una splendida ragazza dal "
"cuore d’oro."

#: scenario4:scenario4_15D378AF_D324_43E0_A1CA_8C82B84F2233
