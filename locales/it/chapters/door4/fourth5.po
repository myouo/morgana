#: scenario4:scenario4_D8C730E6_D220_4BD2_B4DB_B03613FE9E14
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 7ca23413389ee5e70669e258b8a57829cf11ed4611beb964203be7d8bb0f749e
#. default-sha256: 9bf4e73e045bd23f6364ca23805e0da5580b90f17a5eeca5fe25765a2d54a926
msgctxt "scenario4:scenario4_D8C730E6_D220_4BD2_B4DB_B03613FE9E14"
msgid ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫⟪k:4⟫⟪k:5⟫⟪k:6⟫⟪k:7⟫⟪k:8⟫⟪k:9⟫⟪k:10⟫⟪k:11⟫⟪k:12⟫⟪k:13⟫⟪k:14⟫⟪k:15⟫⟪k:16⟫⟪k:17⟫"
"⟪k:18⟫⟪k:19⟫⟪k:20⟫⟪k:21⟫⟪k:22⟫And that marked the true beginning of their quiet days together in "
"the dark mansion."
msgstr ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫⟪k:4⟫⟪k:5⟫⟪k:6⟫⟪k:7⟫⟪k:8⟫⟪k:9⟫⟪k:10⟫⟪k:11⟫⟪k:12⟫⟪k:13⟫⟪k:14⟫⟪k:15⟫⟪k:16⟫⟪k:17⟫"
"⟪k:18⟫⟪k:19⟫⟪k:20⟫⟪k:21⟫⟪k:22⟫E questo segnò il vero inizio della loro vita insieme nella dimora "
"oscura."

#: scenario4:scenario4_F085551F_4068_4559_A67F_4A1C65501FE9
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 831c819c3d779b878bf002469b69a87abf9a29c81306a5d1199b2c85eddcb610
#. default-sha256: 7e45f1ce56d00ff20acddb699077e912c4b4ab2b710c152f5ea8980a4e5405ef
msgctxt "scenario4:scenario4_F085551F_4068_4559_A67F_4A1C65501FE9"
msgid ""
"⟪k:0⟫They acknowledged and accepted each other’s presence, no longer isolating themselves, but "
"actively, regularly conversing."
msgstr ""
"⟪k:0⟫Avevano entrambi riconosciuto e accettato la presenza dell’altro,⟪k:1⟫non più isolandosi, "
"bensì conversando regolarmente."

#: scenario4:scenario4_934438FF_AB82_4D4C_96E2_98AD5581A9ED
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 943b03e625286fa7532ad645f9ea70abd91dc66d24e862200203b6bf97e2af67
#. default-sha256: f3e26fcb9d18c7fd7ca86538e92c0b816bade3dd7d2ee4752d3375cbe4e13966
msgctxt "scenario4:scenario4_934438FF_AB82_4D4C_96E2_98AD5581A9ED"
msgid ""
"⟪k:0⟫As mundane as it might seem, it was something they had been unable to attain until then."
msgstr ""
"⟪k:0⟫Per quanto banale potesse sembrare, era qualcosa che prima di allora non erano ancora "
"riusciti ad ottenere."

#: scenario4:scenario4_F1DB41FD_7525_49AD_9B08_BE017AF4B59C
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 2548de4245b2a98eb1832de31ce8644321932f3d818ccfa723e45c44938282da
#. default-sha256: 930eec6ca0b1e56dd6c35809d44bb09a4019da50be8bf7e1ef0b6c4ef68ee19e
msgctxt "scenario4:scenario4_F1DB41FD_7525_49AD_9B08_BE017AF4B59C"
msgid ""
"⟪k:0⟫Nevertheless, they were still somewhat fumbling around in the dark with one another, drawing "
"closer and pushing away again."
msgstr ""
"⟪k:0⟫Nonostante ciò, si rapportavano ancora maldestramente a vicenda, avvicinandosi e "
"allontanandosi l’un l’altra."

#: scenario4:scenario4_8FEAAD6E_DEF7_4BF9_983B_A2DB5D1404F0
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 434a07474d7a700b15980e942362b36fb359ebe118deaff79661ba0db1b526fd
#. default-sha256: 0dfe34bef6b3f966521868165b8413aa08236ad8bfbcc36ee5b4d9d541a04c1e
msgctxt "scenario4:scenario4_8FEAAD6E_DEF7_4BF9_983B_A2DB5D1404F0"
msgid ""
"⟪k:0⟫Michel, in his own ungraceful way, was beginning to open himself up to the things she said,"
msgstr "⟪k:0⟫Michel, nei suoi modi privi di grazia, aveva iniziato ad aprirsi a lei,"

#: scenario4:scenario4_26C4B32C_F056_4E69_A1BF_1C2B822B551A
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: a0b45c96cfcbe7bad06f4783844a3793b1e45e8e78c177e43f1c999849bb6e38
#. default-sha256: 6cf39e714950a908682bb267b16fbe7573eacaa032837ebc804966718a298e68
msgctxt "scenario4:scenario4_26C4B32C_F056_4E69_A1BF_1C2B822B551A"
msgid "⟪k:0⟫and the White-Haired Girl was beginning to smile with greater frequency."
msgstr "⟪k:0⟫e la Ragazza dai Capelli Bianchi aveva iniziato a sorridere con più frequenza."

#: scenario4:scenario4_0E8068CF_1E52_4198_89D8_E1C794B849A0
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 9329a5299cfee125a629bb092ed36150b2e25b705be5d7fb544f8bf5a80f6f48
#. default-sha256: 84d69e843181e46813b2b9af4c5c3b18e05934e5316f8f8a5926e2ae4de97ea8
msgctxt "scenario4:scenario4_0E8068CF_1E52_4198_89D8_E1C794B849A0"
msgid "⟪k:0⟫They had taken to dining together, and her wish of learning to read was being granted."
msgstr ""
"⟪k:0⟫Cominciarono a cenare insieme, e il desiderio della ragazza di imparare a leggere venne "
"esaudito."

#: scenario4:scenario4_54D32434_00B1_47B9_BD97_C3623016EE94
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: f2544f003c40eddf635596c7bbfd7e03ea4e502c94587a12e23671bfcad4cb8a
#. default-sha256: 53da04a401da6ac123ac8307ef236533f800cb3982e127c1e6678f0e63387950
msgctxt "scenario4:scenario4_54D32434_00B1_47B9_BD97_C3623016EE94"
msgid ""
"⟪k:0⟫He taught her in the feeble light of a candle placed upon the table, the two sitting across "
"from one another."
msgstr ""
"⟪k:0⟫L’uomo le dava lezioni sotto la debole luce di una candela posta al centro del tavolo, "
"mentre i due stavano seduti l’uno di fronte all’altra."

#: scenario4:scenario4_FD793E1F_F6F9_441C_B905_B179018226C5
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 062c680783dae23c230c0b726a431bfea4d2295dbf13baeda8d33dc76bfbc803
#. default-sha256: c4554a51e372413fb14c4a30f633fdfc575db46eec3b3802177b832b2d17bbec
msgctxt "scenario4:scenario4_FD793E1F_F6F9_441C_B905_B179018226C5"
msgid ""
"⟪k:0⟫Though Michel seemed to be well educated, he had not been instructed in the art of teaching, "
"so he found the process quite grueling."
msgstr ""
"⟪k:0⟫Sebbene Michel fosse ben istruito, non aveva appreso l’arte dell’insegnamento, per cui "
"trovava il compito piuttosto arduo."

#: scenario4:scenario4_397AB7EF_2D6D_4E70_AFC4_AA1C02627DB5
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: b12af4587d3f58967f7e563e54350eb557c408f8863d2e71e50658802c18902d
#. default-sha256: 8eb7e465d2f789e265bbf22f4a34d9b769eea1d889a4e29bc181c6df9b95ded5
msgctxt "scenario4:scenario4_397AB7EF_2D6D_4E70_AFC4_AA1C02627DB5"
msgid ""
"⟪k:0⟫But to the White-Haired Girl, the longer it took the better;⟪k:1⟫⟪k:2⟫her primary objective "
"was, after all, to spend time with him."
msgstr ""
"⟪k:0⟫Ma per la Ragazza dai Capelli Bianchi, più tempo richiedeva e meglio era;⟪k:1⟫ il suo "
"principale obiettivo, dopotutto, era quello di trascorrere più tempo possibile con lui."

#: scenario4:scenario4_169BCDD3_EA39_4040_91FA_8DEA88A1E072
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: a1dd00df49fba5bb57a461809477fe9daadadc479b791928ba9f704691c905a4
#. default-sha256: 16848c2541b7d546e7083d4f71557affaac910e9976ff9dd21a5686ca07c3b66
msgctxt "scenario4:scenario4_169BCDD3_EA39_4040_91FA_8DEA88A1E072"
msgid "⟪k:0⟫The days passed,"
msgstr "⟪k:0⟫I giorni passavano,"

#: scenario4:scenario4_864C6DC9_F3F0_4202_9C3D_51E1AA4616BD
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: e479a8cd4d28bc5dfa15c80a0bd9f52c4419c894b3388dc2b21625af756a1937
#. default-sha256: 052095159416b52fdc20cd1e49e7f53ff58a5f360a5b8a0651d456188fb303ec
msgctxt "scenario4:scenario4_864C6DC9_F3F0_4202_9C3D_51E1AA4616BD"
msgid ""
"⟪k:0⟫and eventually, she reached the point where her comprehension was adequate enough without "
"assistance. ⟪k:1⟫Her next request, then, was for them to read through a book together."
msgstr ""
"⟪k:0⟫e infine, lei raggiunse il punto in cui la sua preparazione era sufficientemente adeguata da "
"non richiedere ulteriore assistenza.⟪k:1⟫⟪k:2⟫A quel punto, la sua seguente richiesta fu quella "
"di leggere un libro insieme."

#: scenario4:scenario4_BA67D6B6_3E00_47E2_B154_E49365D0681C
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 837ca6be91aedabaa63079214db668f6f7d9a0fc89dab1123d2a937ad3ed1cf3
#. default-sha256: 97dd0a0ba1696e5e03b717228129a7a756b2b032e04bf81972fe1ecce0ba2643
msgctxt "scenario4:scenario4_BA67D6B6_3E00_47E2_B154_E49365D0681C"
msgid "⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫⟪k:4⟫Have you read every book in the library?"
msgstr "⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫⟪k:4⟫Hai letto tutti i libri della biblioteca?"

#: scenario4:scenario4_7DAB50FB_8948_45A9_923F_F1699154B38F
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 52b41c0f08cdfd7f1650d018a2e1e167c8af36ad4528a078b47885097449610f
#. default-sha256: a9f7bf4d7204fc81a22cc999c91c8833e9e67bfa940a1eb7881f03d3b3a2d5a4
msgctxt "scenario4:scenario4_7DAB50FB_8948_45A9_923F_F1699154B38F"
msgid "⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫⟪k:4⟫No... ⟪k:5⟫I stopped looking at them after a while."
msgstr "⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫⟪k:4⟫No... ⟪k:5⟫dopo un po’ mi sono fermato."

#: scenario4:scenario4_07BD7C42_2024_42BF_A7AC_3D6680ADB294
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 97e0727a9f72ff29d5b70ad0cbc28fe7a26cda1f5392118fafaf69d9ffe9c162
#. default-sha256: 9869fe65a9e35898506557afa7ed4ba62f5351ba166a2a0f077f028d67e3be8a
msgctxt "scenario4:scenario4_07BD7C42_2024_42BF_A7AC_3D6680ADB294"
msgid ""
"⟪k:0⟫⟪k:1⟫Most everything I’m sent is dull, uninformative dreck.⟪k:2⟫⟪k:3⟫The diary of a lord... "
"⟪k:4⟫Foolish make-believe tales..."
msgstr ""
"⟪k:0⟫⟪k:1⟫Quasi tutto quello che mi mandano è noiosa e inutile spazzatura.⟪k:2⟫⟪k:3⟫Il diario di "
"un Lord... ⟪k:4⟫Sciocche storie di finzione..."

#: scenario4:scenario4_8D35450D_B142_480E_A9F5_804E8D21EB2F
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 0f1fbd0d71237b7cfeaf5b021dc9a2a8adf8ff992de2dcbc86b4008d597adb7f
#. default-sha256: b3d49f1c1692c74187bb1948e2e3752f5805e16551ffcb5a47fd84d2da9d4e17
msgctxt "scenario4:scenario4_8D35450D_B142_480E_A9F5_804E8D21EB2F"
msgid "⟪k:0⟫You’re not fond of fiction, I take it?"
msgstr "⟪k:0⟫Deduco che non ti piacciono i racconti di fantasia...?"

#: scenario4:scenario4_AE1BC5CF_BE0C_42C0_8420_E000E3D78D5F
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 3b6d3f1a182e74b1200accd9b85711f06a7293ab04140da3ce48ff3cbd264214
#. default-sha256: 886ef298656248564211a42183bdefe73a2ff6e7d140d51716466198c46bb7b0
msgctxt "scenario4:scenario4_AE1BC5CF_BE0C_42C0_8420_E000E3D78D5F"
msgid "⟪k:0⟫What value is there in the lies and fantasies of another?"
msgstr "⟪k:0⟫Che valore c’è nelle bugie e nelle illusioni di qualcun altro?"

#: scenario4:scenario4_5D9DCB1D_9C9E_4905_8D6B_3C0E3265D28F
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 27c4d6c02e65ff66e569f11af80b08ca6a3b2221345ff026812ed131906ee7e2
#. default-sha256: 162599bd9e05f62b14832a14946f22facfd9c95817637c07cc1aafb95fcea6b7
msgctxt "scenario4:scenario4_5D9DCB1D_9C9E_4905_8D6B_3C0E3265D28F"
msgid ""
"⟪k:0⟫Stories... ⟪k:1⟫can be invigorating.⟪k:2⟫⟪k:3⟫Tales of adventure can take you places you "
"could never go."
msgstr ""
"⟪k:0⟫Le storie... ⟪k:1⟫possono essere stimolanti.⟪k:2⟫⟪k:3⟫I racconti d’avventura possono "
"portarti in luoghi che altrimenti non vedresti mai."

#: scenario4:scenario4_79A4C059_3588_4A67_84DB_1DAE20CFEF5B
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 28f4e92df77d0095c8954efd1b8aeb4e7c4a796a0106bf4f17d879d4bba932f0
#. default-sha256: df13989ffa7238416788b8cfb11a924b34b579f4109be70040da848b9d14c446
msgctxt "scenario4:scenario4_79A4C059_3588_4A67_84DB_1DAE20CFEF5B"
msgid ""
"⟪k:0⟫Legends of heroes, folklore, stories of otherworldly phenomena.⟪k:1⟫⟪k:2⟫They can be "
"terrifying, and they can be exhilarating."
msgstr ""
"⟪k:0⟫Leggende di eroi, folclore, storie di fenomeni ultraterreni...⟪k:1⟫⟪k:2⟫Possono essere "
"terrificanti, e possono essere esilaranti."

#: scenario4:scenario4_E64A5DAE_C4BE_41D7_96DE_D6DB8B7054E0
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: d2ae5257acd4a768269d1ce88e5755b3cbbe5a165b0642440d37c27316132ae3
#. default-sha256: 1d70945efe25c7196ddc5462453cb81eba7a1b23a933a8c757b8aea935f9697d
msgctxt "scenario4:scenario4_E64A5DAE_C4BE_41D7_96DE_D6DB8B7054E0"
msgid ""
"⟪k:0⟫They may not be real, but they give you a little glimpse into the author’s heart—⟪k:1⟫⟪k:2⟫"
"let you feel like you’re seeing the same thing they saw."
msgstr ""
"⟪k:0⟫Potrebbero non essere reali, ma ti permettono di scorgere nel cuore dei loro autori—⟪k:1⟫"
"⟪k:2⟫possono farti sentire come se stessi vedendo le stesse cose che loro hanno visto."

#: scenario4:scenario4_0558A8F4_B267_478E_88CC_3059E51F9061
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: d836224f963fa19b828086f2a35e65ae576730470d96935ede31ac0db004bab1
#. default-sha256: acaddecacb62ae584155f4e120605af6c4a3dbf37118122cb03eb99bdf8929ed
msgctxt "scenario4:scenario4_0558A8F4_B267_478E_88CC_3059E51F9061"
msgid "⟪k:0⟫...You are a very empathetic girl.⟪k:1⟫⟪k:2⟫Fiction inspires nothing of the sort in me."
msgstr ""
"⟪k:0⟫...Sei una ragazza molto empatica.⟪k:1⟫⟪k:2⟫I romanzi non riescono ad ispirarmi allo stesso "
"modo."

#: scenario4:scenario4_8F0A27F9_A8FB_4812_A0BB_03F19731376B
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: d6c8fb068da52e24bcae33e1a49e12420e45b45e8b713b316715fcfd2e7dd358
#. default-sha256: 0d6346fd2c4b8a0622db711fcba35030faad1830598200088996f09f6dcfe3c7
msgctxt "scenario4:scenario4_8F0A27F9_A8FB_4812_A0BB_03F19731376B"
msgid "⟪k:0⟫However..."
msgstr "⟪k:0⟫Tuttavia..."

#: scenario4:scenario4_1EB8D266_8768_4E89_94AE_0D39579A75FE
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 5690e73b8c8b448b702b13ac928ed48a1881bdf78f40e765ef9cc497e889cd61
#. default-sha256: 246d574dc691bc84929b488fd05f4439f40e261ff1da52ce090908fe9d2df18c
msgctxt "scenario4:scenario4_1EB8D266_8768_4E89_94AE_0D39579A75FE"
msgid "⟪k:0⟫...?"
msgstr "⟪k:0⟫...?"

#: scenario4:scenario4_F934972B_8D87_4A6F_9D42_88AA60C16AD6
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: a128d975a3821e7412b0cc2b34ca0d1fd24f6e438986434eea1e955d7d6f3d51
#. default-sha256: 21f5dbae4e7c2a74a5b2e2d236e9f3f4aa2f459255d5813e24cf4d2842cafbe5
msgctxt "scenario4:scenario4_F934972B_8D87_4A6F_9D42_88AA60C16AD6"
msgid ""
"⟪k:0⟫Perhaps long ago... ⟪k:1⟫it may have been able to,⟪k:2⟫though I can no longer remember what "
"it feels like."
msgstr ""
"⟪k:0⟫...forse tempo fa... ⟪k:1⟫potrebbero esserci riusciti,⟪k:2⟫anche se non riesco più a "
"ricordare cosa si prova."

#: scenario4:scenario4_B35B874F_18F8_4245_9D80_D44806C2377C
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: e9d0fb68609a74fa76d3f18375a81b07540e5273e207b0ed12485a6b8d388920
#. default-sha256: f11d4291f3a652c5f1728f7c3d1e0539c0bca294118d5f62d9f59d91acd5ce1d
msgctxt "scenario4:scenario4_B35B874F_18F8_4245_9D80_D44806C2377C"
msgid "⟪k:0⟫I’m sure it’ll come back to you."
msgstr "⟪k:0⟫Sono sicura che ti tornerà in mente."

#: scenario4:scenario4_E37506A1_9251_4FE8_8FB8_A62B9DC8A983
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 97759ec1b3c785d372d0cd8f87a0a6057fad6017a4205e32da5c8a96150aaa17
#. default-sha256: 2049ef924865636f86c2987544ff3f0639199035611131546144633498466318
