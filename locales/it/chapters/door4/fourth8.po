#: scenario4:scenario4_9B4D4193_13FE_49FC_892E_D05717C95ED5
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: e11c024d07a1a763fe389e6012fbd73b837d662fa38c5b13111044a1a70420d8
#. default-sha256: 3bb5835d2a70693cb8a86809c0ac54a23180dcb113788fea9ed7007b8ba612d2
msgctxt "scenario4:scenario4_9B4D4193_13FE_49FC_892E_D05717C95ED5"
msgid ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫⟪k:4⟫⟪k:5⟫⟪k:6⟫⟪k:7⟫⟪k:8⟫⟪k:9⟫⟪k:10⟫⟪k:11⟫⟪k:12⟫⟪k:13⟫⟪k:14⟫⟪k:15⟫⟪k:16⟫⟪k:17⟫"
"⟪k:18⟫⟪k:19⟫⟪k:20⟫⟪k:21⟫⟪k:22⟫⟪k:23⟫⟪k:24⟫⟪k:25⟫But an unfathomable amount of time has passed,"
"⟪k:26⟫and the two have still yet to reunite."
msgstr ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫⟪k:4⟫⟪k:5⟫⟪k:6⟫⟪k:7⟫⟪k:8⟫⟪k:9⟫⟪k:10⟫⟪k:11⟫⟪k:12⟫⟪k:13⟫⟪k:14⟫⟪k:15⟫⟪k:16⟫⟪k:17⟫"
"⟪k:18⟫⟪k:19⟫⟪k:20⟫⟪k:21⟫⟪k:22⟫⟪k:23⟫⟪k:24⟫Ma è passata un’incalcolabile quantità di tempo da "
"allora,⟪k:25⟫e i due non si sono ancora riuniti."

#: scenario4:scenario4_94BC561E_5672_48E3_9852_2DF7363FDBD5
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
