#: scenario9:scenario9_2DFF2445_2A0A_4711_97E0_093585F56C4F
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: da3e1d138205b939e8961b97a6a447309bdcd3f064a93c62480838b3f47ba68a
#. default-sha256: e988c1b18b2f09fb0a2292dd97fbbe235e0161a5ee9530a8f3d32455715a5b70
msgctxt "scenario9:scenario9_2DFF2445_2A0A_4711_97E0_093585F56C4F"
msgid ""
"⟪k:0⟫Her identity as a saint gave her purpose in life,⟪k:1⟫while simultaneously constraining her."
msgstr ""
"⟪k:0⟫La sua identità di santa le aveva dato uno scopo nella vita,⟪k:1⟫e allo stesso tempo la "
"vincolava."

#: scenario9:scenario9_6CB7BB40_3C95_44B3_A839_D2968D9EBE94
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 4638e1a3c8b13e8ae22088e0a8e3c73de4cfa8e897a487931c005d1e66673961
