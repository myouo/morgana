msgid ""
"⟪k:0⟫If I hadn’t been there, the shipwrecked merchant’s lover would not have lost her place as "
"his tether."
msgstr ""
"⟪k:0⟫Se non fossi stata lì, la donna del mercante naufragato avrebbe continuato ad essere la sua "
"ancora."

#: scenario9:scenario9_67FA079F_C169_4B07_9CED_0EC33DBAB5BE
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 19f0810e9f614e45cbd112b4a25f6bfbbbf7dd5c8ef753a17148228e07381bd6
