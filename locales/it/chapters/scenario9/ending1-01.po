msgctxt "scenario9:scenario9_7F4FC72A_008F_4E6F_AEFA_18CB3FF56EE1"
msgid "⟪k:0⟫What? ⟪k:1⟫Why is... ⟪k:2⟫the White-Haired Girl here...?"
msgstr "⟪k:0⟫Cosa...? ⟪k:1⟫⟪k:2⟫La Ragazza dai Capelli Bianchi...⟪k:3⟫⟪k:4⟫ Perché lei è qui?"

#: scenario9:scenario9_EDA5A59B_1C8D_42AA_B3CE_97BFD760A867
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 844f96033f2bf017df6e37a2a24edc288b5986be5720ed16afffd3afc77bbd7f
#. default-sha256: 294f41e8469a478bdfd2b029f1b00582c70e69124793aadf4667b0fb74dcbe09
msgctxt "scenario9:scenario9_EDA5A59B_1C8D_42AA_B3CE_97BFD760A867"
msgid "⟪k:0⟫I was trying to get back to the mansion..."
msgstr "⟪k:0⟫Stavo cercando di tornare alla villa..."

#: scenario9:scenario9_5A6522EC_2818_41C0_A275_E01EFE5F6893
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 231afa50b29070eda03c39c7a45617b2ef818d15e3c4a21ce507839d1bacbd8d
#. default-sha256: bb010e991a90057f973560fbeb3ed9bb9d2606322964a3c38f5152a05326888b
msgctxt "scenario9:scenario9_5A6522EC_2818_41C0_A275_E01EFE5F6893"
msgid "⟪k:0⟫But what are you doing here?"
msgstr "⟪k:0⟫Però... ⟪k:1⟫cosa ci fai qui?"

#: scenario9:scenario9_2350185D_01F0_4ECC_8739_736AF54BE615
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 5589072d53ac4d1600fe68281b65fafa2879f324a5a53c847db7643d4b04b591
#. default-sha256: 0770e09751a2e8beb02f5228bb775b1d08a300d9673f7dff6c011baedccce7a0
msgctxt "scenario9:scenario9_2350185D_01F0_4ECC_8739_736AF54BE615"
msgid "⟪k:0⟫Remember... ⟪k:1⟫who you are?"
msgstr "⟪k:0⟫Ricordare... ⟪k:1⟫chi sei?"

#: scenario9:scenario9_35B96620_2434_4B0B_AFA5_99A6EF685A71
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 7000fe5ef6a08922daf6b4dbddf9f6ea2158e0e15f59880aeb976811f13fdb69
