#: scenario9:scenario9_9F61379E_0202_45A8_9850_9E023C02FA8C
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: c03e4fa44aa742f01228bdd4d1d4985c7069d4e05f4d5e5304dc58a6a3a7a285
#. default-sha256: 612bb36c3632cbbd65c0aed1086ef66d69c915aa1f4aaa27233bf892803a9d18
msgctxt "scenario9:scenario9_9F61379E_0202_45A8_9850_9E023C02FA8C"
msgid "⟪k:0⟫You... ⟪k:1⟫What are you..."
msgstr "⟪k:0⟫Che cosa...?⟪k:1⟫⟪k:2⟫Cosa stai..."

#: scenario9:scenario9_16985783_0C9E_45D6_976E_5508F0AB78BF
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 8c725aaa4c35100ef60cd71d761832b52d9fb32db38da0c800192e585675014d
#. default-sha256: dca88fb1039e33a8fe7e9f040d1eaa204eed0e6fc0ee2a6f3b228ca97e4e2773
msgctxt "scenario9:scenario9_16985783_0C9E_45D6_976E_5508F0AB78BF"
msgid "⟪k:0⟫Extinguish your soul?"
msgstr "⟪k:0⟫Estinguere la tua anima?"

#: scenario9:scenario9_6985F51E_3B8F_48EA_99A3_29D4E19BEBA9
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 08109b817596cfcaefe49dc7d692d8f4c5d1b4c29ebb07d7be238cfa635675f3
#. default-sha256: d873740c1e07badeffe4dce9532f76c5e5dcc9af4ad80e499b643ee74b8d4b51
msgctxt "scenario9:scenario9_6985F51E_3B8F_48EA_99A3_29D4E19BEBA9"
msgid ""
"⟪k:0⟫But I want it to be you... ⟪k:1⟫who sends me off.⟪k:2⟫⟪k:3⟫Could you grant this girl her "
"selfish request?"
msgstr ""
"⟪k:0⟫Ma voglio che sia tu... ⟪k:1⟫a finirmi.⟪k:2⟫⟪k:3⟫Potresti esaudire la mia egoistica "
"richiesta?"

#: scenario9:scenario9_7EB26B21_21B2_4DA7_8FA9_AFBC66F6EC26
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: bd8ed0d97c35a4d17a68669156054dafbe8a113100aa3a44c9697d3151b2b8be
#. default-sha256: dba27dc9c2b9084bb18023bc71f29bdfa1e3690fb1b5d11cd4ec86dc1ba30387
msgctxt "scenario9:scenario9_7EB26B21_21B2_4DA7_8FA9_AFBC66F6EC26"
msgid "⟪k:0⟫but because I wanted to set everyone free from the mansion’s cursed bonds..."
msgstr ""
"⟪k:0⟫Se l’ho fatto, è perché volevo che tutti fossero liberi dai vincoli della villa maledetta..."

#: scenario9:scenario9_872F9179_4F76_4DBE_A8EF_7C2AF30880EF
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: d7161d69780fb1f04edcdca326f42406fe09ecad3f80a74ade8df27d4f33b69b
#. default-sha256: 60c56c7bb466ed5aa329d6fa11971c02a40a2ad5fe42b9c08a3a897e41fb026e
msgctxt "scenario9:scenario9_872F9179_4F76_4DBE_A8EF_7C2AF30880EF"
msgid "⟪k:0⟫And you’re asking me... ⟪k:1⟫to eradicate your soul?"
msgstr "⟪k:0⟫E tu vorresti chiedermi... ⟪k:1⟫di estirpare la tua anima?"

#: scenario9:scenario9_6DE8A0BC_1CED_4C30_AF0B_8F2705D2ECF1
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 20d65a6e286b302d29b96762168d6d0f43a80ca7379f4eb5acd0c6dc166ac764
#. default-sha256: 9fca571bdd1b806e6adf6bfc490f0310135bdbaf16d80887f40f25911ecae19c
msgctxt "scenario9:scenario9_6DE8A0BC_1CED_4C30_AF0B_8F2705D2ECF1"
msgid "⟪k:0⟫I ⟪k:1⟫must⟪k:2⟫ be destroyed."
msgstr "⟪k:0⟫Io ⟪k:1⟫devo⟪k:2⟫ essere distrutta."

#: scenario9:scenario9_FFE289E9_5988_48FC_A478_DDF26D5199E5
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: f3941895860f5216a8f0fc3737855bc4d9934c5166f9b4a9acc0d5d5fb5b9bf6
#. default-sha256: a4bb26cd02fe145ceb4ea6d0ce97f10b5a0083c04007ad3e66944fd2decd6278
msgctxt "scenario9:scenario9_FFE289E9_5988_48FC_A478_DDF26D5199E5"
msgid ""
"⟪k:0⟫While it’s true Morgana wished for misfortune to befall them... ⟪k:1⟫if I hadn’t been there, "
"none of their tragedies would have taken place."
msgstr ""
"⟪k:0⟫Sebbene sia vero che è stata Morgana a desiderare che la sfortuna⟪k:1⟫si abbattesse su di "
"loro... ⟪k:2⟫se non ci fossi stata io, nessuna delle loro tragedie avrebbe avuto luogo."

#: scenario9:scenario9_80BD455B_7180_4F27_9EFC_691B744EA819
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 6b42e95064461deafff58f9ae2c608d557a62f3020b5f48ae273aa06b58b6887
#. default-sha256: bfde9e0a27e142b230d46abdef8ad20f987cfc05c92c3e313ff8a9d9f6e438ae
msgctxt "scenario9:scenario9_80BD455B_7180_4F27_9EFC_691B744EA819"
msgid "⟪k:0⟫⟪k:1⟫Culpable?⟪k:2⟫"
msgstr "⟪k:0⟫⟪k:1⟫Colpevole?⟪k:2⟫"

#: scenario9:scenario9_E4B3A56C_AE7E_4159_A51A_05132BF3EF3F
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 166ee29d11848ec6630487f229dcf1ac19712cba7cb173278733a7a4455939cb
#. default-sha256: e5ec6906d3e12327def8e32047b06828f0f3aa7cd9c2a19924109561d1b68ee2
msgctxt "scenario9:scenario9_E4B3A56C_AE7E_4159_A51A_05132BF3EF3F"
msgid "⟪k:0⟫You didn’t intend for anything bad to befall anyone."
msgstr "⟪k:0⟫Non hai mai voluto che la sfortuna si abbattesse su di loro."

#: scenario9:scenario9_C50A9C00_7CD9_4231_9A74_84B933568663
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: ee0b7cf360d38a0f58e34eadd78675451779e723c39b1a752073df980b1efb7c
#. default-sha256: 1876e3a653d54e009358d1e8ddd4e269ae0e6cd24aeaa6fb9de42bdc3d0fdc79
msgctxt "scenario9:scenario9_C50A9C00_7CD9_4231_9A74_84B933568663"
msgid "⟪k:0⟫What do you say we answer one last lingering question, Michel?"
msgstr "⟪k:0⟫Che ne dici se rispondessimo ad un’ultima domanda rimasta in sospeso, Michel?"

#: scenario9:scenario9_4CB04B8C_CE64_4467_A3FD_D683F1ABE772
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 05623800ff6689d93b0e8ebd865857bb36cd3e10a44f51d4bdf17ac929631d9f
#. default-sha256: 0a5e694b866c120834b6c111314df368faa5eba81f39f54dc8169cecf673679c
msgctxt "scenario9:scenario9_4CB04B8C_CE64_4467_A3FD_D683F1ABE772"
msgid ""
"⟪k:0⟫The explanation might be a bit lengthy...⟪k:1⟫⟪k:2⟫but I would like to share it with you "
"before I depart."
msgstr ""
"⟪k:0⟫La spiegazione potrebbe essere piuttosto lunga...⟪k:1⟫⟪k:2⟫ma mi piacerebbe condividerla con "
"te, prima di andarmene."

#: scenario9:scenario9_674CEFAD_690E_4D6F_8E66_67076AF5F197
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 6f9ea9a11f52aac864c0c4dcde8247b50df9edc6ca55f284bcdb8dd80e7eb1a6
#. default-sha256: 48f41697b22461c825c2f67ac00db3078091b23a05c42741f58ec0ffc02c435d
msgctxt "scenario9:scenario9_674CEFAD_690E_4D6F_8E66_67076AF5F197"
msgid "⟪k:0⟫............"
msgstr "⟪k:0⟫............"

#: scenario9:scenario9_E6E37D27_E7E9_4AD8_B0AA_20F76E48BEC2
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: cd01da55d8604b1b2f05543dcbf00f43eb8a39a5d1002c67eb91d372650ed167
#. default-sha256: ec70cdefd7851e9bd8872b8e26bdd383e3dc0a2d0aea89efc7579ac2e3a29054
msgctxt "scenario9:scenario9_E6E37D27_E7E9_4AD8_B0AA_20F76E48BEC2"
msgid ""
"⟪k:0⟫Upon her death, Morgana’s soul was afflicted with great pain resulting from the hatred and "
"resentment she bore."
msgstr ""
"⟪k:0⟫Al momento della sua morte, l’anima di Morgana era afflitta da un grande dolore, derivato "
"dall’odio e dal risentimento che nutriva."

#: scenario9:scenario9_61E105AB_CBC5_45F8_BB12_D4BBD464AF7B
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: ff38592093874b9d9b620e1ef8de33d7d3597099ed197b5bc7e063ee62e9e4c2
#. default-sha256: 649e6e6d1beb6bd2f658c591e6f95f4bcb2a1909f65f0e9dc3bb6554def2e4b1
msgctxt "scenario9:scenario9_61E105AB_CBC5_45F8_BB12_D4BBD464AF7B"
msgid ""
"⟪k:0⟫A saint must put herself second to all others.⟪k:1⟫⟪k:2⟫She must be caring, generous, "
"forgiving.⟪k:3⟫⟪k:4⟫And she must not bear any ill will for anyone."
msgstr ""
"⟪k:0⟫Una santa deve mettersi al di sotto di chiunque altro.⟪k:1⟫⟪k:2⟫Deve essere altruista, "
"generosa, indulgente...⟪k:3⟫⟪k:4⟫e non deve serbare alcun rancore per nessuno."

#: scenario9:scenario9_22806235_A709_4C41_AC81_AD9B75A68C5F
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: df46758f82a6a1846e9ae8cbe84fd08de9d1584a79ecbdf012fce457729eb123
#. default-sha256: 93f357a64f4223a56259d4a0d6694766bd2a0f0955cb22d4e3d27a3af80efe9d
msgctxt "scenario9:scenario9_22806235_A709_4C41_AC81_AD9B75A68C5F"
msgid "⟪k:0⟫So that’s why you always seemed so... ⟪k:1⟫abnormally pure-hearted..."
msgstr ""
"⟪k:0⟫Dunque è per questo che sei sempre stata così... ⟪k:1⟫eccessivamente pura⟪k:2⟫di cuore..."

#: scenario9:scenario9_C7844E63_00A8_4A5C_9E40_77B244818EEF
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 905644bb43529cf907653cb55189ced167f31e357502ff8ec47ac38ca50c2477
#. default-sha256: 19626e0e6a4de67ee2020b3b127fee27d3bb989ae943d19e4751b170336c1002
msgctxt "scenario9:scenario9_C7844E63_00A8_4A5C_9E40_77B244818EEF"
msgid "⟪k:0⟫I refuse to accept..."
msgstr "⟪k:0⟫Mi rifiuto di credere..."

#: scenario9:scenario9_DB5FE44D_E8BF_4FE4_ADC3_359A9861FAAA
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 5cee9d96c05fa5dd25cfbc6c24091c0b34521534e0ce2b6da85e9b39eba5a084
#. default-sha256: 14dc666b44f77a5b8b92f3f7110b409530afe2841106b0b8e5b146ac34170dcf
msgctxt "scenario9:scenario9_DB5FE44D_E8BF_4FE4_ADC3_359A9861FAAA"
msgid "⟪k:0⟫I was never meant to be a soul of my own."
msgstr "⟪k:0⟫Non ero destinata ad essere un’anima separata."

#: scenario9:scenario9_ED3E19B4_F27A_4DBB_9407_E7BDA4CD3900
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 8b55e05f798ba5783a0ca6b46926a9609a6286ee0d9e9db461628065ffb05a7c
#. default-sha256: aef87c9215e34d6ca9492bbba991bcb63d168234daf19bb6b4fedc3c63e79bff
msgctxt "scenario9:scenario9_ED3E19B4_F27A_4DBB_9407_E7BDA4CD3900"
msgid "⟪k:0⟫I wished to live,"
msgstr "⟪k:0⟫Io avevo desiderato vivere,"

#: scenario9:scenario9_9A5A72F1_0937_45A3_9907_771883651318
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 958f799601e8139ccbe7601c4cfc86283ddb2038c0711218774bce5e34d0f4d9
#. default-sha256: 35941a00a7e2960e360d9b6c7db0273ce3c0a99824e763567c255a24bb118def
msgctxt "scenario9:scenario9_9A5A72F1_0937_45A3_9907_771883651318"
msgid "⟪k:0⟫but your own wish?"
msgstr "⟪k:0⟫ma il tuo stesso desiderio?"

#: scenario9:scenario9_01EDA556_A383_47E5_9362_9F8E1A0E37F5
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 979a65f42982c005a46fd3db8d27596ffe17b7757b3e6605ca03cc9111143f2e
#. default-sha256: ed28d12eccecb76cd535dc2fc7ed7f0b8640907dabeaabbb9eea06d65c40ddd3
msgctxt "scenario9:scenario9_01EDA556_A383_47E5_9362_9F8E1A0E37F5"
msgid "⟪k:0⟫Which meant that my wish... ⟪k:1⟫had the consequence of granting Morgana’s with it."
msgstr ""
"⟪k:0⟫Il che significa che il mio desiderio... ⟪k:1⟫ha avuto l’effetto di esaudire anche quello di "
"Morgana."

#: scenario9:scenario9_EA770485_F763_4E16_90CA_B38FFE952A0A
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 66f18169bbf0a32242a115ece318d7dcba36e3e1e21b1bea5a5ae101bc55149f
#. default-sha256: 2c076081556cdf7d609fc3915eec4f080ed6496a3c8e66da2eb057e7081cef2e
msgctxt "scenario9:scenario9_EA770485_F763_4E16_90CA_B38FFE952A0A"
msgid ""
"⟪k:0⟫The house, having attained perpetuity, served as a place for those reconstructed by "
"Morgana’s curse to return to."
msgstr ""
"⟪k:0⟫La casa, essendo divenuta eterna, è servita come luogo dove accogliere coloro che erano "
"stati ricostruiti dalla maledizione di Morgana."

#: scenario9:scenario9_BF2BAD37_233B_4AAF_BBA1_1D0845550B0B
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: d4c038eabe6e2c1b8597a29940975c6474768e1898fd0b1c287a670e916c7b51
#. default-sha256: 49cc7dc53894cbcfb95ab26a04540d683656cba563b3a273d190508e3e40d817
msgctxt "scenario9:scenario9_BF2BAD37_233B_4AAF_BBA1_1D0845550B0B"
msgid "⟪k:0⟫I was the one most affected by her wish."
msgstr "⟪k:0⟫io sono stata la persona più colpita dal suo desiderio."

#: scenario9:scenario9_D948BE88_0FDF_4E12_B157_FE9A21E42EC8
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 225b3c5ef2c64f6c1006b0cf89882a3ac7c5f6ba991c440e378c857a9b460d6c
#. default-sha256: ac6ef72e2d24b77380d8f4dedd21dbe857bf4504bd85de618108cc4c8d265011
msgctxt "scenario9:scenario9_D948BE88_0FDF_4E12_B157_FE9A21E42EC8"
msgid ""
"⟪k:0⟫As much as I may have wanted to do good, for them to be happy...⟪k:1⟫⟪k:2⟫my fate was "
"dictated by her wish."
msgstr ""
"⟪k:0⟫Per quanto io volessi fare loro del bene—⟪k:1⟫per quanto sperassi che potessero vivere "
"felici...⟪k:2⟫ il mio destino era dettato dal suo desiderio."

#: scenario9:scenario9_CBA0F624_DC0B_454E_927C_7F0A72F8CF0C
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: dd92089dc67d2a226abb2cd0ed97d13ff4c7a2e263479332fcafc1a19c16444a
