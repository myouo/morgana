msgid "⟪k:0⟫Splendid."
msgstr "⟪k:0⟫Splendido."

#: scenario9:scenario9_EF768DFA_9AB5_4F1E_9BAC_8B54FEC7F54E
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 7fb0491a279ccee944dedc1607838e9f46cce17cb67248914a8bbcac0d33f1a6
#. default-sha256: ba191de672021b2a3b797c6a703bb61a631e055d75cd59e548087beeb4f43961
msgctxt "scenario9:scenario9_EF768DFA_9AB5_4F1E_9BAC_8B54FEC7F54E"
msgid "⟪k:0⟫Why is there a sword in your hands?"
msgstr "⟪k:0⟫Perché hai una spada tra le mani?"

#: scenario9:scenario9_68EEC317_9276_4E14_A303_77624A0F3FB5
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 8de1de15e02dbc8c1e404179a3e8cf85567a2e020133bc5e37b99632720328f0
#. default-sha256: f3ced52ddc6c9130a8021839cb204aeb896c2e25dee9946a7addc27ee7617e0c
msgctxt "scenario9:scenario9_68EEC317_9276_4E14_A303_77624A0F3FB5"
msgid ""
"⟪k:0⟫I realize that it’s cruel for me to ask this of you,⟪k:1⟫⟪k:2⟫and for that, I deeply "
"apologize."
msgstr ""
"⟪k:0⟫Mi rendo conto che è una cosa crudele da chiederti,⟪k:1⟫⟪k:2⟫e per questo, ti devo le mie "
"più sentite scuse."

#: scenario9:scenario9_148F91BC_E4C1_467E_B6E2_A38C3FA5AEE7
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: e118cc52598879768b9a4d2441c75621b31c461faa768e4ee02fac10017a59f7
#. default-sha256: 6211d3ccac414adc96fc0c7a271a7a22b54fff4d153f1b20ad3c7a5acf555301
msgctxt "scenario9:scenario9_148F91BC_E4C1_467E_B6E2_A38C3FA5AEE7"
msgid ""
"⟪k:0⟫That’s not why I sought the truth...⟪k:1⟫⟪k:2⟫Not because I wanted to see anyone "
"“extinguished”..."
msgstr ""
"⟪k:0⟫Non è per questo che sono andato alla ricerca della verità...⟪k:1⟫⟪k:2⟫Non volevo vedere "
"nessuno “estinguersi”..."

#: scenario9:scenario9_04875D08_CAE1_4730_9063_7003DD5C6999
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: af3479fb3142977becc741b84b89c79ea6ca785660f13f19108341372e8ece82
