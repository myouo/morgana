msgctxt "scenario9:scenario9_DE0645BD_A94B_49F2_97B1_549192018D30"
msgid "⟪k:0⟫That includes you."
msgstr "⟪k:0⟫Inclusa te."

#: scenario9:scenario9_47FB5147_8F88_4FBA_BD47_47D48530ED8A
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 4e90b6454db458f0327c998c27dbcfcd32ca7c07486cb0193534d8fd42329ed3
#. default-sha256: 88e2e075b6dedfbcf6b33e117ee9d728ca40dd97498e6e1130d3a05b0c862ad4
msgctxt "scenario9:scenario9_47FB5147_8F88_4FBA_BD47_47D48530ED8A"
msgid "⟪k:0⟫I was not a victim in the tragedies...⟪k:1⟫⟪k:2⟫I am culpable for them."
msgstr "⟪k:0⟫Non sono una vittima delle loro tragedie...⟪k:1⟫⟪k:2⟫bensì ne sono colpevole."

#: scenario9:scenario9_830104B4_BEF4_412F_BDDC_A90871F518EB
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: ef352040c65d66f85fb5f80fafe9baaace625157593d6d685d0d1a879e0523ca
