msgstr "⟪k:0⟫............"

#: scenario9:scenario9_CDE192CC_D8E1_483D_ADDA_BF5B772FFBF8
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 5715deda9c05b41792cda59348e1456ee45287f936cd18b0117465d2aae39b7f
#. default-sha256: 4eb45cd85d85f569e2217c282b12e50a9847441c6dcfa926198d8745ad761486
msgctxt "scenario9:scenario9_CDE192CC_D8E1_483D_ADDA_BF5B772FFBF8"
msgid "⟪k:0⟫that there’s anything wrong with wanting to live."
msgstr "⟪k:0⟫che ci sia qualcosa di sbagliato nel voler vivere."

#: scenario9:scenario9_427B61FA_F1B1_48B4_A6BF_CD32FDF16F18
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: cf5f205016124a9c540ee9999ff9fec69627dbe7adfda0b074d26e9507bb3e15
#. default-sha256: 904d4cd93e53a41b640c24b9d159e6c1bf815c8d5baed87516f1ed7498fff1c8
msgctxt "scenario9:scenario9_427B61FA_F1B1_48B4_A6BF_CD32FDF16F18"
msgid "⟪k:0⟫I was supposed to remain within Morgana, as a part of her."
msgstr "⟪k:0⟫Sarei dovuta restare all’interno di Morgana, come parte di lei."

#: scenario9:scenario9_107F121F_562F_4D89_9F82_76A29429BD7B
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 78d10e1a64c535a27f4fd247d61a4fd184888f17669c15fe51d42fc0b5191e6b
#. default-sha256: 26a94f439b4dd4ab65174d9019277d91d376a868cff1a8c9129a3ddb6262b796
msgctxt "scenario9:scenario9_107F121F_562F_4D89_9F82_76A29429BD7B"
msgid "⟪k:0⟫To become one... ⟪k:1⟫was to turn against the laws of the universe."
msgstr "⟪k:0⟫Diventare tale... ⟪k:1⟫significava andare contro le leggi dell’universo."

#: scenario9:scenario9_B3DA77E1_8EE0_4E8D_964B_3B154B0396F5
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 14a348d84cb912a90d9fd4b658ee0cbcd26396f6c44a4c9a882bd33c4569c863
#. default-sha256: 2068c11d0d35b32a2eab44573200dfd3535aec27dd2b75c334ecc3feedf92981
msgctxt "scenario9:scenario9_B3DA77E1_8EE0_4E8D_964B_3B154B0396F5"
msgid "⟪k:0⟫Because that was where she lingered—⟪k:1⟫⟪k:2⟫the girl from which I was formed."
msgstr "⟪k:0⟫Perché è lì che lei risiedeva—⟪k:1⟫⟪k:2⟫la ragazza da cui sono stata generata."

#: scenario9:scenario9_13865182_DB1B_4F73_B3AA_181FDF2483F0
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: fd466d02667c4108b2bb5221a1941cb3e569b6a5e84ed29d4ccf493feaa2b9f2
