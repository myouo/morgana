msgctxt "scenario9:scenario9_D4862E8D_0992_442C_82B4_6E6CBBB09432"
msgid "⟪k:0⟫You’re not a defect..."
msgstr "⟪k:0⟫Tu non sei un’anomalia..."

#: scenario9:scenario9_CC95A959_3809_4FE9_AAC3_5963A5D0B1FE
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 4e9f0d408a9b02dd5a62c45cdda620b2a287f17b4ec1e5fa0f2fdfca1711dc9c
#. default-sha256: ec472afc45203cabf4af5b6f59de77100a5743b17faa75bd13a74fa150498306
msgctxt "scenario9:scenario9_CC95A959_3809_4FE9_AAC3_5963A5D0B1FE"
msgid "⟪k:0⟫and it will take as long, if not longer, for the process to be reversed."
msgstr "⟪k:0⟫e il processo inverso richiederà lo stesso lasso di tempo, se non di più."

#: scenario9:scenario9_4B09E7F5_0C2B_46A6_9A89_910E2A1212EB
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 20057f2ebb0257db7aa6b4817161f42bf1846de564c9269287e9dcb1a1d962cc
