msgid "⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫⟪k:4⟫We meet at last..."
msgstr "⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫⟪k:4⟫Finalmente ci incontriamo..."

#: scenario9:scenario9_7F8EE5F7_11D1_4996_A0CA_9123B8E172A8
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 8d0a60260ddf7987c7721beedd6c3cc68ba0d6f504b5a6b9e9504063e2d64618
#. default-sha256: 39d496b91b6df1659f155f477185754c45b9436450f5f80d509a57543e46a0ac
msgctxt "scenario9:scenario9_7F8EE5F7_11D1_4996_A0CA_9123B8E172A8"
msgid "⟪k:0⟫Never mind that... ⟪k:1⟫Where ⟪k:2⟫am⟪k:3⟫ I?"
msgstr "⟪k:0⟫No, questo non importa adesso...⟪k:1⟫⟪k:2⟫Piuttosto, dove mi trovo?"

#: scenario9:scenario9_7A53115B_CAC3_4A69_B7CF_15B5D7581784
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 3feb30254bd12814ea711e8bfe16f10ec25b42aedc7e1906aa7c9a1a1d915aca
