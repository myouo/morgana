msgctxt "scenario9:scenario9_1E9F04AC_24CD_462E_9AC3_D4184EABDCD7"
msgid "⟪k:0⟫And why... ⟪k:1⟫can I not speak?"
msgstr "⟪k:0⟫E perché... ⟪k:1⟫non riesco a parlare?"

#: scenario9:scenario9_FDA1CBD3_AAFE_4D07_AB73_5CB3BF3EE90A
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: d1d744ec1beff7dab0a7e3cd9c81edae73526328a0537d4c7a87b93b0fdf487d
#. default-sha256: 43b055d7de0e00224e158a8e426234413cf24ee6a0d86d488d405dd3b5c5a6f0
msgctxt "scenario9:scenario9_FDA1CBD3_AAFE_4D07_AB73_5CB3BF3EE90A"
msgid "⟪k:0⟫I was able to return to this gathering place of souls thanks to your efforts."
msgstr ""
"⟪k:0⟫Sono riuscita a tornare in questo luogo di ritrovo per le anime⟪k:1⟫grazie ai tuoi sforzi."

#: scenario9:scenario9_D024F237_3183_4E5B_BE81_82AD558E0E75
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 2e1c312253ca4065a3fa162a552e01d4ffa61e9b446eacb55b8396adc0966063
#. default-sha256: f1e07e182d5d6ae995c45d35908964c54ef79662f709056e93b7db05a8d5ce76
msgctxt "scenario9:scenario9_D024F237_3183_4E5B_BE81_82AD558E0E75"
msgid "⟪k:0⟫But my heart told me I had to do this now."
msgstr "⟪k:0⟫Ma il cuore mi ha detto che dovevo farlo adesso."

#: scenario9:scenario9_74D6CBEA_B305_4027_B19E_4D301A77EACC
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 1cba6afa4f42c8a55e811ef7f10c94d27e8795eb1bb14556033858bd901bb892
#. default-sha256: 943152b8fb7db65fb705275e0fde6ede28f7ee8450ac97db5bf753ff5c7446a2
msgctxt "scenario9:scenario9_74D6CBEA_B305_4027_B19E_4D301A77EACC"
msgid "⟪k:0⟫I have brought you here to ask for your assistance."
msgstr "⟪k:0⟫ti ho portato qui per chiedere la tua assistenza."

#: scenario9:scenario9_6BA1FB6E_E41D_48FA_90FD_50C8BA4E5933
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: c76d7013d6589632c7a92479e6a1cb90eec36883507a0160c2fc7fdbff94cc07
