msgctxt "scenario9:scenario9_A9956F34_AC58_4FD8_AAB2_17ADFA21C0EF"
msgid "⟪k:0⟫............"
msgstr "⟪k:0⟫............"

#: scenario9:scenario9_3D76D3F0_B785_4847_BC7D_4F8DC241C59C
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 753db78bfe98506866b9e7df6548f4eb4b84dcf315035ef0b852cfe6d230afb5
#. default-sha256: 8d805114c5dbbc6c1d38cf0561bf647838e7d23f86442c051bda4162ab211af1
msgctxt "scenario9:scenario9_3D76D3F0_B785_4847_BC7D_4F8DC241C59C"
msgid "⟪k:0⟫My very presence malevolent."
msgstr "⟪k:0⟫La mia stessa presenza una forma d’ostilità."

#: scenario9:scenario9_77583269_3E0D_416C_A4DD_9CEC53949443
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 91de9d1fee99a80d1dbf9c54661fbb0bf1c61facf0e0339aa417ecd5cc81ac5a
#. default-sha256: 39b90f7e5789b34b6cbf8422d8aca7b91591b236173f5307d9a157f3b4d63af7
msgctxt "scenario9:scenario9_77583269_3E0D_416C_A4DD_9CEC53949443"
msgid "⟪k:0⟫Please, stop..."
msgstr "⟪k:0⟫Ti prego, smettila..."

#: scenario9:scenario9_4FA002B7_F14F_45BB_A19E_6A99E0CF9FDA
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: cd0d1de4b03c9bf0c995b498cf229b044c67e99f826b17aa9c2d8a89f8b93769
#. default-sha256: 64fe91cc6a8aac227b765f4fd46af293aef7e79366974856a8b4bdd560c307e1
msgctxt "scenario9:scenario9_4FA002B7_F14F_45BB_A19E_6A99E0CF9FDA"
msgid "⟪k:0⟫The universe must be returned to its proper state, Michel."
msgstr "⟪k:0⟫L’universo deve tornare al suo stato originale, Michel."

#: scenario9:scenario9_4DECEAE2_970C_4CD6_BDDF_DE47457B4E9A
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 6fb9e4af83d5fc4300fab7d6ae1b1aa9d88c94ccdef53537f0b66a305ba88e34
#. default-sha256: 9d6d7864215ee3e06902b40db9f3710ec2cf9bb31cad405762f51fe800fd6a58
msgctxt "scenario9:scenario9_4DECEAE2_970C_4CD6_BDDF_DE47457B4E9A"
msgid "⟪k:0⟫Don’t talk about yourself like that..."
msgstr "⟪k:0⟫Non parlare di te stessa in questo modo..."

#: scenario9:scenario9_A9F321DC_32EA_49D0_A6B0_F157BEECC80C
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 5127efd4a3b5580d130c21866519903836390b9feaada1490cf47e57364341e4
#. default-sha256: 210af3ea8391cf66ef6898a67ee0a2c7b3c22753d8e9dbd6048366610e93abe5
msgctxt "scenario9:scenario9_A9F321DC_32EA_49D0_A6B0_F157BEECC80C"
msgid ""
"⟪k:0⟫Perhaps she will be a butterfly resting upon the lip of a flower.⟪k:1⟫⟪k:2⟫Perhaps she will "
"be that flower.⟪k:3⟫⟪k:4⟫Perhaps she will be the breeze in which that flower sways."
msgstr ""
"⟪k:0⟫Forse sarà una farfalla che si riposa sul petalo di un fiore.⟪k:1⟫⟪k:2⟫Forse sarà il fiore "
"stesso.⟪k:3⟫⟪k:4⟫Forse sarà la brezza che lo accarezza."

