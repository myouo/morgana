#: scenario9:scenario9_EEB2D58B_2A68_4E9C_8379_91E1270DF884
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 1e40d3913c5b36f3dc38eb14eff5e88db80efcc327335bcc4cd5b1d7b9047468
#. default-sha256: 14af29afa47a5d4b44fb558fe625ab5bfb1b2e841e999d56967e33834280cb79
msgctxt "scenario9:scenario9_EEB2D58B_2A68_4E9C_8379_91E1270DF884"
msgid "⟪k:0⟫Why are you acting... ⟪k:1⟫like it’s all your fault?"
msgstr "⟪k:0⟫Perché parli... ⟪k:1⟫come se fosse tua la colpa di tutto?"

#: scenario9:scenario9_DF5DEAFE_AB08_4F9A_BCBA_1DA2539EC800
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 1fff23a6716573b90f48234c3feb8ced8b171dc9d022e846861f2e2b4c5f0d57
#. default-sha256: c89816a837e6a1e6ff937fd930f3c9d56e53d18988e4d50eb71baffe42d92029
msgctxt "scenario9:scenario9_DF5DEAFE_AB08_4F9A_BCBA_1DA2539EC800"
msgid "⟪k:0⟫Are you trying to say everyone would be better off without you?"
msgstr "⟪k:0⟫Stai dicendo che chiunque starebbe meglio senza di te?"

#: scenario9:scenario9_924BB831_2A65_4066_B6DF_6B5AF8268651
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 1453083a0b5c50c87e0faf022ac38274f8e833d1ab4cb0ba61bcc9790228d389
#. default-sha256: 1ff467d74c9393b4895f43d0a34f91f205ddd2d5dcf45bd7acc86c48b243ef68
msgctxt "scenario9:scenario9_924BB831_2A65_4066_B6DF_6B5AF8268651"
msgid "⟪k:0⟫Like hell you were."
msgstr "⟪k:0⟫Col cavolo che lo eri."

#: scenario9:scenario9_B139A233_E70D_4F3B_8565_A51B4A55377C
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 95e4ea501c3593a882235915a805664fa6d2f64ca24b8c0bb6ba8f0ebfe2525c
#. default-sha256: 22698fded409e50b596d165674bfb5df0cee3acca5c5873c6aeda351a4df3994
msgctxt "scenario9:scenario9_B139A233_E70D_4F3B_8565_A51B4A55377C"
msgid "⟪k:0⟫I was born to be a receptacle for her pain, to ease her suffering."
msgstr ""
"⟪k:0⟫Sono nata per fungere da contenitore per il suo dolore,⟪k:1⟫⟪k:2⟫per alleviare la sua "
"sofferenza."

#: scenario9:scenario9_8EC6D6CB_F486_41D7_BCDE_441BCF502863
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 324fd1b8cd46eef55ff14585dbfbf2fd0fcb1df981be3454a7166e86d994f388
#. default-sha256: c2a0fe2e74328dfff5203be78a3692d6f2d3ccf1ce08aaced47db219283c77d1
msgctxt "scenario9:scenario9_8EC6D6CB_F486_41D7_BCDE_441BCF502863"
msgid ""
"⟪k:0⟫That was not how she felt deep down, though.⟪k:1⟫⟪k:2⟫She was not a saint out of the "
"goodness of her heart."
msgstr ""
"⟪k:0⟫Ma nel profondo, non era questo ciò che lei provava.⟪k:1⟫⟪k:2⟫Non era una santa mossa dalla "
"bontà del proprio cuore."

#: scenario9:scenario9_27B4F3AD_B200_46E0_9E39_760FA23116D6
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 3aa0da29c14273dd7751a172c213ebc382d76c76bbfb70d45abd106c042fe1a8
#. default-sha256: 749e32a1a1ce5a04f0e560e1ae1ddc54a96248bb4ef6371c7591e4f2127420cb
msgctxt "scenario9:scenario9_27B4F3AD_B200_46E0_9E39_760FA23116D6"
msgid ""
"⟪k:0⟫So she took all her “saintly” characteristics and gave them to me—⟪k:1⟫⟪k:2⟫caring for "
"others, putting herself second, being forgiving—"
msgstr ""
"⟪k:0⟫Così ha preso tutte le qualità che facevano di lei una santa—⟪k:1⟫⟪k:2⟫⟪k:3⟫il proprio "
"altruismo, la propria generosità, la propria indulgenza—⟪k:4⟫⟪k:5⟫⟪k:6⟫e le ha date a me,"

#: scenario9:scenario9_300588D5_5543_4925_9C59_B86D0CDF8E42
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 6f9ea9a11f52aac864c0c4dcde8247b50df9edc6ca55f284bcdb8dd80e7eb1a6
#. default-sha256: 48f41697b22461c825c2f67ac00db3078091b23a05c42741f58ec0ffc02c435d
msgctxt "scenario9:scenario9_300588D5_5543_4925_9C59_B86D0CDF8E42"
msgid "⟪k:0⟫............"
msgstr "⟪k:0⟫............"

#: scenario9:scenario9_AA49492A_FB24_4BEB_8A11_1B6DE71754A6
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 4c0c50080848eaa6c1131320fdd5dd50aa2b58dcc2e446ef148fb523bd7b3191
#. default-sha256: 8aeea4cf06fee75ac1e6314967e37b98459786f577b6f483e2a57f4e1767a36d
msgctxt "scenario9:scenario9_AA49492A_FB24_4BEB_8A11_1B6DE71754A6"
msgid "⟪k:0⟫In a world where I was never meant to exist."
msgstr "⟪k:0⟫In un mondo in cui non sarei mai dovuta esistere."

#: scenario9:scenario9_82D5CD06_EFF9_4E8C_BF26_7855E821AEAB
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 55b60bea59027cc938f71a7df398165f12c8b8e9076d12333f0ed98a1a39dbbb
#. default-sha256: f0f3e06bd92fe0d345a6969d3c06348c648d0ac0b83123af08957d02c1648e82
msgctxt "scenario9:scenario9_82D5CD06_EFF9_4E8C_BF26_7855E821AEAB"
msgid "⟪k:0⟫and Morgana wished to curse the three men’s souls."
msgstr "⟪k:0⟫e Morgana aveva desiderato maledire l’anima dei tre uomini."

#: scenario9:scenario9_D3FF89B2_C0DD_42E7_9E15_DDDEC5A0FD03
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: a9fb3eec088c951dfeb14e53f03cc7a7502627016787920d10d80a253e19544e
#. default-sha256: d50c29aaa28c5930dcace55718b8b097e468b7e7e083712bc43e790ddc976a0c
msgctxt "scenario9:scenario9_D3FF89B2_C0DD_42E7_9E15_DDDEC5A0FD03"
msgid ""
"⟪k:0⟫In order for an incomplete soul like mine to survive, it needs something to bind itself to "
"the world—⟪k:1⟫⟪k:2⟫something strong enough to prevent the universe from “correcting” the anomaly."
msgstr ""
"⟪k:0⟫Affinché un’anima incompleta come la mia possa sopravvivere,⟪k:1⟫ha bisogno di qualcosa che "
"la leghi al mondo—⟪k:2⟫⟪k:3⟫qualcosa di abbastanza forte da impedire che l’universo “corregga” "
"l’anomalia."

#: scenario9:scenario9_26C22C6F_3835_4C3F_BA35_F932EDDE9DE7
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 07cd5630d78a7b3f60f9a13aedd699b7149b02ad3a51eeea3c6529e503a68848
#. default-sha256: 7328fa19ccf0a704b70ee145848c352a9c88b6cab56ebec99b18b74d84db27f5
msgctxt "scenario9:scenario9_26C22C6F_3835_4C3F_BA35_F932EDDE9DE7"
msgid "⟪k:0⟫And so the wish of that anomaly... ⟪k:1⟫gave birth to yet another anomaly—"
msgstr ""
"⟪k:0⟫E così il desiderio di quell’anomalia... ⟪k:1⟫ha dato vita ad un’⟪k:2⟫altra⟪k:3⟫ anomalia—"

#: scenario9:scenario9_D21274E5_3971_4179_BCFE_1CCDE07DEAD6
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: ea99d0f526ca01439db3d30ed358fa48c1b4e95b38ba7f1b983b49dffe787c0e
#. default-sha256: cb325b48591a52fde0172cf358eca1d230a64b9c8064fe78f45b5ee61db3406d
msgctxt "scenario9:scenario9_D21274E5_3971_4179_BCFE_1CCDE07DEAD6"
msgid ""
"⟪k:0⟫a house that sat outside the currents of time.⟪k:1⟫⟪k:2⟫One that could descend into the "
"mortal realm at various times and places."
msgstr ""
"⟪k:0⟫una casa che risiede al di fuori delle correnti del tempo.⟪k:1⟫⟪k:2⟫Una casa che potesse "
"discendere nel regno dei mortali in diversi luoghi, e in diverse epoche."

#: scenario9:scenario9_7B0EB139_01EE_4014_9911_2C1CB1F186DD
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: ba4d2e431d1a3e25d0149a937934cb453758cc8ad9b95a9f56a695941a9ffe12
#. default-sha256: 526c446c3eff0b70a6ece92db4abd589bc1ceb16afdc0ce2ac354503611cfd19
msgctxt "scenario9:scenario9_7B0EB139_01EE_4014_9911_2C1CB1F186DD"
msgid "⟪k:0⟫And why did it have to be that house that bound me to the world?"
msgstr "⟪k:0⟫E perché doveva essere quella casa a vincolarmi al mondo?"

#: scenario9:scenario9_A9956F34_AC58_4FD8_AAB2_17ADFA21C0EF
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 6f9ea9a11f52aac864c0c4dcde8247b50df9edc6ca55f284bcdb8dd80e7eb1a6
