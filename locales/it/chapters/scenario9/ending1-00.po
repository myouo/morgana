msgctxt "scenario9:scenario9_6BA1FB6E_E41D_48FA_90FD_50C8BA4E5933"
msgid "⟪k:0⟫take this blade, and with it, extinguish my soul."
msgstr "⟪k:0⟫prendi questa spada, e con essa, estingui la mia anima."

#: scenario9:scenario9_46C9FD96_4824_4A8E_B09A_005FD2D06FB3
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: e51ca736db49a53614c1e6bb727b369fa8123e4cba39956bf3c014147bbfb228
#. default-sha256: ad7be0fad011a8000f797f6aa68f7bda248c718b709a46088afc530538c38336
msgctxt "scenario9:scenario9_46C9FD96_4824_4A8E_B09A_005FD2D06FB3"
msgid "⟪k:0⟫Because I wanted to save every last person caught in this tragic quagmire."
msgstr "⟪k:0⟫Perché volevo salvare ogni singola persona coinvolta in questa tragica vicenda."

#: scenario9:scenario9_EB0AB613_6210_4CB4_B8ED_D5CAAEC5535D
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 2100a33e43fa00f532bcbb9fa2cc50393ac3e34e5b86ff829e3abf47470f9acb
#. default-sha256: 1f6aa27bc8b1c1bd3053c837d02327a384a72fb15ecc656ae2c9b98b050f78b2
msgctxt "scenario9:scenario9_EB0AB613_6210_4CB4_B8ED_D5CAAEC5535D"
msgid ""
"⟪k:0⟫You can’t tell me that after everything you’ve seen...⟪k:1⟫⟪k:2⟫you haven’t realized that I "
"have no place in their lives."
msgstr ""
"⟪k:0⟫Dopo tutto ciò che hai visto, non puoi non esserti reso conto che non c’è posto per me nella "
"loro vita."

#: scenario9:scenario9_B62E9CEB_A857_4BDC_8BC4_DE2D0B129191
