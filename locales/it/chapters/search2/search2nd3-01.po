msgctxt "search2:search2_4326134B_FF7B_4A4B_8BD2_38D5522A15CA"
msgid "⟪k:0⟫⟪k:1⟫⟪k:2⟫warm blood spills onto my cheeks, my hair, my skin."
msgstr "⟪k:0⟫⟪k:1⟫⟪k:2⟫avverto del sangue caldo che mi cola sulle guance, sui capelli, sulla pelle."

#: search2:search2_1412DDF5_ADB3_4A79_9474_163C095A2FAA
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: f0f0cc8b17c7cb837078f147c7b869d1974d9455b7a5c7bd8fe02509cab68a5d
