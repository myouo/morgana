msgctxt "search2:search2_09F798CD_19DD_43E8_B229_4FF82C14F5C9"
msgid ""
"⟪k:0⟫It was the first time I had found the courage to face my mother...⟪k:1⟫⟪k:2⟫to open up to "
"her."
msgstr ""
"⟪k:0⟫Fu la prima volta in cui trovai il coraggio di affrontare mia madre...⟪k:1⟫⟪k:2⟫di aprirmi "
"con lei."

