msgctxt "search2:search2_6C1E3712_DB41_4FC0_9741_04C66D419C6C"
msgid ""
"⟪k:0⟫Everything comes back to me all at once.⟪k:1⟫⟪k:2⟫That’s right... ⟪k:3⟫I watched Morgana "
"kidnap her."
msgstr ""
"⟪k:0⟫Tutto mi ritorna alla mente in un istante.⟪k:1⟫⟪k:2⟫Già... ⟪k:3⟫ho visto Morgana mentre la "
"rapiva."

#: search2:search2_317EB5A2_A2E1_46B1_839A_92BC9F210064
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 37f2235ce9ec1b63638aac6af6e729cef7019e67e297531840655bbae064a3e0
