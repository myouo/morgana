msgctxt "search2:search2_EC22BA4B_7D57_4ACF_A0BB_BEC27F9ADBDA"
msgid "⟪k:0⟫I don’t know how I got here, but I’m sitting in a rocking chair, hunched forward."
msgstr ""
"⟪k:0⟫Non so come sono arrivato qui, ma mi trovo seduto su una sedia a dondolo, piegato in avanti."

#: search2:search2_51653318_D752_A6F7_2D6E_F7A3A6DA7744
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 4faec0be2a7b61ca5404b5955cf628766df57cd7b04f1fadd6a46544b9d751ff
