msgctxt "search2:search2_154C13F9_6175_4E44_A4D1_EF744D825BEF"
msgid "⟪k:0⟫The smell of death fills the air."
msgstr "⟪k:0⟫L’odore di morte riempie l’aria."

#: search2:search2_657A7247_EA62_4BA7_BD1B_40B6FE41D4D5
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 37ced48b8400b83419e83bf13e1473241305ec9b0236343f367338bcc016372b
#. default-sha256: 8c0549bfe42c1a1cbe35ba0841ee99934499dfab41a282caaedaa3ad3582500e
