msgctxt "search2:search2_17EB4AD7_3926_4E87_8E3C_2AB06BD3CE2A"
msgid "⟪k:0⟫⟪k:1⟫Pitter patter, ⟪k:2⟫pitter patter.⟪k:3⟫⟪k:4⟫⟪k:5⟫There’s no end to the deluge."
msgstr "⟪k:0⟫⟪k:1⟫Plic, ⟪k:2⟫plic.⟪k:3⟫⟪k:4⟫⟪k:5⟫Non c’è fine al diluvio."

#: search2:search2_154C13F9_6175_4E44_A4D1_EF744D825BEF
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: dd1a4ff75c392a00cc9646593f2dae56ca338afd56a2fd1001532f683d247058
