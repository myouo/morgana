msgctxt "search2:search2_E6D58E53_F994_413A_A105_5D8EBF5414D6"
msgid "⟪k:0⟫⟪k:1⟫⟪k:2⟫“Why are you crying?”"
msgstr "⟪k:0⟫⟪k:1⟫⟪k:2⟫“Perché stai piangendo?”"

#: search2:search2_B1D48E8A_9185_4AF9_BAC1_6640F6142BFB
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 373824c34115d16e848f16ab702fc862f34ba6a703f7f68ca79fec6d01712d40
#. default-sha256: c847425c1c41b0da2e7329474d5ed5fe026f094b9017f0fd3cad3a865de7c72a
msgctxt "search2:search2_B1D48E8A_9185_4AF9_BAC1_6640F6142BFB"
msgid ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫“I’m sad because I didn’t get the chance⟪k:3⟫⟪k:4⟫to show my gratitude to people "
"very dear to me.”"
msgstr ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫“Sono triste perché non ho avuto l’opportunità⟪k:3⟫⟪k:4⟫di mostrare la mia "
"gratitudine alle persone a cui volevo bene.”"

#: search2:search2_F3109D9D_7670_425B_93A1_F83ECC9EA7D2
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 1c4d040895e516d1225c71d87a553f5e527e79de5e9c79e5edcb7ad99701516e
