msgid "⟪k:0⟫⟪k:1⟫⟪k:2⟫Nrgh! M-⟪k:3⟫Make it stop!"
msgstr "⟪k:0⟫⟪k:1⟫⟪k:2⟫Nrgh! F-⟪k:3⟫Fallo smettere!"

#: search2:search2_17EB4AD7_3926_4E87_8E3C_2AB06BD3CE2A
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 6f7b9de4b79e3e3f4207115c97e62b2cbe57a223870dfa6f7cdac40cfcf58805
