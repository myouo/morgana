msgid "⟪k:0⟫⟪k:1⟫⟪k:2⟫Hell? Or to the mountain of corpses?"
msgstr "⟪k:0⟫⟪k:1⟫⟪k:2⟫Verso l’inferno? ⟪k:3⟫O verso una montagna di cadaveri?"

#: search2:search2_AE38A9D5_2682_4351_8FAC_257E561701D4
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 8c6d4951439afbad96fc2a27b64a9a74e61e7e7ce6df692e9622ef492eb5ba06
