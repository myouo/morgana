msgctxt "search:search_3A7FA097_8099_4B4C_90DB_0DE1D276157B"
msgid "⟪k:0⟫⟪k:1⟫I can hear you..."
msgstr "⟪k:0⟫⟪k:1⟫Sì, riesco a sentirti..."

#: search:search_53E12C05_26DB_47D1_9EB4_35E31462CE24
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: e88965493e6cfa73d02c66e121f32b3955cb72cbd491742ebf7118b03157f9b8
#. default-sha256: 5adb59eb631acd98519008abeeaa6565d7f04b48320f70e4ebbdd32a5a55b0c1
msgctxt "search:search_53E12C05_26DB_47D1_9EB4_35E31462CE24"
msgid "⟪k:0⟫⟪k:1⟫Splendid."
msgstr "⟪k:0⟫⟪k:1⟫Ottimo."

#: search:search_AA1E2BF7_D662_4D19_BFD8_D0B8B08D191A
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 847cacf06bc3ed3f539c6d9c851909a9dc89bc70a28c928bd49e22b2c0a7b08a
#. default-sha256: 8ef27fbacf5b6acddea25bef89a5e561985b0fd4a2acce3f83ffbfce225c536f
msgctxt "search:search_AA1E2BF7_D662_4D19_BFD8_D0B8B08D191A"
msgid ""
"⟪k:0⟫Been so long since I’ve had a conversation,⟪k:1⟫I was afraid I might’ve forgotten how to "
"talk.⟪k:2⟫⟪k:3⟫So tell me, who might you be?"
msgstr ""
"⟪k:0⟫⟪k:1⟫È⟪k:2⟫ passato così tanto dall’ultima conversazione che ho avuto,⟪k:3⟫che avevo paura "
"di essermi dimenticato come si parla.⟪k:4⟫⟪k:5⟫Allora, dimmi, tu chi saresti?"

#: search:search_E1EF2AD4_F041_48C4_AB86_840D600A6EB6
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 0c127244f2a41fd4ef134f7f2383d6f3f9ab4042ebbfa2ebc4ff69b53e404959
#. default-sha256: 34a300e3a9e32f2e2cb21ea44edfe70e6b1340d237296149aa07ab050db4407a
msgctxt "search:search_E1EF2AD4_F041_48C4_AB86_840D600A6EB6"
msgid "⟪k:0⟫⟪k:1⟫I don’t know...⟪k:2⟫⟪k:3⟫I don’t know anything..."
msgstr "⟪k:0⟫⟪k:1⟫Non lo so...⟪k:2⟫⟪k:3⟫Non so niente..."

#: search:search_4D53616D_8E16_476F_8EAA_1318DB2A3890
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 1222cbb67dc50f3a2d79d64ab6f858f8147f36d204e2894f381599014bbadfb5
#. default-sha256: ab936da12eafb143629f596d1fe5c0530fb378dbebc4b3149680926baac2a2d8
msgctxt "search:search_4D53616D_8E16_476F_8EAA_1318DB2A3890"
msgid "⟪k:0⟫⟪k:1⟫You don’t know?⟪k:2⟫⟪k:3⟫Well, isn’t that quite the pickle."
msgstr "⟪k:0⟫⟪k:1⟫Non lo sai?⟪k:2⟫⟪k:3⟫Beh, questo sì che è un bel guaio."

#: search:search_8833BD8D_AEEA_4661_B533_6DE38CFDC60E
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 6f7ec965a2ef79729db7eb777f3349d16a8658f663d22f99512c631399a205d3
#. default-sha256: f309832cfc6112974258443b1e4ca6101ac4493b3b9f20852f8a51d2abbb7cdc
msgctxt "search:search_8833BD8D_AEEA_4661_B533_6DE38CFDC60E"
msgid ""
"⟪k:0⟫Then how ’bout we have a little chat, eh?⟪k:1⟫⟪k:2⟫You got yourself turned around and aren’t "
"sure where to go, yeah?"
msgstr ""
"⟪k:0⟫Che ne dici allora di farci una chiacchierata?⟪k:1⟫⟪k:2⟫Ti sei perso e non sai dove andare, "
"non è così?"

#: search:search_55D06A8D_6D62_4964_B686_5578F59611EC
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 2775e026673b4dd8ed3e2966433ebea9675df491681eaa0b940f03bd915d1192
