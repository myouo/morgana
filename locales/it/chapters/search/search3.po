msgstr "⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫............"

#: search:search_CC47AC18_588C_46BE_AFC9_C288EFF64651
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 40f082877ea25dcc2abdb46eaff536f84731fbfcf9709d2e180790fee376a25a
#. default-sha256: 144be5dc1499dc47bdac302f67d98c055bead56f9920fecdfb66154de9d03a4c
msgctxt "search:search_CC47AC18_588C_46BE_AFC9_C288EFF64651"
msgid "⟪k:0⟫⟪k:1⟫⟪k:2⟫(It does the opposite for me...)"
msgstr "⟪k:0⟫⟪k:1⟫⟪k:2⟫(A me trasmette la sensazione opposta...)"

#: search:search_3784042F_9D7B_4CE0_9C70_8140BD6B0EE6
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: d5d448f30535f97ebc921f2d7f7edb7e7d768809747ea66f361df2e0fd38284b
#. default-sha256: 9b305527e5362120c0b72e6cc4cd1e54db84f76d400ee5f851934d35827ec585
msgctxt "search:search_3784042F_9D7B_4CE0_9C70_8140BD6B0EE6"
msgid "⟪k:0⟫⟪k:1⟫⟪k:2⟫A dreadful, deep-rooted curse afflicts this mansion."
msgstr "⟪k:0⟫⟪k:1⟫⟪k:2⟫Questa dimora è afflitta da una terribile e profonda maledizione."

#: search:search_09EC7CC8_EB4C_4E07_AA96_11D3283A7612
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: d6c40f9111d4bea363498418e6433e2677a4743a78161e45636a7c7a4a2bd3bd
#. default-sha256: edcb8957d470d48b227557101c975bde3746a973abe89c27620d62dd060247c1
msgctxt "search:search_09EC7CC8_EB4C_4E07_AA96_11D3283A7612"
msgid ""
"⟪k:0⟫⟪k:1⟫However, this room is the one exception.⟪k:2⟫⟪k:3⟫Can you feel the purity that hangs in "
