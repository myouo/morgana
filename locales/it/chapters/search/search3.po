msgid "⟪k:0⟫⟪k:1⟫⟪k:2⟫(If we were ⟪k:3⟫both⟪k:4⟫ dead...)"
msgstr "⟪k:0⟫⟪k:1⟫⟪k:2⟫(Se fossimo ⟪k:3⟫entrambi⟪k:4⟫ morti...)"

#: search:search_EBB3EA2C_FB0A_4A58_BB2A_C84DC8B99CB5
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: fc2912c710171418823c2e141ffc8498150b6b569eb1a2cc19c12eb710001844
#. default-sha256: c346d0e17f91c8373b2dccf9e6282f2b160ef50aede1acd5bcda930c1f82d160
