msgid "⟪k:0⟫(She seems very... ⟪k:1⟫perky...)"
msgstr "⟪k:0⟫(Sembra... ⟪k:1⟫fin troppo vivace...)"

#: search:search_67ED44BC_7182_42C1_9862_18B5637A2D30
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 9a823172eebfdfabd6089f22abef649c9c34e133b5b286ec44fa10ad97d84bb2
