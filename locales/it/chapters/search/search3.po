msgid "⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫Again...?"
msgstr "⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫Un’altra volta...?"

#: search:search_913C6C5B_DE65_459D_8148_136B8DAAABE2
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 3d3af94d0bc9e28971486e9c21745c113fe4cd0b13dfe6f65da0e9c82343cffb
#. default-sha256: b97f193eab51c2dac26edb49ed5c9594e5bb438edf08939c327d77d19df2ebd3
msgctxt "search:search_913C6C5B_DE65_459D_8148_136B8DAAABE2"
msgid "⟪k:0⟫You said... ⟪k:1⟫you were waiting for me..."
msgstr "⟪k:0⟫Avevi detto... ⟪k:1⟫che mi stavi aspettando..."

#: search:search_B320244E_8E13_4AA2_8770_DAFE48335C47
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: f685b328c3a3b5b4d2006232b11c69cc97eb2ad17f0dd14b32daa0a86b1b0fa2
#. default-sha256: 3f7e8811e0279f96463baef1c55febde345970c3aeece39fccea5dafe529976f
msgctxt "search:search_B320244E_8E13_4AA2_8770_DAFE48335C47"
msgid ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫I did, indeed, say that when you first arrived.⟪k:3⟫⟪k:4⟫I have been waiting for "
"your return for a very long time."
msgstr ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫Proprio così, è ciò che ho detto al suo ritorno.⟪k:3⟫⟪k:4⟫Sa, Padrone, l’ho attesa "
"per molto tempo."

#: search:search_3559D7AC_CF00_3609_7196_1CA18989ADC0
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: e82d4c243f2123057ca681fdfae23df5f6eb63095f6730dc881fb7ed3785ab0d
#. default-sha256: c4ad2348da300bc6ccc74ef730a2e6a260cf23d6080f53df0e12f98e553da6c6
msgctxt "search:search_3559D7AC_CF00_3609_7196_1CA18989ADC0"
msgid "⟪k:0⟫For centuries, as a matter of fact."
msgstr "⟪k:0⟫Per centinaia di anni, a dir la verità."

#: search:search_140202FB_9473_4BAF_BFD0_E32CA5DCC3E3
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 704ad11a566b5fb500ca66b99a4640628396bdac6c93736f03ac8545af2c3bbb
#. default-sha256: 4f4817302149480849d75f233d6d4b54d2c80477b36304f9b9cdc89004f349b3
msgctxt "search:search_140202FB_9473_4BAF_BFD0_E32CA5DCC3E3"
msgid "⟪k:0⟫⟪k:1⟫...That would make me a ghost, then, you say?"
msgstr "⟪k:0⟫⟪k:1⟫...Questo fa di me un fantasma, dice?"

