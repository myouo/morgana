msgid "⟪k:0⟫G-⟪k:1⟫Giselle!"
msgstr "⟪k:0⟫G-⟪k:1⟫Giselle!"

#: badend4:badend4_44A31671_A439_46D8_82FF_255B41B70C64
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 95a0708e929901d0840b14dd2994c37da09206c9b05a901a71697acf2787544e
