#: badend4:badend4_D864E876_6908_4DFD_8C59_9960C551FBD0
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: e09ca6255de739b9b312a86312ec1ea80ec2361e2c2fcd95a4002479920fc4b6
#. default-sha256: 6244cbaa2015077cbbd40f69f697b1e8992c2209aed7ae916f135bd25bb90e2a
msgctxt "badend4:badend4_D864E876_6908_4DFD_8C59_9960C551FBD0"
msgid ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫⟪k:4⟫⟪k:5⟫⟪k:6⟫⟪k:7⟫⟪k:8⟫⟪k:9⟫⟪k:10⟫⟪k:11⟫⟪k:12⟫⟪k:13⟫⟪k:14⟫I ⟪k:15⟫"
"wanted⟪k:16⟫ to deny it."
msgstr ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫⟪k:4⟫⟪k:5⟫⟪k:6⟫⟪k:7⟫⟪k:8⟫⟪k:9⟫⟪k:10⟫⟪k:11⟫⟪k:12⟫⟪k:13⟫⟪k:14⟫⟪k:15⟫"
"Volevo⟪k:16⟫ negarlo."

#: badend4:badend4_43C57723_0AE5_4E6A_91A1_50A7736B839E
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: b56521cae3f0158e8b37bb1dc373133a8bbc105a3693c03d0aed4fdf78d1d68b
#. default-sha256: 15b178967fb67cb6d01ddbc97242c30f07d62e7994ebefe3db515d4a7d151681
msgctxt "badend4:badend4_43C57723_0AE5_4E6A_91A1_50A7736B839E"
msgid ""
"⟪k:0⟫She may have forgotten me, but what she felt still remains,⟪k:1⟫as evidenced by her "
"attraction to the White-Haired Girl—⟪k:2⟫⟪k:3⟫⟪k:4⟫who had many physical similarities to me."
msgstr ""
"⟪k:0⟫Può avermi dimenticato, ma ciò che provava è rimasto, come dimostrato dalla sua attrazione "
"per la Ragazza dai Capelli Bianchi—⟪k:1⟫⟪k:2⟫⟪k:3⟫la quale ha molte somiglianze con me."

#: badend4:badend4_9C2EAC76_A8D9_419D_81C0_982690FB038E
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: aac915752e5f2a796eb2c924c7ec4c6cdaa5ead482a51ca19f64e98a6a3bd9d9
#. default-sha256: a446126a13938c1ac8b730ba26e24c4c30565ebdcf5f4c404d504e92b99b26cd
msgctxt "badend4:badend4_9C2EAC76_A8D9_419D_81C0_982690FB038E"
msgid "⟪k:0⟫Her feelings are still there. ⟪k:1⟫I sincerely believe that."
msgstr "⟪k:0⟫I suoi sentimenti sono ancora lì. ⟪k:1⟫Ne sono convinto."

#: badend4:badend4_851B3478_1274_403C_8DEA_5A643985E0D4
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 20a2212c332a56b0941292ebf7c6b5176d1212fa2b1e15bb40304bd7e2e2c668
#. default-sha256: c62a517876aebddc3d359b2455e7cf769efa5b1da616eece745c71cb0cb35557
msgctxt "badend4:badend4_851B3478_1274_403C_8DEA_5A643985E0D4"
msgid ""
"⟪k:0⟫But her arctic gaze caused me to waver for the briefest moment. ⟪k:1⟫Perhaps I only wanted "
"to deny it for my own selfish reasons."
msgstr ""
"⟪k:0⟫Ma il suo sguardo gelido mi ha fatto esitare per un brevissimo istante.⟪k:1⟫⟪k:2⟫Forse "
"volevo negarlo solo per ragioni egoistiche."

#: badend4:badend4_2D2BD374_E3CE_430E_A7A5_A76BBE55101A
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: af33316a713bc8918a5deed023a40910792e7e257dc6ba9ff0201ebb592b4be2
#. default-sha256: e757732dfda435f285c08c2b890f7fa837a1643b5aafeda1d7ab6bcc0fd13a1b
msgctxt "badend4:badend4_2D2BD374_E3CE_430E_A7A5_A76BBE55101A"
msgid "⟪k:0⟫It was only a few, short seconds,"
msgstr "⟪k:0⟫Non sono stati che pochi, brevi secondi,"

#: badend4:badend4_455C04DF_3FC9_44B9_A371_3FCBD45D2299
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 2939677bc1052559df64073f6646d448a7cc64f2ba3d293bc4b7e1ba830547d6
#. default-sha256: c5729459808049b0e12783edac42590294eb55eddca9e613d1eee896596f210a
msgctxt "badend4:badend4_455C04DF_3FC9_44B9_A371_3FCBD45D2299"
msgid "⟪k:0⟫but those seconds decided it all."
msgstr "⟪k:0⟫ma quei secondi hanno deciso ogni cosa."

#: badend4:badend4_E0D52035_C1FD_40D0_9118_D14ECC478C99
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
