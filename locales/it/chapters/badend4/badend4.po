#: badend4:badend4_016BD7A2_04E1_497B_A66B_E34C427F0DAB
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 569f7a1b2ed63d887fb181a0fd620e1390dd0ee231b1b0f0902175a6eae422ae
#. default-sha256: 5758f7f48855c60298c7f3bbe3917462b533da9f184f372da86bdd086e11f842
msgctxt "badend4:badend4_016BD7A2_04E1_497B_A66B_E34C427F0DAB"
msgid ""
"⟪k:0⟫Darkness consumes everything.⟪k:1⟫⟪k:2⟫My voice. My hands. My very being.⟪k:3⟫⟪k:4⟫And her "
"gaze."
msgstr ""
"⟪k:0⟫L’oscurità consuma ogni cosa.⟪k:1⟫⟪k:2⟫La mia voce. Le mie mani. Il mio essere.⟪k:3⟫⟪k:4⟫E "
"il suo sguardo."

#: badend4:badend4_3EC6C99D_EE3D_43B7_857D_F76FCB16D6F3
