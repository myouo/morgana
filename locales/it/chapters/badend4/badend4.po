msgid "⟪k:0⟫⟪k:1⟫⟪k:2⟫Farewell, Michel."
msgstr "⟪k:0⟫⟪k:1⟫⟪k:2⟫Addio, Michel."

#: badend4:badend4_DEDD2D2D_E3D0_4446_8DB8_75FE39F1FEEE
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 4d5b04fdf1a6531e8e5fa48c61cabb5c313130c53726bd86d75a160ce9d57fef
