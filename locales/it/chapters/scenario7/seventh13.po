msgid ""
"⟪k:0⟫Whatever nonsense that woman filled your head with,⟪k:1⟫it certainly seems to have put some "
"fight into those eyes."
msgstr ""
"⟪k:0⟫Qualunque assurdità ti abbia messo in testa quella donna,⟪k:1⟫di certo ha riacceso il fuoco "
"nei tuoi occhi."

#: scenario7:scenario7_5E250B83_3019_4707_A6F5_7B56EC625D66
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: d99ccbcad35a9c856f537a8f1496274b7c5001b4ffdb90ae0aa8ff6b9d375a73
#. default-sha256: 995b4712fcdf1424b591d2d812ac8a473046e2163420240e9f8cfe95f1017a8e
