msgctxt "scenario7:scenario7_C868D4F1_2DC3_4B08_B4FB_216653ABEDDC"
msgid ""
"⟪k:0⟫This is my mansion. ⟪k:1⟫My domain.⟪k:2⟫⟪k:3⟫She was ⟪k:4⟫supposed⟪k:5⟫ to be locked up,"
msgstr ""
"⟪k:0⟫Questa è la mia villa. ⟪k:1⟫Il mio dominio.⟪k:2⟫⟪k:3⟫Lei sarebbe dovuta rimanere rinchiusa,"

#: scenario7:scenario7_2B1306B5_E4DA_499A_A661_6936ECC0D8BB
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 063647b45f09434dadf01b5cf67e95eb97447ea2cd13c9f8803f8bd6b90dfb4e
