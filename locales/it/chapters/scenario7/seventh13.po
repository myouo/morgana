msgid "⟪k:0⟫Well, good for you, my dear."
msgstr "⟪k:0⟫Beh, buon per te, mio caro."

#: scenario7:scenario7_D3387E17_242B_4891_9DEB_F2FA0A2444A8
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 564bbb0b0e149d73f5b0c6ad539941b042c8614afe1fd18ddbdf8c2157eeb246
#. default-sha256: a829e4b6c5f7f3151e44c24d8ee9a20fd00522e9f0b8ebd85deddb4f96c30350
msgctxt "scenario7:scenario7_D3387E17_242B_4891_9DEB_F2FA0A2444A8"
msgid ""
"⟪k:0⟫A little confidence boost doesn’t erase the fact that you were on the ground, crawling "
"through the filth like a worm, tears streaming down your face as you tried to ignore what lay "
"before you."
msgstr ""
"⟪k:0⟫Una piccola carica di fiducia non cancella il fatto che eri a terra, strisciando nella "
"sporcizia come un verme, con le lacrime che ti bagnavano il viso mentre cercavi di ignorare ciò "
"che avevi davanti."

