msgid "⟪k:0⟫Even I feel blessed... ⟪k:1⟫compared to you."
msgstr "⟪k:0⟫Persino io mi sento fortunato... ⟪k:1⟫in confronto a te."

#: scenario7:scenario7_1044E7B9_BCB3_4E2A_B1D2_004CBC09D103
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 9a0fb2da29e2b753df312ca890328fec0ec457cc436e59f73b16a0d6ac9c64b0
