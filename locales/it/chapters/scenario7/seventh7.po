msgid "⟪k:0⟫stained-glass window...?"
msgstr "⟪k:0⟫una vetrata...?"

#: scenario7:scenario7_B12DF282_261A_452D_8216_44715016049B
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: d1382c1e6de8a7db812c15e8ff6f59c30a09488670e15cf4950b789d5941e054
