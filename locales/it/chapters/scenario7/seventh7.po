msgid "⟪k:0⟫Water pushed out all the air, swallowing me up, suffocating me."
msgstr "⟪k:0⟫L’acqua spingeva via tutta l’aria, inghiottendomi, soffocandomi."

#: scenario7:scenario7_732FDE14_8134_4626_BF16_D0C5AB7444E9
