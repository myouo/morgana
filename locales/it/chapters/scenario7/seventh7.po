msgid "⟪k:0⟫⟪k:1⟫You have my pity, though."
msgstr "⟪k:0⟫⟪k:1⟫Ma hai la mia compassione."

#: scenario7:scenario7_CADE1978_894F_4C1B_AB07_9C71BA262DE4
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 943a7ac5a5aa08ea5290076de976a59ca55ddd3ac57356720f31b3da56906602
