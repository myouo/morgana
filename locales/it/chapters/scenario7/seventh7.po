msgid "⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫Poor child."
msgstr "⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫Povera creatura."

#: scenario7:scenario7_ABA3EF0D_6DD3_46A7_A76A_8ABEA1DCD8A8
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: e31adf553d332c98cf0075d08e6efe01728fd960b2e02874563a7c5207852ecd
