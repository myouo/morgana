msgid "⟪k:0⟫⟪k:1⟫You poor, poor child..."
msgstr "⟪k:0⟫⟪k:1⟫Povera, povera creatura..."

#: scenario7:scenario7_BF1AC9D6_9718_4DAF_BFD3_48556B9C60B1
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: bcc6f669e806126357ff46e2298ac1f2e217ec00782a24a98c53fc410deef158
#. default-sha256: 3ead85ea99d6f927e0a1a69a23cb09faee15e84d25b92361d0ada5ab85c6a76d
msgctxt "scenario7:scenario7_BF1AC9D6_9718_4DAF_BFD3_48556B9C60B1"
msgid ""
"⟪k:0⟫By pretending to pity someone who had had it worse than me,⟪k:1⟫⟪k:2⟫I was able to feel "
"somewhat better about myself."
msgstr ""
"⟪k:0⟫Fingendo di provare pietà per qualcuno che aveva affrontato cose peggiori di me,⟪k:1⟫ "
"riuscii a sentirmi meglio per me stesso, in un certo senso."

#: scenario7:scenario7_D6E3C3D0_3678_4356_9740_08C969B3AC41
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 333d26d3d7201a6dfc0ea500304e974306f33d4b1b64a61538114947d8ee3ed7
