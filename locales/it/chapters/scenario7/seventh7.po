msgid ""
"⟪k:0⟫Two columns of evenly spaced pews ran the length of the room,⟪k:1⟫all facing the "
"multicolored window."
msgstr ""
"⟪k:0⟫Due file di panche, distanziate uniformemente tra loro, occupavano⟪k:1⟫la sala, rivolte "
"verso la finestra multicolore."

#: scenario7:scenario7_348D7897_C894_48AA_8B05_1DB6BE7FA98E
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 2ac1d2adc2a90ae703adef5b83bfb69b032ad676b2d65bfe592c14b861ed706a
#. default-sha256: 28446c6a7404831c51dfb232e8e8c8352f6ac8fcd1a4be55d3289f6573b4c3a1
msgctxt "scenario7:scenario7_348D7897_C894_48AA_8B05_1DB6BE7FA98E"
msgid "⟪k:0⟫I set the candlestick on a podium of some sort, which is when I realized—"
msgstr "⟪k:0⟫Poggiai il candeliere su un podio di qualche tipo,⟪k:1⟫e fu allora che mi resi conto—"

