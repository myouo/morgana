msgctxt "scenario7:scenario7_D6E3C3D0_3678_4356_9740_08C969B3AC41"
msgid "⟪k:0⟫Because if I was in a position to pity someone else..."
msgstr "⟪k:0⟫Perché se ero in una posizione per compatire qualcun altro..."

#: scenario7:scenario7_394AC233_87A7_4B95_AC22_51DFA34BE575
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: c9272996100fd34e5ae537ddf339cd8506da0271f7b41d0b4224e9aab2390384
