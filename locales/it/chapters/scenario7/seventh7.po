msgctxt "scenario7:scenario7_1044E7B9_BCB3_4E2A_B1D2_004CBC09D103"
msgid ""
"⟪k:0⟫Oh, how miserable it must have been, locked away up in this tower... ⟪k:1⟫To have your arm "
"mercilessly severed..."
msgstr ""
"⟪k:0⟫Ahh, quanto dev’essere stato orribile, rimanere rinchiuso in questa torre... ⟪k:1⟫Perdere il "
"braccio in questo modo, reciso senza pietà..."

#: scenario7:scenario7_435D196C_FC86_482D_888C_DCE33D0A36D7
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 0caacf9482501a4c3eace48e63d57a90bddcbf379e0f3e7def355b4724b8ad84
