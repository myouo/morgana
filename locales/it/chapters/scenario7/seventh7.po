msgid "⟪k:0⟫I alone shall mourn your death..."
msgstr "⟪k:0⟫Solo io piangerò la tua morte..."

#: scenario7:scenario7_C7F4B452_3CA5_46CA_949D_B73906C73C27
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: c87cc18d2e37fe8f3a6f24fe7cb307ccd38464bb03788a56776186ca2edc2b45
