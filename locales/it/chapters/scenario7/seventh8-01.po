msgstr "⟪k:0⟫Lo uccidiamo?"

#: scenario7:scenario7_0A5F76DF_0B8B_46B1_A2CA_DA1DDCF29E00
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 6c0ff36c13f2b4d0aa3ca9f750a413e4050300cf66d994062eb07fdf6edf7a95
#. default-sha256: 98016ad5549217c62d1cc414676e8388e8e300547ed4978baab70b9e70e3f039
msgctxt "scenario7:scenario7_0A5F76DF_0B8B_46B1_A2CA_DA1DDCF29E00"
msgid "⟪k:0⟫He deserves at ⟪k:1⟫least⟪k:2⟫ that.⟪k:3⟫⟪k:4⟫He brought you more than enough pain."
msgstr "⟪k:0⟫Si merita ⟪k:1⟫almeno⟪k:2⟫ quello.⟪k:3⟫⟪k:4⟫Ti ha causato fin troppo dolore."

#: scenario7:scenario7_8906939C_E484_4AD9_B410_5DD0F4EABDB9
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: ad2633c848c72422f37681238291087e85ba8fc0f7b4106eaef93a1e207b389f
#. default-sha256: 604685b9a54ae9b6cd23c866c1d53fc293fed2fbf374a59ff93d550163d5ee19
msgctxt "scenario7:scenario7_8906939C_E484_4AD9_B410_5DD0F4EABDB9"
msgid ""
"⟪k:0⟫But if you would rather... ⟪k:1⟫you could curse your mother instead.⟪k:2⟫⟪k:3⟫Or the woman "
"who set you on this path..."
msgstr ""
