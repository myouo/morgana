msgctxt "scenario7:scenario7_9FA6C8F3_2B7D_4816_A931_950BCA707563"
msgid "⟪k:0⟫and I shall do the same for you."
msgstr "⟪k:0⟫e io farò lo stesso per te."

#: scenario7:scenario7_ED94CB92_5964_46E6_9B5A_7065208EF56B
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 35eca9bbb9998408b74f8bf5d3bef583f59ac1f5be01705d667aa510c625cb2c
#. default-sha256: 50d4b0af42c033e9905bddf0351fde09abfa9bbdcd62678922c85f8f434efedc
msgctxt "scenario7:scenario7_ED94CB92_5964_46E6_9B5A_7065208EF56B"
msgid "⟪k:0⟫You can give me life again. You can resurrect me."
msgstr "⟪k:0⟫Puoi ridarmi la vita. Puoi resuscitarmi."

#: scenario7:scenario7_7F088681_CBC3_406F_B370_45C16AA79EFD
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: de201270659792b18057a16eba624b07ac28d898bd75f639769799bb67dd577b
#. default-sha256: 0d651b53eb2ff1433e904f250ef6353ca14b4ee2a969fb8481dcb957dbdbdddb
msgctxt "scenario7:scenario7_7F088681_CBC3_406F_B370_45C16AA79EFD"
msgid ""
"⟪k:0⟫It felt like I was no longer in control of my own body.⟪k:1⟫⟪k:2⟫Her voice was tender in a "
"way unlike either Mother’s or Aimee’s."
msgstr ""
"⟪k:0⟫Mi sentivo come se non avessi più il controllo del mio corpo.⟪k:1⟫⟪k:2⟫La sua voce era "
"soave, ma in modo diverso da quella di mia Madre⟪k:3⟫o di Aimee."

#: scenario7:scenario7_E693A7E3_F555_4086_BBE8_BDB52E3857CF
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 61c48da8bf268e3964aff60d493fba5cc27e482ebb0e4f9b4f4521b03d67d157
#. default-sha256: 96657c11f6d6d97f274f9ed4d5a8f68618d307420a6f4698dada6fcda19bc866
msgctxt "scenario7:scenario7_E693A7E3_F555_4086_BBE8_BDB52E3857CF"
msgid "⟪k:0⟫It was empty."
msgstr "⟪k:0⟫La stanza era vuota."

#: scenario7:scenario7_D33AF05A_D351_474B_AC22_EB755E2EBFAD
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: d5dbebadd42e296aff6d3e7c7196856a1860e83089b327ec61cdb4d283a07a96
#. default-sha256: a575a9528dd6b4c6b3e15a25a7b672cd96e31697ccb4c07d24e120463b5a1db5
msgctxt "scenario7:scenario7_D33AF05A_D351_474B_AC22_EB755E2EBFAD"
msgid "⟪k:0⟫only her voice whispering in my ear."
msgstr "⟪k:0⟫solo la sua voce che mi sussurrava all’orecchio."

#: scenario7:scenario7_1F16E57D_9149_4683_A6EF_EE377EEF2BDD
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: b34f9216bb5f8a47534c69e3802bc25f0729262b17d8ca37a4b215c7c45fdf56
