msgctxt "scenario7:scenario7_1F16E57D_9149_4683_A6EF_EE377EEF2BDD"
msgid "⟪k:0⟫You made this possible..."
msgstr "⟪k:0⟫Tu l’hai reso possibile..."

#: scenario7:scenario7_38463CB7_E401_467F_9703_51F921B5D5D9
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 95c1d2de5d839f624fe55a29664952404bcad666e018fcd4746ef3a627827c2a
