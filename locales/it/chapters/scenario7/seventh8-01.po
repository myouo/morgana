msgctxt "scenario7:scenario7_771B2BBE_68D4_4842_B6F4_FAF4FD301BC8"
msgid "⟪k:0⟫Morgana..."
msgstr "⟪k:0⟫Morgana..."

#: scenario7:scenario7_745E07C6_2877_4A93_BE88_6009A8257722
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: f3f81aae7509ac599ae3d8b78dd9f62da8ceeba544ef0b2d2fc2e757541fe7bc
#. default-sha256: 18030be9b7caebeb9433a3feacb233a93851ab991789e664a3e9230237265360
msgctxt "scenario7:scenario7_745E07C6_2877_4A93_BE88_6009A8257722"
msgid ""
"⟪k:0⟫I could place a curse on someone you have a grudge against.⟪k:1⟫⟪k:2⟫Drag them down into the "
"dark abyss."
msgstr ""
"⟪k:0⟫Potrei lanciare una maledizione su qualcuno verso cui nutri rancore.⟪k:1⟫ Trascinarlo nel "
"buio profondo."

#: scenario7:scenario7_5591326A_723D_440F_BD0C_467CDB8381D6
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: b15e9d9a8eaeec402353708efbc1b2f3bbda3bf971bac18e36cab584ab8222b0
