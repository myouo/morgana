msgctxt "scenario7:scenario7_F26DF4E0_B5F5_4A9A_AADA_023B06F5F5DA"
msgid "⟪k:0⟫Tell me who you wish to curse...⟪k:1⟫⟪k:2⟫and I can lead them here."
msgstr "⟪k:0⟫Dimmi chi vuoi maledire...⟪k:1⟫ e posso condurlo fino a qui."

#: scenario7:scenario7_5455BC8D_74CC_4A29_9CA7_A75AD3ED4949
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: c429a9f23ab27da1c5366b2625119a3de74be181eb00136d5c1ff55145b0d631
#. default-sha256: 2ebb7d4d4fdb3e06db891ff3c75fc81bd1a87b225aaee8e7d9f21fea1d0c1b35
msgctxt "scenario7:scenario7_5455BC8D_74CC_4A29_9CA7_A75AD3ED4949"
msgid "⟪k:0⟫I can force the cross you were made to bear onto them."
msgstr "⟪k:0⟫Posso obbligarlo a portare la croce che ti ha costretto a sostenere."

#: scenario7:scenario7_DCB2D6AB_E33F_4477_9CBE_4AB12A0CCD9A
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
