msgctxt "scenario7:scenario7_B635749A_FC83_4FFC_A662_B0FD9832BB0B"
msgid "⟪k:0⟫⟪k:1⟫And my name is Morgana."
msgstr "⟪k:0⟫⟪k:1⟫Il mio nome è Morgana."

#: scenario7:scenario7_771B2BBE_68D4_4842_B6F4_FAF4FD301BC8
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: e147b2ba3286fcf22a2642f964b8d2112a233d8c74d04327bb3f18140b567c89
