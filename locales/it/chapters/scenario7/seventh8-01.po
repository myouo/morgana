#: scenario7:scenario7_4192695C_CD64_45F6_B7B2_D9385A7FEC77
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 08984a8a733c7348409befd8ef3969f20ed2965d80f776dd490ee999d3260d55
#. default-sha256: d45066d44dfaedc441c40160d5a387876f1a8f5b3076bb22dd3211a4c767c151
msgctxt "scenario7:scenario7_4192695C_CD64_45F6_B7B2_D9385A7FEC77"
msgid "⟪k:0⟫When you arrived at this house... ⟪k:1⟫I felt the hands of fate at work."
msgstr ""
"⟪k:0⟫Quando sei arrivato in questa casa... ⟪k:1⟫ho percepito le mani del fato che si mettevano "
"all’opera."

#: scenario7:scenario7_81463A50_FEBD_4A7A_9C7A_E2EC0C6BCF0C
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 88238e5ba00ef627e9f11ad0515efa4eebcc8ed8421dca8b2f17f3ddd7ed4112
#. default-sha256: b4eceabf70906ba07678ede85fa75622b2877478659b4b0422ff3f809d84407c
msgctxt "scenario7:scenario7_81463A50_FEBD_4A7A_9C7A_E2EC0C6BCF0C"
msgid "⟪k:0⟫You’ve been through so much to get here..."
msgstr "⟪k:0⟫Ne hai passate tante prima di giungere sin qui..."

#: scenario7:scenario7_D858E240_F039_447C_B1C0_07C43C90FB4C
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 29643c66164d526580ab08c971fbbe0ebcce6f4757eae5bc0882c8b58c4b892e
