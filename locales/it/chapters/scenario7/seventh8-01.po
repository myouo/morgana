msgctxt "scenario7:scenario7_38463CB7_E401_467F_9703_51F921B5D5D9"
msgid "⟪k:0⟫Constant, everlasting despair..."
msgstr "⟪k:0⟫Una disperazione costante, eterna..."

#: scenario7:scenario7_2FA8154B_757D_40E8_B98D_4630AF243643
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: d06b47a780dfe4658e3d4d6f0485edc156cf48b5513b0d4edf1dd94d30a79860
#. default-sha256: 8fdcdb67886495ec45379a540069a3fa8a03cf3215b7e78cc94a3bf78391c4cc
msgctxt "scenario7:scenario7_2FA8154B_757D_40E8_B98D_4630AF243643"
msgid "⟪k:0⟫Their flesh may turn to dust..."
msgstr "⟪k:0⟫La loro carne potrà anche diventare cenere..."

#: scenario7:scenario7_D4E5927C_C209_48BF_A235_21727A0C5234
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 80c991e6a757a192355679e9b067a39fe2f47c68499408ecf44feb94dc06b3ad
#. default-sha256: 732998d5c6e6401b916608d36cccec5d5d14099d26a1ee4dd9573f625fa0feaa
msgctxt "scenario7:scenario7_D4E5927C_C209_48BF_A235_21727A0C5234"
msgid "⟪k:0⟫but so long as their souls live on, their torture will know no end..."
msgstr ""
"⟪k:0⟫ma fintanto che le loro anime continueranno a vivere,⟪k:1⟫la loro tortura non avrà fine..."

#: scenario7:scenario7_D449F5C1_B1B1_4276_B37A_ADD7D10D46BE
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 81f763886f80caee9b2e53ca2fbb6fee4b03b22c29d44d175b2262172350872a
#. default-sha256: 324cf73e194d22edec41d5d37194ec8e7afd14ab795bce37469fe0261b4fc0de
msgctxt "scenario7:scenario7_D449F5C1_B1B1_4276_B37A_ADD7D10D46BE"
msgid ""
"⟪k:0⟫The tenderness in her voice crumbled away, leaving only raw loathing behind. ⟪k:1⟫She then "
"let out a half-muffled cackle."
msgstr ""
"⟪k:0⟫La dolcezza nella sua voce si sgretolò, lasciando dietro di sé nient’altro che puro "
"disprezzo. ⟪k:1⟫E poi, emise una risatina ovattata."

#: scenario7:scenario7_9BCB69A7_9EEB_4A04_BAB8_2B40788CF6C1
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: a90af86a92a89436fe5a570e4e8eddc613bd7a5ac1db697384a68b6d90b8095e
#. default-sha256: 0d035985c7c6fa477b69d42f33592e74e1d245f6d100e5f6eff8b5a3d1a8aae5
msgctxt "scenario7:scenario7_9BCB69A7_9EEB_4A04_BAB8_2B40788CF6C1"
msgid "⟪k:0⟫Who ⟪k:1⟫are⟪k:2⟫ you?"
msgstr "⟪k:0⟫⟪k:1⟫Chi sei⟪k:2⟫ tu?"

#: scenario7:scenario7_E2088DD3_5F4E_4D55_B5A4_21971D01EB82
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 10ea44464ff798536a98042020458ae949b8f65c074e83fb25b8d4b1de66334a
#. default-sha256: b8e3431fb5f997f1eace3b8d1b613b6b22e6ba2eab886dbe0525d1e2241edbf1
msgctxt "scenario7:scenario7_E2088DD3_5F4E_4D55_B5A4_21971D01EB82"
msgid ""
"⟪k:0⟫That I am.⟪k:1⟫⟪k:2⟫I am the cursed witch, who loathes this puny, wretched world—⟪k:3⟫⟪k:4⟫"
"⟪k:5⟫curses it."
msgstr ""
"⟪k:0⟫⟪k:1⟫È⟪k:2⟫ così.⟪k:3⟫⟪k:4⟫Io sono la strega maledetta, colei che disprezza questo gracile, "
"miserabile mondo—⟪k:5⟫⟪k:6⟫colei che lo ha maledetto."

#: scenario7:scenario7_B635749A_FC83_4FFC_A662_B0FD9832BB0B
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 0bab83c23ac7ed71fdf9c01df1c55862ddfa4c84c64d27074aeb2cf7fbfd6823
