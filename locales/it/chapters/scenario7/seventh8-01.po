msgctxt "scenario7:scenario7_D858E240_F039_447C_B1C0_07C43C90FB4C"
msgid "⟪k:0⟫I know your pain."
msgstr "⟪k:0⟫Conosco il tuo dolore."

#: scenario7:scenario7_A1F30229_A70F_4449_B9EA_47D4032BAEA2
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 3358904e7959ffe9400c6ccd7ce7be2cd489d7753ea22a5e7683b33526d8d3cc
#. default-sha256: abc14a92d2c03fec5285779a040c2dcb3570179e242cf1d025e018b87a388b7e
msgctxt "scenario7:scenario7_A1F30229_A70F_4449_B9EA_47D4032BAEA2"
msgid "⟪k:0⟫You were the only one to ever have pity for me..."
msgstr "⟪k:0⟫Tu sei l’unico che abbia mai provato compassione per me..."

#: scenario7:scenario7_9FA6C8F3_2B7D_4816_A931_950BCA707563
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: ff27566dee87f95a3169661448e0df1b50ecb3009d644060abaf567e88ea8d70
