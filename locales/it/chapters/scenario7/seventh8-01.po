msgctxt "scenario7:scenario7_4965D32C_A833_4DA2_A2B2_72ED7724F309"
msgid "⟪k:0⟫if you remain steadfast in your desires, they will become reality,"
msgstr "⟪k:0⟫se rimarrai fedele ai tuoi desideri, questi diverranno realtà,"

