#: scenario7:scenario7_89A6D2BA_A23B_4F01_B560_DA41FEB41DDD
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: d51b703b696b7cf0f56139a7d623071afa03c9db5c3c6b03d866c6030a40679b
#. default-sha256: c69ffe5a5afb6f2668f6616344e1fcd1bd35248334bee7c87496169ef644cab5
msgctxt "scenario7:scenario7_89A6D2BA_A23B_4F01_B560_DA41FEB41DDD"
msgid ""
"⟪k:0⟫Heavy clouds filled the sky, blocking out the sun and giving the impression of late evening "
"all throughout the day."
msgstr ""
"⟪k:0⟫Grosse nuvole ricoprivano il cielo, bloccando il sole, e dando l’impressione di essere tarda "
"serata per tutto il giorno."

#: scenario7:scenario7_EA98D4F6_2D01_49A2_9CC9_08B6B91AF57B
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 3d9ba3697b3fc5b92f278116892f90bd073bcaf10455f3ab47822edbc6f063a7
#. default-sha256: 4ae1f723459de1e7a851660ffb85b20375699df609c6a6db789ff976b5192702
msgctxt "scenario7:scenario7_EA98D4F6_2D01_49A2_9CC9_08B6B91AF57B"
msgid ""
"⟪k:0⟫Which meant I could only go outside on days when the weather made most everyone else gloomy."
msgstr ""
"⟪k:0⟫Il che voleva dire che potevo uscire solo nelle giornate in cui il clima avrebbe oscurato "
"ogni cosa."

#: scenario7:scenario7_62BE9474_951A_4850_AB0B_48F8BF4C4213
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 97a2e2a316ef24cfab2f3cbe5c69ff82d1d2b7b95c7b471437630434dbfae0ea
#. default-sha256: 643a03d2c292661da728f31c1460f64865ea7204a8abd96c82e299c226809b75
msgctxt "scenario7:scenario7_62BE9474_951A_4850_AB0B_48F8BF4C4213"
msgid "⟪k:0⟫⟪k:1⟫⟪k:2⟫...?"
msgstr "⟪k:0⟫⟪k:1⟫⟪k:2⟫...?"

#: scenario7:scenario7_43E1C2D0_3F06_485B_BCC9_00626FFF67B2
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 942ce1ed1e13eb8066702fc4cd045fedb119d09ad59355797c4935e7382f5a4c
#. default-sha256: e20c318af6ceac048b48d96c6df8ab50663c5fc38146ee53184554f871401fae
msgctxt "scenario7:scenario7_43E1C2D0_3F06_485B_BCC9_00626FFF67B2"
msgid "⟪k:0⟫A warm breeze blew past, sending up a swirl of flower petals."
msgstr "⟪k:0⟫Una brezza tiepida mi venne incontro, sollevando un vortice di petali di fiori."

#: scenario7:scenario7_FE166405_06E9_48C9_B91E_7D545B24CDC6
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: f89173d8df2abaec9f79c4ae5e648497de23ba1a14532538be91454d4c0dc777
#. default-sha256: d96b51bd3cb3be2c5f4b5ee042f94d31ee9a6cc9cea5a337664f61ed94f92c87
msgctxt "scenario7:scenario7_FE166405_06E9_48C9_B91E_7D545B24CDC6"
msgid "⟪k:0⟫The girl’s dress hung lightly over her frame, tracing her gentle curves."
msgstr ""
"⟪k:0⟫Il vestito della ragazza aderiva leggermente sul suo corpo, calcando le sue dolci curve."

#: scenario7:scenario7_CFB6B5B7_B005_45AD_AEAE_EF9562430783
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: b4ae2c697ac7a96680d0c08427828f5e0136aa0c23fde48d78c8b1dc396e44ed
#. default-sha256: 6cae8fbd414974b9e86a94da3ffb4a4fb744215bd8ba70fdd37d952e32a08d82
msgctxt "scenario7:scenario7_CFB6B5B7_B005_45AD_AEAE_EF9562430783"
msgid "⟪k:0⟫⟪k:1⟫And you are?"
msgstr "⟪k:0⟫⟪k:1⟫E tu saresti?"

#: scenario7:scenario7_E59D31B4_85C2_4732_A368_4E4D1F67B857
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 4ea3e0af93924be92d9e65cd5b7dddc89a6ee8e06c5426879c373f08e28a1deb
#. default-sha256: f550bb27c8873ecd2965a44677015cac9588a182edb9c628fc3fc9901f129cb7
msgctxt "scenario7:scenario7_E59D31B4_85C2_4732_A368_4E4D1F67B857"
msgid "⟪k:0⟫⟪k:1⟫My name is Aimee.⟪k:2⟫⟪k:3⟫It’s a pleasure to finally meet you."
msgstr ""
"⟪k:0⟫⟪k:1⟫Il mio nome è Aimee.⟪k:2⟫⟪k:3⟫⟪k:4⟫È⟪k:5⟫ un piacere poterti finalmente incontrare."

#: scenario7:scenario7_F9079209_E85A_47FC_B2FA_F9843BD38D98
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 194a769c7e053ce33dbe68bbca7af19073da334911f7221fa48e19d5c62b22e6
#. default-sha256: 12d6877ba153aa5536fc62e36be7f22a8d83572b87cceea605a17333b5b478e5
msgctxt "scenario7:scenario7_F9079209_E85A_47FC_B2FA_F9843BD38D98"
msgid "⟪k:0⟫she stepped toward me, kissing me softly on the cheek."
msgstr "⟪k:0⟫lei fece un passo verso di me, baciandomi delicatamente sulla guancia."

#: scenario7:scenario7_BDFDDAED_DC39_40E0_BAAC_48879F664DE0
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: a091797d4f75ea8f3e38dac2aa8de8bfc2ae3f63e384fb5f9d8aeba5bf2dd420
#. default-sha256: 99aae5e79f314acd326042b0e541467285711fa7aa92e0ea0440539abdb9d36f
msgctxt "scenario7:scenario7_BDFDDAED_DC39_40E0_BAAC_48879F664DE0"
msgid "⟪k:0⟫Electrifyingly sweet."
msgstr "⟪k:0⟫Incredibilmente dolce."

#: scenario7:scenario7_09505D2C_BFC5_4070_A5DF_6C8CB3F33C4C
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 7cc98e3d7143294ae0e5b60404c7bc35a5e463a5091c7630dfba0cb786ac6b3d
#. default-sha256: 729f0a8218ebfec3af713b91929cd95988f11cff249e1ade73c5680b210fb1e1
msgctxt "scenario7:scenario7_09505D2C_BFC5_4070_A5DF_6C8CB3F33C4C"
msgid "⟪k:0⟫⟪k:1⟫I’m Georges’s fiancée."
msgstr "⟪k:0⟫⟪k:1⟫Sono la fidanzata di Georges."

#: scenario7:scenario7_0CC24CFF_DFBA_42EC_A670_E87AED53CB32
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 58d8420866ddbbea1d0d15c37f598449d1f80494d4a3db45568098836df5a286
#. default-sha256: ecded285d2f93b984bbaa8e2c1fd7027d8cbe74dcc012b7bb19452e7af04f104
msgctxt "scenario7:scenario7_0CC24CFF_DFBA_42EC_A670_E87AED53CB32"
msgid "⟪k:0⟫And it also"
msgstr "⟪k:0⟫Ed era anche"

#: scenario7:scenario7_7FC60674_11DD_464C_AB5F_B4B8A969DD1D
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: df4147fd8df76ed3977f53c6391fd03c175b90c633689e3d90ac56c7825f940a
#. default-sha256: 41a1cc86173473421c53d921af2e17b35f0c6da8c869874083809daa9c318f51
msgctxt "scenario7:scenario7_7FC60674_11DD_464C_AB5F_B4B8A969DD1D"
msgid ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫⟪k:4⟫⟪k:5⟫⟪k:6⟫⟪k:7⟫⟪k:8⟫She was a noble girl by the name of Aimee Joubert. "
"⟪k:9⟫Though only fifteen, she was the very image of refined—⟪k:10⟫⟪k:11⟫polished to a shine."
msgstr ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫⟪k:4⟫⟪k:5⟫⟪k:6⟫⟪k:7⟫⟪k:8⟫Era una ragazza nobile che rispondeva al nome di "
"Aimee Joubert. ⟪k:9⟫Sebbene avesse solo quindici anni, era l’immagine stessa della raffinatezza e "
"della lucentezza."

#: scenario7:scenario7_CE727012_CD18_480E_AAB1_20A8B589F913
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 2ff459726cf41779680d5489d5a3cad872c94264f0e6249a39004d343e12a641
#. default-sha256: 070f288dd8a31713e0a9b76c01d69ee81ff6b54d123afee53a468da5b0a20bb6
msgctxt "scenario7:scenario7_CE727012_CD18_480E_AAB1_20A8B589F913"
msgid "⟪k:0⟫It came out of nowhere, ⟪k:1⟫and it seemed I was the only one who didn’t know."
msgstr "⟪k:0⟫Era saltato fuori dal nulla, ⟪k:1⟫e sembrava che fossi l’unica a non saperlo."

#: scenario7:scenario7_4C7E4720_9197_41B4_925D_5BAB63DFAD73
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: d89436d0b68fcfcec84659f6d5ac726cbaff53f431454a8e78f444bfab55db5e
#. default-sha256: 9686fe5640637b97179f5f3526458596b72e445783ea5383f243c12e290a9381
msgctxt "scenario7:scenario7_4C7E4720_9197_41B4_925D_5BAB63DFAD73"
msgid ""
"⟪k:0⟫That evening, when the family gathered around the table for supper, Aimee was there too. "
"⟪k:1⟫And they prepared an extravagant feast for the occasion."
msgstr ""
"⟪k:0⟫Quella sera, quando la famiglia si riunì attorno al tavolo per cena,⟪k:1⟫c’era anche Aimee. "
"⟪k:2⟫E per l’occasione prepararono un sontuoso banchetto."

#: scenario7:scenario7_2451AB79_1AEF_4C56_B230_8116FEE02F34
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 59bf6d6210daaf4c8819c6bec17a176f5ee2d4c43114c62cf7fb9bbd95bfae1c
#. default-sha256: 5078e8eb570b7ddff4247f8520de5c7f44f94ac09ae863d1e740f94a7de41d80
msgctxt "scenario7:scenario7_2451AB79_1AEF_4C56_B230_8116FEE02F34"
msgid "⟪k:0⟫Mother was pleased to have another girl around."
msgstr "⟪k:0⟫Mia Madre era felice di avere un’altra ragazza in casa."

#: scenario7:scenario7_64269743_0DF3_4D1E_9780_A9512BF3F822
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 19750c7379a733650b2e501585261acce7c9d32102821fc5c2afbfa6ab8bae66
#. default-sha256: 965efd76d413b1d945a8bbf85b900daf305b32c095bd9ef309424f983e0e1297
msgctxt "scenario7:scenario7_64269743_0DF3_4D1E_9780_A9512BF3F822"
msgid ""
"⟪k:0⟫Or, more specifically, she was relieved to have found someone other than my brothers for me "
"to spend time with."
msgstr ""
"⟪k:0⟫O meglio, era sollevata di aver trovato qualcuno diverso dai miei fratelli con cui avrei "
"trascorso le mie giornate."

#: scenario7:scenario7_AFA09C65_DDDD_4F1D_8E4F_B475801780C8
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: ee37992d2eecb499a89793178341910f9930312f02264c39918ad66715fae856
#. default-sha256: 33843d203a47eeff5e3385a657c9c43e584678d45e5895abf5fdb9445dcabd28
msgctxt "scenario7:scenario7_AFA09C65_DDDD_4F1D_8E4F_B475801780C8"
msgid "⟪k:0⟫I felt much less... ⟪k:1⟫suffocated around her than my mother."
msgstr ""
"⟪k:0⟫mi sentivo molto meno... ⟪k:1⟫soffocata in sua presenza, a differenza di quando stavo con "
"mia madre."

#: scenario7:scenario7_FD5E8DB1_8AFB_4E85_A513_2395D28F0324
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 624d71e6b6bf40ab54702db97fceb2e9cbfb3660cb3b60df8fa736ccdb15c951
#. default-sha256: 8993895ed51aac9a5c360225d73fb9cf1338b1504102f53e667df0a3e85e0361
msgctxt "scenario7:scenario7_FD5E8DB1_8AFB_4E85_A513_2395D28F0324"
msgid "⟪k:0⟫A din the likes of which I had never heard in my life filled the great hall."
msgstr "⟪k:0⟫Un clamore come non l’avevo mai sentito prima in vita mia riempì la sala grande."

#: scenario7:scenario7_FB6993ED_C256_4432_A9BF_47990377BB60
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 8dffff3f0a748b887625a2a4be57e5e0cb826357a5f889750363a90766679009
#. default-sha256: b6cb82516cf004c44dc15f30e5c6fd705613e9fa047a18fa37c8676a4c693be6
msgctxt "scenario7:scenario7_FB6993ED_C256_4432_A9BF_47990377BB60"
msgid "⟪k:0⟫Everywhere I looked, there were people, people, people."
msgstr "⟪k:0⟫Ovunque guardassi, c’erano persone, persone, e ancora persone."

#: scenario7:scenario7_AE3C5140_E779_4907_BA91_7508DDAFC3DA
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 12b2f9cbf0c961b089be209fc9df1db8530c034df1a9b0302e3591da39a2f9cd
#. default-sha256: cd89a8b46174c16cc55c62b9133dbef3106d998026a07374ecae0a610a550655
msgctxt "scenario7:scenario7_AE3C5140_E779_4907_BA91_7508DDAFC3DA"
msgid "⟪k:0⟫Voices from all directions."
msgstr "⟪k:0⟫Voci provenienti da ogni direzione."

#: scenario7:scenario7_9326FF57_90A9_44C3_9FA6_46CDCF4F59BB
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: ccfbb59c31e03ad7e1774e7f26fc46aca65a4cc2361a0db26c571d9df1eebe33
#. default-sha256: eb4955ab6f860961ff1f8237fbc9848d2e90b39ae7efa16d4b6113b7905580af
msgctxt "scenario7:scenario7_9326FF57_90A9_44C3_9FA6_46CDCF4F59BB"
msgid ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫⟪k:4⟫⟪k:5⟫⟪k:6⟫Hey Dee, I feel like we’re critically short on waiters.⟪k:7⟫"
"⟪k:8⟫This don’t look good for us."
msgstr ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫⟪k:4⟫⟪k:5⟫⟪k:6⟫Ehi Didì, ho l’impressione che siamo seriamente a corto di "
"camerieri.⟪k:7⟫⟪k:8⟫Questo non ci metterà in buona luce."

#: scenario7:scenario7_4AB296AE_1FCD_47C1_AE8A_959666A52A0A
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: b5455730a3bea683cb7c2c475144e81dac448db31ca289f8bdee65264ec08556
#. default-sha256: c8c86a19f618855c8b95cfa4c20a7e9083b9e40d13276fc62576629fe933ac71
msgctxt "scenario7:scenario7_4AB296AE_1FCD_47C1_AE8A_959666A52A0A"
msgid ""
"⟪k:0⟫⟪k:1⟫They’re ⟪k:2⟫artistes⟪k:3⟫ like me. I met them at the court.⟪k:4⟫⟪k:5⟫Let’s see, we "
"have some painters, composers, sculptors, troubadours, poets, writers, you name it."
msgstr ""
"⟪k:0⟫⟪k:1⟫Loro sono ⟪k:2⟫artisti⟪k:3⟫ come me. Li ho incontrati a corte.⟪k:4⟫⟪k:5⟫Vediamo... ⟪k:6⟫"
"ci sono pittori, compositori, scultori,⟪k:7⟫cantastorie, poeti, scrittori... ⟪k:8⟫tutti quelli "
"che vuoi."

#: scenario7:scenario7_371CF7E6_AB99_46C2_A916_9B22E1E37DAB
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 0f6dc2eca690c47e1cbfbbe829646eaa8b808b77b2bcac7a333b4849c1f6cda1
#. default-sha256: 2505865c289240c7486544bf9faf68af4a64381a259f447e35c0ff38fbc38167
msgctxt "scenario7:scenario7_371CF7E6_AB99_46C2_A916_9B22E1E37DAB"
msgid "⟪k:0⟫⟪k:1⟫None of them have any connection to the Jouberts ⟪k:2⟫or⟪k:3⟫ Bollingers!"
msgstr "⟪k:0⟫⟪k:1⟫Nessuno di loro ha alcun legame con i Joubert, ⟪k:2⟫né⟪k:3⟫ con i Bollinger!"

#: scenario7:scenario7_03A91D8F_173E_4C91_B91D_251A71428750
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 8ae6d3d29b5b35fc759b9433a77b0efa4acec157dba35aaeaaea5822f6a84842
#. default-sha256: 9b47f427c4a4c91535f8e50a033af1036639b0d52707fc62ff18c801aecab4b4
msgctxt "scenario7:scenario7_03A91D8F_173E_4C91_B91D_251A71428750"
msgid ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫⟪k:4⟫Off in one corner, several men—⟪k:5⟫⟪k:6⟫presumably Georges’s friends—"
"⟪k:7⟫⟪k:8⟫gathered in a circle."
msgstr ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫⟪k:4⟫In un angolo, diversi uomini—⟪k:5⟫⟪k:6⟫presumibilmente amici di Georges—"
"⟪k:7⟫⟪k:8⟫erano radunati in cerchio."

#: scenario7:scenario7_BBBF8C7F_DC36_4327_B785_C5D10320209F
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: f87093988fae7d25f82bb44247fe1d7ee3a4cc3573a82d0e849591949237652f
#. default-sha256: 2d7d3c45aab6caccb7ddbebf16c10305b0638f03cb15a37083a718c4877ac0c2
msgctxt "scenario7:scenario7_BBBF8C7F_DC36_4327_B785_C5D10320209F"
msgid ""
"⟪k:0⟫They stood out from the other aristocrats, both in appearance and the air they gave off. "
"⟪k:1⟫The clothes they wore. The embroidery hidden beneath their jacket cuffs."
msgstr ""
"⟪k:0⟫Si distinguevano dagli altri aristocratici, sia nell’aspetto che nel portamento. ⟪k:1⟫I "
"vestiti che indossavano. Il ricamo sotto i polsini delle loro giacche."

#: scenario7:scenario7_01049DFE_0896_43B2_81A6_1E04BA9F3200
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: eb58683d3516e3ecc310ed66efb40a58bfd767438222dcbf9b36d85092861ecf
#. default-sha256: d244aba9b399d137a8f521a78b40b6fcf615bcf6b2f6382a512057e7bc868e3d
msgctxt "scenario7:scenario7_01049DFE_0896_43B2_81A6_1E04BA9F3200"
msgid ""
"⟪k:0⟫Their manner of speech. The way they held themselves. ⟪k:1⟫They were, simply put, a far cry "
"from the hardheaded Didier’s ideal party guests."
msgstr ""
"⟪k:0⟫Il loro modo di parlare e di porsi. ⟪k:1⟫Per farla breve, erano ben lontani⟪k:2⟫dal concetto "
"ideale di “ospite” di Didier."

#: scenario7:scenario7_6B76385C_D544_4488_9F4C_9DA809AEB49F
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 3b3ced23af9608609892a047ef8be21021a860f6c21718445e801d95f7ccab65
#. default-sha256: 73c2bf8cc6914bd6df24824a9d2e6ff85c42a32449452ff7915f87e300266a7f
msgctxt "scenario7:scenario7_6B76385C_D544_4488_9F4C_9DA809AEB49F"
msgid ""
"⟪k:0⟫If they had been strangers, I doubt their paths would cross much—⟪k:1⟫⟪k:2⟫⟪k:3⟫and if they "
"did, those intersections would be quite rocky."
msgstr ""
"⟪k:0⟫Se fossero stati due sconosciuti, dubito che le loro strade si sarebbero incrociate—⟪k:1⟫"
"⟪k:2⟫e semmai l’avessero fatto, quell’incrocio sarebbe stato parecchio dissestato."

