msgid "⟪k:0⟫⟪k:1⟫What do you—?!"
msgstr "⟪k:0⟫⟪k:1⟫Che cosa stai—?!"

#: scenario7:scenario7_4D32809A_202D_4E10_911C_80BA13EF8805
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 74ac546a5f12cc6a73f08d9971ab119cdc233d80ec54c30c8d65a380483b6d3d
