msgid "⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫⟪k:4⟫⟪k:5⟫⟪k:6⟫⟪k:7⟫⟪k:8⟫⟪k:9⟫I feel so dirty..."
msgstr "⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫⟪k:4⟫⟪k:5⟫⟪k:6⟫⟪k:7⟫⟪k:8⟫⟪k:9⟫Mi sento così sporca..."

#: scenario7:scenario7_BC3FCFB1_F484_4113_B023_73DCEF1450B1
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: ed39bc250bc850cd6b5825fc1c872e9e1988822b8265aa847b2bc503284d9a28
