msgctxt "scenario7:scenario7_BC3FCFB1_F484_4113_B023_73DCEF1450B1"
msgid "⟪k:0⟫You call ⟪k:1⟫that⟪k:2⟫ a greeting?⟪k:3⟫⟪k:4⟫No, that was no greeting. That was..."
msgstr ""
"⟪k:0⟫E quello lo chiami un ⟪k:1⟫saluto⟪k:2⟫?⟪k:3⟫⟪k:4⟫No, quello non era un saluto. Quello era..."

#: scenario7:scenario7_4AE547C9_A935_419E_8B47_E16038802C7D
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 2a8153414232061e2d644dd801bd37c8ee2c233ca34d55829a1a9b989278e34b
