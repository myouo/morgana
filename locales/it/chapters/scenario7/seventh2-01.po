msgid "⟪k:0⟫Why did I feel like this?"
msgstr "⟪k:0⟫Perché mi sentivo così?"

#: scenario7:scenario7_EF7166F8_304B_4FE2_94D0_BA7A76E45179
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: f2c9cbc620b510df262ee01e1627fa842c35ce2580c702fdac5f7eff4cd55509
