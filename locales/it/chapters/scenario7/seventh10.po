#: scenario7:scenario7_D9FF90F2_A55A_4456_8AAA_52BC068B4C01
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: c2de3e1d6af29d2488b629747dd144e75e03b9fd68c064e19de879fcf59ec48e
#. default-sha256: 75b6123786192dce99a774786af791c763253b526f0255c6f86c328036e7b742
msgctxt "scenario7:scenario7_D9FF90F2_A55A_4456_8AAA_52BC068B4C01"
msgid ""
"⟪k:0⟫⟪k:1⟫My desires haven’t changed since our first encounter.⟪k:2⟫⟪k:3⟫I wish to be a person..."
msgstr ""
"⟪k:0⟫⟪k:1⟫I miei desideri non sono cambiati dal nostro primo incontro.⟪k:2⟫⟪k:3⟫Voglio essere "
"ancora una persona..."

#: scenario7:scenario7_8B41CDCB_EDAB_4B67_B2AF_74E0A6E6EEB5
