#: scenario7:scenario7_EBF8C076_5FC9_4BA2_A55A_73FC3D5FB75E
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 3f14dd6e112ba4e3a66324cb448f70f405b0ad6bd06667d973c56ea06c5a25ac
#. default-sha256: bb4bdf1abe380503cdaa3bbc33e706f125780c8d6e04e309a40c860f6f354edb
msgctxt "scenario7:scenario7_EBF8C076_5FC9_4BA2_A55A_73FC3D5FB75E"
msgid ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫I’m sorry, Michel, but we are kindred spirits—⟪k:3⟫⟪k:4⟫⟪k:5⟫as much as you may "
"want to deny it."
msgstr ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫Mi dispiace, Michel, ma noi siamo spiriti affini—⟪k:3⟫⟪k:4⟫⟪k:5⟫per quanto tu "
"voglia negarlo."

#: scenario7:scenario7_D560EA69_8C29_4F9A_96ED_EF2EDD23F22A
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 019498d832cd03a63f748afa8b70893d1e36f1934a2875d983ca565de63309ef
#. default-sha256: db81a43b322e15139052adb20819b190611b9f2ef0762a7d0d3fa3a3742f3feb
msgctxt "scenario7:scenario7_D560EA69_8C29_4F9A_96ED_EF2EDD23F22A"
msgid "⟪k:0⟫You could be second to only God, yet you spurn His gift."
msgstr "⟪k:0⟫Potresti essere secondo solo a Dio, eppure respingi il Suo dono."

#: scenario7:scenario7_47F1DACD_3876_4775_99A0_E5423BACC6D6
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: d04fe2018e23b5b894b6b946c329fb71d99688730c7a9aafa0721e23dc726720
#. default-sha256: 9ff07491b2ab49a79523d9ed0b64054d1f8ea8abe703c50adbd5c604f23b375a
msgctxt "scenario7:scenario7_47F1DACD_3876_4775_99A0_E5423BACC6D6"
msgid "⟪k:0⟫⟪k:1⟫I am nothing like you.⟪k:2⟫⟪k:3⟫I am a human... ⟪k:4⟫nothing more."
msgstr "⟪k:0⟫⟪k:1⟫Non sono come te.⟪k:2⟫⟪k:3⟫Io sono un umano... ⟪k:4⟫niente di più."

#: scenario7:scenario7_EF62B65E_16C7_4FCC_9043_63A39C0D7251
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 1f2492a602b3422350e3615959d5b00283737ba14c987cf6b1003388847d1c59
