msgid "⟪k:0⟫⟪k:1⟫............"
msgstr "⟪k:0⟫⟪k:1⟫............"

#: scenario7:scenario7_A9D99D4E_35D3_4074_9B0A_7E5A3AC6A97B
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: cd3c2168cacfbd2e8af1cb25f5f6a7f388e8f636898061ebeeafafb06988cee8
#. default-sha256: 12317ea46ec7fe9c47976936722f1d71f9f4d9f137af0a8682897ebcd25fb0a8
msgctxt "scenario7:scenario7_A9D99D4E_35D3_4074_9B0A_7E5A3AC6A97B"
msgid ""
"⟪k:0⟫⟪k:1⟫I will send a package with any supplies you need once a month.⟪k:2⟫⟪k:3⟫Food, "
"clothing... ⟪k:4⟫and, ⟪k:5⟫hmm, ⟪k:6⟫something to pass the time..."
msgstr ""
"⟪k:0⟫⟪k:1⟫Manderò un pacco con tutte le provviste che ti servono una volta⟪k:2⟫al mese.⟪k:3⟫ "
"Cibo, vestiti e... ⟪k:4⟫ecco, ⟪k:5⟫qualcosa per passare il tempo..."

#: scenario7:scenario7_EB5FBF65_86D4_4B41_92C9_567FADCDC9CC
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 349a8ffff6d644aaf6240df58ef13afe7681e7df31381ee41fc97faa4b8f885f
#. default-sha256: b10d82a68a4d62c3150b0936b91ec0a6453ec8e4e51fd231ecb20cc3c4dfeb9e
msgctxt "scenario7:scenario7_EB5FBF65_86D4_4B41_92C9_567FADCDC9CC"
msgid "⟪k:0⟫⟪k:1⟫............"
msgstr "⟪k:0⟫⟪k:1⟫............"

#: scenario7:scenario7_4077FCB7_CA33_461C_927B_AF968C0A6F3F
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 8d00cc2eca96b3c7581267446b7ebfc43990823ce70b5d427327f3ed9b14d10b
#. default-sha256: 4ffdf731887df65229e513c40353dbd5a7b7f58cc8c1250fa853368b3ed0b6e5
msgctxt "scenario7:scenario7_4077FCB7_CA33_461C_927B_AF968C0A6F3F"
msgid ""
"⟪k:0⟫⟪k:1⟫If there’s anything you want, Michel, just tell me.⟪k:2⟫⟪k:3⟫Now, ⟪k:4⟫or you can have "
"a servant pass a message on to me."
msgstr ""
"⟪k:0⟫⟪k:1⟫Se c’è qualcosa che desideri, Michel, basta chiedermelo.⟪k:2⟫⟪k:3⟫Se non adesso, ⟪k:4⟫"
"puoi farmi consegnare un messaggio da uno dei servi."

#: scenario7:scenario7_C2CEF67B_A24F_4EBC_8DC2_CE4EC03D5CB3
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 6b1fbdedeaa851c5f426de5ea113fd22b254418c4b7ad641763f34f9ed474ac4
#. default-sha256: b995bf19f28d61d7d24d0bd53946438c81f2ed13f9993edbbdac1376fbf029f2
msgctxt "scenario7:scenario7_C2CEF67B_A24F_4EBC_8DC2_CE4EC03D5CB3"
msgid ""
"⟪k:0⟫⟪k:1⟫I can’t think of— ⟪k:2⟫⟪k:3⟫Actually, ⟪k:4⟫wait, ⟪k:5⟫I ⟪k:6⟫can⟪k:7⟫ think of one "
"thing.⟪k:8⟫⟪k:9⟫I would like a chess set..."
msgstr ""
"⟪k:0⟫⟪k:1⟫Non saprei cosa— ⟪k:2⟫⟪k:3⟫Un momento, ⟪k:4⟫in realtà, ⟪k:5⟫c’è⟪k:6⟫ qualcosa che "
"desidero.⟪k:7⟫⟪k:8⟫Vorrei un set di scacchi..."

#: scenario7:scenario7_505C1968_149F_4518_99EF_C72F7BA41284
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 617378d50857a8b50f8ae461ca0ad760483cf06bdd011ea9c49f90732ee40c12
#. default-sha256: a868eced13680cd2fd4055c351ceac42a200048d2bab9b9266aaba62a775c1d0
msgctxt "scenario7:scenario7_505C1968_149F_4518_99EF_C72F7BA41284"
msgid "⟪k:0⟫⟪k:1⟫All right. I’ll have one made—"
msgstr "⟪k:0⟫⟪k:1⟫Va bene. Te ne farò realizzare uno—"

#: scenario7:scenario7_A699E8CB_FB72_4F79_8085_CB554C20E25D
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: a80d5dbcc8ccf8512d43aae86252eef51f8c973d8ccc0ac95356046e37075867
#. default-sha256: bb44df3c585ebab60dbbdf33a15dc4d02dc931a50a4db3836cbcee87aae4d212
msgctxt "scenario7:scenario7_A699E8CB_FB72_4F79_8085_CB554C20E25D"
msgid "⟪k:0⟫⟪k:1⟫I would rather have... ⟪k:2⟫yours, Didier.⟪k:3⟫⟪k:4⟫Would that be possible...?"
msgstr "⟪k:0⟫⟪k:1⟫Preferisco avere... ⟪k:2⟫il tuo, Didier.⟪k:3⟫⟪k:4⟫Sarebbe possibile...?"

#: scenario7:scenario7_41BD96CA_D881_46D5_A6B2_B6C97E613885
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: d32c69b101800670c199eef3ef6f166798c31404de3bb7f542ba4f094c54c6a5
#. default-sha256: 48985aa0ef3a4a58c944f3d4f01041f90a2d065501fc5b735ed67b43c5c844ac
msgctxt "scenario7:scenario7_41BD96CA_D881_46D5_A6B2_B6C97E613885"
msgid "⟪k:0⟫⟪k:1⟫Are you sure you want that beaten old thing?"
msgstr "⟪k:0⟫⟪k:1⟫Sei sicuro di volere quella vecchia scacchiera consumata?"

#: scenario7:scenario7_C6A44EC2_D2EC_4509_8D70_4310041CC0E2
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 2adb90c41eed5e5dbebf9df3aad9ef6701a81a2fd0ad48aefe604e79516d39d1
#. default-sha256: e708deb1b6e2917fd03d19d5d74f9c5e9999a7c2758df58b2b6337e754e29988
msgctxt "scenario7:scenario7_C6A44EC2_D2EC_4509_8D70_4310041CC0E2"
msgid "⟪k:0⟫⟪k:1⟫...Yes, I want that one."
msgstr "⟪k:0⟫⟪k:1⟫...Sì, voglio quella."

#: scenario7:scenario7_77193580_493C_4B1C_B164_DF42D5A5400F
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: a4779a663de4dad1208918d1d8365e2ae77442b8cbcd8bcba170b493d81fc25c
#. default-sha256: c9cc6e11867fe3d242bb6bfb9720ff6224a26c4d05704e9ecd7e175b10b9a4d1
msgctxt "scenario7:scenario7_77193580_493C_4B1C_B164_DF42D5A5400F"
msgid "⟪k:0⟫⟪k:1⟫...All right, then. I’ll include it in the first delivery."
msgstr "⟪k:0⟫⟪k:1⟫...Va bene, allora. La includerò nella prima consegna."

#: scenario7:scenario7_FD276F4D_E5F0_4568_95EC_1F7EC24345C0
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 5b86bd2a8b630df5d4f6b841e95ff99bcd65b3d3938fd881ead53fc722ba6ec0
#. default-sha256: baa61fe0e7eb1f08cb09c256cea0f66a724f3d329600642870d5f6ceb74c3c19
msgctxt "scenario7:scenario7_FD276F4D_E5F0_4568_95EC_1F7EC24345C0"
msgid ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫I’ll send you something too, Michel.⟪k:4⟫⟪k:5⟫Anything you want, just tell me."
msgstr ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫Ti manderò qualcosa anch’io, Michel.⟪k:4⟫⟪k:5⟫Tutto quello che vuoi, dimmi "
"pure."

#: scenario7:scenario7_AC12B8FE_305D_44C1_8A8C_2B831305A787
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: eac1aa29b5f816779128ba589dcabd4edd2f1be5e324350f9327416b72a5730a
#. default-sha256: 8b4bfd831bf083ccf557020484592748655142f373bf4a52cc925f1b0373ef8c
msgctxt "scenario7:scenario7_AC12B8FE_305D_44C1_8A8C_2B831305A787"
msgid ""
"⟪k:0⟫⟪k:1⟫............⟪k:2⟫⟪k:3⟫⟪k:4⟫In that case... ⟪k:5⟫I would like some art tools.⟪k:6⟫⟪k:7⟫"
"I’m nowhere near as much of an artist as you are,⟪k:8⟫Georges, so they don’t have to be anything "
"special."
msgstr ""
"⟪k:0⟫⟪k:1⟫............⟪k:2⟫⟪k:3⟫⟪k:4⟫In tal caso... ⟪k:5⟫mi piacerebbe avere qualche strumento da "
"disegno.⟪k:6⟫⟪k:7⟫Non sono neanche lontanamente bravo come te, Georges,⟪k:8⟫quindi non mi serve "
"niente di speciale."

#: scenario7:scenario7_6B063F2C_3FEE_4909_821D_945E81EB97D4
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 180df4465d1fcf161f151a6560decad05fb1cb068f28decfc6f8ab39f4042179
#. default-sha256: 0cd3ee901e0d3060844f74f367739cc41ed33124eadd9ecfd4465673925783f2
msgctxt "scenario7:scenario7_6B063F2C_3FEE_4909_821D_945E81EB97D4"
msgid ""
"⟪k:0⟫⟪k:1⟫Gotcha. So some canvas and, ⟪k:2⟫hmm... ⟪k:3⟫how ’bout some charcoal?⟪k:4⟫⟪k:5⟫And when "
"you’re back, I want to see what you’ve made with it, okay?"
msgstr ""
"⟪k:0⟫⟪k:1⟫Afferrato. Quindi qualche tela e, ⟪k:2⟫mmh...⟪k:3⟫⟪k:4⟫che ne dici di un po’ di "
"carboncino?⟪k:5⟫⟪k:6⟫E quando sarai tornato, mi farai vedere cos’hai realizzato, okay?"

#: scenario7:scenario7_773BFE2C_EEBA_4DAA_89F6_C6732E4E9AA9
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 84dc9de89e924ee43fafec86a31265584cc20d1ce2f49badc31a7b624e8eadb7
#. default-sha256: 64c68143fece1da7b62eca4c6055afe2d2baed33f7b41f8a91a8a9119ff54138
msgctxt "scenario7:scenario7_773BFE2C_EEBA_4DAA_89F6_C6732E4E9AA9"
msgid "⟪k:0⟫⟪k:1⟫Okay."
msgstr "⟪k:0⟫⟪k:1⟫D’accordo."

#: scenario7:scenario7_1A34B477_352D_4260_8109_F961EDAD8409
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 7780f64e7555890eecc393f48793313ee56da6788d3d0d80f94fef2a136dbec3
#. default-sha256: 11c5680d44b09c2186f9b8e796bedb6dd7f0703c5ec00bc6b3e49e7a694c2a99
msgctxt "scenario7:scenario7_1A34B477_352D_4260_8109_F961EDAD8409"
msgid ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫⟪k:4⟫I know this is already hard enough on you, Michel...⟪k:5⟫⟪k:6⟫but I need "
"to ask you to do something for me.⟪k:7⟫⟪k:8⟫Avoid making contact with anyone who doesn’t already "
"know about you."
msgstr ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫⟪k:4⟫So bene che è già abbastanza difficile per te, Michel...⟪k:5⟫⟪k:6⟫ma "
"devo chiederti di fare una cosa per me.⟪k:7⟫⟪k:8⟫Evita ogni contatto visivo con chiunque non "
"sappia già di te."

#: scenario7:scenario7_3C6A4E98_1E6E_47E0_81AE_514B9EECE399
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: aa09aecaaa0533a4409aa9bdd9e52e0a12f7981c4b833a38ece1a86d11e5df0f
#. default-sha256: 6cdf860e665621b9dd9bde3e427b0905a225f29254deacc47a421bb0f9914afe
msgctxt "scenario7:scenario7_3C6A4E98_1E6E_47E0_81AE_514B9EECE399"
msgid "⟪k:0⟫⟪k:1⟫So... ⟪k:2⟫I can’t talk to anybody but the servants?"
msgstr "⟪k:0⟫⟪k:1⟫Quindi... ⟪k:2⟫non posso parlare con nessuno all’infuori dei servi?"

#: scenario7:scenario7_0093026E_84C6_4E0C_B5AE_68C8DD4C7C2E
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: f85ef953ee85cef2fc42a34bd9190994b0f1ebb10925377de627d9776fc07aea
