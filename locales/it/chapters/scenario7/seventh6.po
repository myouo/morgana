msgid "⟪k:0⟫⟪k:1⟫⟪k:2⟫............"
msgstr "⟪k:0⟫⟪k:1⟫⟪k:2⟫............"

#: scenario7:scenario7_DCE13B0D_57E6_4B52_AB7E_7C8D7DD09A97
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: e1e9d360a6bc1a9a5893861f8dec41101923f0e1a4e0887b4406b28501e33d27
#. default-sha256: 4db6daaee6c3bd23d123dcf07a67b50deb58a329d87f8761cbb093603dfe70ec
msgctxt "scenario7:scenario7_DCE13B0D_57E6_4B52_AB7E_7C8D7DD09A97"
msgid ""
"⟪k:0⟫Looking at them, I couldn’t help but remember the old days.⟪k:1⟫⟪k:2⟫Playing chess with "
"Didier. Learning to draw from Georges."
msgstr ""
"⟪k:0⟫Guardandoli, non potevo fare a meno di ripensare ai giorni passati.⟪k:1⟫⟪k:2⟫Alle partite a "
"scacchi con Didier. Alle lezioni di disegno con Georges."

#: scenario7:scenario7_8D7B438A_C041_426F_B20E_4A9733C9449D
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 201bd62457908c681697f3b249f8866aedceb4f5ef62640c7bf44f246eef4eb5
#. default-sha256: c6d95df9100f03c0010c0a0f11202146fd5145cb3c7c00e6f071fcf78aea8314
msgctxt "scenario7:scenario7_8D7B438A_C041_426F_B20E_4A9733C9449D"
msgid "⟪k:0⟫Our sibling outings."
msgstr "⟪k:0⟫Alle scampagnate insieme."

#: scenario7:scenario7_D803BB77_22AB_475F_8509_A45EEB5F5B91
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 611e0395014840f835469943db956324cb506f32d11ff6130ecf506e4477f6e8
#. default-sha256: c2bd0462820ccc4d8b2f5a4f968b68ff7c8bcfefe13750cb4625edfd628209a3
msgctxt "scenario7:scenario7_D803BB77_22AB_475F_8509_A45EEB5F5B91"
msgid ""
"⟪k:0⟫However, the ominous sound of thunder crashing in the distance drowned out those memories."
msgstr ""
"⟪k:0⟫Tuttavia, il suono minaccioso di un fulmine che si abbatteva in lontananza, soffocò quei "
"ricordi."

#: scenario7:scenario7_FCE8D84B_D01C_402F_B4D3_4CC436757271
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 5faad0c5a0c9c669498fbd26b9b982b1fae42f39c8da95599329e7e872682ae3
#. default-sha256: 74c3edddf165b94441f3fa9d3812eb3c7ab8e69a0ab728ed265bbd9cf47f12f5
msgctxt "scenario7:scenario7_FCE8D84B_D01C_402F_B4D3_4CC436757271"
msgid ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫The mansion is several days’ travel from here.⟪k:3⟫⟪k:4⟫Hopefully the carriage "
"isn’t too uncomfortable."
msgstr ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫La villa dista alcuni giorni di viaggio da qui.⟪k:3⟫⟪k:4⟫Fortunatamente il carro "
"non è troppo scomodo."

#: scenario7:scenario7_89F3AA26_DF35_434A_8F40_DF2869E9AD99
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 349a8ffff6d644aaf6240df58ef13afe7681e7df31381ee41fc97faa4b8f885f
