msgid ""
"⟪k:0⟫All those gaps in your memory...⟪k:1⟫⟪k:2⟫were from your lives as the White-Haired Girl."
msgstr ""
"⟪k:0⟫Tutte quelle lacune nella tua memoria...⟪k:1⟫⟪k:2⟫appartenevano alle vite trascorse come la "
"Ragazza dai Capelli Bianchi."

#: scenario7:scenario7_F39D252D_0FF5_490E_AC6B_A49AF3966F0A
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 738574cd7d92cec98e37a67c561518c64cd851695294e66ad85b6f6c7bd3b6e7
