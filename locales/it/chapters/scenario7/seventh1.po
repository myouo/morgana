msgid "⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫⟪k:4⟫⟪k:5⟫⟪k:6⟫⟪k:7⟫⟪k:8⟫⟪k:9⟫⟪k:10⟫Haaaaaaaahh... ⟪k:11⟫Kill me now!"
msgstr ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫⟪k:4⟫⟪k:5⟫⟪k:6⟫⟪k:7⟫⟪k:8⟫⟪k:9⟫⟪k:10⟫Haaaaaaaahh... ⟪k:11⟫Vi prego, uccidetemi!"

#: scenario7:scenario7_CD50AFD7_87D0_48C7_8639_D6EB9500FCA8
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 601805dd698070e34fa727526456c1f4bbadd9d629f97189bfcbafb5a75cdf50
#. default-sha256: e9f57b037b0f8d8d4505850a2adc36eb7f245b9bf924150936984a71d6b43cba
msgctxt "scenario7:scenario7_CD50AFD7_87D0_48C7_8639_D6EB9500FCA8"
msgid "⟪k:0⟫⟪k:1⟫⟪k:2⟫I have some cloth... ⟪k:3⟫if you’d like to wipe yourself off."
msgstr "⟪k:0⟫⟪k:1⟫⟪k:2⟫Ho degli strofinacci... ⟪k:3⟫se vuoi asciugarti."

#: scenario7:scenario7_EDEA6CA0_BCB6_4FCC_97BE_0155D979E74D
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: da71c1c22d6e24a33cf50157f25f512b702bec88b8b0c51fd0e17e2a34c8da85
#. default-sha256: b30edf2226fbf2d56d021f2a2980ae7b0232898796fcd51e98e2d63a1b55daf5
msgctxt "scenario7:scenario7_EDEA6CA0_BCB6_4FCC_97BE_0155D979E74D"
msgid "⟪k:0⟫⟪k:1⟫Oh, yeah, thanks.⟪k:2⟫⟪k:3⟫Uggggh, I’m so dead..."
msgstr "⟪k:0⟫⟪k:1⟫Ah, sì, grazie.⟪k:2⟫⟪k:3⟫Aaaggh, sono distrutto..."

#: scenario7:scenario7_B1273B75_9AC7_4A9A_8227_37D2C304326F
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 287ea0c6ca15397d76b3105fa2fd74e695d88534722db08aa17361a5e59f33c9
#. default-sha256: dc93b3096b711bca357c44c75b9c8e74fc8d2169ba2f3385825a1f5b81e44024
msgctxt "scenario7:scenario7_B1273B75_9AC7_4A9A_8227_37D2C304326F"
msgid "⟪k:0⟫⟪k:1⟫You were at it for a long time."
msgstr "⟪k:0⟫⟪k:1⟫Vi siete trattenuti parecchio..."

#: scenario7:scenario7_A0DBDD17_4A04_49B0_BAE8_A7578E73066D
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 6e3faf6f9458399fd90b9b1811b49e8f69cf25d177db4c44984c9d89db164643
#. default-sha256: f81faef41125e4f771dc6546a1155dc2ce7f0b4436d8490a46f0b544eb53b7fa
msgctxt "scenario7:scenario7_A0DBDD17_4A04_49B0_BAE8_A7578E73066D"
msgid ""
"⟪k:0⟫⟪k:1⟫I’ve never known Dee to half-ass something once he gets started.⟪k:2⟫⟪k:3⟫Which, I "
"guess, is what makes him knight material, but..."
msgstr ""
"⟪k:0⟫⟪k:1⟫Non immaginavo che Didì fosse capace di fare a pezzi qualcuno⟪k:2⟫in quel modo, una "
"volta cominciato.⟪k:3⟫ Credo sia questo ciò che lo⟪k:4⟫rende materiale ideale per l’ordine. ⟪k:5⟫"
"Eppure..."

#: scenario7:scenario7_DA601657_1B98_4FCE_911A_DC4B78AF6E3B
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: d5d2b75f917695e8d4514514c2576326381851db030d6ed9af301c8d814c6d6a
#. default-sha256: 97c29ab3132daca2bf7789a7461769ba947c4591ed4ae741979acc56e883974e
