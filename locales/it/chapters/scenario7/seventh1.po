msgid "⟪k:0⟫⟪k:1⟫I didn’t know you were home, Georges."
msgstr "⟪k:0⟫⟪k:1⟫Non sapevo che fossi a casa, Georges."

#: scenario7:scenario7_98404427_389F_4D69_887E_D7799D4222A2
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: ff181b9881ebfb77a74434417b2305dd3e0c2fc755245aaf677b84e8a311c224
