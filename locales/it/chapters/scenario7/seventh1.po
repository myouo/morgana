msgid "⟪k:0⟫⟪k:1⟫I have nothing but time."
msgstr "⟪k:0⟫⟪k:1⟫Non ho nient’altro da fare."

#: scenario7:scenario7_4E77BB0A_41C7_4E74_BEFF_6D5F3A6E5C9F
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 6d93ab990cace613c810826977d26691e2bc250abe4f89b6d7855b09826994c3
