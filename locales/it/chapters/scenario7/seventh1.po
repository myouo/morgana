msgid "⟪k:0⟫⟪k:1⟫What, are you worried about me?"
msgstr "⟪k:0⟫⟪k:1⟫Cosa, sei preoccupata per me?"

#: scenario7:scenario7_184AF4D6_A299_4132_9625_544AC3DCBDFF
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 16d9b570b5e5527a03c099b1dea28cdeac2233ec83786330d425b6926058c109
