msgid "⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫⟪k:4⟫⟪k:5⟫G-⟪k:6⟫Get away from the board!"
msgstr "⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫⟪k:4⟫⟪k:5⟫A-⟪k:6⟫Allontanati dalla scacchiera!"

#: scenario7:scenario7_09DFDE46_6D2D_4CE8_92A9_44E280B4AFD4
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 2eec32be90c52410233c3f72eae62a0c8c6c8a578d7da6e52167fe5e2a38bdbe
