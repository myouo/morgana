msgctxt "scenario7:scenario7_09DFDE46_6D2D_4CE8_92A9_44E280B4AFD4"
msgid ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫⟪k:4⟫Yiiiikes, you got ⟪k:5⟫trounced⟪k:6⟫, huh.⟪k:7⟫⟪k:8⟫And you call "
"yourself her big brother! Ahaha!"
msgstr ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫⟪k:4⟫Ahi ahi ahi, ti sei fatto ⟪k:5⟫stracciare⟪k:6⟫, eh?⟪k:7⟫⟪k:8⟫E ti "
"ritieni suo fratello maggiore?! Ahahah!"

#: scenario7:scenario7_7B2A7768_FBDD_4390_B6B4_666D83D299D6
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 050035b379c7f75cfbb63e8bfbf3ce2226110e187227226bcdcece860530704c
