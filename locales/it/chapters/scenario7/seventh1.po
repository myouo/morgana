msgid "⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫⟪k:4⟫⟪k:5⟫Come on! Put your back into it!"
msgstr "⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫⟪k:4⟫⟪k:5⟫Forza! Mettici più impegno!"

#: scenario7:scenario7_36EE3520_274C_40E3_AACF_BBDDB32D87FF
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 5823726927e6d2b80173c95fea94cfe36a7a63eaf1e50439967b897cf9843d51
