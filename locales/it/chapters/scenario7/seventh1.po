#: scenario7:scenario7_15D2AB99_1918_4402_BEEB_E53A12C46FDF
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 4825302eb65d2694857a3b17694482a60e0df9b21c23c46d194ba211d2b148bc
#. default-sha256: 7fe96f42aa1ea5a82571cf8053a017f539052c7dde4532cff2786f2e48a9b1b4
msgctxt "scenario7:scenario7_15D2AB99_1918_4402_BEEB_E53A12C46FDF"
msgid "⟪k:0⟫Out in the garden, my two brothers traded swings bare-chested."
msgstr "⟪k:0⟫Fuori in giardino, i miei fratelli si scambiavano colpi a petto nudo."

#: scenario7:scenario7_AADA5C9C_F2E7_417E_830E_20644F5D2D60
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: a521ad3be61853447a68ca3300d203b4a55fbd3be1715cdac2ac1b57531619ae
#. default-sha256: dca6e24c3cc1ae86800f5351b857579934be397f35a32b2aa5f8dec952435827
msgctxt "scenario7:scenario7_AADA5C9C_F2E7_417E_830E_20644F5D2D60"
msgid "⟪k:0⟫All I could do, though, was observe from afar."
msgstr "⟪k:0⟫Tutto quel che potevo fare era osservarli da lontano."

#: scenario7:scenario7_EA651833_C1E3_404A_BC2A_9A5E412B6C25
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: a315964a01a0e77924e33e40f03835b9387beba78f4863d974bf04c2e78e91b1
#. default-sha256: 068f2d79b86c93824be38e959f3362482ed0a400855827a3a2965a21bcd5ab35
msgctxt "scenario7:scenario7_EA651833_C1E3_404A_BC2A_9A5E412B6C25"
msgid ""
"⟪k:0⟫And every time I found myself forced to watch,⟪k:1⟫I felt a sharp pain, like a needle "
"piercing my chest."
msgstr ""
"⟪k:0⟫E ogni volta che mi ritrovavo costretta a guardare, provavo un dolore pungente, come un ago "
"che mi infilzava."

#: scenario7:scenario7_9120BFCD_4DD0_41F9_A80B_E4EBD5CB9F29
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 9848632c98adecc291599d70943c319ce8aaddbdc6118cc71e4f9fb981145d59
#. default-sha256: 9b7fd1f9cf3c95df1fc3c290aa218064c2a5b3f971b43a67b6e33ec3739c771a
msgctxt "scenario7:scenario7_9120BFCD_4DD0_41F9_A80B_E4EBD5CB9F29"
msgid "⟪k:0⟫A needle that seemed to be growing ever thicker."
msgstr "⟪k:0⟫Un ago che pareva diventare sempre più spesso."

#: scenario7:scenario7_BE9DF8AC_04C8_4CC3_84EF_281927DFFA9C
