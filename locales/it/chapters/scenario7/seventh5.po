#: scenario7:scenario7_BACD08A1_9263_4A2D_8B26_1FF261B8F58D
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: ff0ac0c4c132f7a5e3f7c82a310b790d7172b2aa7bdbf4cfe72e9701b7077f4b
#. default-sha256: 5844be43c524d98ab5034a5093507ebe5970dd4ccf8a2eae0fba03c348d5820e
msgctxt "scenario7:scenario7_BACD08A1_9263_4A2D_8B26_1FF261B8F58D"
msgid ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫⟪k:4⟫⟪k:5⟫⟪k:6⟫⟪k:7⟫Michelle! Ohh Mich⟪k:8⟫eeee⟪k:9⟫eeeelle! Are you in there?"
msgstr ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫⟪k:4⟫⟪k:5⟫⟪k:6⟫⟪k:7⟫Michelle! Ehi, ⟪k:8⟫Micheeeeeeeelle⟪k:9⟫! Sei lì dentro?"

#: scenario7:scenario7_FB32878E_3B65_40D1_962A_0B9F5ADBCA69
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: cc88040bc9166de7231e5572aa5e13d64bcfecedcd9728e3f16b6d255cdda7ed
#. default-sha256: 0f1c03e8a8eb5abe038158fc09c3133135f1ef43935547724d27b99d4e34d141
msgctxt "scenario7:scenario7_FB32878E_3B65_40D1_962A_0B9F5ADBCA69"
msgid "⟪k:0⟫⟪k:1⟫⟪k:2⟫Did you need something, Georges?"
msgstr "⟪k:0⟫⟪k:1⟫⟪k:2⟫Hai bisogno di qualcosa, Georges?"

#: scenario7:scenario7_A55F8FEF_1AB7_4FE2_986A_3FBBE54321B0
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: ee385731cdbdd6dbd2a9fa6300f8e20f48eba34a7914d35a9664f0cc3fb86654
#. default-sha256: ac8d3d763d6a36c0a6c2a9bdaac612d01b30cde1719311169af160b49d9adca4
msgctxt "scenario7:scenario7_A55F8FEF_1AB7_4FE2_986A_3FBBE54321B0"
msgid ""
"⟪k:0⟫⟪k:1⟫Oh, c’mon, don’t be like that.⟪k:2⟫⟪k:3⟫Do I have to “need something” to talk to you?"
msgstr ""
"⟪k:0⟫⟪k:1⟫Suvvia, non fare così.⟪k:2⟫⟪k:3⟫Devo aver “bisogno di qualcosa” per parlare con te?"

#: scenario7:scenario7_3ED6DA89_DABD_4E8E_A636_8C03D240695F
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 3dce9a2e816a5a54b5aada2ab3f2a3851db44b5204b815c38e3b10f9277527ba
#. default-sha256: 62ec5f17f6f2b93223dd063c68638c1a8f199de8fbe26dd6370b4eb5458ea2e6
msgctxt "scenario7:scenario7_3ED6DA89_DABD_4E8E_A636_8C03D240695F"
msgid ""
"⟪k:0⟫⟪k:1⟫N-⟪k:2⟫No, but you looked like you were in an unusually good mood,⟪k:3⟫so I thought..."
msgstr "⟪k:0⟫⟪k:1⟫N-⟪k:2⟫No, ma sembravi insolitamente di buon umore,⟪k:3⟫così ho pensato..."

#: scenario7:scenario7_CF12D587_2FF9_4EE4_991C_31AAEB65C73E
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: f47df8881eed6b177bf797dd6590b31006becdf5393dc8aa1262a8aff7e436f6
#. default-sha256: 34e437c3157ac70727761bbf5dfedd89769202db031d64892a121732f399eae1
msgctxt "scenario7:scenario7_CF12D587_2FF9_4EE4_991C_31AAEB65C73E"
msgid "⟪k:0⟫⟪k:1⟫Well, why wouldn’t I be?⟪k:2⟫⟪k:3⟫It’s a wonderfully gloomy day out!"
msgstr ""
"⟪k:0⟫⟪k:1⟫Beh, perché non dovrei esserlo?⟪k:2⟫⟪k:3⟫Oggi è una giornata meravigliosamente uggiosa!"

#: scenario7:scenario7_B074DBC1_FA01_4CC8_954A_6C085E79F2EC
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 4785cd71f46f2a4ec42499bd735a5bc68c796d3f55d9a742e59062312594e542
#. default-sha256: b10d82a68a4d62c3150b0936b91ec0a6453ec8e4e51fd231ecb20cc3c4dfeb9e
msgctxt "scenario7:scenario7_B074DBC1_FA01_4CC8_954A_6C085E79F2EC"
msgid "⟪k:0⟫⟪k:1⟫............"
msgstr "⟪k:0⟫⟪k:1⟫............"

#: scenario7:scenario7_2F81EBB3_F8A2_41F0_93EE_05BA4326A48B
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 114f41981f383b69cc6418267885f7b43a5fa582c7ac8ed9cd68c75e2a451bce
#. default-sha256: 7346e2984a1d9ea39b4977c8ba99822cbd82521cdb3d1ba1548cc2d263efc2cd
msgctxt "scenario7:scenario7_2F81EBB3_F8A2_41F0_93EE_05BA4326A48B"
msgid ""
"⟪k:0⟫⟪k:1⟫I would understand if it were clear out...⟪k:2⟫⟪k:3⟫but can you really say it’s "
"“wonderfully” gloomy?"
msgstr ""
"⟪k:0⟫⟪k:1⟫Capirei se fosse sereno là fuori...⟪k:2⟫⟪k:3⟫ma si può davvero dire che sia "
"“meravigliosamente” uggioso?"

#: scenario7:scenario7_DFA0EF82_350D_475B_8014_D38E3E4E9C6F
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 93145ac6aa6bfad0e0afab2b06e20e7749f4140c8545297ac41bc41d6456ae82
#. default-sha256: 9ca69c0bab328709f04940db3054aa18e964050e4b564d5cb8d3921778af8649
msgctxt "scenario7:scenario7_DFA0EF82_350D_475B_8014_D38E3E4E9C6F"
msgid ""
"⟪k:0⟫⟪k:1⟫Well, you can’t be outside for very long when it’s not cloudy, so in our case, this is "
"perfect weather."
msgstr ""
"⟪k:0⟫⟪k:1⟫Beh, non puoi stare fuori per molto quando non è nuvoloso,⟪k:2⟫quindi nel nostro caso "
"questo è il clima perfetto."

#: scenario7:scenario7_E1821575_CA6E_403F_8D30_4330B21534A6
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: d6d63f8d5b95b010c20eab257e0113dee6788fb95cfef7ca24af3fbb990b2cb3
#. default-sha256: c9de2df8c36868adafc2eb1b0ab01e94d2f7404dacab36d2465d743f6c505ba6
msgctxt "scenario7:scenario7_E1821575_CA6E_403F_8D30_4330B21534A6"
msgid "⟪k:0⟫⟪k:1⟫Ah..."
msgstr "⟪k:0⟫⟪k:1⟫Ah..."

#: scenario7:scenario7_C01E4773_3075_4DCE_B133_8C7266956346
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 6ec129f92ba09ce74d3deabd750e6407c84649cc458058002fec7428bb301326
#. default-sha256: 70569fac9c0bb8293dbf31a5f3fac4c1d272c085b47b445204688a0abb54f0ae
msgctxt "scenario7:scenario7_C01E4773_3075_4DCE_B133_8C7266956346"
msgid ""
"⟪k:0⟫⟪k:1⟫What do you say we go for a little stroll, while we can?⟪k:2⟫⟪k:3⟫Dee’s around today "
"too, so we can see if he’s up for it.⟪k:4⟫⟪k:5⟫It’ll be like old times."
msgstr ""
"⟪k:0⟫⟪k:1⟫Che ne dici di andare a fare una passeggiatina, ora che possiamo?⟪k:2⟫⟪k:3⟫Anche Didì è "
"in giro oggi; possiamo vedere se vuole unirsi a noi.⟪k:4⟫⟪k:5⟫Sarà come ai vecchi tempi."

#: scenario7:scenario7_9406F46A_7FED_421F_A304_80D3F5789C3F
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: d12d50ac4149be7a5aca206cb900d4d9560913f0ecaf0a819e80d037791cc9ed
#. default-sha256: 33a27d289f5d6610a44e1a6dc97187969b24baf98789d0a5943b1de310189487
msgctxt "scenario7:scenario7_9406F46A_7FED_421F_A304_80D3F5789C3F"
msgid ""
"⟪k:0⟫⟪k:1⟫We’ve been running around like headless chickens lately,⟪k:2⟫so we haven’t had much of "
"a chance for a sibling outing.⟪k:3⟫⟪k:4⟫We’ll have Mom make us a lunch, and then—"
msgstr ""
"⟪k:0⟫⟪k:1⟫Abbiamo corso come pazzi ultimamente, perciò non abbiamo avuto molte occasioni per fare "
"una scampagnata tra fratelli.⟪k:2⟫⟪k:3⟫Ci faremo preparare il pranzo da Mamma, e poi—"

#: scenario7:scenario7_2086E62F_87B2_47C7_B186_8D57CAE02078
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 1d86e22e7e94c276ec6a65830747aa394b73b381f0f83136230e037cdad11232
#. default-sha256: 9fffb282b41890b61491c2024142e387c13e5154b25011d337f06c7f5f191229
msgctxt "scenario7:scenario7_2086E62F_87B2_47C7_B186_8D57CAE02078"
msgid "⟪k:0⟫⟪k:1⟫Ooh, we’ll take a couple horses up to the forest’s edge!"
msgstr "⟪k:0⟫⟪k:1⟫Ooh, prendiamo dei cavalli per arrivare fino al confine della foresta!"

#: scenario7:scenario7_AB202D56_42D8_44B8_855B_BA820064EA7D
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: b08cb267d3d623b98d37877d3ef98e9453e8d032230b669a31af20e7c7e838cd
#. default-sha256: 5fed983dbc543da00c0bd05e512fe70cdff6115fdcf5215050587326a186a6f9
msgctxt "scenario7:scenario7_AB202D56_42D8_44B8_855B_BA820064EA7D"
msgid "⟪k:0⟫⟪k:1⟫I-⟪k:2⟫I’m fine with that if you are."
msgstr "⟪k:0⟫⟪k:1⟫P-⟪k:2⟫Per me va bene, se a te va."

#: scenario7:scenario7_1CC04FBE_D7D3_499E_8D23_9241BEE32370
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 062da453c0e3f29df151ef40ea249b4a03acfd1d9b24095fd74e5c890032b258
#. default-sha256: ebe06466e81d9cdfe47ccb06ddbc06eef5e80aca4e9c92bb8e8895907e6e629e
msgctxt "scenario7:scenario7_1CC04FBE_D7D3_499E_8D23_9241BEE32370"
msgid "⟪k:0⟫⟪k:1⟫You bet your bum I am. I asked, after all!⟪k:2⟫⟪k:3⟫Now c’mon, let’s go!"
msgstr ""
"⟪k:0⟫⟪k:1⟫Puoi scommetterci le chiappe che mi va. L’ho chiesto io, dopotutto!⟪k:2⟫⟪k:3⟫Forza ora, "
"andiamo!"

#: scenario7:scenario7_34D266ED_1135_4E45_9C31_EA6D46852228
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 4652517f47304125ab2a2ac9ef9d882672d3c65886d06ff5bc3b9b807250861e
#. default-sha256: 8c6d16ed15d36198535f574c9d42806f3b994624f4050ee83846f430e3f33bf8
msgctxt "scenario7:scenario7_34D266ED_1135_4E45_9C31_EA6D46852228"
msgid "⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫⟪k:4⟫⟪k:5⟫⟪k:6⟫⟪k:7⟫An outing, you say?"
msgstr "⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫⟪k:4⟫⟪k:5⟫⟪k:6⟫⟪k:7⟫Una scampagnata, hai detto?"

#: scenario7:scenario7_54C4A907_7278_42D2_914B_8485A57F286B
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: b14d8d53e493b3954a212e4228fd8bb329d0bb65f315ef0b562b60a21b093423
#. default-sha256: b04fc8a98f1cec4fb17bd1323ffe731a110ef0ba3e262492b4d950f0ecbdf06b
msgctxt "scenario7:scenario7_54C4A907_7278_42D2_914B_8485A57F286B"
msgid ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫Yepyep. Hop on a couple horses and head for the forest.⟪k:3⟫⟪k:4⟫We haven’t done "
"this in a while, so I figured why not."
msgstr ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫Già. Montiamo in sella su un paio di cavalli e dirigiamoci verso la foresta.⟪k:3⟫ "
"Non lo facciamo da un bel po’, così mi son chiesto, perché no?"

#: scenario7:scenario7_C7FE1404_21B8_4AFB_ACBC_CE0D1EBB2D6E
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: a1ad31a5690d535f1420a295cfa4d507e449abb44397ef50a75f55bef002e240
#. default-sha256: f304f29e933b29602456744ba3b62565c1a4bf37a6ce368c4908b464461f1c72
msgctxt "scenario7:scenario7_C7FE1404_21B8_4AFB_ACBC_CE0D1EBB2D6E"
msgid ""
"⟪k:0⟫⟪k:1⟫I see. Well, if Michelle is coming, I see no reason to say no.⟪k:2⟫⟪k:3⟫Let’s set off "
"right away."
msgstr ""
"⟪k:0⟫⟪k:1⟫Capisco. Beh, se viene Michelle, non vedo perché rifiutare.⟪k:2⟫⟪k:3⟫Partiamo subito."

#: scenario7:scenario7_0439C8F3_C6DE_422D_BA4F_F3A310E5967F
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: df9abc21c50d4d3fda7c6807ec67ab0e8983f462d8bd6ff669760b044712f005
#. default-sha256: 92dec00195dedfc45c4c979a461510405b2aeae97079c1b8ff035814c9d5d719
msgctxt "scenario7:scenario7_0439C8F3_C6DE_422D_BA4F_F3A310E5967F"
msgid ""
"⟪k:0⟫⟪k:1⟫Whoa, whoa, slow down there.⟪k:2⟫⟪k:3⟫Are you saying you wouldn’t go if it was just me?"
"⟪k:4⟫⟪k:5⟫It’s Michelle or nothing?"
msgstr ""
"⟪k:0⟫⟪k:1⟫Wooh, wooh, rallenta.⟪k:2⟫⟪k:3⟫Stai dicendo che non saresti venuto se fossi stato "
"soltanto io?⟪k:4⟫⟪k:5⟫O Michelle o niente?"

#: scenario7:scenario7_8DF16205_0566_4025_B2D9_528D1AA14340
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 7ad2dc03e4718d0eada8b4321c0a4a6e86d1692e315084e344d28c7042d20c22
#. default-sha256: a0d0b77cda9e1c0d6669294b43cc91ca5e0108a67975d83acdd70ab96074e826
msgctxt "scenario7:scenario7_8DF16205_0566_4025_B2D9_528D1AA14340"
msgid ""
"⟪k:0⟫⟪k:1⟫Of course. Why on earth would I want to go horse-riding alone with you? ⟪k:2⟫I would "
"rather drown myself."
msgstr ""
"⟪k:0⟫⟪k:1⟫Ovvio. Perché diamine dovrei voler cavalcare da solo con te?⟪k:2⟫⟪k:3⟫Preferirei "
"annegare."

#: scenario7:scenario7_D6BBF839_251E_423D_AD38_1E3477201973
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 2f1278399c71c19231c68dc27c23405528819e992cd5b2c2eeff77865d71fdd1
#. default-sha256: 605cbec755df5b999abe39651368398c2c2994065afb8a9e511a87810517df9e
msgctxt "scenario7:scenario7_D6BBF839_251E_423D_AD38_1E3477201973"
msgid "⟪k:0⟫⟪k:1⟫⟪k:2⟫LE GAAAAAAAAAAAAAAAASP!"
msgstr "⟪k:0⟫⟪k:1⟫⟪k:2⟫OH MON DIEU!"

#: scenario7:scenario7_F4B2BA61_62B5_4150_BFC7_104328D10817
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: cfc056f36429a55fb71cc6cab48dc1b4bfbf07d95a9d0b39ca91bd2e722d51ff
#. default-sha256: 7e619169bcacf2e2d36932a55e4f8f66e0bfcaaa0b847ec52a14f5fdfaa56649
msgctxt "scenario7:scenario7_F4B2BA61_62B5_4150_BFC7_104328D10817"
msgid "⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫Um, Didier... ⟪k:4⟫could I, perhaps, make a small request?"
msgstr "⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫Ehm, Didier... ⟪k:4⟫potrei fare una piccola richiesta?"

#: scenario7:scenario7_D5201F50_0026_463D_ACA6_0B41AE96A802
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: b32d7394deb6c139f1ffa042c43031f1c743da75c52e1681c37c222363104c4a
#. default-sha256: 57634e7c6a567bf4e40d4438a08163abd9b1caa36537db898ddc00bd68fab00d
msgctxt "scenario7:scenario7_D5201F50_0026_463D_ACA6_0B41AE96A802"
msgid "⟪k:0⟫⟪k:1⟫Go on, let’s hear it."
msgstr "⟪k:0⟫⟪k:1⟫Avanti, sentiamo."

#: scenario7:scenario7_50A8EFA1_E5B5_46CF_BAFF_2E5A5D2666AC
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 18928d4d5c3dab255f99e0c77d27997f334c3e388e48e6ad7f4fdd39a4e7a1cd
#. default-sha256: da662576d9af3c735c84a888df89c00482a5b1a59428635462c4974a6fa498fc
msgctxt "scenario7:scenario7_50A8EFA1_E5B5_46CF_BAFF_2E5A5D2666AC"
msgid "⟪k:0⟫⟪k:1⟫Do you mind if I... ⟪k:2⟫hold the horse’s reins?"
msgstr "⟪k:0⟫⟪k:1⟫Ti dispiace... ⟪k:2⟫se tengo io le redini del cavallo?"

#: scenario7:scenario7_CD4C7EE4_B103_480B_8DB0_1A19F8854021
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 2ef987a76e0da8dff57c5c4888a3b9552b0b3aeaaa3b8b80d7a389e931f6c61e
#. default-sha256: ce42d12b3a31a7d80496091c9e0d96ecea5fc278d02d39f5d458390d7155cc54
msgctxt "scenario7:scenario7_CD4C7EE4_B103_480B_8DB0_1A19F8854021"
msgid ""
"⟪k:0⟫⟪k:1⟫Oh, that’s all? By all means.⟪k:2⟫⟪k:3⟫I’ll be there behind you to make sure nothing "
"happens, so have at it."
msgstr ""
"⟪k:0⟫⟪k:1⟫Tutto qui? ⟪k:2⟫Certo che no, fa’ pure.⟪k:3⟫⟪k:4⟫Sarò proprio dietro di te per "
"assicurarmi che non accada nulla."

#: scenario7:scenario7_FE8E2917_B186_4CDB_AABC_5C3944D5B965
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 6f44c3e8f431dfe43dd3ba2a0dc94f0f7f19fcbbb80eb6a5412686d5a05732d5
#. default-sha256: 76366a3eeb5ed01dc1e1111cba8052786546266811048e6dc80fcf4680fd0600
msgctxt "scenario7:scenario7_FE8E2917_B186_4CDB_AABC_5C3944D5B965"
msgid ""
"⟪k:0⟫⟪k:1⟫But do be warned, my horse is a bit temperamental.⟪k:2⟫⟪k:3⟫If you’re not gentle, he’ll "
"start getting moody with you."
msgstr ""
