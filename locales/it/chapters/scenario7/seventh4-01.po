msgctxt "scenario7:scenario7_D20445E2_F2CC_476C_91B1_81FD0056EDE1"
msgid "⟪k:0⟫so every time I took up my quill, my hands trembled."
msgstr "⟪k:0⟫perciò ogniqualvolta prendevo la mia penna d’oca, le mie mani tremavano."

