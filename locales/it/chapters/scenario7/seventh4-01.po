#: scenario7:scenario7_2917C442_2C2F_4A42_8209_D81D50F57791
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 2a20f93febeda83a428988bd73dbd2a017ea39ab36902b54143c48c50b7eddff
#. default-sha256: 4783a7989a7bf8b4bf7f99682427baa944a164d774e29f9c901e66c5daae5866
msgctxt "scenario7:scenario7_2917C442_2C2F_4A42_8209_D81D50F57791"
msgid ""
"⟪k:0⟫The only time the routine changed was when, on occasion, a servant would arrive bearing a "
"letter."
msgstr ""
"⟪k:0⟫Le uniche volte in cui la routine veniva interrotta era quando, di tanto in tanto, qualche "
"servo arrivava portando con sé una lettera."

#: scenario7:scenario7_A27261B4_309E_4583_92FE_6917A44D1D9F
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 2e9f3a94f560a953a397d6c984f913fe80af8188666b4d466f99f8fdf6d9e45b
#. default-sha256: b44354fa62e7c4c666db3b651218d8ead0e570b1ea93090ab12684d1f79d2877
msgctxt "scenario7:scenario7_A27261B4_309E_4583_92FE_6917A44D1D9F"
msgid "⟪k:0⟫She demanded I speak like a girl, and I didn’t have the strength to defy her."
msgstr "⟪k:0⟫Chiedeva che parlassi come una ragazza, e io non avevo la forza di oppormi."

#: scenario7:scenario7_7019A919_831D_4189_B094_0BF9750DBEAA
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 74a54d730f3dfe5104730730a84d31c07bc2b5e7c458f465f5ef25e39612ff01
