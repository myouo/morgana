#: scenario7:scenario7_19C8A4BC_99C1_487D_8145_8D0EA7C19F58
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 123185bb273d6944e5e500f8ac6bffe91414cf946d6153acab06c2b3e16ee644
#. default-sha256: 019c2c27b728406fccb6d1a82c65864c8d033feea283dcb31d73ddb540c3b25c
msgctxt "scenario7:scenario7_19C8A4BC_99C1_487D_8145_8D0EA7C19F58"
msgid ""
"⟪k:0⟫After being pierced by Didier’s blade,⟪k:1⟫⟪k:2⟫I found myself looking down upon my own "
"corpse."
msgstr ""
"⟪k:0⟫Dopo essere stato trafitto dalla lama di Didier,⟪k:1⟫⟪k:2⟫mi ritrovai a guardare il mio "
"stesso cadavere."

#: scenario7:scenario7_80A15A9D_1B5F_42D0_A41D_B1D1F2177CA8
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 796971796d54c3c77b2415324681818780475f807024a9a1de76694909045cda
#. default-sha256: fd98ca1c285cb6af8fe7de49de2e4e4e2571574b2c2233797f1978620cbe7607
msgctxt "scenario7:scenario7_80A15A9D_1B5F_42D0_A41D_B1D1F2177CA8"
msgid "⟪k:0⟫I watched as my eldest brother dragged me to the place of my crucifixion."
msgstr ""
"⟪k:0⟫Osservavo mentre mio fratello maggiore mi trascinava verso il luogo della mia crocifissione."

#: scenario7:scenario7_6BA73D07_65B7_4AFD_884C_81E2F012DF25
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 795b3d7dfa706e47fee8e31022c03aa748a98f0821458c43ac6c871df9ba993c
#. default-sha256: 16f68c947ee181585f89b2cbcbf6166d30e669f29898640ae81a859992f5acd1
msgctxt "scenario7:scenario7_6BA73D07_65B7_4AFD_884C_81E2F012DF25"
msgid "⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫⟪k:4⟫The knights!"
msgstr "⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫⟪k:4⟫I cavalieri!"

#: scenario7:scenario7_8B7324EA_75E9_434E_B1E0_E73B255130B5
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: c5c5b7678e5dd9799c765399a032db5fe9d738628df1d8da63ddc1249672c43d
#. default-sha256: 64e14e1121bc729c5ad2c718e637008f2c88bf60ed3029ffc75dd874f7e58cc4
msgctxt "scenario7:scenario7_8B7324EA_75E9_434E_B1E0_E73B255130B5"
msgid ""
"⟪k:0⟫The men who had come to ransack the mansion were standing there, staring at my body in awe."
msgstr ""
"⟪k:0⟫Gli uomini che erano venuti a depredare la villa erano lì,⟪k:1⟫mentre fissavano sbalorditi "
"il mio corpo."

#: scenario7:scenario7_ED90C3D4_9453_4321_A580_7F1D34EEEF7D
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 92131ea08eb9f970ecf34cd2ee32f5f4e83a63abb63621cc3d2fa183c81ccc3a
#. default-sha256: 69716e3c4b0938d21105154457980498b7b9963c30f2c68aad50ec7ed9efe6ff
msgctxt "scenario7:scenario7_ED90C3D4_9453_4321_A580_7F1D34EEEF7D"
msgid ""
"⟪k:0⟫Ahh, the Lord’s judgment has been delivered unto the witch of the cursed mansion by His holy "
"servants."
msgstr ""
"⟪k:0⟫Ahh, i sacri servitori del Signore hanno imposto il giudizio divino⟪k:1⟫alla strega della "
"villa maledetta."

#: scenario7:scenario7_9A1A1486_1AC2_4F6B_93BF_65F63A063C83
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 1b13654642e4817b3d6cddf55f31c769f8b353cbddfc6b93923db7a7c8411383
#. default-sha256: 43b8a48ed37bde5866c5734807c450b8d00589a9b8ffbb6e2cf46ebd86819454
msgctxt "scenario7:scenario7_9A1A1486_1AC2_4F6B_93BF_65F63A063C83"
msgid ""
"⟪k:0⟫We have assembled all the tools you need to execute your divine mission. ⟪k:1⟫A cross, "
"befitting of such a heinous sinner!"
msgstr ""
"⟪k:0⟫Abbiamo riunito tutti gli attrezzi che vi servono per esercitare la vostra sacra missione. "
"⟪k:1⟫Una croce adeguata ad una tale peccatrice!"

#: scenario7:scenario7_71CEAC7F_E583_49D1_AD46_B531CE5EA92D
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: c2bdf293eee8187e43c27fb6bfceb8da8e68a67a8c3fa8fed7a5c41a5d6a3bde
#. default-sha256: f1b79d972ca6bfde7606ef0ec4616d3d7df112a37296dd320cd34c99f573409a
msgctxt "scenario7:scenario7_71CEAC7F_E583_49D1_AD46_B531CE5EA92D"
msgid "⟪k:0⟫That witch threatened to curse us!⟪k:1⟫⟪k:2⟫Sullied our pure ears with its blasphemy!"
msgstr ""
"⟪k:0⟫Quella strega ha minacciato di maledirci!⟪k:1⟫⟪k:2⟫Lordando le nostre orecchie incontaminate "
"con la sua blasfemia!"

#: scenario7:scenario7_C92DCB1B_C140_4C09_A9F4_4E152AD3CBD0
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: c81fcdbf9c54fad574981e88944b5daa98c7dbd7f3beae35c661da0a5559742e
#. default-sha256: bf0022182abe2e07c8660d8b8bbbe77ad6f47d8482fc1ee778558f4fa778b819
msgctxt "scenario7:scenario7_C92DCB1B_C140_4C09_A9F4_4E152AD3CBD0"
msgid ""
"⟪k:0⟫I had done no such thing...⟪k:1⟫⟪k:2⟫I hadn’t cursed anyone.⟪k:3⟫⟪k:4⟫I had merely been "
"defending myself..."
msgstr ""
"⟪k:0⟫Non avevo fatto niente del genere...⟪k:1⟫⟪k:2⟫Non avevo maledetto nessuno...⟪k:3⟫⟪k:4⟫Mi "
"stavo solamente difendendo..."

#: scenario7:scenario7_01CDD73C_7009_4BF2_A713_A9D75E21BF1C
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 8f21121426c934b2bfcc905a98ee510e3a5d74e12cadd425ac43829683264c52
#. default-sha256: ccfeb5c815a7a4d14fb3efc63c2a8b9d3d6ec21f676f4118ba8b14411d1fa008
msgctxt "scenario7:scenario7_01CDD73C_7009_4BF2_A713_A9D75E21BF1C"
msgid ""
"⟪k:0⟫They had been armed and outnumbered me...⟪k:1⟫⟪k:2⟫so I had said what was necessary to chase "
"them off."
msgstr ""
"⟪k:0⟫Erano armati ed io ero in minoranza...⟪k:1⟫⟪k:2⟫così mi ero detto che fosse necessario "
"scacciarli."

#: scenario7:scenario7_9F09D42E_C560_4E6C_85CC_E1446F093B6E
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 8362d607201dbfb8d81265d837131ab76c6ba41fec246e9ef4c641add2dbeadb
#. default-sha256: 04031523f694528e694c45fcccac3ea08687b352d6c2e8fc7d00405ea6063e72
msgctxt "scenario7:scenario7_9F09D42E_C560_4E6C_85CC_E1446F093B6E"
msgid ""
"⟪k:0⟫Our poor harvest and our suffering at the hands of the greedy lord were all the work of the "
"witch!"
msgstr ""
"⟪k:0⟫Il nostro povero raccolto e le nostre sofferenze per mano dell’avido lord erano tutta opera "
"della strega!"

#: scenario7:scenario7_95CFA38E_6A0D_45D8_AC57_B18FBA96D197
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 1f1fc4659806f6b796757e2db9f580f3736528be13ead757e8a60703b4a63af4
#. default-sha256: 0d6f0cd69de6e5714514ea4dd5261d8defd3343b0957ecfd72d6ecc90fecc743
msgctxt "scenario7:scenario7_95CFA38E_6A0D_45D8_AC57_B18FBA96D197"
msgid "⟪k:0⟫So I prayed. ⟪k:1⟫I asked God to grant me the smallest of miracles."
msgstr "⟪k:0⟫E così, pregai. ⟪k:1⟫Chiesi a Dio di concedermi il più piccolo dei miracoli."

#: scenario7:scenario7_033A2315_AC2C_41C2_8315_A7996EA3E827
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 91c35c9f8ddc585719a9ca9b009b317c92c7e82572f394531f96d20c9b4d4258
#. default-sha256: 5e67b79258d0ddee63ca7f89883de1f45ba80f712684fabdea53239f6c8d4518
msgctxt "scenario7:scenario7_033A2315_AC2C_41C2_8315_A7996EA3E827"
msgid "⟪k:0⟫To let my voice reach my brother, who carried my body."
msgstr ""
"⟪k:0⟫Di lasciare che la mia voce raggiungesse mio fratello,⟪k:1⟫che stava trasportando il mio "
"corpo."

#: scenario7:scenario7_3862AE0C_464A_4525_8ECB_6E3291ABEB35
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 57e1a039ac1fef600ebaed6fcb337717218814fdc454c0d78dd921caca903f0b
#. default-sha256: 5ab74ed453a15f55ada12528551d7afa10953e8a704fd25da5eae24ec627e3d2
msgctxt "scenario7:scenario7_3862AE0C_464A_4525_8ECB_6E3291ABEB35"
msgid "⟪k:0⟫You know me better than that...⟪k:1⟫⟪k:2⟫You know I’ve done nothing wrong..."
msgstr "⟪k:0⟫Tu mi conosci bene...⟪k:1⟫⟪k:2⟫Tu ⟪k:3⟫sai⟪k:4⟫ che non ho fatto niente di male..."

#: scenario7:scenario7_D009FECC_2960_47A6_8DA6_F92E9871462F
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: ab2112a9a2d418a3a027a26b0366674eef87933e6d23e14c7c3c13eb2572c50b
#. default-sha256: bd87778180bbc71255707472ac5663f789a5f186153a01cf9f2109b2848cb4ce
msgctxt "scenario7:scenario7_D009FECC_2960_47A6_8DA6_F92E9871462F"
msgid ""
"⟪k:0⟫Those men smirking at the sight of my body...⟪k:1⟫⟪k:2⟫they’re the ones putting the blame "
"for their sins on me..."
msgstr ""
"⟪k:0⟫Quegli uomini sogghignano alla vista del mio corpo...⟪k:1⟫⟪k:2⟫Stanno scaricando la colpa "
"per i loro peccati su di me..."

#: scenario7:scenario7_00B923A4_C9C9_4378_986A_F8838E238D0B
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: f8cd69b74ccb09f525d7d45aeaa4b49cc6fd8316fe321f7538cc39b5f7bfdb00
#. default-sha256: f488967ad5d9897027c9cea38a3265495abdadfc02c801409894b26aeabd9e1a
msgctxt "scenario7:scenario7_00B923A4_C9C9_4378_986A_F8838E238D0B"
msgid "⟪k:0⟫then surely ⟪k:1⟫you⟪k:2⟫ can give me a respectable burial..."
msgstr "⟪k:0⟫allora di sicuro tu ⟪k:1⟫puoi⟪k:2⟫ darmi una degna sepoltura..."

#: scenario7:scenario7_B29EA92E_1B87_454B_8F71_08A903F801C9
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: eb43237bf6a6024ee8c8ecb1adc81f4184af1187ef0b79db00a3ad6fc2018aa9
#. default-sha256: 48f41697b22461c825c2f67ac00db3078091b23a05c42741f58ec0ffc02c435d
msgctxt "scenario7:scenario7_B29EA92E_1B87_454B_8F71_08A903F801C9"
msgid "⟪k:0⟫............"
msgstr "⟪k:0⟫............"

#: scenario7:scenario7_811B82B8_CEB2_4DEE_AEBD_1FA47DD3DB02
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 1f65bdf78e486abc4ce095ac7be8fcc7aa17c0d72b22338dadf1d4a69dd97f88
#. default-sha256: bbc2e6800378bbe320b937a50d1228edd86ab1aa9cb065ef4d62c5c3da5fc609
msgctxt "scenario7:scenario7_811B82B8_CEB2_4DEE_AEBD_1FA47DD3DB02"
msgid "⟪k:0⟫Why do you say nothing?"
msgstr "⟪k:0⟫Perché non dici niente?"

#: scenario7:scenario7_EA47D360_0BC7_473A_B649_CFC04349B927
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 3095294afbd0f61ea7d00079bce84d6f083fd4d5a4da03dce303d7bc2ab87ef5
#. default-sha256: 758a179ee954ce9fc074115493e98e0fe375a0712e3d760104376ac2001da9c7
msgctxt "scenario7:scenario7_EA47D360_0BC7_473A_B649_CFC04349B927"
msgid "⟪k:0⟫Why do you accept the tools this man presents you—"
msgstr "⟪k:0⟫Perché accetti gli strumenti che quell’uomo ti ha dato—"

#: scenario7:scenario7_E6DB3BE6_2FD3_48F8_9DB3_67C9E599D0B8
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 66271ebfb4847f40408278b562d21f81183775ab87a011e4ac5a5609f8b1c447
#. default-sha256: add5a0e09ccf161517519d97feefcaf9805d0dcf3fe0cf2df0daf50e175327c0
msgctxt "scenario7:scenario7_E6DB3BE6_2FD3_48F8_9DB3_67C9E599D0B8"
msgid "⟪k:0⟫tools meant to punish me?"
msgstr "⟪k:0⟫strumenti destinati a punirmi?"

#: scenario7:scenario7_5B464F04_9A92_4579_8C51_EC91CD240255
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 9521e00b228135351a6fc667877a1085d89e53aa22db8a0bd1c31d50f296fc2e
#. default-sha256: f643661b38c13f86158fa5a5a88bc7ae9f07ae8b4342faebaeded15273e6e01e
msgctxt "scenario7:scenario7_5B464F04_9A92_4579_8C51_EC91CD240255"
msgid "⟪k:0⟫Tell me, Didier..."
msgstr "⟪k:0⟫Dimmelo, Didier..."

#: scenario7:scenario7_12D6FB59_6A51_4848_942F_F4928D9277D5
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 7da1b90d07fa48b18bb491852d6acd247019ec419d37699a49edcbd7106241de
#. default-sha256: 5f6617dfca4c78797910400ab03701e73d4a1a41daa8aa5a0c0c208824f9a0c9
msgctxt "scenario7:scenario7_12D6FB59_6A51_4848_942F_F4928D9277D5"
msgid "⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫Crucify the witch!"
msgstr "⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫Crocifiggete la strega!"

#: scenario7:scenario7_06E89998_6C35_4344_BE0B_EE8EF13FA4D4
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: d1ffc394fd37e74e59a0a57c92098672708a011949df250792445a2f7b7040e4
#. default-sha256: 7db95ae2150137022c747492f16f3f124221c818bb3cba31b5fd0e58d8453cf6
msgctxt "scenario7:scenario7_06E89998_6C35_4344_BE0B_EE8EF13FA4D4"
msgid ""
"⟪k:0⟫Please, anything but that... ⟪k:1⟫I’m begging you...⟪k:2⟫⟪k:3⟫don’t expose me to these "
"people..."
msgstr ""
"⟪k:0⟫Ti prego, tutto ma non questo... ⟪k:1⟫ti supplico...⟪k:2⟫⟪k:3⟫non espormi davanti a questa "
"gente..."

#: scenario7:scenario7_1281D409_8BEB_4CAE_888D_48DFD6D3CBC6
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 9a5ca53ea8e2e37843c96ec958672ee7723c0dca2b80323180c6dbaeca9ef0b5
#. default-sha256: dce735397032daedd113ff82d4d00716d5da51b4da7538c5894d90e91f1066a5
msgctxt "scenario7:scenario7_1281D409_8BEB_4CAE_888D_48DFD6D3CBC6"
msgid "⟪k:0⟫Don’t expose my body, Didier!"
msgstr "⟪k:0⟫Non esporre il mio corpo, Didier!"

#: scenario7:scenario7_CF06DD32_7A5D_48DC_AA4A_7BDD93E968AC
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 8b36999a381887c97e26de421cfb278de253c96ed5e2bdc1b3c892bd431ca3fc
#. default-sha256: aeda3fbba238f7b8d0f000c13d3cd5379b942b557f7e078e6e72ae4f8af94f1c
msgctxt "scenario7:scenario7_CF06DD32_7A5D_48DC_AA4A_7BDD93E968AC"
msgid "⟪k:0⟫I’m begging you—"
msgstr "⟪k:0⟫Ti supplico—"

#: scenario7:scenario7_D05EA808_47E5_4593_A6B0_973EFD32CE3F
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: ed3b4e20ec10db9c930d20c16718f24c96f99fe8591fc67b52c9304e42574926
#. default-sha256: 688885e97b2e9f5fa3af858b58efa73f2d4cd2322ed5b36a9e03c22d95e01fd5
msgctxt "scenario7:scenario7_D05EA808_47E5_4593_A6B0_973EFD32CE3F"
msgid ""
"⟪k:0⟫But of course, my voice had no way of reaching him,⟪k:1⟫⟪k:2⟫and he proceeded to remove my "
"clothing, piece by piece,"
msgstr ""
"⟪k:0⟫Ma ovviamente, la mia voce non poteva raggiungerlo,⟪k:1⟫⟪k:2⟫e lui continuò a togliermi i "
"vestiti, pezzo dopo pezzo,"

#: scenario7:scenario7_1DCF0803_C04F_40B6_958E_B00ADB3E0CED
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: a9e14e9dd09fa9f1b799428ecc8de0987b26993d236f3f1116b2935fdf5bc990
#. default-sha256: 046653fb0986ccb89bde1d4efd5fc544f0526ab34b004b84f24cb5c5dd055482
msgctxt "scenario7:scenario7_1DCF0803_C04F_40B6_958E_B00ADB3E0CED"
msgid "⟪k:0⟫until I was left fully nude."
msgstr "⟪k:0⟫finché non rimasi completamente nudo."

#: scenario7:scenario7_8239D993_E4CC_494D_AE65_0BC3127CD6EC
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: a9023ae4eafc9e34d03d2506efd47c8ac9c9a3c61be222d1a40c0ff3ab199107
#. default-sha256: def87684a19f82dacc40ee543fa72721fb3f32cec4e8c1ccb5f388a4842bc4a5
msgctxt "scenario7:scenario7_8239D993_E4CC_494D_AE65_0BC3127CD6EC"
msgid "⟪k:0⟫And then, with a mocking laugh, one man spoke,"
msgstr "⟪k:0⟫E poi, con una risata beffarda, un uomo parlò,"

#: scenario7:scenario7_90C9BCAA_38F4_4491_BFFE_F74F8614A885
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 3347f61d0f2228744f532a4ef2b74107186cf15e7c7334014a3c2513787e3c9b
#. default-sha256: 0aa0de75f329f401b592b343dbbaf53b38cb49e92c7607243c13f1bcda5146e3
msgctxt "scenario7:scenario7_90C9BCAA_38F4_4491_BFFE_F74F8614A885"
msgid "⟪k:0⟫Ahh, so there it is... ⟪k:1⟫the devilish creature."
msgstr "⟪k:0⟫Ahh, dunque eccola lì... ⟪k:1⟫la creatura infernale."

#: scenario7:scenario7_25AEB98A_D52B_4761_915D_8DA07D7F283F
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
