msgid "⟪k:0⟫An angel...⟪k:1⟫⟪k:2⟫Ah, yes. I can see it now, Lydie."
msgstr "⟪k:0⟫Un angelo...⟪k:1⟫⟪k:2⟫Ah, sì. Ora riesco a vederlo, Lydie."

#: scenario7:scenario7_9391D6D2_7A8F_49EF_8D12_343DE250AFC9
