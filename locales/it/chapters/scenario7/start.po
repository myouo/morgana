#: scenario7:scenario7_BFB2B8B6_B695_446E_AF6A_3EA9B1F732A5
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 915da998f3603bb2144bf466b8827ceec57e707dcc2f9f24d94d2d11304443ca
#. default-sha256: f96ac6dc61f1cbba067c6680aeb1551e935a794a9c41ffa27190d0b37c5209ab
msgctxt "scenario7:scenario7_BFB2B8B6_B695_446E_AF6A_3EA9B1F732A5"
msgid ""
"⟪k:0⟫My, she opened her eyes!⟪k:1⟫⟪k:2⟫Maybe she felt you nearby.⟪k:3⟫⟪k:4⟫Hehehe, do you like "
"your father more than me?⟪k:5⟫⟪k:6⟫Is that it, sweetheart?"
msgstr ""
"⟪k:0⟫Hah, ha aperto gli occhi!⟪k:1⟫⟪k:2⟫Forse ha sentito che eri vicino.⟪k:3⟫⟪k:4⟫Hehehe, ti "
"piace più tuo padre di me?⟪k:5⟫⟪k:6⟫⟪k:7⟫È⟪k:8⟫ così, tesoro mio?"

#: scenario7:scenario7_F8F2E1E7_3348_48D2_977D_FF8F38BC7924
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 33363fc8217dd8775cefdb748c7a20605c8d5a55705666affa77d07c3c540eae
