#: scenario7:scenario7_6695B475_B4E7_426F_B473_1770F2C607AF
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 5fbecbcfdd870c1f7cc73f22c4f99760d15b184444c02b8758eedc8e6132cd58
#. default-sha256: fda6ec5712e60d63caab2852cf1bd5416f6830eedf92178a4572d045b5879283
msgctxt "scenario7:scenario7_6695B475_B4E7_426F_B473_1770F2C607AF"
msgid ""
"⟪k:0⟫She needs a name—⟪k:1⟫⟪k:2⟫one that’s just as special as her.⟪k:3⟫⟪k:4⟫Have you already "
"chosen, Antonin?"
msgstr ""
