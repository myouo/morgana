msgid "⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫⟪k:4⟫My god, look at that..."
msgstr "⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫⟪k:4⟫Mio Dio, guarda..."

#: scenario7:scenario7_E4A05C7E_B25F_4801_9F09_491FC019AAB7
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: dac8688efe633d55ae750c22f208733c4c77281200a958f12a66f15e413ac0ef
