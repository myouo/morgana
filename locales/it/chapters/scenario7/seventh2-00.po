msgctxt "scenario7:scenario7_33EABD98_BC03_4C5B_A81A_10244168B25D"
msgid "⟪k:0⟫As I was meandering through the courtyard,"
msgstr "⟪k:0⟫Mentre girovagavo per il cortile,"

#: scenario7:scenario7_47DE9F2F_B236_42A3_8344_89543D58A343
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 028a50f83e7501ea74e9fc77c7d92e314082b2fb2e185b0900214d79b0d3260c
#. default-sha256: 4fb352f031a6f5a48811d57c4ea33ab442574de48228044e6fb16c9538213b92
msgctxt "scenario7:scenario7_47DE9F2F_B236_42A3_8344_89543D58A343"
msgid "⟪k:0⟫⟪k:1⟫⟪k:2⟫I spotted someone I had never seen before."
msgstr "⟪k:0⟫⟪k:1⟫⟪k:2⟫notai qualcuno che non avevo mai visto prima."

#: scenario7:scenario7_7A0FC6F3_CC1D_4374_8C85_9A990957566C
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 5abcc9fa2aca8d91aa1fda762336fc71feaf442f712f2ffbd894cd4dc4879ccb
#. default-sha256: 6f0e42783a0ce653eecce878bdf42241b8e2c92b89ba4a523dcaa4a07d402fa3
msgctxt "scenario7:scenario7_7A0FC6F3_CC1D_4374_8C85_9A990957566C"
msgid "⟪k:0⟫⟪k:1⟫...Who are you?"
msgstr "⟪k:0⟫⟪k:1⟫...Tu chi sei?"

#: scenario7:scenario7_55F98633_ED37_45A9_8D4F_1F8F68725FB4
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: b80f80f607778b4d0c44e4de426ec0cce76ba6d7fada35d67519c53469ec1bf4
#. default-sha256: 5782de5b31a97032080bfc3956ef139d1b97fcfe2f55835f3c3d24bba6108d55
msgctxt "scenario7:scenario7_55F98633_ED37_45A9_8D4F_1F8F68725FB4"
msgid "⟪k:0⟫I asked bluntly, and the girl twirled around, smiling."
msgstr "⟪k:0⟫Chiesi sfacciatamente, e la ragazza si voltò, sorridendo."

#: scenario7:scenario7_5541FDCB_DB15_422E_B325_810ED59E7372
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 4b3f2940cac703ddfeb2f476f29734206532dfbfa0f233766d2c96fc02a98bab
#. default-sha256: d38a1a1f5d3cc73d817abb2b522b8cc560158f3a1e4c1d2cdf00f8afc7aaeb33
msgctxt "scenario7:scenario7_5541FDCB_DB15_422E_B325_810ED59E7372"
msgid ""
"⟪k:0⟫⟪k:1⟫My apologies. You just have such a beautiful courtyard here I let myself in for a "
"little walk."
msgstr ""
"⟪k:0⟫⟪k:1⟫Le mie scuse. ⟪k:2⟫È⟪k:3⟫ solo che avete un così bel cortile qui fuori che mi sono "
"permessa di fare quattro passi."

#: scenario7:scenario7_45288BEE_D663_41C1_AF44_3429D72D3EE7
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 2521b7f193ee50a1118b85969d9dfbc7d146bee4e105c59533fdce9c7de634de
#. default-sha256: 4cc5a67a015d8485c497d1e6642981ec8419ec1b9d6b5f18803aa3f2b90672d2
msgctxt "scenario7:scenario7_45288BEE_D663_41C1_AF44_3429D72D3EE7"
msgid ""
"⟪k:0⟫Long, chestnut hair flowed over round, feminine shoulders.⟪k:1⟫⟪k:2⟫It swayed slightly in "
"the wind."
msgstr ""
"⟪k:0⟫Lunghi capelli castani scorrevano su delle spalle rotonde e femminili,⟪k:1⟫⟪k:2⟫e "
"ondeggiavano delicatamente col vento."

#: scenario7:scenario7_0B2ABE52_A65A_4EF3_A1D8_199842CE8E31
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 2f068257dd770918abb496876e2862c0fa086fa53ecf713200c6dfc6fa47745d
#. default-sha256: 216a31631532647d86b4a38ab4785f0e815f2013716d41ad903e0ab62fdaa161
msgctxt "scenario7:scenario7_0B2ABE52_A65A_4EF3_A1D8_199842CE8E31"
msgid "⟪k:0⟫The cloud of melancholy dissipated in the light of her smile."
msgstr "⟪k:0⟫La nuvola di malinconia si disperse nella luce del suo sorriso."

#: scenario7:scenario7_4D4E9084_E870_492E_A998_C5D99E26EDB7
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 31fa809d7f07c4749a7e81ebbc73bac92cada761608af2f7e94ff1bbe198493b
#. default-sha256: 1a9d368c6f037b5671869b8b7cf4f3c9cd79b5d9d7434effee21151bf43c5fe3
msgctxt "scenario7:scenario7_4D4E9084_E870_492E_A998_C5D99E26EDB7"
msgid "⟪k:0⟫⟪k:1⟫You must be Michelle.⟪k:2⟫⟪k:3⟫You’re just as pretty as I heard."
msgstr "⟪k:0⟫⟪k:1⟫Tu devi essere Michelle.⟪k:2⟫⟪k:3⟫Sei bella proprio come mi avevano detto."

#: scenario7:scenario7_CCB94BB0_F5ED_434C_B5C7_F0C5C7FCCBAA
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 87e910acdbc0d2ee29ae02acc9e580644b76627fc2d2fa4985015d57a43b47c6
#. default-sha256: 221d009a0e612640d5225ff35d437905a4592693dbed8519b7854679928b2e12
msgctxt "scenario7:scenario7_CCB94BB0_F5ED_434C_B5C7_F0C5C7FCCBAA"
msgid ""
"⟪k:0⟫“Finally” meet me? What was she talking about?⟪k:1⟫⟪k:2⟫As I stood there, baffled by this "
"strange woman,"
msgstr ""
"⟪k:0⟫“Finalmente”? Di che stava parlando?⟪k:1⟫⟪k:2⟫Mentre me ne stavo lì, confusa da quella "
"strana donna,"

#: scenario7:scenario7_0C0861C5_D4B4_453C_8326_7C12D391459E
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: aeb66d6921562f70a68f66b3c1fd33345a370c96cd9d21c6b7c1b448948510c4
#. default-sha256: 67761eca892a789da9d2f1370a984829ee163896453a093c3be3ec9a0e6766e1
msgctxt "scenario7:scenario7_0C0861C5_D4B4_453C_8326_7C12D391459E"
msgid "⟪k:0⟫⟪k:1⟫I’m thrilled to make your acquaintance, Michelle."
msgstr "⟪k:0⟫⟪k:1⟫Sono così emozionata di fare la tua conoscenza, Michelle."

#: scenario7:scenario7_395D00B7_3D6A_4726_82D2_4B0208B5AAE9
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 9d912519c40987fb70cc6a8566153788818972e025717661d2f2e5a32a323abd
#. default-sha256: da18fbaa930df94ce92fc6bfbedc6b5ae2cae9d2e4e185eaa664978e0ba127cb
msgctxt "scenario7:scenario7_395D00B7_3D6A_4726_82D2_4B0208B5AAE9"
msgid "⟪k:0⟫Her voice was like someone pouring honey into my ear."
msgstr "⟪k:0⟫La sua voce era come miele versato nelle mie orecchie."

#: scenario7:scenario7_2E190DA1_1B5B_42B8_9724_46FD4AEA5E64
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: f5aee047ffa1afb4f6d76a25e0dc33776263fef1ac80b6375c1ad681f68ee3cb
#. default-sha256: 5b25dad1ff337b87e931ece9612d709077240c8b84c70a6451e9272e5965537e
msgctxt "scenario7:scenario7_2E190DA1_1B5B_42B8_9724_46FD4AEA5E64"
msgid "⟪k:0⟫stuck another needle into my chest."
msgstr "⟪k:0⟫un altro ago conficcato nel mio petto."

#: scenario7:scenario7_92BD0387_003C_458B_BBFA_677D0840B7BC
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: fa2cff3c076036651e9bf984e541c75d19a0c4086818ea2ae8e53f9241772d25
#. default-sha256: a325c6fc70e72e2d4a6dfa55c66ecc81c05a7ea19bfd85421bae837e54449b08
msgctxt "scenario7:scenario7_92BD0387_003C_458B_BBFA_677D0840B7BC"
msgid "⟪k:0⟫No one had told me my brother was to be married."
msgstr "⟪k:0⟫Nessuno mi aveva detto che mio fratello stava per sposarsi."

#: scenario7:scenario7_2EA1FB27_A290_45D4_B001_ED2BAE059597
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: ed34418a8b6fe1f6a0a835cdb200e289444f664f411011e44d22a17d55aca406
#. default-sha256: 4848db15ff1629cdf64a9a32c87b412152048e3190c21e5d43c045f069f93bf5
msgctxt "scenario7:scenario7_2EA1FB27_A290_45D4_B001_ED2BAE059597"
msgid ""
"⟪k:0⟫My father Antonin looked so proud of his two boys—⟪k:1⟫⟪k:2⟫Didier soon to receive his "
"assignment, and Georges soon to be wed."
msgstr ""
"⟪k:0⟫Mio padre Antonin era così fiero dei suoi due ragazzi—⟪k:1⟫⟪k:2⟫Didier avrebbe presto "
"ricevuto il suo incarico, e Georges si sarebbe sposato."

#: scenario7:scenario7_28390D52_0EA1_4574_8E8E_15A463F1A092
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: caa12d92c153db1e34370f4eb5ebcb30a36424ff7d5b5d7807f9c2f823e0101f
#. default-sha256: 0f0810fd0d7f0d91ae24f4a59c9aea50e856f018323fbf74814f85c58236e55f
msgctxt "scenario7:scenario7_28390D52_0EA1_4574_8E8E_15A463F1A092"
msgid "⟪k:0⟫The banquet proceeded smoothly,"
msgstr "⟪k:0⟫La cena proseguiva senza problemi;"

#: scenario7:scenario7_40ADECC1_364A_41F8_AF37_4F3E4BECF6B9
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: d6a1fa3328354d01622d8573dbbe652026d5eaafc067c965567d5ab81e29f4b1
#. default-sha256: dd856b3494f0455f1d87632cf53d4152aae7889a98c8f4b35ccb16cd026adaaa
msgctxt "scenario7:scenario7_40ADECC1_364A_41F8_AF37_4F3E4BECF6B9"
msgid "⟪k:0⟫not a doubt in the air that we were a happy family."
msgstr "⟪k:0⟫non c’era il minimo dubbio che fossimo una famiglia felice."

#: scenario7:scenario7_12A5BB5F_4099_4D82_9B68_037211FB700C
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 3e1a30cb84e20fd986f92112b2124ec34c473fb8e650e4915d22349e9dd8810e
#. default-sha256: fc9105e7b4e736527a8aa42cb31d381a0cf1983a3a3a4939f973beb4c98694a3
msgctxt "scenario7:scenario7_12A5BB5F_4099_4D82_9B68_037211FB700C"
msgid "⟪k:0⟫But my mind was elsewhere."
msgstr "⟪k:0⟫Ma io avevo la testa altrove."

#: scenario7:scenario7_42746B8F_4494_49DF_A79B_BBA692F85693
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 27e3cc9992c78645e44c6dd3965851e0c237e7949f1e56518e0c54a68188002b
#. default-sha256: 4cc3c523d7868ce33ec462649864e0cfbcb87c97ed5a175d2a15ab4e13d16705
msgctxt "scenario7:scenario7_42746B8F_4494_49DF_A79B_BBA692F85693"
msgid "⟪k:0⟫I found myself unconsciously chasing Aimee with my eyes."
msgstr "⟪k:0⟫Inconsciamente, mi ritrovai ad inseguire Aimee con lo sguardo."

#: scenario7:scenario7_82923E7B_2641_4CE0_85D9_3B478E646923
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 5cd13acdf51031a7cf8906c46065fca3bc9eaddf5714f76b0425e1f2e860a909
#. default-sha256: 367e5939fdcecbfcbb37b5f11164d31120de43e59c4cd6d112d457b9bfe7555a
msgctxt "scenario7:scenario7_82923E7B_2641_4CE0_85D9_3B478E646923"
msgid ""
"⟪k:0⟫Watching the way those slender fingers gripped her spoon.⟪k:1⟫Her full lips parting to allow "
"a piece of fruit in."
msgstr ""
"⟪k:0⟫Osservando il modo in cui quelle dita sottili afferravano il cucchiaio.⟪k:1⟫Le labbra "
"carnose che si aprivano per lasciare entrare un pezzo di frutta."

#: scenario7:scenario7_991665B7_761E_4CBB_9097_F7C40F47BB38
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 2e533db5d2c0af782fe65f8d8753005fa1447325415a02e71c1f71ccbb37adca
#. default-sha256: 4eca0cd870fed06715e73d92668df8da6d23546fd222498c27a2153b8e7edc9f
msgctxt "scenario7:scenario7_991665B7_761E_4CBB_9097_F7C40F47BB38"
msgid "⟪k:0⟫Her deep red tongue, visible for but the briefest of moments."
msgstr "⟪k:0⟫La sua lingua rossa, visibile per un brevissimo istante."

#: scenario7:scenario7_3AAE7B4F_BF85_459B_B8D0_40E238F55F91
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: add4090f00b23a0c3de395bb0412e8998669f74417703d83667b6ffd8f171377
#. default-sha256: d4994434a5288e277303bd144fd6eb83d3a94322cd809ed92cd97e8186793207
msgctxt "scenario7:scenario7_3AAE7B4F_BF85_459B_B8D0_40E238F55F91"
msgid ""
"⟪k:0⟫The way all the muscles in her face seemed to relax in bliss as sweet juices seeped into her "
"mouth."
msgstr ""
"⟪k:0⟫Il modo in cui ogni muscolo del suo viso sembrava in estasi mentre il succo si riversava "
"nella sua bocca."

#: scenario7:scenario7_936CDD6B_9C02_4118_9168_A93944FB0CB5
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 4086348e0d015e04727d9b32e9b79c4a3f812dd9fbac2fcb6cafabb1596af2a9
#. default-sha256: 380d3859434ad5c6d6c7bad8cf610c182aaa5549cbbc80084b12be648161c66d
msgctxt "scenario7:scenario7_936CDD6B_9C02_4118_9168_A93944FB0CB5"
msgid ""
"⟪k:0⟫The way she spoke, so soft and gentle, letting each sound hang in the air just briefly "
"before intoning the next."
msgstr ""
"⟪k:0⟫Il modo in cui parlava, così gentile e delicato, lasciando ogni sillaba sospesa nell’aria "
"prima di intonare quella successiva."

#: scenario7:scenario7_0D190A50_753D_446D_888B_297A70987ADE
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 1eef116fc238cf36a1e7196ffbd3cdc14f544509a1eb4e86f9414cc7fd9b50d7
#. default-sha256: d91c9dbae386727cd5d3cbeb9b60798b61f2e88637be844b369e9b3fa1da58e2
msgctxt "scenario7:scenario7_0D190A50_753D_446D_888B_297A70987ADE"
msgid "⟪k:0⟫She was distinctly feminine—⟪k:1⟫⟪k:2⟫in a different way than my mother."
msgstr "⟪k:0⟫Era distintamente femminile—⟪k:1⟫⟪k:2⟫in maniera diversa rispetto a mia madre."

#: scenario7:scenario7_D0282D63_AB66_4BCD_B5CC_D26348888576
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 59489237094867cfbd549be859ff4660c5b1cf37928493dcbfd70fc60f275134
#. default-sha256: b33d27c35e26cbaa40364f95745886cabf88cc31c6376b91e6f0d457432476b1
msgctxt "scenario7:scenario7_D0282D63_AB66_4BCD_B5CC_D26348888576"
msgid "⟪k:0⟫Apparently, Aimee was going to be living at the Bollinger estate for some time."
msgstr "⟪k:0⟫A quanto capii, Aimee sarebbe rimasta nella tenuta dei Bollinger per del tempo."

#: scenario7:scenario7_81C2E136_5BC7_4B56_8605_CACB3CA4CCA5
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: f5a06d2c6b84bb2871ca911cc7c5dae7915206a2e4ffaeccb38032486043e22b
#. default-sha256: a4df6bbb7e911d8034d92e57592eab4a0eb21a01693cc12fd80f62a6158eed3d
msgctxt "scenario7:scenario7_81C2E136_5BC7_4B56_8605_CACB3CA4CCA5"
msgid "⟪k:0⟫I had assumed I would hate being around another girl."
msgstr "⟪k:0⟫Pensavo che avrei odiato stare in compagnia di un’altra ragazza."

#: scenario7:scenario7_F1C4B5DF_CCD9_42D9_8198_E5C7C2159996
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
