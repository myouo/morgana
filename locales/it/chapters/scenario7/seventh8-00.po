msgctxt "scenario7:scenario7_CCCBCFB1_6548_4761_A7EB_DD6CF25A2928"
msgid "⟪k:0⟫Standing at the top of the observation tower, I pushed open the door..."
msgstr "⟪k:0⟫Giunto in cima alla torre d’osservazione, aprii la porta..."

#: scenario7:scenario7_DB4D085A_EA76_49C3_B07E_42997BF4F2E2
