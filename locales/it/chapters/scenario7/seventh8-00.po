#: scenario7:scenario7_3905A0DF_5399_40E6_89EA_481CCE30AF81
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: bda579508e5c1feef5ad31411ffb8d4d23a2d4f6fcaa5160c991569ebf030ff5
#. default-sha256: a9ee126b39067520c34198cb246df5c51cf6f14cbbabd76cd465da5826feca77
msgctxt "scenario7:scenario7_3905A0DF_5399_40E6_89EA_481CCE30AF81"
msgid "⟪k:0⟫Thank you... ⟪k:1⟫for opening the door."
msgstr "⟪k:0⟫Grazie... ⟪k:1⟫per aver aperto la porta."

#: scenario7:scenario7_D7BF15E8_BDB8_49BE_9389_3050755E9FC2
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: c5dec178189fe80b3085dd073e31cdaf23ccecba6ee003cecae7da9e9278ffe9
#. default-sha256: ee11aad9ca8f616daab55c84e30ebbe835e76753e1871b70e1054940fe2f3342
msgctxt "scenario7:scenario7_D7BF15E8_BDB8_49BE_9389_3050755E9FC2"
msgid ""
"⟪k:0⟫The skeleton, which had been sitting there as long as I had been at this house, had vanished "
"without a trace."
msgstr ""
"⟪k:0⟫Lo scheletro, che era sempre stato lì durante la mia permanenza in quella casa, era sparito "
"senza lasciare traccia."

#: scenario7:scenario7_C1990B51_6F38_4EE4_9AB4_3AA0E740A217
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 4c0f3377752917614880e7813ed03ac41b161d5ad5bccc1376b21e0280690780
#. default-sha256: 9237fdd2c5f11ce45aee37ad922c7a42e5bbebef83f19b76a2188f80f9a8b19c
msgctxt "scenario7:scenario7_C1990B51_6F38_4EE4_9AB4_3AA0E740A217"
msgid ""
"⟪k:0⟫I spun around, my gaze darting back and forth across the chamber,⟪k:1⟫but there was no one "
"there—"
msgstr ""
"⟪k:0⟫Mi girai attorno, controllando avanti e indietro per tutta la stanza,⟪k:1⟫ma non c’era "
"nessuno lì—"

#: scenario7:scenario7_3717CEB8_6B08_4EF7_A689_0AE58EACA40A
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 63684e2aa548de42ab3422fe2f77c846ddd59c5094221f83882fb58133c1d88c
#. default-sha256: 6a908409e1ef793241ba74eb363e0872b62aac72a45770e9aee91b6dbc9866a1
msgctxt "scenario7:scenario7_3717CEB8_6B08_4EF7_A689_0AE58EACA40A"
msgid "⟪k:0⟫⟪k:1⟫You gave me the chance to have my revenge."
msgstr "⟪k:0⟫⟪k:1⟫Mi hai dato l’opportunità di avere la mia vendetta."

#: scenario7:scenario7_5C785F31_06F7_4173_9DE7_2858777CFD91
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: e218018198511c20c5e83f191795faa770679d66bc38ececb3dafcdd78b301d1
#. default-sha256: e13f8c16b89ae5c016a71630424f5857fad0ae366c24b1db520fefc34195d073
msgctxt "scenario7:scenario7_5C785F31_06F7_4173_9DE7_2858777CFD91"
msgid "⟪k:0⟫Revenge...?"
msgstr "⟪k:0⟫Vendetta...?"

#: scenario7:scenario7_17FE593C_D11B_4B3A_9B4A_FF51BD304787
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: fa15591cc59780e9b2a55daad1ca8605b8f9a663b599bc13b3d6bf4af5e17c88
#. default-sha256: 41c3427ae9e83f2f59ed15bf1585be9b9be1a81265c5de87de989044dab4a28e
msgctxt "scenario7:scenario7_17FE593C_D11B_4B3A_9B4A_FF51BD304787"
msgid "⟪k:0⟫Now, I can make those men suffer a hell even worse than the one they put me through..."
msgstr ""
"⟪k:0⟫Ora potrò far patire a quegli uomini un inferno addirittura peggiore⟪k:1⟫di quello a cui "
"loro mi hanno costretta..."

#: scenario7:scenario7_7C059B14_A129_4954_80FC_3C436FFA9B93
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 997f4bfb28331b3c48a9773e0e64a21d5f7320ddb2ace610c19f24bdb49ea346
#. default-sha256: 387be6845f3223b6060ce3b781e56d34b772d357766e6a8b69e83c2960c5317b
msgctxt "scenario7:scenario7_7C059B14_A129_4954_80FC_3C436FFA9B93"
msgid "⟪k:0⟫Hah... ⟪k:1⟫haha... ⟪k:2⟫hahaha..."
msgstr "⟪k:0⟫Hah... ⟪k:1⟫haha... ⟪k:2⟫hahaha..."

#: scenario7:scenario7_A4FDA90C_FB78_4D12_9A5B_61011E6CB9DD
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 26f0d3ca72131cc489f8e0cdfeefd95d7098d7f94ba431fb544e3859976515a6
#. default-sha256: ce7008295803b865174bb033a5107295d70e83408d9d6ce598d24c2245992696
msgctxt "scenario7:scenario7_A4FDA90C_FB78_4D12_9A5B_61011E6CB9DD"
msgid "⟪k:0⟫Ahahahahahaha..."
msgstr "⟪k:0⟫Ahahahahahaha..."

#: scenario7:scenario7_E057D1CB_B59B_439E_AE89_1CA6201F6CE0
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 508657e65685f915ffbd699bfef2c8029283f9a6ed46b8dbc3a083ec2b3f27eb
#. default-sha256: 91ce1e35aaf6436618bf675619d2fce261dadfbae6f7b932446c4514c079d024
msgctxt "scenario7:scenario7_E057D1CB_B59B_439E_AE89_1CA6201F6CE0"
msgid "⟪k:0⟫Oh, you poor dear. They locked you up here without telling you whose house it was?"
msgstr ""
"⟪k:0⟫Oh, povero caro.⟪k:1⟫⟪k:2⟫Ti hanno rinchiuso qui senza dirti chi abitava in questa casa?"

#: scenario7:scenario7_D110955E_8C94_4B5F_8B3B_023D2D661687
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 69cb171f0e2eab2b25f9406aad97b6b7993c83d853305ec11ca7fc2f3cc3c077
#. default-sha256: 6ffb00e33d234dd76a57c37916932bc04f14ec1e9c549d451ae3d53c7ca9bd9f
msgctxt "scenario7:scenario7_D110955E_8C94_4B5F_8B3B_023D2D661687"
msgid "⟪k:0⟫You sad, pathetic thing...⟪k:1⟫⟪k:2⟫Though that’s exactly the kind of person I needed."
msgstr ""
"⟪k:0⟫Triste, patetica creatura...⟪k:1⟫⟪k:2⟫Sebbene tu sia esattamente il tipo di persona di cui "
"avevo bisogno."

#: scenario7:scenario7_021FDB46_4407_4465_A38D_7CB739227033
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 2a7613fe212cca867443244011b0718d371a84c388ad1d1fa466e7fa47d97e6f
#. default-sha256: 03e6d880ddb1b65d1aede40c09598dab704df5491065d25c35daab7ac60d0e9a
msgctxt "scenario7:scenario7_021FDB46_4407_4465_A38D_7CB739227033"
msgid "⟪k:0⟫You’re... ⟪k:1⟫You’re not the witch, are you...?"
msgstr "⟪k:0⟫Non sarai... ⟪k:1⟫Non sarai mica la strega...?"

#: scenario7:scenario7_628FA3F9_73B9_45FC_9FBF_59CF1C8441D7
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 59b0f0fddbe5da3a59d232a43793556daec99e6ed8242832832d0dd37807009f
#. default-sha256: bf6ea3943ef18d452afac0f1fd3756557996894e8c900653fb7b0e8bce467091
msgctxt "scenario7:scenario7_628FA3F9_73B9_45FC_9FBF_59CF1C8441D7"
msgid "⟪k:0⟫I assumed... ⟪k:1⟫the witch was nothing but a legend. A tale..."
msgstr "⟪k:0⟫Pensavo... ⟪k:1⟫che la strega non fosse altro che una leggenda.⟪k:2⟫ Una favola..."

#: scenario7:scenario7_AD899BFA_FFBD_4B11_9952_AADF7BCE7E87
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 5feb76f26dab13ea75ce94fb37dee562ab5603ca5f8762db0e91b74abb7ca8dc
#. default-sha256: 8c274ae080041ba056368182b7ab1249b0fc7933a9af145e966470bb3fe4c99b
msgctxt "scenario7:scenario7_AD899BFA_FFBD_4B11_9952_AADF7BCE7E87"
msgid "⟪k:0⟫If you don’t believe me, I would be happy to show you.⟪k:1⟫⟪k:2⟫Let’s see..."
msgstr "⟪k:0⟫Se non mi credi, sarò lieta di dimostrartelo.⟪k:1⟫⟪k:2⟫Vediamo..."

#: scenario7:scenario7_2285AF59_5718_4557_B850_3FC210CA1C53
