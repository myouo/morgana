#: scenario7:scenario7_F82E2626_05F1_49B0_B655_22D8351EAA85
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: c489f1c71d83fb4b87c75a55780f15081b191d289f77c637353491d80a5c78a4
#. default-sha256: adaf5b53ad2ae3eec9d13815592a777322ef2b98af2f166f3ff3bd054f3839d3
msgctxt "scenario7:scenario7_F82E2626_05F1_49B0_B655_22D8351EAA85"
msgid ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫⟪k:4⟫⟪k:5⟫⟪k:6⟫⟪k:7⟫⟪k:8⟫⟪k:9⟫⟪k:10⟫⟪k:11⟫The archangel stood proudly upon "
"his glass perch,⟪k:12⟫looking down at me."
msgstr ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫⟪k:4⟫⟪k:5⟫⟪k:6⟫⟪k:7⟫⟪k:8⟫⟪k:9⟫⟪k:10⟫⟪k:11⟫L’arcangelo se ne stava con "
"orgoglio sul suo piedistallo di vetro,⟪k:12⟫guardandomi dall’alto."

#: scenario7:scenario7_3685A8D2_76B9_410A_92EE_946FC39B311A
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: a67dd8fe44c60c03dd5a20d50cd7e714e18bc2f49790b23fd6453aadbc4c915d
#. default-sha256: 6e7c90e5cb8c2b2504fa0c517750ea047303125bddbe0115ceb8e8d6a3e4dbc8
msgctxt "scenario7:scenario7_3685A8D2_76B9_410A_92EE_946FC39B311A"
msgid "⟪k:0⟫His gaze almost seemed... ⟪k:1⟫judgmental."
msgstr "⟪k:0⟫Il suo pareva quasi essere lo sguardo... ⟪k:1⟫di un giudice."

#: scenario7:scenario7_2B06C58F_460D_4798_B82E_E24EB9845EA2
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 52e72b897ecae8d4852c493c387460096b513b29e5d5371a4064385fb8ef79db
#. default-sha256: 669d7e1092569e42c9484a6267783fe4caf9b5dd7295556133b3d6d18c228c4b
msgctxt "scenario7:scenario7_2B06C58F_460D_4798_B82E_E24EB9845EA2"
msgid "⟪k:0⟫But I marched for the tower, unconcerned."
msgstr "⟪k:0⟫Ma io proseguii verso la torre, indifferente."

#: scenario7:scenario7_923AF344_9FE7_4626_B420_7B87C0EBD422
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 9e5d7526f2e35e5b555f841765381427860a8ba33c1933aaf4bd1ecbfaf7175b
#. default-sha256: 5a33042560490a0d3a710bd7061d1e0e6af338f712fa5293ba2f32eb56d52c04
msgctxt "scenario7:scenario7_923AF344_9FE7_4626_B420_7B87C0EBD422"
msgid "⟪k:0⟫For the day someone would truly set me free."
msgstr "⟪k:0⟫Il giorno in cui qualcuno mi avrebbe finalmente liberata."

#: scenario7:scenario7_80B67623_550E_4CB4_8CB0_B22D8892A316
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 20b6e99bc03602eb2679bf4d0e2f14b72f2ffb1ac7b614c4b22e35b8ef4a2c4c
#. default-sha256: 14069b9e0cce20caa5ccd6457f6e12f446f2737eee42bf5923ebd680b4cc537d
msgctxt "scenario7:scenario7_80B67623_550E_4CB4_8CB0_B22D8892A316"
msgid "⟪k:0⟫That you were led here—⟪k:1⟫⟪k:2⟫that you were ⟪k:3⟫meant⟪k:4⟫ to come to this place."
msgstr ""
"⟪k:0⟫⟪k:1⟫Sentivo⟪k:2⟫ che eri stato condotto qui—⟪k:3⟫⟪k:4⟫che tu fossi ⟪k:5⟫destinato⟪k:6⟫ ad "
"arrivare in questo luogo."

#: scenario7:scenario7_83BBBECD_3144_4476_8C30_E5D98FFBA6B1
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 63727d6cd17f052ef174ea3fe0c8f009abc795396582923bf6b9ae936531c54f
#. default-sha256: 9100c4839aa72eed6270c8167d5f0847fff77051a974d358e3cb41a1fb548b2f
msgctxt "scenario7:scenario7_83BBBECD_3144_4476_8C30_E5D98FFBA6B1"
msgid ""
"⟪k:0⟫I know how it feels to be locked up...⟪k:1⟫⟪k:2⟫to be tortured and used for others’ gain."
msgstr ""
"⟪k:0⟫So cosa si prova a venire imprigionati...⟪k:1⟫⟪k:2⟫torturati per l’interesse degli altri."

#: scenario7:scenario7_073CCD59_A5F1_4026_98A1_77E035B7B0DA
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 2e77cf633bd0b60ea3d271419f0d1a78e2ba24f98bcf017179c9fa46799a19d8
#. default-sha256: 5f82f644a8ec54048ce0790791a246a6970a263e20e58d49372b93a413e96baa
msgctxt "scenario7:scenario7_073CCD59_A5F1_4026_98A1_77E035B7B0DA"
msgid "⟪k:0⟫and I shall be the only one to have compassion for you."
msgstr "⟪k:0⟫e io sarò l’unica a provarne per te."

#: scenario7:scenario7_B32E596E_4255_43C7_A3F1_2A0BD187862D
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 4697c13e6cadd5666d0e3105e4c4eabd6b66946bfc87847fd04aef984ac7837c
#. default-sha256: 00a04fd3c79a864492a7b5d08b4223d761a3ce17f10c8a89969e3deb3b3724d8
msgctxt "scenario7:scenario7_B32E596E_4255_43C7_A3F1_2A0BD187862D"
msgid "⟪k:0⟫You were the only one to stay at my side..."
msgstr "⟪k:0⟫Sei l’unico che sia mai stato dalla mia parte..."

