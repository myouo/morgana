msgid "⟪k:0⟫⟪k:1⟫⟪k:2⟫Now, open the door, ⟪k:3⟫Michel."
msgstr "⟪k:0⟫⟪k:1⟫⟪k:2⟫Ora apri la porta, ⟪k:3⟫Michel."

#: scenario7:scenario7_8A86B1D0_BF72_47AB_BA59_0FE2F2EFE272
