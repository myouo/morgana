msgctxt "badend:badend_A8975700_5290_4EF8_8591_7B9B4986DDFA"
msgid ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫⟪k:4⟫⟪k:5⟫⟪k:6⟫⟪k:7⟫⟪k:8⟫⟪k:9⟫⟪k:10⟫⟪k:11⟫⟪k:12⟫⟪k:13⟫Master... ⟪k:14⟫Master."
msgstr ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫⟪k:4⟫⟪k:5⟫⟪k:6⟫⟪k:7⟫⟪k:8⟫⟪k:9⟫⟪k:10⟫⟪k:11⟫⟪k:12⟫⟪k:13⟫Padrone... ⟪k:14⟫"
"Padrone."

#: badend:badend_29D46658_3C72_4F60_8EBD_02064AC70CDB
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: c5d2e697216994adcd5254072f68513a861eead938388d5949f5b50f65801e0c
