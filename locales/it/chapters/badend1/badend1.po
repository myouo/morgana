#: badend:badend_74649044_6D3B_42E9_91BB_EC8BBFACE885
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: fbd29caeec657bdd04cfccf097e2d9424f5ab9c75ecf8d1660b5005cf0426d67
#. default-sha256: 3f502ff0993d34685951ab715d94603b7d88bbef57ef31c8761a68bc613c66c4
msgctxt "badend:badend_74649044_6D3B_42E9_91BB_EC8BBFACE885"
msgid "⟪k:0⟫Never again to look back upon the past ⟪k:1⟫You⟪k:2⟫he⟪k:3⟫ might have had,"
msgstr ""
"⟪k:0⟫Senza mai più voltar⟪k:1⟫ti⟪k:2⟫si⟪k:3⟫ indietro per guardare il passato che ⟪k:4⟫"
"avresti⟪k:5⟫avrebbe⟪k:6⟫ potuto avere,"

#: badend:badend_EAA90AAE_67A8_4496_8BA6_AE73C80B00D7
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 0ea25156faec70add43bfe3698ab2f145d37c06670ad1dc063f49d50f8a457c6
#. default-sha256: 4332de2c92b3378dfef8b84f72551fffcc6175a5d94fd066097fe72cf0fad292
msgctxt "badend:badend_EAA90AAE_67A8_4496_8BA6_AE73C80B00D7"
msgid "⟪k:0⟫the rare, treasured days of happiness,"
msgstr "⟪k:0⟫i rari e preziosi momenti di felicità,"

#: badend:badend_56C479A0_7DFD_4EE0_9FFF_322BDA18E0A2
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 912e203ac9a54589519e707316f7fde6101311fee145569d029b695d596bc85d
#. default-sha256: bc0357fed5a2840ad64934dce71cfbbf0fef8be8956f6c6098486201749a68b7
msgctxt "badend:badend_56C479A0_7DFD_4EE0_9FFF_322BDA18E0A2"
msgid "⟪k:0⟫or the bitter days filled with nothing but pain,"
msgstr "⟪k:0⟫le amare giornate ricolme di tristezza,"

#: badend:badend_0DC26A41_A3FA_4FCC_954D_84814ECB3595
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: df7a83cd6ce8f1b9aece82103e58816f7120681d3259999c09e6b2cd817f442d
#. default-sha256: 6626fa09bbae2ee2a56f3f3c8a00cbb3eaea44666e51bda60dfb3afa1b1a34d5
msgctxt "badend:badend_0DC26A41_A3FA_4FCC_954D_84814ECB3595"
msgid "⟪k:0⟫or the person ⟪k:1⟫You were⟪k:2⟫he was⟪k:3⟫ supposed to find."
msgstr "⟪k:0⟫o la persona che ⟪k:1⟫avresti⟪k:2⟫avrebbe⟪k:3⟫ dovuto trovare."

#: badend:badend_9597D371_8F16_48D8_B133_E897C5ABDA2F
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 384615045c2c3052544765844afd70c7e4e526ed449fa2c1a3f8e5a41999752b
#. default-sha256: d107333031066608cd5ef5093e61a97d9e034d7cddee49a9dc0f7a04eb6f62a2
msgctxt "badend:badend_9597D371_8F16_48D8_B133_E897C5ABDA2F"
msgid ""
"⟪k:0⟫But ⟪k:1⟫You were⟪k:2⟫he was⟪k:3⟫ fine with that. ⟪k:4⟫There was no one to criticize ⟪k:5⟫"
"You⟪k:6⟫him⟪k:7⟫ for averting ⟪k:8⟫Your⟪k:9⟫his⟪k:10⟫ eyes from ⟪k:11⟫Your⟪k:12⟫his⟪k:13⟫ pain "
"and seizing the opportunity for happiness lying before ⟪k:14⟫You⟪k:15⟫him⟪k:16⟫."
msgstr ""
"⟪k:0⟫Ma ⟪k:1⟫Ti⟪k:2⟫gli⟪k:3⟫ andava bene così.⟪k:4⟫ Non c’era nessuno a criticar⟪k:5⟫ti⟪k:6⟫"
"lo⟪k:7⟫ per aver distolto lo sguardo dal dolore e per aver colto l’occasione di ottenere⟪k:8⟫ "
"⟪k:9⟫⟪k:10⟫⟪k:11⟫la felicità."

#: badend:badend_3EDA9B4B_D931_44BE_B22D_1D681440EFE9
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: d61c12be4927f8d2a67e954f3d72b7ff1c57fa30c3b114a07ebd337b2e3a0d96
#. default-sha256: 81b5c33859545d4e207c89a09abdbe037ecdb7e5efa711ad3ef7b5aa8a442ad7
msgctxt "badend:badend_3EDA9B4B_D931_44BE_B22D_1D681440EFE9"
msgid "⟪k:0⟫⟪k:1⟫You⟪k:2⟫The Departed⟪k:3⟫ made the correct choice."
msgstr "⟪k:0⟫⟪k:1⟫Avevi fatto⟪k:2⟫Il Defunto aveva fatto⟪k:3⟫ la scelta giusta."

#: badend:badend_A8975700_5290_4EF8_8591_7B9B4986DDFA
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 0b7040f57b90c0b92f855d04e35e4994b20e987ab4123635cab6c9b723feb536
