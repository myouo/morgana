msgid "⟪k:0⟫⟪k:1⟫Huh?"
msgstr "⟪k:0⟫⟪k:1⟫Come?"

#: scenario:scenario_7C5FA92F_CDF5_4AC4_93ED_0D5A211356C9
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: a843dfc791394ab78ec98ea1936ab926e1fe4b43476b3926b1e80601993fb4e1
#. default-sha256: 1fcf1a5215a9d8d83ec3ce15ef4f22b822c39f482280286add8da89237f46328
