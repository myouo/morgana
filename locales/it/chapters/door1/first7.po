msgctxt "scenario:scenario_5EF1B95C_1B1B_463B_9ABE_95212015F172"
msgid "⟪k:0⟫and not a girl locked away in a house deep in the forest."
msgstr "⟪k:0⟫e non una ragazza rinchiusa in una casa nel profondo della foresta."

#: scenario:scenario_928C667F_86C1_4B66_ADEB_36C1B7B5ACE0
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: cf826be2edb15578b2317805ecf76cfb0842e2caa1b84df18701a3c3dcd5499f
