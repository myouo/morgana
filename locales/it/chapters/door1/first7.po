msgid "⟪k:0⟫⟪k:1⟫Lady Nellie’s prince...⟪k:2⟫⟪k:3⟫That’s you, Lord Mell, no?"
msgstr "⟪k:0⟫⟪k:1⟫Il principe di Lady Nellie...⟪k:2⟫ siete voi, Lord Mell, no?"

#: scenario:scenario_7F392ACC_5725_41B6_8231_FC52DBCC6A37
