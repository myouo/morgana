msgctxt "scenario:scenario_32F8D57D_8DD9_4FAF_9874_D376DAE271A4"
msgid "⟪k:0⟫And then— ⟪k:1⟫⟪k:2⟫Um, ⟪k:3⟫am I doing a good job?"
msgstr "⟪k:0⟫E poi— ⟪k:1⟫⟪k:2⟫Mmh, ⟪k:3⟫sto andando bene?"

#: scenario:scenario_422A6650_3D5B_48B1_88A6_1234A389EB1A
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 70220a2815a434bdd06094088a879ce67c5332c9bf19f0f38233dd7df31798fc
