msgid "⟪k:0⟫⟪k:1⟫⟪k:2⟫Hehe... ⟪k:3⟫A prince."
msgstr "⟪k:0⟫⟪k:1⟫⟪k:2⟫Hehe... ⟪k:3⟫Un principe."

#: scenario:scenario_97B3EB07_6300_4D7E_B357_55768B9D0C78
