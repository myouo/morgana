#: scenario:scenario_22DA36E8_B82A_485F_B079_E626A6377134
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 42bb704f0fb0a42df08bdd3cef24e506d4ae255b59ab9b85f21f4d10c33ab091
#. default-sha256: 6bf4eb80cdd5a5fabc2bb874676e8be32d4b64c8833d04aded5d41d86be80338
msgctxt "scenario:scenario_22DA36E8_B82A_485F_B079_E626A6377134"
msgid ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫⟪k:4⟫⟪k:5⟫⟪k:6⟫⟪k:7⟫⟪k:8⟫Ahaha!⟪k:9⟫Sorry, sorry.⟪k:10⟫I didn’t mean to scare "
"you."
msgstr ""
