msgctxt "scenario:scenario_56598AB9_8974_4EB1_91E2_584F878B7EFC"
msgid "⟪k:0⟫But she had no way of finding out."
msgstr "⟪k:0⟫e lei non avrebbe potuto saperlo."

#: scenario:scenario_F19D5998_9D81_4477_B7BC_5C48035A7549
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
