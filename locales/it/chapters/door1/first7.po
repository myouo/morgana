msgctxt "scenario:scenario_944EF2BA_DA9A_401C_A94E_33EF98DC569D"
msgid "⟪k:0⟫What do you think she did?"
msgstr "⟪k:0⟫Cosa pensate che abbia fatto?"

#: scenario:scenario_6BA85D26_61EC_4840_A811_4DC4ABA3B256
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: d86684578a5ef999e76d7ba3339fe2f2a1100d881635f365308a322bf375c67a
#. default-sha256: f957c0ed9aa88c3be0fa385f52fff4add17141b7a298a8feb17222d21773d366
msgctxt "scenario:scenario_6BA85D26_61EC_4840_A811_4DC4ABA3B256"
msgid "⟪k:0⟫Wrote a letter and agreed to meet him, right?"
msgstr "⟪k:0⟫Scrisse una lettera e accettò di incontrarlo, giusto?"

#: scenario:scenario_FE34D9F5_4D42_4880_AD4E_25D719C40481
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: bbd020390571e233b55d4b799dcbdac24035816fe22808fa7ee75bf4df45db9a
