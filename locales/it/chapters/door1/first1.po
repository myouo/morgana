msgid ""
"⟪k:0⟫Oh dear. Please don’t look at me like that.⟪k:1⟫⟪k:2⟫I admit I was being rather fanciful..."
msgstr ""
"⟪k:0⟫Suvvia, la prego, non mi guardi in quel modo.⟪k:1⟫⟪k:2⟫Ammetto di star fantasticando..."

#: scenario:scenario_577948E2_4A58_4B2B_9F9F_D1D1E5D12BF7
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
