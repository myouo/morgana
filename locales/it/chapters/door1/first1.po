msgctxt "scenario:scenario_7F307564_3320_4CED_BC5E_3668C2A6DAEF"
msgid "⟪k:0⟫It was, in fact, a Latin grammar textbook he was reading."
msgstr "⟪k:0⟫Quello che stava leggendo era infatti un manuale di grammatica latina."

#: scenario:scenario_F4B1DED2_F3CD_4A8D_8D86_709E45A055FC
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: e3b43c7fd08d92dfb8f8f2e2b1bfddbc0e2068ca71a041feb68399ae7585023b
