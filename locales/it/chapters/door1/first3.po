msgid "⟪k:0⟫⟪k:1⟫⟪k:2⟫So..."
msgstr "⟪k:0⟫⟪k:1⟫⟪k:2⟫Perciò..."

#: scenario:scenario_DC904213_B781_452D_8C21_8C1C3B23F535
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
