msgctxt "scenario:scenario_9CA98E5B_FDC5_47F2_9D98_05DBC6DD419A"
msgid "⟪k:0⟫Now, attend to your princess—⟪k:1⟫⟪k:2⟫as a proper prince should!"
msgstr "⟪k:0⟫Ora, occupati della tua principessa—⟪k:1⟫⟪k:2⟫come farebbe un vero principe!"

#: scenario:scenario_95405DAD_48F4_4D56_9E62_07306CB18DAD
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 672e3956904adbd54771ccf6813698d39e0cf2261abf1cc0ac2568c88372cddb
