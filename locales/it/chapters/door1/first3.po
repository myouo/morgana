msgid "⟪k:0⟫⟪k:1⟫(Whatever’s going on, I’ve been spared.)"
msgstr "⟪k:0⟫⟪k:1⟫(Qualunque cosa stia succedendo, sono stato risparmiato.)"

#: scenario:scenario_377154AA_0D86_4BAB_AD78_DA7FCE852038
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 1177f284abbd735cf77bdc334647778546d786169653ebf0664c60925f4167fd
