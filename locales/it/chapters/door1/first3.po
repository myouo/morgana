msgid "⟪k:0⟫⟪k:1⟫Huh? ⟪k:2⟫Why?!"
msgstr "⟪k:0⟫⟪k:1⟫Eh? ⟪k:2⟫E perché?!"

#: scenario:scenario_DCB893DC_6670_47A0_BD44_6606BE247DA5
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: cd388b6c0f782cad74592430b44370f37f288d0f78ea39d5af50df686894cefd
#. default-sha256: f6bd9ec41aa00652001cce82ff7928ef6508204b61813680539b45d0c0eb033e
msgctxt "scenario:scenario_DCB893DC_6670_47A0_BD44_6606BE247DA5"
msgid "⟪k:0⟫⟪k:1⟫Well, you know.⟪k:2⟫⟪k:3⟫You’re... ⟪k:4⟫about that age, Nellie."
msgstr "⟪k:0⟫⟪k:1⟫Beh, lo sai.⟪k:2⟫⟪k:3⟫Sei quasi arrivata... ⟪k:4⟫a quell’età, Nellie."

#: scenario:scenario_58E28F15_FFFB_40BB_8FD0_F0A7225EED44
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: d47f21d16c4c42205b41cb694c5cf458dbaddd7ef33a486bf7e09ca066c39615
#. default-sha256: 0c12db3c7c11ca330b0044f82bd8d1c0719306aca7a2880d344a66dfc8841775
msgctxt "scenario:scenario_58E28F15_FFFB_40BB_8FD0_F0A7225EED44"
msgid ""
"⟪k:0⟫We ⟪k:1⟫are⟪k:2⟫ a reasonably distinguished family,⟪k:3⟫so there are a number of different "
"houses⟪k:4⟫that would like to have connections with us."
msgstr ""
"⟪k:0⟫Siamo una famiglia molto rinomata, dopotutto,⟪k:1⟫per cui ci sono diverse altre famiglie che "
"vorrebbero instaurare⟪k:2⟫un legame con noi."

#: scenario:scenario_C5D088F7_7505_40FF_A12D_242ABC9EEE1F
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
