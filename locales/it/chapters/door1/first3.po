msgid "⟪k:0⟫Oh my. Why are you looking at me like that?"
msgstr "⟪k:0⟫Oh, perché mi sta guardando in quel modo?"

#: scenario:scenario_48093801_3D5C_41D9_BA88_48173D59E29F
