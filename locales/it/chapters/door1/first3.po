msgid "⟪k:0⟫⟪k:1⟫Exactly. So I can do what I want!"
msgstr "⟪k:0⟫⟪k:1⟫Esatto. Quindi posso fare quello che voglio!"

#: scenario:scenario_9CA98E5B_FDC5_47F2_9D98_05DBC6DD419A
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: b6cc6fb6fb782a1dd58c6df18dd5ed68a0a7900e283e430996030de9d1e691cb
