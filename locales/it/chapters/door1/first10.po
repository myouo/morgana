msgctxt "scenario:scenario_070A5629_127C_415C_921F_91DBC243E559"
msgid "⟪k:0⟫Why..."
msgstr "⟪k:0⟫Perché..."

#: scenario:scenario_1625EB1B_B585_41A7_BB40_9562B88F023E
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: d6890c9ce69c964caed31aec9669389c9a915b05de2095c6515dc78a506a2215
