msgctxt "scenario:scenario_7057D7E3_AA09_4B19_96B6_1163119CB401"
msgid "⟪k:0⟫On the night of the storm, I paid a visit to Rose Manor—⟪k:1⟫⟪k:2⟫⟪k:3⟫this mansion."
msgstr ""
"⟪k:0⟫Durante la notte della tempesta, ho fatto visita alla Villa delle Rose—⟪k:1⟫⟪k:2⟫⟪k:3⟫questa "
"casa."

#: scenario:scenario_3A9BA9CB_5CD3_4594_BF21_EF595EEBD26B
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 2c4d9399a51a252783708cfb3b8150452198d4904d8804df4610b614471833d8
