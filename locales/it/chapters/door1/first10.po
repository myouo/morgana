msgctxt "scenario:scenario_D249464A_BE14_4518_91CF_059F78DC12D7"
msgid "⟪k:0⟫I never anticipated what would happen next, though."
msgstr "⟪k:0⟫Ma non avrei mai potuto prevedere cosa sarebbe successo in seguito."

#: scenario:scenario_90179C8C_6056_4A52_8981_F23F01E6E6E0
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 89aa6ab98c3a181a25d3fb9229c92a8c4bc62937c4c534d80bf2a582b82ff2fe
