msgctxt "scenario:scenario_1625EB1B_B585_41A7_BB40_9562B88F023E"
msgid "⟪k:0⟫Why would you have me put the one I love through any more misery?"
msgstr "⟪k:0⟫Perché vorresti costringermi a far passare altre sofferenze a colei che amo?"

#: scenario:scenario_3FD5B254_A04B_4BD6_AA49_0636A49FEFE8
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
