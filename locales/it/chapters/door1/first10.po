msgctxt "scenario:scenario_D7A1F02F_2CD7_4697_A434_2F0479BE1C2C"
msgid ""
"⟪k:0⟫There are several reasons we couldn’t stay in one place.⟪k:1⟫⟪k:2⟫First... ⟪k:3⟫is my "
"unusual appearance."
msgstr ""
"⟪k:0⟫Ci sono diversi motivi per cui non potevamo rimanere in un posto.⟪k:1⟫⟪k:2⟫Il primo... ⟪k:3⟫"
"è il mio aspetto insolito."

#: scenario:scenario_2C9D2B32_97EA_4808_BDDA_26140DDEC0AF
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: f4e4aa8e7de7c25e012109695778344bf7deeb2377c31e1b6c877f86d508b230
#. default-sha256: ee0f510d8214d3547bbd7bacd4c155ec97979839d892168e4fa000f358c30384
msgctxt "scenario:scenario_2C9D2B32_97EA_4808_BDDA_26140DDEC0AF"
msgid "⟪k:0⟫People often find the color of my skin or eyes disconcerting."
msgstr "⟪k:0⟫Le persone spesso trovano sconcertanti il colore della mia pelle e dei miei occhi."

#: scenario:scenario_0428C509_3AD5_41EF_A5FB_CC73F0B3390B
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 4389f07725c0d43360bf28fe8a2097841dc09a90aa307ec00b3dfd91feee6ea4
