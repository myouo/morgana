msgctxt "scenario:scenario_575B60BC_BB37_4475_8BA8_6814A80488A9"
msgid "⟪k:0⟫We were birds that migrated without a flock."
msgstr "⟪k:0⟫Eravamo uccelli che migravano senza uno stormo."

#: scenario:scenario_4A09487B_5B8F_4949_B006_58FCF7D98D50
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 9074b141b1645e2758fe9c594bf21f05c61a059dabc72e3e6fd06dbbf72d8f42
