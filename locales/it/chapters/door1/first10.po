msgctxt "scenario:scenario_480EC6D3_51C4_47F4_8798_38493C5712CC"
msgid "⟪k:0⟫And that’s... ⟪k:1⟫why you tried to kill me."
msgstr "⟪k:0⟫Ed è per questo... ⟪k:1⟫che hai tentato di uccidermi..."

#: scenario:scenario_3FC565AD_D74E_4DD5_9DB3_30143B74377F
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: a44bf1b698731c12ab5fee847c88c1598bb98e2fa9b94f3e116d7d86526a308b
