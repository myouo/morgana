msgid "⟪k:0⟫⟪k:1⟫⟪k:2⟫White hair..."
msgstr "⟪k:0⟫⟪k:1⟫⟪k:2⟫Capelli bianchi..."

#: scenario:scenario_D6BAECE4_A19C_44BC_B1B5_A46C88E29EF7
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: bbc65918f49ce230499ed621478fe7a0dffe31915fa8e8dda1433a5810f45484
