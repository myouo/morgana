msgid "⟪k:0⟫⟪k:1⟫You didn’t go out on the town last night, did you?⟪k:2⟫⟪k:3⟫Naughty, naughty boy!"
msgstr "⟪k:0⟫⟪k:1⟫Non sarai mica andato in città la scorsa notte?⟪k:2⟫⟪k:3⟫Che monello!"

#: scenario:scenario_609C8D22_CE50_408B_A655_66B38E4DEA40
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 9ab06064456aa3d977e817dba6c73f17176b0a9a27e9f176547f9537186970f3
