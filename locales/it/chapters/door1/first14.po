msgid "⟪k:0⟫Why..."
msgstr "⟪k:0⟫Perché..."

#: scenario:scenario_6ED4B62B_E12E_4D5B_8D73_7EE2BC667616
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 37b27314853ca463d249ae5907fff95f98f3d260b7fdce100dbf1ef29a912442
#. default-sha256: dacb63a8380a65444314af2455f8f1067c4e4cb7620a380df0f6c070f8cb1e78
msgctxt "scenario:scenario_6ED4B62B_E12E_4D5B_8D73_7EE2BC667616"
msgid ""
"⟪k:0⟫Why won’t anyone tell me the truth?⟪k:1⟫⟪k:2⟫All I want... ⟪k:3⟫All I want is for someone to "
"tell me it’s not true!"
msgstr ""
"⟪k:0⟫Perché nessuno vuole dirmi la verità?⟪k:1⟫⟪k:2⟫Quello che voglio... ⟪k:3⟫è che qualcuno mi "
"dica che tutto questo non è vero!"

#: scenario:scenario_C00DCF2D_6774_43CE_9214_83D0559ACD6E
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: db1ce6ea47d9522ed58332589df3d859c06c6ebfa9486aa30be76758e1f07375
#. default-sha256: 2a6fa904d6ac9fea0a084021c997f84cc17d725488c63ea214c6aa061c36cb21
msgctxt "scenario:scenario_C00DCF2D_6774_43CE_9214_83D0559ACD6E"
msgid "⟪k:0⟫Have I sinned?!⟪k:1⟫⟪k:2⟫No, I didn’t know anything!⟪k:3⟫⟪k:4⟫I didn’t know—"
msgstr "⟪k:0⟫Ho forse peccato?!⟪k:1⟫⟪k:2⟫No, io non sapevo nulla!⟪k:3⟫⟪k:4⟫Io non sapevo—"

#: scenario:scenario_7676B9E7_B6A6_4D27_9D66_080D85ADA4E2
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 9623ba04c5cde2992a07248016bf4bbe7b799ae40e1d325e10293fd0015d6424
#. default-sha256: d231d285a910a9eb06cb8cb7a8710e380fc0d162d04ffe2b41c49f182c29239f
msgctxt "scenario:scenario_7676B9E7_B6A6_4D27_9D66_080D85ADA4E2"
msgid ""
"⟪k:0⟫No... ⟪k:1⟫No... ⟪k:2⟫None of it’s true...⟪k:3⟫⟪k:4⟫So I... ⟪k:5⟫I haven’t done anything "
"wrong..."
msgstr ""
"⟪k:0⟫No... ⟪k:1⟫No... ⟪k:2⟫Niente di tutto quello che ha detto è vero...⟪k:3⟫⟪k:4⟫Dunque io... "
"⟪k:5⟫non ho fatto nulla di sbagliato..."

#: scenario:scenario_7679B9E7_B6A6_4D27_9D66_080D85ADA4E2
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 947f761e4b7a558dde519a64db0c937c92de834d23fb1ca7063c2fb58db037d7
#. default-sha256: 25e64464b72470b201a85d5d583f375efaaa5aa7e7dd95b9ba6870830b368564
msgctxt "scenario:scenario_7679B9E7_B6A6_4D27_9D66_080D85ADA4E2"
msgid "⟪k:0⟫I am not at fault! ⟪k:1⟫Am I?!"
msgstr "⟪k:0⟫Non è colpa mia! ⟪k:1⟫Giusto?!"

#: scenario:scenario_88552BA7_3E5E_486A_A919_653A6E6E2460
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
