#: scenario:scenario_76414AD9_CBC2_4E2D_9A48_5BD226AF7166
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 27f1626a0557102135b6c61355c8b46fc66f8eb6b966c0028386f0b6e92fce24
#. default-sha256: cd7ea83bc9b2846fa5f809f6bff44ea8507ed31b6535ea6f8805ec9642d09117
msgctxt "scenario:scenario_76414AD9_CBC2_4E2D_9A48_5BD226AF7166"
msgid ""
"⟪k:0⟫In a fevered frenzy, Mell fled from the mansion. ⟪k:1⟫Even in early summer, the night was "
"cold."
msgstr ""
"⟪k:0⟫Preso da una febbrile frenesia, Mell fuggì dalla villa.⟪k:1⟫⟪k:2⟫La notte era fredda anche "
"all’inizio dell’estate."

#: scenario:scenario_6801AEDC_0747_46BB_8CFE_962228550A8F
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: bc146d5f5febe82a23178a3c300579f515866173af5666be942ab604640828be
#. default-sha256: 3b593f9b56e5037bd332b586e3a36adde275216021905da0488b47d68a8fb28d
msgctxt "scenario:scenario_6801AEDC_0747_46BB_8CFE_962228550A8F"
msgid "⟪k:0⟫And to make matters worse, raindrops pelted him from head to toe."
msgstr "⟪k:0⟫E come se non bastasse, le gocce di pioggia lo colpivano dalla testa⟪k:1⟫ai piedi."

#: scenario:scenario_CCA9673A_482B_43E1_A63C_1E2C96681A1F
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 455e2e2da4d2932753750444df3a40fed1b054aa3efcc2b1ebff9c38eb8ca1ea
#. default-sha256: 8a1335fea787065301debab867c046402b6580e31f55ba4e7862d6a6719d1382
msgctxt "scenario:scenario_CCA9673A_482B_43E1_A63C_1E2C96681A1F"
msgid ""
"⟪k:0⟫But that caused him little discomfort, for a far greater maelstrom of pain rampaged within "
"his breast."
msgstr ""
"⟪k:0⟫Ma ciò gli arrecava ben poco disturbo, se paragonato al vortice di dolore che si era "
"scatenato nel suo petto."

#: scenario:scenario_140790A3_031E_46EE_A5A9_C09D5D593EE8
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 815d8210578bfe7a2d662f468e71b1d5f6b51703ae21452d239f4c84ad49514c
#. default-sha256: ba9b4b4d86d45837dbbbdfad6da2f88a932732d57510347fa159476726f2dfa5
msgctxt "scenario:scenario_140790A3_031E_46EE_A5A9_C09D5D593EE8"
msgid ""
"⟪k:0⟫At night, the town took on a different appearance. ⟪k:1⟫Not simply for lack of illumination, "
"but the people active within it as well."
msgstr ""
"⟪k:0⟫Di notte, la città assumeva un aspetto diverso.⟪k:1⟫⟪k:2⟫Non solo per la mancanza di "
"illuminazione, ma anche per le poche persone in circolazione."

#: scenario:scenario_5678B376_21F6_4AA4_B7F2_5DAE02514F57
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: f05a6fadeea9eac177ac47d5db364e6c17789a864d9389368cc8acbcdcf7c988
#. default-sha256: cc620d40dc234946f9b9ffa3ea2bd6b6be394c550a66d45db5c2e7b45a91ce33
msgctxt "scenario:scenario_5678B376_21F6_4AA4_B7F2_5DAE02514F57"
msgid "⟪k:0⟫It was not a suitable place for a young aristocratic man to go wandering unattended."
msgstr ""
"⟪k:0⟫Non era il posto adatto dove un giovane aristocratico potesse vagare senza accompagnatori."

#: scenario:scenario_320635AE_966E_4446_B2EE_B0BF550649BD
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 217bb69f5aa94c056a2d122df4cd317deedcd421af6d77b67e4c4bb7de0c07ff
#. default-sha256: 45f73bf23819e02e4eac43b5e95c136fa8a8e49baaaa00f6c6140d5cd9c4126f
msgctxt "scenario:scenario_320635AE_966E_4446_B2EE_B0BF550649BD"
msgid ""
"⟪k:0⟫The darkness is not only the abode of devils, but of beggars, thieves, criminals, and all "
"manner of things undesirable."
msgstr ""
"⟪k:0⟫L’oscurità non è la dimora dei soli diavoli, ma anche di mendicanti, ladri, criminali e ogni "
"genere di persone indesiderate."

#: scenario:scenario_CE475EBF_25A7_4D0A_8CA6_D1F696B6A135
