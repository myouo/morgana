msgstr "⟪k:0⟫...!"

#: scenario:scenario_7C893E1F_346E_4C9F_B42E_D76879C2965A
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 991e52d1164cb8011b81d45e0d2bdf14ac9ca9271792edd4e3f05faaefac8509
#. default-sha256: 29008bee65008efcf3e0fc73d5180b31de1dade31a1a2a8bd82a7e11b1fd1437
msgctxt "scenario:scenario_7C893E1F_346E_4C9F_B42E_D76879C2965A"
msgid "⟪k:0⟫But despite that, he continued to run, knowing not where he was to head."
msgstr "⟪k:0⟫Ma nonostante questo, Mell continuò a correre, non sapendo dove fosse diretto."

#: scenario:scenario_7007E2B4_607A_4FF5_8C31_8FF521D1D873
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: a06ce8d852aee0a699be9865ebeee504b6d4b7df8b9ca0163460ea2d52770fb3
