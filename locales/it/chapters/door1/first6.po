msgctxt "scenario:scenario_FA7DB5A1_352F_468E_9A39_B7387CAAB96F"
msgid "⟪k:0⟫In Mell’s eyes, it was as if they were all blessed by a divine light."
msgstr "⟪k:0⟫Agli occhi di Mell, era come se fossero stati tutti benedetti da una luce divina."

#: scenario:scenario_AE1E57CA_ADA2_41A2_9FDA_4F514E42DF20
