#: scenario:scenario_3889ECE8_14D0_4B02_A043_8975F3066FAB
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: de685b174253e9f64854fa262cd5b0913b6db2151d9f4f2da65c41e2b78dc722
#. default-sha256: 5825e1f557e9bc627969aba9ce872eb74de8667fa192be5254b45a6ebc8ff7bd
msgctxt "scenario:scenario_3889ECE8_14D0_4B02_A043_8975F3066FAB"
msgid ""
"⟪k:0⟫However, not everyone living in the same land was equally blessed.⟪k:1⟫⟪k:2⟫In fact, the "
"blessed were far outnumbered by the forsaken."
msgstr ""
"⟪k:0⟫Ma non tutti coloro che vivevano nella stessa terra erano stati ugualmente benedetti.⟪k:1⟫ "
"Anzi, i beati erano molto meno numerosi⟪k:2⟫dei dimenticati."

#: scenario:scenario_23A7B9C7_8346_49FC_924B_A63FB403D755
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 0f40ae6e942ed6134037d986af1fededc1ab33c69459aedc3b0380ef8d35cbca
#. default-sha256: cd4fcf537e4ff4d3bbf2907054ae5a7cf084fbc1b1f3fc3fff3a3a614ba216db
msgctxt "scenario:scenario_23A7B9C7_8346_49FC_924B_A63FB403D755"
msgid "⟪k:0⟫Even if their time would later come to be referred to as the Golden Age."
msgstr "⟪k:0⟫Per quanto la loro epoca sarebbe stata poi chiamata “Età dell’Oro”..."

#: scenario:scenario_EEE16001_D1BD_49B4_B1F4_222398717037
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 7d3d55247afbc2b53004be31d18906078094fd650284e4c251d67589ac660241
