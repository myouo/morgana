#: scenario:scenario_B85E47A8_2A5C_4EAB_B10B_A58D1633E893
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: d8776adbec9be2e77ed1c39e17f8e82e3c29c322ed93638f5e535013cdefc802
#. default-sha256: a8b0cae2071e44ef92395109268c451041065935825250d050a6e89959e75bec
msgctxt "scenario:scenario_B85E47A8_2A5C_4EAB_B10B_A58D1633E893"
msgid ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫⟪k:4⟫⟪k:5⟫⟪k:6⟫⟪k:7⟫⟪k:8⟫⟪k:9⟫⟪k:10⟫⟪k:11⟫⟪k:12⟫⟪k:13⟫⟪k:14⟫⟪k:15⟫⟪k:16⟫⟪k:17⟫"
"⟪k:18⟫⟪k:19⟫⟪k:20⟫⟪k:21⟫⟪k:22⟫⟪k:23⟫⟪k:24⟫⟪k:25⟫⟪k:26⟫⟪k:27⟫⟪k:28⟫⟪k:29⟫⟪k:30⟫⟪k:31⟫⟪k:32⟫⟪k:33⟫"
"⟪k:34⟫Slowly but surely, time trekked onward, everyone working toward their own individual goals."
msgstr ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫⟪k:4⟫⟪k:5⟫⟪k:6⟫⟪k:7⟫⟪k:8⟫⟪k:9⟫⟪k:10⟫⟪k:11⟫⟪k:12⟫⟪k:13⟫⟪k:14⟫⟪k:15⟫⟪k:16⟫⟪k:17⟫"
"⟪k:18⟫⟪k:19⟫⟪k:20⟫⟪k:21⟫⟪k:22⟫⟪k:23⟫⟪k:24⟫⟪k:25⟫⟪k:26⟫⟪k:27⟫⟪k:28⟫⟪k:29⟫⟪k:30⟫⟪k:31⟫⟪k:32⟫⟪k:33⟫"
"⟪k:34⟫Il tempo scorreva, lento ma inesorabile, e ognuno era impegnato a perseguire i propri "
"obiettivi."

#: scenario:scenario_D2036877_CB64_4A97_8B0F_4D65C53B3156
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 353f4e624cf8d50e4f5fcd57541a5a27ef971bb67e1cfc6c1e71bb1ee4804823
#. default-sha256: 01b0f7ef904b14dc1ce6b0b0ce7abf327c21aac6a5ad96efe3c0b20b823b31bd
msgctxt "scenario:scenario_D2036877_CB64_4A97_8B0F_4D65C53B3156"
msgid ""
"⟪k:0⟫Each early-summer breeze that blew through the garden was like God’s hallowed breath "
"carrying the flowers’ fragrance in through Rose Manor’s windows."
msgstr ""
"⟪k:0⟫La brezza di prima estate che soffiava attraverso il giardino era come⟪k:1⟫il respiro sacro "
"di Dio, che portava con sé la fragranza dei fiori,⟪k:2⟫diffondendola in ogni stanza della villa."

#: scenario:scenario_9A4DE7BB_0C12_411E_AE8C_2E488320BDE2
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 3c41b5af44d050d4fc5b9cb1d9400c0afc2fec81a6d3b492f23f0672b051ab11
#. default-sha256: f37b9427ecea44ce32defbf6de635ae19f882b2c4d67d35e2a046028503e3c82
msgctxt "scenario:scenario_9A4DE7BB_0C12_411E_AE8C_2E488320BDE2"
msgid "⟪k:0⟫If only time could be stopped, and this beautiful era made to live on through eternity."
msgstr ""
"⟪k:0⟫Se solo il tempo potesse essere fermato, permettendo a quella splendida epoca di "
"sopravvivere per l’eternità..."

#: scenario:scenario_C8801846_7252_4B91_84FD_916BE74A68A7
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 7981a7ff74a7431aaf56da1abc0ad90ff6e2adf8fe685442e0bf8bd83044d0d8
#. default-sha256: 372ca3de934689f8aa07538adce1b4c121742e4549b3d73103749386d597ad55
msgctxt "scenario:scenario_C8801846_7252_4B91_84FD_916BE74A68A7"
msgid ""
"⟪k:0⟫As usual, Mell’s eyes chased after the White-Haired Girl, and Nellie pursed her lips in "
"frustration at him. ⟪k:1⟫But she was still rather docile."
msgstr ""
"⟪k:0⟫Come al solito, gli occhi di Mell rincorrevano la Ragazza dai Capelli Bianchi, e Nellie "
"contraeva le labbra per la frustrazione.⟪k:1⟫⟪k:2⟫Ma rimaneva comunque piuttosto docile."

#: scenario:scenario_413EE96A_C6D7_4B31_8421_5DE9B5B6592E
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 5bf609e6f064c8718aac9ae927b8d924a546b901082280ef7409b48235cffc23
#. default-sha256: a1440e2a178b017913e5d8fb53880f9e5f6b6bb48387faa61e6fddd0bd9ea1e8
msgctxt "scenario:scenario_413EE96A_C6D7_4B31_8421_5DE9B5B6592E"
msgid ""
"⟪k:0⟫Even taking into account how self-centered she behaved, how fickle her temper, Nellie’s fits "
"were still no worse than a playful kitten."
msgstr ""
"⟪k:0⟫Anche tenendo conto di quanto fosse egocentrico il suo comportamento, e di quanto fosse "
"mutevole la sua rabbia,⟪k:1⟫gli attacchi di Nellie non erano peggiori di quelli di un gattino "
"giocoso."

#: scenario:scenario_5D308507_DC8D_4784_9099_C7E5E1924E30
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: f6884a0681d59fd654ce1357c26522f3f74cf7d33626a3f9c130e65f07b1aac8
#. default-sha256: 7dc833f0b1276fded1c03a4f4b83976ebb69ceac7aea29d5bf3554f1bf4ce568
msgctxt "scenario:scenario_5D308507_DC8D_4784_9099_C7E5E1924E30"
msgid ""
"⟪k:0⟫See? At that very moment, our lively little feline had her claws poised to swat at the "
"flaxen-haired young man."
msgstr ""
"⟪k:0⟫Come può vedere, in quel preciso istante, il nostro vivace, piccolo felino aveva gli artigli "
"serrati, pronti per assalire il giovane dai capelli biondi."

#: scenario:scenario_FD95A642_51F8_40B0_8FBA_93F6CCA6FA16
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 6190eb101b53e677b83afe964a78084601e13444332c436de3bd63e17d8553c1
#. default-sha256: 95e2dfc39cf1a46b74c932911135405b3240cb7c0ca11eda004bb8ff66af9d17
msgctxt "scenario:scenario_FD95A642_51F8_40B0_8FBA_93F6CCA6FA16"
msgid "⟪k:0⟫Hehehe."
msgstr "⟪k:0⟫Hehehe."

#: scenario:scenario_DBE9B976_12DB_4DBB_8E83_7FC83F259946
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 6a1de905f47a1cf097c42e43f681e884f16b3a192aed6316604823b2e16cf398
#. default-sha256: 550157bc12bb594682ecc8e6b91d9e67429981a163b78197a181d3e9b09c90d0
msgctxt "scenario:scenario_DBE9B976_12DB_4DBB_8E83_7FC83F259946"
msgid ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫⟪k:4⟫⟪k:5⟫⟪k:6⟫⟪k:7⟫⟪k:8⟫Mell!⟪k:9⟫You promised me!⟪k:10⟫Or have you "
"forgotten?!"
msgstr ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫⟪k:4⟫⟪k:5⟫⟪k:6⟫⟪k:7⟫⟪k:8⟫Mell!⟪k:9⟫Me l’avevi promesso!⟪k:10⟫Te ne sei "
"dimenticato?!"

#: scenario:scenario_DD3F9AE7_91E2_400A_8840_9D8ED4C66C53
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 05f0aafff7338c907d022c06094ea6f6f015a0df0f2d8a5e0077f393b88ff6f4
#. default-sha256: cac3262d5c4135d9548a9ebcbcd1769a4a80e3d13167422531c2f7b8bf864d5d
msgctxt "scenario:scenario_DD3F9AE7_91E2_400A_8840_9D8ED4C66C53"
msgid "⟪k:0⟫⟪k:1⟫⟪k:2⟫I haven’t forgotten, I’m just asking if we can go another day."
msgstr ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫Non l’ho dimenticato, ti sto solo chiedendo se possiamo andarci⟪k:3⟫un altro "
"giorno."

#: scenario:scenario_DB64EEF5_3153_4721_80BE_6A8D3C452F51
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 9603752091be98ff2a0f3c588058be1b04bb169d97080a61e1cab9de7c014f40
#. default-sha256: a2c3e5b602042260f31a3d7c53c8dbe0482e39af366fbbe1b18a04521f2615be
msgctxt "scenario:scenario_DB64EEF5_3153_4721_80BE_6A8D3C452F51"
msgid ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫Another day?⟪k:3⟫ This isn’t something that happens every day!⟪k:4⟫⟪k:5⟫I’ve been "
"looking forward to tonight’s performance for so long."
msgstr ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫Un altro giorno?⟪k:3⟫ Non è qualcosa che si può vedere tutti i giorni!⟪k:4⟫⟪k:5⟫Ho "
"atteso lo spettacolo di stasera per un sacco di tempo."

#: scenario:scenario_64CBF9EE_F404_48E3_BA36_662BC330EF22
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: c6560bd0d84338a3e1bdc98b777a3727cbdb2f990649b723818475c9c110065b
#. default-sha256: 5288b479657ce2ac298091e5c0b59ccca1108e8a218d06b69819d2d0ee627683
msgctxt "scenario:scenario_64CBF9EE_F404_48E3_BA36_662BC330EF22"
msgid ""
"⟪k:0⟫⟪k:1⟫There’s nothing I can do about that. We’re having a gathering at the priest’s home "
"tonight. ⟪k:2⟫Several high-ranking officials have come up from the mainland just for this."
msgstr ""
"⟪k:0⟫⟪k:1⟫Non posso farci niente. Abbiamo un raduno a casa del parroco stasera. ⟪k:2⟫Diversi "
"funzionari di alto rango sono venuti dalla terraferma solo per questo."

#: scenario:scenario_A4ED2DE1_002E_4D59_91D2_FDE757FC6D54
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 43df5cc6c0a20cc020a811cff62012d80a922b82fc23e6c49c3f725cea9f32d9
#. default-sha256: 0593f0d5d7b015da42e41b7e175ababe4ae69f4431dcd7d8a3e4c0a8ea0ba208
msgctxt "scenario:scenario_A4ED2DE1_002E_4D59_91D2_FDE757FC6D54"
msgid "⟪k:0⟫⟪k:1⟫⟪k:2⟫Who cares?!"
msgstr "⟪k:0⟫⟪k:1⟫⟪k:2⟫E chi se ne importa?!"

#: scenario:scenario_2ECAF814_92B5_4FCA_9A2C_BA4FE44F2586
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: cc08a48982cc61634e82c2586c66fe7bba819c9a1bbdb550ee15f074b4dcb402
#. default-sha256: 0d276851c3ef6b47b076d9d41283b979ac2edfa93effdab5c7d1ef4cdf8bfef4
msgctxt "scenario:scenario_2ECAF814_92B5_4FCA_9A2C_BA4FE44F2586"
msgid ""
"⟪k:0⟫⟪k:1⟫I-⟪k:2⟫I care...⟪k:3⟫⟪k:4⟫You know, Nellie... ⟪k:5⟫it doesn’t ⟪k:6⟫have⟪k:7⟫ to be me "
"who goes with you."
msgstr ""
"⟪k:0⟫⟪k:1⟫A me importa.⟪k:2⟫⟪k:3⟫Sai, Nellie... ⟪k:4⟫non devo essere per forza ⟪k:5⟫io⟪k:6⟫ a "
"venire con te."

#: scenario:scenario_01CE9B15_4BDF_445A_B799_9227D376C28C
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 9cd9160c5e4580e212d770ff0b01b1e42068c4509f23b0ea8bb0d47a13e96715
#. default-sha256: 524e5d222971eff22fb0c8f0817832427a2040c95debb8bdb862c6019ed7b19f
msgctxt "scenario:scenario_01CE9B15_4BDF_445A_B799_9227D376C28C"
msgid "⟪k:0⟫⟪k:1⟫No! I want to go with you, Mell!"
msgstr "⟪k:0⟫⟪k:1⟫No! Voglio andarci con te, Mell!"

#: scenario:scenario_C8F83018_7993_4DEB_87D4_A32FD1F60C4A
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 4633d7074f389c1686ff476e7f24460b4665e3b5bfe7e9fc833d1511d36fb988
#. default-sha256: 7fccbd54c51d2a1dd6fd57b07ec81c8c9b34e1793e7e8717112e7d4a89abf641
msgctxt "scenario:scenario_C8F83018_7993_4DEB_87D4_A32FD1F60C4A"
msgid ""
"⟪k:0⟫⟪k:1⟫You’ve been so distant lately, dearest Mell.⟪k:2⟫⟪k:3⟫You refuse to do anything with "
"me..."
msgstr ""
"⟪k:0⟫⟪k:1⟫Sei così distante ultimamente, caro Mell.⟪k:2⟫⟪k:3⟫Ti rifiuti di fare qualunque cosa "
"insieme a me..."

#: scenario:scenario_1B36894A_FFC7_4F9A_B2F9_50D0F1E37722
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 34d240846bb509461c96e76b8b4f4b85886324296d4ffb2e97bd028a0dfeff9c
#. default-sha256: 18fff6ec3c553ffd41f1f27583ef859842c25c917a97ff865117b9d646adf114
msgctxt "scenario:scenario_1B36894A_FFC7_4F9A_B2F9_50D0F1E37722"
msgid "⟪k:0⟫⟪k:1⟫That’s not true."
msgstr "⟪k:0⟫⟪k:1⟫Non è vero."

#: scenario:scenario_0B4E29E2_F75F_4C33_B0C7_FB7A63F16B56
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 049e729376f4bf0faabab522b98f8ab728a462b1c74aa11abb6eeb8ab9506c48
#. default-sha256: 8a146804746c31a6fd8504717e7d882cb5c2d86dbb839c1f3c18889da0154aa4
msgctxt "scenario:scenario_0B4E29E2_F75F_4C33_B0C7_FB7A63F16B56"
msgid ""
"⟪k:0⟫⟪k:1⟫Tell me—⟪k:2⟫⟪k:3⟫if you can’t go today, when ⟪k:4⟫can⟪k:5⟫ you?⟪k:6⟫⟪k:7⟫When will you "
"be willing to go out with me?"
msgstr ""
"⟪k:0⟫⟪k:1⟫Dimmi—⟪k:2⟫⟪k:3⟫se non oggi, ⟪k:4⟫quand’è⟪k:5⟫ che potrai venire?⟪k:6⟫⟪k:7⟫Quando sarai "
"disposto a uscire con me?"

#: scenario:scenario_4C33E21F_95D7_4D67_A60C_4A7B5FA336B8
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 46dd544e1a0902b1ee6ad401f462ea7a9c8954999737c17e8d43c48b4bc18c6e
#. default-sha256: a2ba02755ed7ad6aa41eedb8290ba12175b1852ec0bb3d75f4d884a4e7cfc681
msgctxt "scenario:scenario_4C33E21F_95D7_4D67_A60C_4A7B5FA336B8"
msgid "⟪k:0⟫When will you be willing to play cards with me?⟪k:1⟫To have tea together?"
msgstr "⟪k:0⟫Quando sarai disposto a giocare a carte con me?⟪k:1⟫O a prendere il tè insieme?"

#: scenario:scenario_9385E4E7_E567_4872_B6EA_244B62C0B2D2
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: b1f3a2f198421a41c058e9f33cd6ecb15d831277f05d221df98c1b3ebff18438
#. default-sha256: c23347961f0a935626787da92464b30391101b87dbe232fc9fe28a5b2eb2b115
msgctxt "scenario:scenario_9385E4E7_E567_4872_B6EA_244B62C0B2D2"
msgid ""
"⟪k:0⟫⟪k:1⟫I... ⟪k:2⟫can’t make any promises.⟪k:3⟫⟪k:4⟫I have things to do—⟪k:5⟫⟪k:6⟫obligations."
"⟪k:7⟫⟪k:8⟫And Nellie, you’re almost an adult yourself."
msgstr ""
"⟪k:0⟫⟪k:1⟫Non... ⟪k:2⟫Non posso prometterti nulla.⟪k:3⟫⟪k:4⟫Ho delle cose da fare—⟪k:5⟫⟪k:6⟫ho "
"degli obblighi.⟪k:7⟫⟪k:8⟫E Nellie, ormai sei un’adulta anche tu."

#: scenario:scenario_A39F153A_73C7_459B_B747_63D03965ADA6
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: e729afaf010bf8956fa350f28db652e781a0f2e1b6bb46eae28f11d42907bc27
#. default-sha256: e1cd3ff5add28c910b2cba1a963268dac4d22bbc9bec1adcb5925e5e35889090
msgctxt "scenario:scenario_A39F153A_73C7_459B_B747_63D03965ADA6"
msgid "⟪k:0⟫Stop acting like such a child."
msgstr "⟪k:0⟫Smettila di comportarti come una bambina."

#: scenario:scenario_353CAC4C_8617_486B_855D_4297A1FFF2F9
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: d341236ff11155e8decb9a1c2082fc5867464704cf8bed48b7bf2b100773de96
#. default-sha256: dba022f0c0f39bf45c4fefd17e51de3072b7fe6aef5ebbc524ece749c95eb70a
msgctxt "scenario:scenario_353CAC4C_8617_486B_855D_4297A1FFF2F9"
msgid "⟪k:0⟫⟪k:1⟫I’m not an adult yet!⟪k:2⟫I’m still a kid!"
msgstr "⟪k:0⟫⟪k:1⟫Non sono un’adulta!⟪k:2⟫Sono ancora una bambina!"

#: scenario:scenario_37C57A29_53DC_4562_B66A_6A46209983BF
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 7835bfb3d16df10eb354d0f4eb81083ca39aa7f10f83b708b517ba1652f5a432
#. default-sha256: 5c745cd639c635ae43c1ef454eb1712c912ba6a283ec53422eab3e668e07f3a5
msgctxt "scenario:scenario_37C57A29_53DC_4562_B66A_6A46209983BF"
msgid ""
"⟪k:0⟫⟪k:1⟫If it means I don’t get to play with you anymore,⟪k:2⟫dearest Mell, then I don’t ⟪k:3⟫"
"want⟪k:4⟫ to be an adult!"
msgstr ""
"⟪k:0⟫⟪k:1⟫Se diventare adulta significa che non potrò mai più giocare con te,⟪k:2⟫caro Mell, "
"allora non lo voglio ⟪k:3⟫affatto⟪k:4⟫!"

#: scenario:scenario_C6699785_C044_4576_A771_11C8207F6A24
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 569048c84f0640455217d48ceba7ea1c357d66106461ef5ad549238495450894
#. default-sha256: 145330457339822994db2e86b5e074725667601d9db2feb6bcdd7cc64e203ef3
msgctxt "scenario:scenario_C6699785_C044_4576_A771_11C8207F6A24"
msgid "⟪k:0⟫⟪k:1⟫Nellie, you can’t—"
msgstr "⟪k:0⟫⟪k:1⟫Nellie, non puoi—"

