msgid "⟪k:0⟫⟪k:1⟫...?"
msgstr "⟪k:0⟫⟪k:1⟫...?"

#: scenario6:scenario6_16E316EF_B176_4919_8842_25639A4FFD25
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 3b6dad1c015c0bfecbefb694f3f3239fa3440a63b46d2ded91b19d4edc0c41b9
#. default-sha256: 0da9bb79f6caae3d341158d17f4a6ea2457441a0906b2c025d2ecb1a29e8f270
msgctxt "scenario6:scenario6_16E316EF_B176_4919_8842_25639A4FFD25"
msgid ""
"⟪k:0⟫⟪k:1⟫Hey, get out here!⟪k:2⟫⟪k:3⟫Christ, there’s not a goddamned confident bone in your "
"body, is there?"
msgstr "⟪k:0⟫⟪k:1⟫Ehi, vieni fuori!⟪k:2⟫⟪k:3⟫Cristo santo, hai le gambe per muoverti o cosa?"

#: scenario6:scenario6_14684D65_8FA9_4010_953A_C2D2C8D024EC
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 9f4708af023a66dec2d1e96a463961a5e9f7fd1169db7cd8a1e27c9c12c9627a
#. default-sha256: 08a83a40cf915ee5bcccecd5e8a8cc0b4a875375ced339f94f74385197cb9297
msgctxt "scenario6:scenario6_14684D65_8FA9_4010_953A_C2D2C8D024EC"
msgid "⟪k:0⟫⟪k:1⟫⟪k:2⟫Ah, ⟪k:3⟫I-⟪k:4⟫I’m sorry... ⟪k:5⟫I’ll be right out!"
msgstr "⟪k:0⟫⟪k:1⟫⟪k:2⟫Ah, ⟪k:3⟫p-⟪k:4⟫perdonami... ⟪k:5⟫Arrivo subito!"

#: scenario6:scenario6_E7BB3F86_5C78_42D9_A0E8_5D77D70DB695
