msgid "⟪k:0⟫⟪k:1⟫⟪k:2⟫It’s a pleasure to meet you."
msgstr "⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫È⟪k:4⟫ un piacere conoscerti."

#: scenario6:scenario6_083071E8_9111_45AE_8A4B_D0C4122FF24C
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: ef980f2f4fe8000d7f2b2ed01b77cb37bf189de610dcbdb5a09756208972fe79
#. default-sha256: fe329b9a1f4a8b30e85867e95ec5fa324ae60a157b5a0b1086b8f1eb8d2d5622
