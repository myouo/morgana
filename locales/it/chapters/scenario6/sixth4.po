msgid "⟪k:0⟫⟪k:1⟫⟪k:2⟫“It’s a pleasure to meet you.”"
msgstr "⟪k:0⟫⟪k:1⟫⟪k:2⟫“⟪k:3⟫È⟪k:4⟫ un piacere conoscerti.”"

#: scenario6:scenario6_666D9EDB_836D_4578_AA5F_8AD6C8F27534
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: eba3db5f4101391f3bd1d3476a8627bd49c2b9052c796d82bafc2e506d771801
#. default-sha256: e057a496b9f2d69e4248ef62799cc431b76de0ba912e87820e731ff2a5af73c2
msgctxt "scenario6:scenario6_666D9EDB_836D_4578_AA5F_8AD6C8F27534"
msgid "⟪k:0⟫What had I spent all that time waiting for?"
msgstr "⟪k:0⟫Per cosa avevo aspettato tutto quel tempo?"

#: scenario6:scenario6_88DA40EB_7F6A_4485_BBEE_ACE5B0922BA6
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 2c098cb7b11635203a0c8b3d65da29a1a562d0e8b44117fb621399a624d5474b
#. default-sha256: 28a55a8b16208f0b71f30a78cf62ef12fcc3e7c0bf7b6182a012282c9852df44
msgctxt "scenario6:scenario6_88DA40EB_7F6A_4485_BBEE_ACE5B0922BA6"
msgid "⟪k:0⟫It was all for naught. It was all meaningless."
msgstr "⟪k:0⟫Era stato tutto inutile—⟪k:1⟫⟪k:2⟫ininfluente."

#: scenario6:scenario6_6F18845D_E537_4999_BC44_68C8B705221C
