msgid "⟪k:0⟫The first thing she said when she saw me was,"
msgstr "⟪k:0⟫La prima cosa che disse appena mi vide fu:"

#: scenario6:scenario6_05C8C434_3889_4466_9C5F_9C967728EF84
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 9b2fb1d23f9e97d953b9cea6a5c31c6c9df34d465ab1be9e9eff18ef15aaddc1
#. default-sha256: 6b0bf3d1b701a1564fb5b0efdc1147eb7eec5c64bce33321ad8e480f35fb0806
