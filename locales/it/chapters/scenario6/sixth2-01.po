#: scenario6:scenario6_DFCA190C_9381_49EB_AF34_7594F696866E
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 072acbe48ab715969c036f080fcc2b4a76681092f6dbd58dec465161e61aded1
#. default-sha256: f30ef24479ddc69ef1214e48d422ed8a6aab87dba707108dbe0395d5c9d2d8b6
msgctxt "scenario6:scenario6_DFCA190C_9381_49EB_AF34_7594F696866E"
msgid "⟪k:0⟫something changed for the very first time."
msgstr "⟪k:0⟫qualcosa cambiò per la prima volta."

#: scenario6:scenario6_A17834CC_C534_4890_9DF7_B42A8279E7D2
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: fc97043ebbec032f3fb1250e7616293e4c7488f976ce20c51b3bc9bd774513f5
#. default-sha256: 68a4cc2940b2dd53185bf8a3a0246e8c296e4f6be461846bb2433b85eb69a6e1
msgctxt "scenario6:scenario6_A17834CC_C534_4890_9DF7_B42A8279E7D2"
msgid "⟪k:0⟫Sunlight, which I had not seen in all that time, shone in from outside."
msgstr "⟪k:0⟫La luce del sole, che in tutto quel tempo non avevo mai visto, splendeva dall’esterno."

#: scenario6:scenario6_B5740C44_6B5C_4BB8_A2B1_5BAB28C78E13
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 6d240cdba1ac0f1cafbc11287e542c3cdd2158b16715da3de7bdb14a967f93a2
#. default-sha256: dc5cdcf4a6becc3140059932df037183e75062161b3ebf9022683566954503b9
msgctxt "scenario6:scenario6_B5740C44_6B5C_4BB8_A2B1_5BAB28C78E13"
msgid ""
"⟪k:0⟫At first, I did not believe it was real. ⟪k:1⟫I thought it was a hallucination born of my "
"inner desires."
msgstr ""
"⟪k:0⟫Inizialmente, non credevo fosse reale.⟪k:1⟫⟪k:2⟫Immaginavo fosse un’allucinazione nata dai "
"miei desideri più profondi."

#: scenario6:scenario6_3B8290BF_A1FD_477C_9A25_BDDA5A48F678
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: aa37428075978f10ee2526cf8299986a4e9ee4dbb950b1619422609720ec1f9c
#. default-sha256: 8fb3c7ceccb803fc6c7505303fcf375e7dc1a25b5dda8b8fcdbea8bde1c67cb1
msgctxt "scenario6:scenario6_3B8290BF_A1FD_477C_9A25_BDDA5A48F678"
msgid "⟪k:0⟫And I thought I must have completely lost it for my fantasies to have escaped my mind."
msgstr ""
"⟪k:0⟫E pensai che se le mie fantasie erano arrivate al punto da prendere forma, dovevo aver perso "
"completamente la testa."

#: scenario6:scenario6_E0EFF0B0_F4EC_4C86_8C4E_09D63CF82B05
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 193d7ab11fc3f27948b9f2db7bce7aa2493cb1b92a6a45475c75ad46a6784bc4
