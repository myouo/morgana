msgctxt "scenario6:scenario6_E0EFF0B0_F4EC_4C86_8C4E_09D63CF82B05"
msgid "⟪k:0⟫⟪k:1⟫The time has come, Giselle.⟪k:2⟫⟪k:3⟫It’s time for you to get to work."
msgstr ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫È⟪k:3⟫ arrivato il momento, Giselle.⟪k:4⟫⟪k:5⟫⟪k:6⟫È⟪k:7⟫ ora di mettersi al "
"lavoro."

#: scenario6:scenario6_34F6CBFA_78F3_45B3_8F31_59CFF12DE53C
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: f849bce5afea558230ce97f2e65e6c400a9c5d2e45df70edbbd21753eb28b61e
#. default-sha256: d8735fc54f70754046aeb64907e9ce6d04a5165e5179c8083acb3ea390842462
msgctxt "scenario6:scenario6_34F6CBFA_78F3_45B3_8F31_59CFF12DE53C"
msgid "⟪k:0⟫Reveling in the sight of the outside was the last thing I should have been doing,"
msgstr "⟪k:0⟫Esultare alla vista del mondo esterno era l’ultima cosa che avrei dovuto fare,"

#: scenario6:scenario6_80F86752_F15F_4301_8AE2_C505E3FD8C04
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 513589d728774a4f98d73354c5ca39ddbc82a58d5cfda15ed6f749e526965a0b
#. default-sha256: b9561928ae4cbd0bc5a3a28cff8f4a8270ee3a99acda30a3a5fb43439d569201
msgctxt "scenario6:scenario6_80F86752_F15F_4301_8AE2_C505E3FD8C04"
msgid "⟪k:0⟫Work? What kind of work?"
msgstr "⟪k:0⟫Lavoro? Che tipo di lavoro?"

#: scenario6:scenario6_D477F6A9_07C6_4A3B_B245_F7D67FF2FA52
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: fd3830adb5e85b96d0adceb0104dea709937b8977da6725e4761a575c9c102ec
