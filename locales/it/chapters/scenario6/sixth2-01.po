msgctxt "scenario6:scenario6_0836612C_FBFD_4359_8344_81C40AE9F202"
msgid "⟪k:0⟫Is someone..."
msgstr "⟪k:0⟫Chi..."

#: scenario6:scenario6_1F63CFE3_69FD_E47E_EB8A_0D76D588D50A
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 77ef2f7b78df8ca0b3fd837f18337774dc1fe087dcd05270f68f711e84fa60fd
