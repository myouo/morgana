msgctxt "scenario6:scenario6_D477F6A9_07C6_4A3B_B245_F7D67FF2FA52"
msgid ""
"⟪k:0⟫As I said, I need you to watch over the house,⟪k:1⟫⟪k:2⟫and show your utmost hospitality to "
"those who show up."
msgstr ""
"⟪k:0⟫Come ho detto, ho bisogno che tu ti prenda cura della casa,⟪k:1⟫⟪k:2⟫e che mostri tutta la "
"tua ospitalità alle persone che verranno."

#: scenario6:scenario6_0836612C_FBFD_4359_8344_81C40AE9F202
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 4c0a29470e408cc2212227a9a6c1a8ba0e98b986e25615affe091b7c837d06e3
