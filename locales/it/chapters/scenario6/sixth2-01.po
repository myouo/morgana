msgid "⟪k:0⟫(But will the door... ⟪k:1⟫open?)"
msgstr "⟪k:0⟫(Ma la porta... ⟪k:1⟫si aprirà?)"

#: scenario6:scenario6_C4E828DB_696C_4F5D_9A09_04597E774214
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 36727d46831efa0d86d64478a33e4911805c67c2fcabde8639a4c0b68fb10198
#. default-sha256: 9d7668bc167290f57929551df8e3664febe2cc5f475cd91d5bd517d04e6188cc
msgctxt "scenario6:scenario6_C4E828DB_696C_4F5D_9A09_04597E774214"
msgid ""
"⟪k:0⟫⟪k:1⟫For so long, the door had refused to budge.⟪k:2⟫⟪k:3⟫For so long, light had forsaken "
"these halls.⟪k:4⟫⟪k:5⟫For so long, there had been no trace of life."
msgstr ""
"⟪k:0⟫⟪k:1⟫Per tutto quel tempo, la porta si era rifiutata di muoversi.⟪k:2⟫⟪k:3⟫Per tutto quel "
"tempo, la luce aveva abbandonato le stanze della villa.⟪k:4⟫⟪k:5⟫Per tutto quel tempo, non c’era "
"stato segno di vita."

#: scenario6:scenario6_D2037F95_74B5_451B_A296_F78BD0F5D9DC
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: ab7bcf981e3929efeb8e502db1fd5c4e23e2880afa19227ed9d1f2e222c0f9a7
#. default-sha256: ca95b1d21db316c0a67268f447a7beaf2e4b113119c8d137e2e16f3a0798888a
msgctxt "scenario6:scenario6_D2037F95_74B5_451B_A296_F78BD0F5D9DC"
msgid "⟪k:0⟫And now, all of that had been turned on its head."
msgstr "⟪k:0⟫E ad un tratto, tutto si era capovolto."

#: scenario6:scenario6_48D2F6F0_DB1E_47E7_BCE8_38526208AA81
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 51bfabb231943359d456b4a4338ebe49fe874f51c1b91eb9281ef0df0cc1fca7
#. default-sha256: 53bd365e4643362f1f431fe882a8e57d2e900f95e0fec27da4b70d59c8f1cebe
msgctxt "scenario6:scenario6_48D2F6F0_DB1E_47E7_BCE8_38526208AA81"
msgid ""
"⟪k:0⟫It was almost certainly a perfectly ordinary slice of nature.⟪k:1⟫⟪k:2⟫Leaves and grass "
"rustled in the wind, flowers specked the earth,"
msgstr ""
"⟪k:0⟫Era di certo una vista naturale del tutto ordinaria.⟪k:1⟫ L’erba e le foglie⟪k:2⟫si "
"muovevano col vento, i fiori sbocciavano dal terreno,"

#: scenario6:scenario6_D13D5DE9_195F_4D3C_81C4_5F28348226CE
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
