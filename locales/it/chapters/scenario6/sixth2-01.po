msgid "⟪k:0⟫This is merely an appetizer."
msgstr "⟪k:0⟫Questo non è che un antipasto."

#: scenario6:scenario6_A469E825_CE1A_4518_B691_B78A80D10F5F
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 547bea2d9f4d9da5617fcbe355fe5c31efc018d6256cfdcbb0227a1910b21b07
