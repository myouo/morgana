msgid "⟪k:0⟫...Before long, two years had passed."
msgstr "⟪k:0⟫...Ben presto, furono passati due anni."

#: scenario6:scenario6_AA6DD54B_D864_41CD_A245_474E7EFA4644
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 1d126e70386a6be373e86cdfeba9773660fb700e791bcb93d0794b810ae4e0ba
