msgid "⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫............"
msgstr "⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫............"

#: scenario6:scenario6_1266F294_ED32_406E_94D6_8CCA1AF6B90C
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: c90fc1b6efb42baf189fdea76fc52182e1861e26ba3b552dc5bcf3fb5563eb68
#. default-sha256: 83f8f8095a53d18b6c5655eb140be48dc3b035a31c85b71e30a6361bc4777243
msgctxt "scenario6:scenario6_1266F294_ED32_406E_94D6_8CCA1AF6B90C"
msgid "⟪k:0⟫I prepared a number of things to say when she was finished with her tale,"
msgstr "⟪k:0⟫Avevo preparato alcune cose da dire non appena avrebbe concluso⟪k:1⟫il suo racconto,"

#: scenario6:scenario6_0CF713FA_806D_4B6A_BAA0_BF374F4C56E0
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 11b1bb31ad8e3fe322b09bd00e499b84bd16cc97556e92e6bf73ee4c7cebbfe0
#. default-sha256: 79ad9a1e6d93ccf12be40e0a706c9359b3e5b65eaf5fb55e9b45c1e16dadeec1
msgctxt "scenario6:scenario6_0CF713FA_806D_4B6A_BAA0_BF374F4C56E0"
msgid "⟪k:0⟫but I can’t manage to put any of them into words."
msgstr "⟪k:0⟫ma non riesco a esprimere a parole nessuna di queste."

#: scenario6:scenario6_1F1C88CC_6A6E_4ECC_868A_58408AC2ABA6
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: f32238882530329275300e596cbf1408ac20361f3463928d28d19a48fcce3e60
#. default-sha256: 1d36fa63d6d1b602098b76221854d802a3548b793f89bae20c02c4960cb047c3
msgctxt "scenario6:scenario6_1F1C88CC_6A6E_4ECC_868A_58408AC2ABA6"
msgid "⟪k:0⟫I almost hate myself for thinking it would be so easy."
msgstr "⟪k:0⟫Quasi mi odio per aver pensato che sarebbe stato facile."

#: scenario6:scenario6_E53F052F_E604_466B_A462_5229FDF0E856
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 236af9d410644bf36b77734aecc33731f2b502e8177cf765aba62c20c8354da2
#. default-sha256: cfedb0cad3477b71b3c04e74354a31f43454151b19892ab58c8a85028c06614f
msgctxt "scenario6:scenario6_E53F052F_E604_466B_A462_5229FDF0E856"
msgid ""
"⟪k:0⟫For letting myself hope I could simply pull her back to her old self,⟪k:1⟫accept whatever "
"had happened to her,"
msgstr ""
"⟪k:0⟫Per aver sperato di riuscire a farla tornare quella di un tempo semplicemente accettando "
"tutto ciò che le è accaduto,"

#: scenario6:scenario6_F3D5627E_7C28_445A_9C3F_932FF496F53E
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 0624ebc8f2493678785223df9f91964e4c712f80aef6c7dcdfa75e5228390cf6
#. default-sha256: 4182be21a4093c5ac17d54fae29c9c565b4bc6ebefc0f0188e96219fa5260f08
msgctxt "scenario6:scenario6_F3D5627E_7C28_445A_9C3F_932FF496F53E"
msgid "⟪k:0⟫take her hand in mine, and that would solve everything."
msgstr ""
"⟪k:0⟫tenendo la sua mano nella mia, e credendo che in questo modo⟪k:1⟫si sarebbe risolta ogni "
"cosa."

#: scenario6:scenario6_218D7FBB_C459_4977_BB6A_96B43570A67F
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: b5e284930c2a73a59b7b2e1dcdcbf2fc197b8f3321cb7d67d07dc48c91fbfc30
#. default-sha256: f0bf87c0f727e508719d7ff4e4f1ad8852a90e750f75cb92745e9623d129240f
msgctxt "scenario6:scenario6_218D7FBB_C459_4977_BB6A_96B43570A67F"
msgid "⟪k:0⟫The truth is so much worse than I imagined—⟪k:1⟫⟪k:2⟫so much more harrowing."
msgstr "⟪k:0⟫La verità è molto peggio di quanto immaginassi—⟪k:1⟫⟪k:2⟫molto più straziante."

#: scenario6:scenario6_16D0120E_43DD_41D0_A19C_830C0C139E1D
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: fe3045d525fdb87250b843f3a0260c92824ad60ec41410a1a7e23d0f97522579
#. default-sha256: 3679f526cc296bec46977d86e7a4dca10a789983a89a9517345c4729a88c5145
msgctxt "scenario6:scenario6_16D0120E_43DD_41D0_A19C_830C0C139E1D"
msgid "⟪k:0⟫She was subjected not only to her own terrible fate,"
msgstr "⟪k:0⟫Non è stata sottoposta unicamente al proprio terribile destino,"

#: scenario6:scenario6_581895C7_70CD_4803_BFC6_FB50FAB30442
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: d3154d4b363dcfec1683222588b12fd8671439aad62f50f526972b44b63bd12a
#. default-sha256: c1c76eaf99e4d45a66b961c12616f7bf62559768a0804f7c6a8e10972f6f542a
msgctxt "scenario6:scenario6_581895C7_70CD_4803_BFC6_FB50FAB30442"
msgid "⟪k:0⟫but every single one of this house’s tragedies."
msgstr "⟪k:0⟫ma ad ogni singola tragedia avvenuta in questa casa."

#: scenario6:scenario6_D523CCEA_32F8_4BE3_ADED_A419394BED4D
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
