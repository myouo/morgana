msgid "⟪k:0⟫N-⟪k:1⟫No, he’s not curs—"
msgstr "⟪k:0⟫N-⟪k:1⟫No, lui non è malede—"

#: scenario5:scenario5_AE7C1CB4_95F7_4057_8995_BE29E66375D5
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 7ffc2c2ccad99f4f27f6f2df6689cbd3429354c38cee3a1d267ce9a2243e77e8
#. default-sha256: 83412dfa67e45f9116b5dc809a592e98f6d05b245df9d12e73c12de0cf664c10
msgctxt "scenario5:scenario5_AE7C1CB4_95F7_4057_8995_BE29E66375D5"
msgid "⟪k:0⟫⟪k:1⟫⟪k:2⟫Indeed! I am cursed!"
msgstr "⟪k:0⟫⟪k:1⟫⟪k:2⟫Esatto! Sono maledetto!"

#: scenario5:scenario5_384DD30F_A1C3_4A73_BFCF_B7E3DFACBC6F
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: ece6cf5dc809b719df878ff4054f1f463349e7e573f6edd31f7b7332ecd35025
#. default-sha256: b07db41203a92c2604410108c28e3e7b9e31dceda86708cd16fab6a25d6fcafe
msgctxt "scenario5:scenario5_384DD30F_A1C3_4A73_BFCF_B7E3DFACBC6F"
msgid ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫⟪k:4⟫⟪k:5⟫⟪k:6⟫⟪k:7⟫⟪k:8⟫The witch’s curse is real!⟪k:9⟫⟪k:10⟫I have "
"inherited it, in its entirety—⟪k:11⟫⟪k:12⟫as well as her purpose!"
msgstr ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫⟪k:4⟫⟪k:5⟫⟪k:6⟫⟪k:7⟫⟪k:8⟫La maledizione della strega è reale!⟪k:9⟫⟪k:10⟫E io "
"l’ho ereditata, nella sua interezza—⟪k:11⟫⟪k:12⟫così come la sua missione!"

#: scenario5:scenario5_E59C58D1_E3D3_41A7_B771_B1C16E79855D
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
