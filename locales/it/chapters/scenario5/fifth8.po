msgctxt "scenario5:scenario5_BFA40E06_D27F_497F_B8CF_AE295E4DD6A5"
msgid "⟪k:0⟫Someone muttered, probably unconsciously."
msgstr "⟪k:0⟫Mormorò qualcuno, probabilmente senza pensarci."

#: scenario5:scenario5_82BBF69C_0AA9_4DFA_BC35_4C07A8FFD1EB
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: d3a4ceb272e51e4498b601af4751fb4c415698a01d27563fbcf391af009ff7a5
#. default-sha256: bfcd385c9020d583ac23ed94d2c6f9f2672edb25429ab27532e102149c7df12d
msgctxt "scenario5:scenario5_82BBF69C_0AA9_4DFA_BC35_4C07A8FFD1EB"
msgid "⟪k:0⟫He did, indeed, look like something not of this world."
msgstr "⟪k:0⟫In effetti appariva proprio come un essere proveniente da un altro mondo."

#: scenario5:scenario5_4E2AFB9D_7BB0_47E8_9C5E_82973E743E92
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: f338d823ed7db98998f1d60f08702de9cb88dec7e6c8203a0683d4d5dbd2b79a
#. default-sha256: 2810ed8eb771ca3761e3760385c464286d3a4576ee195fb04fe9b8241100fd29
msgctxt "scenario5:scenario5_4E2AFB9D_7BB0_47E8_9C5E_82973E743E92"
msgid "⟪k:0⟫Aaah, ⟪k:1⟫i-⟪k:2⟫it’s a demon!⟪k:3⟫The rumors about this place were true!"
msgstr ""
"⟪k:0⟫Aaah, è— ⟪k:1⟫⟪k:2⟫è un demone!⟪k:3⟫⟪k:4⟫Le voci che giravano su questo posto erano vere!"

#: scenario5:scenario5_4D6A6178_F6D8_4178_A294_DC884CA04616
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 19da718d126a7eeb030d1b49be6a9dfbd5455578312b17a755f4e066e569917a
#. default-sha256: abb5121a688381216141aacb6351f5429351a554af98c9a1470fcb6adf118989
msgctxt "scenario5:scenario5_4D6A6178_F6D8_4178_A294_DC884CA04616"
msgid "⟪k:0⟫A cursed demon lives there!"
msgstr "⟪k:0⟫Un demone maledetto vive qui!"

#: scenario5:scenario5_B3899674_34FA_4458_A891_DA3A390A1B3D
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
