msgctxt "scenario5:scenario5_F9198B71_C35F_4BD1_84C0_071E80B99ABA"
msgid "⟪k:0⟫Beneath the dazzling midday sun,"
msgstr "⟪k:0⟫Sotto il sole abbagliante di mezzogiorno,"

#: scenario5:scenario5_231177F8_A960_411F_BAD4_D4A6BF6A7379
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: e6f24caa82aa3e01f1032b303919e7424cc7fb953b5de9d0917fb324418200cc
#. default-sha256: 1d61a97f8e1acd842755d74bb9c4045da4987d94474776c320351ade3324a3c8
msgctxt "scenario5:scenario5_231177F8_A960_411F_BAD4_D4A6BF6A7379"
msgid "⟪k:0⟫he had bone-chillingly alabaster skin and long, nearly translucently pale hair."
msgstr ""
"⟪k:0⟫mostrava un’agghiacciante pelle alabastro e lunghi capelli di un bianco quasi trasparente."

#: scenario5:scenario5_2D3C3470_7C9F_4431_B67D_D05BDB14A582
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: f00e6e362d0a946541be05567f8e20a80e5d1a26e9c1602745facf7b55db159c
#. default-sha256: 4f27fb0a33ae531f09f0fb608bce0328a0cacb2c6b5e07a6563fbd0d0bac87f7
msgctxt "scenario5:scenario5_2D3C3470_7C9F_4431_B67D_D05BDB14A582"
msgid "⟪k:0⟫So surely you came prepared for whatever you would find..."
msgstr "⟪k:0⟫Quindi immagino che siete venuti preparati a qualunque cosa avreste trovato..."

#: scenario5:scenario5_D92D32C1_0A19_4E83_8C64_C449FF8172C1
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 6663bd393ab7ec753763cb504dad169a4853529bf1fbfe80deb8b6c5119d6844
