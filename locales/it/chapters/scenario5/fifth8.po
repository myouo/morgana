msgid "⟪k:0⟫⟪k:1⟫...A-⟪k:2⟫A demon..."
msgstr "⟪k:0⟫⟪k:1⟫...U-⟪k:2⟫Un demone..."

#: scenario5:scenario5_BFA40E06_D27F_497F_B8CF_AE295E4DD6A5
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: e581c2b768a756fcc71c2ff38a58ffd18ad01249645b64ceb5f991dd7de0ee8a
