msgctxt "scenario5:scenario5_D92D32C1_0A19_4E83_8C64_C449FF8172C1"
msgid "⟪k:0⟫And his eyes..."
msgstr "⟪k:0⟫E i suoi occhi..."

#: scenario5:scenario5_D8D799E7_FF18_48BA_B6E3_2BE52A033C20
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 34e9840cb4e80772ce6e2293e5eb19c0d60195ce83c568761a2f3d2386a6fd36
