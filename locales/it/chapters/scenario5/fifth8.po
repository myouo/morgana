msgctxt "scenario5:scenario5_E59C58D1_E3D3_41A7_B771_B1C16E79855D"
msgid "⟪k:0⟫—!"
msgstr "⟪k:0⟫—!"

#: scenario5:scenario5_0CB33A79_4C6F_4949_B116_CA3F9D4681BF
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 8ae4048b604feb3ae773532530ee33f451bd89a4b75aad9da7a99bf22f53cb57
#. default-sha256: b7a4195058ab87677dcfb1e313d18f65775d29d758c21aa15743bb3266685432
msgctxt "scenario5:scenario5_0CB33A79_4C6F_4949_B116_CA3F9D4681BF"
msgid "⟪k:0⟫A witch, a demon, a spirit impure!⟪k:1⟫⟪k:2⟫Call me whatever you wish!"
msgstr "⟪k:0⟫Strega, demone, spirito impuro!⟪k:1⟫⟪k:2⟫Chiamatemi come volete!"

#: scenario5:scenario5_711B9A6F_4494_4E8B_ACFC_EC7EEB85D949
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 3a0ab78c95b223d6e05098db9bd5018381961d941eb024700ecf8bc34e9e98ef
#. default-sha256: 23ddef8811855214cffd5989ff5783a5feea024be3161c0e0f76fe4415be0b73
msgctxt "scenario5:scenario5_711B9A6F_4494_4E8B_ACFC_EC7EEB85D949"
msgid "⟪k:0⟫For the truth shall not change!⟪k:1⟫⟪k:2⟫I carry within me an eternal curse!"
msgstr "⟪k:0⟫Perché la realtà non cambierà!⟪k:1⟫⟪k:2⟫Sono portatore di una maledizione eterna!"

#: scenario5:scenario5_711B9A6F_4494_4E8B_ACFC_EC7EEB95D949
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: db9d833fcfd6d2ebf53a3836db201ac085ab0bfcb8233e8ce7e5682323433787
#. default-sha256: 7ed8ad001dc66ceb88b96223f7a510755769431eee580058176d2946500c5ee5
msgctxt "scenario5:scenario5_711B9A6F_4494_4E8B_ACFC_EC7EEB95D949"
msgid ""
"⟪k:0⟫Behold my flesh, pale as the moon!⟪k:1⟫⟪k:2⟫No red blood flows beneath this skin, as it does "
"yours!"
msgstr ""
"⟪k:0⟫Osservate la mia carne, pallida come la luna!⟪k:1⟫⟪k:2⟫Sotto questa pelle non scorre sangue "
"rosso, a differenza vostra!"

#: scenario5:scenario5_711B9A6F_4494_4E8B_ACFC_EC7EEB85D959
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 09b7e4237b02f18a42ce0ec204ec1a0bb4f389a4a281f65d22abeeba60a9eaab
#. default-sha256: 926d995fcbebd302dd93584e1942ded2850b58ec18ff23788a70efd2cb7f7217
msgctxt "scenario5:scenario5_711B9A6F_4494_4E8B_ACFC_EC7EEB85D959"
msgid ""
"⟪k:0⟫Behold my hair, utterly devoid of color,⟪k:1⟫⟪k:2⟫offered up to the Devil as part of our "
"pact!"
msgstr ""
"⟪k:0⟫Osservate i miei capelli, completamente privi del loro colore,⟪k:1⟫⟪k:2⟫offerto al Diavolo "
"come parte del nostro patto!"

#: scenario5:scenario5_711B9A6F_4494_4E8B_ACFC_EC7EEB85D999
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 486b9a1465e615ded3dfe2fb963edbecb37dea487b1b1d772a9657070b2bac6c
#. default-sha256: c308409baeb549fd68f4bd0677c5f97d23625fa8152d2649c6832b36e91abe83
msgctxt "scenario5:scenario5_711B9A6F_4494_4E8B_ACFC_EC7EEB85D999"
msgid "⟪k:0⟫Behold these crimson eyes!⟪k:1⟫⟪k:2⟫A symbol of the lifeblood spilt at my hands!"
msgstr ""
"⟪k:0⟫Osservate questi occhi cremisi!⟪k:1⟫⟪k:2⟫Il simbolo del sangue versato dalle mie vittime!"

#: scenario5:scenario5_711B9A6F_4494_4E8B_ACFC_EC7EEB85D849
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: cdcf0ec5360f45714a988c9d14a52565a0fb67b7afb0f26cf26db3e0d4e992ad
#. default-sha256: 76da343f76e1c68d2d430783831fe4687b40501ff04270b277884d1f373373b4
msgctxt "scenario5:scenario5_711B9A6F_4494_4E8B_ACFC_EC7EEB85D849"
msgid "⟪k:0⟫Ah... ⟪k:1⟫aaah..."
msgstr "⟪k:0⟫Ah... ⟪k:1⟫aaah..."

#: scenario5:scenario5_E22FD1CE_DC1F_4F16_898F_96EFD80B6207
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: a90eb6f7eed825cddf11961655ca258071ca027b31a7b7f6723bcd9f3874b26d
#. default-sha256: c69148d5d0e14317bbe1e3e4a45e09d9578dc4335db255a242d72b6eafa70956
msgctxt "scenario5:scenario5_E22FD1CE_DC1F_4F16_898F_96EFD80B6207"
msgid "⟪k:0⟫I shall bring calamity upon you, as the witch of legend!"
msgstr "⟪k:0⟫Porterò sventura su di voi, come fece la strega della leggenda!"

#: scenario5:scenario5_B5DDA295_5464_46AA_A330_C83F64301F84
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 44c0597b209586312983cd55a481c5aa17aebf1da474cb6b70f416e3efa24aca
#. default-sha256: 93b8bf99f292f5eff006833cce3738b57e2cd7a98f9f455cdc9585a0e91fb3f2
msgctxt "scenario5:scenario5_B5DDA295_5464_46AA_A330_C83F64301F84"
msgid "⟪k:0⟫Neverending famine! Plague! Catastrophe! Suffering for generations!"
msgstr "⟪k:0⟫Carestie senza fine! Peste! Cataclismi! Sofferenza per generazioni!"

#: scenario5:scenario5_96E5ACB7_9EED_4B68_A0C2_A45F993F1E2D
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: a959e43ac7c3ac81ab0f5ebcad6552cbde0239b2707280673e58e92daae11510
#. default-sha256: 5ef29df8c7a5fed453219356c02c1d7bd1e9d5cb6d1d59222687020dc1ab21f8
msgctxt "scenario5:scenario5_96E5ACB7_9EED_4B68_A0C2_A45F993F1E2D"
