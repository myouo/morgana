msgctxt "scenario5:scenario5_D8D799E7_FF18_48BA_B6E3_2BE52A033C20"
msgid "⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫⟪k:4⟫were like two blazing infernos staring out across the mob."
msgstr "⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫⟪k:4⟫erano come due sfere infuocate che fissavano la banda di uomini."

#: scenario5:scenario5_C3378308_A7A1_4887_A697_04438710BFDE
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 1d73db7b7609f969232d9d5fb970b9ad537d3ab1501fafa84c1136ca43d355aa
#. default-sha256: 1f5b317b2edec26ab5a8fe97665d4a27a5f9960d7e8f852cfc73161bd9daf36c
