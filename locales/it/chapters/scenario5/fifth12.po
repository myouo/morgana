msgid "⟪k:0⟫What went through my father’s mind... ⟪k:1⟫when he looked at these?"
msgstr "⟪k:0⟫Cos’era passato per la testa a mio padre... ⟪k:1⟫quando le aveva riviste?"

#: scenario5:scenario5_4E2234B1_44E4_47E5_9DB4_217802EAE942
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 50f0f80c7c32a9e10fa9f73ca42136fdb8defd3d5b767f77b9d407e49179324d
