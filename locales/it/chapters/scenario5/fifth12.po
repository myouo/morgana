msgid ""
"⟪k:0⟫Swollen, red-and-black gashes, still not healed after more than a year, defiled her white "
"flesh."
msgstr ""
"⟪k:0⟫Tagli profondi, gonfi, rossi e neri—⟪k:1⟫⟪k:2⟫non ancora rimarginati dopo più⟪k:3⟫di un anno—"
"⟪k:4⟫⟪k:5⟫macchiavano la sua carne bianca."

#: scenario5:scenario5_4D726119_BE4D_4340_92F6_5A7B0017C444
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 668757bfea4952043d3164c7846803e2d259788264a11d1a2b6cb6658d73950f
#. default-sha256: a6dc57bb3ab52ba8a257f9b9e3e1919cacaafefe51400beb8cf5eb24cc8bc201
msgctxt "scenario5:scenario5_4D726119_BE4D_4340_92F6_5A7B0017C444"
msgid ""
"⟪k:0⟫As she had described for me, the lines were arranged to form letters carved into her skin."
msgstr ""
"⟪k:0⟫Come lei stessa mi aveva descritto, le linee erano disposte per formare delle lettere incise "
"sulla sua pelle."

#: scenario5:scenario5_6E647427_039A_41AC_9B8D_983F38424F1A
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 43225637cde5dc31d00347cbb2dd69b17056138ed7832b0a02dfaffdb20f6bdf
