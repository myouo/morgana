msgctxt "scenario5:scenario5_55C88ACA_340B_4D9F_BCE4_3EB7415B16CD"
msgid "⟪k:0⟫My instincts told me these were wounds she would carry for the rest of her life."
msgstr ""
"⟪k:0⟫Il mio istinto mi diceva che quelle erano ferite che avrebbe portato con sé per il resto "
"della sua vita."

#: scenario5:scenario5_337DF814_E1AC_4B07_A640_6BC1D14477E4
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 8385e2feb98ef07d867bb76920edfd127fe7ae349152eb75353992f40868e218
