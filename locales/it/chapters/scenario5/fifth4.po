msgid "⟪k:0⟫what we lacked, instead, was wealth."
msgstr "⟪k:0⟫quello che ci mancava, però, era il benessere economico."

#: scenario5:scenario5_544B30C8_2862_43A1_8AF6_ABB4BC74ACEF
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 8311433edb716973fa4297af89c2abfa634d5488cc98cf8f7eead05621b1b94a
