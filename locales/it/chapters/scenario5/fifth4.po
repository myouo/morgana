msgid "⟪k:0⟫Your job is to keep watch over me.⟪k:1⟫⟪k:2⟫If the mere sight of me has you trembling,"
msgstr "⟪k:0⟫Il tuo lavoro consiste nel tenermi d’occhio.⟪k:1⟫⟪k:2⟫Se tremi al solo guardarmi,"

#: scenario5:scenario5_BC4C1FD0_6775_4175_B170_E70613EE8A9B
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 9e9227d93e7704a6aa178bdf6568efff4dc42fc8d05cbfd09b98840ba31156ed
