msgctxt "scenario5:scenario5_FEFFF620_927D_421C_8A7D_35DD35991C84"
msgid "⟪k:0⟫Some things were too foolish to concern yourself over."
msgstr "⟪k:0⟫Alcune cose erano troppo sciocche perché potessi preoccuparmene."

#: scenario5:scenario5_B0E0DB1D_C7F9_44CF_8D6A_BFDB8D03BF84
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 1d1110225f61e5f56608eb28fdbba5026ba6e79c1cdb1ff532a0439d7204e3d5
