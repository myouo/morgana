msgctxt "scenario5:scenario5_5C7D8D1A_F976_4877_91A1_2CB164E9C884"
msgid "⟪k:0⟫Uneasiness gripped me."
msgstr "⟪k:0⟫Venni sopraffatta dal disagio."

#: scenario5:scenario5_F949FB49_0ED6_48BD_BA6D_AEC4B9AE13C3
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: d5c821c8a3dd18835e25bf49f4302699683fe8ccff92c94b7dec5825d0e1d704
