msgid "⟪k:0⟫My voice simply disappeared into the void.⟪k:1⟫⟪k:2⟫No response."
msgstr "⟪k:0⟫La mia voce sparì nel vuoto.⟪k:1⟫⟪k:2⟫Nessuna risposta."

#: scenario5:scenario5_B7FE4138_5A74_4965_A6EE_B0030387B0F5
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: d92d3ee37662a5e89f5ddb08d707e0010b91ca5917507a839f138895c331e3ca
