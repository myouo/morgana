msgid "⟪k:0⟫I suppose I can’t know without looking around a bit more."
msgstr "⟪k:0⟫Immagino che non lo saprò mai senza dare un’occhiata in giro."

#: scenario5:scenario5_7459A744_504E_4A22_B2AB_FE1F3D665720
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 5c8692b37be7b5a0b663660b00c1f7c9627ad1fd15acfce4dba1fffdbb8d2c26
