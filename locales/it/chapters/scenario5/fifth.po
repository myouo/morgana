msgid "⟪k:0⟫That was about all I could say, anyway. ⟪k:1⟫Oh well."
msgstr "⟪k:0⟫Non c’era molto altro che io stessa avrei potuto dire, in fin dei conti."

#: scenario5:scenario5_E6D58D3F_229A_41CD_97BE_845154F0A15F
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: be4465df65e2f9189253b283f9396602be82e4313c3e85f85f6132460e88e702
