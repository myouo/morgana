msgid "⟪k:0⟫Hehehe. And it’s all thanks to you, Amédée."
msgstr "⟪k:0⟫Hehehe. Ed è tutto grazie a te, Amédée."

#: scenario5:scenario5_6B395FC1_F244_4E44_92D9_73CEB67F8ED8
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 404556db718d334033a0172056f7c71d81748da7afae32eab2d2a91dda9339fe
