msgid ""
"⟪k:0⟫Houses were scattered across an area that seemed far too large for only a hundred people."
msgstr ""
"⟪k:0⟫Le case erano sparse in un’area che sembrava troppo grande per solo un centinaio di persone."

#: scenario5:scenario5_1BB3CF46_DC55_4CB5_99A0_966551048D3A
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 24de9a049b76b11e99c17567353382aecb688d6b7d060e56e9ca0342703b398b
