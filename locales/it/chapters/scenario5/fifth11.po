msgctxt "scenario5:scenario5_3302F5D2_B114_4275_97BE_2F2149B8F654"
msgid "⟪k:0⟫But look: it’s only one, but it did."
msgstr "⟪k:0⟫Eppure guarda: ⟪k:1⟫ne è solo una, ma ce l’ho fatta."

#: scenario5:scenario5_3C367B04_7923_4F84_9389_FDCB52BD71D1
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
