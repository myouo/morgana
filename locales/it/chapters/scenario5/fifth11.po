msgctxt "scenario5:scenario5_73C9FBF1_FFE7_4BE4_B0A0_3F9DA390FD4A"
msgid "⟪k:0⟫I wanted... ⟪k:1⟫to make it a gift for you, Master."
msgstr "⟪k:0⟫Volevo... ⟪k:1⟫regalartela, Padrone."

#: scenario5:scenario5_DC4F977F_5278_4FD4_A6FE_FE627B9A881B
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 806288e9507ba3638a18801224b159aab5ed12119e0bfbe2ea705fb38a668e6c
