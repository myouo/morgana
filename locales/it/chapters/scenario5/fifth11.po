#: scenario5:scenario5_5351814B_5466_4814_92DD_53303F78A75E
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 58bfe72d8971ab8b74a66c71adda8a98702bf5de5ef920eccd1902c918d2328b
#. default-sha256: 4ea89627e0150821486c9c6087b13596556679d6715bf3df111ca1fde3bfa58a
msgctxt "scenario5:scenario5_5351814B_5466_4814_92DD_53303F78A75E"
msgid ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫⟪k:4⟫⟪k:5⟫⟪k:6⟫⟪k:7⟫Before long, winter retreated and our second spring came "
"to take its place."
msgstr ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫⟪k:4⟫⟪k:5⟫⟪k:6⟫⟪k:7⟫Di lì a poco, l’inverno giunse alla fine, per lasciare il "
"posto alla nostra seconda primavera insieme."

#: scenario5:scenario5_435A89A1_6490_46EC_B689_8B258E374994
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 118f03f97b979e9f8df98486b2214dbc998c8f4e7a471a1fe0d19c30554bbd86
#. default-sha256: 38e44adba5c0e32a119b82cf203231ac76fe0653c926212a3add02a295d1bdd6
msgctxt "scenario5:scenario5_435A89A1_6490_46EC_B689_8B258E374994"
msgid "⟪k:0⟫A full year had passed since we had resumed living together,"
msgstr "⟪k:0⟫Era passato un anno intero da quando avevamo riniziato a vivere sotto lo stesso tetto,"

#: scenario5:scenario5_4A897F4C_E0E2_415A_A9A0_1CCB1D2596EA
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 7a7b596912e79f67828cd98365ab7c9df52641b156422717a5f481374113ce72
#. default-sha256: 119bf4254bc8ad41e295535237de1768a6d90d7fd3b7e0f4cc9a037f0b05893a
msgctxt "scenario5:scenario5_4A897F4C_E0E2_415A_A9A0_1CCB1D2596EA"
msgid "⟪k:0⟫and I don’t think it was my imagination that this year felt much warmer than last."
msgstr ""
"⟪k:0⟫e il fatto che quell’anno fosse più caldo del precedente non era solo una mia impressione."

#: scenario5:scenario5_CFE1213C_3933_9F57_3F36_8BD7E239BE3E
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 80b472b442e0292f7be889c2b15b07cd77401e0c472f4600e74108dd463a4757
#. default-sha256: 9b30895e9bf182564337f586cb152dae50d6f764ed293ab43bf652e24c6bc340
msgctxt "scenario5:scenario5_CFE1213C_3933_9F57_3F36_8BD7E239BE3E"
msgid "⟪k:0⟫Spring seemed to have arrived a bit earlier than in previous years."
msgstr "⟪k:0⟫La primavera sembrò arrivare leggermente più presto del solito."

#: scenario5:scenario5_428E1259_31F0_4BC3_A73C_8A6F40A6E566
