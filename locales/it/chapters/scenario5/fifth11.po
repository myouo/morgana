msgctxt "scenario5:scenario5_A64047C7_A745_40A3_AAF1_E6A770DCA609"
msgid "⟪k:0⟫Why would you keep it from me?"
msgstr "⟪k:0⟫Perché avresti dovuto tenermelo nascosto?"

#: scenario5:scenario5_73C9FBF1_FFE7_4BE4_B0A0_3F9DA390FD4A
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: f121b90a5ce3b093d18847567b7d4248a29715ec6deb730f4c028104c7d32da1
