msgid "⟪k:0⟫...I had no idea."
msgstr "⟪k:0⟫...Non lo sapevo."

#: scenario5:scenario5_34E128D5_962B_4B90_87DE_8DD815370172
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 9523875bfa3fdf9e7b17ad6cb34b2cf9c998260bcab47f48fe199178954d93ab
