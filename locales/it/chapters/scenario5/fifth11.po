msgctxt "scenario5:scenario5_04A9B3BA_9BD2_4765_9F52_2D74F2237B51"
msgid "⟪k:0⟫It’s the middle of the night... ⟪k:1⟫What’s so important..."
msgstr "⟪k:0⟫⟪k:1⟫È⟪k:2⟫ notte fonda... ⟪k:3⟫Cosa c’è di tanto importante?"

#: scenario5:scenario5_DD08FE95_5669_41DF_8099_3B0D7A8EA63F
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: b1fbb608b5105d68e12bcab9757340b562dfb388d54d0dcaf505471d0525f302
