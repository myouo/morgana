msgctxt "scenario5:scenario5_34E128D5_962B_4B90_87DE_8DD815370172"
msgid "⟪k:0⟫Of course you didn’t. I didn’t tell you."
msgstr "⟪k:0⟫Certo che no. Non te l’avevo detto."

#: scenario5:scenario5_A64047C7_A745_40A3_AAF1_E6A770DCA609
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: b8725122727b8453a64cccb0b039f403ab9397fda8de3034f87f6e271630ff3a
