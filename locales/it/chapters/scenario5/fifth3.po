#: scenario5:scenario5_7F9C6881_0D0B_448C_963B_E47E326BBE54
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: c0908e5f3722f8b0b3e7b145648355e09b46834d4fd06b61db102c67e9319b91
#. default-sha256: fe6e39072cbfaf2d6ee1f38b3a99fe621b6c4426a0994145cf334cecf00c2862
msgctxt "scenario5:scenario5_7F9C6881_0D0B_448C_963B_E47E326BBE54"
msgid ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫⟪k:4⟫⟪k:5⟫⟪k:6⟫⟪k:7⟫⟪k:8⟫⟪k:9⟫⟪k:10⟫⟪k:11⟫⟪k:12⟫It had been a little under "
"two weeks since I had moved in with Michel."
msgstr ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫⟪k:4⟫⟪k:5⟫⟪k:6⟫⟪k:7⟫⟪k:8⟫⟪k:9⟫⟪k:10⟫⟪k:11⟫⟪k:12⟫Erano passate poco meno di "
"due settimane da quando avevo iniziato⟪k:13⟫a vivere con Michel."

#: scenario5:scenario5_A2B2C3A3_E67B_4632_A11A_A01A64AC1CB0
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: c17ef88f6da8e7be0b6e7e472c40b6d4dada93ef18f9c532a58f4d8efcbcd128
#. default-sha256: 8aa4d315b5b41be9580b241cbdf80087c20c2d4e59738165349d34865d202fc0
msgctxt "scenario5:scenario5_A2B2C3A3_E67B_4632_A11A_A01A64AC1CB0"
msgid "⟪k:0⟫Though we lived in the same house, we rarely saw each other."
msgstr "⟪k:0⟫Sebbene vivessimo nella stessa casa, ci vedevamo raramente."

#: scenario5:scenario5_2A965A44_8F80_40BF_A5E1_D86B24CE088C
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: ba8cf4239659f8112c9244fff0383585d01f6f7fbb46411a61fd4009ca42fcdf
#. default-sha256: 6f11102c544d36f2de147acbcd0d2f8fefa96bc6349e5983e797fff4862f4720
msgctxt "scenario5:scenario5_2A965A44_8F80_40BF_A5E1_D86B24CE088C"
msgid "⟪k:0⟫On unlucky days, I wouldn’t see him at all."
msgstr "⟪k:0⟫Nei giorni più sfortunati, non lo vedevo affatto."

#: scenario5:scenario5_85E8BFB9_F381_4DD1_BD7C_4527A9E775B1
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: d69cac98a2c17389719a6afa551043efa7f42266933c23a3c501da8921a0adcc
#. default-sha256: 71488a10ddf56f990fa35e6edc75c5d8a5647619b2cec74cdb0b69813c86ad76
msgctxt "scenario5:scenario5_85E8BFB9_F381_4DD1_BD7C_4527A9E775B1"
msgid ""
"⟪k:0⟫I wasn’t sure if he ate in his room or our schedules were simply misaligned, but we never "
"had any meals together."
msgstr ""
"⟪k:0⟫Non sapevo se mangiasse nella sua stanza o se semplicemente i nostri orari non erano "
"allineati, ma non avevamo mai né pranzato né cenato insieme."

#: scenario5:scenario5_A5BCFB35_20B8_4F12_9B50_57F5C20CAF1C
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: fd8b4ea400e9727d73ea9e3ef789c6f144a1d308ec4f5ad4bf09419d436d2139
#. default-sha256: babee9bad5929149f718abc782f6900c56a00b029798f0c3feaedaf03f60c1a2
msgctxt "scenario5:scenario5_A5BCFB35_20B8_4F12_9B50_57F5C20CAF1C"
msgid "⟪k:0⟫Perhaps he was deliberately avoiding me."
msgstr "⟪k:0⟫Probabilmente mi stava deliberatamente evitando."

#: scenario5:scenario5_CBF3FE2B_D765_47F6_BB1B_2ECF64E875C8
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 5f4e6eb4809e0733e25f6782c7d9d5d85efbd1feacb7c4f58797d93a47d11578
#. default-sha256: 5918f82ba69c421fb2b8df5270d6c2722439236187373cc5d3337ff3bb6ecc23
msgctxt "scenario5:scenario5_CBF3FE2B_D765_47F6_BB1B_2ECF64E875C8"
msgid "⟪k:0⟫That has to be it..."
msgstr "⟪k:0⟫Dev’essere così..."

#: scenario5:scenario5_8C1E720E_D5B5_4FCD_86BC_ACBADC321ACB
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: e7aad45900d3523f88fd621668502cbc882cc0ef96f95b7336a7f7255edd3570
#. default-sha256: 569c108accfc7603957ee6d63f73f9f2a5a15a70b58e2c13e869df58efc6d9b6
msgctxt "scenario5:scenario5_8C1E720E_D5B5_4FCD_86BC_ACBADC321ACB"
msgid "⟪k:0⟫I know servant and master don’t usually eat at the same table,⟪k:1⟫but even so..."
msgstr ""
"⟪k:0⟫Lo so che di norma i servi e i padroni di casa non mangiano allo stesso tavolo, però..."

#: scenario5:scenario5_6CBD4980_1912_4BFE_B443_1D7A16551157
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: e52793ada560879b5e310f28afcfeac38ac9b55b86fcbfc68b1740c95da57790
#. default-sha256: e290f87602d2a44ed243e8c6510a65aefbb0541c306abbed766a60ff6c453923
msgctxt "scenario5:scenario5_6CBD4980_1912_4BFE_B443_1D7A16551157"
msgid "⟪k:0⟫He could be a little less obvious about it."
msgstr "⟪k:0⟫potrebbe fare qualche sforzo per non darlo a vedere."

#: scenario5:scenario5_EA9C66EA_A57E_400D_A70B_91B4F80816DA
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
