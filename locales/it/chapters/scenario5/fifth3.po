msgid "⟪k:0⟫............"
msgstr "⟪k:0⟫............"

#: scenario5:scenario5_5B8E17F4_A3C4_419A_A00C_994A0502EBCA
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: a085712303252bbbc5859704dfeddd7d0ccdd7ca8a1f0924ae9870b785b82817
#. default-sha256: b4aa6f96d852b48cc14d1efaa2b694ce6d693fc1670f27d7ff1841899502b10b
msgctxt "scenario5:scenario5_5B8E17F4_A3C4_419A_A00C_994A0502EBCA"
msgid "⟪k:0⟫Am I really that much of a nuisance?"
msgstr "⟪k:0⟫Sono davvero così fastidiosa?"

#: scenario5:scenario5_BA276AAF_86AF_4D04_9849_50FCA2D525C5
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 61dbd1adf973fca7b1143e3e218d812f8d0d97580e2484cdb3948093700b4c77
#. default-sha256: fa5b9c76e88c2cfdc0c7ec0ee54dd2bcc51df95117e30c17647037759c6f76ff
msgctxt "scenario5:scenario5_BA276AAF_86AF_4D04_9849_50FCA2D525C5"
msgid ""
"⟪k:0⟫I’m not doing anything inappropriate, am I?⟪k:1⟫⟪k:2⟫I’m being pleasant and sociable, aren’t "
"I?"
msgstr ""
"⟪k:0⟫Non sto mica facendo qualcosa di inappropriato...⟪k:1⟫⟪k:2⟫Sono simpatica e cordiale, non è "
"così?"

#: scenario5:scenario5_DF3F6E2A_FF8E_4D95_805F_7A18C50830D4
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 9dd53a265e97d524ecacb4a530abf9139e2c7d3aa53cc9861c59a2f02dd26a7c
#. default-sha256: 80ceb2c96b6147f72a6371f5cba131487ad82ac3144ecb7544d86027b8e9f3b5
msgctxt "scenario5:scenario5_DF3F6E2A_FF8E_4D95_805F_7A18C50830D4"
msgid "⟪k:0⟫I haven’t given him any reason to not like me, I think.⟪k:1⟫⟪k:2⟫I hope..."
msgstr "⟪k:0⟫Non credo di avergli dato alcun motivo per odiarmi.⟪k:1⟫⟪k:2⟫O almeno spero..."

#: scenario5:scenario5_C945864B_F126_41CF_AB15_A799D69A1064
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: bac9cd65da1e747b14cd31916d23b819d272910d024d1cecc7b30310dcc8129c
#. default-sha256: 930cc1fbb9847785388c4cebc1fce8f6c04d57ba628bd76a7053e8ca825b1d00
msgctxt "scenario5:scenario5_C945864B_F126_41CF_AB15_A799D69A1064"
msgid "⟪k:0⟫He had never been very enthusiastic about my staying here,"
msgstr "⟪k:0⟫Non era mai stato davvero entusiasta della mia presenza,"

#: scenario5:scenario5_BA31EB28_082D_47A3_BB1A_CF08485A11A3
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 82f9c99d256621c55c7632e5691ce3871982667fe9ff72796d682f131a30ef63
#. default-sha256: 9e69cbb019924ba16eb5521e885f57d5a86375a40904ce77f00c9840dba8e36d
msgctxt "scenario5:scenario5_BA31EB28_082D_47A3_BB1A_CF08485A11A3"
msgid "⟪k:0⟫but I hadn’t been given a choice. ⟪k:1⟫I had been sent here by his family."
msgstr "⟪k:0⟫ma non mi era stata data scelta. ⟪k:1⟫Ero stata mandata lì dalla sua famiglia."

#: scenario5:scenario5_285A114B_CE40_48E8_A101_D05970835748
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 9ad9e61b607099ef7b74c5cb1843d96c914eabbf7283bdd99ff0224294b28db5
