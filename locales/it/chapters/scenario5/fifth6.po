msgctxt "scenario5:scenario5_7CAECF07_8336_4ED7_B3F0_227FF0ADDFB8"
msgid "⟪k:0⟫She had, supposedly, once been quite beautiful, but now she was only haggard and bony."
msgstr ""
"⟪k:0⟫In passato doveva esser stata una donna davvero bella,⟪k:1⟫ma a quel tempo era smunta e "
"ossuta."

#: scenario5:scenario5_EB611ACB_B35D_4124_8B3B_C13FE06A9AA1
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 94209395b55785fcff0caac2344089bf3842a5e96189a698d4ee092adc1e2e44
