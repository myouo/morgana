msgid ""
"⟪k:0⟫Yes, yes, execute her! Kill this woman! Burn the witch!⟪k:1⟫Seize the peace she’s stolen "
"from me!"
msgstr ""
"⟪k:0⟫Sì, sì, giustiziatela! Uccidete quella donna! Mettete al rogo la strega!⟪k:1⟫Sottraetele la "
"pace di cui mi ha privato!"

