msgid "⟪k:0⟫I assumed he would just stand back and watch,"
msgstr "⟪k:0⟫Pensai che sarebbe rimasto indietro a guardare,"

#: scenario5:scenario5_F8429FFA_4F5E_4833_B615_7CA650327914
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 9c596650c588d738ff8f60aaeff4c481dce8ae04d35fcf7d2f1cef66f532a844
