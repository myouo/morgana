#: scenario5:scenario5_A1A925CB_1079_4097_9984_F74FFA5128D7
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 0033d4aae04e5fb3de15ad2256b889898167675f42e462e13624fa550cd19793
#. default-sha256: f928a6d8371dc6c3e6400b41d85ad78cc508645c498c2d264fe0bb05cd1fe12b
msgctxt "scenario5:scenario5_A1A925CB_1079_4097_9984_F74FFA5128D7"
msgid ""
"⟪k:0⟫For far longer than was comfortable, the only sound we heard was the gentle crackling of the "
"fire."
msgstr ""
"⟪k:0⟫Per un lasso di tempo più lungo di quanto potessi sopportare,⟪k:1⟫l’unico suono che si udiva "
"era il dolce scoppiettio del fuoco."

#: scenario5:scenario5_2FC207D4_5BB8_4F13_8ED3_B5CC837D3D60
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 6bf96a0f94014c9f47cbcb375a1bfb7d6592ac31461f6639bc1257f15ca6ccb7
#. default-sha256: 84232618cca78abbcdf11d5f5c214ae1c1d86ff7d05d240ebb752a81bb2bc2d6
msgctxt "scenario5:scenario5_2FC207D4_5BB8_4F13_8ED3_B5CC837D3D60"
msgid "⟪k:0⟫I had to say something.⟪k:1⟫⟪k:2⟫I knew that, but what I didn’t know was how to begin."
msgstr ""
"⟪k:0⟫Dovevo dire qualcosa, di questo ne ero certo.⟪k:1⟫⟪k:2⟫Quello che non sapevo, tuttavia, era "
"come iniziare."

#: scenario5:scenario5_7636C76B_F264_44A8_B5FB_DAF40CA9AC9B
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: a7e6f7e1ef45029c3db865bc6d78afb881c989171e846edb163bedb2336a038e
#. default-sha256: 49f958ff4c5d04befbcbac45720584905de8a7b18b097b544377354426ef5a0a
msgctxt "scenario5:scenario5_7636C76B_F264_44A8_B5FB_DAF40CA9AC9B"
msgid ""
"⟪k:0⟫I knew nothing about having an honest, face-to-face discussion with someone about the things "
"we were thinking and feeling."
msgstr ""
"⟪k:0⟫Non sapevo nulla di come avere una conversazione onesta e schietta con qualcuno sulle cose "
"che pensavamo e provavamo."

#: scenario5:scenario5_4CA04C0A_498A_4B14_8295_73157439C193
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 7f3b84878b0a18ffd271bc2925969e11eed554f09a13490089fd5f19e0f8433b
#. default-sha256: 036b2c8e64e263a8715d9587cac9627399b38ecd92797965d30209f0345feb1e
msgctxt "scenario5:scenario5_4CA04C0A_498A_4B14_8295_73157439C193"
msgid "⟪k:0⟫But that didn’t change anything..."
msgstr "⟪k:0⟫Ma ciò non cambiava nulla..."

#: scenario5:scenario5_4CB3629A_C22C_48AF_B79D_4760DD361590
