#: scenario5:scenario5_3E162B84_873A_4674_91CC_E3B88D707B3F
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: b41c62410967d47b7196c18edf58a001f747e807a3493bd36438ad7a7fc058cb
#. default-sha256: 8642250fa1dbe6c233f87fccd1f9494cdea07172e576bad69f48a7c433401629
msgctxt "scenario5:scenario5_3E162B84_873A_4674_91CC_E3B88D707B3F"
msgid ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫Could you please tell me... ⟪k:3⟫what you did at—⟪k:4⟫⟪k:5⟫⟪k:6⟫no, what was done "
"to you at my family’s home,"
msgstr ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫Potresti dirmi... ⟪k:3⟫cos’hai fatto—⟪k:4⟫⟪k:5⟫⟪k:6⟫no, cosa ti è stato fatto alla "
"tenuta della mia famiglia,"

#: scenario5:scenario5_9C3B4E45_04D7_436C_93E2_3859E3D15729
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 710e74bc748c5320982055f15338aef3335990ca0d0ad50e3c4bfc272326565a
#. default-sha256: cc306f75a982ef0288c22383e761cf2be20b567b58c912b71322f09c80852bef
msgctxt "scenario5:scenario5_9C3B4E45_04D7_436C_93E2_3859E3D15729"
msgid "⟪k:0⟫how you ended up coming to this mansion,⟪k:1⟫and what happened after you left?"
msgstr "⟪k:0⟫come sei finita in questa villa,⟪k:1⟫e cos’è successo dopo che te ne sei andata?"

#: scenario5:scenario5_9DE87E9A_C5CB_4993_AD68_3A37ED68FDA5
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 927b1ad1a61d1bff52b9cabd322c121c2b5bbda73167f081f8e89a344b90ff5a
