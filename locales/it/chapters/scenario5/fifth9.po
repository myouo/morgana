#: scenario5:scenario5_0C4432C5_4125_4ADD_B0B3_F2A8BF3982BD
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 3c17645e517bcd0d0af33100729a9692afc08250dfdce814ff2e7f193a611ce4
#. default-sha256: 15214e94f5cb262030a37dff7638c689b1ebdca3f70dbebc4fff2677aa8a19a5
msgctxt "scenario5:scenario5_0C4432C5_4125_4ADD_B0B3_F2A8BF3982BD"
msgid "⟪k:0⟫⟪k:1⟫And I very much doubt...⟪k:2⟫⟪k:3⟫you will find what I have to say agreeable."
msgstr "⟪k:0⟫⟪k:1⟫E dubito fortemente...⟪k:2⟫⟪k:3⟫che troverai accettabile quello che ho da dirti."

#: scenario5:scenario5_3A40C90A_CD29_4C3F_8EC8_3B58B76D783A
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 6b5ee2cbc1d12603dd201424469cd70e533ddd2ff5ba82b4f8e0b359c99ea75d
