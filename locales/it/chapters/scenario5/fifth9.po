msgid "⟪k:0⟫I had to do it,"
msgstr "⟪k:0⟫Dovevo farlo,"

#: scenario5:scenario5_D831D3C4_8153_499F_8E4E_3289F4DFA12D
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 1f1c44870dabbb0d409dd2e5bd787e8d12df79db9d23f0ac3ba88e1741a935c7
#. default-sha256: e7eb5eb208794875c8ff38545794f312bbbad7d6d7870db34e7cc5f3da8ad435
msgctxt "scenario5:scenario5_D831D3C4_8153_499F_8E4E_3289F4DFA12D"
msgid "⟪k:0⟫even if down that road lay truths I would be happier not seeing."
msgstr ""
"⟪k:0⟫anche se in fondo a quella strada si trovavano verità che avrei preferito non conoscere."

#: scenario5:scenario5_11AD9665_548E_4721_9E8C_08EE36F08894
