msgid ""
"⟪k:0⟫(It would be terrible if the coachman rolled the carriage because he couldn’t see where we "
"were going.)"
msgstr ""
"⟪k:0⟫(Sarebbe terribile se il cocchiere facesse rotolare la carrozza perché non riusciva a vedere "
"dove stavamo andando.)"

