#: scenario5:scenario5_A1BC6589_AD46_4643_96C3_5BCB407C5728
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: d25efed459b4ce069c6311ca09f73f88cc2f0b3d6eea0345cb63509c0b62fb8d
#. default-sha256: 282507a7546f086db95a98d31d08126142409d5cc4522060bb1573ad47e852fb
msgctxt "scenario5:scenario5_A1BC6589_AD46_4643_96C3_5BCB407C5728"
msgid ""
"⟪k:0⟫If there wasn’t so much fog, I would probably have been able to see little columns of orange "
"evening sunlight fighting their way through the trees,"
msgstr ""
"⟪k:0⟫Se non ci fosse stata tutta quella nebbia, probabilmente avrei potuto vedere i fasci di luce "
"arancioni del tramonto farsi strada tra gli alberi,"

#: scenario5:scenario5_139A6283_5350_4BBB_9D26_9529B5C9F3DE
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 9194442fd18028a423748d8a2c16903a442d299a11eefb365b49354d74c73ede
#. default-sha256: 89bbd64862d39932cfa9743425e439b3c8310ddf283bdc62c6c9038ae07596c8
msgctxt "scenario5:scenario5_139A6283_5350_4BBB_9D26_9529B5C9F3DE"
msgid ""
"⟪k:0⟫but the milky white mist seemed to swallow up all the light,⟪k:1⟫leaving nothing for the "
"surrounding area."
msgstr ""
"⟪k:0⟫ma la bianca foschia pareva aver risucchiato ogni fonte di luce,⟪k:1⟫senza lasciare nulla "
"per la zona circostante."

#: scenario5:scenario5_ABF9FD7C_1F81_4AD6_A52E_98FBE2F3099A
