msgid "⟪k:0⟫He was still my master, but he allowed me almost complete freedom,"
msgstr "⟪k:0⟫Michel era ancora il mio padrone, ma mi concedeva totale libertà,"

#: scenario5:scenario5_1DC9B6EA_6289_4FA4_8355_19D0E652CBBE
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 7740387f0182a72436e65acfd9434c55fcf3bfacbfdfb13510e536a4ff7e0cae
#. default-sha256: 9031f6eec3575c023f082ad3b816d7d987fc37b851afb370fbe9b2b57f4f105f
msgctxt "scenario5:scenario5_1DC9B6EA_6289_4FA4_8355_19D0E652CBBE"
msgid "⟪k:0⟫and he didn’t order me around either.⟪k:1⟫⟪k:2⟫He even gave me a hand with my work."
msgstr "⟪k:0⟫e non mi dava nemmeno ordini.⟪k:1⟫⟪k:2⟫Inoltre mi aiutava con il lavoro."

#: scenario5:scenario5_A87FD8DF_8DC5_4511_92C2_070132823A3B
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: b3ce72ee2ae43c53040bb334cbbf0c0d10a6458966c64059908d13bb398219f1
