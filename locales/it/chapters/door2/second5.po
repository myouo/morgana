msgid "⟪k:0⟫Is anyone... ⟪k:1⟫Is anyone there?"
msgstr "⟪k:0⟫C’è qualcuno qui?"

#: scenario2:scenario2_E3B8080E_64F4_494C_8748_E633AB9B7B86
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 309710dfc9d5c996994a8398560a9e50a9e0b3199a9153f97109c6d322431ecc
#. default-sha256: ec59afc5b71c85754255bd9b03521ce575f0bb57bb990893e2da884371d232ee
msgctxt "scenario2:scenario2_E3B8080E_64F4_494C_8748_E633AB9B7B86"
msgid "⟪k:0⟫I’ve lost my way.⟪k:1⟫⟪k:2⟫Would you please be so kind as to spare me a little food?"
msgstr ""
"⟪k:0⟫Ho smarrito la strada.⟪k:1⟫⟪k:2⟫Sareste così gentili da risparmiare un po’ di cibo per me?"

#: scenario2:scenario2_393C0C24_4D7B_48DD_9E86_86F245D56355
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: c24f42acf3a4a063656b9d8fc7eb122b58ef8b66eb06b3a2b4e79ff61d109d9a
#. default-sha256: 1c62984f5c1aacd8ad7ada44ab8136de99676f1d6e72e2a9e38e180fc545f081
msgctxt "scenario2:scenario2_393C0C24_4D7B_48DD_9E86_86F245D56355"
msgid "⟪k:0⟫(Ahh, there. ⟪k:1⟫There it is.⟪k:2⟫⟪k:3⟫There comes the poor little offering.)"
msgstr "⟪k:0⟫(Ahh, finalmente. ⟪k:1⟫Eccola qui.⟪k:2⟫⟪k:3⟫La povera piccola offerta è arrivata.)"

#: scenario2:scenario2_279D4872_C4C0_47DC_8CB3_5822826870D7
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 12933e7708b2b7cd9b6b072cea5aa7f8cdb6175d34d4a6e36609d55175e5180c
#. default-sha256: 900643e6f4ee0ddaa7492928c7bcfd2d5d92e6889c9fd455c765486e460fc274
msgctxt "scenario2:scenario2_279D4872_C4C0_47DC_8CB3_5822826870D7"
msgid ""
"⟪k:0⟫(They never learn.⟪k:1⟫⟪k:2⟫They just keep coming, again and again.⟪k:3⟫⟪k:4⟫The mansion "
"keeps granting my wish.)"
msgstr ""
"⟪k:0⟫(Non imparano mai.⟪k:1⟫⟪k:2⟫Continuano ad arrivare, ancora e ancora.⟪k:3⟫⟪k:4⟫La villa "
"continua ad esaudire i miei desideri.)"

#: scenario2:scenario2_AAC6CF58_B448_4F28_812F_98CBE17BDAD9
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 7b80f5e3e1e99f5cc2d0c28e546461f05a4f70bf7775f6e143ffe6323bc8a57c
