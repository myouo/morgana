msgctxt "scenario2:scenario2_8394D3CC_BFB0_4D7E_A7C1_D56E2E6EB5CA"
msgid "⟪k:0⟫You are... ⟪k:1⟫without sight."
msgstr "⟪k:0⟫Tu... ⟪k:1⟫non ci vedi."

