msgctxt "scenario2:scenario2_13329D0F_E001_4658_8979_1CED36B9A9DC"
msgid "⟪k:0⟫(I basked in their terror.)"
msgstr "⟪k:0⟫(⟪k:1⟫Sguazzavo⟪k:2⟫ nel loro terrore.)"

#: scenario2:scenario2_CF810AEE_F1A6_4B2C_8B58_3FFE098C534E
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: d593963b86ab3ec5552e6b5216531da42c7571d897c8fbce5f6ada701a0810f0
#. default-sha256: e6f5f52c2801c6c35c18eb54fa5be8d1390478f7991beb2314b0336a783cdce6
msgctxt "scenario2:scenario2_CF810AEE_F1A6_4B2C_8B58_3FFE098C534E"
msgid "⟪k:0⟫(So why... ⟪k:1⟫Why do I not want you to find out?)"
msgstr "⟪k:0⟫(Allora perché... ⟪k:1⟫Perché non voglio che tu lo scopra?)"

#: scenario2:scenario2_B9787E55_09F7_40B2_B99F_E1824044313A
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 986dabb58a4240d6655a04bed49e1ae7ba731f61bc908c75df3116cc7fef2ffb
#. default-sha256: c6ca52f15a3e50c47f3cdfdca0757291f7626f91041b8c3dd8ed4611933aa038
msgctxt "scenario2:scenario2_B9787E55_09F7_40B2_B99F_E1824044313A"
msgid ""
"⟪k:0⟫(I don’t want you to know how many people I’ve tortured,⟪k:1⟫how many I’ve slaughtered, how "
"much blood I’ve imbibed...)"
msgstr ""
"⟪k:0⟫(Non voglio che tu sappia quanta gente ho torturato,⟪k:1⟫quanta gente ho massacrato, quanto "
"sangue ho bevuto...)"

#: scenario2:scenario2_FF7D2F93_0EE1_4904_82BC_CFBF1E4C29EF
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 430350e169078761fc2edcbb0ea4a99d5483dfcd7c57835096ca475af625efec
