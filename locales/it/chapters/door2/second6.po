msgid "⟪k:0⟫⟪k:1⟫No... ⟪k:2⟫y-⟪k:3⟫you do not."
msgstr "⟪k:0⟫⟪k:1⟫No... ⟪k:2⟫d-⟪k:3⟫direi di no."

#: scenario2:scenario2_FA13F74E_6111_4089_8272_900D124FD583
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: b76b42f77e190d7901553c6ae8ffaf4db03636a3c1d10106678c335f2d738a9a
#. default-sha256: 66ca9ea4cdadb472447120bf4e938908954f0fb54a63a064ebbd20bf6263f374
msgctxt "scenario2:scenario2_FA13F74E_6111_4089_8272_900D124FD583"
msgid ""
"⟪k:0⟫(But you ⟪k:1⟫would⟪k:2⟫. ⟪k:3⟫If you could see me,⟪k:4⟫you would react the same as everyone "
"else.⟪k:5⟫⟪k:6⟫You would mock me; ⟪k:7⟫you would despise me;⟪k:8⟫you would want to kill me.)"
msgstr ""
"⟪k:0⟫(Ma ⟪k:1⟫l’avresti⟪k:2⟫.⟪k:3⟫⟪k:4⟫Se potessi vedermi, reagiresti come chiunque altro.⟪k:5⟫"
"⟪k:6⟫Mi offenderesti; ⟪k:7⟫mi disprezzeresti; ⟪k:8⟫vorresti uccidermi.)"

#: scenario2:scenario2_ADED7667_51B0_42A8_966B_728429B71DF1
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: d0e48e8f50dfd9918cfa10affaf0d9c672c56cde4993748fbd8db7ee28482b2d
#. default-sha256: 363516c3d80c6c7dd4446689b3509d224d35efdddf27f299e5a35b6bfcfa701a
msgctxt "scenario2:scenario2_ADED7667_51B0_42A8_966B_728429B71DF1"
msgid "⟪k:0⟫(You don’t know what I’ve done, because you can’t see.)"
msgstr "⟪k:0⟫(Non sai cosa ho fatto, perché non riesci a vedere.)"

#: scenario2:scenario2_5FDA6BE2_1924_4963_BEDA_BF537EC984FF
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: b788928dc1066eee870560d3f461431aac77e07a66505269d202346609a1f77b
