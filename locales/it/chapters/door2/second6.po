msgctxt "scenario2:scenario2_215A2D46_B2AB_4C00_8D11_BCA5D5A8AF86"
msgid "⟪k:0⟫(But I relished in it...)"
msgstr "⟪k:0⟫(Eppure ne godevo...)"

#: scenario2:scenario2_B81F4DF4_2CAE_4BFB_9662_057572CF1458
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: cf80655be9322553ab2c0c870ee78a485efd784c11d8cfe84a050dc21dc6d12f
#. default-sha256: 87cf6757392697dd4fafd1670753dbf75adf252851e1fca7792629dab1de98c3
msgctxt "scenario2:scenario2_B81F4DF4_2CAE_4BFB_9662_057572CF1458"
msgid "⟪k:0⟫(I wanted... ⟪k:1⟫for so long... ⟪k:2⟫to slaughter them...)"
msgstr "⟪k:0⟫(Volevo massacrarli... ⟪k:1⟫da così tanto tempo...)"

#: scenario2:scenario2_5AA9AE97_F7A2_4AFA_A2FD_3B7BBDA70572
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 2734511795a56acd57cfaaa94f742c26a79e993c862cb6ac3eecd8bc73dea630
#. default-sha256: e583a334602e605bc150cd1e5d7561af5fd3691a71ce300a74231a20860d07d4
msgctxt "scenario2:scenario2_5AA9AE97_F7A2_4AFA_A2FD_3B7BBDA70572"
msgid "⟪k:0⟫(I desperately desired to see blood—⟪k:1⟫⟪k:2⟫human blood...)"
msgstr "⟪k:0⟫(Bramavo disperatamente la vista del sangue—⟪k:1⟫⟪k:2⟫del sangue umano...)"

#: scenario2:scenario2_D48F470C_5E20_4CC0_84F6_388845B1A72F
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: cbebd4c9372290902ce433f4fd8a80faf444761ce133a7b6d18b69aab1fce574
#. default-sha256: 594ecabc777e9efeeab5cbb60b8d213a40bdbc3cd4eb3f04499c29aae9cddf67
msgctxt "scenario2:scenario2_D48F470C_5E20_4CC0_84F6_388845B1A72F"
msgid "⟪k:0⟫(What is it I crave? Murder? Or laughter?)"
msgstr "⟪k:0⟫(Cos’è che desidero così ardentemente? Uccidere? O ridere di gusto?)"

#: scenario2:scenario2_47464B74_3291_424D_B8E6_799F589CED24
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 1d656f09e88408f2b2ee1278c9f19c3a2321356c5da32a1d3d71dad724c99765
