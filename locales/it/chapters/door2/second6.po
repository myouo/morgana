msgctxt "scenario2:scenario2_5FDA6BE2_1924_4963_BEDA_BF537EC984FF"
msgid "⟪k:0⟫(I ⟪k:1⟫enjoyed⟪k:2⟫ it.)"
msgstr "⟪k:0⟫(Mi piaceva.)"

#: scenario2:scenario2_13329D0F_E001_4658_8979_1CED36B9A9DC
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 994e10f18365d998a8f0074f686770caa3eff15a88551e04ac47f3af9582ed10
