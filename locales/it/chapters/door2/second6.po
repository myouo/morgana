#: scenario2:scenario2_BCBD67FC_A76D_41C8_85A8_CB3C53F9EF2D
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 269921bae659ccdb95bd20d489d8badd4478746db4ccf690a9e5b059bdf5b3f7
#. default-sha256: 57e3496f2f17cac87e899fd02f1afeea3b0c4860abd55c9c2ca9994c391edc22
msgctxt "scenario2:scenario2_BCBD67FC_A76D_41C8_85A8_CB3C53F9EF2D"
msgid "⟪k:0⟫⟪k:1⟫...What is the matter?"
msgstr "⟪k:0⟫⟪k:1⟫...Cosa c’è?"

#: scenario2:scenario2_B5BD6D06_AAF2_49FD_BAD8_8B3BA4A5AD55
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: fb06515e66168005607af51f47a3642c1c79cd935088dc95c528cb2ce0f8894b
#. default-sha256: 7a5111f188b5466a04ebddb888f65a3daea8406ca93c6baea3f2770e3a304d81
msgctxt "scenario2:scenario2_B5BD6D06_AAF2_49FD_BAD8_8B3BA4A5AD55"
msgid "⟪k:0⟫⟪k:1⟫Do you honestly not fear me?"
msgstr "⟪k:0⟫⟪k:1⟫Davvero non hai paura di me?"

#: scenario2:scenario2_FB16E62F_6D73_4768_AC4F_888E6DAFFCCD
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: cbb2cb1c82a9be63aa53af0e1114aa80ce03648cc2b1b0870b7df17a2f49def5
