msgid "⟪k:0⟫⟪k:1⟫Do I appear to be afraid of you?"
msgstr "⟪k:0⟫⟪k:1⟫Ti sembra che ne abbia?"

#: scenario2:scenario2_819774A8_0F00_452F_8CA5_49691425E1DE
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 2855db3de928533989b9aad2730c9ad70134b8e52e797c6bdde415486619906d
