msgstr "⟪k:0⟫⟪k:1⟫No, ⟪k:2⟫ehm... ⟪k:3⟫del tè."

#: scenario2:scenario2_EC7C9912_7445_4D8E_B611_A08CA62ACB9D
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: b6ad331efa1738e8a4262249d2fcc706469c55f6d135bb94645c283b1effd518
#. default-sha256: feed357af6efd17f31230d7650258cd954e3009672f56353c8a4072e3fd36d33
msgctxt "scenario2:scenario2_EC7C9912_7445_4D8E_B611_A08CA62ACB9D"
msgid "⟪k:0⟫⟪k:1⟫Oh, shall I make some?⟪k:2⟫⟪k:3⟫Are you thirsty?"
msgstr "⟪k:0⟫⟪k:1⟫Oh, devo prepararne un po’?⟪k:2⟫⟪k:3⟫Hai sete?"

#: scenario2:scenario2_0A5D7881_668B_43CC_85AE_41D744B01457
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: e1a54f56d15e8bc3c2b7f21f52ab9e77e67ff3231ae7be4ac29755f61af9b30f
