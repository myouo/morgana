msgctxt "scenario2:scenario2_FF7D2F93_0EE1_4904_82BC_CFBF1E4C29EF"
msgid "⟪k:0⟫(all the horrible things I’ve done.)"
msgstr "⟪k:0⟫(tutte le cose orribili che ho fatto.)"

#: scenario2:scenario2_0A61BE1F_38C0_4EDA_BF3F_E5B5FACFAD54
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 152fad8d387b4de6eead6b7b3a4b9e3a2348e19eb176b20f3ab84c23b431bd16
