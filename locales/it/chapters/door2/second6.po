msgctxt "scenario2:scenario2_0A61BE1F_38C0_4EDA_BF3F_E5B5FACFAD54"
msgid "⟪k:0⟫(“Horrible”? I’m ⟪k:1⟫aware⟪k:2⟫ that what I’ve done is wrong?)"
msgstr "⟪k:0⟫(“Orribili”? Sono ⟪k:1⟫consapevole⟪k:2⟫ che ciò che ho fatto è sbagliato?)"

#: scenario2:scenario2_215A2D46_B2AB_4C00_8D11_BCA5D5A8AF86
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: d8ae2603b433982a54ffd261ffc5da002a5428e94c1ff026fb676a350d128d6f
