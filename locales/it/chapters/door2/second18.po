msgid ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫Her once-porcelain skin was no longer even sickly pale; ⟪k:4⟫it was now the "
"bloodless color of dirt."
msgstr ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫La sua pelle di porcellana non era più pallida; ⟪k:4⟫aveva il colore esangue "
"del marcio."

#: scenario2:scenario2_A1EC3F07_1EE7_43DF_A689_6A4096078902
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: bf7223b56aef7bd24ad8969d69fa81b928db6cca0a5f79d744abb248fe269939
#. default-sha256: 6c9d4a92cd8775225b021e264b0f2fe5de865283c5a35bc34901588efa2fdb89
msgctxt "scenario2:scenario2_A1EC3F07_1EE7_43DF_A689_6A4096078902"
msgid ""
"⟪k:0⟫She was sprawled haphazardly out on the cellar floor, dried blood stains around her half-"
"open mouth."
msgstr ""
"⟪k:0⟫Era distesa a caso sul pavimento della cantina, con macchie di sangue secche attorno alla "
"bocca semiaperta."

#: scenario2:scenario2_32C72CC7_B3DD_449E_92AE_11F7B5E9653C
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: fc310591baaac813d4d91c5831ef36e9775b5c8a39b503325047ee82eba4e2cc
#. default-sha256: 87d1fac44d1e03aa977ad9315e1caca3e515ee1227eafd2ed06519c27e8aeb0c
