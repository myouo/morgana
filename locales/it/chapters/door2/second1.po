#: scenario2:scenario2_AEB55A95_70E2_450A_BD31_2C12B010A75E
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 006297b31ac04b1f7d1ad8bbcbd9d98ac2da489600c057d36dd225d142dd3296
#. default-sha256: f4bc50a640579a7073c891b96adb1acb088fb9f9e94f00761e9327851733bf78
msgctxt "scenario2:scenario2_AEB55A95_70E2_450A_BD31_2C12B010A75E"
msgid "⟪k:0⟫⟪k:1⟫Oh dear, I was afraid you wouldn’t understand me.⟪k:2⟫⟪k:3⟫What am I to do?"
msgstr "⟪k:0⟫⟪k:1⟫Oh cielo, temevo che non mi avresti capito.⟪k:2⟫⟪k:3⟫Che cosa devo fare?"

#: scenario2:scenario2_47547A2F_83BE_4437_861A_9135AF6DFC45
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 5783456fb9df90a7fa7dd29ee7024d0fcf0bce0960bb7f2db95e4107a6ee2d97
#. default-sha256: 87c1404b98e1c9b3f4603b3439e2292ccae71bb95c9c265ca6bdddd59442f487
msgctxt "scenario2:scenario2_47547A2F_83BE_4437_861A_9135AF6DFC45"
msgid "⟪k:0⟫I was in quite the predicament."
msgstr "⟪k:0⟫Era proprio un bel guaio."

#: scenario2:scenario2_9BDF0362_1EAE_4AA9_B4BF_FC6AADF9D3D7
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: e871730882e12270758a1d00b648707a761abc6737e6a7f3d03d1f91a24582bc
#. default-sha256: 311a92ada64407d07d810b915d0832b138a4d54408418dbdda254070a9378df0
msgctxt "scenario2:scenario2_9BDF0362_1EAE_4AA9_B4BF_FC6AADF9D3D7"
msgid ""
"⟪k:0⟫Nevertheless, it meant a great deal to me then that I had found someone who did not fear the "
"mansion—⟪k:1⟫⟪k:2⟫be they human or beast."
msgstr ""
"⟪k:0⟫Ciò nonostante, significava molto per me aver trovato qualcuno che non temeva la villa—⟪k:1⟫"
"⟪k:2⟫che fosse un umano o una bestia."

#: scenario2:scenario2_9DE01657_F670_4BDB_9C2B_AD22BF342A8E
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 25e4a86935a9a2f0306ce8a7dcf842c4d2c6defec73614787750dfbc2a4b46f8
#. default-sha256: 9c579a282c332115fff63b39777178c41c7d824e988bffd0cb1ce4bb474efe90
msgctxt "scenario2:scenario2_9DE01657_F670_4BDB_9C2B_AD22BF342A8E"
msgid "⟪k:0⟫So I decided I should give him my assistance, while doing my best not to agitate him."
msgstr "⟪k:0⟫Così decisi di assisterlo, facendo del mio meglio per non agitarlo."

#: scenario2:scenario2_BB096FB2_47A4_4E8A_BB42_866D2BD0EEDD
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 2612706de7a4941447a568b906f85bb30317f7a28e03ac3483d850265317f29b
