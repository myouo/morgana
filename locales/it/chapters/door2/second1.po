msgid "⟪k:0⟫⟪k:1⟫Say... ⟪k:2⟫could you, perchance... ⟪k:3⟫be my new master?"
msgstr "⟪k:0⟫⟪k:1⟫Dimmi... ⟪k:2⟫per caso, vorresti diventare... ⟪k:3⟫il mio nuovo padrone?"
