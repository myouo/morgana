msgid "⟪k:0⟫×××××××××××××××××××××⟪k:1⟫⟪k:2⟫⟪k:3⟫"
msgstr "⟪k:0⟫×××××××××××××××××××××⟪k:1⟫⟪k:2⟫⟪k:3⟫"

#: scenario2:scenario2_D0AD09AE_120B_46E6_95B8_2C114A440F45
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: ae32a5f456a7e462df212d9137fdfafaca9e42842ac28a7e8e1fc256594c8c38
#. default-sha256: fd2b993ec523aa8872a1d2aaa5ef1ae62790e2324c4ee26514ed90bce47056fe
msgctxt "scenario2:scenario2_D0AD09AE_120B_46E6_95B8_2C114A440F45"
msgid "⟪k:0⟫⟪k:1⟫⟪k:2⟫Oh my.⟪k:3⟫This is quite something."
msgstr "⟪k:0⟫⟪k:1⟫⟪k:2⟫Oh cielo.⟪k:3⟫Questo sì che è insolito."

#: scenario2:scenario2_7D398619_A634_4060_A0C0_05D4DFC99173
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: ebf005dfa63a97cbe3c762cc15c3fe3dc5c3d6c8b91569bf7187290f4cd6b636
