#: scenario2:scenario2_111F5064_ADFE_466A_A14C_A75FD5928ADF
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: d30c88d57eae2c3e498910efc3e16e5c6d17e94cfdafbcdaf84905a7a82d0a83
#. default-sha256: 417926ead840d6bad3e4cfb70afcec988e0686e0dd8e8e54f543fd71d865501f
msgctxt "scenario2:scenario2_111F5064_ADFE_466A_A14C_A75FD5928ADF"
msgid "⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫⟪k:4⟫⟪k:5⟫⟪k:6⟫⟪k:7⟫⟪k:8⟫...Master. Master."
msgstr "⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫⟪k:4⟫⟪k:5⟫⟪k:6⟫⟪k:7⟫⟪k:8⟫...Padrone. Padrone."

#: scenario2:scenario2_11F56EE0_9C38_4F29_B74A_6FCC8A325BC3
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 0814245b791f1110e0ed8cd5197e4c3619d66d95993a987c37d4ba6a1d2ddee4
#. default-sha256: 7576c41b502bbcc7d91054c23c015effa280b66d11fbd97e3c26a357b8253161
msgctxt "scenario2:scenario2_11F56EE0_9C38_4F29_B74A_6FCC8A325BC3"
msgid "⟪k:0⟫Ahh... ⟪k:1⟫you have awakened. ⟪k:2⟫You gave me quite the startle."
msgstr "⟪k:0⟫Ahh... ⟪k:1⟫finalmente ha ripreso conoscenza. ⟪k:2⟫Mi ha spaventata."

#: scenario2:scenario2_89EE87C6_5B9A_4A0A_A1DF_5919B15040CC
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: bb6cec6a6ea0f30ef3d76976452e90df6c7786bfacafeac92a2259b14c037065
#. default-sha256: 64d02b65f305e0e47c6f1c95a6736eaf06b99fa20698f86eabead5a5cd449e97
msgctxt "scenario2:scenario2_89EE87C6_5B9A_4A0A_A1DF_5919B15040CC"
msgid ""
"⟪k:0⟫Do you not remember? ⟪k:1⟫You suddenly started staring off into the distance, and you would "
"not respond to anything I said."
msgstr ""
"⟪k:0⟫Non si ricorda? ⟪k:1⟫Aveva improvvisamente iniziato a fissare il vuoto, senza reagire "
"minimamente a ciò che le dicevo."

#: scenario2:scenario2_1CC76CC7_F747_47C2_8887_23081832279C
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: a766562df5482614d4d7387c89bf387457cbebc7ff18af452ba23d3c51ba0903
#. default-sha256: fa0dd8636fc2e8b7a2d169b39c3f5507addf9ee097462fb19f8ceff0b026904f
msgctxt "scenario2:scenario2_1CC76CC7_F747_47C2_8887_23081832279C"
msgid "⟪k:0⟫Hehe. I thought you were playing a prank on me."
msgstr "⟪k:0⟫Hehe. Ho pensato che volesse farmi uno scherzo."

#: scenario2:scenario2_1AD64425_BDF5_4EA6_9999_FD49546236A4
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 03a077239f0a7a00aca2e8d1651556cd0ff26da7108c3312c075e8a8ba887760
#. default-sha256: 03cabb447bc2a553283ebf359613bfd5d7fc80a61ff55e91a6b78744d4fb042e
msgctxt "scenario2:scenario2_1AD64425_BDF5_4EA6_9999_FD49546236A4"
msgid "⟪k:0⟫Your hand? ⟪k:1⟫Oh, yes, I did not let go of it."
msgstr "⟪k:0⟫La sua mano? ⟪k:1⟫Oh, sì, non l’ho mai lasciata."

#: scenario2:scenario2_1A399BDF_5BE1_4A36_AB0A_D560CD523861
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 3c02427322b6fc3fc8f04f5e96008acfeb3be8b02bc34bc7efe99f1d1b42472c
#. default-sha256: 1fc1f6ac673c5c0494d1acdc8cfc136412ec8c607ac06db1b67b52df668b0ac8
msgctxt "scenario2:scenario2_1A399BDF_5BE1_4A36_AB0A_D560CD523861"
msgid "⟪k:0⟫For if I had, we would be in quite the predicament."
msgstr "⟪k:0⟫Se l’avessi fatto, sarebbe stato un bel guaio."

#: scenario2:scenario2_F848F63F_7A17_4B90_B2F5_A318014EACD6
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 10f51f896928e64a613ca477f3c1ada3b796fed0ba07d1316ff73d7f0b03a1fa
#. default-sha256: 4e8eb4ddbb246dcc93447c3ff6f98aff11904625d9e91157d6e066fd7fa0ab8e
msgctxt "scenario2:scenario2_F848F63F_7A17_4B90_B2F5_A318014EACD6"
msgid "⟪k:0⟫Someone approaching the mansion, you say? ⟪k:1⟫You saw them?"
msgstr "⟪k:0⟫Delle persone che si avvicinavano alla villa, dice? ⟪k:1⟫Le ha viste?"

#: scenario2:scenario2_A1598863_CBF6_41E4_BCFE_3F9793B411E7
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: a614a68c29eccb59c9fc19607106dea263305168a488ef8093b69c54ee33b2a3
#. default-sha256: a51498d3d34cc028e24cb593232b2ae9607a4077e097449e233950db6a222dc2
msgctxt "scenario2:scenario2_A1598863_CBF6_41E4_BCFE_3F9793B411E7"
msgid ""
"⟪k:0⟫Those images... ⟪k:1⟫were not shown to you by me. ⟪k:2⟫If you saw something, then it was by "
"your own powers."
msgstr ""
"⟪k:0⟫Quelle immagini... ⟪k:1⟫non le sono state mostrate da me.⟪k:2⟫⟪k:3⟫Se ha visto qualcosa, è "
"stato grazie alla sua forza."

#: scenario2:scenario2_71F90BF4_07DD_4E07_A132_1B71D3313736
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: ec80ca29d27f3d1a162a85a585ed74023402b0673629f205a8882474b5389726
#. default-sha256: 653a0e95d0a08e01a8174613a0ea1115dab3dc522b84506df3b5dd0c1393948e
msgctxt "scenario2:scenario2_71F90BF4_07DD_4E07_A132_1B71D3313736"
msgid "⟪k:0⟫But if you think about it, that is nothing unusual."
msgstr "⟪k:0⟫Ma se ci pensa, non c’è nulla di strano."

#: scenario2:scenario2_2BC8B724_D335_4767_B5CD_FCB8966C49A9
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 3c9ae624f0383eff05ae532b903ca132bd52e341778d8c720d7535dd122faaf3
#. default-sha256: f538e2511df98b5de26dc0b77cb34e3b1c1f6793f33133b507c347c358f81803
msgctxt "scenario2:scenario2_2BC8B724_D335_4767_B5CD_FCB8966C49A9"
msgid "⟪k:0⟫You are, after all, the master of this house."
msgstr "⟪k:0⟫Dopotutto, lei è il padrone di questa casa."

#: scenario2:scenario2_1B8C40FB_85CC_4FE2_AC7E_E24F642F5E44
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 29e71105c457d8a3c6c2cf1bd329cbf79a60d0a6ce6e7f1c3d4a8b0a619fa048
#. default-sha256: 38710c7144a67ffe616dcec6953193956e3ab6456e9bf0b448e5b83b705c28d3
msgctxt "scenario2:scenario2_1B8C40FB_85CC_4FE2_AC7E_E24F642F5E44"
msgid "⟪k:0⟫You should, in all actuality, be able to do anything I can do by yourself, Master."
msgstr "⟪k:0⟫In realtà, lei sarebbe in grado di fare qualunque cosa senza alcun aiuto, Padrone."

#: scenario2:scenario2_7E71B94D_DC7F_4E9D_A51F_AD26D219E9FC
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: c94eee06b8c9a0575760cd89ce31e39af996c221650ddd40604af2e72e3b636d
#. default-sha256: c2649c5dc4e3792a020ce1e8c00011c8a1dacddc360c577881a69b108f21d43b
msgctxt "scenario2:scenario2_7E71B94D_DC7F_4E9D_A51F_AD26D219E9FC"
msgid "⟪k:0⟫So it is very possible you could have knowledge that I do not."
msgstr "⟪k:0⟫Dunque è possibile che lei sappia più cose di me."

#: scenario2:scenario2_6E2FABCA_9F64_48A0_B7E6_6CD0ADBD4555
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 561bc561224bfda5de542e7efffb2eb6bcfa2eddd332f5840b916b8c1ad0cc30
#. default-sha256: d6d91336ec08f87ecaa202ce6cf363dd2d6763b032fb572bfbfee40804703aa9
msgctxt "scenario2:scenario2_6E2FABCA_9F64_48A0_B7E6_6CD0ADBD4555"
msgid "⟪k:0⟫Now, let us return to the mansion’s tale."
msgstr "⟪k:0⟫Torniamo adesso al racconto della villa."

#: scenario2:scenario2_0F1BEE93_B1C4_4A09_B39D_E7D9E7B6F528
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 5987511e2e74f229842521daa683604a2d7d264f450551ea66f30a1e9a87dac6
#. default-sha256: 99b4fa4766d1eb3b588c7744587574dfdaf6d64225eecd2899de9afe330234d0
msgctxt "scenario2:scenario2_0F1BEE93_B1C4_4A09_B39D_E7D9E7B6F528"
msgid "⟪k:0⟫After the second beast paid a visit, Bestia began to destabilize again."
msgstr "⟪k:0⟫Dopo la visita della seconda bestia, Bestia iniziò a destabilizzarsi nuovamente."

#: scenario2:scenario2_9192764E_EBB3_456D_8944_942876725FB3
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 3aabc4baa744406f399d7d0e89fd82232dba4a7f994e971a80539493d293e225
#. default-sha256: a4b7a7a1977d19e4cbff6a3095e5b2ad45a1fc21d12bc9812f0b34a2ac65aca0
msgctxt "scenario2:scenario2_9192764E_EBB3_456D_8944_942876725FB3"
msgid "⟪k:0⟫The White-Haired Girl would soothe his heart, but the calm was only ephemeral."
msgstr ""
"⟪k:0⟫La Ragazza dai Capelli Bianchi avrebbe dato sollievo al suo cuore,⟪k:1⟫ma la calma sarebbe "
"stata solamente passeggera."

#: scenario2:scenario2_E9596033_9464_4E27_AE7A_5F6978E107B7
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 1f8fadccdf152d64865302ea8026cb02931e8e08b4cabb0d3c6f175a6ba5746d
#. default-sha256: cbb637757fbb027e68d70525da23b89dab30f7a4b821db2c01203cdbf626e8f3
msgctxt "scenario2:scenario2_E9596033_9464_4E27_AE7A_5F6978E107B7"
msgid "⟪k:0⟫He was like a cracked glass ball."
msgstr "⟪k:0⟫Lui era come un bicchiere di vetro crepato."

#: scenario2:scenario2_A0605F8E_692A_4C13_9EBC_6804BCFE93B3
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 059bbc1ae0ff00d0f45aa26860b0c8acf0bd1fa0633c546ed7dc709dcd39eff3
#. default-sha256: f68b00240d18d9d917ee0d0779465bfca6954f8565413a5463a45c22a46e81a4
msgctxt "scenario2:scenario2_A0605F8E_692A_4C13_9EBC_6804BCFE93B3"
msgid ""
"⟪k:0⟫If you dropped him, that would be the end. ⟪k:1⟫If you put too much force into handling him, "
"he would shatter. ⟪k:2⟫He was very difficult to care for."
msgstr ""
"⟪k:0⟫Se lo si fosse lasciato, mollando la presa, sarebbe stata la fine.⟪k:1⟫⟪k:2⟫Se lo si fosse "
"tenuto in mano con troppa forza, si sarebbe frantumato. ⟪k:3⟫Era molto difficile prendersene cura."

#: scenario2:scenario2_0B4F9443_56C3_456D_B951_B6010DA695FE
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: aa31de51add5b0c66d70c68ddbfe29244adfd04427dc1098edae3e02b1e8eaf6
#. default-sha256: 0258e96aaf3daa5484d94b53eb04ff08dbe0c43e010990fa180f48a69d8a8e3b
msgctxt "scenario2:scenario2_0B4F9443_56C3_456D_B951_B6010DA695FE"
msgid ""
"⟪k:0⟫And cracks do not heal. ⟪k:1⟫The damage still remains, even if the two sides appear to be "
"held together firmly in place."
msgstr ""
"⟪k:0⟫E le crepe non guariscono. ⟪k:1⟫Il danno rimane, anche se le due parti sembrano essere "
"tenute insieme, saldamente in posizione."

#: scenario2:scenario2_5A7A7FC0_467A_41A0_9F25_8AB72A3349B6
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: a14b6e7a43b48f5fb5dbbcb576e5b2573ceeb913d1cd280fd43fe881228eb51f
#. default-sha256: 0f869a5ff7a6922224146e3a52bddcc55979ae80cb8d1820724a6c02f6b63e27
msgctxt "scenario2:scenario2_5A7A7FC0_467A_41A0_9F25_8AB72A3349B6"
msgid "⟪k:0⟫Furthermore, they slowly, gradually, and without intervention spread."
msgstr ""
"⟪k:0⟫Oltretutto, le crepe si estendono, lentamente, gradualmente,⟪k:1⟫senza alcun intervento."

#: scenario2:scenario2_F3BEFB24_9F16_4AFE_BBF4_CCCC02D9858D
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 20809279d7dcfb693c4f6de27c56ef0eab8d58b9c25556f1baf174cbec9a0764
#. default-sha256: 2026ab5f07f9fba2d59c6cc22fcc680a42cb8c4e8c4fd6a4cd964682489bce66
msgctxt "scenario2:scenario2_F3BEFB24_9F16_4AFE_BBF4_CCCC02D9858D"
msgid "⟪k:0⟫The beast appeared to be afraid of someone’s voice."
msgstr "⟪k:0⟫La bestia sembrava aver paura della voce di qualcuno."

#: scenario2:scenario2_3CCE8F83_81C4_47D8_99D2_C77A99D5C210
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: aa2c98a02234e958cfedd11f9e6e47b1d1e7a9639f968faf738eeb38751f0f30
#. default-sha256: e08e2df6ff6f0a8301bf31c78241d299f9ef20de3e45d7aecb8460f7a615fe6a
msgctxt "scenario2:scenario2_3CCE8F83_81C4_47D8_99D2_C77A99D5C210"
msgid "⟪k:0⟫He would on occasion stare into empty space and shout, cover his ears, and groan."
msgstr "⟪k:0⟫Ogni tanto fissava lo spazio vuoto e gridava, si copriva le orecchie,⟪k:1⟫e gemeva."

#: scenario2:scenario2_3602D6A7_C211_42BD_B283_E0DEACB10FD7
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 55f86559ed056ce2c8949489991bead23f565aeeafd378016059ed92a947874b
#. default-sha256: 9f28971d92b67aa2dc9b399270ef230a47c89c94c511a33adfd6732b3d5cfee0
msgctxt "scenario2:scenario2_3602D6A7_C211_42BD_B283_E0DEACB10FD7"
msgid ""
"⟪k:0⟫One day, he shattered all the windows in the mansion, crushed the silverware I had just "
"polished to a shine..."
msgstr ""
"⟪k:0⟫Un giorno, frantumò tutte le finestre della villa, distrusse l’argenteria che avevo appena "
"lucidato..."

#: scenario2:scenario2_E717A328_7A1E_4C98_AEC3_5BA798EE0BCD
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: ea69317e4a61ea45e1a4e21d8f6fad94cf0d5f701efa7accaec0dad2c9a4615d
#. default-sha256: cbcbc82a469273f1808a7a0fa33dcda33797b6d7fc1392f60c717bd68cc9de19
msgctxt "scenario2:scenario2_E717A328_7A1E_4C98_AEC3_5BA798EE0BCD"
msgid "⟪k:0⟫and destroyed all the mirrors."
msgstr "⟪k:0⟫e ruppe tutti gli specchi."

#: scenario2:scenario2_3D6268C8_5E43_4895_85B3_41C34C8C23E7
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: c19dceec1356013637251b848fbf3158d64e03c6aacad3666f4e88cf34d2195b
#. default-sha256: d639fe998e2f17cd86e6eb82734d86db3e5a29a3153e8ad37562e1ca34b9204d
msgctxt "scenario2:scenario2_3D6268C8_5E43_4895_85B3_41C34C8C23E7"
msgid "⟪k:0⟫I assume he did not want to see his beastly self."
msgstr "⟪k:0⟫Immagino che non volesse vedere la propria immagine bestiale."

#: scenario2:scenario2_E6660BE9_C4A9_4F2A_900C_9387CC154EA2
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 6c1c51c068c099cb505d1ad2dd3282ea841cf2fc04ba4cb22a725f3ad83dda45
#. default-sha256: 44c626cef95d4c498170ce9075639aebe052bc6f33d5994dbeb872627b23f0c0
msgctxt "scenario2:scenario2_E6660BE9_C4A9_4F2A_900C_9387CC154EA2"
msgid ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫⟪k:4⟫⟪k:5⟫⟪k:6⟫⟪k:7⟫⟪k:8⟫⟪k:9⟫More... ⟪k:10⟫There’s more!⟪k:11⟫⟪k:12⟫There’s "
"still more that reflects my image!"
msgstr ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫⟪k:4⟫⟪k:5⟫⟪k:6⟫⟪k:7⟫⟪k:8⟫⟪k:9⟫Ancora... ⟪k:10⟫Ce ne sono ancora!⟪k:11⟫⟪k:12⟫"
"C’è ancora altro che riflette la mia immagine!"

#: scenario2:scenario2_0E8A774D_89D2_40BB_B08E_32EBA92EA1AD
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 546d1663d52cc474787091d924e841a750f46abef4dc495f36684bfe2ab24368
#. default-sha256: 08b1174cdfa6c9ecee513463eed87c84b6cd9fafca944fb3f977767a4ff743f4
msgctxt "scenario2:scenario2_0E8A774D_89D2_40BB_B08E_32EBA92EA1AD"
msgid "⟪k:0⟫Windows! Mirrors! Vases! Dishes!⟪k:1⟫They all show my reflection!"
msgstr "⟪k:0⟫Finestre! Specchi! Vasi! Piatti!⟪k:1⟫Mostrano tutti il mio riflesso!"

#: scenario2:scenario2_30E1C98F_85D0_415D_9596_F850209C4998
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: df4c7b63e4f4bd4c6bdbe6c2bbc88a91ed487dcadbd8215932900dc6ee406607
#. default-sha256: 6dc25f595218ae335773b8cdb232c039c62934e87ea19b71dadf74c9da71e55d
msgctxt "scenario2:scenario2_30E1C98F_85D0_415D_9596_F850209C4998"
msgid "⟪k:0⟫⟪k:1⟫⟪k:2⟫Wh-⟪k:3⟫What are you doing?"
msgstr "⟪k:0⟫⟪k:1⟫⟪k:2⟫C-⟪k:3⟫Cosa stai facendo?"

#: scenario2:scenario2_F54E30E6_55AA_42BA_AD2E_92886CDE897F
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 402fe3cbc3292a2568531f93c7d72096bd617a038751bfaa218f56c40ddd803f
#. default-sha256: cc59b93f312e74ad8313b39942d9c957df3954d4ea2257d3051d8f7669e92fef
msgctxt "scenario2:scenario2_F54E30E6_55AA_42BA_AD2E_92886CDE897F"
msgid ""
"⟪k:0⟫⟪k:1⟫I have no need of anything that reflects me!⟪k:2⟫You can understand that, can’t you?!"
msgstr "⟪k:0⟫⟪k:1⟫Non ho bisogno di qualcosa che mi rifletta!⟪k:2⟫Riesci a capirlo questo, vero?!"

