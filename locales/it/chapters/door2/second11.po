msgid "⟪k:0⟫⟪k:1⟫The heat was searing."
msgstr "⟪k:0⟫⟪k:1⟫Il clima era bollente."

#: scenario2:scenario2_CFD43D05_666D_4CA7_A856_FF12D3099C17
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 60b657463b71c76e374c68a0f05ac71d57091f21520be1beb7fdfb1c3f5227b0
