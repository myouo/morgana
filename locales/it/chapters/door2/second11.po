msgctxt "scenario2:scenario2_8CB2E2B1_B83D_435B_B406_C5A1239B2153"
msgid "⟪k:0⟫⟪k:1⟫Mmm..."
msgstr "⟪k:0⟫⟪k:1⟫Mmm..."

#: scenario2:scenario2_59EC1995_9F69_4928_B63F_A488984FD7D5
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 2540d4a9c4c7a2653b39dabd1a0c7d1edc515ad2bb76559fe56fdd65cff54217
#. default-sha256: dcca058223ea4c7edb1b34fe402275d0a5a4a69218841e57b74ee4f44d375e86
msgctxt "scenario2:scenario2_59EC1995_9F69_4928_B63F_A488984FD7D5"
msgid "⟪k:0⟫It’s hot."
msgstr "⟪k:0⟫Fa caldo."

#: scenario2:scenario2_48688F6C_4A2D_4F6F_8035_0F50B05DBDCA
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: b54ff6e381854316d5454e550f863582d0ffb0a8901cae5d3fb8d9dd89c07dba
#. default-sha256: 0f04dd246f245308dbec1b4ebb1b3a6f36f8b9b137c405a0d5366c8469f0484f
msgctxt "scenario2:scenario2_48688F6C_4A2D_4F6F_8035_0F50B05DBDCA"
msgid ""
"⟪k:0⟫My parents’ relationship is on thin ice, but the air feels like it’s on fire. ⟪k:1⟫It’s much "
"too hot."
msgstr ""
"⟪k:0⟫Il rapporto tra i miei genitori è diventato di ghiaccio,⟪k:1⟫eppure l’aria sembra bruciare. "
"⟪k:2⟫Fa troppo caldo."

#: scenario2:scenario2_9E8AA447_803D_4FF2_867B_0D87BF0DBCA8
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 51bb38f8bf26b96d9de955b1fdb3db4d501b6b135e6bc39eac8b8c94e9b671d6
#. default-sha256: 3b610c3cf9586a16659a65a8d6049d1c81d4281b3399ce0729d4726882fdbb8a
msgctxt "scenario2:scenario2_9E8AA447_803D_4FF2_867B_0D87BF0DBCA8"
msgid ""
"⟪k:0⟫My dad loves this seaside restaurant. ⟪k:1⟫It actually specializes in fish, but he always "
"asks for meat."
msgstr ""
"⟪k:0⟫Mio padre adora questo ristorante sul litorale.⟪k:1⟫⟪k:2⟫Nonostante sia specializzato nel "
"pesce, lui chiede sempre e solo carne."

#: scenario2:scenario2_7568A884_1212_4814_AD60_5BB3B1D66CA4
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 2c9067383bbc49d37c960343038828d9e3591dea5d59a438681518c53c164b28
#. default-sha256: 0a46925b9af17ef039989797d866cb5da960fc7eb90b74f3d61e7c880057f095
msgctxt "scenario2:scenario2_7568A884_1212_4814_AD60_5BB3B1D66CA4"
msgid ""
"⟪k:0⟫Though “always” isn’t very often. He’s out of the country most of the time, so we rarely eat "
"together as a family."
msgstr ""
"⟪k:0⟫Anche se “sempre” non significa che ci viene spesso.⟪k:1⟫⟪k:2⟫Rimane all’estero la maggior "
"parte del tempo, dunque è raro che riusciamo a mangiare tutti insieme."

#: scenario2:scenario2_4714BF7B_C21A_4DE6_A54C_A5E914690614
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 472d7e48661f788793a4110e777b7b18831a295b01fc4fca1bfe1eb7b600d6d9
#. default-sha256: b2cd23df3f60df34abc032feb77a4478e3b9adf6b185ba8a322afc294516cf49
msgctxt "scenario2:scenario2_4714BF7B_C21A_4DE6_A54C_A5E914690614"
msgid "⟪k:0⟫For that reason, I can usually put up with a little heat for a family gathering..."
msgstr ""
"⟪k:0⟫⟪k:1⟫È⟪k:2⟫ per questo che, una volta tanto, cerco di sopportare un po’ di caldo per una "
"riunione di famiglia..."

