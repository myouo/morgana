msgctxt "scenario2:scenario2_3380BD21_7C7C_4798_84A2_08A06159DE42"
msgid "⟪k:0⟫The sun was beginning to set, draping the surroundings in a deep blackness."
msgstr ""
"⟪k:0⟫Il sole stava iniziando a tramontare, facendo piombare i dintorni⟪k:1⟫in una profonda "
"oscurità."

#: scenario2:scenario2_90DC954B_85AB_4D14_9969_34AE653F673B
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: ce4e983fb275c8b728af6f58566a0eaf9856abf8492cd90e230c08b9370eede8
#. default-sha256: c0b6dd4e7c8f6004519943c744e82de100d8de4d9e1c6573355f359a1a77cd73
msgctxt "scenario2:scenario2_90DC954B_85AB_4D14_9969_34AE653F673B"
msgid ""
"⟪k:0⟫As if to keep him from returning home, the night wrapped its hands around his head, covering "
"both eyes."
msgstr ""
"⟪k:0⟫Come se volesse impedirgli di tornare a casa, la notte avvolse le proprie mani attorno alla "
"sua testa, coprendogli entrambi gli occhi."

#: scenario2:scenario2_A3292FE9_7ACB_44F2_B5E3_E573DF8E53F4
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 71605d435cbd434a62721124bb5df4a013216cb1bcacd117b8a2d520e12dd653
