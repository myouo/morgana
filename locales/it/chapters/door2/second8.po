msgid "⟪k:0⟫⟪k:1⟫Calm down."
msgstr "⟪k:0⟫⟪k:1⟫Su, calmati."

#: scenario2:scenario2_DD4689FB_0486_4EB5_A3C2_1A6CB1819498
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 2d8f3de2310cde48c018b0cf1e7d7733824fdecc06c794f27c52f36573bddcb2
