#: scenario2:scenario2_D22FE458_8A7D_4673_90FE_7646580B8285
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 4ae37a15ed17d8ffa9278e95899afaa1dadd660a5273ea5b1d34bb8e219043b4
#. default-sha256: b67859892e6ad2ecc5df4527586c03b2bdf4993adfee511f6b1608cb2b5c5448
msgctxt "scenario2:scenario2_D22FE458_8A7D_4673_90FE_7646580B8285"
msgid "⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫His psyche drifted erratically between human and beast."
msgstr "⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫La sua psiche andava alla deriva, in bilico tra uomo e bestia."

#: scenario2:scenario2_613DC2C4_840E_4A8F_9D57_5CAB67B354D1
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 9fe4ff24e49d09cd6b17ce6a9f7aa12e842d3e6cf49d3f72f49ff58ab07b9a7b
#. default-sha256: 3005862cfeea3a06ad4aac2584658bf90b456cbb01bcf9cd0ea05023499d1e45
msgctxt "scenario2:scenario2_613DC2C4_840E_4A8F_9D57_5CAB67B354D1"
msgid ""
"⟪k:0⟫If he accepted himself as human, it might cause memories better left buried to return to him."
msgstr ""
"⟪k:0⟫Se si fosse accettato come umano, i ricordi lasciati sepolti sarebbero potuti riaffiorare "
"nella propria mente."

#: scenario2:scenario2_4E8DBE94_0F0F_455E_BD75_60909F199278
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: bc3956aa4102a584c331658aad227c25bf25d87ce74e62e52ed81b15a73da8e0
#. default-sha256: 92defd62b8f5b2b42a1dad37c39583bacf424f8c7cb6d1ddb38a990beddcc492
msgctxt "scenario2:scenario2_4E8DBE94_0F0F_455E_BD75_60909F199278"
msgid ""
"⟪k:0⟫If he accepted himself as a beast, in exchange for his memories,⟪k:1⟫he would no longer be "
"able to rejoin human society."
msgstr ""
"⟪k:0⟫Se si fosse accettato come bestia, in cambio dei propri ricordi,⟪k:1⟫non sarebbe stato più "
"in grado di rientrare nella società umana."

#: scenario2:scenario2_27E0A2EF_2853_4A32_A306_7FD78DEF8BD7
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 2e0ba4f1a2945849ae9a3864f94814434012c65fdbfeaacd49f90fbe00a98fce
#. default-sha256: 3ff21666ce5b6a916f0b650adc47e2113859ab23ccf0ac0ad4b23b46a93fc5f0
msgctxt "scenario2:scenario2_27E0A2EF_2853_4A32_A306_7FD78DEF8BD7"
msgid "⟪k:0⟫The White-Haired Girl fervently supported him in these precarious times."
msgstr "⟪k:0⟫La Ragazza dai Capelli Bianchi lo sosteneva con impegno in quei momenti difficili."

#: scenario2:scenario2_85DB32B0_F282_4C4F_AADE_25DF44D1793A
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: f1ff63dacfcd24d6aafbe5170576069ecf56bb2f032129c74b4a8e69cb55c3ce
#. default-sha256: dd0262f250c2dcfb5beb65663187347ed326b767405651f1c7272b1aa401a43f
msgctxt "scenario2:scenario2_85DB32B0_F282_4C4F_AADE_25DF44D1793A"
msgid "⟪k:0⟫I was quite amazed. ⟪k:1⟫I had never imagined she would grow to be such a strong woman."
msgstr ""
"⟪k:0⟫Ero piuttosto sorpresa. ⟪k:1⟫Non avrei mai immaginato che sarebbe diventata una donna così "
"forte."

#: scenario2:scenario2_81BAC672_0240_4367_B8F1_AEEE5EF63437
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 385c43ab6e0950b6440d450a888a06b8a406b307eee02bc637d0008aec345719
#. default-sha256: c9f7f7e6dfeb5ba615339efbf38734786afef0a6ab5738ee6cf3b09872f9dfa4
msgctxt "scenario2:scenario2_81BAC672_0240_4367_B8F1_AEEE5EF63437"
msgid ""
"⟪k:0⟫Nevertheless, God is a cruel master. ⟪k:1⟫For what strength He gave her spiritually, He took "
"in equal part from her physically."
msgstr ""
"⟪k:0⟫Ciò nonostante, Dio è un padrone crudele. ⟪k:1⟫Per quanta forza le donasse spiritualmente, "
"tanta gliene sottraeva fisicamente."

#: scenario2:scenario2_05F0A744_A738_48CE_AC4F_1752BD288946
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 0ace4e3ef2069e59629d134f17ffa614a76167a67934d2658284a092e6ceb939
#. default-sha256: 63cdf106ef3a4eb1bd7f2358470eaaf62f4caa7115cc62ad65a00dd62f01898d
msgctxt "scenario2:scenario2_05F0A744_A738_48CE_AC4F_1752BD288946"
msgid ""
"⟪k:0⟫Though she persisted, day in and day out, to stay by the man’s side, one day, she suddenly "
"fell ill."
msgstr ""
"⟪k:0⟫Anche se insisteva, giorno dopo giorno, a rimanere al suo fianco,⟪k:1⟫un giorno la donna si "
"ammalò improvvisamente."

#: scenario2:scenario2_634710E0_4271_494D_8734_B73C81AB4A91
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 03efc1a77ee45af013abf961e2d99146e2aa1849acac6942afdd3de28b9fab65
#. default-sha256: 4d078546ca3c61475530e6ecb2938228aaf623e8b29c52ef88b17af0df01ce79
msgctxt "scenario2:scenario2_634710E0_4271_494D_8734_B73C81AB4A91"
msgid ""
"⟪k:0⟫With her in the throes of a high fever and not knowing the cause, he fell into a perpetual "
"panic."
msgstr ""
"⟪k:0⟫Con lei in preda ad una febbre alta, e non conoscendo la causa,⟪k:1⟫Bestia cadde in un "
"panico costante."

#: scenario2:scenario2_3AE81AF8_72E6_46B9_87D7_D2F4F26D2594
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: be318b0b2ca2b898b0845dbe45857dd72a7df91220d291bc1449805694088303
#. default-sha256: eb1f4c4142ea43fd83458b1bcbf6f4e85374b2129f8afe8168874ab7caa0dc1f
msgctxt "scenario2:scenario2_3AE81AF8_72E6_46B9_87D7_D2F4F26D2594"
msgid ""
"⟪k:0⟫There was no medicine in the mansion. ⟪k:1⟫They could hardly manage to put together "
"sufficiently nutritious meals."
msgstr ""
"⟪k:0⟫Non c’era alcun farmaco in casa. ⟪k:1⟫Riuscivano a malapena a preparare pasti "
"sufficientemente nutrienti."

#: scenario2:scenario2_86C68658_873A_40A0_944A_3AFF8C8C15F3
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 2c7e5bf1db99ab4a033fcb1d3cec638637c1c0edb4a20270b1610c82c9a27bb8
#. default-sha256: ac95bd427acc6f3bcbc5ba3a27cfab060630cc614ca4cdb0337e408602ecc534
msgctxt "scenario2:scenario2_86C68658_873A_40A0_944A_3AFF8C8C15F3"
msgid ""
"⟪k:0⟫Though there was no medicine, maybe there was something else that could make her feel better."
msgstr ""
"⟪k:0⟫Sebbene non ci fossero medicine, forse c’era qualcos’altro che avrebbe potuto farla stare "
"meglio."

#: scenario2:scenario2_781579D4_483E_40FE_AF37_18A0F7978D13
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 884be5b542c7dec3802d603838c1034103622495276d0c5bb22433b29f0e6439
#. default-sha256: 4126e718e5ac34a573626264b46816b020fb66a2776431f2b611f83c2a25ab4a
msgctxt "scenario2:scenario2_781579D4_483E_40FE_AF37_18A0F7978D13"
msgid "⟪k:0⟫However, everything he could think of required him to leave the house."
msgstr "⟪k:0⟫Tuttavia, qualunque cosa gli veniva in mente gli imponeva di lasciare la casa."

#: scenario2:scenario2_FF92B370_1B1F_450C_8CEE_E0A7058049B4
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 5829acf2cc3e6b441b39c148eb0fd2eb9d316a6c7473e5c713b21717126abd6b
#. default-sha256: 3d669fc499fcb62cc496421b65ee853d531ebb60b8aafb23b0392fa363a5e8a9
msgctxt "scenario2:scenario2_FF92B370_1B1F_450C_8CEE_E0A7058049B4"
msgid "⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫⟪k:4⟫⟪k:5⟫⟪k:6⟫⟪k:7⟫⟪k:8⟫⟪k:9⟫Hey... ⟪k:10⟫Hey."
msgstr "⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫⟪k:4⟫⟪k:5⟫⟪k:6⟫⟪k:7⟫⟪k:8⟫⟪k:9⟫Ehi... ⟪k:10⟫⟪k:11⟫Ehi."

#: scenario2:scenario2_3270703E_D7AD_4458_8C31_65257D00792F
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: e0b88e912b99919696e782c262cd523879c3ca14da09a74f256ff2d203b89ed8
