msgctxt "scenario2:scenario2_3270703E_D7AD_4458_8C31_65257D00792F"
msgid "⟪k:0⟫⟪k:1⟫............"
msgstr "⟪k:0⟫⟪k:1⟫............"

#: scenario2:scenario2_001F0AE2_2F0B_404C_AA1A_D785C93AA9B9
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: a7cf98455c9f4de13e4ed0ea60740f0c7cf5fc1377fde1fcc627a5a966e65bc8
#. default-sha256: da84a15b7c183e1c1903122e7086e26cacc8563e240d2f236c030683970dbc52
msgctxt "scenario2:scenario2_001F0AE2_2F0B_404C_AA1A_D785C93AA9B9"
msgid "⟪k:0⟫⟪k:1⟫Is there anything you would like?"
msgstr "⟪k:0⟫⟪k:1⟫C’è qualcosa che vuoi in particolare?"

#: scenario2:scenario2_A0151887_D25E_4A14_BE0E_3B9B75139582
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 4295ba2d1208daa47425a900eaf50c6f5b40c8d5cd465a05eb3438892546ec15
#. default-sha256: b6f5625d943b005c8c21bfde96b683219591bfc2a5e8941b6948a5d9065bca83
msgctxt "scenario2:scenario2_A0151887_D25E_4A14_BE0E_3B9B75139582"
msgid "⟪k:0⟫⟪k:1⟫Anything... ⟪k:2⟫I would like...?"
msgstr "⟪k:0⟫⟪k:1⟫Qualcosa... ⟪k:2⟫che voglio...?"

#: scenario2:scenario2_675D2378_B607_43CE_8DAB_78E22BDD345D
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: a73f54b676e522ead740bc180a578310f716145449d8360a758f496965a6570d
#. default-sha256: 90ae88b73389d71364fbd07da7ad51c9ffe9a34cf144fca16ecc81f38c1630e8
msgctxt "scenario2:scenario2_675D2378_B607_43CE_8DAB_78E22BDD345D"
msgid "⟪k:0⟫⟪k:1⟫I’m considering..."
msgstr "⟪k:0⟫⟪k:1⟫Stavo considerando..."

#: scenario2:scenario2_4C48DE42_33E8_45EB_82F7_FCF9CFA52535
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: c7a55348725d5470b0b94cc02b8348f9702d9848fe7ff5cab84bef4660713008
#. default-sha256: 2e00a6293a1ef87f2841e4d162f8245d52c01a243ba8c8c589713a673264fe23
msgctxt "scenario2:scenario2_4C48DE42_33E8_45EB_82F7_FCF9CFA52535"
msgid "⟪k:0⟫⟪k:1⟫visiting the village."
msgstr "⟪k:0⟫⟪k:1⟫l’idea di far visita al villaggio."

#: scenario2:scenario2_5AA70BC1_FCF0_46EF_9164_F66F9D0A6DA0
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: b6607e7665d5a46ee841633a04a8a0ae848f7c5efbbbd41f766ee585eb053e64
#. default-sha256: d70fbf92d6d3d9a3deed7709eb82eb42052462cc77a8709478707f439d624c9f
msgctxt "scenario2:scenario2_5AA70BC1_FCF0_46EF_9164_F66F9D0A6DA0"
msgid "⟪k:0⟫⟪k:1⟫I see...⟪k:2⟫⟪k:3⟫You’re going to the village..."
msgstr "⟪k:0⟫⟪k:1⟫Capisco...⟪k:2⟫⟪k:3⟫Stai andando al villaggio..."

#: scenario2:scenario2_0E72AAEA_BFA9_466B_AAC8_843C1EAB28C9
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 123a7e8ee201c603ee9a3799879056b3ff2f5b55fe16fb9ae7ef8705c1abdde0
#. default-sha256: c36d21b131edb76982e48c978d40cb9fe7c98f5f33161117d79c475174a0741f
msgctxt "scenario2:scenario2_0E72AAEA_BFA9_466B_AAC8_843C1EAB28C9"
msgid "⟪k:0⟫⟪k:1⟫I thought I might be able to get some medicine."
msgstr "⟪k:0⟫⟪k:1⟫Ho pensato che avrei potuto comprare delle medicine."

#: scenario2:scenario2_31BBE612_F46E_46E3_8340_8AC43F461A39
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 1fdaf41abc5b1798a4b8e5dfc7f90e122438b7947426993211295f52adf0f5c9
#. default-sha256: b2806b6d65aced2d1dd032f42a932d39b5a7c767521b9e9ebbaaadfe867bec47
msgctxt "scenario2:scenario2_31BBE612_F46E_46E3_8340_8AC43F461A39"
msgid ""
"⟪k:0⟫I would prefer to bring a doctor here...⟪k:1⟫⟪k:2⟫but no one would come if they learned you "
"were in this mansion."
msgstr ""
"⟪k:0⟫Preferirei portare qui un dottore...⟪k:1⟫⟪k:2⟫ma non verrebbe nessuno se scoprissero che ti "
"trovi in questa villa."

#: scenario2:scenario2_4837F3A8_618A_4A41_8BCA_9F65184841C2
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 0723f2fc72c400801eeb9d5c500fb439ea4e240ddc788153cb4a80a0a1416f22
#. default-sha256: bb4a4d18b2d8bc6199db781f8c4026597fddb38ba93ea80fd5ac0f6f98072352
msgctxt "scenario2:scenario2_4837F3A8_618A_4A41_8BCA_9F65184841C2"
msgid "⟪k:0⟫⟪k:1⟫So..."
msgstr "⟪k:0⟫⟪k:1⟫Perciò..."

#: scenario2:scenario2_BF0A6369_E0B3_4637_8924_C2EC4BCA7C2F
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: dc2b1b323347999a63cf922c7bcead53d08101b09a4c275b05c8d6cf201a1ca3
#. default-sha256: 36dfd3f5f217c6e02ff87059237b24f146afb5b6d2bee1b08abafb3e849e746a
msgctxt "scenario2:scenario2_BF0A6369_E0B3_4637_8924_C2EC4BCA7C2F"
msgid "⟪k:0⟫He was planning to put on a disguise—⟪k:1⟫⟪k:2⟫to enter the village as a person."
msgstr ""
"⟪k:0⟫Aveva intenzione di indossare un travestimento—⟪k:1⟫⟪k:2⟫per entrare nel villaggio con "
"l’aspetto di una persona."

#: scenario2:scenario2_7C2E41D3_243D_485A_BD38_AD1A0ADB69D8
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 7e20df52ce140f6925b0c50f4d3748267dcefd5564fa194e5fd673fa28e1204a
#. default-sha256: a1f237394adaddf41f4e773b94dcea8fe5174694161b87d2233e00564f3994ad
msgctxt "scenario2:scenario2_7C2E41D3_243D_485A_BD38_AD1A0ADB69D8"
msgid "⟪k:0⟫The White-Haired Girl smiled when she heard his idea."
msgstr "⟪k:0⟫La Ragazza dai Capelli Bianchi sorrise dopo aver sentito la sua idea."

#: scenario2:scenario2_C3594EDB_5862_465C_8F1E_DE54E325F513
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 4d758d70e7e95447eb2f644b621b97766131c95f4c89958addd718802a4a91dc
#. default-sha256: 81f1f0c7c9b4d1b358be97c3cf5d160e1009bd1323d6414d743ded0804a6bb91
msgctxt "scenario2:scenario2_C3594EDB_5862_465C_8F1E_DE54E325F513"
msgid "⟪k:0⟫She had, after all, always wanted him to think of himself as human."
msgstr "⟪k:0⟫Dopotutto, aveva sempre voluto che lui si vedesse come un essere umano."

#: scenario2:scenario2_70401842_E177_492C_93E8_5FA5249EBE4C
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: bf9bb2e2ef593ab66adb8e9a2ca3e0c3deff7816f44cc270251ee9cad9686c17
#. default-sha256: edc1b87d2bb12e28554fbb7a9ada113715049b0b6351e5150bcc4cddb3bc19b3
msgctxt "scenario2:scenario2_70401842_E177_492C_93E8_5FA5249EBE4C"
msgid "⟪k:0⟫However, because she was so pure-hearted, she did not comprehend..."
msgstr "⟪k:0⟫Tuttavia, essendo pura di cuore..."

#: scenario2:scenario2_46DD207F_F77B_462E_AE51_E870377CD651
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: ada22c6c2c3bdc9cc7d71ad4a6b9390f9892a17c2275b6f49128b3eec3b2be94
#. default-sha256: 1ac20cd33adb6a62a5258dd6efa7e38de868733d18b6f0c13cfc52543c53caef
msgctxt "scenario2:scenario2_46DD207F_F77B_462E_AE51_E870377CD651"
msgid "⟪k:0⟫the full extent of the slaughter he had confessed to committing."
msgstr "⟪k:0⟫non comprendeva la portata del massacro che l’uomo aveva confessato di aver compiuto."

#: scenario2:scenario2_05DDE8BA_3870_4B45_BA3C_233D3FC7144F
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 8ba0ada06447e3fdbdcde118d84a03653352680334a0dd596a432e1efd03217f
#. default-sha256: 4f0e613b515f00bf961909294c443153c5abf2c5fd6303f7b1c5fb26c56127e2
msgctxt "scenario2:scenario2_05DDE8BA_3870_4B45_BA3C_233D3FC7144F"
msgid ""
"⟪k:0⟫The revenge he had taken on those who had chased him around.⟪k:1⟫⟪k:2⟫How sinister his "
"cackling and furious his reaping."
msgstr ""
"⟪k:0⟫La vendetta che si era preso su coloro che lo avevano inseguito.⟪k:1⟫⟪k:2⟫Quanto sinistra "
"fosse la sua risata, e quanto furiosa la sua carneficina."

#: scenario2:scenario2_571DB84B_714D_4092_9951_39A38108CD82
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 45834baf52d35fe8e595a16f3d5545ca8796d5f0b1234b7c677f61869c0a94c2
#. default-sha256: cd00c0f7e1f3371ee0285a1142c3379e0536118cb88421a669614cf167cc9e7b
msgctxt "scenario2:scenario2_571DB84B_714D_4092_9951_39A38108CD82"
msgid "⟪k:0⟫She did not grasp just how serious it was."
msgstr "⟪k:0⟫Non capiva quanto fosse grave la sua situazione."

#: scenario2:scenario2_82CF0A9B_B3E4_43E0_92C6_7F34EB21A356
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
