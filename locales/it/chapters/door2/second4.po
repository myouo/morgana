msgctxt "scenario2:scenario2_4948A3D4_B1E4_443D_8534_D5A1DBC6F668"
msgid "⟪k:0⟫⟪k:1⟫Don’t have enough, not enough,⟪k:2⟫⟪k:3⟫I need more, I need moooooooore!⟪k:4⟫"
msgstr ""
"⟪k:0⟫⟪k:1⟫Non mi basta, non è sufficiente,⟪k:2⟫⟪k:3⟫ne voglio ancora, ne voglio ancoraaaaaaaa!"
"⟪k:4⟫"

#: scenario2:scenario2_44A70BCF_E7C4_4F48_922F_44612B539764
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: fc3297ba92ac083fb2fb857c61d65b929709ff28c9b61fba8dff244dd1545b83
