msgctxt "scenario2:scenario2_44A70BCF_E7C4_4F48_922F_44612B539764"
msgid "⟪k:0⟫I must satisfy these ⟪k:1⟫urges⟪k:2⟫!"
msgstr "⟪k:0⟫Devo saziare questo ⟪k:1⟫bisogno⟪k:2⟫!"

#: scenario2:scenario2_3658F769_8C7F_480E_A8E0_F7FA9C5DE928
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: c5685b07cdcf204c55d05befe9cb9b02b546b9b2bc2c8aec0ff3b5b9d63307cf
#. default-sha256: e843f17b116d8c40f6afb5f4f45a7095bd847d87052d018a6448608ae20d3c58
msgctxt "scenario2:scenario2_3658F769_8C7F_480E_A8E0_F7FA9C5DE928"
msgid "⟪k:0⟫⟪k:1⟫Are you saying peace was not enough to sate you?"
msgstr "⟪k:0⟫⟪k:1⟫Stai dicendo che la serenità non era abbastanza da soddisfarti?"

#: scenario2:scenario2_74DDD056_1D04_48D8_ABCF_32277ECC01DF
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 8955433551feb766d5c3c9300b39f17dfe834ab1c4b1636918bb9a456be80416
#. default-sha256: d07de020138f33de7c2edbe669e8975fd328c13c8168a0093614600a9f603fc7
msgctxt "scenario2:scenario2_74DDD056_1D04_48D8_ABCF_32277ECC01DF"
msgid "⟪k:0⟫Did I mishear you when you asked for peace?"
msgstr "⟪k:0⟫Ho capito male quando hai detto di desiderare la pace?"

#: scenario2:scenario2_261F42AA_8689_4AD7_8968_57FF4EEECC49
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 1ba567ca93ec81991cb84c7a4ac326434b5189a0f8d6b3c9962837e18f0a91ba
#. default-sha256: 0f47dfa983b426ec1607d84dc8348f2ed8a8ed61d15f7584993ce543f84ad41a
msgctxt "scenario2:scenario2_261F42AA_8689_4AD7_8968_57FF4EEECC49"
msgid "⟪k:0⟫⟪k:1⟫I was mistaken...⟪k:2⟫⟪k:3⟫Asking for peace won’t solve anything!⟪k:4⟫"
msgstr "⟪k:0⟫⟪k:1⟫Mi ero sbagliato...⟪k:2⟫⟪k:3⟫Chiedere la pace non risolverà nulla!⟪k:4⟫"

#: scenario2:scenario2_2FB5527E_7BE5_42EC_856F_6A709DB470D9
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 301542a2fb7813dfde0f2f781465537e4fb5380658d2333580b17dd7ee95cd43
#. default-sha256: 2c3cef59aa4d44eaeda0947921f26d457a3ef4c29ffb176dad0e33d19d9a9ab6
msgctxt "scenario2:scenario2_2FB5527E_7BE5_42EC_856F_6A709DB470D9"
msgid ""
"⟪k:0⟫Blood! Despair! Eyes filled with terror!⟪k:1⟫⟪k:2⟫⟪k:3⟫These⟪k:4⟫ are the things I need!"
msgstr ""
"⟪k:0⟫Sangue! Disperazione! Occhi ricolmi di terrore!⟪k:1⟫⟪k:2⟫Sono ⟪k:3⟫queste⟪k:4⟫ le cose che "
"mi servono!"

#: scenario2:scenario2_7BEAD8C7_5402_4EAA_B237_D81D80A53B63
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 422f0a4935e205f2e0d45208ce5df77f9c7c3427fdf0660695fc24f9c839cd5a
#. default-sha256: cebb48b21efaa5add5ffb4f749597e453d4a1b54ffad6c685db9bad5ec866a58
msgctxt "scenario2:scenario2_7BEAD8C7_5402_4EAA_B237_D81D80A53B63"
msgid "⟪k:0⟫And I’ve always known it!"
msgstr "⟪k:0⟫E l’ho sempre saputo!"

#: scenario2:scenario2_042BD0C6_56E9_4935_A39D_6D2E017DDBF0
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: cf3a35f228b0823c83e9507c96365f83909ab34cadb1b817fa433842afeccd01
#. default-sha256: 1594ffca39d6c0332e32ffae46741cf4c49b575742c898ee927b99090bfaa8d0
msgctxt "scenario2:scenario2_042BD0C6_56E9_4935_A39D_6D2E017DDBF0"
msgid "⟪k:0⟫You said this mansion fulfills people’s desires!⟪k:1⟫Then... ⟪k:2⟫Then..."
msgstr ""
"⟪k:0⟫Hai detto che questa villa esaudisce i desideri della gente!⟪k:1⟫Allora... ⟪k:2⟫Allora..."

#: scenario2:scenario2_ABAFA661_B50D_44A5_A9CC_F2392825F410
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 0279d32920a53ab4ad1c67cecdb0d3d8d6c68322eb7013ff8a79a129a1590ae0
#. default-sha256: 28672f160a04f32300274cd79f65a7e3719c3113a1f42c6b4bd94d1e3f8ab2b0
msgctxt "scenario2:scenario2_ABAFA661_B50D_44A5_A9CC_F2392825F410"
msgid ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫⟪k:4⟫⟪k:5⟫Give me prey!⟪k:6⟫⟪k:7⟫⟪k:8⟫No more hares—⟪k:9⟫⟪k:10⟫⟪k:11⟫live "
"humans⟪k:12⟫!"
msgstr ""
"⟪k:0⟫⟪k:1⟫⟪k:2⟫⟪k:3⟫⟪k:4⟫...⟪k:5⟫dammi altre prede!⟪k:6⟫⟪k:7⟫⟪k:8⟫Niente più lepri—⟪k:9⟫⟪k:10⟫"
"solo ⟪k:11⟫esseri umani vivi⟪k:12⟫!"

#: scenario2:scenario2_36216E4E_37A8_4288_9365_AC3C7D3298A5
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: 1bf0d10b48e470b30d864bc0f595e36c2f372fc02a63763ae550ee66659df3fe
#. default-sha256: fb1d5eaeb7d01fafd17ba7f3157aa7fdd3219964dec0f6f1c9002b656e5d3509
msgctxt "scenario2:scenario2_36216E4E_37A8_4288_9365_AC3C7D3298A5"
msgid "⟪k:0⟫Why did I ever teach him to speak human language?"
msgstr "⟪k:0⟫A cosa era servito insegnargli a parlare la lingua degli uomini?"

#: scenario2:scenario2_3956845F_F173_49C2_B599_3DC3CE06B064
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: f61d54b234a6fb4cc900a44bacd907f2ef6ee5810f74807ef4d9222f0c7eb0e7
#. default-sha256: b51fac07f2b9c68da4790eefcdbd2e4b3ae7b26337b65b32090d6dcf5ef8359d
msgctxt "scenario2:scenario2_3956845F_F173_49C2_B599_3DC3CE06B064"
msgid "⟪k:0⟫⟪k:1⟫Before long, the mansion granted his wish."
msgstr "⟪k:0⟫⟪k:1⟫Di lì a poco, la villa esaudì il suo desiderio."

#: scenario2:scenario2_2D3DB347_9C5C_4348_9141_8DBA4EE15AA9
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: f1e0e6c1387b0f804734b8140d54193d07bcf6602f4f1528ccafa48cc1b5ae34
#. default-sha256: 4e05b647be654274203f72cd596cdd5f1818f5c4f41c90a05a0b3e7403988d40
msgctxt "scenario2:scenario2_2D3DB347_9C5C_4348_9141_8DBA4EE15AA9"
msgid ""
"⟪k:0⟫Once a week, a villager or a traveling merchant from somewhere would wander into the forest, "
"ending up at the mansion on the cliff."
msgstr ""
"⟪k:0⟫Una volta a settimana, un abitante del villaggio o un mercante in viaggio avrebbe vagato per "
"la foresta, giungendo infine alla villa sulla scogliera."

#: scenario2:scenario2_EC3E1937_F81D_450E_AE1A_5424CC1137AF
#. Edit msgstr; keep protected ⟪k:N⟫ markers in source order.
#. native-sha256: f3b4adb6c2cfc4daa5ce9abccaaf2731d2443c477d50526f87d5ff3ec7e8b8de
#. default-sha256: dcb15fcb7b6eee4217a1b081e54133c076b6a8539a00a264d054924fe25bf205
msgctxt "scenario2:scenario2_EC3E1937_F81D_450E_AE1A_5424CC1137AF"
msgid ""
